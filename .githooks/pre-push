#!/usr/bin/env bash
# Pre-push keeps scoped static checks; generation, compilation, and game tests are CI-owned.
# Install with: git config core.hooksPath .githooks
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

if [[ "${SKIP_TRINKET_PREPUSH:-}" == "1" ]]; then
  echo "Skipping Trinket pre-push gate (SKIP_TRINKET_PREPUSH=1)."
  exit 0
fi

# Read and validate Git's ref pairs before tooling can consume stdin or inspect
# a tree that differs from the outgoing commit. Command substitution propagates
# discovery failures; a process-substitution pipeline would hide them.
push_input="$(cat)"
push_paths="$(python3 Scripts/pre-push-paths.py <<< "$push_input")" || exit $?
if [[ -z "$push_paths" ]]; then
  echo "No outgoing source paths to verify."
  exit 0
fi

echo "=== Pre-push: ensure pinned format/lint tools ==="
./Scripts/ensure-ci-tools.sh
export PATH="$ROOT/.tools:$PATH"

style_swift=()
pushed_paths=()
while IFS= read -r path; do
  [[ -n "$path" ]] || continue
  pushed_paths+=("$path")
  if [[ "$path" == *.swift && -f "$path" ]]; then
    style_swift+=("$path")
  fi
done <<< "$push_paths"

echo "=== Pre-push: style (format / lint / UI / platform bans / exclusivity / agent invariants / accessibility IDs) ==="
# Classify push range for path-scoped package selection.
# shellcheck source=Scripts/change-classification.sh
source Scripts/change-classification.sh
if (( ${#pushed_paths[@]} > 0 )); then
  trinket_collect_paths explicit "${pushed_paths[@]}"
  trinket_classify_paths
fi
if (( ${#style_swift[@]} > 0 )); then
  echo "Path-scoped style on ${#style_swift[@]} Swift file(s) in the push range."
  ./Scripts/test.sh style "${style_swift[@]}"
else
  ./Scripts/check-api-bans.sh
  ./Scripts/check-exclusivity-footguns.sh
  ./Scripts/check-agent-invariants.sh
  python3 ./Scripts/check-accessibility-ids.py
fi

echo "=== Pre-push: agent push gate (static generated-output completeness) ==="
./Scripts/agent-push-gate.sh --paths "${pushed_paths[@]}"

echo "Package tests, app compilation, generation freshness, and UI verification are deferred to CI."

# Checks must not have rewritten tracked files or introduced untracked inputs.
python3 Scripts/pre-push-paths.py <<< "$push_input" >/dev/null

echo "=== Pre-push gate passed ==="
