#!/usr/bin/env bash
# Pre-push gate: format lint + SwiftLint + UI style + agent push gate (generate/assert).
# Install with: git config core.hooksPath .githooks
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

if [[ "${SKIP_TRINKET_PREPUSH:-}" == "1" ]]; then
  echo "Skipping Trinket pre-push gate (SKIP_TRINKET_PREPUSH=1)."
  exit 0
fi

echo "=== Pre-push: ensure pinned format/lint tools ==="
./Scripts/ensure-ci-tools.sh
export PATH="$ROOT/.tools:$PATH"

echo "=== Pre-push: SwiftFormat lint ==="
./Scripts/format.sh --lint

echo "=== Pre-push: SwiftLint ==="
./Scripts/lint.sh

echo "=== Pre-push: UI style guardrail ==="
./Scripts/check-ui-style.sh

echo "=== Pre-push: platform API bans ==="
./Scripts/check-platform-api-bans.sh

echo "=== Pre-push: exclusivity footguns ==="
./Scripts/check-exclusivity-footguns.sh

echo "=== Pre-push: agent push gate (generate + assert vs HEAD) ==="
./Scripts/agent-push-gate.sh

echo "=== Pre-push gate passed ==="
echo "Tip: after push, run ./Scripts/agent-watch-ci.sh (agents must babysit CI until green)."
