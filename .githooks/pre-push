#!/usr/bin/env bash
# Pre-push gate: path-scoped style, generation completeness, then path-scoped package tests.
# Install with: git config core.hooksPath .githooks
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

if [[ "${SKIP_TRINKET_PREPUSH:-}" == "1" ]]; then
  echo "Skipping Trinket pre-push gate (SKIP_TRINKET_PREPUSH=1)."
  exit 0
fi

echo "=== Pre-push: ensure pinned format/lint tools ==="
./Scripts/ensure-ci-tools.sh
export PATH="$ROOT/.tools:$PATH"

# Git feeds one "local_ref local_sha remote_ref remote_sha" line per ref on stdin.
# Read those first so later pipes cannot steal the push range.
push_lines=()
while IFS= read -r line; do
  [[ -n "$line" ]] || continue
  push_lines+=("$line")
done

collect_pushed_paths() {
  local z40="0000000000000000000000000000000000000000"
  local local_ref local_sha remote_ref remote_sha
  local line

  emit_commit_paths() {
    git log -m --format= --name-only --diff-filter=ACMR "$@"
  }

  if (( ${#push_lines[@]} > 0 )); then
    for line in "${push_lines[@]}"; do
      read -r local_ref local_sha remote_ref remote_sha <<<"$line"
      if [[ "$local_sha" == "$z40" ]]; then
        continue
      fi
      if [[ "$remote_sha" == "$z40" ]]; then
        if git for-each-ref --format='%(refname)' refs/remotes | grep -q .; then
          emit_commit_paths "$local_sha" --not --remotes
        else
          git diff-tree --root --no-commit-id --name-only -m -r --diff-filter=ACMR "$local_sha"
        fi
      else
        emit_commit_paths "$remote_sha..$local_sha"
      fi
    done
    return 0
  fi

  if git for-each-ref --format='%(refname)' refs/remotes | grep -q .; then
    emit_commit_paths HEAD --not --remotes
  else
    git diff-tree --root --no-commit-id --name-only -m -r --diff-filter=ACMR HEAD
  fi
}

style_swift=()
pushed_paths=()
while IFS= read -r path; do
  [[ -n "$path" ]] || continue
  pushed_paths+=("$path")
  if [[ "$path" == *.swift && -f "$path" ]]; then
    style_swift+=("$path")
  fi
done < <(collect_pushed_paths | sed '/^$/d' | sort -u)

echo "=== Pre-push: style (format / lint / UI / platform bans / exclusivity / agent invariants / accessibility IDs / comment ban) ==="
if (( ${#style_swift[@]} > 0 )); then
  echo "Path-scoped style on ${#style_swift[@]} Swift file(s) in the push range."
  ./Scripts/test.sh style "${style_swift[@]}"
else
  ./Scripts/check-platform-api-bans.sh
  ./Scripts/check-exclusivity-footguns.sh
  ./Scripts/check-agent-invariants.sh
  ./Scripts/check-accessibility-ids.sh
  ./Scripts/check-comment-ban.sh
fi

echo "=== Pre-push: agent push gate (generate + assert vs HEAD) ==="
./Scripts/agent-push-gate.sh

echo "=== Pre-push: path-scoped package tests ==="
# shellcheck source=Scripts/change-classification.sh
source Scripts/change-classification.sh
if (( ${#pushed_paths[@]} > 0 )); then
  trinket_collect_paths explicit "${pushed_paths[@]}"
  trinket_classify_paths
fi
if (( ${#TRINKET_PACKAGES[@]} > 0 )); then
  echo "Package tests for: ${TRINKET_PACKAGES[*]}"
  if command -v xcodebuild >/dev/null 2>&1; then
    SKIP_GENERATE=1 ./Scripts/test-package.sh "${TRINKET_PACKAGES[@]}"
  else
    echo "Skipping package tests (xcodebuild unavailable)." >&2
  fi
else
  echo "No package test targets in the push range."
fi

echo "=== Pre-push gate passed ==="
