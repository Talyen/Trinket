    "store.promotionaltext": {
      "comment": "App Store promotionalText. Maximum 170 characters. Trinket is the unchanged game brand; Full Game is the permanent, one-time non-consumable purchase. No subscriptions or paid random loot.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle eine Gruppe aus Helden und Gefährten zusammen, gestalte ihre Fähigkeiten und Ausrüstung und erkunde eine Fantasywelt in rundenbasierten Kartenkämpfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build a party of Heroes and Companions, shape their abilities and equipment, and explore a fantasy world through turn-based card battles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Formez une équipe de Héros et de Compagnons, personnalisez leurs capacités et équipements, puis explorez un monde fantastique par des combats de cartes au tour par tour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒーローと仲間のパーティを組み、アビリティと装備を整え、ターン制カードバトルで幻想世界を探索しよう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영웅과 동료로 파티를 꾸리고, 능력과 장비를 갖춰 턴제 카드 전투로 판타지 세계를 탐험하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "組建英雄與夥伴的隊伍，塑造他們的能力與裝備，透過回合制卡牌戰鬥探索奇幻世界。"
          }
        }
      }
    },
