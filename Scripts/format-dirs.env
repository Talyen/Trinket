# Format/lint Swift source roots, derived from the package list owned by
# build-inputs.env (sourced below). Adding a package
# only touches TRINKET_TEST_PACKAGES / TRINKET_COMPILE_ONLY_PACKAGES.
# shellcheck disable=SC2034
SWIFT_SOURCE_DIRS=(
  Trinket
  TrinketUITests
)
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/build-inputs.env"
_TRINKET_FORMAT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
for _trinket_format_package in "${TRINKET_TEST_PACKAGES[@]}" "${TRINKET_COMPILE_ONLY_PACKAGES[@]}"; do
  SWIFT_SOURCE_DIRS+=("Packages/$_trinket_format_package/Sources")
  # Support-only packages ship no Tests tree; gate on the directory instead of
  # the package name so future test targets are covered without edits here.
  if [[ -d "$_TRINKET_FORMAT_ROOT/Packages/$_trinket_format_package/Tests" ]]; then
    SWIFT_SOURCE_DIRS+=("Packages/$_trinket_format_package/Tests")
  fi
done
unset _trinket_format_package _TRINKET_FORMAT_ROOT
