# Format/lint Swift source roots, derived from the package list owned by
# build-inputs.env (sourced first via swift-source-dirs.env). Adding a package
# only touches TRINKET_TEST_PACKAGES / TRINKET_COMPILE_ONLY_PACKAGES.
# shellcheck disable=SC2034
SWIFT_SOURCE_DIRS=(
  Trinket
  TrinketUITests
)
if [[ -z "${TRINKET_TEST_PACKAGES+x}" ]]; then
  TRINKET_TEST_PACKAGES=(
    TrinketCore
    TrinketContent
    BattleEngine
    TrinketPersistence
    TrinketDesignSystem
    TrinketFeatureSupport
    TrinketBattleFeature
    TrinketAppState
  )
fi
if [[ -z "${TRINKET_COMPILE_ONLY_PACKAGES+x}" ]]; then
  TRINKET_COMPILE_ONLY_PACKAGES=(TrinketTestSupport)
fi
for _trinket_format_package in "${TRINKET_TEST_PACKAGES[@]}" "${TRINKET_COMPILE_ONLY_PACKAGES[@]}"; do
  SWIFT_SOURCE_DIRS+=("Packages/$_trinket_format_package/Sources")
  if [[ "$_trinket_format_package" != "TrinketTestSupport" ]]; then
    SWIFT_SOURCE_DIRS+=("Packages/$_trinket_format_package/Tests")
  fi
done
unset _trinket_format_package
