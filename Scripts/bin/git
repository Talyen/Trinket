#!/usr/bin/env sh
# Harness-agnostic shim: intercepts destructive git commands via guard,
# delegates to real git otherwise. Bypass with REAL_GIT_BYPASS=1 /usr/bin/git ...
set -eu
if [ "${REAL_GIT_BYPASS:-0}" = "1" ]; then
  exec /usr/bin/git "$@"
fi
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
SHIM_DIR="$ROOT/Scripts/bin"
# Find real git - prefer system git, skip any wrappers that delegate to this shim
REAL_GIT="${REAL_GIT:-}"
if [ -z "$REAL_GIT" ]; then
  for cand in /opt/homebrew/bin/git /usr/local/bin/git /usr/bin/git; do
    if [ -x "$cand" ]; then REAL_GIT="$cand"; break; fi
  done
  REAL_GIT="${REAL_GIT:-/usr/bin/git}"
fi
# Fast path: non-destructive commands go straight to real git. The command
# list is owned by Scripts/git-safety-guard.mjs (exported
# DESTRUCTIVE_GIT_COMMANDS); parse it here so the shell shim cannot drift.
# Comma-wrapped containment keeps the match portable across sh variants.
destructive_commands="$(sed -n 's/^export const DESTRUCTIVE_GIT_COMMANDS = \[\(.*\)\];$/\1/p' "$ROOT/Scripts/git-safety-guard.mjs" | tr -d ' "')"
if [ -z "$destructive_commands" ]; then
  # Fail closed: without the canonical list every command goes via the guard.
  exec env REAL_GIT="$REAL_GIT" node "$ROOT/Scripts/git-safety-guard.mjs" "$@"
fi
case ",${destructive_commands}," in
  *,"${1:-}",*) ;;
  *) exec "$REAL_GIT" "$@" ;;
esac
# Destructive candidates: run guard (which re-exec's REAL_GIT if clean)
exec env REAL_GIT="$REAL_GIT" node "$ROOT/Scripts/git-safety-guard.mjs" "$@"
