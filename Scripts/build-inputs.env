# Build/test/compile packages, generation inputs, and cache roots.
# Split from swift-source-dirs.env; swift-source-dirs.env sources this file
# so existing consumers keep working. Variable names are unchanged.
# shellcheck disable=SC2034
TRINKET_TEST_PACKAGES=(
  TrinketCore
  TrinketContent
  BattleEngine
  TrinketPersistence
  TrinketDesignSystem
  TrinketFeatureSupport
  TrinketBattleFeature
  TrinketAppState
)

# shellcheck disable=SC2034
TRINKET_COMPILE_ONLY_PACKAGES=(
  TrinketTestSupport
)

# shellcheck disable=SC2034
TRINKET_CONTENT_GENERATION_INPUTS=(
  ContentManifest
  Scripts/content_codegen.py
  Scripts/internal/content/content_codegen_modifiers.py
  Scripts/internal/content/content_codegen_triggers.py
  Scripts/internal/content/trigger_family_schema.json
  Packages/TrinketContent/Sources/TrinketContent/Abilities
  Packages/TrinketCore/Sources
  Packages/TrinketContent/Sources/TrinketContent/Encounters/MysteryEventPool+Wilds.swift
  Packages/TrinketContent/Sources/TrinketContent/Encounters/MysteryEventPool+Relics.swift
  Packages/TrinketContent/Sources/TrinketContent/Encounters/RecruitEventPool.swift
  Packages/TrinketContent/Sources/AbilityInventoryDump/AbilityInventoryDumpMain.swift
)

# shellcheck disable=SC2034
TRINKET_ASSET_GENERATION_INPUTS=(
  ArtManifest
  MusicManifest
  SoundManifest
  CinematicManifest
  "Raw Assets"
  Scripts/prepare-assets.sh
  Scripts/lib/media-assets.sh
  Scripts/prepare-app-icon.sh
  Scripts/prepare-art-assets.sh
  Scripts/prepare-cinematic-assets.sh
  Scripts/prepare-audio-assets.sh
)

# Shared project-generation ownership; quoted patterns also cover deleted inputs.
# shellcheck disable=SC2034
TRINKET_PROJECT_GENERATION_INPUTS=(
  project.yml '*.xctestplan' Scripts/build-inputs.env Scripts/tool-versions.env Scripts/generate.sh
  Scripts/apply-scheme-storekit.py Scripts/ensure-ci-tools.sh
  Scripts/lib/ci-tools.d/xcodegen.sh Scripts/lib/tools.sh Scripts/lib/tool-install.sh
  Scripts/lib/project-generation.sh Scripts/check-staged-project.sh .githooks/pre-commit
  'Trinket/Assets.xcassets/*' 'Trinket/AppIcon.icon/*' Trinket/PrivacyInfo.xcprivacy
  Trinket/Trinket.entitlements 'StoreKit/*' 'Packages/*/Package.swift'
)

# shellcheck disable=SC2034
TRINKET_BUILD_ROOTS=(
  Trinket
  TrinketUITests
  Packages/TrinketTestSupport
)
for _trinket_test_package in "${TRINKET_TEST_PACKAGES[@]}"; do
  TRINKET_BUILD_ROOTS+=("Packages/$_trinket_test_package")
done
unset _trinket_test_package

# shellcheck disable=SC2034
TRINKET_PROJECT_INPUTS=(
  StoreKit
  ContentManifest
  ArtManifest
  MusicManifest
  SoundManifest
  CinematicManifest
  "Raw Assets"
  Scripts
  project.yml
  BattlePerformance.xctestplan
  FullUI.xctestplan
  Smoke.xctestplan
)

# shellcheck disable=SC2034
TRINKET_CACHE_REQUIRED_ROOTS=(
  'StoreKit/**'
  'Trinket/**'
  'TrinketUITests/**'
  'ContentManifest/**'
  'ArtManifest/**'
  'MusicManifest/**'
  'SoundManifest/**'
  'CinematicManifest/**'
  'Raw Assets/**'
  'Scripts/**'
  'project.yml'
  'Packages/**'
  '*.xctestplan'
)
