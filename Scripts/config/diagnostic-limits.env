# Shared diagnostic output budgets. Python readers and shell reporters source
# this file so terminal excerpts and structured reports cannot drift silently.
TRINKET_DIAGNOSTIC_MAX_ISSUES=12
TRINKET_DIAGNOSTIC_MAX_LINES=60
TRINKET_DIAGNOSTIC_MAX_DETAIL_LINES=8
TRINKET_DIAGNOSTIC_MAX_DETAIL_CHARS=2400
TRINKET_DIAGNOSTIC_MAX_MESSAGE_CHARS=800
TRINKET_DIAGNOSTIC_MAX_LINE_CHARS=240
TRINKET_DIAGNOSTIC_MAX_AGGREGATE_ISSUES=20
TRINKET_DIAGNOSTIC_MAX_LABELS_IN_DETAIL=3
TRINKET_XCODE_FAILURE_LOG_LINES_DEFAULT=8
TRINKET_XCODE_FAILURE_LOG_LINE_CHARS_DEFAULT=240
