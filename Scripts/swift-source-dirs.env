# Compatibility shim: split into format-dirs.env + build-inputs.env.
# Existing consumers source this file unchanged; new consumers may source
# the split files directly. build-inputs.env owns the package list, so it
# loads first and format-dirs.env derives source roots from it.
_SWIFT_SOURCE_DIRS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=build-inputs.env
source "$_SWIFT_SOURCE_DIRS_DIR/build-inputs.env"
# shellcheck source=format-dirs.env
source "$_SWIFT_SOURCE_DIRS_DIR/format-dirs.env"
unset _SWIFT_SOURCE_DIRS_DIR
