# Shared Swift source roots for format.sh / lint.sh.
# shellcheck disable=SC2034
SWIFT_SOURCE_DIRS=(
  Trinket
  TrinketUITests
  Packages/TrinketCore/Sources
  Packages/TrinketCore/Tests
  Packages/TrinketContent/Sources
  Packages/TrinketContent/Tests
  Packages/BattleEngine/Sources
  Packages/BattleEngine/Tests
  Packages/TrinketBattleRuntime/Sources
  Packages/TrinketPersistence/Sources
  Packages/TrinketPersistence/Tests
  Packages/TrinketDesignSystem/Sources
  Packages/TrinketDesignSystem/Tests
  Packages/TrinketFeatureSupport/Sources
  Packages/TrinketFeatureSupport/Tests
  Packages/TrinketBattleFeature/Sources
  Packages/TrinketBattleFeature/Tests
  Packages/TrinketAppState/Sources
  Packages/TrinketAppState/Tests
  Packages/TrinketTestSupport/Sources
)

# Local SPM packages with test schemes (build-for-testing / test.sh / test-package.sh).
# shellcheck disable=SC2034
TRINKET_TEST_PACKAGES=(
  TrinketCore
  TrinketContent
  BattleEngine
  TrinketPersistence
  TrinketDesignSystem
  TrinketFeatureSupport
  TrinketBattleFeature
  TrinketAppState
)

# Shared authored-input ownership for generation and build freshness. Consumers
# derive their local arrays from these values instead of maintaining another
# package/test-plan/path list.
# shellcheck disable=SC2034
TRINKET_CONTENT_GENERATION_INPUTS=(
  ContentManifest
  Scripts/content_codegen.py
  Scripts/trigger_family_schema.json
)

# shellcheck disable=SC2034
TRINKET_ASSET_GENERATION_INPUTS=(
  ArtManifest
  MusicManifest
  SoundManifest
  CinematicManifest
  "Raw Assets"
  Scripts/prepare-app-icon.sh
  Scripts/prepare-art-assets.sh
  Scripts/prepare-cinematic-assets.sh
  Scripts/prepare-music-assets.sh
  Scripts/prepare-sfx-assets.sh
)

# shellcheck disable=SC2034
TRINKET_BUILD_ROOTS=(
  Trinket
  TrinketUITests
  Packages/TrinketTestSupport
)
for _trinket_test_package in "${TRINKET_TEST_PACKAGES[@]}"; do
  TRINKET_BUILD_ROOTS+=("Packages/$_trinket_test_package")
done
unset _trinket_test_package

# shellcheck disable=SC2034
TRINKET_PROJECT_INPUTS=(
  ContentManifest
  ArtManifest
  MusicManifest
  SoundManifest
  CinematicManifest
  "Raw Assets"
  Scripts
  project.yml
  BattlePerformance.xctestplan
  FullUI.xctestplan
  Smoke.xctestplan
)

# The cache action intentionally uses broader globs than local freshness, but
# these roots are the shared policy that both sides must cover.
# shellcheck disable=SC2034
TRINKET_CACHE_REQUIRED_ROOTS=(
  'Trinket/**'
  'TrinketUITests/**'
  'ContentManifest/**'
  'ArtManifest/**'
  'MusicManifest/**'
  'SoundManifest/**'
  'CinematicManifest/**'
  'Raw Assets/**'
  'Scripts/**'
  'project.yml'
  'Packages/**'
  '*.xctestplan'
)
