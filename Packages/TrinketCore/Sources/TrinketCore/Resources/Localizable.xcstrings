    "effect.panacea": {
      "comment": "Complete effect rule. Placeholder values correspond to their semantic <value id> labels; string arguments are already localized keyword names. Preserve rule mechanics and token identities.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"cleanse\">Reinige</keyword> alle Schwächungseffekte und stelle <value id=\"base_health\">%1$lld</value> <keyword id=\"health\">Gesundheit</keyword> sowie pro gereinigtem Schwächungseffekt weitere <value id=\"health_per_debuff\">%2$lld</value> <keyword id=\"health\">Gesundheit</keyword> wieder her"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"cleanse\">Cleanse</keyword> all debuffs and restore <value id=\"base_health\">%1$lld</value> <keyword id=\"health\">Health</keyword> plus <value id=\"health_per_debuff\">%2$lld</value> <keyword id=\"health\">Health</keyword> for each debuff cleansed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"cleanse\">Purifica</keyword> todos los perjuicios y restaura <value id=\"base_health\">%1$lld</value> de <keyword id=\"health\">Salud</keyword> más <value id=\"health_per_debuff\">%2$lld</value> de <keyword id=\"health\">Salud</keyword> por cada perjuicio purificado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"cleanse\">Purification</keyword> de tous les malus et restauration de <value id=\"base_health\">%1$lld</value> <keyword id=\"health\">Santé</keyword>, plus <value id=\"health_per_debuff\">%2$lld</value> <keyword id=\"health\">Santé</keyword> par malus purifié"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての弱体効果を<keyword id=\"cleanse\">浄化</keyword>し、<keyword id=\"health\">体力</keyword>を<value id=\"base_health\">%1$lld</value>回復し、さらに解除した弱体効果1つにつき<keyword id=\"health\">体力</keyword>を<value id=\"health_per_debuff\">%2$lld</value>回復"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 약화 효과를 <keyword id=\"cleanse\">정화</keyword>하고 <keyword id=\"health\">체력</keyword> <value id=\"base_health\">%1$lld</value> 회복 및 정화한 약화 효과마다 <keyword id=\"health\">체력</keyword> <value id=\"health_per_debuff\">%2$lld</value> 추가 회복"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"cleanse\">Purifique</keyword> todos os efeitos negativos e restaure <value id=\"base_health\">%1$lld</value> de <keyword id=\"health\">Vida</keyword> mais <value id=\"health_per_debuff\">%2$lld</value> de <keyword id=\"health\">Vida</keyword> por efeito negativo purificado"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"cleanse\">淨化</keyword>所有減益效果，恢復<value id=\"base_health\">%1$lld</value>點<keyword id=\"health\">生命值</keyword>，並為每項淨化的減益效果額外恢復<value id=\"health_per_debuff\">%2$lld</value>點<keyword id=\"health\">生命值</keyword>"
          }
        }
      }
    },
