    "keyword.rules.mana": {
      "comment": "Tooltip for the mana game keyword. Preserve rule timing and all quantities.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"mana\">Mana</keyword> regeneriert sich jede Runde um +1\nGib 3 <keyword id=\"mana\">Mana</keyword> aus, um einer Karte +1 <keyword id=\"burn\">Brand</keyword> oder <keyword id=\"freeze\">Frost</keyword> hinzuzufügen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"mana\">Mana</keyword> regenerates +1 each round\nSpend 3 <keyword id=\"mana\">Mana</keyword> to add +1 <keyword id=\"burn\">Burn</keyword> or <keyword id=\"freeze\">Freeze</keyword> on a card"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"mana\">Maná</keyword> regenera +1 cada ronda\nGasta 3 de <keyword id=\"mana\">Maná</keyword> para añadir +1 de <keyword id=\"burn\">Quemadura</keyword> o <keyword id=\"freeze\">Congelación</keyword> a una carta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le <keyword id=\"mana\">Mana</keyword> se régénère de +1 à chaque manche\nDépensez 3 <keyword id=\"mana\">Mana</keyword> pour ajouter +1 en <keyword id=\"burn\">Brûlure</keyword> ou en <keyword id=\"freeze\">Gel</keyword> à une carte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"mana\">マナ</keyword>は毎ラウンド+1回復する\n<keyword id=\"mana\">マナ</keyword>を3消費してカードの<keyword id=\"burn\">炎上</keyword>または<keyword id=\"freeze\">凍結</keyword>を+1"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"mana\">마나</keyword>는 매 라운드 +1 재생됩니다\n<keyword id=\"mana\">마나</keyword> 3을 소모해 카드의 <keyword id=\"burn\">화상</keyword> 또는 <keyword id=\"freeze\">빙결</keyword>을 +1 강화할 수 있습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"mana\">Mana</keyword> regenera +1 a cada rodada\nGaste 3 de <keyword id=\"mana\">Mana</keyword> para adicionar +1 de <keyword id=\"burn\">Queimadura</keyword> ou de <keyword id=\"freeze\">Congelamento</keyword> a uma carta"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"mana\">魔力</keyword>每輪恢復1點\n消耗3點<keyword id=\"mana\">魔力</keyword>，為卡牌增加1點<keyword id=\"burn\">燃燒</keyword>或<keyword id=\"freeze\">冰凍</keyword>"
          }
        }
      }
    },
