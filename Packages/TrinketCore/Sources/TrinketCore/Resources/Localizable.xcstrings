        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"freeze\">凍結</keyword>はゲージを蓄積する\n満タンになると敵の行動を1回阻止する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"freeze\">빙결</keyword>은 게이지를 쌓습니다\n게이지가 가득 차면 적이 행동 한 번을 잃습니다"
          }
