    "keyword.rules.bleed": {
      "comment": "Tooltip for the bleed game keyword. Preserve rule timing and all quantities.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"bleed\">Blutung</keyword> verursacht 1 Runde lang jede Runde Schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"bleed\">Bleed</keyword> deals damage each round for 1 round"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"bleed\">Sangrado</keyword> inflige daño cada ronda durante 1 ronda"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le <keyword id=\"bleed\">Saignement</keyword> inflige des dégâts à chaque manche pendant 1 manche"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"bleed\">出血</keyword>は1ラウンドの間、毎ラウンドダメージを与える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"bleed\">출혈</keyword>은 1라운드 동안 매 라운드 피해를 줍니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"bleed\">Sangramento</keyword> causa dano a cada rodada por 1 rodada"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"bleed\">流血</keyword>每輪造成傷害，持續1輪"
          }
        }
      }
    },
    "keyword.rules.block": {
      "comment": "Tooltip for the block game keyword. Preserve rule timing and all quantities.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"block\">Block</keyword> verhindert Schaden an der <keyword id=\"health\">Gesundheit</keyword>\nVerbleibender <keyword id=\"block\">Block</keyword> wird bei deiner Gruppe nach dem gegnerischen Zug halbiert, bei Gegnern vor dem gegnerischen Zug"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"block\">Block</keyword> prevents <keyword id=\"health\">Health</keyword> damage\nRemaining <keyword id=\"block\">Block</keyword> halves after the enemy's turn for your party, and before the enemy's turn for enemies"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"block\">Bloqueo</keyword> impide daño a la <keyword id=\"health\">Salud</keyword>\nEl <keyword id=\"block\">Bloqueo</keyword> restante se reduce a la mitad después del turno enemigo para tu grupo y antes del turno enemigo para los enemigos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le <keyword id=\"block\">Blocage</keyword> empêche les dégâts à la <keyword id=\"health\">Santé</keyword>\nLe <keyword id=\"block\">Blocage</keyword> restant diminue de moitié après le tour ennemi pour votre groupe et avant le tour ennemi pour les ennemis"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"block\">ブロック</keyword>は<keyword id=\"health\">体力</keyword>へのダメージを防ぐ\n残った<keyword id=\"block\">ブロック</keyword>は、パーティでは敵のターン後、敵では敵のターン前に半減する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"block\">방어도</keyword>는 <keyword id=\"health\">체력</keyword> 피해를 막습니다\n남은 <keyword id=\"block\">방어도</keyword>는 파티의 경우 적의 턴이 끝난 뒤, 적의 경우 적의 턴이 시작되기 전에 절반으로 줄어듭니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"block\">Bloqueio</keyword> impede dano à <keyword id=\"health\">Vida</keyword>\nO <keyword id=\"block\">Bloqueio</keyword> restante cai à metade após o turno inimigo para seu grupo e antes do turno inimigo para os inimigos"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"block\">格擋</keyword>防止<keyword id=\"health\">生命值</keyword>受到傷害\n隊伍剩餘的<keyword id=\"block\">格擋</keyword>會在敵人回合結束後減半，敵人則在其回合開始前減半"
          }
        }
      }
    },
    "keyword.rules.burn": {
      "comment": "Tooltip for the burn game keyword. Preserve rule timing and all quantities.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">Brand</keyword> verursacht jede Runde Schaden und nimmt schnell ab"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">Burn</keyword> deals damage each round and fades quickly"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">Quemadura</keyword> inflige daño cada ronda y disminuye rápidamente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La <keyword id=\"burn\">Brûlure</keyword> inflige des dégâts à chaque manche et diminue rapidement"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">炎上</keyword>は毎ラウンドダメージを与え、素早く減衰する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">화상</keyword>은 매 라운드 피해를 주며 빠르게 감소합니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">Queimadura</keyword> causa dano a cada rodada e diminui rapidamente"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">燃燒</keyword>每輪造成傷害，並迅速衰減"
          }
        }
      }
    },
    "keyword.rules.cleanse": {
      "comment": "Tooltip for the cleanse game keyword. Preserve rule timing and all quantities.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"cleanse\">Reinigen</keyword> entfernt einen Schwächungseffekt eines Gruppenmitglieds"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"cleanse\">Cleanse</keyword> removes a debuff from a party member"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"cleanse\">Purificación</keyword> elimina un perjuicio de un miembro del grupo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La <keyword id=\"cleanse\">Purification</keyword> retire un malus à un membre du groupe"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"cleanse\">浄化</keyword>はパーティメンバーの弱体効果を1つ解除する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"cleanse\">정화</keyword>는 파티원에게 걸린 약화 효과 하나를 제거합니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"cleanse\">Purificação</keyword> remove um efeito negativo de um membro do grupo"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"cleanse\">淨化</keyword>移除一名隊員的一項減益效果"
          }
        }
      }
    },
    "keyword.rules.deathsdoor": {
      "comment": "Tooltip for the deathsDoor game keyword. Preserve rule timing and all quantities.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die <keyword id=\"deathsdoor\">Todesschwelle</keyword> lässt dich einen tödlichen Treffer mit 1 <keyword id=\"health\">Gesundheit</keyword> überleben und schützt während ihrer Dauer vor tödlichen Treffern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"deathsdoor\">Death's Door</keyword> survives a fatal blow at 1 <keyword id=\"health\">Health</keyword> and is immune to fatal blows while it lasts"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"deathsdoor\">Puertas de la Muerte</keyword> permite sobrevivir a un golpe mortal con 1 de <keyword id=\"health\">Salud</keyword> y otorga inmunidad a golpes mortales mientras dura"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le <keyword id=\"deathsdoor\">Seuil de la mort</keyword> permet de survivre à un coup fatal avec 1 <keyword id=\"health\">Santé</keyword> et protège des coups fatals tant qu’il dure"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"deathsdoor\">死の淵</keyword>は致命傷を受けても<keyword id=\"health\">体力</keyword>1で生存させ、効果中は致命傷を防ぐ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"deathsdoor\">죽음의 문턱</keyword>은 죽음에 이르는 공격을 받아도 <keyword id=\"health\">체력</keyword> 1로 생존하게 하며, 지속되는 동안 죽음에 이르는 공격에 면역이 됩니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A condição <keyword id=\"deathsdoor\">À Beira da Morte</keyword> permite sobreviver a um golpe fatal com 1 de <keyword id=\"health\">Vida</keyword> e concede imunidade a golpes fatais enquanto durar"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"deathsdoor\">瀕死之門</keyword>使角色受到致命一擊時以1點<keyword id=\"health\">生命值</keyword>存活，並在持續期間免於致命一擊"
          }
        }
      }
    },
    "keyword.rules.dodge": {
      "comment": "Tooltip for the dodge game keyword. Preserve rule timing and all quantities.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"dodge\">Ausweichen</keyword> vermeidet einen Angriff vollständig"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"dodge\">Dodge</keyword> avoids an attack completely"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"dodge\">Evasión</keyword> evita un ataque por completo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’<keyword id=\"dodge\">Esquive</keyword> évite entièrement une attaque"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"dodge\">回避</keyword>は攻撃を完全に避ける"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"dodge\">회피</keyword>는 공격을 완전히 피합니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
