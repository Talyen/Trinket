      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"freeze\">Frost</keyword> baut eine Anzeige auf\nEine volle Anzeige lässt den Gegner eine Aktion verlieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"freeze\">Freeze</keyword> builds a meter\nFilling it makes the enemy lose an action"
