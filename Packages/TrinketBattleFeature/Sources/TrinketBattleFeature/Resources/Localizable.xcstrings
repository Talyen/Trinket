    "ui.battleview.auto_battle_paused_message": {
      "comment": "Explains why Auto Battle paused and offers the existing manual play and Retreat actions. No automatic defeat or reward is granted.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Fortschritt gegen den Gegner. Spiele manuell weiter oder ziehe dich zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No progress against the enemy. Play manually or retreat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le combat ne progresse plus. Jouez manuellement ou battez en retraite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "敵との戦闘が進展していません。手動で戦うか、撤退してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
