    "ui.battletransitionlabview.fixed_sample_stages_and_rewards_battle_return_f796b": {
      "comment": "Packages/TrinketBattleFeature/Sources/TrinketBattleFeature/Features/TransitionLab/BattleTransitionLabView.swift: Text. Arguments are displayed values in source order.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feste Beispielabschnitte und Belohnungen. Kämpfen, Zurück zur Abschnittsauswahl und Alles einsammeln verändern nur diese Vorschau; Fortschritt wird nicht gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixed sample stages and rewards. Battle, Return to Stages, and Loot All only change this preview; no progress is saved."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Étapes et récompenses d’exemple fixes. Combat, Retour aux étapes et Tout récupérer modifient uniquement cet aperçu ; aucune progression n’est enregistrée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "固定のサンプルステージと報酬です。「戦闘」「ステージに戻る」「すべて回収」はこのプレビューだけに反映され、進行状況は保存されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정된 예시 스테이지와 보상입니다. 전투, 스테이지로 돌아가기, 모두 획득은 이 미리보기에만 적용되며 진행도는 저장되지 않습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "固定的範例關卡與獎勵。「戰鬥」、「返回關卡」及「全部拾取」只會改變此預覽，不會儲存進度。"
          }
        }
      }
    },
