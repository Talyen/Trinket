    "ui.designsystempreview.system_semantic_text_remains_adaptive_over_th_6d741": {
      "comment": "Packages/TrinketDesignSystem/Sources/TrinketDesignSystem/DesignSystemPreview.swift: Text. Arguments are displayed values in source order.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Semantischer Systemtext bleibt auf der kühlen, anthrazitfarbenen Fläche anpassungsfähig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System semantic text remains adaptive over the cool charcoal canvas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte sémantique du système reste adaptatif sur ce fond anthracite froid."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムの用途別テキスト色は、寒色のチャコール背景でも自動的に調整されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차가운 차콜색 배경에서도 시스템 의미별 텍스트 색상이 자동으로 조정됩니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統語意文字在冷調炭灰背景上仍會自適應調整。"
          }
        }
      }
    },
