    "flag.avatar": {
      "comment": "Battle presentation only; preserve actor, target, timing, and amounts. Names and clauses are nested localized resources.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Avatar: Der nächste Angriff verursacht heiligen Schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avatar: Next attack deals Holy damage"
