    "summary.battlestate_effectsummaries.0bdf6333f6e4": {
      "comment": "Packages/BattleEngine/Sources/BattleEngine/State/BattleState+EffectSummaries.swift: active effect presentation. Typed quantities retain their combat meaning; nested resources are names or duration clauses.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunst der Viper: Der nächste Treffer einer manuell gespielten Karte, der Gesundheit abzieht, verursacht zusätzlichen Gift- und Blutungsschaden, jeweils in Höhe der Hälfte der verlorenen Gesundheit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Viper’s Courtesy: Your next manually played card hit that removes Health deals additional Poison and Bleed damage, each equal to half the Health lost"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La courtoisie de la vipère : le prochain impact d’une carte jouée manuellement qui fait perdre de la Santé inflige des dégâts supplémentaires de Poison et de Saignement, chaque type infligeant la moitié de la Santé perdue"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毒蛇の礼儀：手動で使ったカードの攻撃で次に体力を減らしたとき、失われた体力の半分に等しい毒ダメージと出血ダメージをそれぞれ追加で与える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "독사의 예의: 다음에 직접 사용하는 카드의 적중이 체력을 깎으면, 잃은 체력의 절반만큼 독 및 출혈 추가 피해를 각각 줌"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "毒蛇禮遇：下次手動出牌的命中使敵人失去生命值時，額外造成中毒與流血傷害，各等於失去的生命值的一半"
          }
        }
      }
    },
