    "talents.panther_bleed_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: panther_bleed_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">Blutende</keyword> Gegner stellen halb so viel <keyword id=\"health\">Gesundheit</keyword> wieder her"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">Bleeding</keyword> enemies restore half as much <keyword id=\"health\">Health</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los enemigos con <keyword id=\"bleed\">Sangrado</keyword> restauran la mitad de la cantidad normal de <keyword id=\"health\">Salud</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les ennemis sous <keyword id=\"bleed\">Saignement</keyword> restaurent moitié moins de <keyword id=\"health\">Santé</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">出血</keyword>状態の敵の<keyword id=\"health\">体力</keyword>回復量が半減"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">출혈</keyword> 상태인 적의 <keyword id=\"health\">체력</keyword> 회복량이 절반으로 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Inimigos com <keyword id=\"bleed\">Sangramento</keyword> restauram apenas metade da quantidade normal de <keyword id=\"health\">Vida</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">流血</keyword>的敵人恢復的<keyword id=\"health\">生命值</keyword>減半"}}
      }
    },
