    "talents.warlock_mana_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: warlock_mana_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Mit <keyword id=\"mana\">Mana</keyword> verstärkte kritische Treffer verursachen <value id=\"quantity_1\">%1$lld</value>%% mehr Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">Mana</keyword>-empowered Critical Hits deal <value id=\"quantity_1\">%1$lld</value>%% more damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los golpes críticos potenciados con <keyword id=\"mana\">Maná</keyword> infligen un <value id=\"quantity_1\">%1$lld</value>%% más de daño"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les coups critiques renforcés au <keyword id=\"mana\">Mana</keyword> infligent <value id=\"quantity_1\">%1$lld</value>%% de dégâts en plus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">マナ</keyword>で強化したクリティカルヒットのダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">마나</keyword>로 강화한 치명타의 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Golpes críticos fortalecidos com <keyword id=\"mana\">Mana</keyword> causam <value id=\"quantity_1\">%1$lld</value>%% mais dano"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">魔力</keyword>強化的暴擊傷害提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
