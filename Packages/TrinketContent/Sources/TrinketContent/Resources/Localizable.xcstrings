    "talents.warlock_mana_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: warlock_mana_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword>, wenn du <keyword id=\"health\">Gesundheit</keyword> verlierst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gain <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword> when you lose <keyword id=\"health\">Health</keyword>"
