    "talents.fox_dodge_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: fox_dodge_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<value id=\"quantity_1\">%1$lld</value>%% Chance, einen Angriff auf einen Verbündeten abzufangen und ihm durch <keyword id=\"dodge\">Ausweichen</keyword> zu entgehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<value id=\"quantity_1\">%1$lld</value>%% chance to intercept and <keyword id=\"dodge\">Dodge</keyword> for an ally"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<value id=\"quantity_1\">%1$lld</value>%% de chances d’intercepter une attaque visant un allié et d’effectuer une <keyword id=\"dodge\">Esquive</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<value id=\"quantity_1\">%1$lld</value>%%の確率で味方への攻撃を引き受けて<keyword id=\"dodge\">回避</keyword>"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<value id=\"quantity_1\">%1$lld</value>%% 확률로 아군 대신 공격을 가로막고 <keyword id=\"dodge\">회피</keyword>"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有<value id=\"quantity_1\">%1$lld</value>%%機率為友方攔截攻擊並<keyword id=\"dodge\">閃避</keyword>"
          }
        }
      }
    },
