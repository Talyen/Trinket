    "authored.83333795ca476074": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog+Ranged.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Einmal pro Zug: Ausweichen bringt deine zuletzt gespielte Angriffskarte auf deine Hand zurück"}},
        "en": {"stringUnit": {"state": "translated", "value": "Once per turn, Dodging returns your last attack card"}},
        "es": {"stringUnit": {"state": "translated", "value": "Una vez por turno, esquivar devuelve a tu mano la última carta de ataque que jugaste"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Une fois par tour, une esquive renvoie dans votre main la dernière carte d’attaque que vous avez jouée"}},
        "ja": {"stringUnit": {"state": "translated", "value": "1ターンに1回、回避すると最後に使った攻撃カードが手札に戻る"}},
        "ko": {"stringUnit": {"state": "translated", "value": "턴마다 한 번, 회피 시 마지막으로 사용한 공격 카드를 손패로 반환"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Uma vez por turno, esquivar devolve à sua mão a última carta de ataque que você jogou"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每回合一次，閃避時將你最後打出的攻擊卡牌返回手牌"}}
      }
    },
    "authored.84aa5a2803ca4647": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Encounters/Rewards/RewardModifier.swift: computed title",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Waffenhort"}},
        "en": {"stringUnit": {"state": "translated", "value": "Arms Hoard"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tesoro de armas"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Trésor d’armes"}},
        "ja": {"stringUnit": {"state": "translated", "value": "武器の宝庫"}},
        "ko": {"stringUnit": {"state": "translated", "value": "무기 보물 무더기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Tesouro de Armas"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "武器寶庫"}}
      }
    },
    "authored.84db54a03c7a660e": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog+Accessory.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wenn du eine <keyword id=\"freeze\">Frost</keyword>-Karte verstärkst, gib pro fehlendem <keyword id=\"mana\">Mana</keyword> <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword> aus"}},
        "en": {"stringUnit": {"state": "translated", "value": "When empowering a <keyword id=\"freeze\">Freeze</keyword> card, spend <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword> per missing <keyword id=\"mana\">Mana</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Al potenciar una carta de <keyword id=\"freeze\">Congelación</keyword>, gasta <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueo</keyword> por cada punto de <keyword id=\"mana\">Maná</keyword> que falte"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Renforcer une carte de <keyword id=\"freeze\">Gel</keyword> dépense <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Blocage</keyword> par <keyword id=\"mana\">Mana</keyword> manquant"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">凍結</keyword>カードを強化する際、不足する<keyword id=\"mana\">マナ</keyword>1につき<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>消費"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">빙결</keyword> 카드 강화 시 부족한 <keyword id=\"mana\">마나</keyword> 1당 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 소모"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ao fortalecer uma carta de <keyword id=\"freeze\">Congelamento</keyword>, gaste <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueio</keyword> por <keyword id=\"mana\">Mana</keyword> que faltar"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "強化<keyword id=\"freeze\">冰凍</keyword>卡牌時，每缺少一點<keyword id=\"mana\">魔力</keyword>，消耗<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>"}}
      }
    },
