    "affixes.shattering.astral_description": {
      "comment": "ContentManifest/affixes.tsv: shattering, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wenn du einen Gegner einfrierst, verursache <value id=\"quantity_1\">%1$lld</value> <keyword id=\"physical\">physischen</keyword> Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Freezing an enemy deals <value id=\"quantity_1\">%1$lld</value> <keyword id=\"physical\">Physical</keyword> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Congelar a un enemigo inflige <value id=\"quantity_1\">%1$lld</value> de daño <keyword id=\"physical\">físico</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Geler un ennemi inflige <value id=\"quantity_1\">%1$lld</value> dégâts <keyword id=\"physical\">physiques</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "敵を凍結させると、<value id=\"quantity_1\">%1$lld</value>の<keyword id=\"physical\">物理</keyword>ダメージを与える"}},
        "ko": {"stringUnit": {"state": "translated", "value": "적을 빙결시키면 <keyword id=\"physical\">물리</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Congelar um inimigo causa <value id=\"quantity_1\">%1$lld</value> de dano <keyword id=\"physical\">físico</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "凍結敵人時造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"physical\">物理</keyword>傷害"}}
      }
    },
