    "talents.frost_whelp_mana_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: frost_whelp_mana_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verstärken mit <keyword id=\"mana\">Mana</keyword> fügt <keyword id=\"freeze\">Frost</keyword>-Angriffen <value id=\"quantity_1\">%1$lld</value> Schaden hinzu"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">Mana</keyword> empowerment adds <value id=\"quantity_1\">%1$lld</value> damage to <keyword id=\"freeze\">Freeze</keyword> attacks"}},
        "es": {"stringUnit": {"state": "translated", "value": "Potenciar con <keyword id=\"mana\">Maná</keyword> añade <value id=\"quantity_1\">%1$lld</value> de daño a los ataques de <keyword id=\"freeze\">Congelación</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Un renforcement au <keyword id=\"mana\">Mana</keyword> ajoute <value id=\"quantity_1\">%1$lld</value> dégâts aux attaques de <keyword id=\"freeze\">Gel</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">マナ</keyword>で強化すると<keyword id=\"freeze\">凍結</keyword>攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">마나</keyword>로 강화 시 <keyword id=\"freeze\">빙결</keyword> 공격의 피해 <value id=\"quantity_1\">%1$lld</value> 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Fortalecer com <keyword id=\"mana\">Mana</keyword> adiciona <value id=\"quantity_1\">%1$lld</value> de dano a ataques de <keyword id=\"freeze\">Congelamento</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "以<keyword id=\"mana\">魔力</keyword>強化時，<keyword id=\"freeze\">冰凍</keyword>攻擊的傷害增加<value id=\"quantity_1\">%1$lld</value>點"}}
      }
    },
