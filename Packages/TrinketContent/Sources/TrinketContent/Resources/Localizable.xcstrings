    "authored.0f3925b4d796195e": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Encounters/Mystery/MysteryEventPool+Events.swift: narrative",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein uraltes Skelett bewacht „%1$@“, während rund um „%2$@“ Goldmünzen verstreut liegen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An ancient skeleton guards “%1$@” while gold coins spill around “%2$@”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ancien squelette garde « %1$@ », tandis que des pièces d’or se répandent autour de « %2$@ »"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古代の骸骨が「%1$@」を守り、「%2$@」の周りには金貨がこぼれている"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고대 해골이 지키는 것은 ‘%1$@’, ‘%2$@’ 주위에는 금화가 쏟아져 있습니다"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "古老骷髏守護著「%1$@」，金幣散落在「%2$@」四周"
          }
        }
      }
    },
