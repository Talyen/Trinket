    "talents.alchemist_cleanse_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: alchemist_cleanse_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"variations": {"plural": {"one": {"stringUnit": {"state": "translated", "value": "Fähigkeiten, die <keyword id=\"health\">Gesundheit</keyword> wiederherstellen, <keyword id=\"cleanse\">reinigen</keyword> auch <value id=\"quantity_1\">%1$lld</value> Schwächungseffekt"}}, "other": {"stringUnit": {"state": "translated", "value": "Fähigkeiten, die <keyword id=\"health\">Gesundheit</keyword> wiederherstellen, <keyword id=\"cleanse\">reinigen</keyword> auch <value id=\"quantity_1\">%1$lld</value> Schwächungseffekte"}}}}},
        "en": {"variations": {"plural": {"one": {"stringUnit": {"state": "translated", "value": "Abilities that restore <keyword id=\"health\">Health</keyword> also <keyword id=\"cleanse\">Cleanse</keyword> <value id=\"quantity_1\">%1$lld</value> debuff"}}, "other": {"stringUnit": {"state": "translated", "value": "Abilities that restore <keyword id=\"health\">Health</keyword> also <keyword id=\"cleanse\">Cleanse</keyword> <value id=\"quantity_1\">%1$lld</value> debuffs"}}}}},
        "es": {"variations": {"plural": {"many": {"stringUnit": {"state": "translated", "value": "Las habilidades que restauran <keyword id=\"health\">Salud</keyword> también <keyword id=\"cleanse\">purifican</keyword> <value id=\"quantity_1\">%1$lld</value> perjuicios"}}, "one": {"stringUnit": {"state": "translated", "value": "Las habilidades que restauran <keyword id=\"health\">Salud</keyword> también <keyword id=\"cleanse\">purifican</keyword> <value id=\"quantity_1\">%1$lld</value> perjuicio"}}, "other": {"stringUnit": {"state": "translated", "value": "Las habilidades que restauran <keyword id=\"health\">Salud</keyword> también <keyword id=\"cleanse\">purifican</keyword> <value id=\"quantity_1\">%1$lld</value> perjuicios"}}}}},
        "fr": {"variations": {"plural": {"many": {"stringUnit": {"state": "translated", "value": "Les capacités qui rendent de la <keyword id=\"health\">Santé</keyword> déclenchent aussi la <keyword id=\"cleanse\">Purification</keyword> de <value id=\"quantity_1\">%1$lld</value> malus"}}, "one": {"stringUnit": {"state": "translated", "value": "Les capacités qui rendent de la <keyword id=\"health\">Santé</keyword> déclenchent aussi la <keyword id=\"cleanse\">Purification</keyword> de <value id=\"quantity_1\">%1$lld</value> malus"}}, "other": {"stringUnit": {"state": "translated", "value": "Les capacités qui rendent de la <keyword id=\"health\">Santé</keyword> déclenchent aussi la <keyword id=\"cleanse\">Purification</keyword> de <value id=\"quantity_1\">%1$lld</value> malus"}}}}},
        "ja": {"variations": {"plural": {"other": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>を回復するアビリティは弱体効果も<value id=\"quantity_1\">%1$lld</value>個<keyword id=\"cleanse\">浄化</keyword>"}}}}},
        "ko": {"variations": {"plural": {"other": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword>을 회복하는 능력이 약화 효과 <value id=\"quantity_1\">%1$lld</value>개도 <keyword id=\"cleanse\">정화</keyword>"}}}}},
        "pt-BR": {"variations": {"plural": {"many": {"stringUnit": {"state": "translated", "value": "Habilidades que restauram <keyword id=\"health\">Vida</keyword> também <keyword id=\"cleanse\">Purificam</keyword> <value id=\"quantity_1\">%1$lld</value> efeitos negativos"}}, "one": {"stringUnit": {"state": "translated", "value": "Habilidades que restauram <keyword id=\"health\">Vida</keyword> também <keyword id=\"cleanse\">Purificam</keyword> <value id=\"quantity_1\">%1$lld</value> efeito negativo"}}, "other": {"stringUnit": {"state": "translated", "value": "Habilidades que restauram <keyword id=\"health\">Vida</keyword> também <keyword id=\"cleanse\">Purificam</keyword> <value id=\"quantity_1\">%1$lld</value> efeitos negativos"}}}}},
        "zh-Hant": {"variations": {"plural": {"other": {"stringUnit": {"state": "translated", "value": "恢復<keyword id=\"health\">生命值</keyword>的能力也會<keyword id=\"cleanse\">淨化</keyword><value id=\"quantity_1\">%1$lld</value>項減益效果"}}}}}
      }
    },
