    "homestead_nodes.library.1.summary": {
      "comment": "ContentManifest/homestead_nodes.tsv: library.1, summary",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Uraltes Wissen verwandelt hart erkämpfte Erfahrung in bleibende Erkenntnis"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancient knowledge turns hard-won experience into lasting insight"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le savoir antique transforme l’expérience durement acquise en connaissance durable"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古代の知識が、苦労して得た経験を永続する知恵へと変える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고대의 지식이 힘들게 쌓은 경험을 영원한 깨달음으로 바꿉니다"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "古老知識將辛苦得來的經驗化為長久智慧"
          }
        }
      }
    },
