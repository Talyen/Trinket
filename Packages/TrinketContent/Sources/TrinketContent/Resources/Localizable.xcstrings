    "affixes.mortar_and_pestle.astral_description": {
      "comment": "ContentManifest/affixes.tsv: mortar_and_pestle, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dein nächster <keyword id=\"poison\">Gift</keyword>angriff erhält Bonusschaden in Höhe der Hälfte deiner zuletzt erhaltenen Heilung"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your next <keyword id=\"poison\">Poison</keyword> attack gains bonus damage equal to half your latest healing received"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu siguiente ataque de <keyword id=\"poison\">Veneno</keyword> obtiene daño adicional equivalente a la mitad de la última curación que recibiste"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre prochaine attaque de <keyword id=\"poison\">Poison</keyword> gagne des dégâts bonus égaux à la moitié des derniers soins reçus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "次の<keyword id=\"poison\">毒</keyword>攻撃のダメージが、最後に受けた回復量の半分増加する"}},
        "ko": {"stringUnit": {"state": "translated", "value": "다음 <keyword id=\"poison\">독</keyword> 공격이 마지막으로 받은 치유량의 절반만큼 추가 피해를 얻습니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seu próximo ataque de <keyword id=\"poison\">Veneno</keyword> ganha dano adicional igual à metade da última cura recebida"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "你的下一次<keyword id=\"poison\">中毒</keyword>攻擊會獲得相當於最近一次所受治療量一半的額外傷害"}}
      }
    },
    "affixes.mortar_and_pestle.basic_description": {
      "comment": "ContentManifest/affixes.tsv: mortar_and_pestle, basic_description",
      "extractionState": "manual",
