      "comment": "ContentManifest/talents.tsv: panther_leech_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Kritische <keyword id=\"bleed\">Blutungs</keyword>-Treffer erhalten <keyword id=\"leech\">Lebensraub</keyword>"}},
