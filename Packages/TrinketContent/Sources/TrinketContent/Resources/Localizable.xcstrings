    "traits.reform.description": {
      "comment": "ContentManifest/traits.tsv: reform, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Stellt zu Beginn jedes Zuges <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Gesundheit</keyword> wieder her"}},
        "en": {"stringUnit": {"state": "translated", "value": "Restore <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Health</keyword> at the start of each turn"}},
        "es": {"stringUnit": {"state": "translated", "value": "Recupera <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Salud</keyword> al inicio de cada turno"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Restaure <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Santé</keyword> au début de chaque tour"}},
        "ja": {"stringUnit": {"state": "translated", "value": "各ターン開始時に<keyword id=\"health\">体力</keyword>を<value id=\"quantity_1\">%1$lld</value>回復する"}},
        "ko": {"stringUnit": {"state": "translated", "value": "매 턴 시작 시 <keyword id=\"health\">체력</keyword>을 <value id=\"quantity_1\">%1$lld</value> 회복한다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Recupera <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Vida</keyword> no início de cada turno"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每回合開始時恢復<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"health\">生命值</keyword>"}}
      }
    },
    "traits.reform.name": {
      "comment": "ContentManifest/traits.tsv: reform, name",
