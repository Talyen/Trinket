    "talents.fox_dodge_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: fox_dodge_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Nach dem Ausweichen ignoriert dein nächster Angriff gegnerischen <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Dodging makes your next attack ignore enemy <keyword id=\"block\">Block</keyword>"}},
