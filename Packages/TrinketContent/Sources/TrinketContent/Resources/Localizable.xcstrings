    "homestead_nodes.moonlitsanctum.1.summary": {
      "comment": "ContentManifest/homestead_nodes.tsv: moonlitSanctum.1, summary",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein stilles Heiligtum zum Aufspüren seltener Funde und widernatürlicher Gefahren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A quiet sanctum for sensing rare finds and unnatural threats"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un sanctuaire paisible pour déceler les trouvailles rares et les menaces surnaturelles"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "希少な発見と異形の脅威を感じ取る、静かな聖所"
          }
