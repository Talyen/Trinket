    "talents.wizard_mana_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: wizard_mana_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kritische <keyword id=\"freeze\">Frost</keyword>-Treffer stellen <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword> wieder her"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"freeze\">Freeze</keyword> Critical Hits restore <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les coups critiques de <keyword id=\"freeze\">Gel</keyword> restaurent <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"freeze\">凍結</keyword>クリティカルヒットで<keyword id=\"mana\">マナ</keyword>を<value id=\"quantity_1\">%1$lld</value>回復"
          }
