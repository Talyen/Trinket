    "traits.bloodletting.description": {
      "comment": "ContentManifest/traits.tsv: bloodletting, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Jeder Angriffstreffer verursacht <value id=\"quantity_1\">%1$lld</value> <keyword id=\"bleed\">Blutung</keyword>."}},
        "en": {"stringUnit": {"state": "translated", "value": "Attack hits inflict <value id=\"quantity_1\">%1$lld</value> <keyword id=\"bleed\">Bleed</keyword>."}},
        "es": {"stringUnit": {"state": "translated", "value": "Cada impacto de ataque aplica <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"bleed\">Sangrado</keyword>."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Chaque coup d’une attaque applique <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"bleed\">Saignement</keyword>."}},
        "ja": {"stringUnit": {"state": "translated", "value": "攻撃の各ヒットで<keyword id=\"bleed\">出血</keyword>を<value id=\"quantity_1\">%1$lld</value>付与する。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "공격이 적중할 때마다 <keyword id=\"bleed\">출혈</keyword>을 <value id=\"quantity_1\">%1$lld</value> 부여한다."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cada acerto de ataque aplica <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"bleed\">Sangramento</keyword>."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每次攻擊命中時，施加<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"bleed\">流血</keyword>。"}}
      }
    },
    "traits.bloodletting.name": {
      "comment": "ContentManifest/traits.tsv: bloodletting, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Aderlass"}},
        "en": {"stringUnit": {"state": "translated", "value": "Bloodletting"}},
        "es": {"stringUnit": {"state": "translated", "value": "Sangría"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Saignée"}},
        "ja": {"stringUnit": {"state": "translated", "value": "瀉血"}},
        "ko": {"stringUnit": {"state": "translated", "value": "방혈"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Sangria"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "放血"}}
      }
    },
    "traits.bulwark_force.description": {
      "comment": "ContentManifest/traits.tsv: bulwark_force, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Solange es <keyword id=\"block\">Block</keyword> hat, verursachen seine Angriffe <value id=\"quantity_1\">%1$lld</value> zusätzlichen Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Attacks deal <value id=\"quantity_1\">%1$lld</value> additional damage while it has <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Mientras tiene <keyword id=\"block\">Bloqueo</keyword>, sus ataques infligen <value id=\"quantity_1\">%1$lld</value> de daño adicional"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Tant qu’il a du <keyword id=\"block\">Blocage</keyword>, les dégâts de ses attaques augmentent de <value id=\"quantity_1\">%1$lld</value>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">ブロック</keyword>がある間、攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">방어도</keyword>가 있는 동안 공격 피해가 <value id=\"quantity_1\">%1$lld</value> 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Enquanto tiver <keyword id=\"block\">Bloqueio</keyword>, seus ataques causam <value id=\"quantity_1\">%1$lld</value> de dano adicional"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "擁有<keyword id=\"block\">格擋</keyword>時，攻擊額外造成<value id=\"quantity_1\">%1$lld</value>點傷害"}}
      }
    },
    "traits.bulwark_force.name": {
      "comment": "ContentManifest/traits.tsv: bulwark_force, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Bollwerkkraft"}},
        "en": {"stringUnit": {"state": "translated", "value": "Bulwark Force"}},
        "es": {"stringUnit": {"state": "translated", "value": "Fuerza de baluarte"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Force du rempart"}},
        "ja": {"stringUnit": {"state": "translated", "value": "防壁の力"}},
        "ko": {"stringUnit": {"state": "translated", "value": "방벽의 힘"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Força do Baluarte"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "壁壘之力"}}
      }
    },
    "traits.chilling_strikes.description": {
      "comment": "ContentManifest/traits.tsv: chilling_strikes, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Jeder Angriffstreffer verursacht <value id=\"quantity_1\">%1$lld</value> zusätzlichen <keyword id=\"freeze\">Frost</keyword>schaden."}},
        "en": {"stringUnit": {"state": "translated", "value": "Attack hits deal <value id=\"quantity_1\">%1$lld</value> additional <keyword id=\"freeze\">Freeze</keyword> damage."}},
        "es": {"stringUnit": {"state": "translated", "value": "Cada impacto de ataque inflige <value id=\"quantity_1\">%1$lld</value> de daño adicional de <keyword id=\"freeze\">Congelación</keyword>."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Chaque coup d’une attaque inflige <value id=\"quantity_1\">%1$lld</value> de dégâts de <keyword id=\"freeze\">Gel</keyword> supplémentaires."}},
        "ja": {"stringUnit": {"state": "translated", "value": "攻撃の各ヒットで追加の<keyword id=\"freeze\">凍結</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "공격이 적중할 때마다 <keyword id=\"freeze\">빙결</keyword> 피해를 <value id=\"quantity_1\">%1$lld</value> 추가로 준다."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cada acerto de ataque causa <value id=\"quantity_1\">%1$lld</value> de dano adicional de <keyword id=\"freeze\">Congelamento</keyword>."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每次攻擊命中時，額外造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"freeze\">冰凍</keyword>傷害。"}}
      }
    },
    "traits.chilling_strikes.name": {
      "comment": "ContentManifest/traits.tsv: chilling_strikes, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Kühlende Schläge"}},
        "en": {"stringUnit": {"state": "translated", "value": "Chilling Strikes"}},
        "es": {"stringUnit": {"state": "translated", "value": "Golpes gélidos"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Frappes glaciales"}},
        "ja": {"stringUnit": {"state": "translated", "value": "冷たい連撃"}},
        "ko": {"stringUnit": {"state": "translated", "value": "차가운 연격"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Golpes Gélidos"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "寒冷打擊"}}
      }
    },
    "traits.cold_shocked.description": {
      "comment": "ContentManifest/traits.tsv: cold_shocked, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erlittener <keyword id=\"freeze\">Frost</keyword>schaden um <value id=\"quantity_1\">%1$lld</value>%% erhöht"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">Freeze</keyword> damage taken increased by <value id=\"quantity_1\">%1$lld</value>%%"}},
        "es": {"stringUnit": {"state": "translated", "value": "Daño de <keyword id=\"freeze\">Congelación</keyword> recibido aumentado en un <value id=\"quantity_1\">%1$lld</value>%%"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Dégâts de <keyword id=\"freeze\">Gel</keyword> subis augmentés de <value id=\"quantity_1\">%1$lld</value>%%"}},
        "ja": {"stringUnit": {"state": "translated", "value": "受ける<keyword id=\"freeze\">凍結</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "받는 <keyword id=\"freeze\">빙결</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Dano de <keyword id=\"freeze\">Congelamento</keyword> recebido aumentado em <value id=\"quantity_1\">%1$lld</value>%%"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "承受的<keyword id=\"freeze\">冰凍</keyword>傷害增加<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "traits.cold_shocked.name": {
      "comment": "ContentManifest/traits.tsv: cold_shocked, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Kälteschock"}},
        "en": {"stringUnit": {"state": "translated", "value": "Cold-Shocked"}},
        "es": {"stringUnit": {"state": "translated", "value": "Choque de frío"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Choc du froid"}},
        "ja": {"stringUnit": {"state": "translated", "value": "寒さへの弱さ"}},
        "ko": {"stringUnit": {"state": "translated", "value": "냉기 충격"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Choque de Frio"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "寒冷震撼"}}
      }
    },
    "traits.concussion.description": {
      "comment": "ContentManifest/traits.tsv: concussion, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">Betäubung</keyword> verringert den Schaden des nächsten gegnerischen Angriffs um <value id=\"quantity_1\">%1$lld</value>%%."}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">Stun</keyword> weakens the opponent’s next attack by <value id=\"quantity_1\">%1$lld</value>%%."}},
        "es": {"stringUnit": {"state": "translated", "value": "El <keyword id=\"stun\">Aturdimiento</keyword> reduce el daño del siguiente ataque del oponente un <value id=\"quantity_1\">%1$lld</value>%%."}},
        "fr": {"stringUnit": {"state": "translated", "value": "L’<keyword id=\"stun\">Étourdissement</keyword> réduit les dégâts de la prochaine attaque de l’adversaire de <value id=\"quantity_1\">%1$lld</value>%%."}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">スタン</keyword>により、相手の次の攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>%%減少する。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">기절</keyword>이 상대의 다음 공격 피해를 <value id=\"quantity_1\">%1$lld</value>%% 감소시킨다."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O <keyword id=\"stun\">Atordoamento</keyword> reduz o dano do próximo ataque do oponente em <value id=\"quantity_1\">%1$lld</value>%%."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">暈眩</keyword>使對手下次攻擊的傷害降低<value id=\"quantity_1\">%1$lld</value>%%。"}}
      }
    },
    "traits.concussion.name": {
      "comment": "ContentManifest/traits.tsv: concussion, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Gehirnerschütterung"}},
        "en": {"stringUnit": {"state": "translated", "value": "Concussion"}},
        "es": {"stringUnit": {"state": "translated", "value": "Conmoción"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Commotion cérébrale"}},
        "ja": {"stringUnit": {"state": "translated", "value": "震盪"}},
        "ko": {"stringUnit": {"state": "translated", "value": "뇌진탕 증상"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Concussão"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "腦震盪"}}
      }
    },
    "traits.condemn.description": {
      "comment": "ContentManifest/traits.tsv: condemn, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Jeder Angriffstreffer verursacht bei Gegnern mit weniger als der Hälfte ihrer <keyword id=\"health\">Gesundheit</keyword> <value id=\"quantity_1\">%1$lld</value> zusätzlichen Schaden vom Typ <keyword id=\"holy\">Heilig</keyword>."}},
        "en": {"stringUnit": {"state": "translated", "value": "Attack hits deal <value id=\"quantity_1\">%1$lld</value> additional <keyword id=\"holy\">Holy</keyword> damage against opponents below half <keyword id=\"health\">Health</keyword>."}},
        "es": {"stringUnit": {"state": "translated", "value": "Cada impacto de ataque inflige <value id=\"quantity_1\">%1$lld</value> de daño <keyword id=\"holy\">Sagrado</keyword> adicional a oponentes con menos de la mitad de su <keyword id=\"health\">Salud</keyword>."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Chaque coup d’une attaque inflige <value id=\"quantity_1\">%1$lld</value> de dégâts supplémentaires de type <keyword id=\"holy\">Sacré</keyword> aux adversaires ayant moins de la moitié de leur <keyword id=\"health\">Santé</keyword>."}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>が半分未満の相手には、攻撃の各ヒットで追加の<keyword id=\"holy\">聖</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword>이 절반 미만인 상대에게 공격이 적중할 때마다 <keyword id=\"holy\">신성</keyword> 피해를 <value id=\"quantity_1\">%1$lld</value> 추가로 준다."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cada acerto de ataque causa <value id=\"quantity_1\">%1$lld</value> de dano <keyword id=\"holy\">Sagrado</keyword> adicional a oponentes com menos da metade da <keyword id=\"health\">Vida</keyword>."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每次攻擊命中<keyword id=\"health\">生命值</keyword>低於一半的對手時，額外造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"holy\">神聖</keyword>傷害。"}}
      }
    },
    "traits.condemn.name": {
      "comment": "ContentManifest/traits.tsv: condemn, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verurteilung"}},
        "en": {"stringUnit": {"state": "translated", "value": "Condemn"}},
        "es": {"stringUnit": {"state": "translated", "value": "Condena"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Condamnation"}},
        "ja": {"stringUnit": {"state": "translated", "value": "断罪"}},
        "ko": {"stringUnit": {"state": "translated", "value": "단죄"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Condenação"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "定罪"}}
      }
    },
    "traits.corrodible.description": {
      "comment": "ContentManifest/traits.tsv: corrodible, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erlittener Schaden durch <keyword id=\"poison\">Gift</keyword> um <value id=\"quantity_1\">%1$lld</value> %% erhöht"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Poison</keyword> damage taken increased by <value id=\"quantity_1\">%1$lld</value>%%"}},
        "es": {"stringUnit": {"state": "translated", "value": "El daño de <keyword id=\"poison\">Veneno</keyword> recibido aumenta un <value id=\"quantity_1\">%1$lld</value> %%"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les dégâts de <keyword id=\"poison\">Poison</keyword> subis augmentent de <value id=\"quantity_1\">%1$lld</value> %%"}},
        "ja": {"stringUnit": {"state": "translated", "value": "受ける<keyword id=\"poison\">毒</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "받는 <keyword id=\"poison\">독</keyword> 피해가 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O dano de <keyword id=\"poison\">Veneno</keyword> recebido aumenta em <value id=\"quantity_1\">%1$lld</value>%%"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "受到的<keyword id=\"poison\">中毒</keyword>傷害提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "traits.corrodible.name": {
      "comment": "ContentManifest/traits.tsv: corrodible, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Korrosionsanfällig"}},
        "en": {"stringUnit": {"state": "translated", "value": "Corrodible"}},
        "es": {"stringUnit": {"state": "translated", "value": "Corrosible"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Corrodable"}},
        "ja": {"stringUnit": {"state": "translated", "value": "腐食しやすい"}},
        "ko": {"stringUnit": {"state": "translated", "value": "부식에 취약"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Corrosível"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "易腐蝕"}}
      }
    },
    "traits.corrosive_venom.description": {
      "comment": "ContentManifest/traits.tsv: corrosive_venom, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Gift</keyword> entfernt <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>, bevor es der <keyword id=\"health\">Gesundheit</keyword> schadet"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Poison</keyword> strips <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword> before damaging <keyword id=\"health\">Health</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Veneno</keyword> elimina <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueo</keyword> antes de dañar la <keyword id=\"health\">Salud</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le <keyword id=\"poison\">Poison</keyword> retire <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Blocage</keyword> avant d’infliger des dégâts à la <keyword id=\"health\">Santé</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">毒</keyword>が<keyword id=\"health\">体力</keyword>にダメージを与える前に<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>削る"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">독</keyword>이 <keyword id=\"health\">체력</keyword>에 피해를 주기 전에 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 제거"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Veneno</keyword> remove <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueio</keyword> antes de causar dano à <keyword id=\"health\">Vida</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">中毒</keyword>在傷害<keyword id=\"health\">生命值</keyword>前，先削除<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>"}}
      }
    },
    "traits.corrosive_venom.name": {
      "comment": "ContentManifest/traits.tsv: corrosive_venom, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ätzendes Gift"}},
        "en": {"stringUnit": {"state": "translated", "value": "Corrosive Venom"}},
        "es": {"stringUnit": {"state": "translated", "value": "Veneno corrosivo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Venin corrosif"}},
        "ja": {"stringUnit": {"state": "translated", "value": "腐食の毒"}},
        "ko": {"stringUnit": {"state": "translated", "value": "부식 맹독"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Peçonha Corrosiva"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "腐蝕毒液"}}
      }
    },
    "traits.cowardly.description": {
      "comment": "ContentManifest/traits.tsv: cowardly, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Solange seine <keyword id=\"health\">Gesundheit</keyword> unter der Hälfte liegt, verursachen seine Angriffe <value id=\"quantity_1\">%1$lld</value> weniger Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Attacks deal <value id=\"quantity_1\">%1$lld</value> less damage while below half <keyword id=\"health\">Health</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Mientras su <keyword id=\"health\">Salud</keyword> está por debajo de la mitad, sus ataques infligen <value id=\"quantity_1\">%1$lld</value> menos de daño"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Tant que sa <keyword id=\"health\">Santé</keyword> est inférieure à la moitié, les dégâts de ses attaques diminuent de <value id=\"quantity_1\">%1$lld</value>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "自身の<keyword id=\"health\">体力</keyword>が半分未満の間、攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>減少"}},
        "ko": {"stringUnit": {"state": "translated", "value": "자신의 <keyword id=\"health\">체력</keyword>이 절반 미만인 동안 공격 피해가 <value id=\"quantity_1\">%1$lld</value> 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Enquanto sua <keyword id=\"health\">Vida</keyword> estiver abaixo da metade, seus ataques causam <value id=\"quantity_1\">%1$lld</value> a menos de dano"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "自身<keyword id=\"health\">生命值</keyword>低於一半時，攻擊傷害降低<value id=\"quantity_1\">%1$lld</value>點"}}
      }
    },
