            "value": "Erhöhe <keyword id=\"freeze\">Frost</keyword>schaden um <value id=\"quantity_1\">%1$lld</value>%%\nErhöhe <keyword id=\"holy\">heiligen</keyword> Schaden um <value id=\"quantity_2\">%2$lld</value>%%\nProduziere <value id=\"quantity_3\">%3$lld</value> Edelsteine pro Tag"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Increase <keyword id=\"freeze\">Freeze</keyword> damage by <value id=\"quantity_1\">%1$lld</value>%%\nIncrease <keyword id=\"holy\">Holy</keyword> damage by <value id=\"quantity_2\">%2$lld</value>%%\nProduce <value id=\"quantity_3\">%3$lld</value> Gems per Day"
