    "talents.shield_scarab_stun_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: shield_scarab_stun_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Betäuben eines Gegners verursacht <value id=\"quantity_1\">%1$lld</value> <keyword id=\"burn\">Brand</keyword>schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stunning an enemy deals <value id=\"quantity_1\">%1$lld</value> <keyword id=\"burn\">Burn</keyword> damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Étourdir un ennemi inflige <value id=\"quantity_1\">%1$lld</value> dégâts de <keyword id=\"burn\">Brûlure</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "敵をスタン状態にすると<keyword id=\"burn\">炎上</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적을 기절시키면 <keyword id=\"burn\">화상</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使敵人暈眩時，造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"burn\">燃燒</keyword>傷害"
          }
        }
      }
    },
