    "talents.rogue_bleed_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: rogue_bleed_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Besiegen <keyword id=\"bleed\">blutender</keyword> Gegner gewährt <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Gold</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Defeating <keyword id=\"bleed\">Bleeding</keyword> enemies grants <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Gold</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terrasser un ennemi sous <keyword id=\"bleed\">Saignement</keyword> octroie <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Or</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"bleed\">出血</keyword>状態の敵を倒すと<keyword id=\"gold\">ゴールド</keyword>を<value id=\"quantity_1\">%1$lld</value>獲得"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"bleed\">출혈</keyword> 상태의 적 처치 시 <keyword id=\"gold\">골드</keyword> <value id=\"quantity_1\">%1$lld</value> 획득"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擊敗<keyword id=\"bleed\">流血</keyword>的敵人時，獲得<value id=\"quantity_1\">%1$lld</value><keyword id=\"gold\">金幣</keyword>"
          }
        }
      }
    },
    "talents.rogue_bleed_t2_2.name": {
      "comment": "ContentManifest/talents.tsv: rogue_bleed_t2_2, name",
      "extractionState": "manual",
