    "homestead_nodes.culinaryarts.1.bonus_description": {
      "comment": "ContentManifest/homestead_nodes.tsv: culinaryArts.1, bonus_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle <value id=\"quantity_1\">%1$lld</value>%% mehr <keyword id=\"health\">Gesundheit</keyword> wieder her\nProduziere <value id=\"quantity_2\">%2$lld</value> Nahrung pro Tag"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore <value id=\"quantity_1\">%1$lld</value>%% more <keyword id=\"health\">Health</keyword>\nProduce <value id=\"quantity_2\">%2$lld</value> Food per Day"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">Santé</keyword> restaurée augmentée de <value id=\"quantity_1\">%1$lld</value>%%\nProduit <value id=\"quantity_2\">%2$lld</value> nourriture par jour"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">体力</keyword>回復量が<value id=\"quantity_1\">%1$lld</value>%%増加\n1日に食料を<value id=\"quantity_2\">%2$lld</value>生産"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">체력</keyword> 회복량 <value id=\"quantity_1\">%1$lld</value>%% 증가\n하루에 식량 <value id=\"quantity_2\">%2$lld</value>개 생산"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復的<keyword id=\"health\">生命值</keyword>增加<value id=\"quantity_1\">%1$lld</value>%%\n每天生產<value id=\"quantity_2\">%2$lld</value>食物"
          }
        }
      }
    },
