    "homestead_nodes.herbgarden.1.bonus_description": {
      "comment": "ContentManifest/homestead_nodes.tsv: herbGarden.1, bonus_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erleide <value id=\"quantity_1\">%1$lld</value>%% weniger <keyword id=\"poison\">Gift</keyword>schaden\nKräuterproduktion pro Tag: <value id=\"quantity_2\">%2$lld</value>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Take <value id=\"quantity_1\">%1$lld</value>%% less <keyword id=\"poison\">Poison</keyword> damage\nProduce <value id=\"quantity_2\">%2$lld</value> Herbs per Day"}},
        "es": {"stringUnit": {"state": "translated", "value": "Recibe un <value id=\"quantity_1\">%1$lld</value>%% menos de daño de <keyword id=\"poison\">Veneno</keyword>\nProducción diaria de hierbas: <value id=\"quantity_2\">%2$lld</value>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Dégâts de <keyword id=\"poison\">Poison</keyword> subis réduits de <value id=\"quantity_1\">%1$lld</value>%%\nProduction quotidienne d’herbes : <value id=\"quantity_2\">%2$lld</value>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "受ける<keyword id=\"poison\">毒</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%減少\n1日に薬草を<value id=\"quantity_2\">%2$lld</value>生産"}},
        "ko": {"stringUnit": {"state": "translated", "value": "받는 <keyword id=\"poison\">독</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>%% 감소\n하루에 약초 <value id=\"quantity_2\">%2$lld</value>개 생산"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Receba <value id=\"quantity_1\">%1$lld</value>%% menos dano de <keyword id=\"poison\">Veneno</keyword>\nProdução diária de Ervas: <value id=\"quantity_2\">%2$lld</value>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "承受的<keyword id=\"poison\">中毒</keyword>傷害降低<value id=\"quantity_1\">%1$lld</value>%%\n每天生產<value id=\"quantity_2\">%2$lld</value>藥草"}}
      }
    },
