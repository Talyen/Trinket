    "talents.druid_health_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: druid_health_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du deinen Gefährten heilst, stelle auch halb so viel eigene <keyword id=\"health\">Gesundheit</keyword> wieder her"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Healing your Companion also restores half as much of your <keyword id=\"health\">Health</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soigner votre Compagnon restaure aussi la moitié de ce montant à votre <keyword id=\"health\">Santé</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仲間を回復すると、その半分の量だけ自分の<keyword id=\"health\">体力</keyword>も回復"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동료 치유 시 그 절반만큼 내 <keyword id=\"health\">체력</keyword>도 회복"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "治療夥伴時，也為自身恢復相當於該治療量一半的<keyword id=\"health\">生命值</keyword>"
          }
        }
      }
    },
