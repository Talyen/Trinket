    "talents.alchemist_poison_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: alchemist_poison_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Gift</keyword>-Angriffe ignorieren gegnerische <keyword id=\"thorns\">Dornen</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Poison</keyword> attacks ignore enemy <keyword id=\"thorns\">Thorns</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques de <keyword id=\"poison\">Veneno</keyword> ignoran las <keyword id=\"thorns\">Espinas</keyword> del enemigo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques de <keyword id=\"poison\">Poison</keyword> ignorent les <keyword id=\"thorns\">Épines</keyword> ennemies"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">毒</keyword>攻撃が敵の<keyword id=\"thorns\">棘</keyword>を無視"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">독</keyword> 공격이 적의 <keyword id=\"thorns\">가시</keyword> 무시"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques de <keyword id=\"poison\">Veneno</keyword> ignoram os <keyword id=\"thorns\">Espinhos</keyword> inimigos"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">中毒</keyword>攻擊無視敵人<keyword id=\"thorns\">荊棘</keyword>"}}
      }
    },
    "talents.alchemist_poison_t1_2.name": {
      "comment": "ContentManifest/talents.tsv: alchemist_poison_t1_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Sicherer Umgang"}},
        "en": {"stringUnit": {"state": "translated", "value": "Safe Handling"}},
        "es": {"stringUnit": {"state": "translated", "value": "Manejo seguro"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Manipulation sûre"}},
        "ja": {"stringUnit": {"state": "translated", "value": "安全な取り扱い"}},
        "ko": {"stringUnit": {"state": "translated", "value": "안전한 취급"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Manuseio Seguro"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "安全操作"}}
      }
    },
    "talents.alchemist_poison_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: alchemist_poison_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Brennende</keyword> Gegner erleiden <value id=\"quantity_1\">%1$lld</value>%% mehr <keyword id=\"poison\">Gift</keyword>schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Burning</keyword> enemies take <value id=\"quantity_1\">%1$lld</value>%% increased <keyword id=\"poison\">Poison</keyword> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los enemigos con <keyword id=\"burn\">Quemadura</keyword> reciben un <value id=\"quantity_1\">%1$lld</value>%% más de daño de <keyword id=\"poison\">Veneno</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les ennemis sous <keyword id=\"burn\">Brûlure</keyword> subissent <value id=\"quantity_1\">%1$lld</value>%% de dégâts de <keyword id=\"poison\">Poison</keyword> en plus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">炎上</keyword>状態の敵が受ける<keyword id=\"poison\">毒</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">화상</keyword> 상태의 적이 받는 <keyword id=\"poison\">독</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Inimigos <keyword id=\"burn\">Em Chamas</keyword> recebem <value id=\"quantity_1\">%1$lld</value>%% mais dano de <keyword id=\"poison\">Veneno</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">燃燒</keyword>中的敵人承受的<keyword id=\"poison\">中毒</keyword>傷害增加<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.alchemist_poison_t2_1.name": {
      "comment": "ContentManifest/talents.tsv: alchemist_poison_t2_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Reaktiver Bodensatz"}},
        "en": {"stringUnit": {"state": "translated", "value": "Reactive Sediment"}},
        "es": {"stringUnit": {"state": "translated", "value": "Sedimento reactivo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Sédiment réactif"}},
        "ja": {"stringUnit": {"state": "translated", "value": "反応性沈殿物"}},
        "ko": {"stringUnit": {"state": "translated", "value": "반응성 침전물"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Sedimento Reativo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "反應沉澱"}}
      }
    },
    "talents.alchemist_poison_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: alchemist_poison_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wenn dein <keyword id=\"poison\">Gift</keyword> von selbst endet, stelle <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword> wieder her"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your <keyword id=\"poison\">Poison</keyword> naturally expiring restores <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Cuando tu <keyword id=\"poison\">Veneno</keyword> expira de forma natural, restaura <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"mana\">Maná</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "La fin naturelle de votre <keyword id=\"poison\">Poison</keyword> restaure <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "自分が与えた<keyword id=\"poison\">毒</keyword>が自然消滅すると<keyword id=\"mana\">マナ</keyword>を<value id=\"quantity_1\">%1$lld</value>回復"}},
        "ko": {"stringUnit": {"state": "translated", "value": "내 <keyword id=\"poison\">독</keyword>이 자연적으로 끝나면 <keyword id=\"mana\">마나</keyword> <value id=\"quantity_1\">%1$lld</value> 회복"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seu <keyword id=\"poison\">Veneno</keyword> expirar naturalmente restaura <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"mana\">Mana</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "自身施加的<keyword id=\"poison\">中毒</keyword>自然消退時，恢復<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"mana\">魔力</keyword>"}}
      }
    },
    "talents.alchemist_poison_t2_2.name": {
      "comment": "ContentManifest/talents.tsv: alchemist_poison_t2_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verbrauchte Reagenzien"}},
        "en": {"stringUnit": {"state": "translated", "value": "Spent Reagents"}},
        "es": {"stringUnit": {"state": "translated", "value": "Reactivos agotados"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Réactifs épuisés"}},
        "ja": {"stringUnit": {"state": "translated", "value": "使用済み試薬"}},
        "ko": {"stringUnit": {"state": "translated", "value": "소진된 시약"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Reagentes Esgotados"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "耗盡試劑"}}
      }
    },
    "talents.alchemist_poison_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: alchemist_poison_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Gift</keyword> verursacht <value id=\"quantity_1\">%1$lld</value>%% mehr Schaden an gegnerischem <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Poison</keyword> deals <value id=\"quantity_1\">%1$lld</value>%% more damage to enemy <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Veneno</keyword> inflige un <value id=\"quantity_1\">%1$lld</value>%% más de daño al <keyword id=\"block\">Bloqueo</keyword> del enemigo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le <keyword id=\"poison\">Poison</keyword> inflige <value id=\"quantity_1\">%1$lld</value>%% de dégâts en plus au <keyword id=\"block\">Blocage</keyword> ennemi"}},
        "ja": {"stringUnit": {"state": "translated", "value": "敵の<keyword id=\"block\">ブロック</keyword>への<keyword id=\"poison\">毒</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">독</keyword>이 적의 <keyword id=\"block\">방어도</keyword>에 주는 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Veneno</keyword> causa <value id=\"quantity_1\">%1$lld</value>%% mais dano ao <keyword id=\"block\">Bloqueio</keyword> inimigo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">中毒</keyword>對敵人<keyword id=\"block\">格擋</keyword>造成的傷害增加<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.alchemist_poison_t3_1.name": {
      "comment": "ContentManifest/talents.tsv: alchemist_poison_t3_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Auflösende Dämpfe"}},
        "en": {"stringUnit": {"state": "translated", "value": "Dissolving Fumes"}},
        "es": {"stringUnit": {"state": "translated", "value": "Vapores disolventes"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Vapeurs dissolvantes"}},
        "ja": {"stringUnit": {"state": "translated", "value": "溶解の煙"}},
        "ko": {"stringUnit": {"state": "translated", "value": "용해 연무"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Vapores Dissolventes"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "溶解煙霧"}}
      }
    },
    "talents.alchemist_poison_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: alchemist_poison_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wenn dein <keyword id=\"poison\">Gift</keyword> von selbst endet, wird dein nächster <keyword id=\"poison\">Gift</keyword>-Angriff verdoppelt"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your <keyword id=\"poison\">Poison</keyword> naturally expiring doubles your next <keyword id=\"poison\">Poison</keyword> attack"}},
        "es": {"stringUnit": {"state": "translated", "value": "Cuando tu <keyword id=\"poison\">Veneno</keyword> expira de forma natural, duplica tu siguiente ataque de <keyword id=\"poison\">Veneno</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "La fin naturelle de votre <keyword id=\"poison\">Poison</keyword> double votre prochaine attaque de <keyword id=\"poison\">Poison</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "自分が与えた<keyword id=\"poison\">毒</keyword>が自然消滅すると、次の<keyword id=\"poison\">毒</keyword>攻撃が2倍になる"}},
        "ko": {"stringUnit": {"state": "translated", "value": "내 <keyword id=\"poison\">독</keyword>이 자연적으로 끝나면 다음 <keyword id=\"poison\">독</keyword> 공격이 두 배"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seu <keyword id=\"poison\">Veneno</keyword> expirar naturalmente dobra seu próximo ataque de <keyword id=\"poison\">Veneno</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "自身施加的<keyword id=\"poison\">中毒</keyword>自然消退時，下次<keyword id=\"poison\">中毒</keyword>攻擊加倍"}}
      }
    },
    "talents.alchemist_poison_t3_2.name": {
      "comment": "ContentManifest/talents.tsv: alchemist_poison_t3_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Instabile Kultur"}},
        "en": {"stringUnit": {"state": "translated", "value": "Unstable Culture"}},
        "es": {"stringUnit": {"state": "translated", "value": "Cultivo inestable"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Culture instable"}},
        "ja": {"stringUnit": {"state": "translated", "value": "不安定な培養"}},
        "ko": {"stringUnit": {"state": "translated", "value": "불안정한 배양"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cultura Instável"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "不穩定培養物"}}
      }
    },
    "talents.alchemist_poison_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: alchemist_poison_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dein erster <keyword id=\"poison\">Gift</keyword>-Angriff in jedem Kampf verursacht doppelten Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your first <keyword id=\"poison\">Poison</keyword> attack each combat deals double damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu primer ataque de <keyword id=\"poison\">Veneno</keyword> de cada combate inflige el doble de daño"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre première attaque de <keyword id=\"poison\">Poison</keyword> de chaque combat inflige le double de dégâts"}},
        "ja": {"stringUnit": {"state": "translated", "value": "各戦闘で最初の<keyword id=\"poison\">毒</keyword>攻撃のダメージが2倍になる"}},
        "ko": {"stringUnit": {"state": "translated", "value": "매 전투 첫 <keyword id=\"poison\">독</keyword> 공격이 두 배의 피해"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seu primeiro ataque de <keyword id=\"poison\">Veneno</keyword> de cada combate causa o dobro de dano"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每場戰鬥首次<keyword id=\"poison\">中毒</keyword>攻擊造成雙倍傷害"}}
      }
    },
    "talents.alchemist_poison_t4_1.name": {
      "comment": "ContentManifest/talents.tsv: alchemist_poison_t4_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Versiegelte Phiole"}},
        "en": {"stringUnit": {"state": "translated", "value": "Sealed Vial"}},
        "es": {"stringUnit": {"state": "translated", "value": "Vial sellado"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Fiole scellée"}},
        "ja": {"stringUnit": {"state": "translated", "value": "封じた小瓶"}},
        "ko": {"stringUnit": {"state": "translated", "value": "밀봉된 약병"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Frasco Selado"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "密封藥瓶"}}
      }
    },
    "talents.bear_block_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: bear_block_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Solange du <keyword id=\"block\">Block</keyword> hast, erleide <value id=\"quantity_1\">%1$lld</value> weniger <keyword id=\"physical\">physischen</keyword> Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "While you have <keyword id=\"block\">Block</keyword>, take <value id=\"quantity_1\">%1$lld</value> less <keyword id=\"physical\">Physical</keyword> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Mientras tienes <keyword id=\"block\">Bloqueo</keyword>, recibes <value id=\"quantity_1\">%1$lld</value> menos de daño <keyword id=\"physical\">físico</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Tant que vous avez du <keyword id=\"block\">Blocage</keyword>, les dégâts de type <keyword id=\"physical\">Physique</keyword> subis sont réduits de <value id=\"quantity_1\">%1$lld</value>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">ブロック</keyword>がある間、受ける<keyword id=\"physical\">物理</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>減少"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">방어도</keyword>가 있으면 받는 <keyword id=\"physical\">물리</keyword> 피해 <value id=\"quantity_1\">%1$lld</value> 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Enquanto tiver <keyword id=\"block\">Bloqueio</keyword>, receba <value id=\"quantity_1\">%1$lld</value> de dano <keyword id=\"physical\">Físico</keyword> a menos"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "擁有<keyword id=\"block\">格擋</keyword>時，承受的<keyword id=\"physical\">物理</keyword>傷害降低<value id=\"quantity_1\">%1$lld</value>點"}}
      }
    },
    "talents.bear_block_t1_1.name": {
      "comment": "ContentManifest/talents.tsv: bear_block_t1_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dicke Haut"}},
        "en": {"stringUnit": {"state": "translated", "value": "Thick Hide"}},
        "es": {"stringUnit": {"state": "translated", "value": "Piel gruesa"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Cuir épais"}},
        "ja": {"stringUnit": {"state": "translated", "value": "厚い獣皮"}},
        "ko": {"stringUnit": {"state": "translated", "value": "두꺼운 가죽"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Couro Grosso"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "厚皮"}}
      }
    },
    "talents.bear_block_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: bear_block_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Beende deinen Zug mit <keyword id=\"block\">Block</keyword>, um <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Gesundheit</keyword> wiederherzustellen"}},
        "en": {"stringUnit": {"state": "translated", "value": "End your turn with <keyword id=\"block\">Block</keyword> to restore <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Health</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Termina tu turno con <keyword id=\"block\">Bloqueo</keyword> para restaurar <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Salud</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Terminez votre tour avec du <keyword id=\"block\">Blocage</keyword> pour restaurer <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Santé</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">ブロック</keyword>を持ってターンを終えると<keyword id=\"health\">体力</keyword>を<value id=\"quantity_1\">%1$lld</value>回復"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">방어도</keyword>가 있는 채로 턴을 마치면 <keyword id=\"health\">체력</keyword> <value id=\"quantity_1\">%1$lld</value> 회복"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Encerre seu turno com <keyword id=\"block\">Bloqueio</keyword> para restaurar <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Vida</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "回合結束時若有<keyword id=\"block\">格擋</keyword>，恢復<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"health\">生命值</keyword>"}}
      }
    },
    "talents.bear_block_t1_2.name": {
      "comment": "ContentManifest/talents.tsv: bear_block_t1_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Winterschlaf"}},
        "en": {"stringUnit": {"state": "translated", "value": "Hibernation"}},
        "es": {"stringUnit": {"state": "translated", "value": "Hibernación"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Hibernation"}},
        "ja": {"stringUnit": {"state": "translated", "value": "冬眠"}},
        "ko": {"stringUnit": {"state": "translated", "value": "겨울잠"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Hibernação"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "冬眠"}}
      }
    },
    "talents.bear_block_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: bear_block_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wenn dein Verbündeter erstmals unter halbe <keyword id=\"health\">Gesundheit</keyword> fällt, gewähre <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "When your ally first falls below half <keyword id=\"health\">Health</keyword>, grant <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Cuando tu aliado cae por primera vez por debajo de la mitad de <keyword id=\"health\">Salud</keyword>, otorga <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueo</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Lorsque votre allié passe pour la première fois sous la moitié de sa <keyword id=\"health\">Santé</keyword>, octroyez-lui <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Blocage</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "味方の<keyword id=\"health\">体力</keyword>が初めて半分未満になると、その味方に<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>付与"}},
        "ko": {"stringUnit": {"state": "translated", "value": "아군의 <keyword id=\"health\">체력</keyword>이 처음으로 절반 미만이 되면 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 부여"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Quando seu aliado ficar abaixo de metade da <keyword id=\"health\">Vida</keyword> pela primeira vez, conceda <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueio</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "友方<keyword id=\"health\">生命值</keyword>首次低於一半時，賦予該友方<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>"}}
      }
    },
    "talents.bear_block_t2_1.name": {
      "comment": "ContentManifest/talents.tsv: bear_block_t2_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Grizzlyschutz"}},
        "en": {"stringUnit": {"state": "translated", "value": "Grizzly Guard"}},
        "es": {"stringUnit": {"state": "translated", "value": "Guardia de oso pardo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Garde du grizzli"}},
        "ja": {"stringUnit": {"state": "translated", "value": "灰色熊の守護"}},
        "ko": {"stringUnit": {"state": "translated", "value": "불곰의 수호"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Guarda do Urso"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "灰熊守護"}}
      }
    },
    "talents.bear_block_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: bear_block_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Solange du <keyword id=\"block\">Block</keyword> hast, wird <keyword id=\"bleed\">Blutungs</keyword>schaden halbiert"}},
        "en": {"stringUnit": {"state": "translated", "value": "While you have <keyword id=\"block\">Block</keyword>, <keyword id=\"bleed\">Bleed</keyword> damage is halved"}},
        "es": {"stringUnit": {"state": "translated", "value": "Mientras tienes <keyword id=\"block\">Bloqueo</keyword>, el daño de <keyword id=\"bleed\">Sangrado</keyword> se reduce a la mitad"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Tant que vous avez du <keyword id=\"block\">Blocage</keyword>, les dégâts de <keyword id=\"bleed\">Saignement</keyword> subis sont réduits de moitié"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">ブロック</keyword>がある間、受ける<keyword id=\"bleed\">出血</keyword>ダメージが半減"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">방어도</keyword>가 있으면 받는 <keyword id=\"bleed\">출혈</keyword> 피해가 절반으로 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Enquanto tiver <keyword id=\"block\">Bloqueio</keyword>, o dano de <keyword id=\"bleed\">Sangramento</keyword> é reduzido à metade"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "擁有<keyword id=\"block\">格擋</keyword>時，承受的<keyword id=\"bleed\">流血</keyword>傷害減半"}}
      }
    },
    "talents.bear_block_t2_2.name": {
      "comment": "ContentManifest/talents.tsv: bear_block_t2_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Zäher Pelz"}},
        "en": {"stringUnit": {"state": "translated", "value": "Tough Pelt"}},
        "es": {"stringUnit": {"state": "translated", "value": "Pelaje resistente"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Pelage résistant"}},
        "ja": {"stringUnit": {"state": "translated", "value": "丈夫な毛皮"}},
        "ko": {"stringUnit": {"state": "translated", "value": "질긴 털가죽"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Pelagem Resistente"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "堅韌毛皮"}}
      }
