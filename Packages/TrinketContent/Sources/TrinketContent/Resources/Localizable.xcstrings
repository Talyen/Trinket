    "talents.warlock_burn_t4_2.description": {
      "comment": "ContentManifest/talents.tsv: warlock_burn_t4_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">Brand</keyword>-Angriffe fügen deinem nächsten <keyword id=\"bleed\">Blutungs</keyword>-Angriff <value id=\"quantity_1\">%1$lld</value> Schaden hinzu"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">Burn</keyword> attacks add <value id=\"quantity_1\">%1$lld</value> damage to your next <keyword id=\"bleed\">Bleed</keyword> attack"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les attaques de <keyword id=\"burn\">Brûlure</keyword> ajoutent <value id=\"quantity_1\">%1$lld</value> dégâts à votre prochaine attaque de <keyword id=\"bleed\">Saignement</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">炎上</keyword>攻撃で次の<keyword id=\"bleed\">出血</keyword>攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>増加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">화상</keyword> 공격 시 다음 <keyword id=\"bleed\">출혈</keyword> 공격의 피해 <value id=\"quantity_1\">%1$lld</value> 증가"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">燃燒</keyword>攻擊使下次<keyword id=\"bleed\">流血</keyword>攻擊的傷害增加<value id=\"quantity_1\">%1$lld</value>點"
          }
        }
      }
    },
