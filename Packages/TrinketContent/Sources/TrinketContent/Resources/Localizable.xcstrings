    "talents.druid_health_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: druid_health_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbündete mit <keyword id=\"thorns\">Dornen</keyword> erleiden oberhalb halber <keyword id=\"health\">Gesundheit</keyword> <value id=\"quantity_1\">%1$lld</value>%% weniger Schaden"
          }
