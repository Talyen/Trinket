    "talents.golden_retriever_health_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: golden_retriever_health_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Fange in jedem Kampf den ersten Schaden ab, der die <keyword id=\"health\">Gesundheit</keyword> deines Verbündeten auf null senken würde"}},
        "en": {"stringUnit": {"state": "translated", "value": "Intercept the first damage each combat that would reduce your ally's <keyword id=\"health\">Health</keyword> to zero"}},
        "es": {"stringUnit": {"state": "translated", "value": "Intercepta el primer daño de cada combate que reduciría la <keyword id=\"health\">Salud</keyword> de tu aliado a cero"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Interceptez les premiers dégâts de chaque combat qui réduiraient la <keyword id=\"health\">Santé</keyword> de votre allié à zéro"}},
        "ja": {"stringUnit": {"state": "translated", "value": "各戦闘で初めて味方の<keyword id=\"health\">体力</keyword>を0にするダメージを引き受ける"}},
        "ko": {"stringUnit": {"state": "translated", "value": "매 전투 아군의 <keyword id=\"health\">체력</keyword>을 0으로 만들 첫 피해를 대신 받음"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Intercepte o primeiro dano de cada combate que reduziria a <keyword id=\"health\">Vida</keyword> do seu aliado a zero"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每場戰鬥首次有傷害將使友方<keyword id=\"health\">生命值</keyword>歸零時，代為承受"}}
      }
    },
    "talents.golden_retriever_health_t2_2.name": {
      "comment": "ContentManifest/talents.tsv: golden_retriever_health_t2_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Bester Freund des Menschen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Man's Best Friend"}},
        "es": {"stringUnit": {"state": "translated", "value": "El mejor amigo del hombre"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Meilleur ami de l’homme"}},
        "ja": {"stringUnit": {"state": "translated", "value": "人の最良の友"}},
        "ko": {"stringUnit": {"state": "translated", "value": "인간의 가장 좋은 친구"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Melhor Amigo do Homem"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "人類最好的朋友"}}
      }
    },
    "talents.golden_retriever_health_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: golden_retriever_health_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Unter halber <keyword id=\"health\">Gesundheit</keyword> erhalten beide Verbündeten +<value id=\"quantity_1\">%1$lld</value>%% Chance auf kritische Treffer"}},
        "en": {"stringUnit": {"state": "translated", "value": "Below half <keyword id=\"health\">Health</keyword>, both allies gain +<value id=\"quantity_1\">%1$lld</value>%% Critical Hit chance"}},
        "es": {"stringUnit": {"state": "translated", "value": "Por debajo de la mitad de <keyword id=\"health\">Salud</keyword>, ambos aliados obtienen +<value id=\"quantity_1\">%1$lld</value>%% de probabilidad de golpe crítico"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Sous la moitié de votre <keyword id=\"health\">Santé</keyword>, les deux alliés gagnent +<value id=\"quantity_1\">%1$lld</value>%% de chances de coup critique"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>が半分未満なら、味方2人のクリティカル率が<value id=\"quantity_1\">%1$lld</value>%%上昇"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword>이 절반 미만이면 두 아군의 치명타 확률 +<value id=\"quantity_1\">%1$lld</value>%%"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Abaixo de metade da <keyword id=\"health\">Vida</keyword>, ambos os aliados ganham +<value id=\"quantity_1\">%1$lld</value>%% de chance de golpe crítico"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">生命值</keyword>低於一半時，兩名友方的暴擊機率提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
