    "authored.d81ccd40d340713a": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Abilities/AbilityCatalog+Skill.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verliere <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Gesundheit</keyword>\nVerursache <value id=\"quantity_2\">%2$lld</value> <keyword id=\"bleed\">Blutungs</keyword>schaden\nZiehe eine Karte"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lose <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Health</keyword>\nDeal <value id=\"quantity_2\">%2$lld</value> <keyword id=\"bleed\">Bleed</keyword> damage\nDraw a card"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Perdez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Santé</keyword>\nInfligez <value id=\"quantity_2\">%2$lld</value> dégâts de <keyword id=\"bleed\">Saignement</keyword>\nPiochez une carte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">体力</keyword>を<value id=\"quantity_1\">%1$lld</value>失う\n<keyword id=\"bleed\">出血</keyword>ダメージを<value id=\"quantity_2\">%2$lld</value>与える\nカードを1枚引く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">체력</keyword> <value id=\"quantity_1\">%1$lld</value> 소모\n<keyword id=\"bleed\">출혈</keyword> 피해 <value id=\"quantity_2\">%2$lld</value>\n카드 한 장 뽑기"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "失去<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"health\">生命值</keyword>\n造成<value id=\"quantity_2\">%2$lld</value>點<keyword id=\"bleed\">流血</keyword>傷害\n抽一張牌"
          }
        }
      }
    },
    "authored.d81e4149c4b3b5dd": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Abilities/AbilityCatalog+Ultimate.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"cleanse\">Reinige</keyword> den Verbündeten mit den meisten Schwächungseffekten\nStelle <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Gesundheit</keyword> wieder her\nZiehe <value id=\"quantity_2\">%2$lld</value> Karte"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"cleanse\">Cleanse</keyword> the ally with the most debuffs\nRestore <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Health</keyword>\nDraw <value id=\"quantity_2\">%2$lld</value> card"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"cleanse\">Purification</keyword> de l’allié ayant le plus de malus\nRestaurez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Santé</keyword>\nPiochez <value id=\"quantity_2\">%2$lld</value> carte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "弱体効果が最も多い味方を<keyword id=\"cleanse\">浄化</keyword>\n<keyword id=\"health\">体力</keyword>を<value id=\"quantity_1\">%1$lld</value>回復\nカードを<value id=\"quantity_2\">%2$lld</value>枚引く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약화 효과가 가장 많은 아군을 <keyword id=\"cleanse\">정화</keyword>\n<keyword id=\"health\">체력</keyword> <value id=\"quantity_1\">%1$lld</value> 회복\n카드 <value id=\"quantity_2\">%2$lld</value>장 뽑기"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"cleanse\">淨化</keyword>減益效果最多的友方\n恢復<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"health\">生命值</keyword>\n抽<value id=\"quantity_2\">%2$lld</value>張牌"
          }
        }
      }
    },
    "authored.d843720819826554": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Encounters/Mystery/MysteryEventPool+Events.swift: narrative",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neben „%1$@“ liegt ein schweres Netz, während abgenutzte Wunschsteine „%2$@“ umgeben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A heavy net lies beside “%1$@” while worn wishing stones surround “%2$@”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lourd filet repose près de « %1$@ », tandis que des pierres à souhaits usées entourent « %2$@ »"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」の隣には重い網があり、使い古された願掛け石が「%2$@」を囲んでいる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무거운 그물은 ‘%1$@’ 곁에 놓여 있고, 닳은 소원 돌은 ‘%2$@’ 주위를 둘러쌉니다"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沉重漁網躺在「%1$@」旁，磨損的許願石圍繞著「%2$@」"
          }
        }
      }
    },
