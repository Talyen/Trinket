    "traits.corrosive_venom.description": {
      "comment": "ContentManifest/traits.tsv: corrosive_venom, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"poison\">Gift</keyword> entfernt <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>, bevor es der <keyword id=\"health\">Gesundheit</keyword> schadet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"poison\">Poison</keyword> strips <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword> before damaging <keyword id=\"health\">Health</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le <keyword id=\"poison\">Poison</keyword> retire <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Blocage</keyword> avant d’infliger des dégâts à la <keyword id=\"health\">Santé</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"poison\">毒</keyword>が<keyword id=\"health\">体力</keyword>にダメージを与える前に<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>削る"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"poison\">독</keyword>이 <keyword id=\"health\">체력</keyword>에 피해를 주기 전에 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 제거"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"poison\">中毒</keyword>在傷害<keyword id=\"health\">生命值</keyword>前，先削除<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>"
          }
        }
      }
    },
