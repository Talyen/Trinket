    "authored.c1c75f2574d8fb56": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Abilities/AbilityCatalog+Skill.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halbiere gegnerischen <keyword id=\"block\">Block</keyword>\nVerursache <value id=\"quantity_1\">%1$lld</value> <keyword id=\"physical\">physischen</keyword> Schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Halve enemy <keyword id=\"block\">Block</keyword>\nDeal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"physical\">Physical</keyword> damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduisez de moitié le <keyword id=\"block\">Blocage</keyword> ennemi\nInfligez <value id=\"quantity_1\">%1$lld</value> dégâts de type <keyword id=\"physical\">Physique</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "敵の<keyword id=\"block\">ブロック</keyword>を半減\n<keyword id=\"physical\">物理</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적의 <keyword id=\"block\">방어도</keyword>를 절반으로 감소\n<keyword id=\"physical\">물리</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將敵人<keyword id=\"block\">格擋</keyword>減半\n造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"physical\">物理</keyword>傷害"
          }
        }
      }
    },
