    "affixes.riposte.astral_description": {
      "comment": "ContentManifest/affixes.tsv: riposte, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verursache mit deinem nächsten Angriff nach dem Ausweichen <value id=\"quantity_1\">%1$lld</value> zusätzlichen Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Deal <value id=\"quantity_1\">%1$lld</value> additional damage on your next attack after Dodging"}},
        "es": {"stringUnit": {"state": "translated", "value": "Inflige <value id=\"quantity_1\">%1$lld</value> de daño adicional en tu siguiente ataque después de esquivar"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Infligez <value id=\"quantity_1\">%1$lld</value> dégâts supplémentaires lors de votre prochaine attaque après une esquive"}},
        "ja": {"stringUnit": {"state": "translated", "value": "回避後の次の攻撃で与えるダメージが<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "회피 후 다음 공격에 추가 피해 <value id=\"quantity_1\">%1$lld</value>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cause <value id=\"quantity_1\">%1$lld</value> de dano adicional no próximo ataque após esquivar"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "閃避後的下次攻擊額外造成<value id=\"quantity_1\">%1$lld</value>點傷害"}}
      }
    },
    "affixes.riposte.basic_description": {
      "comment": "ContentManifest/affixes.tsv: riposte, basic_description",
      "extractionState": "manual",
