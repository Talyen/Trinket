    "talents.risen_skeleton_physical_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_physical_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange du <keyword id=\"block\">Block</keyword> hast, erleide <value id=\"quantity_1\">%1$lld</value> weniger <keyword id=\"physical\">physischen</keyword> Schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While you have <keyword id=\"block\">Block</keyword>, take <value id=\"quantity_1\">%1$lld</value> less <keyword id=\"physical\">Physical</keyword> damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que vous avez du <keyword id=\"block\">Blocage</keyword>, les dégâts de type <keyword id=\"physical\">Physique</keyword> subis sont réduits de <value id=\"quantity_1\">%1$lld</value>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"block\">ブロック</keyword>がある間、受ける<keyword id=\"physical\">物理</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>減少"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"block\">방어도</keyword>가 있으면 받는 <keyword id=\"physical\">물리</keyword> 피해 <value id=\"quantity_1\">%1$lld</value> 감소"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擁有<keyword id=\"block\">格擋</keyword>時，承受的<keyword id=\"physical\">物理</keyword>傷害降低<value id=\"quantity_1\">%1$lld</value>點"
          }
        }
      }
    },
