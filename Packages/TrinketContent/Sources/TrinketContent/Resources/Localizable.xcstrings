    "talents.shield_scarab_stun_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: shield_scarab_stun_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erhöhe den <keyword id=\"stun\">Betäubungs</keyword>aufbau um <value id=\"quantity_1\">%1$lld</value>%%"}},
        "en": {"stringUnit": {"state": "translated", "value": "Increase <keyword id=\"stun\">Stun</keyword> build-up by <value id=\"quantity_1\">%1$lld</value>%%"}},
        "es": {"stringUnit": {"state": "translated", "value": "Aumenta la acumulación de <keyword id=\"stun\">Aturdimiento</keyword> en un <value id=\"quantity_1\">%1$lld</value>%%"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Accumulation d’<keyword id=\"stun\">Étourdissement</keyword> augmentée de <value id=\"quantity_1\">%1$lld</value>%%"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">スタン</keyword>蓄積量が<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">기절</keyword> 축적량 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Aumente o acúmulo de <keyword id=\"stun\">Atordoamento</keyword> em <value id=\"quantity_1\">%1$lld</value>%%"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">暈眩</keyword>累積量增加<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.shield_scarab_stun_t2_2.name": {
      "comment": "ContentManifest/talents.tsv: shield_scarab_stun_t2_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Seismischer Einschlag"}},
        "en": {"stringUnit": {"state": "translated", "value": "Seismic Impact"}},
        "es": {"stringUnit": {"state": "translated", "value": "Impacto sísmico"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Impact sismique"}},
        "ja": {"stringUnit": {"state": "translated", "value": "大地を揺らす衝撃"}},
        "ko": {"stringUnit": {"state": "translated", "value": "지진 충격"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Impacto Sísmico"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "震地衝擊"}}
      }
    },
    "talents.shield_scarab_stun_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: shield_scarab_stun_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wenn dein <keyword id=\"block\">Block</keyword> in einem Kampf erstmals durchbrochen wird, verdoppelt sich dein nächster <keyword id=\"stun\">Betäubungs</keyword>-Angriff"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your first <keyword id=\"block\">Block</keyword> break each combat doubles your next <keyword id=\"stun\">Stun</keyword> attack"}},
        "es": {"stringUnit": {"state": "translated", "value": "Cuando tu <keyword id=\"block\">Bloqueo</keyword> se rompe por primera vez en cada combate, tu siguiente ataque de <keyword id=\"stun\">Aturdimiento</keyword> se duplica"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le premier bris de votre <keyword id=\"block\">Blocage</keyword> de chaque combat double votre prochaine attaque d’<keyword id=\"stun\">Étourdissement</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "各戦闘で初めて自分の<keyword id=\"block\">ブロック</keyword>が崩れると、次の<keyword id=\"stun\">スタン</keyword>攻撃が2倍になる"}},
        "ko": {"stringUnit": {"state": "translated", "value": "매 전투 처음으로 내 <keyword id=\"block\">방어도</keyword>가 깨지면 다음 <keyword id=\"stun\">기절</keyword> 공격이 두 배"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "A primeira vez que seu <keyword id=\"block\">Bloqueio</keyword> quebrar a cada combate dobra seu próximo ataque de <keyword id=\"stun\">Atordoamento</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每場戰鬥自身<keyword id=\"block\">格擋</keyword>首次被擊破時，下次<keyword id=\"stun\">暈眩</keyword>攻擊加倍"}}
      }
    },
    "talents.shield_scarab_stun_t3_1.name": {
      "comment": "ContentManifest/talents.tsv: shield_scarab_stun_t3_1, name",
      "extractionState": "manual",
      "localizations": {
