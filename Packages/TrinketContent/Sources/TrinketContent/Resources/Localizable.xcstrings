    "talents.druid_health_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: druid_health_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbündete mit <keyword id=\"thorns\">Dornen</keyword> stellen <value id=\"quantity_1\">%1$lld</value> zusätzliche <keyword id=\"health\">Gesundheit</keyword> wieder her"
          }
