    "homestead_nodes.runesmithworkshop.1.bonus_description": {
      "comment": "ContentManifest/homestead_nodes.tsv: runesmithWorkshop.1, bonus_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhöhe <keyword id=\"freeze\">Frost</keyword>schaden um <value id=\"quantity_1\">%1$lld</value>%%\nErhöhe <keyword id=\"holy\">heiligen</keyword> Schaden um <value id=\"quantity_2\">%2$lld</value>%%\nProduziere <value id=\"quantity_3\">%3$lld</value> Edelsteine pro Tag"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Increase <keyword id=\"freeze\">Freeze</keyword> damage by <value id=\"quantity_1\">%1$lld</value>%%\nIncrease <keyword id=\"holy\">Holy</keyword> damage by <value id=\"quantity_2\">%2$lld</value>%%\nProduce <value id=\"quantity_3\">%3$lld</value> Gems per Day"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dégâts de <keyword id=\"freeze\">Gel</keyword> augmentés de <value id=\"quantity_1\">%1$lld</value>%%\nDégâts de type <keyword id=\"holy\">Sacré</keyword> augmentés de <value id=\"quantity_2\">%2$lld</value>%%\nProduit <value id=\"quantity_3\">%3$lld</value> gemmes par jour"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"freeze\">凍結</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%増加\n<keyword id=\"holy\">聖</keyword>ダメージが<value id=\"quantity_2\">%2$lld</value>%%増加\n1日に宝石を<value id=\"quantity_3\">%3$lld</value>生産"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"freeze\">빙결</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가\n<keyword id=\"holy\">신성</keyword> 피해 <value id=\"quantity_2\">%2$lld</value>%% 증가\n하루에 보석 <value id=\"quantity_3\">%3$lld</value>개 생산"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"freeze\">冰凍</keyword>傷害提高<value id=\"quantity_1\">%1$lld</value>%%\n<keyword id=\"holy\">神聖</keyword>傷害提高<value id=\"quantity_2\">%2$lld</value>%%\n每天生產<value id=\"quantity_3\">%3$lld</value>寶石"
          }
        }
      }
    },
