            "state": "translated",
            "value": "<keyword id=\"mana\">マナ</keyword>で強化すると<keyword id=\"burn\">炎上</keyword>と<keyword id=\"freeze\">凍結</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"mana\">마나</keyword>로 강화 시 <keyword id=\"burn\">화상</keyword> 및 <keyword id=\"freeze\">빙결</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以<keyword id=\"mana\">魔力</keyword>強化時，<keyword id=\"burn\">燃燒</keyword>與<keyword id=\"freeze\">冰凍</keyword>傷害提高<value id=\"quantity_1\">%1$lld</value>%%"
