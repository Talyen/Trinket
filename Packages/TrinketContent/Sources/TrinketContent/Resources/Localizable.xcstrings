    "talents.fox_stun_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: fox_stun_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wenn <keyword id=\"stun\">Betäubung</keyword> endet, verursache <value id=\"quantity_1\">%1$lld</value> <keyword id=\"poison\">Gift</keyword>schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "When <keyword id=\"stun\">Stun</keyword> ends, deal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"poison\">Poison</keyword> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Cuando termina <keyword id=\"stun\">Aturdimiento</keyword>, inflige <value id=\"quantity_1\">%1$lld</value> de daño de <keyword id=\"poison\">Veneno</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "À la fin de l’<keyword id=\"stun\">Étourdissement</keyword>, infligez <value id=\"quantity_1\">%1$lld</value> dégâts de <keyword id=\"poison\">Poison</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">スタン</keyword>が終了すると<keyword id=\"poison\">毒</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">기절</keyword> 종료 시 <keyword id=\"poison\">독</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Quando <keyword id=\"stun\">Atordoamento</keyword> terminar, cause <value id=\"quantity_1\">%1$lld</value> de dano de <keyword id=\"poison\">Veneno</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">暈眩</keyword>結束時，造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"poison\">中毒</keyword>傷害"}}
      }
    },
