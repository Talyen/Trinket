    "talents.fox_stun_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: fox_stun_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kritische <keyword id=\"stun\">Betäubungs</keyword>-Treffer ignorieren gegnerischen <keyword id=\"block\">Block</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"stun\">Stun</keyword> Critical Hits ignore enemy <keyword id=\"block\">Block</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les coups critiques d’<keyword id=\"stun\">Étourdissement</keyword> ignorent le <keyword id=\"block\">Blocage</keyword> ennemi"
          }
