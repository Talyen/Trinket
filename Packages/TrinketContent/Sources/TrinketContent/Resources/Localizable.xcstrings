    "talents.druid_mana_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: druid_mana_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Wiederherstellen von <keyword id=\"mana\">Mana</keyword> gewährt <value id=\"quantity_1\">%1$lld</value> <keyword id=\"thorns\">Dornen</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Restoring <keyword id=\"mana\">Mana</keyword> grants <value id=\"quantity_1\">%1$lld</value> <keyword id=\"thorns\">Thorns</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Restaurar <keyword id=\"mana\">Maná</keyword> otorga <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"thorns\">Espinas</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Restaurer du <keyword id=\"mana\">Mana</keyword> octroie <value id=\"quantity_1\">%1$lld</value> <keyword id=\"thorns\">Épines</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">マナ</keyword>を回復すると<keyword id=\"thorns\">棘</keyword>を<value id=\"quantity_1\">%1$lld</value>獲得"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">마나</keyword> 회복 시 <keyword id=\"thorns\">가시</keyword> <value id=\"quantity_1\">%1$lld</value> 획득"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Restaurar <keyword id=\"mana\">Mana</keyword> concede <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"thorns\">Espinhos</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "恢復<keyword id=\"mana\">魔力</keyword>時，獲得<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"thorns\">荊棘</keyword>"}}
      }
    },
    "talents.druid_mana_t1_1.name": {
      "comment": "ContentManifest/talents.tsv: druid_mana_t1_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Arkane <keyword id=\"thorns\">Dornen</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Arcane <keyword id=\"thorns\">Thorns</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "<keyword id=\"thorns\">Espinas</keyword> arcanas"}},
        "fr": {"stringUnit": {"state": "translated", "value": "<keyword id=\"thorns\">Épines</keyword> arcaniques"}},
        "ja": {"stringUnit": {"state": "translated", "value": "秘術の<keyword id=\"thorns\">棘</keyword>"}},
        "ko": {"stringUnit": {"state": "translated", "value": "비전 <keyword id=\"thorns\">가시</keyword>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "<keyword id=\"thorns\">Espinhos</keyword> Arcanos"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "秘法<keyword id=\"thorns\">荊棘</keyword>"}}
      }
    },
    "talents.druid_mana_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: druid_mana_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verstärken mit <keyword id=\"mana\">Mana</keyword> gewährt <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">Mana</keyword> empowerment grants <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Potenciar con <keyword id=\"mana\">Maná</keyword> otorga <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueo</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Un renforcement au <keyword id=\"mana\">Mana</keyword> octroie <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Blocage</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">マナ</keyword>で強化すると<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>獲得"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">마나</keyword>로 강화 시 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 획득"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Fortalecer com <keyword id=\"mana\">Mana</keyword> concede <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueio</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "以<keyword id=\"mana\">魔力</keyword>強化時，獲得<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>"}}
      }
    },
    "talents.druid_mana_t1_2.name": {
      "comment": "ContentManifest/talents.tsv: druid_mana_t1_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Rindengewebe"}},
        "en": {"stringUnit": {"state": "translated", "value": "Barkweave"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tejido de corteza"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Tissage d’écorce"}},
        "ja": {"stringUnit": {"state": "translated", "value": "樹皮の織物"}},
        "ko": {"stringUnit": {"state": "translated", "value": "나무껍질 직조"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Trama de Casca"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "樹皮編織"}}
      }
    },
    "talents.druid_mana_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: druid_mana_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Bei unverbrauchtem <keyword id=\"mana\">Mana</keyword> erhält dein Gefährte +<value id=\"quantity_1\">%1$lld</value>%% Chance auf <keyword id=\"dodge\">Ausweichen</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "With unspent <keyword id=\"mana\">Mana</keyword>, your Companion gains +<value id=\"quantity_1\">%1$lld</value>%% <keyword id=\"dodge\">Dodge</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Con <keyword id=\"mana\">Maná</keyword> sin gastar, tu compañero obtiene +<value id=\"quantity_1\">%1$lld</value>%% de <keyword id=\"dodge\">Evasión</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Avec du <keyword id=\"mana\">Mana</keyword> non dépensé, votre Compagnon gagne +<value id=\"quantity_1\">%1$lld</value>%% d’<keyword id=\"dodge\">Esquive</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "未使用の<keyword id=\"mana\">マナ</keyword>がある間、仲間の<keyword id=\"dodge\">回避</keyword>率が<value id=\"quantity_1\">%1$lld</value>%%上昇"}},
        "ko": {"stringUnit": {"state": "translated", "value": "사용하지 않은 <keyword id=\"mana\">마나</keyword>가 있으면 동료의 <keyword id=\"dodge\">회피</keyword> +<value id=\"quantity_1\">%1$lld</value>%%"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Com <keyword id=\"mana\">Mana</keyword> não gasta, seu Companheiro ganha +<value id=\"quantity_1\">%1$lld</value>%% de <keyword id=\"dodge\">Esquiva</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "有未使用的<keyword id=\"mana\">魔力</keyword>時，夥伴<keyword id=\"dodge\">閃避</keyword>機率提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
