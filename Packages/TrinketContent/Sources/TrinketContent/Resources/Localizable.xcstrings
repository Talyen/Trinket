    "authored.84db54a03c7a660e": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog+Accessory.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du eine <keyword id=\"freeze\">Frost</keyword>-Karte verstärkst, gib pro fehlendem <keyword id=\"mana\">Mana</keyword> <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword> aus"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When empowering a <keyword id=\"freeze\">Freeze</keyword> card, spend <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword> per missing <keyword id=\"mana\">Mana</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renforcer une carte de <keyword id=\"freeze\">Gel</keyword> dépense <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Blocage</keyword> par <keyword id=\"mana\">Mana</keyword> manquant"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"freeze\">凍結</keyword>カードを強化する際、不足する<keyword id=\"mana\">マナ</keyword>1につき<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>消費"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"freeze\">빙결</keyword> 카드 강화 시 부족한 <keyword id=\"mana\">마나</keyword> 1당 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 소모"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "強化<keyword id=\"freeze\">冰凍</keyword>卡牌時，每缺少一點<keyword id=\"mana\">魔力</keyword>，消耗<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>"
          }
        }
      }
    },
