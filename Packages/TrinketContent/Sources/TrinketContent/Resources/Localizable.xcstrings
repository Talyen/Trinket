    "affixes.heartshock.astral_description": {
      "comment": "ContentManifest/affixes.tsv: heartshock, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn <keyword id=\"leech\">Lebensraub</keyword> <keyword id=\"health\">Gesundheit</keyword> wiederherstellt, während du unter halber <keyword id=\"health\">Gesundheit</keyword> bist, verursache <value id=\"quantity_1\">%1$lld</value> <keyword id=\"stun\">Betäubungs</keyword>schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When <keyword id=\"leech\">Leech</keyword> restores <keyword id=\"health\">Health</keyword> while you are below half <keyword id=\"health\">Health</keyword>, deal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"stun\">Stun</keyword> damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un <keyword id=\"leech\">Vol de vie</keyword> restaure de la <keyword id=\"health\">Santé</keyword> alors que vous êtes sous la moitié de votre <keyword id=\"health\">Santé</keyword>, infligez <value id=\"quantity_1\">%1$lld</value> dégâts d’<keyword id=\"stun\">Étourdissement</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">体力</keyword>が半分未満の状態で<keyword id=\"leech\">吸収</keyword>により<keyword id=\"health\">体力</keyword>を回復すると、<keyword id=\"stun\">スタン</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">체력</keyword>이 절반 미만일 때 <keyword id=\"leech\">흡혈</keyword>로 <keyword id=\"health\">체력</keyword>을 회복하면 <keyword id=\"stun\">기절</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">生命值</keyword>低於一半時，若<keyword id=\"leech\">吸血</keyword>恢復<keyword id=\"health\">生命值</keyword>，則造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"stun\">暈眩</keyword>傷害"
          }
        }
      }
    },
    "affixes.heartshock.basic_description": {
      "comment": "ContentManifest/affixes.tsv: heartshock, basic_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn <keyword id=\"leech\">Lebensraub</keyword> <keyword id=\"health\">Gesundheit</keyword> wiederherstellt, während du unter halber <keyword id=\"health\">Gesundheit</keyword> bist, verursache <value id=\"quantity_1\">%1$lld</value> <keyword id=\"stun\">Betäubungs</keyword>schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When <keyword id=\"leech\">Leech</keyword> restores <keyword id=\"health\">Health</keyword> while you are below half <keyword id=\"health\">Health</keyword>, deal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"stun\">Stun</keyword> damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un <keyword id=\"leech\">Vol de vie</keyword> restaure de la <keyword id=\"health\">Santé</keyword> alors que vous êtes sous la moitié de votre <keyword id=\"health\">Santé</keyword>, infligez <value id=\"quantity_1\">%1$lld</value> dégâts d’<keyword id=\"stun\">Étourdissement</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">体力</keyword>が半分未満の状態で<keyword id=\"leech\">吸収</keyword>により<keyword id=\"health\">体力</keyword>を回復すると、<keyword id=\"stun\">スタン</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">체력</keyword>이 절반 미만일 때 <keyword id=\"leech\">흡혈</keyword>로 <keyword id=\"health\">체력</keyword>을 회복하면 <keyword id=\"stun\">기절</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">生命值</keyword>低於一半時，若<keyword id=\"leech\">吸血</keyword>恢復<keyword id=\"health\">生命值</keyword>，則造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"stun\">暈眩</keyword>傷害"
          }
        }
      }
    },
    "affixes.heartshock.title": {
      "comment": "ContentManifest/affixes.tsv: heartshock, title",
      "extractionState": "manual",
      "localizations": {
