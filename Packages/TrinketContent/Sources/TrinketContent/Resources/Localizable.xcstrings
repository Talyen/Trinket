    "authored.4afd173b91d4ab0d": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/InventoryItem+Compatibility.swift: canonical numeric compatibility description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">Lebensraub</keyword> gewährt mit <value id=\"quantity_1\">%1$lld</value>%% Wahrscheinlichkeit <value id=\"quantity_2\">%2$lld</value> <keyword id=\"gold\">Gold</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">Leech</keyword> has a <value id=\"quantity_1\">%1$lld</value>%% chance to grant <value id=\"quantity_2\">%2$lld</value> <keyword id=\"gold\">Gold</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "La <keyword id=\"leech\">Absorción</keyword> tiene un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de otorgar <value id=\"quantity_2\">%2$lld</value> de <keyword id=\"gold\">Oro</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le <keyword id=\"leech\">Vol de vie</keyword> a <value id=\"quantity_1\">%1$lld</value>%% de chances de rapporter <value id=\"quantity_2\">%2$lld</value> <keyword id=\"gold\">Or</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">吸収</keyword>時、<value id=\"quantity_1\">%1$lld</value>%%の確率で<keyword id=\"gold\">ゴールド</keyword>を<value id=\"quantity_2\">%2$lld</value>獲得"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">흡혈</keyword> 시 <value id=\"quantity_1\">%1$lld</value>%% 확률로 <keyword id=\"gold\">골드</keyword> <value id=\"quantity_2\">%2$lld</value> 획득"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "A <keyword id=\"leech\">Drenagem</keyword> tem <value id=\"quantity_1\">%1$lld</value>%% de chance de conceder <value id=\"quantity_2\">%2$lld</value> de <keyword id=\"gold\">Ouro</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">吸血</keyword>時有<value id=\"quantity_1\">%1$lld</value>%%機率獲得<value id=\"quantity_2\">%2$lld</value><keyword id=\"gold\">金幣</keyword>"}}
      }
    },
