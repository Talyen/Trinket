    "authored.6ed460d0356d5e78": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog+Melee.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Deine Boni auf <keyword id=\"physical\">physischen</keyword> Schaden verstärken auch <keyword id=\"holy\">heiligen</keyword> Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your <keyword id=\"physical\">Physical</keyword> damage bonuses also strengthen <keyword id=\"holy\">Holy</keyword> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tus bonificaciones de daño <keyword id=\"physical\">físico</keyword> también refuerzan el daño <keyword id=\"holy\">sagrado</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Vos bonus aux dégâts de type <keyword id=\"physical\">Physique</keyword> renforcent aussi les dégâts de type <keyword id=\"holy\">Sacré</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "自分の<keyword id=\"physical\">物理</keyword>ダメージボーナスが<keyword id=\"holy\">聖</keyword>ダメージも強化"}},
        "ko": {"stringUnit": {"state": "translated", "value": "내 <keyword id=\"physical\">물리</keyword> 피해 보너스가 <keyword id=\"holy\">신성</keyword> 피해도 강화"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seus bônus de dano <keyword id=\"physical\">Físico</keyword> também fortalecem o dano <keyword id=\"holy\">Sagrado</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "自身<keyword id=\"physical\">物理</keyword>傷害加成也會強化<keyword id=\"holy\">神聖</keyword>傷害"}}
      }
    },
    "authored.6ee786aa7f7a23c9": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Abilities/AbilityCatalog+Skill.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verursache <value id=\"quantity_1\">%1$lld</value> <keyword id=\"bleed\">Blutungs</keyword>schaden\nVerringert die von Gegnern wiederhergestellte <keyword id=\"health\">Gesundheit</keyword> für <value id=\"quantity_3\">%3$lld</value> Züge um <value id=\"quantity_2\">%2$lld</value>%%"}},
        "en": {"stringUnit": {"state": "translated", "value": "Deal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"bleed\">Bleed</keyword> damage\nReduces <keyword id=\"health\">Health</keyword> restored by enemies by <value id=\"quantity_2\">%2$lld</value>%% for <value id=\"quantity_3\">%3$lld</value> turns"}},
        "es": {"stringUnit": {"state": "translated", "value": "Inflige <value id=\"quantity_1\">%1$lld</value> de daño de <keyword id=\"bleed\">Sangrado</keyword>\nReduce la <keyword id=\"health\">Salud</keyword> que restauran los enemigos en un <value id=\"quantity_2\">%2$lld</value>%% durante <value id=\"quantity_3\">%3$lld</value> turnos"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Infligez <value id=\"quantity_1\">%1$lld</value> dégâts de <keyword id=\"bleed\">Saignement</keyword>\nRéduit de <value id=\"quantity_2\">%2$lld</value>%% la <keyword id=\"health\">Santé</keyword> restaurée par les ennemis pendant <value id=\"quantity_3\">%3$lld</value> tours"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">出血</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える\n<value id=\"quantity_3\">%3$lld</value>ターンの間、敵の<keyword id=\"health\">体力</keyword>回復量が<value id=\"quantity_2\">%2$lld</value>%%減少"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">출혈</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>\n<value id=\"quantity_3\">%3$lld</value>턴 동안 적의 <keyword id=\"health\">체력</keyword> 회복량 <value id=\"quantity_2\">%2$lld</value>%% 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cause <value id=\"quantity_1\">%1$lld</value> de dano de <keyword id=\"bleed\">Sangramento</keyword>\nReduz a <keyword id=\"health\">Vida</keyword> restaurada pelos inimigos em <value id=\"quantity_2\">%2$lld</value>%% por <value id=\"quantity_3\">%3$lld</value> turnos"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"bleed\">流血</keyword>傷害\n使敵人恢復的<keyword id=\"health\">生命值</keyword>降低<value id=\"quantity_2\">%2$lld</value>%%，持續<value id=\"quantity_3\">%3$lld</value>回合"}}
      }
    },
    "authored.6ff43388c95c88b3": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/InventoryItem+Compatibility.swift: canonical numeric compatibility description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Bei <keyword id=\"burn\">Brand</keyword>-Schaden besteht eine Chance von <value id=\"quantity_1\">%1$lld</value>%%, eine Karte zu ziehen"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Burn</keyword> damage has a <value id=\"quantity_1\">%1$lld</value>%% chance to draw a card"}},
        "es": {"stringUnit": {"state": "translated", "value": "El daño de <keyword id=\"burn\">Quemadura</keyword> tiene un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de hacerte robar una carta"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les dégâts de <keyword id=\"burn\">Brûlure</keyword> ont <value id=\"quantity_1\">%1$lld</value>%% de chances de vous faire piocher une carte"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">炎上</keyword>ダメージで、<value id=\"quantity_1\">%1$lld</value>%%の確率でカードを1枚引く"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">화상</keyword> 피해 발생 시 <value id=\"quantity_1\">%1$lld</value>%% 확률로 카드 한 장 뽑기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O dano de <keyword id=\"burn\">Queimadura</keyword> tem <value id=\"quantity_1\">%1$lld</value>%% de chance de fazer você comprar uma carta"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "造成<keyword id=\"burn\">燃燒</keyword>傷害時，有<value id=\"quantity_1\">%1$lld</value>%%的機率抽一張牌"}}
      }
    },
