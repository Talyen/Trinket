    "affixes.venomtrail.astral_description": {
      "comment": "ContentManifest/affixes.tsv: venomtrail, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Gift</keyword> verursacht <value id=\"quantity_1\">%1$lld</value> zusätzlichen Schaden an <keyword id=\"bleed\">blutenden</keyword> Gegnern"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Poison</keyword> deals <value id=\"quantity_1\">%1$lld</value> additional damage against <keyword id=\"bleed\">Bleeding</keyword> enemies"}},
        "es": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Veneno</keyword> inflige <value id=\"quantity_1\">%1$lld</value> de daño adicional contra enemigos con <keyword id=\"bleed\">Sangrado</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le <keyword id=\"poison\">Poison</keyword> inflige <value id=\"quantity_1\">%1$lld</value> dégâts supplémentaires aux ennemis sous <keyword id=\"bleed\">Saignement</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">出血</keyword>状態の敵に与える<keyword id=\"poison\">毒</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">출혈</keyword> 상태의 적에게 <keyword id=\"poison\">독</keyword>이 추가 피해 <value id=\"quantity_1\">%1$lld</value>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Veneno</keyword> causa <value id=\"quantity_1\">%1$lld</value> de dano adicional contra inimigos com <keyword id=\"bleed\">Sangramento</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "對<keyword id=\"bleed\">流血</keyword>的敵人造成的<keyword id=\"poison\">中毒</keyword>傷害增加<value id=\"quantity_1\">%1$lld</value>點"}}
      }
    },
