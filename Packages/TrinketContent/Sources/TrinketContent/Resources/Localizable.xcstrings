    "talents.wizard_mana_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: wizard_mana_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verstärken mit <keyword id=\"mana\">Mana</keyword> erhöht den Angriffsschaden um <value id=\"quantity_1\">%1$lld</value>"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">Mana</keyword> empowerment increases attack damage by <value id=\"quantity_1\">%1$lld</value>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Potenciar con <keyword id=\"mana\">Maná</keyword> aumenta el daño de ataque en <value id=\"quantity_1\">%1$lld</value>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Un renforcement au <keyword id=\"mana\">Mana</keyword> augmente les dégâts d’attaque de <value id=\"quantity_1\">%1$lld</value>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">マナ</keyword>で強化すると攻撃ダメージが<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">마나</keyword>로 강화 시 공격 피해 <value id=\"quantity_1\">%1$lld</value> 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Fortalecer com <keyword id=\"mana\">Mana</keyword> aumenta o dano do ataque em <value id=\"quantity_1\">%1$lld</value>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">魔力</keyword>強化使攻擊傷害增加<value id=\"quantity_1\">%1$lld</value>點"}}
      }
    },
    "talents.wizard_mana_t1_1.name": {
      "comment": "ContentManifest/talents.tsv: wizard_mana_t1_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Arkaner Fokus"}},
        "en": {"stringUnit": {"state": "translated", "value": "Arcane Focus"}},
        "es": {"stringUnit": {"state": "translated", "value": "Concentración arcana"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Concentration arcanique"}},
        "ja": {"stringUnit": {"state": "translated", "value": "秘術の集中"}},
        "ko": {"stringUnit": {"state": "translated", "value": "비전 집중"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Foco Arcano"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "秘法專注"}}
      }
    },
    "talents.wizard_mana_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: wizard_mana_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erhalte am Zugende pro unverbrauchtem <keyword id=\"mana\">Mana</keyword> <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>, höchstens <value id=\"quantity_2\">%2$lld</value>"}},
        "en": {"stringUnit": {"state": "translated", "value": "At turn’s end, gain <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword> per unspent <keyword id=\"mana\">Mana</keyword>, up to <value id=\"quantity_2\">%2$lld</value>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Al terminar el turno, obtén <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueo</keyword> por cada punto de <keyword id=\"mana\">Maná</keyword> sin gastar, hasta <value id=\"quantity_2\">%2$lld</value>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "En fin de tour, gagnez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Blocage</keyword> par <keyword id=\"mana\">Mana</keyword> non dépensé, jusqu’à <value id=\"quantity_2\">%2$lld</value>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "ターン終了時、未使用の<keyword id=\"mana\">マナ</keyword>1につき<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>獲得（最大<value id=\"quantity_2\">%2$lld</value>）"}},
        "ko": {"stringUnit": {"state": "translated", "value": "턴 종료 시 남은 <keyword id=\"mana\">마나</keyword> 1당 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 획득, 최대 <value id=\"quantity_2\">%2$lld</value>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "No fim do turno, ganhe <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueio</keyword> por <keyword id=\"mana\">Mana</keyword> não gasta, até <value id=\"quantity_2\">%2$lld</value>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "回合結束時，每點未使用的<keyword id=\"mana\">魔力</keyword>賦予<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>，最多<value id=\"quantity_2\">%2$lld</value>點"}}
      }
    },
    "talents.wizard_mana_t1_2.name": {
      "comment": "ContentManifest/talents.tsv: wizard_mana_t1_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">Mana</keyword>-Schild"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">Mana</keyword> Shield"}},
        "es": {"stringUnit": {"state": "translated", "value": "Escudo de <keyword id=\"mana\">Maná</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Bouclier de <keyword id=\"mana\">Mana</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">マナ</keyword>シールド"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">마나</keyword> 방패"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Escudo de <keyword id=\"mana\">Mana</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">魔力</keyword>護盾"}}
      }
    },
    "talents.wizard_mana_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: wizard_mana_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verstärken mit <keyword id=\"mana\">Mana</keyword> erhöht den Schaden deines nächsten Angriffs um <value id=\"quantity_1\">%1$lld</value>%%"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">Mana</keyword> empowerment increases your next attack's damage by <value id=\"quantity_1\">%1$lld</value>%%"}},
        "es": {"stringUnit": {"state": "translated", "value": "Potenciar con <keyword id=\"mana\">Maná</keyword> aumenta el daño de tu siguiente ataque en un <value id=\"quantity_1\">%1$lld</value>%%"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Un renforcement au <keyword id=\"mana\">Mana</keyword> augmente les dégâts de votre prochaine attaque de <value id=\"quantity_1\">%1$lld</value>%%"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">マナ</keyword>で強化すると、次の攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">마나</keyword>로 강화 시 다음 공격의 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Fortalecer com <keyword id=\"mana\">Mana</keyword> aumenta o dano do seu próximo ataque em <value id=\"quantity_1\">%1$lld</value>%%"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "以<keyword id=\"mana\">魔力</keyword>強化時，下次攻擊的傷害提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.wizard_mana_t2_1.name": {
      "comment": "ContentManifest/talents.tsv: wizard_mana_t2_1, name",
