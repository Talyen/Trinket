    "authored.2fa567236bcc63e8": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog+Melee.swift: name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Die nie heilende Wunde"}},
        "en": {"stringUnit": {"state": "translated", "value": "The Unclosing Wound"}},
        "es": {"stringUnit": {"state": "translated", "value": "La herida que no cierra"}},
        "fr": {"stringUnit": {"state": "translated", "value": "La plaie béante"}},
        "ja": {"stringUnit": {"state": "translated", "value": "閉じぬ傷"}},
        "ko": {"stringUnit": {"state": "translated", "value": "아물지 않는 상처"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "A Ferida que Não Fecha"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "不癒之傷"}}
      }
    },
    "authored.314177feec6f4a17": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Encounters/Mystery/MysteryEventPool+Events.swift: narrative",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Räucherkräuter umgeben „%1$@“, während ein Weihrauchfass inmitten von Pilgermünzen „%2$@“ birgt"}},
        "en": {"stringUnit": {"state": "translated", "value": "Incense herbs surround “%1$@” while a censer shelters “%2$@” among pilgrims’ coins"}},
        "es": {"stringUnit": {"state": "translated", "value": "Hierbas de incienso rodean «%1$@» mientras un incensario cobija «%2$@» entre monedas de peregrinos"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Des herbes à encens entourent « %1$@ », tandis qu’un encensoir abrite « %2$@ » parmi les pièces des pèlerins"}},
        "ja": {"stringUnit": {"state": "translated", "value": "香草が「%1$@」を囲み、香炉が巡礼者の硬貨の中で「%2$@」を包んでいる"}},
        "ko": {"stringUnit": {"state": "translated", "value": "향을 내는 약초가 ‘%1$@’ 주위를 둘러싸고, 순례자의 동전 사이 향로가 품은 것은 ‘%2$@’입니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ervas de incenso cercam “%1$@” enquanto um incensário abriga “%2$@” entre moedas de peregrinos"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "香草圍繞著「%1$@」，香爐在朝聖者的錢幣間庇護著「%2$@」"}}
      }
    },
    "authored.3194d33a508ae24d": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Encounters/Mystery/MysteryEventPool+Events.swift: Mystery choice label",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Gruft durchsuchen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Search Crypt"}},
        "es": {"stringUnit": {"state": "translated", "value": "Buscar en la cripta"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Fouiller la crypte"}},
        "ja": {"stringUnit": {"state": "translated", "value": "地下墓所を調べる"}},
        "ko": {"stringUnit": {"state": "translated", "value": "지하묘지 수색"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Vasculhar cripta"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "搜尋墓室"}}
      }
    },
    "authored.31f730a52db51c68": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog+Melee.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wenn du einen Gegner betäubst, bleibt ein Viertel des auslösenden <keyword id=\"stun\">Betäubungs</keyword>aufbaus erhalten"}},
        "en": {"stringUnit": {"state": "translated", "value": "Stunning an enemy preserves a quarter of the <keyword id=\"stun\">Stun</keyword> buildup that triggered it"}},
        "es": {"stringUnit": {"state": "translated", "value": "Aturdir a un enemigo conserva un cuarto de la acumulación de <keyword id=\"stun\">Aturdimiento</keyword> que lo activó"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Étourdir un ennemi conserve un quart de l’accumulation d’<keyword id=\"stun\">Étourdissement</keyword> qui l’a déclenché"}},
        "ja": {"stringUnit": {"state": "translated", "value": "敵をスタン状態にすると、発動に使われた<keyword id=\"stun\">スタン</keyword>蓄積量の4分の1が残る"}},
        "ko": {"stringUnit": {"state": "translated", "value": "적을 기절시키면 기절을 유발한 <keyword id=\"stun\">기절</keyword> 축적량의 4분의 1 유지"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Atordoar um inimigo preserva um quarto do acúmulo de <keyword id=\"stun\">Atordoamento</keyword> que o ativou"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "使敵人暈眩時，保留觸發該狀態的<keyword id=\"stun\">暈眩</keyword>累積量的四分之一"}}
      }
    },
    "authored.3271d589dd662bf2": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Encounters/Mystery/MysteryEventPool.swift: Mystery choice label",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Gehen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Leave"}},
        "es": {"stringUnit": {"state": "translated", "value": "Irse"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Partir"}},
        "ja": {"stringUnit": {"state": "translated", "value": "立ち去る"}},
        "ko": {"stringUnit": {"state": "translated", "value": "떠나기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Sair"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "離開"}}
      }
    },
    "authored.32d3d52154e28806": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Abilities/AbilityCatalog+Skill.swift: name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Blutopfer"}},
        "en": {"stringUnit": {"state": "translated", "value": "Blood Offering"}},
        "es": {"stringUnit": {"state": "translated", "value": "Ofrenda de sangre"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Offrande de sang"}},
        "ja": {"stringUnit": {"state": "translated", "value": "血の供物"}},
        "ko": {"stringUnit": {"state": "translated", "value": "피의 제물"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Oferenda de Sangue"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "鮮血獻祭"}}
      }
    },
    "authored.33ae3045806f0c59": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Abilities/AbilityCatalog+Ultimate.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wirf einen <value id=\"quantity_1\">%1$lld</value>-seitigen Würfel\nErhalte entsprechend viel <keyword id=\"block\">Block</keyword> und <keyword id=\"thorns\">Dornen</keyword>\nZiehe eine Karte"}},
        "en": {"stringUnit": {"state": "translated", "value": "Roll an <value id=\"quantity_1\">%1$lld</value>-sided die\nGain that much <keyword id=\"block\">Block</keyword> and <keyword id=\"thorns\">Thorns</keyword>\nDraw a card"}},
        "es": {"stringUnit": {"state": "translated", "value": "Lanza un dado de <value id=\"quantity_1\">%1$lld</value> caras\nObtén esa cantidad de <keyword id=\"block\">Bloqueo</keyword> y <keyword id=\"thorns\">Espinas</keyword>\nRoba una carta"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Lancez un dé à <value id=\"quantity_1\">%1$lld</value> faces\nGagnez autant de <keyword id=\"block\">Blocage</keyword> et d’<keyword id=\"thorns\">Épines</keyword>\nPiochez une carte"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<value id=\"quantity_1\">%1$lld</value>面ダイスを振る\n出目と同量の<keyword id=\"block\">ブロック</keyword>と<keyword id=\"thorns\">棘</keyword>を獲得\nカードを1枚引く"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<value id=\"quantity_1\">%1$lld</value>면 주사위 굴리기\n나온 수만큼 <keyword id=\"block\">방어도</keyword>와 <keyword id=\"thorns\">가시</keyword> 획득\n카드 1장 뽑기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Role um dado de <value id=\"quantity_1\">%1$lld</value> lados\nGanhe essa quantidade de <keyword id=\"block\">Bloqueio</keyword> e <keyword id=\"thorns\">Espinhos</keyword>\nCompre uma carta"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "擲一顆<value id=\"quantity_1\">%1$lld</value>面骰\n獲得等同點數的<keyword id=\"block\">格擋</keyword>和<keyword id=\"thorns\">荊棘</keyword>\n抽一張牌"}}
      }
    },
    "authored.340d09c98a84db17": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Encounters/Mystery/MysteryEventPool+Events.swift: narrative",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Eine Opferschale birgt „%1$@“, während darunter rostige Ketten „%2$@“ binden"}},
        "en": {"stringUnit": {"state": "translated", "value": "An offering bowl holds “%1$@” while rusted chains bind “%2$@” below"}},
        "es": {"stringUnit": {"state": "translated", "value": "Un cuenco de ofrendas contiene «%1$@» mientras cadenas oxidadas sujetan «%2$@» debajo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Un bol d’offrandes contient « %1$@ », tandis que des chaînes rouillées retiennent « %2$@ » en contrebas"}},
        "ja": {"stringUnit": {"state": "translated", "value": "供物鉢には「%1$@」が収まり、その下では錆びた鎖が「%2$@」を縛っている"}},
        "ko": {"stringUnit": {"state": "translated", "value": "제물 그릇에 담긴 것은 ‘%1$@’, 그 아래 녹슨 사슬에 묶인 것은 ‘%2$@’입니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Uma tigela de oferendas contém “%1$@” enquanto correntes enferrujadas prendem “%2$@” abaixo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "供碗盛著「%1$@」，下方生鏽的鎖鏈束縛著「%2$@」"}}
      }
    },
    "authored.346df12519cf9ef7": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Encounters/NodeModifierModels.swift: computed description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erhöhter <keyword id=\"burn\">Brand</keyword>schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Increased <keyword id=\"burn\">Burn</keyword> Damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Daño de <keyword id=\"burn\">Quemadura</keyword> aumentado"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Dégâts de type <keyword id=\"burn\">Brûlure</keyword> accrus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">炎上</keyword>ダメージ増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">화상</keyword> 피해 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Dano de <keyword id=\"burn\">Queimadura</keyword> aumentado"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">燃燒</keyword>傷害提高"}}
      }
    },
    "authored.348c1a5e9ab28ec0": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Encounters/Rewards/RewardModifier.swift: computed description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Lässt Gegenstände mit <keyword id=\"block\">Block</keyword> fallen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Drops <keyword id=\"block\">Block</keyword> items"}},
        "es": {"stringUnit": {"state": "translated", "value": "Otorga objetos de <keyword id=\"block\">Bloqueo</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Butin : objets de type <keyword id=\"block\">Blocage</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">ブロック</keyword>アイテムをドロップ"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">방어도</keyword> 아이템 드롭"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Concede itens de <keyword id=\"block\">Bloqueio</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "掉落<keyword id=\"block\">格擋</keyword>物品"}}
      }
    },
    "authored.34d51e747d5210bf": {
