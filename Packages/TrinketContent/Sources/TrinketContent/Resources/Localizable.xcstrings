    "talents.wizard_freeze_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: wizard_freeze_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhöhe den <keyword id=\"freeze\">Frost</keyword>-Aufbau um <value id=\"quantity_1\">%1$lld</value>%%"
          }
