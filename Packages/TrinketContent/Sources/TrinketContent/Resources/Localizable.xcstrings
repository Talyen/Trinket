        "ko": {"stringUnit": {"state": "translated", "value": "적을 빙결시키면 <keyword id=\"physical\">물리</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Congelar um inimigo causa <value id=\"quantity_1\">%1$lld</value> de dano <keyword id=\"physical\">físico</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "凍結敵人時造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"physical\">物理</keyword>傷害"}}
      }
    },
    "affixes.shattering.title": {
      "comment": "ContentManifest/affixes.tsv: shattering, title",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Zerschmetternd"}},
        "en": {"stringUnit": {"state": "translated", "value": "Shattering"}},
        "es": {"stringUnit": {"state": "translated", "value": "Devastador"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Fracassant"}},
        "ja": {"stringUnit": {"state": "translated", "value": "粉砕の"}},
        "ko": {"stringUnit": {"state": "translated", "value": "분쇄의"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Estilhaçante"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "碎裂"}}
