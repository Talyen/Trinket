    "affixes.stunned_pocketwatch.astral_description": {
      "comment": "ContentManifest/affixes.tsv: stunned_pocketwatch, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">Betäubung</keyword> hält mit <value id=\"quantity_1\">%1$lld</value>%% Chance einen zusätzlichen Zug an"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">Stun</keyword> has a <value id=\"quantity_1\">%1$lld</value>%% chance to last an additional turn"}},
        "es": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">Aturdimiento</keyword> tiene un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de durar un turno adicional"}},
        "fr": {"stringUnit": {"state": "translated", "value": "L’<keyword id=\"stun\">Étourdissement</keyword> a <value id=\"quantity_1\">%1$lld</value>%% de chances de durer un tour de plus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">スタン</keyword>が<value id=\"quantity_1\">%1$lld</value>%%の確率でさらに1ターン持続"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">기절</keyword>이 <value id=\"quantity_1\">%1$lld</value>%% 확률로 1턴 더 지속"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">Atordoamento</keyword> tem <value id=\"quantity_1\">%1$lld</value>%% de chance de durar um turno adicional"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">暈眩</keyword>有<value id=\"quantity_1\">%1$lld</value>%%機率額外持續一回合"}}
      }
    },
