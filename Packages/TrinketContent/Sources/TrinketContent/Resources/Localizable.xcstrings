    "homestead_nodes.mycologycellar.1.bonus_description": {
      "comment": "ContentManifest/homestead_nodes.tsv: mycologyCellar.1, bonus_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">Lebensraub</keyword> stellt <value id=\"quantity_1\">%1$lld</value>%% mehr <keyword id=\"health\">Gesundheit</keyword> wieder her\nProduziere <value id=\"quantity_2\">%2$lld</value> Kräuter pro Tag"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">Leech</keyword> restores <value id=\"quantity_1\">%1$lld</value>%% more <keyword id=\"health\">Health</keyword>\nProduce <value id=\"quantity_2\">%2$lld</value> Herbs per Day"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le <keyword id=\"leech\">Vol de vie</keyword> restaure <value id=\"quantity_1\">%1$lld</value>%% de <keyword id=\"health\">Santé</keyword> en plus\nProduit <value id=\"quantity_2\">%2$lld</value> herbes par jour"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">吸収</keyword>による<keyword id=\"health\">体力</keyword>回復量が<value id=\"quantity_1\">%1$lld</value>%%増加\n1日に薬草を<value id=\"quantity_2\">%2$lld</value>生産"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">흡혈</keyword>의 <keyword id=\"health\">체력</keyword> 회복량 <value id=\"quantity_1\">%1$lld</value>%% 증가\n하루에 약초 <value id=\"quantity_2\">%2$lld</value>개 생산"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">吸血</keyword>恢復的<keyword id=\"health\">生命值</keyword>增加<value id=\"quantity_1\">%1$lld</value>%%\n每天生產<value id=\"quantity_2\">%2$lld</value>藥草"
          }
        }
      }
    },
