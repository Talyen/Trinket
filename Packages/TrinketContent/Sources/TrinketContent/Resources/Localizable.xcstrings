          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Santé</keyword> de plus lors d’un <keyword id=\"leech\">Vol de vie</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">吸収</keyword>すると<keyword id=\"health\">体力</keyword>を追加で<value id=\"quantity_1\">%1$lld</value>回復"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">흡혈</keyword> 시 <keyword id=\"health\">체력</keyword> <value id=\"quantity_1\">%1$lld</value> 추가 회복"
          }
        },
        "zh-Hant": {
