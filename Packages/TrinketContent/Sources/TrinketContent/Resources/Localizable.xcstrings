    "authored.c73204111b3bec52": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Abilities/AbilityCatalog+Basic.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verursache <value id=\"quantity_1\">%1$lld</value> <keyword id=\"bleed\">Blutungs</keyword>schaden\nVerursache gegen Gegner mit <keyword id=\"block\">Block</keyword> stattdessen <keyword id=\"stun\">Betäubungs</keyword>schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"bleed\">Bleed</keyword> damage\nDeal <keyword id=\"stun\">Stun</keyword> instead against enemies with <keyword id=\"block\">Block</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Infligez <value id=\"quantity_1\">%1$lld</value> dégâts de <keyword id=\"bleed\">Saignement</keyword>\nInfligez des dégâts d’<keyword id=\"stun\">Étourdissement</keyword> à la place aux ennemis ayant du <keyword id=\"block\">Blocage</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"bleed\">出血</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える\n敵に<keyword id=\"block\">ブロック</keyword>がある場合は代わりに<keyword id=\"stun\">スタン</keyword>を与える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"bleed\">출혈</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>\n<keyword id=\"block\">방어도</keyword>가 있는 적에게는 대신 <keyword id=\"stun\">기절</keyword> 피해"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
