        "ja": {"stringUnit": {"state": "translated", "value": "血の契約"}},
        "ko": {"stringUnit": {"state": "translated", "value": "피의 계약"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Pacto de Sangue"}},
