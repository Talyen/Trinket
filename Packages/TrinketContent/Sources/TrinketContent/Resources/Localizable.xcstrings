        "es": {"stringUnit": {"state": "translated", "value": "Ataque en vuelo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Frappe en vol"}},
        "ja": {"stringUnit": {"state": "translated", "value": "飛び去りざまの一撃"}},
        "ko": {"stringUnit": {"state": "translated", "value": "비행 일격"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataque Rasante"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "掠襲"}}
