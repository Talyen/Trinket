    "talents.rogue_gold_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: rogue_gold_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Besiegen eines Gegners mit einem kritischen Treffer gewährt <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Gold</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Defeating an enemy with a Critical Hit grants <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Gold</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Derrotar a un enemigo con un golpe crítico otorga <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"gold\">Oro</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Terrasser un ennemi d’un coup critique octroie <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Or</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "クリティカルヒットで敵を倒すと<keyword id=\"gold\">ゴールド</keyword>を<value id=\"quantity_1\">%1$lld</value>獲得"}},
        "ko": {"stringUnit": {"state": "translated", "value": "치명타로 적 처치 시 <keyword id=\"gold\">골드</keyword> <value id=\"quantity_1\">%1$lld</value> 획득"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Derrotar um inimigo com um golpe crítico concede <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"gold\">Ouro</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "以暴擊擊敗敵人時，獲得<value id=\"quantity_1\">%1$lld</value><keyword id=\"gold\">金幣</keyword>"}}
      }
    },
    "talents.rogue_gold_t3_1.name": {
      "comment": "ContentManifest/talents.tsv: rogue_gold_t3_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Kopfgeldjäger"}},
        "en": {"stringUnit": {"state": "translated", "value": "Bounty Hunter"}},
        "es": {"stringUnit": {"state": "translated", "value": "Cazarrecompensas"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Chasseur de primes"}},
        "ja": {"stringUnit": {"state": "translated", "value": "賞金稼ぎ"}},
        "ko": {"stringUnit": {"state": "translated", "value": "현상금 사냥꾼"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Caçador de Recompensas"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "賞金獵人"}}
      }
    },
    "talents.rogue_gold_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: rogue_gold_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Kritische Treffer, die <keyword id=\"gold\">Gold</keyword> stehlen, lassen dich eine Karte ziehen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Critical Hits that steal <keyword id=\"gold\">Gold</keyword> draw a card"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los golpes críticos que roban <keyword id=\"gold\">Oro</keyword> hacen que robes una carta"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les coups critiques qui volent de l’<keyword id=\"gold\">Or</keyword> font piocher une carte"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"gold\">ゴールド</keyword>を盗むクリティカルヒットで、カードを1枚引く"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"gold\">골드</keyword>를 훔치는 치명타 적중 시 카드 한 장 뽑기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Golpes críticos que roubam <keyword id=\"gold\">Ouro</keyword> fazem você comprar uma carta"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "偷取<keyword id=\"gold\">金幣</keyword>的暴擊會抽一張牌"}}
      }
    },
    "talents.rogue_gold_t3_2.name": {
      "comment": "ContentManifest/talents.tsv: rogue_gold_t3_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Schnelle Finger"}},
        "en": {"stringUnit": {"state": "translated", "value": "Quick Fingers"}},
        "es": {"stringUnit": {"state": "translated", "value": "Dedos rápidos"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Doigts vifs"}},
        "ja": {"stringUnit": {"state": "translated", "value": "素早い指"}},
        "ko": {"stringUnit": {"state": "translated", "value": "재빠른 손가락"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Dedos Rápidos"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "快手"}}
      }
