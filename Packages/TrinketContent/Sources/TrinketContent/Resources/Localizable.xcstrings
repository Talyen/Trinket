    "talents.wildcard_dodge_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: wildcard_dodge_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ausweichen lässt den nächsten Angriff deines Gefährten kritisch treffen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Dodging makes your Companion’s next attack Critically Hit"}},
        "es": {"stringUnit": {"state": "translated", "value": "Esquivar hace que el siguiente ataque de tu compañero aseste un golpe crítico"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Une esquive garantit un coup critique à la prochaine attaque de votre Compagnon"}},
        "ja": {"stringUnit": {"state": "translated", "value": "回避すると、仲間の次の攻撃が必ずクリティカルヒット"}},
        "ko": {"stringUnit": {"state": "translated", "value": "회피 시 동료의 다음 공격이 반드시 치명타"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Esquivar faz o próximo ataque do seu Companheiro acertar um golpe crítico"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "閃避後，夥伴下次攻擊必定暴擊"}}
      }
    },
    "talents.wildcard_dodge_t2_1.name": {
      "comment": "ContentManifest/talents.tsv: wildcard_dodge_t2_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Weitergegebenes Glück"}},
        "en": {"stringUnit": {"state": "translated", "value": "Passing Luck"}},
        "es": {"stringUnit": {"state": "translated", "value": "Suerte compartida"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Chance transmise"}},
        "ja": {"stringUnit": {"state": "translated", "value": "巡る幸運"}},
        "ko": {"stringUnit": {"state": "translated", "value": "전하는 행운"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Sorte Passageira"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "傳遞幸運"}}
