    "talents.lizard_scout_poison_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: lizard_scout_poison_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verursache bei Angreifern <value id=\"quantity_1\">%1$lld</value> <keyword id=\"poison\">Gift</keyword>schaden, wenn du Schaden erleidest"}},
        "en": {"stringUnit": {"state": "translated", "value": "Deal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"poison\">Poison</keyword> damage to attackers when you take damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Inflige <value id=\"quantity_1\">%1$lld</value> de daño de <keyword id=\"poison\">Veneno</keyword> a los atacantes cuando recibes daño"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Infligez <value id=\"quantity_1\">%1$lld</value> dégâts de <keyword id=\"poison\">Poison</keyword> aux attaquants lorsque vous subissez des dégâts"}},
        "ja": {"stringUnit": {"state": "translated", "value": "ダメージを受けると攻撃者に<keyword id=\"poison\">毒</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える"}},
        "ko": {"stringUnit": {"state": "translated", "value": "피해를 받으면 공격자에게 <keyword id=\"poison\">독</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cause <value id=\"quantity_1\">%1$lld</value> de dano de <keyword id=\"poison\">Veneno</keyword> aos atacantes ao receber dano"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "受到傷害時，對攻擊者造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"poison\">中毒</keyword>傷害"}}
      }
    },
