    "talents.library_owl_health_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: library_owl_health_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Wiederherstellen von <keyword id=\"health\">Gesundheit</keyword> gewährt mit <value id=\"quantity_1\">%1$lld</value>%% Chance <value id=\"quantity_2\">%2$lld</value> <keyword id=\"thorns\">Dornen</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Restoring <keyword id=\"health\">Health</keyword> has a <value id=\"quantity_1\">%1$lld</value>%% chance to grant <value id=\"quantity_2\">%2$lld</value> <keyword id=\"thorns\">Thorns</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Restaurar <keyword id=\"health\">Salud</keyword> tiene un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de otorgar <value id=\"quantity_2\">%2$lld</value> de <keyword id=\"thorns\">Espinas</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Restaurer de la <keyword id=\"health\">Santé</keyword> a <value id=\"quantity_1\">%1$lld</value>%% de chances d’octroyer <value id=\"quantity_2\">%2$lld</value> <keyword id=\"thorns\">Épines</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>を回復すると<value id=\"quantity_1\">%1$lld</value>%%の確率で<keyword id=\"thorns\">棘</keyword>を<value id=\"quantity_2\">%2$lld</value>付与"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword> 회복 시 <value id=\"quantity_1\">%1$lld</value>%% 확률로 <keyword id=\"thorns\">가시</keyword> <value id=\"quantity_2\">%2$lld</value> 획득"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Restaurar <keyword id=\"health\">Vida</keyword> tem <value id=\"quantity_1\">%1$lld</value>%% de chance de conceder <value id=\"quantity_2\">%2$lld</value> de <keyword id=\"thorns\">Espinhos</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "恢復<keyword id=\"health\">生命值</keyword>時，有<value id=\"quantity_1\">%1$lld</value>%%機率賦予<value id=\"quantity_2\">%2$lld</value>點<keyword id=\"thorns\">荊棘</keyword>"}}
      }
    },
