    "homestead_nodes.transmutationcrucible.1.summary": {
      "comment": "ContentManifest/homestead_nodes.tsv: transmutationCrucible.1, summary",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ein alchemistischer Hochofen, der Roherz in veredelte Metalle verwandelt"}},
        "en": {"stringUnit": {"state": "translated", "value": "An alchemical blast furnace catalyzing raw ore into refined metals"}},
        "es": {"stringUnit": {"state": "translated", "value": "Un alto horno alquímico que transforma mineral bruto en metales refinados"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Un haut-fourneau alchimique catalysant le minerai brut en métaux raffinés"}},
        "ja": {"stringUnit": {"state": "translated", "value": "原鉱石を精製金属へと変える錬金術の溶鉱炉"}},
        "ko": {"stringUnit": {"state": "translated", "value": "원광석을 정제 금속으로 변환하는 연금술 용광로"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Um alto-forno alquímico que catalisa minério bruto em metais refinados"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "以煉金術將原礦催化成精煉金屬的高爐"}}
      }
    },
