    "authored.97fd8651019497f7": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog+Melee.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Blocken eines Angriffs lässt deinen nächsten manuell gespielten Angriff kritisch treffen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocking an attack makes your next manually played attack Critically Hit"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquer une attaque garantit un coup critique à votre prochaine attaque jouée manuellement"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "攻撃をブロックすると、次に手動で使う攻撃が必ずクリティカルヒット"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공격을 막으면 다음에 직접 사용하는 공격이 반드시 치명타"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "格擋攻擊後，下次手動打出的攻擊必定暴擊"
          }
        }
      }
    },
