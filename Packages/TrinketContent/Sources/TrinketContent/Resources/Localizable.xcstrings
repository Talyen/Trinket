    "affixes.relay.astral_description": {
      "comment": "ContentManifest/affixes.tsv: relay, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ein gespielter Angriff erhöht den Schaden des nächsten Angriffs deines Verbündeten um <value id=\"quantity_1\">%1$lld</value>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Playing an attack adds <value id=\"quantity_1\">%1$lld</value> damage to your ally's next attack"}},
        "es": {"stringUnit": {"state": "translated", "value": "Jugar un ataque añade <value id=\"quantity_1\">%1$lld</value> de daño al siguiente ataque de tu aliado"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Jouer une attaque ajoute <value id=\"quantity_1\">%1$lld</value> dégâts à la prochaine attaque de votre allié"}},
        "ja": {"stringUnit": {"state": "translated", "value": "攻撃カードを使うと、味方の次の攻撃ダメージが<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "공격 카드를 사용하면 아군의 다음 공격 피해가 <value id=\"quantity_1\">%1$lld</value> 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Jogar um ataque adiciona <value id=\"quantity_1\">%1$lld</value> de dano ao próximo ataque do seu aliado"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "打出攻擊牌後，盟友下一次攻擊的傷害提高<value id=\"quantity_1\">%1$lld</value>"}}
      }
    },
    "affixes.relay.basic_description": {
