        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"thorns\">가시</keyword>가 있는 아군의 <keyword id=\"health\">체력</keyword> <value id=\"quantity_1\">%1$lld</value> 추가 회복"
