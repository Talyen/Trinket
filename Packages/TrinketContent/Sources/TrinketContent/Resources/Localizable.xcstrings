        "pt-BR": {"stringUnit": {"state": "translated", "value": "Laço Abrasador"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "灼熱束縛"}}
      }
    },
    "talents.knight_stun_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: knight_stun_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">Heiliger</keyword> Schaden gegen <keyword id=\"stun\">betäubte</keyword> Gegner wird um <value id=\"quantity_1\">%1$lld</value> erhöht"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">Holy</keyword> damage is increased by <value id=\"quantity_1\">%1$lld</value> against <keyword id=\"stun\">Stunned</keyword> enemies"}},
        "es": {"stringUnit": {"state": "translated", "value": "El daño <keyword id=\"holy\">sagrado</keyword> aumenta en <value id=\"quantity_1\">%1$lld</value> contra enemigos <keyword id=\"stun\">aturdidos</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Dégâts de type <keyword id=\"holy\">Sacré</keyword> augmentés de <value id=\"quantity_1\">%1$lld</value> contre les ennemis sous <keyword id=\"stun\">Étourdissement</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">スタン</keyword>状態の敵への<keyword id=\"holy\">聖</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">기절</keyword> 상태의 적에게 주는 <keyword id=\"holy\">신성</keyword> 피해 <value id=\"quantity_1\">%1$lld</value> 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O dano <keyword id=\"holy\">Sagrado</keyword> aumenta em <value id=\"quantity_1\">%1$lld</value> contra inimigos <keyword id=\"stun\">Atordoados</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "對<keyword id=\"stun\">暈眩</keyword>的敵人，<keyword id=\"holy\">神聖</keyword>傷害增加<value id=\"quantity_1\">%1$lld</value>點"}}
      }
    },
