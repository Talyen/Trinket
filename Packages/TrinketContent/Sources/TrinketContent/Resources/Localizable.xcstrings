    "talents.pixie_holy_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: pixie_holy_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dein erster <keyword id=\"holy\">heiliger</keyword> Angriff in jedem Zug gewährt <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your first <keyword id=\"holy\">Holy</keyword> attack each turn grants <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu primer ataque <keyword id=\"holy\">sagrado</keyword> de cada turno otorga <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueo</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre première attaque de type <keyword id=\"holy\">Sacré</keyword> de chaque tour octroie <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Blocage</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "各ターンで最初の<keyword id=\"holy\">聖</keyword>攻撃で<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>獲得"}},
        "ko": {"stringUnit": {"state": "translated", "value": "매 턴 첫 <keyword id=\"holy\">신성</keyword> 공격 시 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 획득"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seu primeiro ataque <keyword id=\"holy\">Sagrado</keyword> de cada turno concede <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueio</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每回合首次<keyword id=\"holy\">神聖</keyword>攻擊賦予<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>"}}
      }
    },
