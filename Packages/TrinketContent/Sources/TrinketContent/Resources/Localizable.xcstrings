    "homestead_nodes.blacksmithforge.1.summary": {
      "comment": "ContentManifest/homestead_nodes.tsv: blacksmithForge.1, summary",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Eine betriebsame Schmiede für Beschläge, Waffen und stärkere Bauwerke"}},
        "en": {"stringUnit": {"state": "translated", "value": "A working forge for hardware, weapons, and stronger construction"}},
        "es": {"stringUnit": {"state": "translated", "value": "Una forja activa para herramientas, armas y construcciones más resistentes"}},
