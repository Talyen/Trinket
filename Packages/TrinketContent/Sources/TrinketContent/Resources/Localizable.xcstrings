    "talents.phoenix_health_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: phoenix_health_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überschüssige Wiederherstellung deiner <keyword id=\"health\">Gesundheit</keyword> fügt deinem nächsten <keyword id=\"burn\">Brand</keyword>-Angriff <value id=\"quantity_1\">%1$lld</value> Schaden hinzu"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Excess <keyword id=\"health\">Health</keyword> restored to you adds <value id=\"quantity_1\">%1$lld</value> damage to your next <keyword id=\"burn\">Burn</keyword> attack"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La <keyword id=\"health\">Santé</keyword> qui vous est restaurée en excès ajoute <value id=\"quantity_1\">%1$lld</value> dégâts à votre prochaine attaque de <keyword id=\"burn\">Brûlure</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の<keyword id=\"health\">体力</keyword>が過剰に回復すると、次の<keyword id=\"burn\">炎上</keyword>攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>増加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자신의 초과 <keyword id=\"health\">체력</keyword> 회복 시 다음 <keyword id=\"burn\">화상</keyword> 공격의 피해 <value id=\"quantity_1\">%1$lld</value> 증가"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自身<keyword id=\"health\">生命值</keyword>受到過量恢復時，下次<keyword id=\"burn\">燃燒</keyword>攻擊的傷害增加<value id=\"quantity_1\">%1$lld</value>點"
          }
