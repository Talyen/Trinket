    "talents.druid_mana_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: druid_mana_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn beide Verbündeten im selben Zug <keyword id=\"mana\">Mana</keyword> ausgeben, erhält jeder <value id=\"quantity_1\">%1$lld</value> <keyword id=\"thorns\">Dornen</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both allies spending <keyword id=\"mana\">Mana</keyword> in the same turn grants each <value id=\"quantity_1\">%1$lld</value> <keyword id=\"thorns\">Thorns</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si les deux alliés dépensent du <keyword id=\"mana\">Mana</keyword> au même tour, chacun gagne <value id=\"quantity_1\">%1$lld</value> <keyword id=\"thorns\">Épines</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じターンに味方2人が<keyword id=\"mana\">マナ</keyword>を消費すると、それぞれ<keyword id=\"thorns\">棘</keyword>を<value id=\"quantity_1\">%1$lld</value>獲得"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 아군이 같은 턴에 <keyword id=\"mana\">마나</keyword>를 소모하면 각각 <keyword id=\"thorns\">가시</keyword> <value id=\"quantity_1\">%1$lld</value> 획득"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同回合兩名友方都消耗<keyword id=\"mana\">魔力</keyword>時，各獲得<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"thorns\">荊棘</keyword>"
          }
        }
      }
    },
