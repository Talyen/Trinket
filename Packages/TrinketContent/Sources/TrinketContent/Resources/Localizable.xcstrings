    "talents.ranger_bleed_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: ranger_bleed_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">Blutungs</keyword>-Angriffe verursachen <value id=\"quantity_1\">%1$lld</value>%% mehr Schaden an <keyword id=\"stun\">betäubten</keyword> Gegnern"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">Bleed</keyword> attacks deal <value id=\"quantity_1\">%1$lld</value>%% more damage to <keyword id=\"stun\">Stunned</keyword> enemies"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques de <keyword id=\"bleed\">Sangrado</keyword> infligen un <value id=\"quantity_1\">%1$lld</value>%% más de daño a enemigos <keyword id=\"stun\">aturdidos</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques de <keyword id=\"bleed\">Saignement</keyword> infligent <value id=\"quantity_1\">%1$lld</value>%% de dégâts en plus aux ennemis sous <keyword id=\"stun\">Étourdissement</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">スタン</keyword>状態の敵への<keyword id=\"bleed\">出血</keyword>攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">기절</keyword> 상태의 적에게 <keyword id=\"bleed\">출혈</keyword> 공격의 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques de <keyword id=\"bleed\">Sangramento</keyword> causam <value id=\"quantity_1\">%1$lld</value>%% mais dano a inimigos <keyword id=\"stun\">Atordoados</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">流血</keyword>攻擊對<keyword id=\"stun\">暈眩</keyword>敵人的傷害提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
