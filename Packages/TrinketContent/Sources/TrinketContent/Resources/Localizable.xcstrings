    "talents.shield_scarab_holy_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: shield_scarab_holy_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Solange du <keyword id=\"block\">Block</keyword> hast, wird <keyword id=\"holy\">heiliger</keyword> Schaden um <value id=\"quantity_1\">%1$lld</value>%% erhöht"}},
        "en": {"stringUnit": {"state": "translated", "value": "While you have <keyword id=\"block\">Block</keyword>, <keyword id=\"holy\">Holy</keyword> damage is increased by <value id=\"quantity_1\">%1$lld</value>%%"}},
        "es": {"stringUnit": {"state": "translated", "value": "Mientras tienes <keyword id=\"block\">Bloqueo</keyword>, el daño <keyword id=\"holy\">sagrado</keyword> aumenta en un <value id=\"quantity_1\">%1$lld</value>%%"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Tant que vous avez du <keyword id=\"block\">Blocage</keyword>, les dégâts de type <keyword id=\"holy\">Sacré</keyword> augmentent de <value id=\"quantity_1\">%1$lld</value>%%"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">ブロック</keyword>がある間、<keyword id=\"holy\">聖</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">방어도</keyword>가 있으면 <keyword id=\"holy\">신성</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Enquanto tiver <keyword id=\"block\">Bloqueio</keyword>, o dano <keyword id=\"holy\">Sagrado</keyword> aumenta em <value id=\"quantity_1\">%1$lld</value>%%"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "擁有<keyword id=\"block\">格擋</keyword>時，<keyword id=\"holy\">神聖</keyword>傷害提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.shield_scarab_holy_t1_1.name": {
      "comment": "ContentManifest/talents.tsv: shield_scarab_holy_t1_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Vergoldeter Chitinpanzer"}},
        "en": {"stringUnit": {"state": "translated", "value": "Gilded Carapace"}},
