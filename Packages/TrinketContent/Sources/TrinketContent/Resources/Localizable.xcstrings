      }
    },
    "traits.lumbering.description": {
      "comment": "ContentManifest/traits.tsv: lumbering, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erlittener Schaden vom Typ <keyword id=\"stun\">Betäubung</keyword> um <value id=\"quantity_1\">%1$lld</value> %% erhöht"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">Stun</keyword> damage taken increased by <value id=\"quantity_1\">%1$lld</value>%%"}},
        "es": {"stringUnit": {"state": "translated", "value": "El daño de <keyword id=\"stun\">Aturdimiento</keyword> recibido aumenta un <value id=\"quantity_1\">%1$lld</value> %%"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les dégâts d’<keyword id=\"stun\">Étourdissement</keyword> subis augmentent de <value id=\"quantity_1\">%1$lld</value> %%"}},
        "ja": {"stringUnit": {"state": "translated", "value": "受ける<keyword id=\"stun\">スタン</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "받는 <keyword id=\"stun\">기절</keyword> 피해가 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O dano de <keyword id=\"stun\">Atordoamento</keyword> recebido aumenta em <value id=\"quantity_1\">%1$lld</value>%%"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "受到的<keyword id=\"stun\">暈眩</keyword>傷害提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
