    "authored.0f3925b4d796195e": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Encounters/Mystery/MysteryEventPool+Events.swift: narrative",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ein uraltes Skelett bewacht „%1$@“, während rund um „%2$@“ Goldmünzen verstreut liegen"}},
        "en": {"stringUnit": {"state": "translated", "value": "An ancient skeleton guards “%1$@” while gold coins spill around “%2$@”"}},
        "es": {"stringUnit": {"state": "translated", "value": "Un esqueleto antiguo custodia «%1$@» mientras monedas de oro se derraman alrededor de «%2$@»"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Un ancien squelette garde « %1$@ », tandis que des pièces d’or se répandent autour de « %2$@ »"}},
        "ja": {"stringUnit": {"state": "translated", "value": "古代の骸骨が「%1$@」を守り、「%2$@」の周りには金貨がこぼれている"}},
        "ko": {"stringUnit": {"state": "translated", "value": "고대 해골이 지키는 것은 ‘%1$@’, ‘%2$@’ 주위에는 금화가 쏟아져 있습니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Um esqueleto ancestral guarda “%1$@” enquanto moedas de ouro se espalham ao redor de “%2$@”"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "古老骷髏守護著「%1$@」，金幣散落在「%2$@」四周"}}
      }
    },
    "authored.0f7d3f163db26abe": {
      "comment": "Packages/TrinketAppState/Sources/TrinketAppState/Play/Modes/SpiresPlayMode.swift: player-facing failure message",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dieser Turm ist noch nicht bereit."}},
        "en": {"stringUnit": {"state": "translated", "value": "This Spire is not ready yet."}},
        "es": {"stringUnit": {"state": "translated", "value": "Esta Aguja aún no está lista."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Cette Tour n’est pas encore prête."}},
        "ja": {"stringUnit": {"state": "translated", "value": "この尖塔はまだ準備できていません。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "이 첨탑은 아직 준비되지 않았습니다."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Esta Torre ainda não está pronta."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "這座高塔尚未準備就緒。"}}
      }
    },
    "authored.10aa10678d29bbeb": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Encounters/Rewards/RewardModifier.swift: computed description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Lässt Gegenstände mit <keyword id=\"deathsdoor\">Todesschwelle</keyword> fallen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Drops <keyword id=\"deathsdoor\">Death's Door</keyword> items"}},
        "es": {"stringUnit": {"state": "translated", "value": "Otorga objetos de <keyword id=\"deathsdoor\">Puertas de la Muerte</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Butin : objets de type <keyword id=\"deathsdoor\">Seuil de la mort</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">死の淵</keyword>アイテムをドロップ"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">죽음의 문턱</keyword> 아이템 드롭"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Concede itens da condição <keyword id=\"deathsdoor\">À Beira da Morte</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "掉落<keyword id=\"deathsdoor\">瀕死之門</keyword>物品"}}
      }
    },
    "authored.128a299334d9ba34": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Abilities/AbilityCatalog+Skill.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verursache <value id=\"quantity_1\">%1$lld</value> <keyword id=\"holy\">heiligen</keyword> Schaden\n<keyword id=\"purge\">Entzaubere</keyword> <value id=\"quantity_2\">%2$lld</value> Verstärkung des Gegners"}},
        "en": {"stringUnit": {"state": "translated", "value": "Deal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"holy\">Holy</keyword> damage\n<keyword id=\"purge\">Purge</keyword> <value id=\"quantity_2\">%2$lld</value> buff from the enemy"}},
        "es": {"stringUnit": {"state": "translated", "value": "Inflige <value id=\"quantity_1\">%1$lld</value> de daño <keyword id=\"holy\">sagrado</keyword>\n<keyword id=\"purge\">Purga</keyword> <value id=\"quantity_2\">%2$lld</value> mejora del enemigo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Inflige <value id=\"quantity_1\">%1$lld</value> dégâts de type <keyword id=\"holy\">Sacré</keyword>\n<keyword id=\"purge\">Dissipation</keyword> de <value id=\"quantity_2\">%2$lld</value> bonus de l’ennemi"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">聖</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える\n敵の強化効果を<value id=\"quantity_2\">%2$lld</value>個<keyword id=\"purge\">強化解除</keyword>"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">신성</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>\n<keyword id=\"purge\">강화 해제</keyword>로 적의 강화 효과 <value id=\"quantity_2\">%2$lld</value>개 제거"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cause <value id=\"quantity_1\">%1$lld</value> de dano <keyword id=\"holy\">Sagrado</keyword>\n<keyword id=\"purge\">Expurgue</keyword> <value id=\"quantity_2\">%2$lld</value> efeito positivo do inimigo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"holy\">神聖</keyword>傷害\n<keyword id=\"purge\">驅散</keyword>敵人的<value id=\"quantity_2\">%2$lld</value>項增益效果"}}
      }
    },
