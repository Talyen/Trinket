    "talents.alchemist_health_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: alchemist_health_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Hälfte deiner überschüssigen Heilung wird für den Empfänger zu <keyword id=\"block\">Block</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Half your excess healing becomes <keyword id=\"block\">Block</keyword> for its recipient"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La moitié de vos soins excédentaires devient du <keyword id=\"block\">Blocage</keyword> pour le bénéficiaire"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過剰回復量の半分を、回復対象の<keyword id=\"block\">ブロック</keyword>に変換"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초과 치유량의 절반을 치유 대상의 <keyword id=\"block\">방어도</keyword>로 전환"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將自身過量治療的一半轉為受治者的<keyword id=\"block\">格擋</keyword>"
          }
        }
      }
    },
