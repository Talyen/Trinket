    "affixes.martyrs.title": {
      "comment": "ContentManifest/affixes.tsv: martyrs, title",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Märtyrer"}},
        "en": {"stringUnit": {"state": "translated", "value": "Martyr's"}},
        "es": {"stringUnit": {"state": "translated", "value": "Del mártir"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Du martyr"}},
        "ja": {"stringUnit": {"state": "translated", "value": "殉教者の"}},
        "ko": {"stringUnit": {"state": "translated", "value": "순교자의"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Do Mártir"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "殉道者的"}}
      }
    },
    "affixes.measured.astral_description": {
      "comment": "ContentManifest/affixes.tsv: measured, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Angriffe verursachen <value id=\"quantity_1\">%1$lld</value> zusätzlichen Schaden, solange der Gegner mehr <keyword id=\"block\">Block</keyword> hat als du"}},
        "en": {"stringUnit": {"state": "translated", "value": "Attacks gain <value id=\"quantity_1\">%1$lld</value> damage while the enemy has more <keyword id=\"block\">Block</keyword> than you"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques infligen <value id=\"quantity_1\">%1$lld</value> de daño adicional mientras el enemigo tenga más <keyword id=\"block\">Bloqueo</keyword> que tú"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques infligent <value id=\"quantity_1\">%1$lld</value> dégâts supplémentaires si l’ennemi a plus de <keyword id=\"block\">Blocage</keyword> que vous"}},
        "ja": {"stringUnit": {"state": "translated", "value": "敵の<keyword id=\"block\">ブロック</keyword>が自分より多い間、攻撃ダメージが<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "적의 <keyword id=\"block\">방어도</keyword>가 자신보다 많으면 공격 피해가 <value id=\"quantity_1\">%1$lld</value> 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques causam <value id=\"quantity_1\">%1$lld</value> de dano adicional enquanto o inimigo tiver mais <keyword id=\"block\">Bloqueio</keyword> que você"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "敵人的<keyword id=\"block\">格擋</keyword>比你多時，攻擊傷害提高<value id=\"quantity_1\">%1$lld</value>"}}
      }
    },
    "affixes.measured.basic_description": {
      "comment": "ContentManifest/affixes.tsv: measured, basic_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Angriffe verursachen <value id=\"quantity_1\">%1$lld</value> zusätzlichen Schaden, solange der Gegner mehr <keyword id=\"block\">Block</keyword> hat als du"}},
        "en": {"stringUnit": {"state": "translated", "value": "Attacks gain <value id=\"quantity_1\">%1$lld</value> damage while the enemy has more <keyword id=\"block\">Block</keyword> than you"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques infligen <value id=\"quantity_1\">%1$lld</value> de daño adicional mientras el enemigo tenga más <keyword id=\"block\">Bloqueo</keyword> que tú"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques infligent <value id=\"quantity_1\">%1$lld</value> dégâts supplémentaires si l’ennemi a plus de <keyword id=\"block\">Blocage</keyword> que vous"}},
        "ja": {"stringUnit": {"state": "translated", "value": "敵の<keyword id=\"block\">ブロック</keyword>が自分より多い間、攻撃ダメージが<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "적의 <keyword id=\"block\">방어도</keyword>가 자신보다 많으면 공격 피해가 <value id=\"quantity_1\">%1$lld</value> 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques causam <value id=\"quantity_1\">%1$lld</value> de dano adicional enquanto o inimigo tiver mais <keyword id=\"block\">Bloqueio</keyword> que você"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "敵人的<keyword id=\"block\">格擋</keyword>比你多時，攻擊傷害提高<value id=\"quantity_1\">%1$lld</value>"}}
