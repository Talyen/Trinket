    "affixes.ironwood_buckler.astral_description": {
      "comment": "ContentManifest/affixes.tsv: ironwood_buckler, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte <keyword id=\"thorns\">Dornen</keyword> in Höhe der Hälfte deines erhaltenen <keyword id=\"block\">Blocks</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gain <keyword id=\"thorns\">Thorns</keyword> equal to half the <keyword id=\"block\">Block</keyword> you gain"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagnez des <keyword id=\"thorns\">Épines</keyword> à hauteur de la moitié du <keyword id=\"block\">Blocage</keyword> obtenu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "獲得した<keyword id=\"block\">ブロック</keyword>の半分に等しい<keyword id=\"thorns\">棘</keyword>を獲得"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "획득한 <keyword id=\"block\">방어도</keyword>의 절반만큼 <keyword id=\"thorns\">가시</keyword> 획득"
          }
        },
        "zh-Hant": {
