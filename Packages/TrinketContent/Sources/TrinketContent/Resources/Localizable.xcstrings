    "talents.rogue_poison_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: rogue_poison_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei <keyword id=\"poison\">vergifteten</keyword> Gegnern steigt der <keyword id=\"stun\">Betäubungs</keyword>aufbau um <value id=\"quantity_1\">%1$lld</value>%%"
          }
