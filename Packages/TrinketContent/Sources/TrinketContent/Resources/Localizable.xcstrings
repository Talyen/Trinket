    "affixes.thornwrought.astral_description": {
      "comment": "ContentManifest/affixes.tsv: thornwrought, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erhalte zu Kampfbeginn <value id=\"quantity_1\">%1$lld</value> <keyword id=\"thorns\">Dornen</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Gain <value id=\"quantity_1\">%1$lld</value> <keyword id=\"thorns\">Thorns</keyword> at the start of combat"}},
        "es": {"stringUnit": {"state": "translated", "value": "Obtén <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"thorns\">Espinas</keyword> al inicio del combate"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Gagnez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"thorns\">Épines</keyword> au début du combat"}},
        "ja": {"stringUnit": {"state": "translated", "value": "戦闘開始時に<keyword id=\"thorns\">棘</keyword>を<value id=\"quantity_1\">%1$lld</value>獲得"}},
        "ko": {"stringUnit": {"state": "translated", "value": "전투 시작 시 <keyword id=\"thorns\">가시</keyword> <value id=\"quantity_1\">%1$lld</value> 획득"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ganhe <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"thorns\">Espinhos</keyword> no início do combate"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "戰鬥開始時獲得<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"thorns\">荊棘</keyword>"}}
      }
    },
