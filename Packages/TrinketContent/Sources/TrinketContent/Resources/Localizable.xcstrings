    "affixes.bloodbound.basic_description": {
      "comment": "ContentManifest/affixes.tsv: bloodbound, basic_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle <value id=\"quantity_1\">%1$lld</value> zusätzliche <keyword id=\"health\">Gesundheit</keyword> wieder her, wenn du <keyword id=\"leech\">Lebensraub</keyword> einsetzt"
          }
