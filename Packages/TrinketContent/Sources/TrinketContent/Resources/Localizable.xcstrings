        "en": {"stringUnit": {"state": "translated", "value": "Prismatic"}},
        "es": {"stringUnit": {"state": "translated", "value": "Prismático"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Prismatique"}},
        "ja": {"stringUnit": {"state": "translated", "value": "多彩"}},
        "ko": {"stringUnit": {"state": "translated", "value": "다채"}},
