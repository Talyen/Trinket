        "fr": {"stringUnit": {"state": "translated", "value": "Léchouille protectrice"}},
        "ja": {"stringUnit": {"state": "translated", "value": "守りのひと舐め"}},
        "ko": {"stringUnit": {"state": "translated", "value": "보호의 핥기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Lambida Protetora"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "守護舔舐"}}
      }
    },
    "talents.golden_retriever_health_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: golden_retriever_health_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Überschüssige Heilung, die du erhältst, stellt die <keyword id=\"health\">Gesundheit</keyword> deines Helden wieder her"}},
        "en": {"stringUnit": {"state": "translated", "value": "Excess healing you receive restores your Hero’s <keyword id=\"health\">Health</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "La curación sobrante que recibes restaura la <keyword id=\"health\">Salud</keyword> de tu héroe"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les soins excédentaires que vous recevez restaurent la <keyword id=\"health\">Santé</keyword> de votre Héros"}},
        "ja": {"stringUnit": {"state": "translated", "value": "自分が受けた過剰回復で、ヒーローの<keyword id=\"health\">体力</keyword>を回復"}},
        "ko": {"stringUnit": {"state": "translated", "value": "받는 초과 치유량만큼 영웅의 <keyword id=\"health\">체력</keyword> 회복"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "A cura excedente que você recebe restaura a <keyword id=\"health\">Vida</keyword> do seu Herói"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "自身受到的過量治療會恢復英雄的<keyword id=\"health\">生命值</keyword>"}}
      }
    },
    "talents.golden_retriever_health_t4_1.name": {
      "comment": "ContentManifest/talents.tsv: golden_retriever_health_t4_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ansteckende Freude"}},
        "en": {"stringUnit": {"state": "translated", "value": "Contagious Joy"}},
        "es": {"stringUnit": {"state": "translated", "value": "Alegría contagiosa"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Joie contagieuse"}},
        "ja": {"stringUnit": {"state": "translated", "value": "広がる喜び"}},
        "ko": {"stringUnit": {"state": "translated", "value": "퍼지는 기쁨"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Alegria Contagiante"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "喜悅傳染"}}
      }
