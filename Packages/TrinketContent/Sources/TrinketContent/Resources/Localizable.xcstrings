    "homestead_nodes.mycologycellar.1.summary": {
      "comment": "ContentManifest/homestead_nodes.tsv: mycologyCellar.1, summary",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein schattiger Keller zur Zucht parasitärer Pilze und wirksamer Reagenzien"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A shaded cellar cultivating parasitic fungi and potent reagents"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une cave ombragée pour cultiver des champignons parasites et des réactifs puissants"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "寄生菌や強力な試薬を育てる、薄暗い地下室"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기생 버섯과 강력한 시약을 배양하는 그늘진 지하실"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "培養寄生真菌與強效試劑的陰暗地窖"
          }
        }
      }
    },
