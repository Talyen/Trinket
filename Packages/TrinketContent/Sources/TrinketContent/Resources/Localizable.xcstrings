            "value": "처음으로 <keyword id=\"health\">체력</keyword>이 <value id=\"quantity_2\">%2$lld</value>%% 미만이 되면 <keyword id=\"health\">체력</keyword> <value id=\"quantity_1\">%1$lld</value> 회복"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">生命值</keyword>首次低於<value id=\"quantity_2\">%2$lld</value>%%時，恢復<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"health\">生命值</keyword>"
          }
        }
      }
    },
