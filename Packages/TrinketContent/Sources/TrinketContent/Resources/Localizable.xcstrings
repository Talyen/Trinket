    "talents.wizard_freeze_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: wizard_freeze_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocken verursacht einmal pro Zug <value id=\"quantity_1\">%1$lld</value> <keyword id=\"freeze\">Frost</keyword>schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocking deals <value id=\"quantity_1\">%1$lld</value> <keyword id=\"freeze\">Freeze</keyword> damage once per turn"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquer inflige <value id=\"quantity_1\">%1$lld</value> dégâts de <keyword id=\"freeze\">Gel</keyword> une fois par tour"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1ターンに1回、ブロックすると<keyword id=\"freeze\">凍結</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "턴마다 한 번, 공격을 막으면 <keyword id=\"freeze\">빙결</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每回合一次，格擋時造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"freeze\">冰凍</keyword>傷害"
          }
        }
      }
    },
