    "talents.phoenix_burn_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: phoenix_burn_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Brand</keyword>-Angriffe verursachen <value id=\"quantity_1\">%1$lld</value>%% mehr Schaden an gegnerischem <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Burn</keyword> attacks deal <value id=\"quantity_1\">%1$lld</value>%% more damage to enemy <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques de <keyword id=\"burn\">Quemadura</keyword> infligen un <value id=\"quantity_1\">%1$lld</value>%% más de daño al <keyword id=\"block\">Bloqueo</keyword> del enemigo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques de <keyword id=\"burn\">Brûlure</keyword> infligent <value id=\"quantity_1\">%1$lld</value>%% de dégâts en plus au <keyword id=\"block\">Blocage</keyword> ennemi"}},
        "ja": {"stringUnit": {"state": "translated", "value": "敵の<keyword id=\"block\">ブロック</keyword>への<keyword id=\"burn\">炎上</keyword>攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">화상</keyword> 공격이 적의 <keyword id=\"block\">방어도</keyword>에 주는 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques de <keyword id=\"burn\">Queimadura</keyword> causam <value id=\"quantity_1\">%1$lld</value>%% mais dano ao <keyword id=\"block\">Bloqueio</keyword> inimigo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">燃燒</keyword>攻擊對敵人<keyword id=\"block\">格擋</keyword>造成的傷害增加<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.phoenix_burn_t3_1.name": {
      "comment": "ContentManifest/talents.tsv: phoenix_burn_t3_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Schmelzhitze"}},
        "en": {"stringUnit": {"state": "translated", "value": "Molten Heat"}},
        "es": {"stringUnit": {"state": "translated", "value": "Calor fundente"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Chaleur en fusion"}},
        "ja": {"stringUnit": {"state": "translated", "value": "溶岩の熱"}},
        "ko": {"stringUnit": {"state": "translated", "value": "용암의 열기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Calor Fundente"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "熔岩高熱"}}
      }
    },
    "talents.phoenix_burn_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: phoenix_burn_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Brennende</keyword> Gegner erleiden <value id=\"quantity_1\">%1$lld</value>%% mehr Schaden durch deine kritischen Treffer"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Burning</keyword> enemies take <value id=\"quantity_1\">%1$lld</value>%% increased damage from your Critical Hits"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los enemigos con <keyword id=\"burn\">Quemadura</keyword> reciben un <value id=\"quantity_1\">%1$lld</value>%% más de daño de tus golpes críticos"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les ennemis sous <keyword id=\"burn\">Brûlure</keyword> subissent <value id=\"quantity_1\">%1$lld</value>%% de dégâts en plus de vos coups critiques"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">炎上</keyword>状態の敵が自分のクリティカルヒットから受けるダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">화상</keyword> 상태의 적에게 주는 내 치명타 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Inimigos <keyword id=\"burn\">Em Chamas</keyword> recebem <value id=\"quantity_1\">%1$lld</value>%% mais dano dos seus golpes críticos"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">燃燒</keyword>中的敵人承受你的暴擊時，傷害增加<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.phoenix_burn_t3_2.name": {
      "comment": "ContentManifest/talents.tsv: phoenix_burn_t3_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Intensive Hitze"}},
        "en": {"stringUnit": {"state": "translated", "value": "Intense Heat"}},
        "es": {"stringUnit": {"state": "translated", "value": "Calor intenso"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Chaleur intense"}},
        "ja": {"stringUnit": {"state": "translated", "value": "猛熱"}},
        "ko": {"stringUnit": {"state": "translated", "value": "맹렬한 열기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Calor Intenso"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "極熱"}}
      }
    },
    "talents.phoenix_burn_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: phoenix_burn_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Kritische <keyword id=\"burn\">Brand</keyword>-Treffer stellen <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword> wieder her"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Burn</keyword> Critical Hits restore <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los golpes críticos de <keyword id=\"burn\">Quemadura</keyword> restauran <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"mana\">Maná</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les coups critiques de <keyword id=\"burn\">Brûlure</keyword> restaurent <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">炎上</keyword>クリティカルヒットで<keyword id=\"mana\">マナ</keyword>を<value id=\"quantity_1\">%1$lld</value>回復"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">화상</keyword> 치명타 적중 시 <keyword id=\"mana\">마나</keyword> <value id=\"quantity_1\">%1$lld</value> 회복"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Golpes críticos de <keyword id=\"burn\">Queimadura</keyword> restauram <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"mana\">Mana</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">燃燒</keyword>暴擊恢復<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"mana\">魔力</keyword>"}}
      }
    },
    "talents.phoenix_burn_t4_1.name": {
      "comment": "ContentManifest/talents.tsv: phoenix_burn_t4_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ofenrhythmus"}},
        "en": {"stringUnit": {"state": "translated", "value": "Furnace Rhythm"}},
        "es": {"stringUnit": {"state": "translated", "value": "Ritmo del horno"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Rythme de fournaise"}},
        "ja": {"stringUnit": {"state": "translated", "value": "炉の律動"}},
        "ko": {"stringUnit": {"state": "translated", "value": "용광로의 리듬"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ritmo da Fornalha"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "熔爐律動"}}
      }
    },
    "talents.phoenix_deathsdoor_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: phoenix_deathsdoor_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Erreichen der <keyword id=\"deathsdoor\">Todesschwelle</keyword> stellt <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Gesundheit</keyword> wieder her"}},
        "en": {"stringUnit": {"state": "translated", "value": "Entering <keyword id=\"deathsdoor\">Death's Door</keyword> restores <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Health</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Entrar en las <keyword id=\"deathsdoor\">Puertas de la Muerte</keyword> restaura <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Salud</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Atteindre le <keyword id=\"deathsdoor\">Seuil de la mort</keyword> restaure <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Santé</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">死の淵</keyword>に入ると<keyword id=\"health\">体力</keyword>を<value id=\"quantity_1\">%1$lld</value>回復"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">죽음의 문턱</keyword>에 들어서면 <keyword id=\"health\">체력</keyword> <value id=\"quantity_1\">%1$lld</value> 회복"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ficar <keyword id=\"deathsdoor\">À Beira da Morte</keyword> restaura <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Vida</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "進入<keyword id=\"deathsdoor\">瀕死之門</keyword>時，恢復<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"health\">生命值</keyword>"}}
      }
    },
    "talents.phoenix_deathsdoor_t1_1.name": {
      "comment": "ContentManifest/talents.tsv: phoenix_deathsdoor_t1_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Aus der Asche"}},
        "en": {"stringUnit": {"state": "translated", "value": "From the Ashes"}},
        "es": {"stringUnit": {"state": "translated", "value": "De las cenizas"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Des cendres"}},
        "ja": {"stringUnit": {"state": "translated", "value": "灰からの帰還"}},
        "ko": {"stringUnit": {"state": "translated", "value": "잿더미에서"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Das Cinzas"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "浴火重生"}}
      }
    },
    "talents.phoenix_deathsdoor_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: phoenix_deathsdoor_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Die <keyword id=\"deathsdoor\">Todesschwelle</keyword> hält <value id=\"quantity_1\">%1$lld</value> zusätzlichen Zug an"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">Death's Door</keyword> lasts <value id=\"quantity_1\">%1$lld</value> additional turn"}},
        "es": {"stringUnit": {"state": "translated", "value": "El efecto <keyword id=\"deathsdoor\">Puertas de la Muerte</keyword> dura <value id=\"quantity_1\">%1$lld</value> turno adicional"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le <keyword id=\"deathsdoor\">Seuil de la mort</keyword> dure <value id=\"quantity_1\">%1$lld</value> tour de plus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">死の淵</keyword>がさらに<value id=\"quantity_1\">%1$lld</value>ターン持続"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">죽음의 문턱</keyword> 지속 시간 <value id=\"quantity_1\">%1$lld</value>턴 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "A condição <keyword id=\"deathsdoor\">À Beira da Morte</keyword> dura <value id=\"quantity_1\">%1$lld</value> turno adicional"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">瀕死之門</keyword>額外持續<value id=\"quantity_1\">%1$lld</value>回合"}}
      }
    },
    "talents.phoenix_deathsdoor_t1_2.name": {
      "comment": "ContentManifest/talents.tsv: phoenix_deathsdoor_t1_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verweilender Geist"}},
        "en": {"stringUnit": {"state": "translated", "value": "Lingering Spirit"}},
        "es": {"stringUnit": {"state": "translated", "value": "Espíritu persistente"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Esprit persistant"}},
        "ja": {"stringUnit": {"state": "translated", "value": "消えぬ魂"}},
        "ko": {"stringUnit": {"state": "translated", "value": "머무는 영혼"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Espírito Persistente"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "留戀之靈"}}
      }
    },
    "talents.phoenix_deathsdoor_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: phoenix_deathsdoor_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Erreichen der <keyword id=\"deathsdoor\">Todesschwelle</keyword> verursacht beim Gegner <value id=\"quantity_1\">%1$lld</value> <keyword id=\"burn\">Brand</keyword>schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Entering <keyword id=\"deathsdoor\">Death's Door</keyword> deals <value id=\"quantity_1\">%1$lld</value> <keyword id=\"burn\">Burn</keyword> damage to the enemy"}},
        "es": {"stringUnit": {"state": "translated", "value": "Entrar en las <keyword id=\"deathsdoor\">Puertas de la Muerte</keyword> inflige <value id=\"quantity_1\">%1$lld</value> de daño de <keyword id=\"burn\">Quemadura</keyword> al enemigo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Atteindre le <keyword id=\"deathsdoor\">Seuil de la mort</keyword> inflige <value id=\"quantity_1\">%1$lld</value> dégâts de <keyword id=\"burn\">Brûlure</keyword> à l’ennemi"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">死の淵</keyword>に入ると敵に<keyword id=\"burn\">炎上</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">죽음의 문턱</keyword>에 들어서면 적에게 <keyword id=\"burn\">화상</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ficar <keyword id=\"deathsdoor\">À Beira da Morte</keyword> causa <value id=\"quantity_1\">%1$lld</value> de dano de <keyword id=\"burn\">Queimadura</keyword> ao inimigo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "進入<keyword id=\"deathsdoor\">瀕死之門</keyword>時，對敵人造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"burn\">燃燒</keyword>傷害"}}
      }
    },
    "talents.phoenix_deathsdoor_t2_1.name": {
      "comment": "ContentManifest/talents.tsv: phoenix_deathsdoor_t2_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Lodernde Wiedergeburt"}},
        "en": {"stringUnit": {"state": "translated", "value": "Blazing Rebirth"}},
        "es": {"stringUnit": {"state": "translated", "value": "Renacer llameante"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Renaissance ardente"}},
        "ja": {"stringUnit": {"state": "translated", "value": "炎の再誕"}},
        "ko": {"stringUnit": {"state": "translated", "value": "불타는 재탄생"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Renascimento Flamejante"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "烈焰重生"}}
      }
    },
    "talents.phoenix_deathsdoor_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: phoenix_deathsdoor_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Überleben der <keyword id=\"deathsdoor\">Todesschwelle</keyword> verdoppelt deinen nächsten Angriff"}},
        "en": {"stringUnit": {"state": "translated", "value": "Surviving <keyword id=\"deathsdoor\">Death's Door</keyword> doubles your next attack"}},
        "es": {"stringUnit": {"state": "translated", "value": "Sobrevivir a las <keyword id=\"deathsdoor\">Puertas de la Muerte</keyword> duplica tu siguiente ataque"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Survivre au <keyword id=\"deathsdoor\">Seuil de la mort</keyword> double votre prochaine attaque"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">死の淵</keyword>を生き延びると次の攻撃が2倍になる"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">죽음의 문턱</keyword>에서 살아남으면 다음 공격이 두 배"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Sobreviver à condição <keyword id=\"deathsdoor\">À Beira da Morte</keyword> dobra seu próximo ataque"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "從<keyword id=\"deathsdoor\">瀕死之門</keyword>生還後，下次攻擊加倍"}}
      }
    },
    "talents.phoenix_deathsdoor_t2_2.name": {
      "comment": "ContentManifest/talents.tsv: phoenix_deathsdoor_t2_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Phönixkraft"}},
        "en": {"stringUnit": {"state": "translated", "value": "Phoenix Vigor"}},
        "es": {"stringUnit": {"state": "translated", "value": "Vigor de fénix"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Vigueur du phénix"}},
        "ja": {"stringUnit": {"state": "translated", "value": "不死鳥の活力"}},
        "ko": {"stringUnit": {"state": "translated", "value": "불사조의 활력"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Vigor da Fênix"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "鳳凰活力"}}
      }
    },
    "talents.phoenix_deathsdoor_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: phoenix_deathsdoor_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Die <keyword id=\"deathsdoor\">Todesschwelle</keyword> halbiert den Schaden, den du erleidest"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">Death's Door</keyword> halves damage you take"}},
        "es": {"stringUnit": {"state": "translated", "value": "El efecto <keyword id=\"deathsdoor\">Puertas de la Muerte</keyword> reduce a la mitad el daño que recibes"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le <keyword id=\"deathsdoor\">Seuil de la mort</keyword> réduit de moitié les dégâts subis"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">死の淵</keyword>の間、受けるダメージが半減"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">죽음의 문턱</keyword> 상태에서 받는 피해가 절반으로 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "A condição <keyword id=\"deathsdoor\">À Beira da Morte</keyword> reduz à metade o dano que você recebe"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">瀕死之門</keyword>使自身承受的傷害減半"}}
      }
    },
    "talents.phoenix_deathsdoor_t3_1.name": {
      "comment": "ContentManifest/talents.tsv: phoenix_deathsdoor_t3_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Gestärkte Wiedergeburt"}},
        "en": {"stringUnit": {"state": "translated", "value": "Fortified Rebirth"}},
        "es": {"stringUnit": {"state": "translated", "value": "Renacer fortificado"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Renaissance fortifiée"}},
        "ja": {"stringUnit": {"state": "translated", "value": "堅固な再誕"}},
        "ko": {"stringUnit": {"state": "translated", "value": "굳건한 재탄생"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Renascimento Fortificado"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "堅固重生"}}
      }
    },
    "talents.phoenix_deathsdoor_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: phoenix_deathsdoor_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Die <keyword id=\"deathsdoor\">Todesschwelle</keyword> verhindert Schwächungseffekte"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">Death's Door</keyword> prevents debuffs"}},
        "es": {"stringUnit": {"state": "translated", "value": "El efecto <keyword id=\"deathsdoor\">Puertas de la Muerte</keyword> impide perjuicios"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le <keyword id=\"deathsdoor\">Seuil de la mort</keyword> empêche les malus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">死の淵</keyword>の間、弱体効果を防ぐ"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">죽음의 문턱</keyword> 상태에서 약화 효과 방지"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "A condição <keyword id=\"deathsdoor\">À Beira da Morte</keyword> impede efeitos negativos"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">瀕死之門</keyword>防止減益效果"}}
      }
    },
    "talents.phoenix_deathsdoor_t3_2.name": {
      "comment": "ContentManifest/talents.tsv: phoenix_deathsdoor_t3_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ascheschutz"}},
        "en": {"stringUnit": {"state": "translated", "value": "Ashen Ward"}},
        "es": {"stringUnit": {"state": "translated", "value": "Protección de ceniza"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Protection de cendres"}},
        "ja": {"stringUnit": {"state": "translated", "value": "灰の守り"}},
        "ko": {"stringUnit": {"state": "translated", "value": "잿빛 수호"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Proteção de Cinzas"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "灰燼守護"}}
      }
    },
    "talents.phoenix_deathsdoor_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: phoenix_deathsdoor_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Brand</keyword>schaden erhält <keyword id=\"leech\">Lebensraub</keyword>, solange du an der <keyword id=\"deathsdoor\">Todesschwelle</keyword> stehst"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Burn</keyword> damage gains <keyword id=\"leech\">Leech</keyword> while you're on <keyword id=\"deathsdoor\">Death's Door</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "El daño de <keyword id=\"burn\">Quemadura</keyword> obtiene <keyword id=\"leech\">Absorción</keyword> mientras estás a las <keyword id=\"deathsdoor\">Puertas de la Muerte</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les dégâts de <keyword id=\"burn\">Brûlure</keyword> bénéficient de <keyword id=\"leech\">Vol de vie</keyword> lorsque vous êtes au <keyword id=\"deathsdoor\">Seuil de la mort</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">死の淵</keyword>の間、<keyword id=\"burn\">炎上</keyword>ダメージに<keyword id=\"leech\">吸収</keyword>を付与"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">죽음의 문턱</keyword> 상태이면 <keyword id=\"burn\">화상</keyword> 피해에 <keyword id=\"leech\">흡혈</keyword> 부여"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Dano de <keyword id=\"burn\">Queimadura</keyword> ganha <keyword id=\"leech\">Drenagem</keyword> enquanto você estiver <keyword id=\"deathsdoor\">À Beira da Morte</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "處於<keyword id=\"deathsdoor\">瀕死之門</keyword>時，<keyword id=\"burn\">燃燒</keyword>傷害獲得<keyword id=\"leech\">吸血</keyword>"}}
      }
    },
    "talents.phoenix_deathsdoor_t4_1.name": {
      "comment": "ContentManifest/talents.tsv: phoenix_deathsdoor_t4_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Unsterbliche Glut"}},
        "en": {"stringUnit": {"state": "translated", "value": "Undying Ember"}},
        "es": {"stringUnit": {"state": "translated", "value": "Ascua inmortal"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Braise immortelle"}},
        "ja": {"stringUnit": {"state": "translated", "value": "不滅の残り火"}},
        "ko": {"stringUnit": {"state": "translated", "value": "꺼지지 않는 잿불"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Brasa Imortal"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "不滅餘燼"}}
      }
    },
    "talents.phoenix_health_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: phoenix_health_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Unter halber <keyword id=\"health\">Gesundheit</keyword> stellst du <value id=\"quantity_1\">%1$lld</value>%% mehr <keyword id=\"health\">Gesundheit</keyword> wieder her"}},
        "en": {"stringUnit": {"state": "translated", "value": "Below half <keyword id=\"health\">Health</keyword>, restore <value id=\"quantity_1\">%1$lld</value>%% more <keyword id=\"health\">Health</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Por debajo de la mitad de <keyword id=\"health\">Salud</keyword>, restaura un <value id=\"quantity_1\">%1$lld</value>%% más de <keyword id=\"health\">Salud</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Sous la moitié de votre <keyword id=\"health\">Santé</keyword>, restaurez <value id=\"quantity_1\">%1$lld</value>%% de <keyword id=\"health\">Santé</keyword> en plus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>が半分未満なら、<keyword id=\"health\">体力</keyword>回復量が<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword>이 절반 미만이면 <keyword id=\"health\">체력</keyword> 회복량 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Abaixo de metade da <keyword id=\"health\">Vida</keyword>, restaure <value id=\"quantity_1\">%1$lld</value>%% mais <keyword id=\"health\">Vida</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">生命值</keyword>低於一半時，恢復的<keyword id=\"health\">生命值</keyword>增加<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.phoenix_health_t1_1.name": {
      "comment": "ContentManifest/talents.tsv: phoenix_health_t1_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Heilende Asche"}},
        "en": {"stringUnit": {"state": "translated", "value": "Restorative Ashes"}},
        "es": {"stringUnit": {"state": "translated", "value": "Cenizas restauradoras"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Cendres réparatrices"}},
        "ja": {"stringUnit": {"state": "translated", "value": "癒やしの灰"}},
        "ko": {"stringUnit": {"state": "translated", "value": "회복의 잿더미"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cinzas Restauradoras"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "療癒灰燼"}}
      }
    },
    "talents.phoenix_health_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: phoenix_health_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Brand</keyword>-Angriffe stellen mit <value id=\"quantity_1\">%1$lld</value>%% Chance <value id=\"quantity_2\">%2$lld</value> <keyword id=\"health\">Gesundheit</keyword> beim Verbündeten mit der niedrigsten Gesundheit wieder her"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Burn</keyword> attacks have a <value id=\"quantity_1\">%1$lld</value>%% chance to restore <value id=\"quantity_2\">%2$lld</value> <keyword id=\"health\">Health</keyword> to the lowest ally"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques de <keyword id=\"burn\">Quemadura</keyword> tienen un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de restaurar <value id=\"quantity_2\">%2$lld</value> de <keyword id=\"health\">Salud</keyword> al aliado con menos salud"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques de <keyword id=\"burn\">Brûlure</keyword> ont <value id=\"quantity_1\">%1$lld</value>%% de chances de restaurer <value id=\"quantity_2\">%2$lld</value> <keyword id=\"health\">Santé</keyword> à l’allié ayant le moins de Santé"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">炎上</keyword>攻撃が<value id=\"quantity_1\">%1$lld</value>%%の確率で最も体力の低い味方の<keyword id=\"health\">体力</keyword>を<value id=\"quantity_2\">%2$lld</value>回復"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">화상</keyword> 공격 시 <value id=\"quantity_1\">%1$lld</value>%% 확률로 체력이 가장 낮은 아군의 <keyword id=\"health\">체력</keyword> <value id=\"quantity_2\">%2$lld</value> 회복"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques de <keyword id=\"burn\">Queimadura</keyword> têm <value id=\"quantity_1\">%1$lld</value>%% de chance de restaurar <value id=\"quantity_2\">%2$lld</value> de <keyword id=\"health\">Vida</keyword> do aliado com menos vida"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">燃燒</keyword>攻擊有<value id=\"quantity_1\">%1$lld</value>%%機率為生命值最低的友方恢復<value id=\"quantity_2\">%2$lld</value>點<keyword id=\"health\">生命值</keyword>"}}
      }
    },
    "talents.phoenix_health_t1_2.name": {
      "comment": "ContentManifest/talents.tsv: phoenix_health_t1_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Heilende Flammen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Healing Flames"}},
        "es": {"stringUnit": {"state": "translated", "value": "Llamas curativas"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Flammes guérisseuses"}},
        "ja": {"stringUnit": {"state": "translated", "value": "癒やしの炎"}},
        "ko": {"stringUnit": {"state": "translated", "value": "치유의 불꽃"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Chamas Curativas"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "治療火焰"}}
      }
    },
    "talents.phoenix_health_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: phoenix_health_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Überleben der <keyword id=\"deathsdoor\">Todesschwelle</keyword> stellt <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Gesundheit</keyword> beider Verbündeten wieder her"}},
        "en": {"stringUnit": {"state": "translated", "value": "Surviving <keyword id=\"deathsdoor\">Death's Door</keyword> restores <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Health</keyword> to both allies"}},
        "es": {"stringUnit": {"state": "translated", "value": "Sobrevivir a las <keyword id=\"deathsdoor\">Puertas de la Muerte</keyword> restaura <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Salud</keyword> a ambos aliados"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Survivre au <keyword id=\"deathsdoor\">Seuil de la mort</keyword> restaure <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Santé</keyword> aux deux alliés"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">死の淵</keyword>を生き延びると、味方2人の<keyword id=\"health\">体力</keyword>を<value id=\"quantity_1\">%1$lld</value>回復"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">죽음의 문턱</keyword>에서 살아남으면 두 아군의 <keyword id=\"health\">체력</keyword> <value id=\"quantity_1\">%1$lld</value> 회복"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Sobreviver à condição <keyword id=\"deathsdoor\">À Beira da Morte</keyword> restaura <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Vida</keyword> de ambos os aliados"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "從<keyword id=\"deathsdoor\">瀕死之門</keyword>生還時，為兩名友方恢復<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"health\">生命值</keyword>"}}
      }
    },
    "talents.phoenix_health_t2_1.name": {
      "comment": "ContentManifest/talents.tsv: phoenix_health_t2_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Nachglühen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Afterglow"}},
        "es": {"stringUnit": {"state": "translated", "value": "Resplandor residual"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Lueur persistante"}},
        "ja": {"stringUnit": {"state": "translated", "value": "残光"}},
        "ko": {"stringUnit": {"state": "translated", "value": "잔광"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Brilho Residual"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "餘暉"}}
      }
    },
    "talents.phoenix_health_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: phoenix_health_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Bei voller <keyword id=\"health\">Gesundheit</keyword> erhalten beide Verbündeten +<value id=\"quantity_1\">%1$lld</value>%% Chance auf kritische Treffer"}},
        "en": {"stringUnit": {"state": "translated", "value": "At full <keyword id=\"health\">Health</keyword>, both allies gain +<value id=\"quantity_1\">%1$lld</value>%% Critical Hit chance"}},
        "es": {"stringUnit": {"state": "translated", "value": "Con toda la <keyword id=\"health\">Salud</keyword>, ambos aliados obtienen +<value id=\"quantity_1\">%1$lld</value>%% de probabilidad de golpe crítico"}},
        "fr": {"stringUnit": {"state": "translated", "value": "À pleine <keyword id=\"health\">Santé</keyword>, les deux alliés gagnent +<value id=\"quantity_1\">%1$lld</value>%% de chances de coup critique"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>が満タンの間、味方2人のクリティカル率が<value id=\"quantity_1\">%1$lld</value>%%上昇"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword>이 가득 차 있으면 두 아군의 치명타 확률 +<value id=\"quantity_1\">%1$lld</value>%%"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Com <keyword id=\"health\">Vida</keyword> cheia, ambos os aliados ganham +<value id=\"quantity_1\">%1$lld</value>%% de chance de golpe crítico"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "自身<keyword id=\"health\">生命值</keyword>全滿時，兩名友方的暴擊機率提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.phoenix_health_t2_2.name": {
      "comment": "ContentManifest/talents.tsv: phoenix_health_t2_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Strahlende <keyword id=\"health\">Gesundheit</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Radiant <keyword id=\"health\">Health</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">Salud</keyword> radiante"}},
        "fr": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">Santé</keyword> radieuse"}},
        "ja": {"stringUnit": {"state": "translated", "value": "輝く<keyword id=\"health\">体力</keyword>"}},
        "ko": {"stringUnit": {"state": "translated", "value": "빛나는 <keyword id=\"health\">체력</keyword>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">Vida</keyword> Radiante"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "光輝<keyword id=\"health\">生命值</keyword>"}}
      }
    },
    "talents.phoenix_health_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: phoenix_health_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Der erste tödliche Treffer gegen deinen Verbündeten in jedem Kampf belebt ihn mit <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Gesundheit</keyword> wieder"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your ally's first fatal hit each combat revives them with <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Health</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "El primer golpe mortal que recibe tu aliado en cada combate lo revive con <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Salud</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le premier coup fatal reçu par votre allié à chaque combat le ranime avec <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Santé</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "各戦闘で味方が最初の致命打を受けると、<keyword id=\"health\">体力</keyword><value id=\"quantity_1\">%1$lld</value>で蘇生"}},
        "ko": {"stringUnit": {"state": "translated", "value": "매 전투 아군이 처음으로 죽음에 이르는 공격을 받으면 <keyword id=\"health\">체력</keyword> <value id=\"quantity_1\">%1$lld</value> 상태로 부활"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O primeiro golpe fatal que seu aliado receber a cada combate o revive com <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Vida</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每場戰鬥友方首次受到致命一擊時，以<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"health\">生命值</keyword>復活"}}
      }
    },
    "talents.phoenix_health_t3_1.name": {
      "comment": "ContentManifest/talents.tsv: phoenix_health_t3_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Phönixgeschenk"}},
        "en": {"stringUnit": {"state": "translated", "value": "Phoenix Gift"}},
        "es": {"stringUnit": {"state": "translated", "value": "Regalo del fénix"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Don du phénix"}},
        "ja": {"stringUnit": {"state": "translated", "value": "不死鳥の贈り物"}},
        "ko": {"stringUnit": {"state": "translated", "value": "불사조의 선물"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Presente da Fênix"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "鳳凰贈禮"}}
      }
    },
    "talents.phoenix_health_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: phoenix_health_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Überschüssige Wiederherstellung deiner <keyword id=\"health\">Gesundheit</keyword> fügt deinem nächsten <keyword id=\"burn\">Brand</keyword>-Angriff <value id=\"quantity_1\">%1$lld</value> Schaden hinzu"}},
        "en": {"stringUnit": {"state": "translated", "value": "Excess <keyword id=\"health\">Health</keyword> restored to you adds <value id=\"quantity_1\">%1$lld</value> damage to your next <keyword id=\"burn\">Burn</keyword> attack"}},
        "es": {"stringUnit": {"state": "translated", "value": "La <keyword id=\"health\">Salud</keyword> sobrante que se te restaura añade <value id=\"quantity_1\">%1$lld</value> de daño a tu siguiente ataque de <keyword id=\"burn\">Quemadura</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "La <keyword id=\"health\">Santé</keyword> qui vous est restaurée en excès ajoute <value id=\"quantity_1\">%1$lld</value> dégâts à votre prochaine attaque de <keyword id=\"burn\">Brûlure</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "自分の<keyword id=\"health\">体力</keyword>が過剰に回復すると、次の<keyword id=\"burn\">炎上</keyword>攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "자신의 초과 <keyword id=\"health\">체력</keyword> 회복 시 다음 <keyword id=\"burn\">화상</keyword> 공격의 피해 <value id=\"quantity_1\">%1$lld</value> 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "A <keyword id=\"health\">Vida</keyword> restaurada em excesso em você adiciona <value id=\"quantity_1\">%1$lld</value> de dano ao seu próximo ataque de <keyword id=\"burn\">Queimadura</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "自身<keyword id=\"health\">生命值</keyword>受到過量恢復時，下次<keyword id=\"burn\">燃燒</keyword>攻擊的傷害增加<value id=\"quantity_1\">%1$lld</value>點"}}
      }
    },
    "talents.phoenix_health_t3_2.name": {
      "comment": "ContentManifest/talents.tsv: phoenix_health_t3_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Aschevitalität"}},
        "en": {"stringUnit": {"state": "translated", "value": "Ashen Vitality"}},
        "es": {"stringUnit": {"state": "translated", "value": "Vitalidad de ceniza"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Vitalité de cendres"}},
        "ja": {"stringUnit": {"state": "translated", "value": "灰の生命力"}},
        "ko": {"stringUnit": {"state": "translated", "value": "잿빛 생명력"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Vitalidade das Cinzas"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "灰燼活力"}}
      }
    },
    "talents.phoenix_health_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: phoenix_health_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"variations": {"plural": {"one": {"stringUnit": {"state": "translated", "value": "Überschüssige Wiederherstellung von <keyword id=\"health\">Gesundheit</keyword> reinigt <value id=\"quantity_1\">%1$lld</value> Schwächungseffekt"}}, "other": {"stringUnit": {"state": "translated", "value": "Überschüssige Wiederherstellung von <keyword id=\"health\">Gesundheit</keyword> reinigt <value id=\"quantity_1\">%1$lld</value> Schwächungseffekte"}}}}},
        "en": {"variations": {"plural": {"one": {"stringUnit": {"state": "translated", "value": "Excess <keyword id=\"health\">Health</keyword> restoration Cleanses <value id=\"quantity_1\">%1$lld</value> debuff"}}, "other": {"stringUnit": {"state": "translated", "value": "Excess <keyword id=\"health\">Health</keyword> restoration Cleanses <value id=\"quantity_1\">%1$lld</value> debuffs"}}}}},
        "es": {"variations": {"plural": {"many": {"stringUnit": {"state": "translated", "value": "La restauración sobrante de <keyword id=\"health\">Salud</keyword> purifica <value id=\"quantity_1\">%1$lld</value> perjuicios"}}, "one": {"stringUnit": {"state": "translated", "value": "La restauración sobrante de <keyword id=\"health\">Salud</keyword> purifica <value id=\"quantity_1\">%1$lld</value> perjuicio"}}, "other": {"stringUnit": {"state": "translated", "value": "La restauración sobrante de <keyword id=\"health\">Salud</keyword> purifica <value id=\"quantity_1\">%1$lld</value> perjuicios"}}}}},
        "fr": {"variations": {"plural": {"many": {"stringUnit": {"state": "translated", "value": "Les soins de <keyword id=\"health\">Santé</keyword> excédentaires purifient <value id=\"quantity_1\">%1$lld</value> malus"}}, "one": {"stringUnit": {"state": "translated", "value": "Les soins de <keyword id=\"health\">Santé</keyword> excédentaires purifient <value id=\"quantity_1\">%1$lld</value> malus"}}, "other": {"stringUnit": {"state": "translated", "value": "Les soins de <keyword id=\"health\">Santé</keyword> excédentaires purifient <value id=\"quantity_1\">%1$lld</value> malus"}}}}},
        "ja": {"variations": {"plural": {"other": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>の過剰回復で弱体効果を<value id=\"quantity_1\">%1$lld</value>個浄化"}}}}},
        "ko": {"variations": {"plural": {"other": {"stringUnit": {"state": "translated", "value": "초과 <keyword id=\"health\">체력</keyword> 회복 시 약화 효과 <value id=\"quantity_1\">%1$lld</value>개 정화"}}}}},
        "pt-BR": {"variations": {"plural": {"many": {"stringUnit": {"state": "translated", "value": "A restauração excedente de <keyword id=\"health\">Vida</keyword> Purifica <value id=\"quantity_1\">%1$lld</value> efeitos negativos"}}, "one": {"stringUnit": {"state": "translated", "value": "A restauração excedente de <keyword id=\"health\">Vida</keyword> Purifica <value id=\"quantity_1\">%1$lld</value> efeito negativo"}}, "other": {"stringUnit": {"state": "translated", "value": "A restauração excedente de <keyword id=\"health\">Vida</keyword> Purifica <value id=\"quantity_1\">%1$lld</value> efeitos negativos"}}}}},
        "zh-Hant": {"variations": {"plural": {"other": {"stringUnit": {"state": "translated", "value": "過量恢復<keyword id=\"health\">生命值</keyword>時，淨化<value id=\"quantity_1\">%1$lld</value>項減益效果"}}}}}
      }
