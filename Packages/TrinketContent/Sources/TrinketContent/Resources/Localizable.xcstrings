    "talents.shield_scarab_holy_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: shield_scarab_holy_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Geblockter Schaden wird mit <value id=\"quantity_1\">%1$lld</value>%% Chance als <keyword id=\"holy\">heiliger</keyword> Schaden zurückgeworfen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Blocking damage has a <value id=\"quantity_1\">%1$lld</value>%% chance to reflect it as <keyword id=\"holy\">Holy</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Bloquear daño tiene un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de reflejarlo como daño <keyword id=\"holy\">sagrado</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Bloquer des dégâts a <value id=\"quantity_1\">%1$lld</value>%% de chances de les renvoyer en dégâts de type <keyword id=\"holy\">Sacré</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "ダメージをブロックすると<value id=\"quantity_1\">%1$lld</value>%%の確率でそのダメージを<keyword id=\"holy\">聖</keyword>として反射"}},
        "ko": {"stringUnit": {"state": "translated", "value": "피해를 막으면 <value id=\"quantity_1\">%1$lld</value>%% 확률로 그 피해를 <keyword id=\"holy\">신성</keyword> 피해로 반사"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Bloquear dano tem <value id=\"quantity_1\">%1$lld</value>%% de chance de refleti-lo como dano <keyword id=\"holy\">Sagrado</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "格擋傷害時，有<value id=\"quantity_1\">%1$lld</value>%%機率將其反射為<keyword id=\"holy\">神聖</keyword>傷害"}}
      }
    },
    "talents.shield_scarab_holy_t1_2.name": {
      "comment": "ContentManifest/talents.tsv: shield_scarab_holy_t1_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Strahlender Panzer"}},
        "en": {"stringUnit": {"state": "translated", "value": "Radiant Shell"}},
        "es": {"stringUnit": {"state": "translated", "value": "Caparazón radiante"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Carapace radieuse"}},
        "ja": {"stringUnit": {"state": "translated", "value": "光輝の甲羅"}},
        "ko": {"stringUnit": {"state": "translated", "value": "빛나는 껍질"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Casco Radiante"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "光輝甲殼"}}
      }
    },
    "talents.shield_scarab_holy_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: shield_scarab_holy_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dein erster <keyword id=\"holy\">heiliger</keyword> Treffer in jedem Zug gewährt deinem Verbündeten <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your first <keyword id=\"holy\">Holy</keyword> hit each turn grants your ally <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu primer impacto <keyword id=\"holy\">sagrado</keyword> de cada turno otorga a tu aliado <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueo</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre premier coup de type <keyword id=\"holy\">Sacré</keyword> de chaque tour octroie <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Blocage</keyword> à votre allié"}},
        "ja": {"stringUnit": {"state": "translated", "value": "各ターンで最初の<keyword id=\"holy\">聖</keyword>ヒットで味方に<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>付与"}},
        "ko": {"stringUnit": {"state": "translated", "value": "매 턴 첫 <keyword id=\"holy\">신성</keyword> 적중 시 아군에게 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 부여"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seu primeiro acerto <keyword id=\"holy\">Sagrado</keyword> de cada turno concede <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueio</keyword> ao seu aliado"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每回合首次<keyword id=\"holy\">神聖</keyword>命中賦予友方<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>"}}
      }
    },
    "talents.shield_scarab_holy_t2_1.name": {
      "comment": "ContentManifest/talents.tsv: shield_scarab_holy_t2_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Sonnenglyphe"}},
        "en": {"stringUnit": {"state": "translated", "value": "Sun Glyph"}},
        "es": {"stringUnit": {"state": "translated", "value": "Glifo solar"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Glyphe solaire"}},
        "ja": {"stringUnit": {"state": "translated", "value": "太陽の刻印"}},
        "ko": {"stringUnit": {"state": "translated", "value": "태양 문양"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Glifo Solar"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "太陽符印"}}
      }
    },
    "talents.shield_scarab_holy_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: shield_scarab_holy_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">Heilige</keyword> Angriffe beider Verbündeten erhalten +<value id=\"quantity_1\">%1$lld</value>%% Chance auf kritische Treffer"}},
        "en": {"stringUnit": {"state": "translated", "value": "Both allies' <keyword id=\"holy\">Holy</keyword> attacks gain +<value id=\"quantity_1\">%1$lld</value>%% Critical Hit chance"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques <keyword id=\"holy\">sagrados</keyword> de ambos aliados obtienen +<value id=\"quantity_1\">%1$lld</value>%% de probabilidad de golpe crítico"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques de type <keyword id=\"holy\">Sacré</keyword> des deux alliés gagnent +<value id=\"quantity_1\">%1$lld</value>%% de chances de coup critique"}},
        "ja": {"stringUnit": {"state": "translated", "value": "味方2人の<keyword id=\"holy\">聖</keyword>攻撃のクリティカル率が<value id=\"quantity_1\">%1$lld</value>%%上昇"}},
        "ko": {"stringUnit": {"state": "translated", "value": "두 아군의 <keyword id=\"holy\">신성</keyword> 공격 치명타 확률 +<value id=\"quantity_1\">%1$lld</value>%%"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques <keyword id=\"holy\">Sagrados</keyword> de ambos os aliados ganham +<value id=\"quantity_1\">%1$lld</value>%% de chance de golpe crítico"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "兩名友方的<keyword id=\"holy\">神聖</keyword>攻擊暴擊機率提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.shield_scarab_holy_t2_2.name": {
      "comment": "ContentManifest/talents.tsv: shield_scarab_holy_t2_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Sonnenschutz"}},
        "en": {"stringUnit": {"state": "translated", "value": "Solar Ward"}},
        "es": {"stringUnit": {"state": "translated", "value": "Protección solar"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Protection solaire"}},
        "ja": {"stringUnit": {"state": "translated", "value": "太陽の守り"}},
        "ko": {"stringUnit": {"state": "translated", "value": "태양의 수호"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Proteção Solar"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "太陽守護"}}
      }
    },
    "talents.shield_scarab_holy_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: shield_scarab_holy_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Kritische <keyword id=\"holy\">heilige</keyword> Treffer verringern die Treffergenauigkeit des nächsten gegnerischen Angriffs um <value id=\"quantity_1\">%1$lld</value>%%"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">Holy</keyword> Critical Hits reduce the enemy's next attack accuracy by <value id=\"quantity_1\">%1$lld</value>%%"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los golpes críticos <keyword id=\"holy\">sagrados</keyword> reducen la precisión del siguiente ataque del enemigo en un <value id=\"quantity_1\">%1$lld</value>%%"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les coups critiques de type <keyword id=\"holy\">Sacré</keyword> réduisent de <value id=\"quantity_1\">%1$lld</value>%% la précision de la prochaine attaque ennemie"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">聖</keyword>クリティカルヒットで敵の次の攻撃の命中率が<value id=\"quantity_1\">%1$lld</value>%%低下"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">신성</keyword> 치명타가 적의 다음 공격 명중률 <value id=\"quantity_1\">%1$lld</value>%% 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Golpes críticos <keyword id=\"holy\">Sagrados</keyword> reduzem a precisão do próximo ataque inimigo em <value id=\"quantity_1\">%1$lld</value>%%"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">神聖</keyword>暴擊使敵人下次攻擊的命中率降低<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.shield_scarab_holy_t3_1.name": {
      "comment": "ContentManifest/talents.tsv: shield_scarab_holy_t3_1, name",
