        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"poison\">Poisoned</keyword> enemies take <value id=\"quantity_1\">%1$lld</value>%% more <keyword id=\"stun\">Stun</keyword> build-up"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les ennemis sous <keyword id=\"poison\">Poison</keyword> subissent <value id=\"quantity_1\">%1$lld</value>%% d’accumulation d’<keyword id=\"stun\">Étourdissement</keyword> en plus"
