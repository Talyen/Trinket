    "authored.33ae3045806f0c59": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Abilities/AbilityCatalog+Ultimate.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wirf einen <value id=\"quantity_1\">%1$lld</value>-seitigen Würfel\nErhalte entsprechend viel <keyword id=\"block\">Block</keyword>, <keyword id=\"thorns\">Dornen</keyword> oder <keyword id=\"health\">Gesundheit</keyword>\nBei voller <keyword id=\"health\">Gesundheit</keyword> der Gruppe: Würfle für <keyword id=\"block\">Block</keyword> oder <keyword id=\"thorns\">Dornen</keyword>\nZiehe <value id=\"quantity_2\">%2$lld</value> Karte"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roll a <value id=\"quantity_1\">%1$lld</value>-sided die\nGain that much <keyword id=\"block\">Block</keyword>, <keyword id=\"thorns\">Thorns</keyword>, or <keyword id=\"health\">Health</keyword>\nAt full party <keyword id=\"health\">Health</keyword>, roll <keyword id=\"block\">Block</keyword> or <keyword id=\"thorns\">Thorns</keyword>\nDraw <value id=\"quantity_2\">%2$lld</value> card"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancez un dé à <value id=\"quantity_1\">%1$lld</value> faces\nGagnez autant de <keyword id=\"block\">Blocage</keyword>, d’<keyword id=\"thorns\">Épines</keyword> ou de <keyword id=\"health\">Santé</keyword>\nSi le groupe est à pleine <keyword id=\"health\">Santé</keyword>, le résultat donne du <keyword id=\"block\">Blocage</keyword> ou des <keyword id=\"thorns\">Épines</keyword>\nPiochez <value id=\"quantity_2\">%2$lld</value> carte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<value id=\"quantity_1\">%1$lld</value>面ダイスを振る\n出目と同量の<keyword id=\"block\">ブロック</keyword>、<keyword id=\"thorns\">棘</keyword>、<keyword id=\"health\">体力</keyword>のいずれかを獲得\nパーティー全員の<keyword id=\"health\">体力</keyword>が満タンなら<keyword id=\"block\">ブロック</keyword>か<keyword id=\"thorns\">棘</keyword>を獲得\nカードを<value id=\"quantity_2\">%2$lld</value>枚引く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<value id=\"quantity_1\">%1$lld</value>면 주사위 굴리기\n나온 수만큼 <keyword id=\"block\">방어도</keyword>, <keyword id=\"thorns\">가시</keyword> 또는 <keyword id=\"health\">체력</keyword> 획득\n파티 전체의 <keyword id=\"health\">체력</keyword>이 가득 차 있으면 <keyword id=\"block\">방어도</keyword> 또는 <keyword id=\"thorns\">가시</keyword>만 나옴\n카드 <value id=\"quantity_2\">%2$lld</value>장 뽑기"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擲一顆<value id=\"quantity_1\">%1$lld</value>面骰\n獲得等同點數的<keyword id=\"block\">格擋</keyword>、<keyword id=\"thorns\">荊棘</keyword>或<keyword id=\"health\">生命值</keyword>\n隊伍<keyword id=\"health\">生命值</keyword>全滿時，只擲出<keyword id=\"block\">格擋</keyword>或<keyword id=\"thorns\">荊棘</keyword>\n抽<value id=\"quantity_2\">%2$lld</value>張牌"
          }
        }
      }
    },
    "authored.340d09c98a84db17": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Encounters/Mystery/MysteryEventPool+Events.swift: narrative",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Opferschale birgt „%1$@“, während darunter rostige Ketten „%2$@“ binden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An offering bowl holds “%1$@” while rusted chains bind “%2$@” below"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bol d’offrandes contient « %1$@ », tandis que des chaînes rouillées retiennent « %2$@ » en contrebas"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "供物鉢には「%1$@」が収まり、その下では錆びた鎖が「%2$@」を縛っている"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제물 그릇에 담긴 것은 ‘%1$@’, 그 아래 녹슨 사슬에 묶인 것은 ‘%2$@’입니다"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "供碗盛著「%1$@」，下方生鏽的鎖鏈束縛著「%2$@」"
          }
        }
      }
    },
