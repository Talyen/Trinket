    "affixes.lucky_clover.astral_description": {
      "comment": "ContentManifest/affixes.tsv: lucky_clover, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erhalte <value id=\"quantity_1\">%1$lld</value>%% Chance auf kritische Treffer\nErhalte bei einem kritischen Treffer <value id=\"quantity_2\">%2$lld</value> <keyword id=\"gold\">Gold</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Gain <value id=\"quantity_1\">%1$lld</value>%% Critical chance\nGain <value id=\"quantity_2\">%2$lld</value> <keyword id=\"gold\">Gold</keyword> on Critical Hit"}},
        "es": {"stringUnit": {"state": "translated", "value": "Obtén un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de crítico\nObtén <value id=\"quantity_2\">%2$lld</value> de <keyword id=\"gold\">Oro</keyword> al asestar un golpe crítico"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Gagnez <value id=\"quantity_1\">%1$lld</value>%% de chances de coup critique\nGagnez <value id=\"quantity_2\">%2$lld</value> <keyword id=\"gold\">Or</keyword> par coup critique"}},
        "ja": {"stringUnit": {"state": "translated", "value": "クリティカル率が<value id=\"quantity_1\">%1$lld</value>%%上昇\nクリティカルヒット時に<keyword id=\"gold\">ゴールド</keyword>を<value id=\"quantity_2\">%2$lld</value>獲得"}},
        "ko": {"stringUnit": {"state": "translated", "value": "치명타 확률 <value id=\"quantity_1\">%1$lld</value>%% 증가\n치명타 적중 시 <keyword id=\"gold\">골드</keyword> <value id=\"quantity_2\">%2$lld</value> 획득"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ganhe <value id=\"quantity_1\">%1$lld</value>%% de chance de crítico\nGanhe <value id=\"quantity_2\">%2$lld</value> de <keyword id=\"gold\">Ouro</keyword> ao acertar um golpe crítico"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "暴擊機率提高<value id=\"quantity_1\">%1$lld</value>%%\n暴擊命中時獲得<value id=\"quantity_2\">%2$lld</value><keyword id=\"gold\">金幣</keyword>"}}
      }
    },
