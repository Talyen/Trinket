    "authored.ab6b9b827fb7dab4": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/InventoryItem+Compatibility.swift: canonical numeric compatibility description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Unter halber <keyword id=\"health\">Gesundheit</keyword> stellt <keyword id=\"leech\">Lebensraub</keyword> gegen <keyword id=\"stun\">betäubte</keyword> Gegner <value id=\"quantity_1\">%1$lld</value> zusätzliche <keyword id=\"health\">Gesundheit</keyword> wieder her"}},
        "en": {"stringUnit": {"state": "translated", "value": "Below half <keyword id=\"health\">Health</keyword>, <keyword id=\"leech\">Leech</keyword> restores <value id=\"quantity_1\">%1$lld</value> additional <keyword id=\"health\">Health</keyword> against <keyword id=\"stun\">Stunned</keyword> enemies"}},
        "es": {"stringUnit": {"state": "translated", "value": "Por debajo de la mitad de <keyword id=\"health\">Salud</keyword>, <keyword id=\"leech\">Absorción</keyword> restaura <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Salud</keyword> adicional contra enemigos <keyword id=\"stun\">aturdidos</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Sous la moitié de votre <keyword id=\"health\">Santé</keyword> maximale, le <keyword id=\"leech\">Vol de vie</keyword> rend <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Santé</keyword> de plus contre les ennemis <keyword id=\"stun\">étourdis</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>が最大値の半分未満のとき、<keyword id=\"stun\">スタン</keyword>状態の敵への<keyword id=\"leech\">吸収</keyword>による<keyword id=\"health\">体力</keyword>回復量が<value id=\"quantity_1\">%1$lld</value>増加する"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword>이 최대치의 절반 미만일 때, <keyword id=\"stun\">기절</keyword>한 적에 대한 <keyword id=\"leech\">흡혈</keyword>이 <keyword id=\"health\">체력</keyword>을 <value id=\"quantity_1\">%1$lld</value> 추가로 회복합니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Abaixo de metade da <keyword id=\"health\">Vida</keyword>, <keyword id=\"leech\">Drenagem</keyword> restaura <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Vida</keyword> adicional contra inimigos <keyword id=\"stun\">Atordoados</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">生命值</keyword>低於上限的一半時，對<keyword id=\"stun\">暈眩</keyword>敵人的<keyword id=\"leech\">吸血</keyword>額外恢復<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"health\">生命值</keyword>"}}
      }
    },
