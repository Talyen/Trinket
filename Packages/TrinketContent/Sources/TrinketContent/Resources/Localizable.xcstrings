    "talents.knight_stun_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: knight_stun_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"stun\">Betäubte</keyword> Gegner verursachen halben Schaden, wenn sie sich erholen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"stun\">Stunned</keyword> enemies deal half damage when they recover"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les ennemis sous <keyword id=\"stun\">Étourdissement</keyword> infligent la moitié des dégâts lorsqu’ils récupèrent"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"stun\">スタン</keyword>状態から回復した敵の与えるダメージが半減"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"stun\">기절</keyword> 상태의 적이 회복한 뒤 주는 피해가 절반으로 감소"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"stun\">暈眩</keyword>的敵人恢復後，造成的傷害減半"
          }
        }
      }
    },
