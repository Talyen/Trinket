    "affixes.symbiosis.astral_description": {
      "comment": "ContentManifest/affixes.tsv: symbiosis, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dein Verbündeter erhält <value id=\"quantity_1\">%1$lld</value>%% der <keyword id=\"health\">Gesundheit</keyword>, die du mit <keyword id=\"leech\">Lebensraub</keyword> wiederherstellst"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your ally receives <value id=\"quantity_1\">%1$lld</value>%% of the <keyword id=\"health\">Health</keyword> you restore with <keyword id=\"leech\">Leech</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu aliado recibe un <value id=\"quantity_1\">%1$lld</value>%% de la <keyword id=\"health\">Salud</keyword> que restauras con <keyword id=\"leech\">Absorción</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre allié reçoit <value id=\"quantity_1\">%1$lld</value>%% de la <keyword id=\"health\">Santé</keyword> que vous restaurez avec <keyword id=\"leech\">Vol de vie</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">吸収</keyword>で回復した<keyword id=\"health\">体力</keyword>の<value id=\"quantity_1\">%1$lld</value>%%を味方も回復"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">흡혈</keyword>로 회복한 <keyword id=\"health\">체력</keyword>의 <value id=\"quantity_1\">%1$lld</value>%%만큼 아군도 회복"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seu aliado recebe <value id=\"quantity_1\">%1$lld</value>%% da <keyword id=\"health\">Vida</keyword> que você restaura com <keyword id=\"leech\">Drenagem</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "你的友方恢復相當於你透過<keyword id=\"leech\">吸血</keyword>恢復的<keyword id=\"health\">生命值</keyword>的<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
