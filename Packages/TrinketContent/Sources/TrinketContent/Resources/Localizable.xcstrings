    "talents.alchemist_health_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: alchemist_health_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Wiederherstellen von <keyword id=\"health\">Gesundheit</keyword> lässt dich mit <value id=\"quantity_1\">%1$lld</value>%% Chance eine Karte ziehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restoring <keyword id=\"health\">Health</keyword> has a <value id=\"quantity_1\">%1$lld</value>%% chance to draw a card"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurer de la <keyword id=\"health\">Santé</keyword> a <value id=\"quantity_1\">%1$lld</value>%% de chances de faire piocher une carte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">体力</keyword>を回復すると<value id=\"quantity_1\">%1$lld</value>%%の確率でカードを1枚引く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">체력</keyword> 회복 시 <value id=\"quantity_1\">%1$lld</value>%% 확률로 카드 한 장 뽑기"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復<keyword id=\"health\">生命值</keyword>時，有<value id=\"quantity_1\">%1$lld</value>%%機率抽一張牌"
          }
        }
      }
    },
