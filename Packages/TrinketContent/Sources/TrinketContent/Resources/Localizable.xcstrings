        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"gold\">ゴールド</keyword>を盗むと、次の自分のターンまで<keyword id=\"dodge\">回避</keyword>率が<value id=\"quantity_1\">%1$lld</value>%%上昇"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"gold\">골드</keyword>를 훔치면 다음 내 턴까지 <keyword id=\"dodge\">회피</keyword> +<value id=\"quantity_1\">%1$lld</value>%%"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偷取<keyword id=\"gold\">金幣</keyword>時，<keyword id=\"dodge\">閃避</keyword>機率提高<value id=\"quantity_1\">%1$lld</value>%%，直到下個自身回合"
          }
        }
      }
    },
