    "talents.wizard_mana_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: wizard_mana_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ausgeben deines letzten <keyword id=\"mana\">Mana</keyword> lässt dich eine Karte ziehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spending your last <keyword id=\"mana\">Mana</keyword> draws a card"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dépenser votre dernier <keyword id=\"mana\">Mana</keyword> fait piocher une carte"
