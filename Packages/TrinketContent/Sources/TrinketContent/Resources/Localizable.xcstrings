    "traits.searing_body.description": {
      "comment": "ContentManifest/traits.tsv: searing_body, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du getroffen wirst, belege den Angreifer mit <value id=\"quantity_1\">%1$lld</value> <keyword id=\"burn\">Brand</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply <value id=\"quantity_1\">%1$lld</value> <keyword id=\"burn\">Burn</keyword> to attackers when hit"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Applique <value id=\"quantity_1\">%1$lld</value> <keyword id=\"burn\">Brûlure</keyword> aux attaquants lorsque vous êtes touché"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "攻撃を受けると攻撃者に<keyword id=\"burn\">炎上</keyword>を<value id=\"quantity_1\">%1$lld</value>付与"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공격에 맞으면 공격자에게 <keyword id=\"burn\">화상</keyword> <value id=\"quantity_1\">%1$lld</value> 부여"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "被命中時，對攻擊者施加<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"burn\">燃燒</keyword>"
          }
        }
      }
    },
