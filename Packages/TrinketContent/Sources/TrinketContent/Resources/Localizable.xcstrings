    "talents.mana_moth_burn_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: mana_moth_burn_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">Block</keyword> absorbiert gegen <keyword id=\"burn\">brennende</keyword> Gegner <value id=\"quantity_1\">%1$lld</value>%% mehr Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">Block</keyword> absorbs <value id=\"quantity_1\">%1$lld</value>%% more damage against <keyword id=\"burn\">Burning</keyword> enemies"}},
        "es": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">Bloqueo</keyword> absorbe un <value id=\"quantity_1\">%1$lld</value>%% más de daño contra enemigos con <keyword id=\"burn\">Quemadura</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le <keyword id=\"block\">Blocage</keyword> absorbe <value id=\"quantity_1\">%1$lld</value>%% de dégâts en plus contre les ennemis sous <keyword id=\"burn\">Brûlure</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">炎上</keyword>状態の敵に対し、<keyword id=\"block\">ブロック</keyword>のダメージ吸収量が<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">화상</keyword> 상태의 적을 상대로 <keyword id=\"block\">방어도</keyword>의 피해 흡수량 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">Bloqueio</keyword> absorve <value id=\"quantity_1\">%1$lld</value>%% mais dano contra inimigos <keyword id=\"burn\">Em Chamas</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "面對<keyword id=\"burn\">燃燒</keyword>中的敵人，<keyword id=\"block\">格擋</keyword>吸收的傷害增加<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
