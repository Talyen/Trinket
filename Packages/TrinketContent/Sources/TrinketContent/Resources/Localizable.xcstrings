    "authored.08f41d507a8f1751": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Encounters/Mystery/MysteryEventPool+Events.swift: narrative",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Unter der Quelle umschließen Kristalle „%1$@“, während heilende Wellen „%2$@“ enthüllen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Beneath the spring, crystal traps “%1$@” while healing ripples reveal “%2$@”"}},
        "es": {"stringUnit": {"state": "translated", "value": "Bajo el manantial, el cristal atrapa «%1$@» mientras las ondas curativas revelan «%2$@»"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Sous la source, le cristal emprisonne « %1$@ », tandis que des ondulations curatives révèlent « %2$@ »"}},
        "ja": {"stringUnit": {"state": "translated", "value": "泉の底では水晶が「%1$@」を閉じ込め、癒やしの波紋が「%2$@」を浮かび上がらせる"}},
        "ko": {"stringUnit": {"state": "translated", "value": "샘 아래 수정에 갇힌 것은 ‘%1$@’, 치유의 물결이 드러낸 것은 ‘%2$@’입니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Sob a nascente, cristais aprisionam “%1$@” enquanto ondulações curativas revelam “%2$@”"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "泉水之下，水晶困住了「%1$@」，療癒的漣漪則顯露出「%2$@」"}}
      }
    },
