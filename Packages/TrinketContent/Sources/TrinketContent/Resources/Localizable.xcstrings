    "talents.alchemist_poison_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: alchemist_poison_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Kritische <keyword id=\"poison\">Gift</keyword>-Treffer verursachen <value id=\"quantity_1\">%1$lld</value> zusätzlichen Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Poison</keyword> Critical Hits deal <value id=\"quantity_1\">%1$lld</value> additional damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los golpes críticos de <keyword id=\"poison\">Veneno</keyword> infligen <value id=\"quantity_1\">%1$lld</value> de daño adicional"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les coups critiques de <keyword id=\"poison\">Poison</keyword> infligent <value id=\"quantity_1\">%1$lld</value> dégâts supplémentaires"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">毒</keyword>クリティカルヒットのダメージが<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">독</keyword> 치명타의 추가 피해 <value id=\"quantity_1\">%1$lld</value>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Golpes críticos de <keyword id=\"poison\">Veneno</keyword> causam <value id=\"quantity_1\">%1$lld</value> de dano adicional"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">中毒</keyword>暴擊額外造成<value id=\"quantity_1\">%1$lld</value>點傷害"}}
      }
    },
    "talents.alchemist_poison_t1_1.name": {
      "comment": "ContentManifest/talents.tsv: alchemist_poison_t1_1, name",
      "extractionState": "manual",
      "localizations": {
