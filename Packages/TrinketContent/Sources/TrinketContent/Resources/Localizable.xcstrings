      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Rauchgasexplosion"}},
        "en": {"stringUnit": {"state": "translated", "value": "Backdraft"}},
        "es": {"stringUnit": {"state": "translated", "value": "Explosión de retorno"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Retour de flamme"}},
        "ja": {"stringUnit": {"state": "translated", "value": "逆火"}},
        "ko": {"stringUnit": {"state": "translated", "value": "역화"}},
