    "talents.risen_skeleton_deathsdoor_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_deathsdoor_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Überleben der <keyword id=\"deathsdoor\">Todesschwelle</keyword> gewährt beiden Verbündeten <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Surviving <keyword id=\"deathsdoor\">Death's Door</keyword> grants both allies <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Survivre au <keyword id=\"deathsdoor\">Seuil de la mort</keyword> octroie <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Blocage</keyword> aux deux alliés"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"deathsdoor\">死の淵</keyword>を生き延びると味方2人に<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>付与"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"deathsdoor\">죽음의 문턱</keyword>에서 살아남으면 두 아군에게 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 부여"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從<keyword id=\"deathsdoor\">瀕死之門</keyword>生還時，賦予兩名友方<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>"
          }
        }
      }
    },
