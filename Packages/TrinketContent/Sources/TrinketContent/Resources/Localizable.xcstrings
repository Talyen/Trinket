    "talents.library_owl_holy_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: library_owl_holy_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">Heilige</keyword> Angriffe verringern die Treffergenauigkeit des nächsten gegnerischen Angriffs um <value id=\"quantity_1\">%1$lld</value>%%"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">Holy</keyword> attacks reduce the enemy's next attack accuracy by <value id=\"quantity_1\">%1$lld</value>%%"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques <keyword id=\"holy\">sagrados</keyword> reducen la precisión del siguiente ataque del enemigo en un <value id=\"quantity_1\">%1$lld</value>%%"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques de type <keyword id=\"holy\">Sacré</keyword> réduisent de <value id=\"quantity_1\">%1$lld</value>%% la précision de la prochaine attaque ennemie"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">聖</keyword>攻撃で敵の次の攻撃の命中率が<value id=\"quantity_1\">%1$lld</value>%%低下"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">신성</keyword> 공격이 적의 다음 공격 명중률 <value id=\"quantity_1\">%1$lld</value>%% 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques <keyword id=\"holy\">Sagrados</keyword> reduzem a precisão do próximo ataque inimigo em <value id=\"quantity_1\">%1$lld</value>%%"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">神聖</keyword>攻擊使敵人下次攻擊的命中率降低<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
