    "talents.bear_block_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: bear_block_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angriffe, die deinen <keyword id=\"block\">Block</keyword> durchbrechen, verursachen nur die Hälfte ihres verbleibenden Schadens"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attacks that break your <keyword id=\"block\">Block</keyword> deal half their remaining damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les attaques qui brisent votre <keyword id=\"block\">Blocage</keyword> infligent la moitié de leurs dégâts restants"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の<keyword id=\"block\">ブロック</keyword>を崩した攻撃の残りのダメージが半減"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 <keyword id=\"block\">방어도</keyword>를 깨뜨리는 공격의 남은 피해가 절반으로 감소"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擊破自身<keyword id=\"block\">格擋</keyword>的攻擊，其剩餘傷害減半"
          }
        }
      }
    },
