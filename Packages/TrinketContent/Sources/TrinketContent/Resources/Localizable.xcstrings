    "talents.wolf_bleed_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: wolf_bleed_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dein erster <keyword id=\"bleed\">Blutungs</keyword>-Angriff in jedem Zug erhält <keyword id=\"leech\">Lebensraub</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your first <keyword id=\"bleed\">Bleed</keyword> attack each turn gains <keyword id=\"leech\">Leech</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu primer ataque de <keyword id=\"bleed\">Sangrado</keyword> de cada turno obtiene <keyword id=\"leech\">Absorción</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre première attaque de <keyword id=\"bleed\">Saignement</keyword> de chaque tour bénéficie de <keyword id=\"leech\">Vol de vie</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "各ターンで最初の<keyword id=\"bleed\">出血</keyword>攻撃に<keyword id=\"leech\">吸収</keyword>を付与"}},
        "ko": {"stringUnit": {"state": "translated", "value": "매 턴 첫 <keyword id=\"bleed\">출혈</keyword> 공격에 <keyword id=\"leech\">흡혈</keyword> 부여"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seu primeiro ataque de <keyword id=\"bleed\">Sangramento</keyword> de cada turno ganha <keyword id=\"leech\">Drenagem</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每回合首次<keyword id=\"bleed\">流血</keyword>攻擊獲得<keyword id=\"leech\">吸血</keyword>"}}
      }
