    "talents.rogue_gold_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: rogue_gold_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">Physische</keyword> Angriffe verursachen <value id=\"quantity_1\">%1$lld</value> zusätzlichen Schaden. Das Stehlen von <keyword id=\"gold\">Gold</keyword> fügt deinem nächsten <keyword id=\"physical\">physischen</keyword> Angriff <value id=\"quantity_2\">%2$lld</value> Schaden hinzu"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">Physical</keyword> attacks deal <value id=\"quantity_1\">%1$lld</value> extra damage. Stealing <keyword id=\"gold\">Gold</keyword> adds <value id=\"quantity_2\">%2$lld</value> damage to your next <keyword id=\"physical\">Physical</keyword> attack"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques <keyword id=\"physical\">físicos</keyword> infligen <value id=\"quantity_1\">%1$lld</value> de daño adicional. Robar <keyword id=\"gold\">Oro</keyword> añade <value id=\"quantity_2\">%2$lld</value> de daño a tu siguiente ataque <keyword id=\"physical\">físico</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques de type <keyword id=\"physical\">Physique</keyword> infligent <value id=\"quantity_1\">%1$lld</value> dégâts supplémentaires. Voler de l’<keyword id=\"gold\">Or</keyword> ajoute <value id=\"quantity_2\">%2$lld</value> dégâts à votre prochaine attaque de type <keyword id=\"physical\">Physique</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">物理</keyword>攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>増加。<keyword id=\"gold\">ゴールド</keyword>を盗むと、次の<keyword id=\"physical\">物理</keyword>攻撃のダメージが<value id=\"quantity_2\">%2$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">물리</keyword> 공격의 피해가 <value id=\"quantity_1\">%1$lld</value> 증가합니다. <keyword id=\"gold\">골드</keyword>를 훔치면 다음 <keyword id=\"physical\">물리</keyword> 공격의 피해가 <value id=\"quantity_2\">%2$lld</value> 증가합니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques <keyword id=\"physical\">Físicos</keyword> causam <value id=\"quantity_1\">%1$lld</value> de dano adicional. Roubar <keyword id=\"gold\">Ouro</keyword> adiciona <value id=\"quantity_2\">%2$lld</value> de dano ao seu próximo ataque <keyword id=\"physical\">Físico</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">物理</keyword>攻擊額外造成<value id=\"quantity_1\">%1$lld</value>點傷害。偷取<keyword id=\"gold\">金幣</keyword>後，下次<keyword id=\"physical\">物理</keyword>攻擊的傷害增加<value id=\"quantity_2\">%2$lld</value>點"}}
      }
    },
    "talents.rogue_gold_t4_1.name": {
      "comment": "ContentManifest/talents.tsv: rogue_gold_t4_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Kopfgeldklinge"}},
        "en": {"stringUnit": {"state": "translated", "value": "Bounty Blade"}},
        "es": {"stringUnit": {"state": "translated", "value": "Hoja de recompensa"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Lame à prime"}},
        "ja": {"stringUnit": {"state": "translated", "value": "賞金の刃"}},
        "ko": {"stringUnit": {"state": "translated", "value": "현상금 칼날"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Lâmina da Recompensa"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "賞金之刃"}}
      }
    },
    "talents.rogue_poison_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: rogue_poison_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">Blutende</keyword> Gegner erleiden <value id=\"quantity_1\">%1$lld</value>%% mehr <keyword id=\"poison\">Gift</keyword>schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">Bleeding</keyword> enemies take <value id=\"quantity_1\">%1$lld</value>%% increased <keyword id=\"poison\">Poison</keyword> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los enemigos con <keyword id=\"bleed\">Sangrado</keyword> reciben un <value id=\"quantity_1\">%1$lld</value>%% más de daño de <keyword id=\"poison\">Veneno</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les ennemis sous <keyword id=\"bleed\">Saignement</keyword> subissent <value id=\"quantity_1\">%1$lld</value>%% de dégâts de <keyword id=\"poison\">Poison</keyword> en plus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">出血</keyword>状態の敵が受ける<keyword id=\"poison\">毒</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">출혈</keyword> 상태의 적이 받는 <keyword id=\"poison\">독</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Inimigos com <keyword id=\"bleed\">Sangramento</keyword> recebem <value id=\"quantity_1\">%1$lld</value>%% mais dano de <keyword id=\"poison\">Veneno</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">流血</keyword>的敵人承受的<keyword id=\"poison\">中毒</keyword>傷害增加<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.rogue_poison_t1_1.name": {
      "comment": "ContentManifest/talents.tsv: rogue_poison_t1_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Giftbeschichtung"}},
        "en": {"stringUnit": {"state": "translated", "value": "Toxic Coating"}},
        "es": {"stringUnit": {"state": "translated", "value": "Capa tóxica"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Revêtement toxique"}},
        "ja": {"stringUnit": {"state": "translated", "value": "毒の塗布"}},
        "ko": {"stringUnit": {"state": "translated", "value": "맹독 코팅"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Revestimento Tóxico"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "劇毒塗層"}}
      }
    },
    "talents.rogue_poison_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: rogue_poison_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Gift</keyword> auf Gegnern nimmt <value id=\"quantity_1\">%1$lld</value>%% langsamer ab"}},
        "en": {"stringUnit": {"state": "translated", "value": "Enemy <keyword id=\"poison\">Poison</keyword> fades <value id=\"quantity_1\">%1$lld</value>%% slower"}},
        "es": {"stringUnit": {"state": "translated", "value": "El <keyword id=\"poison\">Veneno</keyword> que afecta al enemigo disminuye un <value id=\"quantity_1\">%1$lld</value>%% más despacio"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le <keyword id=\"poison\">Poison</keyword> affectant l’ennemi diminue <value id=\"quantity_1\">%1$lld</value>%% plus lentement"}},
        "ja": {"stringUnit": {"state": "translated", "value": "敵にかかった<keyword id=\"poison\">毒</keyword>の減衰が<value id=\"quantity_1\">%1$lld</value>%%遅くなる"}},
        "ko": {"stringUnit": {"state": "translated", "value": "적에게 걸린 <keyword id=\"poison\">독</keyword>의 감소 속도 <value id=\"quantity_1\">%1$lld</value>%% 저하"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O <keyword id=\"poison\">Veneno</keyword> no inimigo diminui <value id=\"quantity_1\">%1$lld</value>%% mais devagar"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "敵人身上的<keyword id=\"poison\">中毒</keyword>衰減速度降低<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.rogue_poison_t1_2.name": {
      "comment": "ContentManifest/talents.tsv: rogue_poison_t1_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Nachwirkendes Toxin"}},
        "en": {"stringUnit": {"state": "translated", "value": "Lingering Toxin"}},
        "es": {"stringUnit": {"state": "translated", "value": "Toxina persistente"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Toxine persistante"}},
        "ja": {"stringUnit": {"state": "translated", "value": "残留毒"}},
        "ko": {"stringUnit": {"state": "translated", "value": "남아 있는 독소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Toxina Persistente"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "持續毒素"}}
      }
    },
    "talents.rogue_poison_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: rogue_poison_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Kritische <keyword id=\"poison\">Gift</keyword>-Treffer lassen deinen nächsten <keyword id=\"bleed\">Blutungs</keyword>-Angriff kritisch treffen"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Poison</keyword> Critical Hits make your next <keyword id=\"bleed\">Bleed</keyword> attack Critically Hit"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los golpes críticos de <keyword id=\"poison\">Veneno</keyword> hacen que tu siguiente ataque de <keyword id=\"bleed\">Sangrado</keyword> aseste un golpe crítico"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les coups critiques de <keyword id=\"poison\">Poison</keyword> garantissent un coup critique à votre prochaine attaque de <keyword id=\"bleed\">Saignement</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">毒</keyword>クリティカルヒットで、次の<keyword id=\"bleed\">出血</keyword>攻撃が必ずクリティカルヒット"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">독</keyword> 치명타가 다음 <keyword id=\"bleed\">출혈</keyword> 공격을 반드시 치명타로 만듦"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Golpes críticos de <keyword id=\"poison\">Veneno</keyword> fazem seu próximo ataque de <keyword id=\"bleed\">Sangramento</keyword> acertar um golpe crítico"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">中毒</keyword>暴擊使下次<keyword id=\"bleed\">流血</keyword>攻擊必定暴擊"}}
      }
    },
    "talents.rogue_poison_t2_1.name": {
      "comment": "ContentManifest/talents.tsv: rogue_poison_t2_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Giftige Reaktion"}},
        "en": {"stringUnit": {"state": "translated", "value": "Noxious Reaction"}},
        "es": {"stringUnit": {"state": "translated", "value": "Reacción nociva"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Réaction nocive"}},
        "ja": {"stringUnit": {"state": "translated", "value": "有毒反応"}},
        "ko": {"stringUnit": {"state": "translated", "value": "유독 반응"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Reação Nociva"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "有毒反應"}}
