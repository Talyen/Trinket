    "talents.wildcard_gold_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: wildcard_gold_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kritische Treffer, die <keyword id=\"gold\">Gold</keyword> stehlen, gewähren <value id=\"quantity_1\">%1$lld</value> zusätzliches <keyword id=\"gold\">Gold</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Critical Hits that steal <keyword id=\"gold\">Gold</keyword> grant <value id=\"quantity_1\">%1$lld</value> additional <keyword id=\"gold\">Gold</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les coups critiques qui volent de l’<keyword id=\"gold\">Or</keyword> octroient <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Or</keyword> supplémentaires"
          }
