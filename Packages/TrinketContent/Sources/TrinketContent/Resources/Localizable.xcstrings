    "talents.druid_health_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: druid_health_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verbündete mit <keyword id=\"thorns\">Dornen</keyword> stellen <value id=\"quantity_1\">%1$lld</value> zusätzliche <keyword id=\"health\">Gesundheit</keyword> wieder her"}},
        "en": {"stringUnit": {"state": "translated", "value": "Allies with <keyword id=\"thorns\">Thorns</keyword> restore <value id=\"quantity_1\">%1$lld</value> additional <keyword id=\"health\">Health</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los aliados con <keyword id=\"thorns\">Espinas</keyword> restauran <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Salud</keyword> adicional"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les alliés ayant des <keyword id=\"thorns\">Épines</keyword> restaurent <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Santé</keyword> de plus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"thorns\">棘</keyword>を持つ味方の<keyword id=\"health\">体力</keyword>回復量が<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"thorns\">가시</keyword>가 있는 아군의 <keyword id=\"health\">체력</keyword> <value id=\"quantity_1\">%1$lld</value> 추가 회복"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Aliados com <keyword id=\"thorns\">Espinhos</keyword> restauram <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Vida</keyword> adicional"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "擁有<keyword id=\"thorns\">荊棘</keyword>的友方額外恢復<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"health\">生命值</keyword>"}}
      }
    },
