    "talents.golden_retriever_gold_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: golden_retriever_gold_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erhalte bei einem Sieg <value id=\"quantity_1\">%1$lld</value>%% mehr <keyword id=\"gold\">Gold</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Gain <value id=\"quantity_1\">%1$lld</value>%% more <keyword id=\"gold\">Gold</keyword> on victory"}},
        "es": {"stringUnit": {"state": "translated", "value": "Obtén un <value id=\"quantity_1\">%1$lld</value>%% más de <keyword id=\"gold\">Oro</keyword> al vencer"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Gagnez <value id=\"quantity_1\">%1$lld</value>%% d’<keyword id=\"gold\">Or</keyword> en plus à la victoire"}},
        "ja": {"stringUnit": {"state": "translated", "value": "勝利時の<keyword id=\"gold\">ゴールド</keyword>獲得量が<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "승리 시 <keyword id=\"gold\">골드</keyword> 획득량 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ganhe <value id=\"quantity_1\">%1$lld</value>%% mais <keyword id=\"gold\">Ouro</keyword> na vitória"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "勝利時獲得的<keyword id=\"gold\">金幣</keyword>增加<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.golden_retriever_gold_t1_2.name": {
      "comment": "ContentManifest/talents.tsv: golden_retriever_gold_t1_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Schatzsuche"}},
        "en": {"stringUnit": {"state": "translated", "value": "Dig for Treasure"}},
        "es": {"stringUnit": {"state": "translated", "value": "Excavar en busca de tesoros"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Creuser pour un trésor"}},
        "ja": {"stringUnit": {"state": "translated", "value": "宝探し"}},
        "ko": {"stringUnit": {"state": "translated", "value": "보물 파내기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cavar em Busca de Tesouros"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "挖掘寶藏"}}
