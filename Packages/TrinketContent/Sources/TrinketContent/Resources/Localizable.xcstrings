        "fr": {"stringUnit": {"state": "translated", "value": "Butin : objets de type <keyword id=\"cleanse\">Purification</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"cleanse\">浄化</keyword>アイテムをドロップ"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"cleanse\">정화</keyword> 아이템 드롭"}},
