        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"bleed\">Bleed</keyword> damage\nDetonate all <keyword id=\"bleed\">Bleed</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Infligez <value id=\"quantity_1\">%1$lld</value> dégâts de <keyword id=\"bleed\">Saignement</keyword>\nFaites exploser tout le <keyword id=\"bleed\">Saignement</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"bleed\">出血</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える\nすべての<keyword id=\"bleed\">出血</keyword>を炸裂させる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"bleed\">출혈</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>\n모든 <keyword id=\"bleed\">출혈</keyword> 폭발"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
