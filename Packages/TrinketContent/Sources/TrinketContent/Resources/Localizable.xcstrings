      }
    },
    "talents.risen_skeleton_leech_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_leech_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">Lebensraub</keyword>-Angriffe verursachen <value id=\"quantity_1\">%1$lld</value>%% mehr Schaden an <keyword id=\"bleed\">blutenden</keyword> Gegnern"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">Leech</keyword> attacks deal <value id=\"quantity_1\">%1$lld</value>%% more damage against <keyword id=\"bleed\">Bleeding</keyword> enemies"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques de <keyword id=\"leech\">Absorción</keyword> infligen un <value id=\"quantity_1\">%1$lld</value>%% más de daño contra enemigos con <keyword id=\"bleed\">Sangrado</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques de <keyword id=\"leech\">Vol de vie</keyword> infligent <value id=\"quantity_1\">%1$lld</value>%% de dégâts en plus contre les ennemis sous <keyword id=\"bleed\">Saignement</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">出血</keyword>状態の敵への<keyword id=\"leech\">吸収</keyword>攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">출혈</keyword> 상태의 적에게 <keyword id=\"leech\">흡혈</keyword> 공격의 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques com <keyword id=\"leech\">Drenagem</keyword> causam <value id=\"quantity_1\">%1$lld</value>%% mais dano contra inimigos com <keyword id=\"bleed\">Sangramento</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">吸血</keyword>攻擊對<keyword id=\"bleed\">流血</keyword>敵人的傷害提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
