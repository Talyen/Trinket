    "homestead_nodes.leylineenergy.4.summary": {
      "comment": "ContentManifest/homestead_nodes.tsv: leylineEnergy.4, summary",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Leuchtende unterirdische Spalten leiten rohe Ebenenmagie aus tiefen Leylinien nach oben"}},
        "en": {"stringUnit": {"state": "translated", "value": "Luminous subterranean fissures channeling raw planar magic up from deep leylines"}},
        "es": {"stringUnit": {"state": "translated", "value": "Fisuras subterráneas luminosas que canalizan magia planar pura desde profundas líneas ley"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Des fissures souterraines lumineuses canalisent la magie planaire brute des lignes telluriques profondes"}},
        "ja": {"stringUnit": {"state": "translated", "value": "地下深くの地脈から、次元の魔力を地上へ導く光り輝く裂け目"}},
        "ko": {"stringUnit": {"state": "translated", "value": "깊은 지맥에서 솟는 원시 차원 마법을 끌어올리는 빛나는 지하 균열"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Fissuras subterrâneas luminosas canalizam magia planar bruta das profundezas das linhas de ley"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "發光的地下裂隙，將深處地脈的原始位面魔法引至地表"}}
      }
    },
