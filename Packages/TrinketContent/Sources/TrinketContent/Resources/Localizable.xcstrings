    "homestead_nodes.crystalgarden.1.bonus_description": {
      "comment": "ContentManifest/homestead_nodes.tsv: crystalGarden.1, bonus_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erhöhe kritischen Schaden um <value id=\"quantity_1\">%1$lld</value>%%\nEdelsteine pro Tag: <value id=\"quantity_2\">%2$lld</value>\nProduziere <value id=\"quantity_3\">%3$lld</value> Stein pro Tag"}},
        "en": {"stringUnit": {"state": "translated", "value": "Increase Critical damage by <value id=\"quantity_1\">%1$lld</value>%%\nProduce <value id=\"quantity_2\">%2$lld</value> Gems per Day\nProduce <value id=\"quantity_3\">%3$lld</value> Stone per Day"}},
        "es": {"stringUnit": {"state": "translated", "value": "Aumenta el daño crítico en un <value id=\"quantity_1\">%1$lld</value>%%\nGemas al día: <value id=\"quantity_2\">%2$lld</value>\nProduce <value id=\"quantity_3\">%3$lld</value> de piedra al día"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Dégâts critiques augmentés de <value id=\"quantity_1\">%1$lld</value>%%\nGemmes produites par jour : <value id=\"quantity_2\">%2$lld</value>\nProduit <value id=\"quantity_3\">%3$lld</value> de pierre par jour"}},
        "ja": {"stringUnit": {"state": "translated", "value": "クリティカルダメージが<value id=\"quantity_1\">%1$lld</value>%%増加\n1日に宝石を<value id=\"quantity_2\">%2$lld</value>生産\n1日に石材を<value id=\"quantity_3\">%3$lld</value>生産"}},
        "ko": {"stringUnit": {"state": "translated", "value": "치명타 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가\n하루에 보석 <value id=\"quantity_2\">%2$lld</value>개 생산\n하루에 석재 <value id=\"quantity_3\">%3$lld</value>개 생산"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Aumente o dano crítico em <value id=\"quantity_1\">%1$lld</value>%%\nGemas por Dia: <value id=\"quantity_2\">%2$lld</value>\nProduza <value id=\"quantity_3\">%3$lld</value> de Pedra por Dia"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "暴擊傷害提高<value id=\"quantity_1\">%1$lld</value>%%\n每天生產<value id=\"quantity_2\">%2$lld</value>寶石\n每天生產<value id=\"quantity_3\">%3$lld</value>石材"}}
      }
    },
