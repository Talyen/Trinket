    "talents.knight_holy_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: knight_holy_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"holy\">Heiliger</keyword> Schaden belebt deinen Gefährten mit <value id=\"quantity_1\">%1$lld</value>%% Chance wieder"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"holy\">Holy</keyword> damage has a <value id=\"quantity_1\">%1$lld</value>%% chance to revive your Companion"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dégâts de type <keyword id=\"holy\">Sacré</keyword> ont <value id=\"quantity_1\">%1$lld</value>%% de chances de ranimer votre Compagnon"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"holy\">聖</keyword>ダメージを与えると<value id=\"quantity_1\">%1$lld</value>%%の確率で仲間を蘇生"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"holy\">신성</keyword> 피해를 주면 <value id=\"quantity_1\">%1$lld</value>%% 확률로 동료 부활"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"holy\">神聖</keyword>傷害有<value id=\"quantity_1\">%1$lld</value>%%機率使夥伴復活"
          }
        }
      }
    },
