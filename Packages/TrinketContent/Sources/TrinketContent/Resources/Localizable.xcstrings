        "ja": {"stringUnit": {"state": "translated", "value": "魔法の残響"}},
        "ko": {"stringUnit": {"state": "translated", "value": "주문 메아리"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Eco de Feitiço"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "法術迴響"}}
      }
