    "traits.concussion.description": {
      "comment": "ContentManifest/traits.tsv: concussion, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"stun\">Betäubte</keyword> Gegner verursachen im nächsten Zug <value id=\"quantity_1\">%1$lld</value>%% weniger Schaden"
          }
