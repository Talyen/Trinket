    "talents.library_owl_holy_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: library_owl_holy_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">Heilige</keyword> Angriffe <keyword id=\"cleanse\">reinigen</keyword> deinen Verbündeten mit <value id=\"quantity_1\">%1$lld</value>%% Chance"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">Holy</keyword> attacks have a <value id=\"quantity_1\">%1$lld</value>%% chance to <keyword id=\"cleanse\">Cleanse</keyword> your ally"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques <keyword id=\"holy\">sagrados</keyword> tienen un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de <keyword id=\"cleanse\">purificar</keyword> a tu aliado"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques de type <keyword id=\"holy\">Sacré</keyword> ont <value id=\"quantity_1\">%1$lld</value>%% de chances d’appliquer une <keyword id=\"cleanse\">Purification</keyword> à votre allié"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">聖</keyword>攻撃が<value id=\"quantity_1\">%1$lld</value>%%の確率で味方を<keyword id=\"cleanse\">浄化</keyword>"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">신성</keyword> 공격 시 <value id=\"quantity_1\">%1$lld</value>%% 확률로 아군 <keyword id=\"cleanse\">정화</keyword>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques <keyword id=\"holy\">Sagrados</keyword> têm <value id=\"quantity_1\">%1$lld</value>%% de chance de <keyword id=\"cleanse\">Purificar</keyword> seu aliado"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">神聖</keyword>攻擊有<value id=\"quantity_1\">%1$lld</value>%%機率<keyword id=\"cleanse\">淨化</keyword>友方"}}
      }
    },
