    "talents.pixie_health_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: pixie_health_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine überschüssige Heilung macht dein nächstes Verstärken mit <keyword id=\"mana\">Mana</keyword> kostenlos"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your excess healing makes your next <keyword id=\"mana\">Mana</keyword> empowerment free"
          }
