    "talents.rogue_poison_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: rogue_poison_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"poison\">Gift</keyword> auf Gegnern nimmt <value id=\"quantity_1\">%1$lld</value>%% langsamer ab"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enemy <keyword id=\"poison\">Poison</keyword> fades <value id=\"quantity_1\">%1$lld</value>%% slower"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le <keyword id=\"poison\">Poison</keyword> affectant l’ennemi diminue <value id=\"quantity_1\">%1$lld</value>%% plus lentement"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "敵にかかった<keyword id=\"poison\">毒</keyword>の減衰が<value id=\"quantity_1\">%1$lld</value>%%遅くなる"
