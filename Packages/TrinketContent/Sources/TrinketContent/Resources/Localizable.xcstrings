    "talents.wildcard_physical_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: wildcard_physical_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Stehlen von <keyword id=\"gold\">Gold</keyword> fügt deinem nächsten Angriff <value id=\"quantity_1\">%1$lld</value> Schaden hinzu"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stealing <keyword id=\"gold\">Gold</keyword> adds <value id=\"quantity_1\">%1$lld</value> damage to your next attack"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voler de l’<keyword id=\"gold\">Or</keyword> ajoute <value id=\"quantity_1\">%1$lld</value> dégâts à votre prochaine attaque"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"gold\">ゴールド</keyword>を盗むと、次の攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>増加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"gold\">골드</keyword>를 훔치면 다음 공격의 피해 <value id=\"quantity_1\">%1$lld</value> 증가"
          }
        },
        "zh-Hant": {
