    "talents.fox_dodge_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: fox_dodge_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausweichen verursacht mit <value id=\"quantity_1\">%1$lld</value>%% Chance <value id=\"quantity_2\">%2$lld</value> <keyword id=\"poison\">Gift</keyword>schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodging has a <value id=\"quantity_1\">%1$lld</value>%% chance to deal <value id=\"quantity_2\">%2$lld</value> <keyword id=\"poison\">Poison</keyword> damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une esquive a <value id=\"quantity_1\">%1$lld</value>%% de chances d’infliger <value id=\"quantity_2\">%2$lld</value> dégâts de <keyword id=\"poison\">Poison</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回避すると<value id=\"quantity_1\">%1$lld</value>%%の確率で<keyword id=\"poison\">毒</keyword>ダメージを<value id=\"quantity_2\">%2$lld</value>与える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회피 시 <value id=\"quantity_1\">%1$lld</value>%% 확률로 <keyword id=\"poison\">독</keyword> 피해 <value id=\"quantity_2\">%2$lld</value>"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "閃避時有<value id=\"quantity_1\">%1$lld</value>%%機率造成<value id=\"quantity_2\">%2$lld</value>點<keyword id=\"poison\">中毒</keyword>傷害"
          }
        }
      }
    },
