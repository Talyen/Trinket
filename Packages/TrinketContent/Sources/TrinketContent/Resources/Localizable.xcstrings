    "homestead_nodes.moonlitsanctum.1.bonus_description": {
      "comment": "ContentManifest/homestead_nodes.tsv: moonlitSanctum.1, bonus_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fundrate astraler Gegenstände steigt um <value id=\"quantity_1\">%1$lld</value>%%\nFinde <value id=\"quantity_2\">%2$lld</value>%% mehr Edelsteine"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Astral drop rates rise by <value id=\"quantity_1\">%1$lld</value>%%\nFind <value id=\"quantity_2\">%2$lld</value>%% more Gems"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taux de butin astral augmenté de <value id=\"quantity_1\">%1$lld</value>%%\nTrouvez <value id=\"quantity_2\">%2$lld</value>%% de gemmes en plus"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "星界級のドロップ率が<value id=\"quantity_1\">%1$lld</value>%%上昇\n宝石の発見量が<value id=\"quantity_2\">%2$lld</value>%%増加"
          }
        },
        "ko": {
