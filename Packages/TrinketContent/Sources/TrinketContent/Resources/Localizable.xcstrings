    "talents.ranger_poison_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: ranger_poison_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Gift</keyword> verursacht einmalig doppelten Schaden, nachdem ein <keyword id=\"poison\">vergifteter</keyword> Gegner deinem Gefährten geschadet hat"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Poison</keyword> deals double damage once after a <keyword id=\"poison\">Poisoned</keyword> enemy hurts your Companion"}},
        "es": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Veneno</keyword> inflige el doble de daño una vez después de que un enemigo <keyword id=\"poison\">envenenado</keyword> hiera a tu compañero"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le <keyword id=\"poison\">Poison</keyword> inflige une fois le double de dégâts après qu’un ennemi sous <keyword id=\"poison\">Poison</keyword> blesse votre Compagnon"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">毒</keyword>状態の敵が仲間を傷つけると、その後1回の<keyword id=\"poison\">毒</keyword>ダメージが2倍になる"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">독</keyword> 상태의 적이 동료에게 피해를 주면 다음 <keyword id=\"poison\">독</keyword> 피해가 한 번 두 배"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Veneno</keyword> causa o dobro de dano uma vez após um inimigo <keyword id=\"poison\">Envenenado</keyword> ferir seu Companheiro"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">中毒</keyword>的敵人傷害夥伴後，下一次<keyword id=\"poison\">中毒</keyword>傷害加倍"}}
      }
    },
    "talents.ranger_poison_t2_2.name": {
      "comment": "ContentManifest/talents.tsv: ranger_poison_t2_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Giftiger Rückschlag"}},
        "en": {"stringUnit": {"state": "translated", "value": "Toxic Backlash"}},
        "es": {"stringUnit": {"state": "translated", "value": "Reacción tóxica"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Contrecoup toxique"}},
        "ja": {"stringUnit": {"state": "translated", "value": "毒の反撃"}},
        "ko": {"stringUnit": {"state": "translated", "value": "맹독의 반격"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Retaliação Tóxica"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "劇毒反噬"}}
      }
    },
    "talents.ranger_poison_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: ranger_poison_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Gift</keyword>-Angriffe entfernen <value id=\"quantity_1\">%1$lld</value> zusätzlichen <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Poison</keyword> attacks remove <value id=\"quantity_1\">%1$lld</value> extra <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques de <keyword id=\"poison\">Veneno</keyword> eliminan <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueo</keyword> adicional"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques de <keyword id=\"poison\">Poison</keyword> retirent <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Blocage</keyword> supplémentaires"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">毒</keyword>攻撃で削る<keyword id=\"block\">ブロック</keyword>量が<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">독</keyword> 공격이 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 추가 제거"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques de <keyword id=\"poison\">Veneno</keyword> removem <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueio</keyword> extra"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">中毒</keyword>攻擊額外削除<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>"}}
      }
    },
    "talents.ranger_poison_t3_1.name": {
      "comment": "ContentManifest/talents.tsv: ranger_poison_t3_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ätzendes Gift"}},
        "en": {"stringUnit": {"state": "translated", "value": "Corrosive Venom"}},
        "es": {"stringUnit": {"state": "translated", "value": "Veneno corrosivo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Venin corrosif"}},
        "ja": {"stringUnit": {"state": "translated", "value": "腐食の毒"}},
        "ko": {"stringUnit": {"state": "translated", "value": "부식 맹독"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Peçonha Corrosiva"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "腐蝕毒液"}}
      }
    },
    "talents.ranger_poison_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: ranger_poison_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Gegner unter halber <keyword id=\"health\">Gesundheit</keyword> erleiden <value id=\"quantity_1\">%1$lld</value>%% mehr <keyword id=\"poison\">Gift</keyword>schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Enemies below half <keyword id=\"health\">Health</keyword> take <value id=\"quantity_1\">%1$lld</value>%% increased <keyword id=\"poison\">Poison</keyword> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los enemigos por debajo de la mitad de <keyword id=\"health\">Salud</keyword> reciben un <value id=\"quantity_1\">%1$lld</value>%% más de daño de <keyword id=\"poison\">Veneno</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les ennemis sous la moitié de leur <keyword id=\"health\">Santé</keyword> subissent <value id=\"quantity_1\">%1$lld</value>%% de dégâts de <keyword id=\"poison\">Poison</keyword> en plus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>が半分未満の敵が受ける<keyword id=\"poison\">毒</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword>이 절반 미만인 적이 받는 <keyword id=\"poison\">독</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Inimigos abaixo de metade da <keyword id=\"health\">Vida</keyword> recebem <value id=\"quantity_1\">%1$lld</value>%% mais dano de <keyword id=\"poison\">Veneno</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">生命值</keyword>低於一半的敵人，承受的<keyword id=\"poison\">中毒</keyword>傷害增加<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.ranger_poison_t3_2.name": {
      "comment": "ContentManifest/talents.tsv: ranger_poison_t3_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Tödliche Dosis"}},
        "en": {"stringUnit": {"state": "translated", "value": "Lethal Dose"}},
        "es": {"stringUnit": {"state": "translated", "value": "Dosis letal"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Dose létale"}},
        "ja": {"stringUnit": {"state": "translated", "value": "致死量"}},
        "ko": {"stringUnit": {"state": "translated", "value": "치사량"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Dose Letal"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "致死劑量"}}
      }
    },
    "talents.ranger_poison_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: ranger_poison_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Kritische Treffer des Gefährten verdoppeln deinen nächsten <keyword id=\"poison\">Gift</keyword>-Angriff"}},
        "en": {"stringUnit": {"state": "translated", "value": "Companion Critical Hits double your next <keyword id=\"poison\">Poison</keyword> attack"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los golpes críticos del compañero duplican tu siguiente ataque de <keyword id=\"poison\">Veneno</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les coups critiques du Compagnon doublent votre prochaine attaque de <keyword id=\"poison\">Poison</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "仲間のクリティカルヒットで、次の<keyword id=\"poison\">毒</keyword>攻撃が2倍になる"}},
        "ko": {"stringUnit": {"state": "translated", "value": "동료의 치명타가 내 다음 <keyword id=\"poison\">독</keyword> 공격을 두 배로 강화"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Golpes críticos do Companheiro dobram seu próximo ataque de <keyword id=\"poison\">Veneno</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "夥伴暴擊使你的下次<keyword id=\"poison\">中毒</keyword>攻擊加倍"}}
      }
    },
    "talents.ranger_poison_t4_1.name": {
      "comment": "ContentManifest/talents.tsv: ranger_poison_t4_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Gifttransfusion"}},
        "en": {"stringUnit": {"state": "translated", "value": "Toxic Transfusion"}},
        "es": {"stringUnit": {"state": "translated", "value": "Transfusión tóxica"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Transfusion toxique"}},
        "ja": {"stringUnit": {"state": "translated", "value": "毒の輸血"}},
        "ko": {"stringUnit": {"state": "translated", "value": "맹독 수혈"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Transfusão Tóxica"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "劇毒輸注"}}
      }
    },
    "talents.risen_skeleton_deathsdoor_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_deathsdoor_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Erreichen der <keyword id=\"deathsdoor\">Todesschwelle</keyword> lässt dich eine Karte ziehen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Entering <keyword id=\"deathsdoor\">Death's Door</keyword> draws a card"}},
        "es": {"stringUnit": {"state": "translated", "value": "Entrar en las <keyword id=\"deathsdoor\">Puertas de la Muerte</keyword> hace que robes una carta"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Atteindre le <keyword id=\"deathsdoor\">Seuil de la mort</keyword> fait piocher une carte"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">死の淵</keyword>に入るとカードを1枚引く"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">죽음의 문턱</keyword>에 들어서면 카드 한 장 뽑기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ficar <keyword id=\"deathsdoor\">À Beira da Morte</keyword> faz você comprar uma carta"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "進入<keyword id=\"deathsdoor\">瀕死之門</keyword>時，抽一張牌"}}
      }
    },
    "talents.risen_skeleton_deathsdoor_t1_1.name": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_deathsdoor_t1_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Todesrasseln"}},
        "en": {"stringUnit": {"state": "translated", "value": "Deathrattle"}},
        "es": {"stringUnit": {"state": "translated", "value": "Estertor"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Râle d’agonie"}},
        "ja": {"stringUnit": {"state": "translated", "value": "断末魔"}},
        "ko": {"stringUnit": {"state": "translated", "value": "죽음의 메아리"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Último Suspiro"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "亡語"}}
      }
    },
    "talents.risen_skeleton_deathsdoor_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_deathsdoor_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Die <keyword id=\"deathsdoor\">Todesschwelle</keyword> hält einen zusätzlichen Zug an"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">Death's Door</keyword> lasts one additional turn"}},
        "es": {"stringUnit": {"state": "translated", "value": "El efecto <keyword id=\"deathsdoor\">Puertas de la Muerte</keyword> dura un turno adicional"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le <keyword id=\"deathsdoor\">Seuil de la mort</keyword> dure un tour de plus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">死の淵</keyword>がさらに1ターン持続"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">죽음의 문턱</keyword> 지속 시간 1턴 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "A condição <keyword id=\"deathsdoor\">À Beira da Morte</keyword> dura um turno adicional"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">瀕死之門</keyword>額外持續一回合"}}
      }
    },
    "talents.risen_skeleton_deathsdoor_t1_2.name": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_deathsdoor_t1_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Zäher Geist"}},
        "en": {"stringUnit": {"state": "translated", "value": "Tenacious Spirit"}},
        "es": {"stringUnit": {"state": "translated", "value": "Espíritu tenaz"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Esprit tenace"}},
        "ja": {"stringUnit": {"state": "translated", "value": "不屈の魂"}},
        "ko": {"stringUnit": {"state": "translated", "value": "끈질긴 영혼"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Espírito Tenaz"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "堅韌靈魂"}}
      }
    },
    "talents.risen_skeleton_deathsdoor_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_deathsdoor_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Der Tod nach der <keyword id=\"deathsdoor\">Todesschwelle</keyword> verursacht <value id=\"quantity_1\">%1$lld</value> <keyword id=\"physical\">physischen</keyword> Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Dying after <keyword id=\"deathsdoor\">Death's Door</keyword> deals <value id=\"quantity_1\">%1$lld</value> <keyword id=\"physical\">Physical</keyword> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Morir después de las <keyword id=\"deathsdoor\">Puertas de la Muerte</keyword> inflige <value id=\"quantity_1\">%1$lld</value> de daño <keyword id=\"physical\">físico</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Mourir après le <keyword id=\"deathsdoor\">Seuil de la mort</keyword> inflige <value id=\"quantity_1\">%1$lld</value> dégâts de type <keyword id=\"physical\">Physique</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">死の淵</keyword>の後に死亡すると<keyword id=\"physical\">物理</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">죽음의 문턱</keyword> 이후 죽으면 <keyword id=\"physical\">물리</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Morrer após a condição <keyword id=\"deathsdoor\">À Beira da Morte</keyword> causa <value id=\"quantity_1\">%1$lld</value> de dano <keyword id=\"physical\">Físico</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "經歷<keyword id=\"deathsdoor\">瀕死之門</keyword>後死亡時，造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"physical\">物理</keyword>傷害"}}
      }
    },
    "talents.risen_skeleton_deathsdoor_t2_1.name": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_deathsdoor_t2_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Leichenexplosion"}},
        "en": {"stringUnit": {"state": "translated", "value": "Corpse Explosion"}},
        "es": {"stringUnit": {"state": "translated", "value": "Explosión de cadáver"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Explosion de cadavre"}},
        "ja": {"stringUnit": {"state": "translated", "value": "死体爆発"}},
        "ko": {"stringUnit": {"state": "translated", "value": "시체 폭발"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Explosão Cadavérica"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "屍爆"}}
      }
    },
    "talents.risen_skeleton_deathsdoor_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_deathsdoor_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "An der <keyword id=\"deathsdoor\">Todesschwelle</keyword> erhältst du +<value id=\"quantity_1\">%1$lld</value>%% Chance auf kritische Treffer"}},
        "en": {"stringUnit": {"state": "translated", "value": "While on <keyword id=\"deathsdoor\">Death's Door</keyword>, gain +<value id=\"quantity_1\">%1$lld</value>%% Critical Hit chance"}},
        "es": {"stringUnit": {"state": "translated", "value": "Mientras estás a las <keyword id=\"deathsdoor\">Puertas de la Muerte</keyword>, obtén +<value id=\"quantity_1\">%1$lld</value>%% de probabilidad de golpe crítico"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Au <keyword id=\"deathsdoor\">Seuil de la mort</keyword>, gagnez +<value id=\"quantity_1\">%1$lld</value>%% de chances de coup critique"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">死の淵</keyword>の間、クリティカル率が<value id=\"quantity_1\">%1$lld</value>%%上昇"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">죽음의 문턱</keyword> 상태이면 치명타 확률 +<value id=\"quantity_1\">%1$lld</value>%%"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Enquanto estiver <keyword id=\"deathsdoor\">À Beira da Morte</keyword>, ganhe +<value id=\"quantity_1\">%1$lld</value>%% de chance de golpe crítico"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "處於<keyword id=\"deathsdoor\">瀕死之門</keyword>時，暴擊機率提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.risen_skeleton_deathsdoor_t2_2.name": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_deathsdoor_t2_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Tödlicher Zorn"}},
        "en": {"stringUnit": {"state": "translated", "value": "Deathly Wrath"}},
        "es": {"stringUnit": {"state": "translated", "value": "Ira mortal"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Courroux mortel"}},
        "ja": {"stringUnit": {"state": "translated", "value": "死の憤怒"}},
        "ko": {"stringUnit": {"state": "translated", "value": "죽음의 격노"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ira Mortal"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "死亡之怒"}}
      }
    },
    "talents.risen_skeleton_deathsdoor_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_deathsdoor_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Überleben der <keyword id=\"deathsdoor\">Todesschwelle</keyword> gewährt beiden Verbündeten <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Surviving <keyword id=\"deathsdoor\">Death's Door</keyword> grants both allies <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Sobrevivir a las <keyword id=\"deathsdoor\">Puertas de la Muerte</keyword> otorga a ambos aliados <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueo</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Survivre au <keyword id=\"deathsdoor\">Seuil de la mort</keyword> octroie <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Blocage</keyword> aux deux alliés"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">死の淵</keyword>を生き延びると味方2人に<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>付与"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">죽음의 문턱</keyword>에서 살아남으면 두 아군에게 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 부여"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Sobreviver à condição <keyword id=\"deathsdoor\">À Beira da Morte</keyword> concede <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueio</keyword> a ambos os aliados"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "從<keyword id=\"deathsdoor\">瀕死之門</keyword>生還時，賦予兩名友方<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>"}}
      }
    },
    "talents.risen_skeleton_deathsdoor_t3_1.name": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_deathsdoor_t3_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Endlose Legion"}},
        "en": {"stringUnit": {"state": "translated", "value": "Endless Legion"}},
        "es": {"stringUnit": {"state": "translated", "value": "Legión interminable"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Légion sans fin"}},
        "ja": {"stringUnit": {"state": "translated", "value": "無限の軍勢"}},
        "ko": {"stringUnit": {"state": "translated", "value": "끝없는 군단"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Legião Infinita"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "無盡軍團"}}
      }
    },
    "talents.risen_skeleton_deathsdoor_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_deathsdoor_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Die <keyword id=\"deathsdoor\">Todesschwelle</keyword> erhält deinen <keyword id=\"block\">Block</keyword> zwischen deinen Zügen"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">Death's Door</keyword> preserves your <keyword id=\"block\">Block</keyword> between turns"}},
        "es": {"stringUnit": {"state": "translated", "value": "El efecto <keyword id=\"deathsdoor\">Puertas de la Muerte</keyword> conserva tu <keyword id=\"block\">Bloqueo</keyword> entre turnos"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le <keyword id=\"deathsdoor\">Seuil de la mort</keyword> conserve votre <keyword id=\"block\">Blocage</keyword> entre les tours"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">死の淵</keyword>の間、ターンをまたいで自分の<keyword id=\"block\">ブロック</keyword>を保持"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">죽음의 문턱</keyword> 상태에서는 턴이 바뀌어도 내 <keyword id=\"block\">방어도</keyword> 유지"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "A condição <keyword id=\"deathsdoor\">À Beira da Morte</keyword> preserva seu <keyword id=\"block\">Bloqueio</keyword> entre turnos"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">瀕死之門</keyword>使自身<keyword id=\"block\">格擋</keyword>在回合之間保留"}}
      }
    },
