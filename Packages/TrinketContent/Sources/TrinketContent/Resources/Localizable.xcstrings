        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">Frozen</keyword> enemies take <value id=\"quantity_1\">%1$lld</value>%% increased <keyword id=\"burn\">Burn</keyword> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los enemigos <keyword id=\"freeze\">congelados</keyword> reciben un <value id=\"quantity_1\">%1$lld</value>%% más de daño de <keyword id=\"burn\">Quemadura</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les ennemis sous <keyword id=\"freeze\">Gel</keyword> subissent <value id=\"quantity_1\">%1$lld</value>%% de dégâts de <keyword id=\"burn\">Brûlure</keyword> en plus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">凍結</keyword>状態の敵が受ける<keyword id=\"burn\">炎上</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">빙결</keyword> 상태의 적이 받는 <keyword id=\"burn\">화상</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Inimigos <keyword id=\"freeze\">Congelados</keyword> recebem <value id=\"quantity_1\">%1$lld</value>%% mais dano de <keyword id=\"burn\">Queimadura</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">冰凍</keyword>的敵人承受的<keyword id=\"burn\">燃燒</keyword>傷害增加<value id=\"quantity_1\">%1$lld</value>%%"}}
