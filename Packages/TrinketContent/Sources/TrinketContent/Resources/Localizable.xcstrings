      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erhalte <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>\nErhalte <value id=\"quantity_2\">%2$lld</value> mehr, wenn du in diesem Zug <keyword id=\"gold\">Gold</keyword> erhalten hast"}},
        "en": {"stringUnit": {"state": "translated", "value": "Gain <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>\nGain <value id=\"quantity_2\">%2$lld</value> more if you gained <keyword id=\"gold\">Gold</keyword> this turn"}},
        "es": {"stringUnit": {"state": "translated", "value": "Obtén <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueo</keyword>\nObtén <value id=\"quantity_2\">%2$lld</value> más si has obtenido <keyword id=\"gold\">Oro</keyword> este turno"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Gagnez <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Blocage</keyword>\nGagnez-en <value id=\"quantity_2\">%2$lld</value> de plus si vous avez gagné de l’<keyword id=\"gold\">Or</keyword> ce tour-ci"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>獲得\nこのターンに自分が<keyword id=\"gold\">ゴールド</keyword>を獲得していれば、ブロックをさらに<value id=\"quantity_2\">%2$lld</value>獲得"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 획득\n이번 턴에 자신이 <keyword id=\"gold\">골드</keyword>를 획득했다면 방어도 <value id=\"quantity_2\">%2$lld</value> 추가 획득"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ganhe <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueio</keyword>\nGanhe mais <value id=\"quantity_2\">%2$lld</value> se você ganhou <keyword id=\"gold\">Ouro</keyword> neste turno"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "獲得<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>\n若你在本回合獲得過<keyword id=\"gold\">金幣</keyword>，則額外獲得<value id=\"quantity_2\">%2$lld</value>點格擋"}}
      }
    },
    "authored.0ca0cc5d15f73c74": {
      "comment": "Packages/TrinketAppState/Sources/TrinketAppState/Play/MysteryEncounterSession.swift: player-facing failure choiceUnavailableMessage",
