    "talents.phoenix_health_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: phoenix_health_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der erste tödliche Treffer gegen deinen Verbündeten in jedem Kampf belebt ihn mit <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Gesundheit</keyword> wieder"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your ally's first fatal hit each combat revives them with <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Health</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier coup fatal reçu par votre allié à chaque combat le ranime avec <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Santé</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各戦闘で味方が最初の致命打を受けると、<keyword id=\"health\">体力</keyword><value id=\"quantity_1\">%1$lld</value>で蘇生"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매 전투 아군이 처음으로 죽음에 이르는 공격을 받으면 <keyword id=\"health\">체력</keyword> <value id=\"quantity_1\">%1$lld</value> 상태로 부활"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每場戰鬥友方首次受到致命一擊時，以<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"health\">生命值</keyword>復活"
          }
        }
      }
    },
