    "talents.wildcard_physical_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: wildcard_physical_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Deine Angriffe verursachen mit <value id=\"quantity_1\">%1$lld</value>%% Chance zusätzlichen <keyword id=\"freeze\">Frost</keyword>- oder <keyword id=\"burn\">Brandschaden</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your attacks have a <value id=\"quantity_1\">%1$lld</value>%% chance to also <keyword id=\"freeze\">Freeze</keyword> or <keyword id=\"burn\">Burn</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tus ataques tienen un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de infligir daño adicional de <keyword id=\"freeze\">Congelación</keyword> o <keyword id=\"burn\">Quemadura</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Vos attaques ont <value id=\"quantity_1\">%1$lld</value>%% de chances d’infliger des dégâts supplémentaires de <keyword id=\"freeze\">Gel</keyword> ou de <keyword id=\"burn\">Brûlure</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "あなたの攻撃は、<value id=\"quantity_1\">%1$lld</value>%%の確率で<keyword id=\"freeze\">凍結</keyword>または<keyword id=\"burn\">炎上</keyword>の追加ダメージを与える"}},
        "ko": {"stringUnit": {"state": "translated", "value": "자신의 공격이 <value id=\"quantity_1\">%1$lld</value>%% 확률로 <keyword id=\"freeze\">빙결</keyword> 또는 <keyword id=\"burn\">화상</keyword> 피해를 추가로 줍니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seus ataques têm <value id=\"quantity_1\">%1$lld</value>%% de chance de causar dano adicional de <keyword id=\"freeze\">Congelamento</keyword> ou <keyword id=\"burn\">Queimadura</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "你的攻擊有<value id=\"quantity_1\">%1$lld</value>%%機率額外造成<keyword id=\"freeze\">冰凍</keyword>或<keyword id=\"burn\">燃燒</keyword>傷害"}}
      }
    },
