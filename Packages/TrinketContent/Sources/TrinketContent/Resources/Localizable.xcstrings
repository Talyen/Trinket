        "en": {"stringUnit": {"state": "translated", "value": "Alpha Strike"}},
        "es": {"stringUnit": {"state": "translated", "value": "Golpe alfa"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Frappe alpha"}},
        "ja": {"stringUnit": {"state": "translated", "value": "群れ長の一撃"}},
