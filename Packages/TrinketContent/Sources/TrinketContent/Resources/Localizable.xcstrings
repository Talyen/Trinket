        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dégâts de <keyword id=\"bleed\">Saignement</keyword> augmentés de <value id=\"quantity_1\">%1$lld</value>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"bleed\">出血</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>増加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
