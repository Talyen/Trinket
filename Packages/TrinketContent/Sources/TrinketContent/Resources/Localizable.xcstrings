    "talents.wildcard_gold_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: wildcard_gold_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Stehlen von <keyword id=\"gold\">Gold</keyword> gewährt bis zu deinem nächsten Zug +<value id=\"quantity_1\">%1$lld</value>%% Chance auf <keyword id=\"dodge\">Ausweichen</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stealing <keyword id=\"gold\">Gold</keyword> grants +<value id=\"quantity_1\">%1$lld</value>%% <keyword id=\"dodge\">Dodge</keyword> until your next turn"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voler de l’<keyword id=\"gold\">Or</keyword> octroie +<value id=\"quantity_1\">%1$lld</value>%% d’<keyword id=\"dodge\">Esquive</keyword> jusqu’à votre prochain tour"
          }
