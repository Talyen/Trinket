    "talents.warlock_leech_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: warlock_leech_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">Lebensraub</keyword>-Angriffe ignorieren die Hälfte des gegnerischen <keyword id=\"block\">Blocks</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">Leech</keyword> attacks ignore half enemy <keyword id=\"block\">Block</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les attaques de <keyword id=\"leech\">Vol de vie</keyword> ignorent la moitié du <keyword id=\"block\">Blocage</keyword> ennemi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">吸収</keyword>攻撃が敵の<keyword id=\"block\">ブロック</keyword>を半分無視"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">흡혈</keyword> 공격이 적의 <keyword id=\"block\">방어도</keyword> 절반 무시"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">吸血</keyword>攻擊無視敵人一半<keyword id=\"block\">格擋</keyword>"
          }
        }
      }
    },
