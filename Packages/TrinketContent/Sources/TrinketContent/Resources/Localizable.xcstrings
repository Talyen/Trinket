    "talents.pixie_cleanse_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: pixie_cleanse_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Reinigen stellt pro entferntem Schwächungseffekt <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Gesundheit</keyword> wieder her"}},
        "en": {"stringUnit": {"state": "translated", "value": "Cleansing restores <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Health</keyword> per debuff removed"}},
        "es": {"stringUnit": {"state": "translated", "value": "Purificar restaura <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Salud</keyword> por cada perjuicio eliminado"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Purifier restaure <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Santé</keyword> par malus retiré"}},
        "ja": {"stringUnit": {"state": "translated", "value": "浄化すると、解除した弱体効果1つにつき<keyword id=\"health\">体力</keyword>を<value id=\"quantity_1\">%1$lld</value>回復"}},
        "ko": {"stringUnit": {"state": "translated", "value": "정화 시 제거한 약화 효과마다 <keyword id=\"health\">체력</keyword> <value id=\"quantity_1\">%1$lld</value> 회복"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Purificar restaura <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Vida</keyword> por efeito negativo removido"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "淨化時，每移除一項減益效果恢復<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"health\">生命值</keyword>"}}
      }
    },
