        "ja": {"stringUnit": {"state": "translated", "value": "炎術師の火花"}},
        "ko": {"stringUnit": {"state": "translated", "value": "화염술사의 불꽃"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Faísca do Piromante"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "烈焰法師火花"}}
      }
    },
    "talents.wizard_burn_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: wizard_burn_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Brennende</keyword> Gegner erleiden <value id=\"quantity_1\">%1$lld</value>%% mehr Schaden durch kritische Treffer"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Burning</keyword> enemies take <value id=\"quantity_1\">%1$lld</value>%% increased Critical Hit damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los enemigos con <keyword id=\"burn\">Quemadura</keyword> reciben un <value id=\"quantity_1\">%1$lld</value>%% más de daño de golpes críticos"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les ennemis sous <keyword id=\"burn\">Brûlure</keyword> subissent <value id=\"quantity_1\">%1$lld</value>%% de dégâts critiques en plus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">炎上</keyword>状態の敵が受けるクリティカルヒットのダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">화상</keyword> 상태의 적이 받는 치명타 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Inimigos <keyword id=\"burn\">Em Chamas</keyword> recebem <value id=\"quantity_1\">%1$lld</value>%% mais dano de golpes críticos"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">燃燒</keyword>中的敵人承受的暴擊傷害增加<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.wizard_burn_t4_1.name": {
      "comment": "ContentManifest/talents.tsv: wizard_burn_t4_1, name",
