    "affixes.keen.astral_description": {
      "comment": "ContentManifest/affixes.tsv: keen, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhöhe <keyword id=\"physical\">physischen</keyword> Schaden um <value id=\"quantity_1\">%1$lld</value>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Increase <keyword id=\"physical\">Physical</keyword> damage by <value id=\"quantity_1\">%1$lld</value>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dégâts de type <keyword id=\"physical\">Physique</keyword> augmentés de <value id=\"quantity_1\">%1$lld</value>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"physical\">物理</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>増加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"physical\">물리</keyword> 피해 <value id=\"quantity_1\">%1$lld</value> 증가"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"physical\">物理</keyword>傷害增加<value id=\"quantity_1\">%1$lld</value>點"
          }
        }
      }
    },
