    "homestead_nodes.leylineenergy.1.bonus_description": {
      "comment": "ContentManifest/homestead_nodes.tsv: leylineEnergy.1, bonus_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Stelle <value id=\"quantity_1\">%1$lld</value>%% mehr <keyword id=\"mana\">Mana</keyword> wieder her\nEdelsteinproduktion pro Tag: <value id=\"quantity_2\">%2$lld</value>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Restore <value id=\"quantity_1\">%1$lld</value>%% more <keyword id=\"mana\">Mana</keyword>\nProduce <value id=\"quantity_2\">%2$lld</value> Gems per Day"}},
        "es": {"stringUnit": {"state": "translated", "value": "Restaura un <value id=\"quantity_1\">%1$lld</value>%% más de <keyword id=\"mana\">Maná</keyword>\nProducción diaria de gemas: <value id=\"quantity_2\">%2$lld</value>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">Mana</keyword> restauré augmenté de <value id=\"quantity_1\">%1$lld</value>%%\nProduction quotidienne de gemmes : <value id=\"quantity_2\">%2$lld</value>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">マナ</keyword>回復量が<value id=\"quantity_1\">%1$lld</value>%%増加\n1日に宝石を<value id=\"quantity_2\">%2$lld</value>生産"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">마나</keyword> 회복량 <value id=\"quantity_1\">%1$lld</value>%% 증가\n하루에 보석 <value id=\"quantity_2\">%2$lld</value>개 생산"}},
