    "affixes.branding.astral_description": {
      "comment": "ContentManifest/affixes.tsv: branding, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Markiere den Gegner, wenn er <keyword id=\"stun\">betäubt</keyword> wird"}},
        "en": {"stringUnit": {"state": "translated", "value": "Mark the enemy when they are <keyword id=\"stun\">Stunned</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Marca al enemigo cuando está <keyword id=\"stun\">aturdido</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Marquez l’ennemi lorsqu’il subit un <keyword id=\"stun\">Étourdissement</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "敵が<keyword id=\"stun\">スタン</keyword>状態になると、その敵をマーク"}},
        "ko": {"stringUnit": {"state": "translated", "value": "적이 <keyword id=\"stun\">기절</keyword>하면 그 적에게 표식 부여"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Marque o inimigo quando ele for <keyword id=\"stun\">Atordoado</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "敵人陷入<keyword id=\"stun\">暈眩</keyword>時，標記該敵人"}}
      }
    },
