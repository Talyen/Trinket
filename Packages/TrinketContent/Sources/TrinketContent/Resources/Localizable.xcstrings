    "talents.druid_health_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: druid_health_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Wiederherstellen von <keyword id=\"health\">Gesundheit</keyword> bei Verbündeten unter halber <keyword id=\"health\">Gesundheit</keyword> gewährt <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restoring <keyword id=\"health\">Health</keyword> to allies below half <keyword id=\"health\">Health</keyword> grants <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurer de la <keyword id=\"health\">Santé</keyword> aux alliés sous la moitié de leur <keyword id=\"health\">Santé</keyword> octroie <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Blocage</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">体力</keyword>が半分未満の味方の<keyword id=\"health\">体力</keyword>を回復すると、その味方に<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>付与"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">체력</keyword>이 절반 미만인 아군의 <keyword id=\"health\">체력</keyword> 회복 시 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 부여"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為<keyword id=\"health\">生命值</keyword>低於一半的友方恢復<keyword id=\"health\">生命值</keyword>時，賦予該友方<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>"
          }
        }
      }
    },
