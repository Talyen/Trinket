    "talents.golden_retriever_block_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: golden_retriever_block_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewähre deinem Verbündeten vor dem ersten Angriff gegen ihn <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant your ally <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword> before their first incoming attack"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Octroyez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Blocage</keyword> à votre allié avant la première attaque qu’il reçoit"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "味方が最初の攻撃を受ける前に、その味方に<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>付与"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아군이 처음 공격받기 전에 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 부여"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "友方首次受到攻擊前，賦予其<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>"
          }
        }
      }
    },
