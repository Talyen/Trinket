    "talents.lizard_scout_poison_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: lizard_scout_poison_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Gift</keyword>-Angriffe <keyword id=\"stun\">betäuben</keyword> mit <value id=\"quantity_1\">%1$lld</value>%% Chance"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Poison</keyword> attacks have a <value id=\"quantity_1\">%1$lld</value>%% chance to <keyword id=\"stun\">Stun</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques de <keyword id=\"poison\">Veneno</keyword> tienen un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de <keyword id=\"stun\">aturdir</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques de <keyword id=\"poison\">Poison</keyword> ont <value id=\"quantity_1\">%1$lld</value>%% de chances d’infliger un <keyword id=\"stun\">Étourdissement</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">毒</keyword>攻撃が<value id=\"quantity_1\">%1$lld</value>%%の確率で<keyword id=\"stun\">スタン</keyword>させる"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">독</keyword> 공격이 <value id=\"quantity_1\">%1$lld</value>%% 확률로 <keyword id=\"stun\">기절</keyword> 유발"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques de <keyword id=\"poison\">Veneno</keyword> têm <value id=\"quantity_1\">%1$lld</value>%% de chance de <keyword id=\"stun\">Atordoar</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">中毒</keyword>攻擊有<value id=\"quantity_1\">%1$lld</value>%%機率造成<keyword id=\"stun\">暈眩</keyword>"}}
      }
    },
