    "talents.wizard_freeze_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: wizard_freeze_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"freeze\">Eingefrorene</keyword> Gegner können keinen <keyword id=\"block\">Block</keyword> erhalten oder <keyword id=\"health\">Gesundheit</keyword> wiederherstellen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"freeze\">Frozen</keyword> enemies cannot gain <keyword id=\"block\">Block</keyword> or restore <keyword id=\"health\">Health</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les ennemis sous <keyword id=\"freeze\">Gel</keyword> ne peuvent ni gagner de <keyword id=\"block\">Blocage</keyword> ni restaurer de <keyword id=\"health\">Santé</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"freeze\">凍結</keyword>状態の敵は<keyword id=\"block\">ブロック</keyword>を獲得できず、<keyword id=\"health\">体力</keyword>も回復できない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"freeze\">빙결</keyword> 상태의 적은 <keyword id=\"block\">방어도</keyword> 획득 및 <keyword id=\"health\">체력</keyword> 회복 불가"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"freeze\">冰凍</keyword>的敵人無法獲得<keyword id=\"block\">格擋</keyword>或恢復<keyword id=\"health\">生命值</keyword>"
          }
        }
      }
    },
