    "talents.panther_bleed_t4_2.description": {
      "comment": "ContentManifest/talents.tsv: panther_bleed_t4_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du unter halbe <keyword id=\"health\">Gesundheit</keyword> fällst, wird dein nächster <keyword id=\"bleed\">Blutungs</keyword>-Angriff verdoppelt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dropping below half <keyword id=\"health\">Health</keyword> doubles your next <keyword id=\"bleed\">Bleed</keyword> attack"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passer sous la moitié de votre <keyword id=\"health\">Santé</keyword> double votre prochaine attaque de <keyword id=\"bleed\">Saignement</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">体力</keyword>が半分未満になると、次の<keyword id=\"bleed\">出血</keyword>攻撃が2倍になる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">체력</keyword>이 절반 미만이 되면 다음 <keyword id=\"bleed\">출혈</keyword> 공격이 두 배"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">生命值</keyword>降至低於一半時，下次<keyword id=\"bleed\">流血</keyword>攻擊加倍"
          }
        }
      }
    },
