        "ko": {"stringUnit": {"state": "translated", "value": "한계선"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Limite Vermelho"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "危險界線"}}
      }
    },
    "talents.panther_dodge_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: panther_dodge_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dein erstes <keyword id=\"dodge\">Ausweichen</keyword> in jedem Kampf verdoppelt deinen nächsten Angriff"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your first <keyword id=\"dodge\">Dodge</keyword> each combat doubles your next attack"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu primera <keyword id=\"dodge\">Evasión</keyword> de cada combate duplica tu siguiente ataque"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre première <keyword id=\"dodge\">Esquive</keyword> de chaque combat double votre prochaine attaque"}},
        "ja": {"stringUnit": {"state": "translated", "value": "各戦闘で最初の<keyword id=\"dodge\">回避</keyword>で次の攻撃が2倍になる"}},
        "ko": {"stringUnit": {"state": "translated", "value": "매 전투 첫 <keyword id=\"dodge\">회피</keyword> 시 다음 공격이 두 배"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Sua primeira <keyword id=\"dodge\">Esquiva</keyword> de cada combate dobra seu próximo ataque"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每場戰鬥首次<keyword id=\"dodge\">閃避</keyword>使下次攻擊加倍"}}
      }
    },
    "talents.panther_dodge_t1_1.name": {
      "comment": "ContentManifest/talents.tsv: panther_dodge_t1_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Überraschungsschlag"}},
        "en": {"stringUnit": {"state": "translated", "value": "Surprise Strike"}},
        "es": {"stringUnit": {"state": "translated", "value": "Golpe sorpresa"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Frappe surprise"}},
        "ja": {"stringUnit": {"state": "translated", "value": "奇襲の一撃"}},
        "ko": {"stringUnit": {"state": "translated", "value": "기습 일격"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Golpe Surpresa"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "奇襲"}}
      }
    },
    "talents.panther_dodge_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: panther_dodge_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Nach dem Ausweichen verursacht dein nächster <keyword id=\"bleed\">Blutungs</keyword>angriff <value id=\"quantity_1\">%1$lld</value> zusätzlichen Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Dodging adds <value id=\"quantity_1\">%1$lld</value> damage to your next <keyword id=\"bleed\">Bleed</keyword> attack"}},
        "es": {"stringUnit": {"state": "translated", "value": "Esquivar añade <value id=\"quantity_1\">%1$lld</value> de daño a tu siguiente ataque de <keyword id=\"bleed\">Sangrado</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Esquiver ajoute <value id=\"quantity_1\">%1$lld</value> dégâts à votre prochaine attaque de <keyword id=\"bleed\">Saignement</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "回避すると、次の<keyword id=\"bleed\">出血</keyword>攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>増加する"}},
        "ko": {"stringUnit": {"state": "translated", "value": "회피하면 다음 <keyword id=\"bleed\">출혈</keyword> 공격의 피해가 <value id=\"quantity_1\">%1$lld</value> 증가합니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Esquivar adiciona <value id=\"quantity_1\">%1$lld</value> de dano ao seu próximo ataque de <keyword id=\"bleed\">Sangramento</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "閃避後，你的下一次<keyword id=\"bleed\">流血</keyword>攻擊傷害提高<value id=\"quantity_1\">%1$lld</value>點"}}
      }
    },
    "talents.panther_dodge_t1_2.name": {
      "comment": "ContentManifest/talents.tsv: panther_dodge_t1_2, name",
      "extractionState": "manual",
      "localizations": {
