    "talents.wizard_freeze_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: wizard_freeze_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erhalte <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>, wenn ein Gegner <keyword id=\"freeze\">eingefroren</keyword> wird"}},
        "en": {"stringUnit": {"state": "translated", "value": "Gain <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword> whenever an enemy becomes <keyword id=\"freeze\">Frozen</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Obtén <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueo</keyword> siempre que un enemigo queda <keyword id=\"freeze\">congelado</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Gagnez <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Blocage</keyword> chaque fois qu’un ennemi devient <keyword id=\"freeze\">gelé</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "敵が<keyword id=\"freeze\">凍結</keyword>状態になるたび、<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>獲得"}},
        "ko": {"stringUnit": {"state": "translated", "value": "적이 <keyword id=\"freeze\">빙결</keyword> 상태가 될 때마다 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 획득"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ganhe <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueio</keyword> sempre que um inimigo for <keyword id=\"freeze\">Congelado</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每當敵人陷入<keyword id=\"freeze\">冰凍</keyword>，獲得<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>"}}
      }
    },
    "talents.wizard_freeze_t2_2.name": {
      "comment": "ContentManifest/talents.tsv: wizard_freeze_t2_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Gletscherbarriere"}},
        "en": {"stringUnit": {"state": "translated", "value": "Glacial Barrier"}},
        "es": {"stringUnit": {"state": "translated", "value": "Barrera glacial"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Barrière glaciale"}},
        "ja": {"stringUnit": {"state": "translated", "value": "氷河の障壁"}},
        "ko": {"stringUnit": {"state": "translated", "value": "빙하 장벽"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Barreira Glacial"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "冰川屏障"}}
      }
    },
    "talents.wizard_freeze_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: wizard_freeze_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">Eingefrorene</keyword> Gegner können keinen <keyword id=\"block\">Block</keyword> erhalten oder <keyword id=\"health\">Gesundheit</keyword> wiederherstellen"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">Frozen</keyword> enemies cannot gain <keyword id=\"block\">Block</keyword> or restore <keyword id=\"health\">Health</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los enemigos <keyword id=\"freeze\">congelados</keyword> no pueden obtener <keyword id=\"block\">Bloqueo</keyword> ni restaurar <keyword id=\"health\">Salud</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les ennemis sous <keyword id=\"freeze\">Gel</keyword> ne peuvent ni gagner de <keyword id=\"block\">Blocage</keyword> ni restaurer de <keyword id=\"health\">Santé</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">凍結</keyword>状態の敵は<keyword id=\"block\">ブロック</keyword>を獲得できず、<keyword id=\"health\">体力</keyword>も回復できない"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">빙결</keyword> 상태의 적은 <keyword id=\"block\">방어도</keyword> 획득 및 <keyword id=\"health\">체력</keyword> 회복 불가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Inimigos <keyword id=\"freeze\">Congelados</keyword> não podem ganhar <keyword id=\"block\">Bloqueio</keyword> nem restaurar <keyword id=\"health\">Vida</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">冰凍</keyword>的敵人無法獲得<keyword id=\"block\">格擋</keyword>或恢復<keyword id=\"health\">生命值</keyword>"}}
      }
    },
    "talents.wizard_freeze_t3_1.name": {
      "comment": "ContentManifest/talents.tsv: wizard_freeze_t3_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Tiefer <keyword id=\"freeze\">Frost</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Deep <keyword id=\"freeze\">Freeze</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">Congelación</keyword> profunda"}},
        "fr": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">Gel</keyword> profond"}},
        "ja": {"stringUnit": {"state": "translated", "value": "深き<keyword id=\"freeze\">凍結</keyword>"}},
        "ko": {"stringUnit": {"state": "translated", "value": "깊은 <keyword id=\"freeze\">빙결</keyword>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">Congelamento</keyword> Profundo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "深度<keyword id=\"freeze\">冰凍</keyword>"}}
      }
    },
    "talents.wizard_freeze_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: wizard_freeze_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erhöhe den <keyword id=\"freeze\">Frost</keyword>-Aufbau um <value id=\"quantity_1\">%1$lld</value>%%"}},
        "en": {"stringUnit": {"state": "translated", "value": "Increase <keyword id=\"freeze\">Freeze</keyword> build-up by <value id=\"quantity_1\">%1$lld</value>%%"}},
        "es": {"stringUnit": {"state": "translated", "value": "Aumenta la acumulación de <keyword id=\"freeze\">Congelación</keyword> en un <value id=\"quantity_1\">%1$lld</value>%%"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Accumulation de <keyword id=\"freeze\">Gel</keyword> augmentée de <value id=\"quantity_1\">%1$lld</value>%%"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">凍結</keyword>蓄積量が<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">빙결</keyword> 축적량 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Aumente o acúmulo de <keyword id=\"freeze\">Congelamento</keyword> em <value id=\"quantity_1\">%1$lld</value>%%"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">冰凍</keyword>累積量增加<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.wizard_freeze_t3_2.name": {
      "comment": "ContentManifest/talents.tsv: wizard_freeze_t3_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Schneetreiben"}},
        "en": {"stringUnit": {"state": "translated", "value": "Whiteout"}},
        "es": {"stringUnit": {"state": "translated", "value": "Ceguera blanca"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Voile blanc"}},
        "ja": {"stringUnit": {"state": "translated", "value": "白い闇"}},
        "ko": {"stringUnit": {"state": "translated", "value": "눈보라 장막"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Branco Total"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "白茫"}}
      }
    },
    "talents.wizard_freeze_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: wizard_freeze_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Blocken verursacht einmal pro Zug <value id=\"quantity_1\">%1$lld</value> <keyword id=\"freeze\">Frost</keyword>schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Blocking deals <value id=\"quantity_1\">%1$lld</value> <keyword id=\"freeze\">Freeze</keyword> damage once per turn"}},
        "es": {"stringUnit": {"state": "translated", "value": "Bloquear inflige <value id=\"quantity_1\">%1$lld</value> de daño de <keyword id=\"freeze\">Congelación</keyword> una vez por turno"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Bloquer inflige <value id=\"quantity_1\">%1$lld</value> dégâts de <keyword id=\"freeze\">Gel</keyword> une fois par tour"}},
        "ja": {"stringUnit": {"state": "translated", "value": "1ターンに1回、ブロックすると<keyword id=\"freeze\">凍結</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える"}},
        "ko": {"stringUnit": {"state": "translated", "value": "턴마다 한 번, 공격을 막으면 <keyword id=\"freeze\">빙결</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Bloquear causa <value id=\"quantity_1\">%1$lld</value> de dano de <keyword id=\"freeze\">Congelamento</keyword> uma vez por turno"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每回合一次，格擋時造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"freeze\">冰凍</keyword>傷害"}}
      }
    },
    "talents.wizard_freeze_t4_1.name": {
      "comment": "ContentManifest/talents.tsv: wizard_freeze_t4_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Eisige Atempause"}},
        "en": {"stringUnit": {"state": "translated", "value": "Glacial Reprieve"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tregua glacial"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Répit glacial"}},
        "ja": {"stringUnit": {"state": "translated", "value": "氷河の猶予"}},
        "ko": {"stringUnit": {"state": "translated", "value": "빙하의 유예"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Trégua Glacial"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "冰川喘息"}}
      }
