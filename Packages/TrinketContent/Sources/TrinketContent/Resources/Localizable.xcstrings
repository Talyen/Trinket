    "talents.bear_physical_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: bear_physical_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein erster <keyword id=\"physical\">physischer</keyword> Angriff in jedem Zug erhält die Hälfte deines <keyword id=\"block\">Blocks</keyword> als Schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your first <keyword id=\"physical\">Physical</keyword> attack each turn gains half your <keyword id=\"block\">Block</keyword> as damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre première attaque de type <keyword id=\"physical\">Physique</keyword> de chaque tour ajoute la moitié de votre <keyword id=\"block\">Blocage</keyword> à ses dégâts"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ターンで最初の<keyword id=\"physical\">物理</keyword>攻撃に、自分の<keyword id=\"block\">ブロック</keyword>の半分をダメージとして追加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매 턴 첫 <keyword id=\"physical\">물리</keyword> 공격이 내 <keyword id=\"block\">방어도</keyword>의 절반만큼 추가 피해"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每回合首次<keyword id=\"physical\">物理</keyword>攻擊增加相當於自身<keyword id=\"block\">格擋</keyword>一半的傷害"
          }
        }
      }
    },
