    "affixes.thunderstone.astral_description": {
      "comment": "ContentManifest/affixes.tsv: thunderstone, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verursache doppelten Schaden an <keyword id=\"stun\">betäubten</keyword> Gegnern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deal double damage to <keyword id=\"stun\">Stunned</keyword> enemies"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Infligez le double de dégâts aux ennemis sous <keyword id=\"stun\">Étourdissement</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"stun\">スタン</keyword>状態の敵に与えるダメージが2倍になる"
