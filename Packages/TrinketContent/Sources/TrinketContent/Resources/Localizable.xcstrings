    "talents.wizard_mana_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: wizard_mana_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte am Zugende pro unverbrauchtem <keyword id=\"mana\">Mana</keyword> <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>, höchstens <value id=\"quantity_2\">%2$lld</value>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At turn’s end, gain <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword> per unspent <keyword id=\"mana\">Mana</keyword>, up to <value id=\"quantity_2\">%2$lld</value>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En fin de tour, gagnez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Blocage</keyword> par <keyword id=\"mana\">Mana</keyword> non dépensé, jusqu’à <value id=\"quantity_2\">%2$lld</value>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターン終了時、未使用の<keyword id=\"mana\">マナ</keyword>1につき<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>獲得（最大<value id=\"quantity_2\">%2$lld</value>）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "턴 종료 시 남은 <keyword id=\"mana\">마나</keyword> 1당 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 획득, 최대 <value id=\"quantity_2\">%2$lld</value>"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回合結束時，每點未使用的<keyword id=\"mana\">魔力</keyword>賦予<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>，最多<value id=\"quantity_2\">%2$lld</value>點"
          }
        }
      }
    },
