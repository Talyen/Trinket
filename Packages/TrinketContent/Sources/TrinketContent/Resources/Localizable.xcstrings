    "authored.62f91beb09391622": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog+Offhand.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte <keyword id=\"block\">Block</keyword> zwischen deinen Zügen\nAusweichen verbraucht die Hälfte deines <keyword id=\"block\">Blocks</keyword>, um ebenso viel <keyword id=\"physical\">physischen</keyword> Schaden zu verursachen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep <keyword id=\"block\">Block</keyword> between turns\nDodging spends half your <keyword id=\"block\">Block</keyword> to deal that much <keyword id=\"physical\">Physical</keyword> damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservez le <keyword id=\"block\">Blocage</keyword> entre les tours\nUne esquive dépense la moitié de votre <keyword id=\"block\">Blocage</keyword> pour infliger autant de dégâts de type <keyword id=\"physical\">Physique</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターンをまたいで<keyword id=\"block\">ブロック</keyword>を保持\n回避すると<keyword id=\"block\">ブロック</keyword>の半分を消費し、同量の<keyword id=\"physical\">物理</keyword>ダメージを与える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "턴이 바뀌어도 <keyword id=\"block\">방어도</keyword> 유지\n회피 시 내 <keyword id=\"block\">방어도</keyword>의 절반을 소모해 그만큼 <keyword id=\"physical\">물리</keyword> 피해"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回合之間保留<keyword id=\"block\">格擋</keyword>\n閃避時消耗一半<keyword id=\"block\">格擋</keyword>，造成等量<keyword id=\"physical\">物理</keyword>傷害"
          }
        }
      }
    },
    "authored.631c19c743a036ed": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Encounters/Mystery/MysteryEventPool+Events.swift: narrative",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heilpilze umgeben „%1$@“, während treibende Sporen sich über „%2$@“ sammeln"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Medicinal caps surround “%1$@” as drifting spores gather above “%2$@”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des chapeaux de champignons médicinaux entourent « %1$@ », tandis que des spores en suspension se rassemblent au-dessus de « %2$@ »"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "薬効のあるキノコが「%1$@」を囲み、漂う胞子が「%2$@」の上に集まっている"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약용 버섯이 ‘%1$@’ 주위를 둘러싸고, 흩날리는 포자가 ‘%2$@’ 위에 모입니다"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "藥用菌蓋圍繞著「%1$@」，飄散的孢子在「%2$@」上方聚集"
          }
        }
      }
    },
