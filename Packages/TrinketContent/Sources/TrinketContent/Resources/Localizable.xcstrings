    "talents.pixie_holy_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: pixie_holy_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein erster <keyword id=\"holy\">heiliger</keyword> Angriff in jedem Zug verursacht <value id=\"quantity_1\">%1$lld</value> zusätzlichen Schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your first <keyword id=\"holy\">Holy</keyword> attack each turn deals <value id=\"quantity_1\">%1$lld</value> additional damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre première attaque de type <keyword id=\"holy\">Sacré</keyword> de chaque tour inflige <value id=\"quantity_1\">%1$lld</value> dégâts supplémentaires"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ターンで最初の<keyword id=\"holy\">聖</keyword>攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>増加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매 턴 첫 <keyword id=\"holy\">신성</keyword> 공격의 추가 피해 <value id=\"quantity_1\">%1$lld</value>"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每回合首次<keyword id=\"holy\">神聖</keyword>攻擊額外造成<value id=\"quantity_1\">%1$lld</value>點傷害"
          }
        }
      }
    },
