    "talents.rogue_bleed_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: rogue_bleed_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">Lebensraub</keyword>-Angriffe erhalten gegen <keyword id=\"bleed\">blutende</keyword> Gegner +<value id=\"quantity_1\">%1$lld</value>%% Chance auf kritische Treffer"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">Leech</keyword> attacks gain +<value id=\"quantity_1\">%1$lld</value>%% Critical chance against <keyword id=\"bleed\">Bleeding</keyword> enemies"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques de <keyword id=\"leech\">Absorción</keyword> obtienen +<value id=\"quantity_1\">%1$lld</value>%% de probabilidad de crítico contra enemigos con <keyword id=\"bleed\">Sangrado</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques de <keyword id=\"leech\">Vol de vie</keyword> gagnent +<value id=\"quantity_1\">%1$lld</value>%% de chances de coup critique contre les ennemis sous <keyword id=\"bleed\">Saignement</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">出血</keyword>状態の敵への<keyword id=\"leech\">吸収</keyword>攻撃のクリティカル率が<value id=\"quantity_1\">%1$lld</value>%%上昇"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">출혈</keyword> 상태의 적에게 <keyword id=\"leech\">흡혈</keyword> 공격의 치명타 확률 +<value id=\"quantity_1\">%1$lld</value>%%"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques com <keyword id=\"leech\">Drenagem</keyword> ganham +<value id=\"quantity_1\">%1$lld</value>%% de chance de crítico contra inimigos com <keyword id=\"bleed\">Sangramento</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">吸血</keyword>攻擊對<keyword id=\"bleed\">流血</keyword>敵人的暴擊機率提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.rogue_bleed_t2_1.name": {
      "comment": "ContentManifest/talents.tsv: rogue_bleed_t2_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Blutgeschmack"}},
        "en": {"stringUnit": {"state": "translated", "value": "Taste for Blood"}},
        "es": {"stringUnit": {"state": "translated", "value": "Gusto por la sangre"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Goût du sang"}},
        "ja": {"stringUnit": {"state": "translated", "value": "血の味"}},
        "ko": {"stringUnit": {"state": "translated", "value": "피의 맛"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Gosto de Sangue"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "鮮血滋味"}}
      }
    },
    "talents.rogue_bleed_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: rogue_bleed_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Besiegen <keyword id=\"bleed\">blutender</keyword> Gegner gewährt <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Gold</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Defeating <keyword id=\"bleed\">Bleeding</keyword> enemies grants <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Gold</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Derrotar a enemigos con <keyword id=\"bleed\">Sangrado</keyword> otorga <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"gold\">Oro</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Terrasser un ennemi sous <keyword id=\"bleed\">Saignement</keyword> octroie <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Or</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">出血</keyword>状態の敵を倒すと<keyword id=\"gold\">ゴールド</keyword>を<value id=\"quantity_1\">%1$lld</value>獲得"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">출혈</keyword> 상태의 적 처치 시 <keyword id=\"gold\">골드</keyword> <value id=\"quantity_1\">%1$lld</value> 획득"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Derrotar inimigos com <keyword id=\"bleed\">Sangramento</keyword> concede <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"gold\">Ouro</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "擊敗<keyword id=\"bleed\">流血</keyword>的敵人時，獲得<value id=\"quantity_1\">%1$lld</value><keyword id=\"gold\">金幣</keyword>"}}
      }
    },
    "talents.rogue_bleed_t2_2.name": {
      "comment": "ContentManifest/talents.tsv: rogue_bleed_t2_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Blutgeld"}},
        "en": {"stringUnit": {"state": "translated", "value": "Blood Money"}},
        "es": {"stringUnit": {"state": "translated", "value": "Dinero de sangre"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Argent du sang"}},
        "ja": {"stringUnit": {"state": "translated", "value": "血塗られた金"}},
        "ko": {"stringUnit": {"state": "translated", "value": "피 묻은 돈"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Dinheiro de Sangue"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "血腥錢財"}}
      }
    },
    "talents.rogue_bleed_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: rogue_bleed_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Kritische <keyword id=\"bleed\">Blutungs</keyword>-Treffer verursachen doppelten Schaden, wenn der Gegner unter halber <keyword id=\"health\">Gesundheit</keyword> ist"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">Bleed</keyword> Critical Hits deal double damage below half enemy <keyword id=\"health\">Health</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los golpes críticos de <keyword id=\"bleed\">Sangrado</keyword> infligen el doble de daño cuando el enemigo está por debajo de la mitad de <keyword id=\"health\">Salud</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les coups critiques de <keyword id=\"bleed\">Saignement</keyword> infligent le double de dégâts si l’ennemi est sous la moitié de sa <keyword id=\"health\">Santé</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "敵の<keyword id=\"health\">体力</keyword>が半分未満なら、<keyword id=\"bleed\">出血</keyword>クリティカルヒットのダメージが2倍になる"}},
        "ko": {"stringUnit": {"state": "translated", "value": "적의 <keyword id=\"health\">체력</keyword>이 절반 미만이면 <keyword id=\"bleed\">출혈</keyword> 치명타가 두 배의 피해"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Golpes críticos de <keyword id=\"bleed\">Sangramento</keyword> causam o dobro de dano quando o inimigo está abaixo de metade da <keyword id=\"health\">Vida</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "敵人<keyword id=\"health\">生命值</keyword>低於一半時，<keyword id=\"bleed\">流血</keyword>暴擊造成雙倍傷害"}}
      }
    },
    "talents.rogue_bleed_t3_1.name": {
      "comment": "ContentManifest/talents.tsv: rogue_bleed_t3_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ausbluten"}},
        "en": {"stringUnit": {"state": "translated", "value": "Exsanguinate"}},
        "es": {"stringUnit": {"state": "translated", "value": "Exsanguinar"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Exsanguination"}},
        "ja": {"stringUnit": {"state": "translated", "value": "失血死"}},
        "ko": {"stringUnit": {"state": "translated", "value": "방혈"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Exsanguinar"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "放血"}}
      }
    },
    "talents.rogue_bleed_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: rogue_bleed_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">Blutende</keyword> Gegner stellen halb so viel <keyword id=\"health\">Gesundheit</keyword> wieder her"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">Bleeding</keyword> enemies restore half as much <keyword id=\"health\">Health</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los enemigos con <keyword id=\"bleed\">Sangrado</keyword> restauran la mitad de la cantidad normal de <keyword id=\"health\">Salud</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les ennemis sous <keyword id=\"bleed\">Saignement</keyword> restaurent moitié moins de <keyword id=\"health\">Santé</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">出血</keyword>状態の敵の<keyword id=\"health\">体力</keyword>回復量が半減"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">출혈</keyword> 상태인 적의 <keyword id=\"health\">체력</keyword> 회복량이 절반으로 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Inimigos com <keyword id=\"bleed\">Sangramento</keyword> restauram apenas metade da quantidade normal de <keyword id=\"health\">Vida</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">流血</keyword>的敵人恢復的<keyword id=\"health\">生命值</keyword>減半"}}
      }
    },
    "talents.rogue_bleed_t3_2.name": {
      "comment": "ContentManifest/talents.tsv: rogue_bleed_t3_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Tödliche Wunde"}},
        "en": {"stringUnit": {"state": "translated", "value": "Mortal Wound"}},
        "es": {"stringUnit": {"state": "translated", "value": "Herida mortal"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Blessure mortelle"}},
        "ja": {"stringUnit": {"state": "translated", "value": "致命傷"}},
        "ko": {"stringUnit": {"state": "translated", "value": "치명상"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ferida Mortal"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "致命創傷"}}
      }
    },
    "talents.rogue_bleed_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: rogue_bleed_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">Blutung</keyword> hält bei <keyword id=\"poison\">vergifteten</keyword> Gegnern <value id=\"quantity_1\">%1$lld</value> zusätzlichen Zug an"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">Bleed</keyword> lasts <value id=\"quantity_1\">%1$lld</value> extra turn on <keyword id=\"poison\">Poisoned</keyword> enemies"}},
        "es": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">Sangrado</keyword> dura <value id=\"quantity_1\">%1$lld</value> turno adicional en enemigos <keyword id=\"poison\">envenenados</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le <keyword id=\"bleed\">Saignement</keyword> dure <value id=\"quantity_1\">%1$lld</value> tour de plus sur les ennemis sous <keyword id=\"poison\">Poison</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">毒</keyword>状態の敵への<keyword id=\"bleed\">出血</keyword>がさらに<value id=\"quantity_1\">%1$lld</value>ターン持続"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">독</keyword> 상태의 적에게 <keyword id=\"bleed\">출혈</keyword> 지속 시간 <value id=\"quantity_1\">%1$lld</value>턴 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">Sangramento</keyword> dura <value id=\"quantity_1\">%1$lld</value> turno adicional em inimigos <keyword id=\"poison\">Envenenados</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "對<keyword id=\"poison\">中毒</keyword>的敵人，<keyword id=\"bleed\">流血</keyword>額外持續<value id=\"quantity_1\">%1$lld</value>回合"}}
      }
    },
    "talents.rogue_bleed_t4_1.name": {
      "comment": "ContentManifest/talents.tsv: rogue_bleed_t4_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Septische Wunde"}},
        "en": {"stringUnit": {"state": "translated", "value": "Septic Wound"}},
        "es": {"stringUnit": {"state": "translated", "value": "Herida séptica"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Plaie septique"}},
        "ja": {"stringUnit": {"state": "translated", "value": "化膿した傷"}},
        "ko": {"stringUnit": {"state": "translated", "value": "패혈성 상처"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ferida Séptica"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "感染創傷"}}
      }
    },
    "talents.rogue_gold_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: rogue_gold_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Kritische Treffer stehlen <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Gold</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Critical Hits steal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Gold</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los golpes críticos roban <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"gold\">Oro</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les coups critiques volent <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Or</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "クリティカルヒットで<keyword id=\"gold\">ゴールド</keyword>を<value id=\"quantity_1\">%1$lld</value>盗む"}},
        "ko": {"stringUnit": {"state": "translated", "value": "치명타 적중 시 <keyword id=\"gold\">골드</keyword> <value id=\"quantity_1\">%1$lld</value> 훔치기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Golpes críticos roubam <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"gold\">Ouro</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "暴擊時偷取<value id=\"quantity_1\">%1$lld</value><keyword id=\"gold\">金幣</keyword>"}}
      }
    },
    "talents.rogue_gold_t1_1.name": {
      "comment": "ContentManifest/talents.tsv: rogue_gold_t1_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Flinke Finger"}},
        "en": {"stringUnit": {"state": "translated", "value": "Light Fingers"}},
        "es": {"stringUnit": {"state": "translated", "value": "Dedos ligeros"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Doigts légers"}},
        "ja": {"stringUnit": {"state": "translated", "value": "軽業の指"}},
        "ko": {"stringUnit": {"state": "translated", "value": "가벼운 손놀림"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Mãos Leves"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "輕巧手指"}}
      }
    },
    "talents.rogue_gold_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: rogue_gold_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wenn du im Kampf <keyword id=\"gold\">Gold</keyword> erhältst, erhalte <keyword id=\"block\">Block</keyword> in Höhe der Hälfte dieses Betrags"}},
        "en": {"stringUnit": {"state": "translated", "value": "Whenever you gain <keyword id=\"gold\">Gold</keyword> in combat, gain <keyword id=\"block\">Block</keyword> equal to half that amount"}},
        "es": {"stringUnit": {"state": "translated", "value": "Siempre que obtienes <keyword id=\"gold\">Oro</keyword> en combate, obtén <keyword id=\"block\">Bloqueo</keyword> equivalente a la mitad de esa cantidad"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Chaque gain d’<keyword id=\"gold\">Or</keyword> en combat octroie du <keyword id=\"block\">Blocage</keyword> à hauteur de la moitié de ce montant"}},
        "ja": {"stringUnit": {"state": "translated", "value": "戦闘中に<keyword id=\"gold\">ゴールド</keyword>を獲得するたび、その半分に等しい<keyword id=\"block\">ブロック</keyword>を獲得"}},
        "ko": {"stringUnit": {"state": "translated", "value": "전투에서 <keyword id=\"gold\">골드</keyword> 획득 시 그 절반만큼 <keyword id=\"block\">방어도</keyword> 획득"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Sempre que ganhar <keyword id=\"gold\">Ouro</keyword> em combate, ganhe <keyword id=\"block\">Bloqueio</keyword> equivalente à metade dessa quantidade"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "戰鬥中每次獲得<keyword id=\"gold\">金幣</keyword>時，獲得相當於該數量一半的<keyword id=\"block\">格擋</keyword>"}}
      }
    },
