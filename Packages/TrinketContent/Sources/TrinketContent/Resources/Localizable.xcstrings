    "authored.a54f62394e652e95": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Abilities/AbilityCatalog+Skill.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verursache <value id=\"quantity_1\">%1$lld</value> bis <value id=\"quantity_2\">%2$lld</value> <keyword id=\"burn\">Brand</keyword>schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deal <value id=\"quantity_1\">%1$lld</value> to <value id=\"quantity_2\">%2$lld</value> <keyword id=\"burn\">Burn</keyword> damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Infligez de <value id=\"quantity_1\">%1$lld</value> à <value id=\"quantity_2\">%2$lld</value> dégâts de <keyword id=\"burn\">Brûlure</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">炎上</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>〜<value id=\"quantity_2\">%2$lld</value>与える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">화상</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>~<value id=\"quantity_2\">%2$lld</value>"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "造成<value id=\"quantity_1\">%1$lld</value>至<value id=\"quantity_2\">%2$lld</value>點<keyword id=\"burn\">燃燒</keyword>傷害"
          }
        }
      }
    },
    "authored.a581cd58714a2621": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Encounters/Mystery/MysteryEventPool+Events.swift: narrative",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabmünzen umgeben „%1$@“, während herabgestürztes Mauerwerk neben der Gruft „%2$@“ festklemmt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Burial coins surround “%1$@” while fallen masonry pins “%2$@” beside the crypt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des pièces funéraires entourent « %1$@ », tandis que des débris de maçonnerie coincent « %2$@ » près de la crypte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "埋葬用の硬貨が「%1$@」を囲み、地下墓所の横では崩れた石積みが「%2$@」を押さえ込んでいる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매장용 동전이 둘러싼 것은 ‘%1$@’, 지하묘지 곁 무너진 석조물에 깔린 것은 ‘%2$@’입니다"
          }
        },
        "zh-Hant": {
