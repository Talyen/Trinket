    "affixes.icy_heart.astral_description": {
      "comment": "ContentManifest/affixes.tsv: icy_heart, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dein <keyword id=\"freeze\">Frost</keyword>schaden löst mit <value id=\"quantity_1\">%1$lld</value>%% Chance <keyword id=\"leech\">Lebensraub</keyword> aus"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your <keyword id=\"freeze\">Freeze</keyword> damage has a <value id=\"quantity_1\">%1$lld</value>%% chance to <keyword id=\"leech\">Leech</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu daño de <keyword id=\"freeze\">Congelación</keyword> tiene un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de activar <keyword id=\"leech\">Absorción</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Vos dégâts de <keyword id=\"freeze\">Gel</keyword> ont <value id=\"quantity_1\">%1$lld</value>%% de chances de bénéficier de <keyword id=\"leech\">Vol de vie</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "自分の<keyword id=\"freeze\">凍結</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%の確率で<keyword id=\"leech\">吸収</keyword>する"}},
        "ko": {"stringUnit": {"state": "translated", "value": "내 <keyword id=\"freeze\">빙결</keyword> 피해에 <value id=\"quantity_1\">%1$lld</value>%% 확률로 <keyword id=\"leech\">흡혈</keyword> 적용"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seu dano de <keyword id=\"freeze\">Congelamento</keyword> tem <value id=\"quantity_1\">%1$lld</value>%% de chance de aplicar <keyword id=\"leech\">Drenagem</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "自身<keyword id=\"freeze\">冰凍</keyword>傷害有<value id=\"quantity_1\">%1$lld</value>%%機率<keyword id=\"leech\">吸血</keyword>"}}
      }
    },
