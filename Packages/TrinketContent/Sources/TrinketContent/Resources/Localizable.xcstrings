    "traits.numbing_presence.description": {
      "comment": "ContentManifest/traits.tsv: numbing_presence, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">Eingefrorene</keyword> Gegner verursachen <value id=\"quantity_1\">%1$lld</value> weniger Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">Frozen</keyword> enemies deal <value id=\"quantity_1\">%1$lld</value> less damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los enemigos <keyword id=\"freeze\">congelados</keyword> infligen <value id=\"quantity_1\">%1$lld</value> menos de daño"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les ennemis sous <keyword id=\"freeze\">Gel</keyword> infligent <value id=\"quantity_1\">%1$lld</value> dégâts en moins"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">凍結</keyword>状態の敵の与えるダメージが<value id=\"quantity_1\">%1$lld</value>減少"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">빙결</keyword> 상태의 적이 주는 피해 <value id=\"quantity_1\">%1$lld</value> 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Inimigos <keyword id=\"freeze\">Congelados</keyword> causam <value id=\"quantity_1\">%1$lld</value> de dano a menos"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">冰凍</keyword>的敵人造成的傷害降低<value id=\"quantity_1\">%1$lld</value>點"}}
      }
    },
    "traits.numbing_presence.name": {
      "comment": "ContentManifest/traits.tsv: numbing_presence, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Betäubende Präsenz"}},
        "en": {"stringUnit": {"state": "translated", "value": "Numbing Presence"}},
        "es": {"stringUnit": {"state": "translated", "value": "Presencia entumecedora"}},
