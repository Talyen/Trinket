    "talents.library_owl_cleanse_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: library_owl_cleanse_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Reinigen eines Verbündeten stellt <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Gesundheit</keyword> wieder her"}},
        "en": {"stringUnit": {"state": "translated", "value": "Cleansing an ally restores <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Health</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Purificar a un aliado restaura <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Salud</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Purifier un allié restaure <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Santé</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "味方を浄化すると<keyword id=\"health\">体力</keyword>を<value id=\"quantity_1\">%1$lld</value>回復"}},
        "ko": {"stringUnit": {"state": "translated", "value": "아군 정화 시 <keyword id=\"health\">체력</keyword> <value id=\"quantity_1\">%1$lld</value> 회복"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Purificar um aliado restaura <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Vida</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "淨化友方時，恢復<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"health\">生命值</keyword>"}}
      }
    },
    "talents.library_owl_cleanse_t1_2.name": {
      "comment": "ContentManifest/talents.tsv: library_owl_cleanse_t1_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Heilhymne"}},
        "en": {"stringUnit": {"state": "translated", "value": "Healing Hymn"}},
        "es": {"stringUnit": {"state": "translated", "value": "Himno curativo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Hymne de soin"}},
        "ja": {"stringUnit": {"state": "translated", "value": "癒やしの賛歌"}},
        "ko": {"stringUnit": {"state": "translated", "value": "치유의 찬가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Hino de Cura"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "治療聖歌"}}
