    "talents.wildcard_gold_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: wildcard_gold_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein erster vollständig geblockter Angriff in jedem Kampf\nfügt deiner Hand eine zufällige Karte hinzu"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your first fully Blocked attack each combat\nadds a random card to your hand"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre première attaque entièrement bloquée de chaque combat\najoute une carte aléatoire à votre main"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各戦闘で初めて自分の攻撃が完全にブロックされると\nランダムなカードを1枚手札に追加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매 전투 내 공격이 처음으로 완전히 막히면\n손에 무작위 카드 한 장 추가"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每場戰鬥自身攻擊首次被完全格擋時\n將一張隨機卡牌加入手牌"
          }
        }
      }
    },
