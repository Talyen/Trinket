        "zh-Hant": {"stringUnit": {"state": "translated", "value": "煽風點火"}}
      }
    },
    "traits.fault_lines.description": {
      "comment": "ContentManifest/traits.tsv: fault_lines, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erlittener <keyword id=\"stun\">Betäubungs</keyword>schaden um <value id=\"quantity_1\">%1$lld</value>%% erhöht"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">Stun</keyword> damage taken increased by <value id=\"quantity_1\">%1$lld</value>%%"}},
        "es": {"stringUnit": {"state": "translated", "value": "Daño de <keyword id=\"stun\">Aturdimiento</keyword> recibido aumentado en un <value id=\"quantity_1\">%1$lld</value>%%"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Dégâts d’<keyword id=\"stun\">Étourdissement</keyword> subis augmentés de <value id=\"quantity_1\">%1$lld</value>%%"}},
        "ja": {"stringUnit": {"state": "translated", "value": "受ける<keyword id=\"stun\">スタン</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "받는 <keyword id=\"stun\">기절</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Dano de <keyword id=\"stun\">Atordoamento</keyword> recebido aumentado em <value id=\"quantity_1\">%1$lld</value>%%"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "承受的<keyword id=\"stun\">暈眩</keyword>傷害增加<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "traits.fault_lines.name": {
