    "talents.ranger_bleed_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: ranger_bleed_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
