    "talents.warlock_mana_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: warlock_mana_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Bei <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword> wird <keyword id=\"burn\">Brand</keyword>schaden um <value id=\"quantity_2\">%2$lld</value>%% erhöht"}},
        "en": {"stringUnit": {"state": "translated", "value": "At <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword>, <keyword id=\"burn\">Burn</keyword> damage is increased by <value id=\"quantity_2\">%2$lld</value>%%"}},
        "es": {"stringUnit": {"state": "translated", "value": "Con <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"mana\">Maná</keyword>, el daño de <keyword id=\"burn\">Quemadura</keyword> aumenta en un <value id=\"quantity_2\">%2$lld</value>%%"}},
        "fr": {"stringUnit": {"state": "translated", "value": "À <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword>, les dégâts de <keyword id=\"burn\">Brûlure</keyword> augmentent de <value id=\"quantity_2\">%2$lld</value>%%"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">マナ</keyword>が<value id=\"quantity_1\">%1$lld</value>の時、<keyword id=\"burn\">炎上</keyword>ダメージが<value id=\"quantity_2\">%2$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">마나</keyword>가 <value id=\"quantity_1\">%1$lld</value>일 때 <keyword id=\"burn\">화상</keyword> 피해 <value id=\"quantity_2\">%2$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Com <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"mana\">Mana</keyword>, o dano de <keyword id=\"burn\">Queimadura</keyword> aumenta em <value id=\"quantity_2\">%2$lld</value>%%"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "擁有<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"mana\">魔力</keyword>時，<keyword id=\"burn\">燃燒</keyword>傷害提高<value id=\"quantity_2\">%2$lld</value>%%"}}
      }
    },
