    "homestead_nodes.culinaryarts.1.bonus_description": {
      "comment": "ContentManifest/homestead_nodes.tsv: culinaryArts.1, bonus_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Stelle <value id=\"quantity_1\">%1$lld</value>%% mehr <keyword id=\"health\">Gesundheit</keyword> wieder her\nProduziere <value id=\"quantity_2\">%2$lld</value> Nahrung pro Tag"}},
