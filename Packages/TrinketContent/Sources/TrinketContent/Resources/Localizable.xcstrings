    "talents.knight_block_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: knight_block_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter halber <keyword id=\"health\">Gesundheit</keyword> absorbiert <keyword id=\"block\">Block</keyword> <value id=\"quantity_1\">%1$lld</value>%% mehr Schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Below half <keyword id=\"health\">Health</keyword>, <keyword id=\"block\">Block</keyword> absorbs <value id=\"quantity_1\">%1$lld</value>%% more damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sous la moitié de votre <keyword id=\"health\">Santé</keyword>, le <keyword id=\"block\">Blocage</keyword> absorbe <value id=\"quantity_1\">%1$lld</value>%% de dégâts en plus"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">体力</keyword>が半分未満なら、<keyword id=\"block\">ブロック</keyword>が吸収するダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">체력</keyword>이 절반 미만이면 <keyword id=\"block\">방어도</keyword>의 피해 흡수량 <value id=\"quantity_1\">%1$lld</value>%% 증가"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">生命值</keyword>低於一半時，<keyword id=\"block\">格擋</keyword>吸收的傷害增加<value id=\"quantity_1\">%1$lld</value>%%"
          }
        }
      }
    },
