    "affixes.clearheaded.astral_description": {
      "comment": "ContentManifest/affixes.tsv: clearheaded, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>, wenn du <value id=\"quantity_2\">%2$lld</value> Schwächungseffekt <keyword id=\"cleanse\">reinigst</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gain <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword> when you <keyword id=\"cleanse\">Cleanse</keyword> <value id=\"quantity_2\">%2$lld</value> debuff"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagne <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Blocage</keyword> lors de la <keyword id=\"cleanse\">Purification</keyword> de <value id=\"quantity_2\">%2$lld</value> malus"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "弱体効果を<value id=\"quantity_2\">%2$lld</value>個<keyword id=\"cleanse\">浄化</keyword>すると<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>得る"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약화 효과 <value id=\"quantity_2\">%2$lld</value>개를 <keyword id=\"cleanse\">정화</keyword>하면 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 획득"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"cleanse\">淨化</keyword><value id=\"quantity_2\">%2$lld</value>項減益效果時，獲得<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>"
          }
        }
      }
    },
    "affixes.clearheaded.basic_description": {
      "comment": "ContentManifest/affixes.tsv: clearheaded, basic_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>, wenn du <value id=\"quantity_2\">%2$lld</value> Schwächungseffekt <keyword id=\"cleanse\">reinigst</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gain <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword> when you <keyword id=\"cleanse\">Cleanse</keyword> <value id=\"quantity_2\">%2$lld</value> debuff"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagne <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Blocage</keyword> lors de la <keyword id=\"cleanse\">Purification</keyword> de <value id=\"quantity_2\">%2$lld</value> malus"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "弱体効果を<value id=\"quantity_2\">%2$lld</value>個<keyword id=\"cleanse\">浄化</keyword>すると<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>得る"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약화 효과 <value id=\"quantity_2\">%2$lld</value>개를 <keyword id=\"cleanse\">정화</keyword>하면 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 획득"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"cleanse\">淨化</keyword><value id=\"quantity_2\">%2$lld</value>項減益效果時，獲得<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>"
          }
        }
      }
    },
