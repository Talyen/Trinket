    "talents.warlock_mana_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: warlock_mana_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">Gesundheits</keyword>kosten senken die Kosten deines nächsten Verstärkens mit <keyword id=\"mana\">Mana</keyword> um <value id=\"quantity_1\">%1$lld</value>"
