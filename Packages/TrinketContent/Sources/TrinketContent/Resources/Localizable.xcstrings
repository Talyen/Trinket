        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偷取<keyword id=\"gold\">金幣</keyword>的暴擊額外賦予<value id=\"quantity_1\">%1$lld</value><keyword id=\"gold\">金幣</keyword>"
          }
