        "pt-BR": {"stringUnit": {"state": "translated", "value": "Toque de Fada"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "精靈之觸"}}
      }
    },
    "talents.pixie_health_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: pixie_health_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Stelle bei Verbündeten unter halber <keyword id=\"health\">Gesundheit</keyword> <value id=\"quantity_1\">%1$lld</value>%% mehr <keyword id=\"health\">Gesundheit</keyword> wieder her"}},
        "en": {"stringUnit": {"state": "translated", "value": "Restore <value id=\"quantity_1\">%1$lld</value>%% more <keyword id=\"health\">Health</keyword> to allies below half <keyword id=\"health\">Health</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Restaura un <value id=\"quantity_1\">%1$lld</value>%% más de <keyword id=\"health\">Salud</keyword> a los aliados por debajo de la mitad de <keyword id=\"health\">Salud</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Restaurez <value id=\"quantity_1\">%1$lld</value>%% de <keyword id=\"health\">Santé</keyword> en plus aux alliés sous la moitié de leur <keyword id=\"health\">Santé</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>が半分未満の味方への<keyword id=\"health\">体力</keyword>回復量が<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword>이 절반 미만인 아군의 <keyword id=\"health\">체력</keyword> 회복량 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Restaure <value id=\"quantity_1\">%1$lld</value>%% mais <keyword id=\"health\">Vida</keyword> de aliados abaixo de metade da <keyword id=\"health\">Vida</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "為<keyword id=\"health\">生命值</keyword>低於一半的友方恢復的<keyword id=\"health\">生命值</keyword>增加<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
