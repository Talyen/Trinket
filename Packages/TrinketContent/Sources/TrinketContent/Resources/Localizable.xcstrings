    "homestead_nodes.archeryrange.1.bonus_description": {
      "comment": "ContentManifest/homestead_nodes.tsv: archeryRange.1, bonus_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Bogen- und Armbrustschaden +<value id=\"quantity_1\">%1$lld</value>%%\nProduziere <value id=\"quantity_2\">%2$lld</value> Holz pro Tag"}},
        "en": {"stringUnit": {"state": "translated", "value": "Bow and Crossbow damage +<value id=\"quantity_1\">%1$lld</value>%%\nProduce <value id=\"quantity_2\">%2$lld</value> Wood per Day"}},
        "es": {"stringUnit": {"state": "translated", "value": "Daño de arcos y ballestas +<value id=\"quantity_1\">%1$lld</value>%%\nProduce <value id=\"quantity_2\">%2$lld</value> de madera al día"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Dégâts des arcs et arbalètes +<value id=\"quantity_1\">%1$lld</value>%%\nProduction quotidienne de bois : <value id=\"quantity_2\">%2$lld</value>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "弓とクロスボウのダメージ +<value id=\"quantity_1\">%1$lld</value>%%\n1日に木材を<value id=\"quantity_2\">%2$lld</value>生産"}},
        "ko": {"stringUnit": {"state": "translated", "value": "활과 석궁 피해 +<value id=\"quantity_1\">%1$lld</value>%%\n하루에 목재 <value id=\"quantity_2\">%2$lld</value>개 생산"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Dano de Arcos e Bestas +<value id=\"quantity_1\">%1$lld</value>%%\nProduza <value id=\"quantity_2\">%2$lld</value> de Madeira por Dia"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "弓與弩傷害+<value id=\"quantity_1\">%1$lld</value>%%\n每天生產<value id=\"quantity_2\">%2$lld</value>木材"}}
      }
    },
