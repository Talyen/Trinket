    "talents.fox_dodge_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: fox_dodge_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Ausweichen ignoriert dein nächster Angriff gegnerischen <keyword id=\"block\">Block</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodging makes your next attack ignore enemy <keyword id=\"block\">Block</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une esquive fait ignorer le <keyword id=\"block\">Blocage</keyword> ennemi à votre prochaine attaque"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回避すると、次の攻撃が敵の<keyword id=\"block\">ブロック</keyword>を無視"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회피 시 다음 공격이 적의 <keyword id=\"block\">방어도</keyword> 무시"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "閃避後，下次攻擊無視敵人<keyword id=\"block\">格擋</keyword>"
          }
        }
      }
    },
