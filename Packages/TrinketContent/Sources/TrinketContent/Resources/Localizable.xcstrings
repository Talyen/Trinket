    "talents.wizard_mana_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: wizard_mana_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Beenden eines Zugs mit <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword> reinigt <value id=\"quantity_2\">%2$lld</value> Schwächungseffekt"}},
        "en": {"stringUnit": {"state": "translated", "value": "Ending a turn at <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword> Cleanses <value id=\"quantity_2\">%2$lld</value> debuff"}},
        "es": {"stringUnit": {"state": "translated", "value": "Terminar un turno con <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"mana\">Maná</keyword> purifica <value id=\"quantity_2\">%2$lld</value> perjuicio"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Terminer un tour avec <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"mana\">Mana</keyword> purifie <value id=\"quantity_2\">%2$lld</value> malus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">マナ</keyword>が<value id=\"quantity_1\">%1$lld</value>の状態でターンを終えると弱体効果を<value id=\"quantity_2\">%2$lld</value>個浄化"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">마나</keyword>가 <value id=\"quantity_1\">%1$lld</value>인 채 턴을 마치면 약화 효과 <value id=\"quantity_2\">%2$lld</value>개 정화"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Encerrar um turno com <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"mana\">Mana</keyword> Purifica <value id=\"quantity_2\">%2$lld</value> efeito negativo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "以<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"mana\">魔力</keyword>結束回合時，淨化<value id=\"quantity_2\">%2$lld</value>項減益效果"}}
      }
    },
    "talents.wizard_mana_t2_2.name": {
      "comment": "ContentManifest/talents.tsv: wizard_mana_t2_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Arkane Reinigung"}},
