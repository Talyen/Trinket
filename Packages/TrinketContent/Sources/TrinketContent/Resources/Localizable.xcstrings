    "authored.afae16a3cf881d1d": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Abilities/AbilityCatalog+Ultimate.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verursache <value id=\"quantity_1\">%1$lld</value> <keyword id=\"physical\">physischen</keyword> Schaden\nZiehe eine Karte vom Deck deines Verbündeten\nIst dies nicht möglich, ziehe von deinem Deck"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"physical\">Physical</keyword> damage\nDraw a card from your ally's deck\nIf unavailable, draw from your deck"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Infligez <value id=\"quantity_1\">%1$lld</value> dégâts de type <keyword id=\"physical\">Physique</keyword>\nPiochez une carte dans le paquet de votre allié\nSinon, piochez dans votre paquet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"physical\">物理</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える\n味方のデッキからカードを1枚引く\n引けなければ自分のデッキから引く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"physical\">물리</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>\n아군의 덱에서 카드 한 장 뽑기\n불가능하면 내 덱에서 뽑기"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"physical\">物理</keyword>傷害\n從友方牌組抽一張牌\n若無法抽取，改從自身牌組抽牌"
          }
        }
      }
    },
    "authored.b0a3e28af7dcec6d": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Encounters/Mystery/MysteryEventPool+Events.swift: narrative",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Münzen schimmern neben „%1$@“, während Feenlichter um „%2$@“ tanzen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coins glimmer beside “%1$@” while fairy lights dance around “%2$@”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des pièces brillent près de « %1$@ », tandis que des lueurs féeriques dansent autour de « %2$@ »"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」の傍らで硬貨がきらめき、「%2$@」の周りでは妖精の光が踊っている"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%1$@’ 곁에서 동전이 반짝이고, 요정의 빛이 ‘%2$@’ 주위에서 춤춥니다"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錢幣在「%1$@」旁閃耀，精靈光點在「%2$@」四周起舞"
          }
        }
      }
    },
    "authored.b1675a38dab65f37": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/InventoryItem+Compatibility.swift: canonical numeric compatibility description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Blocken eines Angriffs lässt deinen nächsten manuell gespielten Angriff kritisch treffen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocking an attack makes your next manually played attack Critically Hit"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquer une attaque garantit que votre prochaine attaque jouée manuellement sera Critique"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "攻撃をブロックすると、次に手動で使う攻撃がクリティカルヒットする"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공격을 막으면 다음에 직접 사용하는 공격이 반드시 치명타"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "格擋一次攻擊後，下一次手動打出的攻擊必定暴擊"
          }
        }
      }
    },
