    "talents.golden_retriever_health_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: golden_retriever_health_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dein erstes Wiederherstellen von <keyword id=\"health\">Gesundheit</keyword> in jedem Kampf lässt dich eine Karte ziehen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your first <keyword id=\"health\">Health</keyword> restoration each combat draws a card"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu primera restauración de <keyword id=\"health\">Salud</keyword> de cada combate hace que robes una carta"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre première restauration de <keyword id=\"health\">Santé</keyword> de chaque combat fait piocher une carte"}},
        "ja": {"stringUnit": {"state": "translated", "value": "各戦闘で初めて<keyword id=\"health\">体力</keyword>を回復すると、カードを1枚引く"}},
        "ko": {"stringUnit": {"state": "translated", "value": "매 전투 첫 <keyword id=\"health\">체력</keyword> 회복 시 카드 한 장 뽑기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Sua primeira restauração de <keyword id=\"health\">Vida</keyword> de cada combate faz você comprar uma carta"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每場戰鬥首次恢復<keyword id=\"health\">生命值</keyword>時，抽一張牌"}}
      }
    },
