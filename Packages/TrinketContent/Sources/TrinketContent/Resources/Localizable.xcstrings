    "talents.library_owl_cleanse_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: library_owl_cleanse_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Reinigen eines Verbündeten gewährt seinem nächsten Angriff +<value id=\"quantity_1\">%1$lld</value>%% Chance auf kritische Treffer"}},
        "en": {"stringUnit": {"state": "translated", "value": "Cleansing an ally grants +<value id=\"quantity_1\">%1$lld</value>%% Critical Hit chance on their next attack"}},
        "es": {"stringUnit": {"state": "translated", "value": "Purificar a un aliado otorga +<value id=\"quantity_1\">%1$lld</value>%% de probabilidad de golpe crítico en su siguiente ataque"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Purifier un allié octroie +<value id=\"quantity_1\">%1$lld</value>%% de chances de coup critique à sa prochaine attaque"}},
        "ja": {"stringUnit": {"state": "translated", "value": "味方を浄化すると、その味方の次の攻撃のクリティカル率が<value id=\"quantity_1\">%1$lld</value>%%上昇"}},
        "ko": {"stringUnit": {"state": "translated", "value": "아군 정화 시 해당 아군의 다음 공격 치명타 확률 +<value id=\"quantity_1\">%1$lld</value>%%"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Purificar um aliado concede +<value id=\"quantity_1\">%1$lld</value>%% de chance de golpe crítico no próximo ataque dele"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "淨化友方後，該友方下次攻擊的暴擊機率提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
