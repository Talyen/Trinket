    "authored.d0463a96c348a68c": {
      "comment": "Packages/TrinketAppState/Sources/TrinketAppState/Play/Modes/EncounterPlayMode.swift: player-facing failure message",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Der Händler hat nichts mehr zu verkaufen\nDu ziehst weiter"}},
        "en": {"stringUnit": {"state": "translated", "value": "The merchant has nothing left to sell\nYou continue on"}},
        "es": {"stringUnit": {"state": "translated", "value": "Al mercader no le queda nada que vender\nSigues tu camino"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le marchand n’a plus rien à vendre\nVous poursuivez votre route"}},
        "ja": {"stringUnit": {"state": "translated", "value": "商人にはもう売る物がない\nそのまま先へ進む"}},
        "ko": {"stringUnit": {"state": "translated", "value": "상인에게 더는 팔 물건이 없습니다\n계속 나아갑니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O mercador não tem mais nada para vender\nVocê segue em frente"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "商人已無物可售\n你繼續前進"}}
      }
    },
    "authored.d05c226ac0e13004": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog+Melee.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">Physische</keyword> kritische Treffer, die <keyword id=\"health\">Gesundheit</keyword> abziehen, lassen <keyword id=\"bleed\">Blutung</keyword> detonieren"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">Physical</keyword> Critical Hits that remove <keyword id=\"health\">Health</keyword> detonate <keyword id=\"bleed\">Bleed</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los golpes críticos <keyword id=\"physical\">físicos</keyword> que reducen <keyword id=\"health\">Salud</keyword> detonan <keyword id=\"bleed\">Sangrado</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les coups critiques de type <keyword id=\"physical\">Physique</keyword> qui retirent de la <keyword id=\"health\">Santé</keyword> font exploser le <keyword id=\"bleed\">Saignement</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">物理</keyword>クリティカルヒットで<keyword id=\"health\">体力</keyword>を減らすと、<keyword id=\"bleed\">出血</keyword>を炸裂させる"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword>을 깎는 <keyword id=\"physical\">물리</keyword> 치명타가 <keyword id=\"bleed\">출혈</keyword> 폭발"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Golpes críticos <keyword id=\"physical\">Físicos</keyword> que removem <keyword id=\"health\">Vida</keyword> detonam <keyword id=\"bleed\">Sangramento</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "使敵人失去<keyword id=\"health\">生命值</keyword>的<keyword id=\"physical\">物理</keyword>暴擊會引爆<keyword id=\"bleed\">流血</keyword>"}}
      }
    },
