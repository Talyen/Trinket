        "ja": {"stringUnit": {"state": "translated", "value": "鎧の獣皮"}},
        "ko": {"stringUnit": {"state": "translated", "value": "판금 가죽"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Pele Blindada"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "甲片獸皮"}}
      }
    },
    "talents.shield_scarab_block_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: shield_scarab_block_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Solange du <keyword id=\"block\">Block</keyword> hast, erleide <value id=\"quantity_1\">%1$lld</value> weniger nicht-<keyword id=\"physical\">physischen</keyword> Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "While you have <keyword id=\"block\">Block</keyword>, take <value id=\"quantity_1\">%1$lld</value> less non-<keyword id=\"physical\">Physical</keyword> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Mientras tienes <keyword id=\"block\">Bloqueo</keyword>, recibes <value id=\"quantity_1\">%1$lld</value> menos de daño no <keyword id=\"physical\">físico</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Tant que vous avez du <keyword id=\"block\">Blocage</keyword>, les dégâts autres que de type <keyword id=\"physical\">Physique</keyword> subis sont réduits de <value id=\"quantity_1\">%1$lld</value>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">ブロック</keyword>がある間、受ける<keyword id=\"physical\">物理</keyword>以外のダメージが<value id=\"quantity_1\">%1$lld</value>減少"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">방어도</keyword>가 있으면 <keyword id=\"physical\">물리</keyword> 외의 받는 피해 <value id=\"quantity_1\">%1$lld</value> 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Enquanto tiver <keyword id=\"block\">Bloqueio</keyword>, receba <value id=\"quantity_1\">%1$lld</value> de dano não <keyword id=\"physical\">Físico</keyword> a menos"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "擁有<keyword id=\"block\">格擋</keyword>時，承受的非<keyword id=\"physical\">物理</keyword>傷害降低<value id=\"quantity_1\">%1$lld</value>點"}}
      }
    },
