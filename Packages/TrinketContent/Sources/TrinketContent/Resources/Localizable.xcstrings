    "authored.966023551496008c": {
      "comment": "Packages/TrinketAppState/Sources/TrinketAppState/Play/Modes/LabyrinthPlayMode.swift: player-facing failure message",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Die Labyrinthkarte konnte nicht geladen werden. Dein Fortschritt bleibt erhalten. Versuche es später erneut."}},
        "en": {"stringUnit": {"state": "translated", "value": "Couldn't read the Labyrinth map. Progress is preserved. Try again later."}},
        "es": {"stringUnit": {"state": "translated", "value": "No se pudo leer el mapa del Laberinto. El progreso se conserva. Vuelve a intentarlo más tarde."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Impossible de lire la carte du Labyrinthe. Votre progression est conservée. Réessayez plus tard."}},
        "ja": {"stringUnit": {"state": "translated", "value": "迷宮の地図を読み込めませんでした。進行状況は保持されています。後でもう一度お試しください。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "미궁 지도를 불러오지 못했습니다. 진행도는 보존되어 있습니다. 나중에 다시 시도하세요."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Não foi possível ler o mapa do Labirinto. Seu progresso foi preservado. Tente mais tarde."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法讀取迷宮地圖，進度已保留，請稍後再試。"}}
      }
    },
