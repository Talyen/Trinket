    "talents.bear_physical_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: bear_physical_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dein erster <keyword id=\"physical\">physischer</keyword> Angriff in jedem Zug erhält die Hälfte deines <keyword id=\"block\">Blocks</keyword> als Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your first <keyword id=\"physical\">Physical</keyword> attack each turn gains half your <keyword id=\"block\">Block</keyword> as damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu primer ataque <keyword id=\"physical\">físico</keyword> de cada turno obtiene la mitad de tu <keyword id=\"block\">Bloqueo</keyword> como daño"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre première attaque de type <keyword id=\"physical\">Physique</keyword> de chaque tour ajoute la moitié de votre <keyword id=\"block\">Blocage</keyword> à ses dégâts"}},
        "ja": {"stringUnit": {"state": "translated", "value": "各ターンで最初の<keyword id=\"physical\">物理</keyword>攻撃に、自分の<keyword id=\"block\">ブロック</keyword>の半分をダメージとして追加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "매 턴 첫 <keyword id=\"physical\">물리</keyword> 공격이 내 <keyword id=\"block\">방어도</keyword>의 절반만큼 추가 피해"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seu primeiro ataque <keyword id=\"physical\">Físico</keyword> de cada turno ganha metade do seu <keyword id=\"block\">Bloqueio</keyword> como dano"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每回合首次<keyword id=\"physical\">物理</keyword>攻擊增加相當於自身<keyword id=\"block\">格擋</keyword>一半的傷害"}}
      }
    },
    "talents.bear_physical_t4_1.name": {
      "comment": "ContentManifest/talents.tsv: bear_physical_t4_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Rammbock"}},
        "en": {"stringUnit": {"state": "translated", "value": "Battering Ram"}},
        "es": {"stringUnit": {"state": "translated", "value": "Ariete"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Bélier"}},
        "ja": {"stringUnit": {"state": "translated", "value": "破城槌"}},
        "ko": {"stringUnit": {"state": "translated", "value": "공성추"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Aríete"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "攻城錘"}}
      }
    },
    "talents.bear_stun_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: bear_stun_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dein erster <keyword id=\"stun\">Betäubungs</keyword>-Angriff in jedem Zug verursacht <value id=\"quantity_1\">%1$lld</value> zusätzlichen Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your first <keyword id=\"stun\">Stun</keyword> attack each turn deals <value id=\"quantity_1\">%1$lld</value> additional damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu primer ataque de <keyword id=\"stun\">Aturdimiento</keyword> de cada turno inflige <value id=\"quantity_1\">%1$lld</value> de daño adicional"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre première attaque d’<keyword id=\"stun\">Étourdissement</keyword> de chaque tour inflige <value id=\"quantity_1\">%1$lld</value> dégâts supplémentaires"}},
        "ja": {"stringUnit": {"state": "translated", "value": "各ターンで最初の<keyword id=\"stun\">スタン</keyword>攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "매 턴 첫 <keyword id=\"stun\">기절</keyword> 공격의 추가 피해 <value id=\"quantity_1\">%1$lld</value>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seu primeiro ataque de <keyword id=\"stun\">Atordoamento</keyword> de cada turno causa <value id=\"quantity_1\">%1$lld</value> de dano adicional"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每回合首次<keyword id=\"stun\">暈眩</keyword>攻擊額外造成<value id=\"quantity_1\">%1$lld</value>點傷害"}}
      }
    },
    "talents.bear_stun_t1_1.name": {
      "comment": "ContentManifest/talents.tsv: bear_stun_t1_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Bodenschlag"}},
        "en": {"stringUnit": {"state": "translated", "value": "Ground Slam"}},
        "es": {"stringUnit": {"state": "translated", "value": "Golpe al suelo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Frappe au sol"}},
        "ja": {"stringUnit": {"state": "translated", "value": "地面叩き"}},
        "ko": {"stringUnit": {"state": "translated", "value": "지면 강타"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Pancada no Chão"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "撼地猛擊"}}
      }
    },
    "talents.bear_stun_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: bear_stun_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">Physische</keyword> Angriffe haben eine Chance von <value id=\"quantity_1\">%1$lld</value>%%, <value id=\"quantity_2\">%2$lld</value> <keyword id=\"stun\">Betäubungs</keyword>aufbau zu verursachen"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">Physical</keyword> attacks have a <value id=\"quantity_1\">%1$lld</value>%% chance to apply <value id=\"quantity_2\">%2$lld</value> <keyword id=\"stun\">Stun</keyword> build-up"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques <keyword id=\"physical\">físicos</keyword> tienen un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de aplicar <value id=\"quantity_2\">%2$lld</value> de acumulación de <keyword id=\"stun\">Aturdimiento</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques <keyword id=\"physical\">physiques</keyword> ont <value id=\"quantity_1\">%1$lld</value>%% de chances d’ajouter <value id=\"quantity_2\">%2$lld</value> points à la jauge d’<keyword id=\"stun\">Étourdissement</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">物理</keyword>攻撃は<value id=\"quantity_1\">%1$lld</value>%%の確率で<keyword id=\"stun\">スタン</keyword>蓄積値を<value id=\"quantity_2\">%2$lld</value>増やす"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">물리</keyword> 공격은 <value id=\"quantity_1\">%1$lld</value>%% 확률로 <value id=\"quantity_2\">%2$lld</value>의 <keyword id=\"stun\">기절</keyword> 축적을 부여합니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques <keyword id=\"physical\">Físicos</keyword> têm <value id=\"quantity_1\">%1$lld</value>%% de chance de aplicar <value id=\"quantity_2\">%2$lld</value> de acúmulo de <keyword id=\"stun\">Atordoamento</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">物理</keyword>攻擊有<value id=\"quantity_1\">%1$lld</value>%%的機率累積<value id=\"quantity_2\">%2$lld</value>點<keyword id=\"stun\">暈眩</keyword>"}}
      }
    },
    "talents.bear_stun_t1_2.name": {
      "comment": "ContentManifest/talents.tsv: bear_stun_t1_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Betäubender Prankenhieb"}},
        "en": {"stringUnit": {"state": "translated", "value": "Dazing Swipe"}},
        "es": {"stringUnit": {"state": "translated", "value": "Zarpazo aturdidor"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Griffure hébétante"}},
        "ja": {"stringUnit": {"state": "translated", "value": "眩惑の薙ぎ払い"}},
        "ko": {"stringUnit": {"state": "translated", "value": "어지러운 할퀴기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Patada Atordoante"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "暈眩揮擊"}}
      }
    },
    "talents.bear_stun_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: bear_stun_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">Betäubungs</keyword>-Angriffe ignorieren die Hälfte des gegnerischen <keyword id=\"block\">Blocks</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">Stun</keyword> attacks ignore half enemy <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques de <keyword id=\"stun\">Aturdimiento</keyword> ignoran la mitad del <keyword id=\"block\">Bloqueo</keyword> del enemigo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques d’<keyword id=\"stun\">Étourdissement</keyword> ignorent la moitié du <keyword id=\"block\">Blocage</keyword> ennemi"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">スタン</keyword>攻撃が敵の<keyword id=\"block\">ブロック</keyword>を半分無視"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">기절</keyword> 공격이 적의 <keyword id=\"block\">방어도</keyword> 절반 무시"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques de <keyword id=\"stun\">Atordoamento</keyword> ignoram metade do <keyword id=\"block\">Bloqueio</keyword> inimigo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">暈眩</keyword>攻擊無視敵人一半<keyword id=\"block\">格擋</keyword>"}}
      }
    },
    "talents.bear_stun_t2_1.name": {
      "comment": "ContentManifest/talents.tsv: bear_stun_t2_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Schockwelle"}},
        "en": {"stringUnit": {"state": "translated", "value": "Shockwave"}},
        "es": {"stringUnit": {"state": "translated", "value": "Onda de choque"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Onde de choc"}},
        "ja": {"stringUnit": {"state": "translated", "value": "衝撃波"}},
        "ko": {"stringUnit": {"state": "translated", "value": "충격파"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Onda de Choque"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "衝擊波"}}
      }
    },
    "talents.bear_stun_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: bear_stun_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">Betäubung</keyword> hält mit <value id=\"quantity_1\">%1$lld</value>%% Chance einen weiteren Zug an"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">Stun</keyword> has a <value id=\"quantity_1\">%1$lld</value>%% chance to last another turn"}},
        "es": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">Aturdimiento</keyword> tiene un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de durar otro turno"}},
        "fr": {"stringUnit": {"state": "translated", "value": "L’<keyword id=\"stun\">Étourdissement</keyword> a <value id=\"quantity_1\">%1$lld</value>%% de chances de durer un tour de plus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">スタン</keyword>が<value id=\"quantity_1\">%1$lld</value>%%の確率でさらに1ターン持続"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">기절</keyword>이 <value id=\"quantity_1\">%1$lld</value>%% 확률로 1턴 더 지속"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">Atordoamento</keyword> tem <value id=\"quantity_1\">%1$lld</value>%% de chance de durar mais um turno"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">暈眩</keyword>有<value id=\"quantity_1\">%1$lld</value>%%機率再持續一回合"}}
      }
    },
    "talents.bear_stun_t2_2.name": {
      "comment": "ContentManifest/talents.tsv: bear_stun_t2_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Tiefe <keyword id=\"stun\">Betäubung</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Deep <keyword id=\"stun\">Stun</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">Aturdimiento</keyword> profundo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">Étourdissement</keyword> profond"}},
        "ja": {"stringUnit": {"state": "translated", "value": "深い<keyword id=\"stun\">スタン</keyword>"}},
        "ko": {"stringUnit": {"state": "translated", "value": "깊은 <keyword id=\"stun\">기절</keyword>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">Atordoamento</keyword> Profundo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "深度<keyword id=\"stun\">暈眩</keyword>"}}
      }
    },
    "talents.bear_stun_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: bear_stun_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">Betäubte</keyword> Gegner erleiden <value id=\"quantity_1\">%1$lld</value>%% mehr Schaden durch deinen Verbündeten"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">Stunned</keyword> enemies take <value id=\"quantity_1\">%1$lld</value>%% more damage from your ally"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los enemigos <keyword id=\"stun\">aturdidos</keyword> reciben un <value id=\"quantity_1\">%1$lld</value>%% más de daño de tu aliado"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les ennemis sous <keyword id=\"stun\">Étourdissement</keyword> subissent <value id=\"quantity_1\">%1$lld</value>%% de dégâts en plus de votre allié"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">スタン</keyword>状態の敵が自分の味方から受けるダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">기절</keyword> 상태의 적이 아군에게 받는 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Inimigos <keyword id=\"stun\">Atordoados</keyword> recebem <value id=\"quantity_1\">%1$lld</value>%% mais dano do seu aliado"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">暈眩</keyword>的敵人受到你的友方造成的傷害增加<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.bear_stun_t3_1.name": {
      "comment": "ContentManifest/talents.tsv: bear_stun_t3_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Entblößte Beute"}},
        "en": {"stringUnit": {"state": "translated", "value": "Exposed Prey"}},
        "es": {"stringUnit": {"state": "translated", "value": "Presa expuesta"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Proie exposée"}},
        "ja": {"stringUnit": {"state": "translated", "value": "無防備な獲物"}},
        "ko": {"stringUnit": {"state": "translated", "value": "빈틈 보인 먹잇감"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Presa Exposta"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "暴露獵物"}}
      }
    },
    "talents.bear_stun_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: bear_stun_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Unter halber <keyword id=\"health\">Gesundheit</keyword> steigt dein <keyword id=\"stun\">Betäubungs</keyword>aufbau um <value id=\"quantity_1\">%1$lld</value>%%"}},
        "en": {"stringUnit": {"state": "translated", "value": "Below half <keyword id=\"health\">Health</keyword>, your <keyword id=\"stun\">Stun</keyword> build-up increases by <value id=\"quantity_1\">%1$lld</value>%%"}},
        "es": {"stringUnit": {"state": "translated", "value": "Por debajo de la mitad de <keyword id=\"health\">Salud</keyword>, tu acumulación de <keyword id=\"stun\">Aturdimiento</keyword> aumenta en un <value id=\"quantity_1\">%1$lld</value>%%"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Sous la moitié de votre <keyword id=\"health\">Santé</keyword>, votre accumulation d’<keyword id=\"stun\">Étourdissement</keyword> augmente de <value id=\"quantity_1\">%1$lld</value>%%"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>が半分未満なら、自分の<keyword id=\"stun\">スタン</keyword>蓄積量が<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword>이 절반 미만이면 내 <keyword id=\"stun\">기절</keyword> 축적량 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Abaixo de metade da <keyword id=\"health\">Vida</keyword>, seu acúmulo de <keyword id=\"stun\">Atordoamento</keyword> aumenta em <value id=\"quantity_1\">%1$lld</value>%%"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">生命值</keyword>低於一半時，自身<keyword id=\"stun\">暈眩</keyword>累積量增加<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.bear_stun_t3_2.name": {
      "comment": "ContentManifest/talents.tsv: bear_stun_t3_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erdbebenbrüllen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Seismic Roar"}},
        "es": {"stringUnit": {"state": "translated", "value": "Rugido sísmico"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Rugissement sismique"}},
        "ja": {"stringUnit": {"state": "translated", "value": "大地を揺らす咆哮"}},
        "ko": {"stringUnit": {"state": "translated", "value": "지진의 포효"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Rugido Sísmico"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "撼地咆哮"}}
      }
    },
    "talents.bear_stun_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: bear_stun_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wenn dein <keyword id=\"block\">Block</keyword> durchbrochen wird, wirf den absorbierten Schaden als <keyword id=\"stun\">Betäubungs</keyword>schaden zurück"}},
        "en": {"stringUnit": {"state": "translated", "value": "When your <keyword id=\"block\">Block</keyword> breaks, return absorbed damage as <keyword id=\"stun\">Stun</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Cuando se rompe tu <keyword id=\"block\">Bloqueo</keyword>, devuelve el daño absorbido como <keyword id=\"stun\">Aturdimiento</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Lorsque votre <keyword id=\"block\">Blocage</keyword> est brisé, renvoyez les dégâts absorbés en dégâts d’<keyword id=\"stun\">Étourdissement</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "自分の<keyword id=\"block\">ブロック</keyword>が崩れると、吸収したダメージを<keyword id=\"stun\">スタン</keyword>として返す"}},
        "ko": {"stringUnit": {"state": "translated", "value": "내 <keyword id=\"block\">방어도</keyword>가 깨지면 흡수한 피해를 <keyword id=\"stun\">기절</keyword>로 되돌림"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Quando seu <keyword id=\"block\">Bloqueio</keyword> quebrar, devolva o dano absorvido como <keyword id=\"stun\">Atordoamento</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "自身<keyword id=\"block\">格擋</keyword>被擊破時，將吸收的傷害以<keyword id=\"stun\">暈眩</keyword>返還"}}
      }
    },
