        "ja": {"stringUnit": {"state": "translated", "value": "残る祝福"}},
        "ko": {"stringUnit": {"state": "translated", "value": "지속되는 축복"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Bênção Persistente"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "持續祝福"}}
