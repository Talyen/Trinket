    "talents.alchemist_health_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: alchemist_health_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Die Hälfte deiner überschüssigen Heilung wird für den Empfänger zu <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Half your excess healing becomes <keyword id=\"block\">Block</keyword> for its recipient"}},
        "es": {"stringUnit": {"state": "translated", "value": "La mitad de tu curación sobrante se convierte en <keyword id=\"block\">Bloqueo</keyword> para su receptor"}},
        "fr": {"stringUnit": {"state": "translated", "value": "La moitié de vos soins excédentaires devient du <keyword id=\"block\">Blocage</keyword> pour le bénéficiaire"}},
        "ja": {"stringUnit": {"state": "translated", "value": "過剰回復量の半分を、回復対象の<keyword id=\"block\">ブロック</keyword>に変換"}},
        "ko": {"stringUnit": {"state": "translated", "value": "초과 치유량의 절반을 치유 대상의 <keyword id=\"block\">방어도</keyword>로 전환"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Metade da sua cura excedente se torna <keyword id=\"block\">Bloqueio</keyword> para quem a recebe"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "將自身過量治療的一半轉為受治者的<keyword id=\"block\">格擋</keyword>"}}
      }
    },
    "talents.alchemist_health_t2_2.name": {
      "comment": "ContentManifest/talents.tsv: alchemist_health_t2_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Rückgewonnene Reagenzien"}},
        "en": {"stringUnit": {"state": "translated", "value": "Reclaimed Reagents"}},
        "es": {"stringUnit": {"state": "translated", "value": "Reactivos recuperados"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Réactifs récupérés"}},
        "ja": {"stringUnit": {"state": "translated", "value": "再利用の試薬"}},
        "ko": {"stringUnit": {"state": "translated", "value": "재활용 시약"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Reagentes Recuperados"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "回收試劑"}}
      }
    },
    "talents.alchemist_health_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: alchemist_health_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Deine überschüssige Heilung stellt <keyword id=\"health\">Gesundheit</keyword> beim Partner des Empfängers wieder her"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your excess healing restores <keyword id=\"health\">Health</keyword> to the recipient’s partner"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu curación sobrante restaura <keyword id=\"health\">Salud</keyword> al compañero del receptor"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Vos soins excédentaires restaurent la <keyword id=\"health\">Santé</keyword> du partenaire du bénéficiaire"}},
        "ja": {"stringUnit": {"state": "translated", "value": "自分の過剰回復で、回復対象の相棒の<keyword id=\"health\">体力</keyword>を回復"}},
        "ko": {"stringUnit": {"state": "translated", "value": "초과 치유량만큼 치유 대상의 파트너의 <keyword id=\"health\">체력</keyword> 회복"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Sua cura excedente restaura a <keyword id=\"health\">Vida</keyword> do parceiro de quem a recebe"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "自身過量治療會恢復受治者搭檔的<keyword id=\"health\">生命值</keyword>"}}
      }
    },
    "talents.alchemist_health_t3_1.name": {
      "comment": "ContentManifest/talents.tsv: alchemist_health_t3_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Geteiltes Rezept"}},
        "en": {"stringUnit": {"state": "translated", "value": "Shared Prescription"}},
        "es": {"stringUnit": {"state": "translated", "value": "Receta compartida"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Ordonnance partagée"}},
        "ja": {"stringUnit": {"state": "translated", "value": "分かち合う処方"}},
        "ko": {"stringUnit": {"state": "translated", "value": "공유 처방"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Receita Compartilhada"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "共享處方"}}
      }
    },
    "talents.alchemist_health_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: alchemist_health_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Wiederherstellen von <keyword id=\"health\">Gesundheit</keyword> fügt deinem nächsten <keyword id=\"poison\">Gift</keyword>-Angriff <value id=\"quantity_1\">%1$lld</value> Schaden hinzu"}},
        "en": {"stringUnit": {"state": "translated", "value": "Restoring <keyword id=\"health\">Health</keyword> adds <value id=\"quantity_1\">%1$lld</value> damage to your next <keyword id=\"poison\">Poison</keyword> attack"}},
        "es": {"stringUnit": {"state": "translated", "value": "Restaurar <keyword id=\"health\">Salud</keyword> añade <value id=\"quantity_1\">%1$lld</value> de daño a tu siguiente ataque de <keyword id=\"poison\">Veneno</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Restaurer de la <keyword id=\"health\">Santé</keyword> ajoute <value id=\"quantity_1\">%1$lld</value> dégâts à votre prochaine attaque de <keyword id=\"poison\">Poison</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>を回復すると、次の<keyword id=\"poison\">毒</keyword>攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword> 회복 시 다음 <keyword id=\"poison\">독</keyword> 공격의 피해 <value id=\"quantity_1\">%1$lld</value> 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Restaurar <keyword id=\"health\">Vida</keyword> adiciona <value id=\"quantity_1\">%1$lld</value> de dano ao seu próximo ataque de <keyword id=\"poison\">Veneno</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "恢復<keyword id=\"health\">生命值</keyword>時，下次<keyword id=\"poison\">中毒</keyword>攻擊的傷害增加<value id=\"quantity_1\">%1$lld</value>點"}}
      }
    },
    "talents.alchemist_health_t3_2.name": {
      "comment": "ContentManifest/talents.tsv: alchemist_health_t3_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Flüchtige Arznei"}},
        "en": {"stringUnit": {"state": "translated", "value": "Volatile Remedy"}},
