    "talents.phoenix_burn_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: phoenix_burn_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Brand</keyword>-Angriffe gewähren mit <value id=\"quantity_1\">%1$lld</value>%% Chance <value id=\"quantity_2\">%2$lld</value> <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Burn</keyword> attacks have a <value id=\"quantity_1\">%1$lld</value>%% chance to grant <value id=\"quantity_2\">%2$lld</value> <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques de <keyword id=\"burn\">Quemadura</keyword> tienen un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de otorgar <value id=\"quantity_2\">%2$lld</value> de <keyword id=\"block\">Bloqueo</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques de <keyword id=\"burn\">Brûlure</keyword> ont <value id=\"quantity_1\">%1$lld</value>%% de chances d’octroyer <value id=\"quantity_2\">%2$lld</value> <keyword id=\"block\">Blocage</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">炎上</keyword>攻撃が<value id=\"quantity_1\">%1$lld</value>%%の確率で<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_2\">%2$lld</value>付与"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">화상</keyword> 공격 시 <value id=\"quantity_1\">%1$lld</value>%% 확률로 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_2\">%2$lld</value> 획득"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques de <keyword id=\"burn\">Queimadura</keyword> têm <value id=\"quantity_1\">%1$lld</value>%% de chance de conceder <value id=\"quantity_2\">%2$lld</value> de <keyword id=\"block\">Bloqueio</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">燃燒</keyword>攻擊有<value id=\"quantity_1\">%1$lld</value>%%機率賦予<value id=\"quantity_2\">%2$lld</value>點<keyword id=\"block\">格擋</keyword>"}}
      }
    },
