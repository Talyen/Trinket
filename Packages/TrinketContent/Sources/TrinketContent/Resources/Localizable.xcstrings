    },
    "traits.radiant_judgment.description": {
      "comment": "ContentManifest/traits.tsv: radiant_judgment, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verursacht jeden zweiten Zug bei beiden Verbündeten jeweils <value id=\"quantity_1\">%1$lld</value> Schaden vom Typ <keyword id=\"holy\">Heilig</keyword>."}},
        "en": {"stringUnit": {"state": "translated", "value": "Deals <value id=\"quantity_1\">%1$lld</value> <keyword id=\"holy\">Holy</keyword> damage to both allies every other turn."}},
        "es": {"stringUnit": {"state": "translated", "value": "Inflige <value id=\"quantity_1\">%1$lld</value> de daño <keyword id=\"holy\">Sagrado</keyword> a cada uno de los dos aliados cada dos turnos."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Inflige <value id=\"quantity_1\">%1$lld</value> de dégâts de type <keyword id=\"holy\">Sacré</keyword> à chacun des deux alliés, un tour sur deux."}},
        "ja": {"stringUnit": {"state": "translated", "value": "1ターンおきに味方2人それぞれに<keyword id=\"holy\">聖</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "한 턴 걸러 아군 둘에게 각각 <keyword id=\"holy\">신성</keyword> 피해를 <value id=\"quantity_1\">%1$lld</value> 준다."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Causa <value id=\"quantity_1\">%1$lld</value> de dano <keyword id=\"holy\">Sagrado</keyword> a cada um dos dois aliados a cada dois turnos."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每隔一回合對兩名盟友各造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"holy\">神聖</keyword>傷害。"}}
      }
    },
    "traits.radiant_judgment.name": {
      "comment": "ContentManifest/traits.tsv: radiant_judgment, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Strahlendes Urteil"}},
        "en": {"stringUnit": {"state": "translated", "value": "Radiant Judgment"}},
        "es": {"stringUnit": {"state": "translated", "value": "Juicio radiante"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Jugement radieux"}},
        "ja": {"stringUnit": {"state": "translated", "value": "光輝の裁き"}},
        "ko": {"stringUnit": {"state": "translated", "value": "빛나는 심판"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Julgamento Radiante"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "光輝審判"}}
      }
    },
    "traits.reckless.description": {
      "comment": "ContentManifest/traits.tsv: reckless, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erlittener Schaden vom Typ <keyword id=\"physical\">Physisch</keyword> um <value id=\"quantity_1\">%1$lld</value> %% erhöht"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">Physical</keyword> damage taken increased by <value id=\"quantity_1\">%1$lld</value>%%"}},
        "es": {"stringUnit": {"state": "translated", "value": "El daño <keyword id=\"physical\">Físico</keyword> recibido aumenta un <value id=\"quantity_1\">%1$lld</value> %%"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les dégâts de type <keyword id=\"physical\">Physique</keyword> subis augmentent de <value id=\"quantity_1\">%1$lld</value> %%"}},
        "ja": {"stringUnit": {"state": "translated", "value": "受ける<keyword id=\"physical\">物理</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "받는 <keyword id=\"physical\">물리</keyword> 피해가 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O dano <keyword id=\"physical\">Físico</keyword> recebido aumenta em <value id=\"quantity_1\">%1$lld</value>%%"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "受到的<keyword id=\"physical\">物理</keyword>傷害提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "traits.reckless.name": {
      "comment": "ContentManifest/traits.tsv: reckless, name",
