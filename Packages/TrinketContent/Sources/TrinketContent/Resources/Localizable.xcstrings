    "affixes.companions_collar.astral_description": {
      "comment": "ContentManifest/affixes.tsv: companions_collar, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal pro Zug: Wenn du deinen Gefährten heilst, ziehe eine Gefährtenkarte"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once per turn, healing your Companion draws a Companion card"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois par tour, soigner votre Compagnon fait piocher une carte de Compagnon"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1ターンに1回、仲間を回復すると仲間のカードを1枚引く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "턴마다 한 번, 동료를 치유하면 동료 카드 한 장 뽑기"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每回合一次，治療夥伴時抽一張夥伴牌"
          }
        }
      }
    },
