        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword>이 절반 미만일 때 아군 공격 피해의 <value id=\"quantity_1\">%1$lld</value>%%만큼 <keyword id=\"health\">체력</keyword> 회복"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Com menos da metade da sua <keyword id=\"health\">Vida</keyword>, restaure <keyword id=\"health\">Vida</keyword> igual a <value id=\"quantity_1\">%1$lld</value>%% do dano de ataque do seu aliado"}},
