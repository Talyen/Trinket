    "talents.ranger_burn_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: ranger_burn_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Brennende</keyword> Gegner erhalten <value id=\"quantity_1\">%1$lld</value>%% weniger <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Burning</keyword> enemies gain <value id=\"quantity_1\">%1$lld</value>%% less <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los enemigos con <keyword id=\"burn\">Quemadura</keyword> obtienen un <value id=\"quantity_1\">%1$lld</value>%% menos de <keyword id=\"block\">Bloqueo</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les ennemis sous <keyword id=\"burn\">Brûlure</keyword> gagnent <value id=\"quantity_1\">%1$lld</value>%% de <keyword id=\"block\">Blocage</keyword> en moins"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">炎上</keyword>状態の敵の<keyword id=\"block\">ブロック</keyword>獲得量が<value id=\"quantity_1\">%1$lld</value>%%減少"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">화상</keyword> 상태의 적의 <keyword id=\"block\">방어도</keyword> 획득량 <value id=\"quantity_1\">%1$lld</value>%% 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Inimigos <keyword id=\"burn\">Em Chamas</keyword> ganham <value id=\"quantity_1\">%1$lld</value>%% menos <keyword id=\"block\">Bloqueio</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">燃燒</keyword>中的敵人獲得的<keyword id=\"block\">格擋</keyword>減少<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
