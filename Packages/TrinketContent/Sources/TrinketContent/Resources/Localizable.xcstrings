    "talents.druid_poison_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: druid_poison_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Bei <keyword id=\"poison\">vergifteten</keyword> Gegnern steigt der <keyword id=\"stun\">Betäubungs</keyword>aufbau um <value id=\"quantity_1\">%1$lld</value>%%"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Poisoned</keyword> enemies take <value id=\"quantity_1\">%1$lld</value>%% more <keyword id=\"stun\">Stun</keyword> build-up"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los enemigos <keyword id=\"poison\">envenenados</keyword> reciben un <value id=\"quantity_1\">%1$lld</value>%% más de acumulación de <keyword id=\"stun\">Aturdimiento</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les ennemis sous <keyword id=\"poison\">Poison</keyword> subissent <value id=\"quantity_1\">%1$lld</value>%% d’accumulation d’<keyword id=\"stun\">Étourdissement</keyword> en plus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">毒</keyword>状態の敵の<keyword id=\"stun\">スタン</keyword>蓄積量が<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">독</keyword> 상태의 적에게 쌓이는 <keyword id=\"stun\">기절</keyword> <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Inimigos <keyword id=\"poison\">Envenenados</keyword> recebem <value id=\"quantity_1\">%1$lld</value>%% mais acúmulo de <keyword id=\"stun\">Atordoamento</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">中毒</keyword>的敵人承受的<keyword id=\"stun\">暈眩</keyword>累積量增加<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.druid_poison_t3_2.name": {
      "comment": "ContentManifest/talents.tsv: druid_poison_t3_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Umschlingendes Wachstum"}},
        "en": {"stringUnit": {"state": "translated", "value": "Entangling Growth"}},
