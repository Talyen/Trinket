    "talents.rogue_bleed_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: rogue_bleed_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">Blutung</keyword> ignoriert gegnerischen <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">Bleed</keyword> ignores enemy <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">Sangrado</keyword> ignora el <keyword id=\"block\">Bloqueo</keyword> del enemigo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le <keyword id=\"bleed\">Saignement</keyword> ignore le <keyword id=\"block\">Blocage</keyword> ennemi"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">出血</keyword>が敵の<keyword id=\"block\">ブロック</keyword>を無視"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">출혈</keyword>이 적의 <keyword id=\"block\">방어도</keyword> 무시"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">Sangramento</keyword> ignora o <keyword id=\"block\">Bloqueio</keyword> inimigo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">流血</keyword>無視敵人<keyword id=\"block\">格擋</keyword>"}}
      }
    },
    "talents.rogue_bleed_t1_2.name": {
      "comment": "ContentManifest/talents.tsv: rogue_bleed_t1_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Tiefe Wunden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Deep Wounds"}},
        "es": {"stringUnit": {"state": "translated", "value": "Heridas profundas"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Plaies profondes"}},
        "ja": {"stringUnit": {"state": "translated", "value": "深い傷"}},
        "ko": {"stringUnit": {"state": "translated", "value": "깊은 상처"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Feridas Profundas"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "深度創傷"}}
      }
