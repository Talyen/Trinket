    "talents.shield_scarab_holy_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: shield_scarab_holy_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kritische <keyword id=\"holy\">heilige</keyword> Treffer verringern die Treffergenauigkeit des nächsten gegnerischen Angriffs um <value id=\"quantity_1\">%1$lld</value>%%"
          }
