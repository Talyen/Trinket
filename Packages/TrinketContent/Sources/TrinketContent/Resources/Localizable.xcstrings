    "talents.warlock_burn_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: warlock_burn_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">Brennende</keyword> Gegner stellen halb so viel <keyword id=\"health\">Gesundheit</keyword> wieder her"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">Burning</keyword> enemies restore half as much <keyword id=\"health\">Health</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les ennemis sous <keyword id=\"burn\">Brûlure</keyword> restaurent moitié moins de <keyword id=\"health\">Santé</keyword>"
          }
        },
