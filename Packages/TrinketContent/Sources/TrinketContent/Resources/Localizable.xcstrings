    "talents.golden_retriever_gold_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: golden_retriever_gold_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Stiehl <value id=\"quantity_1\">%1$lld</value> zusätzliches <keyword id=\"gold\">Gold</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Steal <value id=\"quantity_1\">%1$lld</value> additional <keyword id=\"gold\">Gold</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Roba <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"gold\">Oro</keyword> adicional"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Volez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Or</keyword> de plus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "盗む<keyword id=\"gold\">ゴールド</keyword>が<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"gold\">골드</keyword> <value id=\"quantity_1\">%1$lld</value> 추가 훔치기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Roube <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"gold\">Ouro</keyword> adicional"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "額外偷取<value id=\"quantity_1\">%1$lld</value><keyword id=\"gold\">金幣</keyword>"}}
      }
    },
    "talents.golden_retriever_gold_t2_1.name": {
      "comment": "ContentManifest/talents.tsv: golden_retriever_gold_t2_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Feilscher"}},
        "en": {"stringUnit": {"state": "translated", "value": "Haggler"}},
        "es": {"stringUnit": {"state": "translated", "value": "Regateador"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Marchandeur"}},
        "ja": {"stringUnit": {"state": "translated", "value": "値切り上手"}},
        "ko": {"stringUnit": {"state": "translated", "value": "흥정꾼"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Pechincheiro"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "議價高手"}}
      }
    },
    "talents.golden_retriever_gold_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: golden_retriever_gold_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Stehlen von <keyword id=\"gold\">Gold</keyword> erhöht deinen nächsten Erhalt von <keyword id=\"block\">Block</keyword> um <value id=\"quantity_1\">%1$lld</value>%%"}},
        "en": {"stringUnit": {"state": "translated", "value": "Stealing <keyword id=\"gold\">Gold</keyword> increases your next <keyword id=\"block\">Block</keyword> gain by <value id=\"quantity_1\">%1$lld</value>%%"}},
        "es": {"stringUnit": {"state": "translated", "value": "Robar <keyword id=\"gold\">Oro</keyword> aumenta tu siguiente obtención de <keyword id=\"block\">Bloqueo</keyword> en un <value id=\"quantity_1\">%1$lld</value>%%"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Voler de l’<keyword id=\"gold\">Or</keyword> augmente votre prochain gain de <keyword id=\"block\">Blocage</keyword> de <value id=\"quantity_1\">%1$lld</value>%%"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"gold\">ゴールド</keyword>を盗むと、次の<keyword id=\"block\">ブロック</keyword>獲得量が<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"gold\">골드</keyword>를 훔치면 다음 <keyword id=\"block\">방어도</keyword> 획득량 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Roubar <keyword id=\"gold\">Ouro</keyword> aumenta seu próximo ganho de <keyword id=\"block\">Bloqueio</keyword> em <value id=\"quantity_1\">%1$lld</value>%%"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "偷取<keyword id=\"gold\">金幣</keyword>後，下次獲得的<keyword id=\"block\">格擋</keyword>增加<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.golden_retriever_gold_t2_2.name": {
      "comment": "ContentManifest/talents.tsv: golden_retriever_gold_t2_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Goldener Schutz"}},
        "en": {"stringUnit": {"state": "translated", "value": "Golden Guard"}},
        "es": {"stringUnit": {"state": "translated", "value": "Guardia dorada"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Garde dorée"}},
        "ja": {"stringUnit": {"state": "translated", "value": "黄金の守り"}},
        "ko": {"stringUnit": {"state": "translated", "value": "황금 수호"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Guarda Dourada"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "黃金守護"}}
      }
    },
    "talents.golden_retriever_gold_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: golden_retriever_gold_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dein erster <keyword id=\"gold\">Gold</keyword>-Diebstahl in jedem Kampf lässt dich eine Karte ziehen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your first <keyword id=\"gold\">Gold</keyword> steal each combat draws a card"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu primer robo de <keyword id=\"gold\">Oro</keyword> de cada combate hace que robes una carta"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre premier vol d’<keyword id=\"gold\">Or</keyword> de chaque combat fait piocher une carte"}},
        "ja": {"stringUnit": {"state": "translated", "value": "各戦闘で初めて<keyword id=\"gold\">ゴールド</keyword>を盗むと、カードを1枚引く"}},
        "ko": {"stringUnit": {"state": "translated", "value": "매 전투 첫 <keyword id=\"gold\">골드</keyword> 훔치기 시 카드 한 장 뽑기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seu primeiro roubo de <keyword id=\"gold\">Ouro</keyword> de cada combate faz você comprar uma carta"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每場戰鬥首次偷取<keyword id=\"gold\">金幣</keyword>時，抽一張牌"}}
      }
    },
