      "comment": "ContentManifest/talents.tsv: golden_retriever_health_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"variations": {"plural": {"one": {"stringUnit": {"state": "translated", "value": "Das Wiederherstellen von <keyword id=\"health\">Gesundheit</keyword> reinigt auch <value id=\"quantity_1\">%1$lld</value> Schwächungseffekt"}}, "other": {"stringUnit": {"state": "translated", "value": "Das Wiederherstellen von <keyword id=\"health\">Gesundheit</keyword> reinigt auch <value id=\"quantity_1\">%1$lld</value> Schwächungseffekte"}}}}},
        "en": {"variations": {"plural": {"one": {"stringUnit": {"state": "translated", "value": "Restoring <keyword id=\"health\">Health</keyword> also Cleanses <value id=\"quantity_1\">%1$lld</value> debuff"}}, "other": {"stringUnit": {"state": "translated", "value": "Restoring <keyword id=\"health\">Health</keyword> also Cleanses <value id=\"quantity_1\">%1$lld</value> debuffs"}}}}},
        "es": {"variations": {"plural": {"many": {"stringUnit": {"state": "translated", "value": "Restaurar <keyword id=\"health\">Salud</keyword> también purifica <value id=\"quantity_1\">%1$lld</value> perjuicios"}}, "one": {"stringUnit": {"state": "translated", "value": "Restaurar <keyword id=\"health\">Salud</keyword> también purifica <value id=\"quantity_1\">%1$lld</value> perjuicio"}}, "other": {"stringUnit": {"state": "translated", "value": "Restaurar <keyword id=\"health\">Salud</keyword> también purifica <value id=\"quantity_1\">%1$lld</value> perjuicios"}}}}},
        "fr": {"variations": {"plural": {"many": {"stringUnit": {"state": "translated", "value": "Rendre de la <keyword id=\"health\">Santé</keyword> purifie aussi <value id=\"quantity_1\">%1$lld</value> malus"}}, "one": {"stringUnit": {"state": "translated", "value": "Rendre de la <keyword id=\"health\">Santé</keyword> purifie aussi <value id=\"quantity_1\">%1$lld</value> malus"}}, "other": {"stringUnit": {"state": "translated", "value": "Rendre de la <keyword id=\"health\">Santé</keyword> purifie aussi <value id=\"quantity_1\">%1$lld</value> malus"}}}}},
        "ja": {"variations": {"plural": {"other": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>を回復すると弱体効果も<value id=\"quantity_1\">%1$lld</value>個浄化"}}}}},
        "ko": {"variations": {"plural": {"other": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword> 회복 시 약화 효과 <value id=\"quantity_1\">%1$lld</value>개도 정화"}}}}},
        "pt-BR": {"variations": {"plural": {"many": {"stringUnit": {"state": "translated", "value": "Restaurar <keyword id=\"health\">Vida</keyword> também Purifica <value id=\"quantity_1\">%1$lld</value> efeitos negativos"}}, "one": {"stringUnit": {"state": "translated", "value": "Restaurar <keyword id=\"health\">Vida</keyword> também Purifica <value id=\"quantity_1\">%1$lld</value> efeito negativo"}}, "other": {"stringUnit": {"state": "translated", "value": "Restaurar <keyword id=\"health\">Vida</keyword> também Purifica <value id=\"quantity_1\">%1$lld</value> efeitos negativos"}}}}},
        "zh-Hant": {"variations": {"plural": {"other": {"stringUnit": {"state": "translated", "value": "恢復<keyword id=\"health\">生命值</keyword>時，也會淨化<value id=\"quantity_1\">%1$lld</value>項減益效果"}}}}}
      }
