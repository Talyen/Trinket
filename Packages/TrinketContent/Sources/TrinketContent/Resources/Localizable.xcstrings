    "authored.0208e3efa131750d": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/InventoryItem+Compatibility.swift: canonical numeric compatibility description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Kampf erhaltenes <keyword id=\"gold\">Gold</keyword> verstärkt deinen nächsten <keyword id=\"holy\">heiligen</keyword> Treffer einer manuell gespielten Karte um ebenso viel Schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"gold\">Gold</keyword> gained in combat adds equal damage to your next <keyword id=\"holy\">Holy</keyword> hit from a manually played card"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’<keyword id=\"gold\">Or</keyword> gagné en combat ajoute autant de dégâts à votre prochain impact de type <keyword id=\"holy\">Sacré</keyword> provenant d’une carte jouée manuellement"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "戦闘中に得た<keyword id=\"gold\">ゴールド</keyword>と同じ量だけ、手動で使ったカードによる次の<keyword id=\"holy\">聖</keyword>攻撃の命中ダメージが増加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전투에서 획득한 <keyword id=\"gold\">골드</keyword>만큼, 직접 사용한 카드의 다음 <keyword id=\"holy\">신성</keyword> 적중 피해 증가"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "戰鬥中獲得的<keyword id=\"gold\">金幣</keyword>，會使你以手動打出的卡牌造成的下一次<keyword id=\"holy\">神聖</keyword>傷害提高等量數值"
          }
        }
      }
    },
