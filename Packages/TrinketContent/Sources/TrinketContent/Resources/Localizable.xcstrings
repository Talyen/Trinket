    "authored.d8dc8b523964f2d6": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"holy\">Heiliger</keyword> Schaden baut <keyword id=\"stun\">Betäubung</keyword> auf und stiehlt <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Gold</keyword>, wenn er einen Gegner betäubt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"holy\">Holy</keyword> damage causes <keyword id=\"stun\">Stun</keyword> build-up and steals <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Gold</keyword> when it Stuns an enemy"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dégâts de type <keyword id=\"holy\">Sacré</keyword> accumulent de l’<keyword id=\"stun\">Étourdissement</keyword> et volent <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Or</keyword> lorsqu’ils étourdissent un ennemi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"holy\">聖</keyword>ダメージで<keyword id=\"stun\">スタン</keyword>を蓄積し、敵をスタン状態にすると<keyword id=\"gold\">ゴールド</keyword>を<value id=\"quantity_1\">%1$lld</value>盗む"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"holy\">신성</keyword> 피해가 <keyword id=\"stun\">기절</keyword>을 축적하며, 이로 적을 기절시키면 <keyword id=\"gold\">골드</keyword> <value id=\"quantity_1\">%1$lld</value> 훔치기"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"holy\">神聖</keyword>傷害會累積<keyword id=\"stun\">暈眩</keyword>，並在使敵人暈眩時偷取<value id=\"quantity_1\">%1$lld</value><keyword id=\"gold\">金幣</keyword>"
          }
        }
      }
    },
    "authored.d9cffbda49267e68": {
      "comment": "Packages/TrinketAppState/Sources/TrinketAppState/Play/Modes/SpiresPlayMode.swift: player-facing failure title",
