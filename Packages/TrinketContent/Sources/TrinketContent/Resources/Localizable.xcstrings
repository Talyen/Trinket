    "authored.67116b71a403b895": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Encounters/NodeModifierModels.swift: computed description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Gift</keyword>resistenz"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Poison</keyword> Resistance"}},
        "es": {"stringUnit": {"state": "translated", "value": "Resistencia a <keyword id=\"poison\">Veneno</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Résistance au type <keyword id=\"poison\">Poison</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">毒</keyword>耐性"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">독</keyword> 저항"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Resistência a <keyword id=\"poison\">Veneno</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">中毒</keyword>抗性"}}
      }
    },
    "authored.675d5c34d8158e0e": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wenn du <keyword id=\"dodge\">ausweichst</keyword>, ziehe und spiele sofort eine Karte\nBei einem kritischen Treffer wiederhole diesen Effekt"}},
        "en": {"stringUnit": {"state": "translated", "value": "When you <keyword id=\"dodge\">Dodge</keyword>, immediately draw and play a card\nIf it's a Critical Hit, repeat this effect"}},
        "es": {"stringUnit": {"state": "translated", "value": "Cuando activas <keyword id=\"dodge\">Evasión</keyword>, roba y juega inmediatamente una carta\nSi asesta un golpe crítico, repite este efecto"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Lors d’une <keyword id=\"dodge\">Esquive</keyword>, piochez et jouez immédiatement une carte\nSi c’est un coup critique, répétez cet effet"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"dodge\">回避</keyword>すると即座にカードを1枚引いて使う\nそれがクリティカルヒットなら、この効果を繰り返す"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"dodge\">회피</keyword> 시 즉시 카드 한 장을 뽑아 사용\n치명타이면 이 효과 반복"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ao usar <keyword id=\"dodge\">Esquiva</keyword>, compre e jogue uma carta imediatamente\nSe for um golpe crítico, repita este efeito"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"dodge\">閃避</keyword>時，立刻抽一張牌並打出\n若造成暴擊，重複此效果"}}
      }
    },
    "authored.680eb778440a9065": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog+Accessory.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Deine Angriffe gegen <keyword id=\"poison\">vergiftete</keyword> Gegner ignorieren <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your attacks against <keyword id=\"poison\">Poisoned</keyword> enemies ignore <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tus ataques contra enemigos <keyword id=\"poison\">envenenados</keyword> ignoran <keyword id=\"block\">Bloqueo</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Vos attaques contre les ennemis sous <keyword id=\"poison\">Poison</keyword> ignorent le <keyword id=\"block\">Blocage</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">毒</keyword>状態の敵への自分の攻撃が<keyword id=\"block\">ブロック</keyword>を無視"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">독</keyword> 상태의 적을 공격하면 <keyword id=\"block\">방어도</keyword> 무시"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seus ataques contra inimigos <keyword id=\"poison\">Envenenados</keyword> ignoram <keyword id=\"block\">Bloqueio</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "自身對<keyword id=\"poison\">中毒</keyword>敵人的攻擊無視<keyword id=\"block\">格擋</keyword>"}}
      }
    },
