    "talents.druid_poison_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: druid_poison_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"thorns\">Dornen</keyword> verursachen einmal pro Zug <value id=\"quantity_1\">%1$lld</value> zusätzlichen <keyword id=\"poison\">Gift</keyword>schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"thorns\">Thorns</keyword> deal <value id=\"quantity_1\">%1$lld</value> bonus <keyword id=\"poison\">Poison</keyword> damage once per turn"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les <keyword id=\"thorns\">Épines</keyword> infligent <value id=\"quantity_1\">%1$lld</value> dégâts de <keyword id=\"poison\">Poison</keyword> supplémentaires une fois par tour"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1ターンに1回、<keyword id=\"thorns\">棘</keyword>が追加の<keyword id=\"poison\">毒</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "턴마다 한 번, <keyword id=\"thorns\">가시</keyword>가 <keyword id=\"poison\">독</keyword> 추가 피해 <value id=\"quantity_1\">%1$lld</value>"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每回合一次，<keyword id=\"thorns\">荊棘</keyword>額外造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"poison\">中毒</keyword>傷害"
          }
        }
      }
    },
