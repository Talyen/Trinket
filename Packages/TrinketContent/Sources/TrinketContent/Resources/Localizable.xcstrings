        "en": {"stringUnit": {"state": "translated", "value": "Last Wager"}},
        "es": {"stringUnit": {"state": "translated", "value": "Última apuesta"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Dernier pari"}},
