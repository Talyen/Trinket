    "affixes.brass_censer.astral_description": {
      "comment": "ContentManifest/affixes.tsv: brass_censer, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Deine <keyword id=\"holy\">heiligen</keyword> Angriffe verursachen <value id=\"quantity_1\">%1$lld</value> zusätzlichen Schaden bei <keyword id=\"poison\">vergifteten</keyword> Gegnern"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your <keyword id=\"holy\">Holy</keyword> attacks deal <value id=\"quantity_1\">%1$lld</value> additional damage to <keyword id=\"poison\">Poisoned</keyword> enemies"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tus ataques <keyword id=\"holy\">sagrados</keyword> infligen <value id=\"quantity_1\">%1$lld</value> de daño adicional a enemigos <keyword id=\"poison\">envenenados</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Vos attaques <keyword id=\"holy\">sacrées</keyword> infligent <value id=\"quantity_1\">%1$lld</value> dégâts supplémentaires aux ennemis <keyword id=\"poison\">empoisonnés</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "あなたの<keyword id=\"holy\">聖</keyword>攻撃は、<keyword id=\"poison\">毒</keyword>状態の敵に<value id=\"quantity_1\">%1$lld</value>の追加ダメージを与える"}},
        "ko": {"stringUnit": {"state": "translated", "value": "자신의 <keyword id=\"holy\">신성</keyword> 공격이 <keyword id=\"poison\">독</keyword>에 걸린 적에게 <value id=\"quantity_1\">%1$lld</value>의 추가 피해를 줍니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seus ataques <keyword id=\"holy\">Sagrados</keyword> causam <value id=\"quantity_1\">%1$lld</value> de dano adicional a inimigos <keyword id=\"poison\">Envenenados</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "你的<keyword id=\"holy\">神聖</keyword>攻擊對<keyword id=\"poison\">中毒</keyword>的敵人額外造成<value id=\"quantity_1\">%1$lld</value>點傷害"}}
      }
    },
