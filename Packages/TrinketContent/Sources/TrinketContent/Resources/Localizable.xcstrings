    "authored.6a206b91727070b3": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Encounters/Mystery/MysteryEventPool+Events.swift: narrative",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heilblüten umgeben „%1$@“, und freiliegende Wurzeln zeichnen neben „%2$@“ Heilriten nach"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Medicinal blooms surround “%1$@”, and exposed roots trace healing rites near “%2$@”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des fleurs médicinales entourent « %1$@ », tandis que des racines exposées tracent des rites de guérison près de « %2$@ »"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "薬効のある花が「%1$@」を囲み、むき出しの根が「%2$@」の近くに癒やしの儀式を描いている"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약용 꽃이 ‘%1$@’ 주위를 둘러싸고, 드러난 뿌리가 ‘%2$@’ 근처에 치유 의식을 그립니다"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "藥用花朵圍繞著「%1$@」，外露的根鬚在「%2$@」附近勾勒出療癒儀式"
          }
        }
      }
    },
    "authored.6ad421ff35f8ad4b": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"purge\">Entzaubere</keyword> alle Verstärkungen, wenn du einen Gegner <keyword id=\"stun\">betäubst</keyword>\nVerursache pro entfernter Verstärkung <value id=\"quantity_1\">%1$lld</value> <keyword id=\"holy\">heiligen</keyword> Schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"purge\">Purge</keyword> all buffs when you <keyword id=\"stun\">Stun</keyword> an enemy\nDeal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"holy\">Holy</keyword> damage per buff removed"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"purge\">Dissipation</keyword> de tous les bonus lorsque vous infligez un <keyword id=\"stun\">Étourdissement</keyword> à un ennemi\nInfligez <value id=\"quantity_1\">%1$lld</value> dégâts de type <keyword id=\"holy\">Sacré</keyword> par bonus retiré"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "敵を<keyword id=\"stun\">スタン</keyword>状態にすると、すべての強化効果を<keyword id=\"purge\">強化解除</keyword>\n解除した強化効果1つにつき<keyword id=\"holy\">聖</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적을 <keyword id=\"stun\">기절</keyword>시키면 <keyword id=\"purge\">강화 해제</keyword>로 모든 강화 효과 제거\n제거한 강화 효과마다 <keyword id=\"holy\">신성</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使敵人<keyword id=\"stun\">暈眩</keyword>時，<keyword id=\"purge\">驅散</keyword>所有增益效果\n每移除一項增益效果，造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"holy\">神聖</keyword>傷害"
          }
        }
      }
    },
