    "authored.f9e0a4a01fcefe3a": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Abilities/AbilityCatalog+Ultimate.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verursache <value id=\"quantity_1\">%1$lld</value> <keyword id=\"bleed\">Blutungs</keyword>schaden\nLasse die gesamte <keyword id=\"bleed\">Blutung</keyword> detonieren"}},
        "en": {"stringUnit": {"state": "translated", "value": "Deal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"bleed\">Bleed</keyword> damage\nDetonate all <keyword id=\"bleed\">Bleed</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Inflige <value id=\"quantity_1\">%1$lld</value> de daño de <keyword id=\"bleed\">Sangrado</keyword>\nDetona todo el <keyword id=\"bleed\">Sangrado</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Infligez <value id=\"quantity_1\">%1$lld</value> dégâts de <keyword id=\"bleed\">Saignement</keyword>\nFaites exploser tout le <keyword id=\"bleed\">Saignement</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">出血</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える\nすべての<keyword id=\"bleed\">出血</keyword>を炸裂させる"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">출혈</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>\n모든 <keyword id=\"bleed\">출혈</keyword> 폭발"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cause <value id=\"quantity_1\">%1$lld</value> de dano de <keyword id=\"bleed\">Sangramento</keyword>\nDetone todo o <keyword id=\"bleed\">Sangramento</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"bleed\">流血</keyword>傷害\n引爆所有<keyword id=\"bleed\">流血</keyword>"}}
      }
    },
