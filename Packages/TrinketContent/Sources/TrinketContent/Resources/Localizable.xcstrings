    "authored.571d6a1b2c939913": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Abilities/AbilityCatalog+Skill.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verursache <value id=\"quantity_1\">%1$lld</value> <keyword id=\"freeze\">Frost</keyword>schaden\nZiehe eine Karte, wenn der Gegner <keyword id=\"freeze\">eingefroren</keyword> ist"}},
        "en": {"stringUnit": {"state": "translated", "value": "Deal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"freeze\">Freeze</keyword> damage\nDraw a card if the enemy is <keyword id=\"freeze\">Frozen</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Inflige <value id=\"quantity_1\">%1$lld</value> de daño de <keyword id=\"freeze\">Congelación</keyword>\nRoba una carta si el enemigo está <keyword id=\"freeze\">congelado</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Infligez <value id=\"quantity_1\">%1$lld</value> dégâts de <keyword id=\"freeze\">Gel</keyword>\nPiochez une carte si l’ennemi est sous <keyword id=\"freeze\">Gel</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">凍結</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える\n敵が<keyword id=\"freeze\">凍結</keyword>状態ならカードを1枚引く"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">빙결</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>\n적이 <keyword id=\"freeze\">빙결</keyword> 상태이면 카드 한 장 뽑기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cause <value id=\"quantity_1\">%1$lld</value> de dano de <keyword id=\"freeze\">Congelamento</keyword>\nCompre uma carta se o inimigo estiver <keyword id=\"freeze\">Congelado</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"freeze\">冰凍</keyword>傷害\n若敵人已<keyword id=\"freeze\">冰凍</keyword>，抽一張牌"}}
      }
    },
