    "traits.kindling.description": {
      "comment": "ContentManifest/traits.tsv: kindling, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erlittener <keyword id=\"burn\">Brand</keyword>schaden um <value id=\"quantity_1\">%1$lld</value>%% erhöht"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Burn</keyword> damage taken increased by <value id=\"quantity_1\">%1$lld</value>%%"}},
        "es": {"stringUnit": {"state": "translated", "value": "Daño de <keyword id=\"burn\">Quemadura</keyword> recibido aumentado en un <value id=\"quantity_1\">%1$lld</value>%%"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Dégâts de <keyword id=\"burn\">Brûlure</keyword> subis augmentés de <value id=\"quantity_1\">%1$lld</value>%%"}},
