    "authored.d7fcd6019bb54548": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog+Offhand.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dein <keyword id=\"block\">Block</keyword> in einem Zug erstmals Angriffsschaden absorbiert, setze sofort deine Grundfähigkeit ein"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first time each turn your <keyword id=\"block\">Block</keyword> absorbs attack damage, immediately use your Basic ability"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La première fois que votre <keyword id=\"block\">Blocage</keyword> absorbe des dégâts d’attaque à chaque tour, utilisez immédiatement votre capacité de base"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ターンに初めて自分の<keyword id=\"block\">ブロック</keyword>が攻撃ダメージを吸収すると、即座に基本アビリティを使う"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매 턴 처음으로 내 <keyword id=\"block\">방어도</keyword>가 공격 피해를 흡수하면 즉시 기본 능력 사용"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每回合自身<keyword id=\"block\">格擋</keyword>首次吸收攻擊傷害時，立刻使用基本能力"
          }
        }
      }
    },
