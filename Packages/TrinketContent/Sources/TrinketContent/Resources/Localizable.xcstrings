    "talents.wizard_mana_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: wizard_mana_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verstärken mit <keyword id=\"mana\">Mana</keyword> erhöht den Schaden deines nächsten Angriffs um <value id=\"quantity_1\">%1$lld</value>%%"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"mana\">Mana</keyword> empowerment increases your next attack's damage by <value id=\"quantity_1\">%1$lld</value>%%"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un renforcement au <keyword id=\"mana\">Mana</keyword> augmente les dégâts de votre prochaine attaque de <value id=\"quantity_1\">%1$lld</value>%%"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"mana\">マナ</keyword>で強化すると、次の攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"mana\">마나</keyword>로 강화 시 다음 공격의 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以<keyword id=\"mana\">魔力</keyword>強化時，下次攻擊的傷害提高<value id=\"quantity_1\">%1$lld</value>%%"
          }
        }
      }
    },
