    "talents.wildcard_physical_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: wildcard_physical_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Durchbrechen gegnerischen <keyword id=\"block\">Blocks</keyword> mit <keyword id=\"physical\">physischem</keyword> Schaden lässt deinen nächsten Angriff kritisch treffen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Breaking enemy <keyword id=\"block\">Block</keyword> with <keyword id=\"physical\">Physical</keyword> damage makes your next attack Critically Hit"}},
        "es": {"stringUnit": {"state": "translated", "value": "Romper el <keyword id=\"block\">Bloqueo</keyword> del enemigo con daño <keyword id=\"physical\">físico</keyword> hace que tu siguiente ataque aseste un golpe crítico"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Briser le <keyword id=\"block\">Blocage</keyword> ennemi avec des dégâts de type <keyword id=\"physical\">Physique</keyword> garantit un coup critique à votre prochaine attaque"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">物理</keyword>ダメージで敵の<keyword id=\"block\">ブロック</keyword>を崩すと、次の攻撃が必ずクリティカルヒット"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">물리</keyword> 피해로 적의 <keyword id=\"block\">방어도</keyword>를 깨뜨리면 다음 공격이 반드시 치명타"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Quebrar o <keyword id=\"block\">Bloqueio</keyword> inimigo com dano <keyword id=\"physical\">Físico</keyword> faz seu próximo ataque acertar um golpe crítico"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "以<keyword id=\"physical\">物理</keyword>傷害擊破敵人<keyword id=\"block\">格擋</keyword>後，下次攻擊必定暴擊"}}
      }
    },
    "talents.wildcard_physical_t2_2.name": {
      "comment": "ContentManifest/talents.tsv: wildcard_physical_t2_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Gebrochene Deckung"}},
        "en": {"stringUnit": {"state": "translated", "value": "Cracked Guard"}},
        "es": {"stringUnit": {"state": "translated", "value": "Guardia agrietada"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Garde fissurée"}},
        "ja": {"stringUnit": {"state": "translated", "value": "崩れた守り"}},
        "ko": {"stringUnit": {"state": "translated", "value": "무너진 방어"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Guarda Rachada"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "破裂防守"}}
      }
    },
    "talents.wildcard_physical_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: wildcard_physical_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">Physische</keyword> Angriffe gegen <keyword id=\"freeze\">eingefrorene</keyword> Gegner erhalten +<value id=\"quantity_1\">%1$lld</value>%% Chance auf kritische Treffer"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">Physical</keyword> attacks against <keyword id=\"freeze\">Frozen</keyword> enemies gain +<value id=\"quantity_1\">%1$lld</value>%% Critical Hit chance"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques <keyword id=\"physical\">físicos</keyword> contra enemigos <keyword id=\"freeze\">congelados</keyword> obtienen +<value id=\"quantity_1\">%1$lld</value>%% de probabilidad de golpe crítico"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques de type <keyword id=\"physical\">Physique</keyword> contre les ennemis sous <keyword id=\"freeze\">Gel</keyword> gagnent +<value id=\"quantity_1\">%1$lld</value>%% de chances de coup critique"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">凍結</keyword>状態の敵への<keyword id=\"physical\">物理</keyword>攻撃のクリティカル率が<value id=\"quantity_1\">%1$lld</value>%%上昇"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">빙결</keyword> 상태의 적에게 <keyword id=\"physical\">물리</keyword> 공격의 치명타 확률 +<value id=\"quantity_1\">%1$lld</value>%%"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques <keyword id=\"physical\">Físicos</keyword> contra inimigos <keyword id=\"freeze\">Congelados</keyword> ganham +<value id=\"quantity_1\">%1$lld</value>%% de chance de golpe crítico"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">物理</keyword>攻擊對<keyword id=\"freeze\">冰凍</keyword>敵人的暴擊機率提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.wildcard_physical_t3_1.name": {
      "comment": "ContentManifest/talents.tsv: wildcard_physical_t3_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Kalter Blick"}},
        "en": {"stringUnit": {"state": "translated", "value": "Cold Read"}},
        "es": {"stringUnit": {"state": "translated", "value": "Lectura fría"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Lecture à froid"}},
        "ja": {"stringUnit": {"state": "translated", "value": "冷静な見切り"}},
        "ko": {"stringUnit": {"state": "translated", "value": "냉철한 간파"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Leitura Fria"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "冷靜判讀"}}
      }
    },
    "talents.wildcard_physical_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: wildcard_physical_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wenn ein Gegner deinen Angriff vollständig blockt, wird dein nächster <keyword id=\"physical\">physischer</keyword> Angriff verdoppelt"}},
        "en": {"stringUnit": {"state": "translated", "value": "An enemy fully Blocking your attack doubles your next <keyword id=\"physical\">Physical</keyword> attack"}},
        "es": {"stringUnit": {"state": "translated", "value": "Si un enemigo bloquea por completo tu ataque, duplica tu siguiente ataque <keyword id=\"physical\">físico</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Si un ennemi bloque entièrement votre attaque, votre prochaine attaque de type <keyword id=\"physical\">Physique</keyword> est doublée"}},
        "ja": {"stringUnit": {"state": "translated", "value": "自分の攻撃を敵が完全にブロックすると、次の<keyword id=\"physical\">物理</keyword>攻撃が2倍になる"}},
        "ko": {"stringUnit": {"state": "translated", "value": "적이 내 공격을 완전히 막으면 다음 <keyword id=\"physical\">물리</keyword> 공격이 두 배"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Um inimigo Bloquear completamente seu ataque dobra seu próximo ataque <keyword id=\"physical\">Físico</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "自身攻擊被敵人完全格擋後，下次<keyword id=\"physical\">物理</keyword>攻擊加倍"}}
      }
    },
    "talents.wildcard_physical_t3_2.name": {
      "comment": "ContentManifest/talents.tsv: wildcard_physical_t3_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Vorgetäuschter Fehlschlag"}},
        "en": {"stringUnit": {"state": "translated", "value": "Feigned Miss"}},
        "es": {"stringUnit": {"state": "translated", "value": "Fallo fingido"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Échec feint"}},
        "ja": {"stringUnit": {"state": "translated", "value": "偽りの空振り"}},
        "ko": {"stringUnit": {"state": "translated", "value": "빗나간 척하기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Erro Fingido"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "佯裝失手"}}
      }
    },
    "talents.wildcard_physical_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: wildcard_physical_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Stehlen von <keyword id=\"gold\">Gold</keyword> fügt deinem nächsten Angriff <value id=\"quantity_1\">%1$lld</value> Schaden hinzu"}},
        "en": {"stringUnit": {"state": "translated", "value": "Stealing <keyword id=\"gold\">Gold</keyword> adds <value id=\"quantity_1\">%1$lld</value> damage to your next attack"}},
        "es": {"stringUnit": {"state": "translated", "value": "Robar <keyword id=\"gold\">Oro</keyword> añade <value id=\"quantity_1\">%1$lld</value> de daño a tu siguiente ataque"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Voler de l’<keyword id=\"gold\">Or</keyword> ajoute <value id=\"quantity_1\">%1$lld</value> dégâts à votre prochaine attaque"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"gold\">ゴールド</keyword>を盗むと、次の攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"gold\">골드</keyword>를 훔치면 다음 공격의 피해 <value id=\"quantity_1\">%1$lld</value> 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Roubar <keyword id=\"gold\">Ouro</keyword> adiciona <value id=\"quantity_1\">%1$lld</value> de dano ao seu próximo ataque"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "偷取<keyword id=\"gold\">金幣</keyword>後，下次攻擊的傷害增加<value id=\"quantity_1\">%1$lld</value>點"}}
      }
    },
    "talents.wildcard_physical_t4_1.name": {
      "comment": "ContentManifest/talents.tsv: wildcard_physical_t4_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Vollständig bezahlt"}},
        "en": {"stringUnit": {"state": "translated", "value": "Paid in Full"}},
        "es": {"stringUnit": {"state": "translated", "value": "Pago completo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Solde de tout compte"}},
        "ja": {"stringUnit": {"state": "translated", "value": "完済"}},
        "ko": {"stringUnit": {"state": "translated", "value": "완납"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Pago por Inteiro"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "全額付清"}}
      }
    },
    "talents.wizard_burn_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: wizard_burn_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Brand</keyword> verursacht <value id=\"quantity_1\">%1$lld</value>%% mehr Schaden an Gegnern ohne <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Burn</keyword> deals <value id=\"quantity_1\">%1$lld</value>%% more damage to enemies with no <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Quemadura</keyword> inflige un <value id=\"quantity_1\">%1$lld</value>%% más de daño a enemigos sin <keyword id=\"block\">Bloqueo</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "La <keyword id=\"burn\">Brûlure</keyword> inflige <value id=\"quantity_1\">%1$lld</value>%% de dégâts en plus aux ennemis sans <keyword id=\"block\">Blocage</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">ブロック</keyword>のない敵への<keyword id=\"burn\">炎上</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">방어도</keyword>가 없는 적에게 <keyword id=\"burn\">화상</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Queimadura</keyword> causa <value id=\"quantity_1\">%1$lld</value>%% mais dano a inimigos sem <keyword id=\"block\">Bloqueio</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">燃燒</keyword>對沒有<keyword id=\"block\">格擋</keyword>的敵人造成的傷害增加<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.wizard_burn_t1_1.name": {
      "comment": "ContentManifest/talents.tsv: wizard_burn_t1_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Entzündung"}},
        "en": {"stringUnit": {"state": "translated", "value": "Ignition"}},
        "es": {"stringUnit": {"state": "translated", "value": "Ignición"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Ignition"}},
        "ja": {"stringUnit": {"state": "translated", "value": "着火"}},
        "ko": {"stringUnit": {"state": "translated", "value": "발화"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ignição"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "引燃"}}
      }
    },
    "talents.wizard_burn_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: wizard_burn_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Brand</keyword> auf Gegnern nimmt <value id=\"quantity_1\">%1$lld</value>%% langsamer ab"}},
        "en": {"stringUnit": {"state": "translated", "value": "Enemy <keyword id=\"burn\">Burn</keyword> fades <value id=\"quantity_1\">%1$lld</value>%% slower"}},
        "es": {"stringUnit": {"state": "translated", "value": "La <keyword id=\"burn\">Quemadura</keyword> que afecta al enemigo disminuye un <value id=\"quantity_1\">%1$lld</value>%% más despacio"}},
        "fr": {"stringUnit": {"state": "translated", "value": "La <keyword id=\"burn\">Brûlure</keyword> affectant l’ennemi diminue <value id=\"quantity_1\">%1$lld</value>%% plus lentement"}},
        "ja": {"stringUnit": {"state": "translated", "value": "敵にかかった<keyword id=\"burn\">炎上</keyword>の減衰が<value id=\"quantity_1\">%1$lld</value>%%遅くなる"}},
        "ko": {"stringUnit": {"state": "translated", "value": "적에게 걸린 <keyword id=\"burn\">화상</keyword>의 감소 속도 <value id=\"quantity_1\">%1$lld</value>%% 저하"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "A <keyword id=\"burn\">Queimadura</keyword> no inimigo diminui <value id=\"quantity_1\">%1$lld</value>%% mais devagar"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "敵人身上的<keyword id=\"burn\">燃燒</keyword>衰減速度降低<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.wizard_burn_t1_2.name": {
      "comment": "ContentManifest/talents.tsv: wizard_burn_t1_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Schwelend"}},
        "en": {"stringUnit": {"state": "translated", "value": "Smoldering"}},
        "es": {"stringUnit": {"state": "translated", "value": "Humeante"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Couvant"}},
        "ja": {"stringUnit": {"state": "translated", "value": "燻り"}},
        "ko": {"stringUnit": {"state": "translated", "value": "그을린"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Fumegante"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "悶燒"}}
      }
    },
    "talents.wizard_burn_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: wizard_burn_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Brand</keyword> ignoriert gegnerischen <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Burn</keyword> ignores enemy <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Quemadura</keyword> ignora el <keyword id=\"block\">Bloqueo</keyword> del enemigo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "La <keyword id=\"burn\">Brûlure</keyword> ignore le <keyword id=\"block\">Blocage</keyword> ennemi"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">炎上</keyword>が敵の<keyword id=\"block\">ブロック</keyword>を無視"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">화상</keyword>이 적의 <keyword id=\"block\">방어도</keyword> 무시"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Queimadura</keyword> ignora o <keyword id=\"block\">Bloqueio</keyword> inimigo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">燃燒</keyword>無視敵人<keyword id=\"block\">格擋</keyword>"}}
      }
    },
    "talents.wizard_burn_t2_1.name": {
      "comment": "ContentManifest/talents.tsv: wizard_burn_t2_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Sengende Hitze"}},
        "en": {"stringUnit": {"state": "translated", "value": "Searing Heat"}},
        "es": {"stringUnit": {"state": "translated", "value": "Calor abrasador"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Chaleur ardente"}},
        "ja": {"stringUnit": {"state": "translated", "value": "焼けつく熱"}},
        "ko": {"stringUnit": {"state": "translated", "value": "타는 듯한 열기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Calor Abrasador"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "灼熱高溫"}}
      }
    },
    "talents.wizard_burn_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: wizard_burn_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Mit <keyword id=\"mana\">Mana</keyword> verstärkte <keyword id=\"burn\">Brand</keyword>-Angriffe verursachen <value id=\"quantity_1\">%1$lld</value> zusätzlichen Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">Mana</keyword>-empowered <keyword id=\"burn\">Burn</keyword> attacks deal <value id=\"quantity_1\">%1$lld</value> additional damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques de <keyword id=\"burn\">Quemadura</keyword> potenciados con <keyword id=\"mana\">Maná</keyword> infligen <value id=\"quantity_1\">%1$lld</value> de daño adicional"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques de <keyword id=\"burn\">Brûlure</keyword> renforcées au <keyword id=\"mana\">Mana</keyword> infligent <value id=\"quantity_1\">%1$lld</value> dégâts supplémentaires"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">マナ</keyword>で強化した<keyword id=\"burn\">炎上</keyword>攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">마나</keyword>로 강화한 <keyword id=\"burn\">화상</keyword> 공격의 추가 피해 <value id=\"quantity_1\">%1$lld</value>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques de <keyword id=\"burn\">Queimadura</keyword> fortalecidos com <keyword id=\"mana\">Mana</keyword> causam <value id=\"quantity_1\">%1$lld</value> de dano adicional"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">魔力</keyword>強化的<keyword id=\"burn\">燃燒</keyword>攻擊額外造成<value id=\"quantity_1\">%1$lld</value>點傷害"}}
      }
    },
    "talents.wizard_burn_t2_2.name": {
      "comment": "ContentManifest/talents.tsv: wizard_burn_t2_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Die Flammen nähren"}},
        "en": {"stringUnit": {"state": "translated", "value": "Fuel the Flames"}},
        "es": {"stringUnit": {"state": "translated", "value": "Avivar las llamas"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Attiser les flammes"}},
        "ja": {"stringUnit": {"state": "translated", "value": "火に燃料を"}},
        "ko": {"stringUnit": {"state": "translated", "value": "불길에 연료를"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Alimentar as Chamas"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "火上加油"}}
      }
    },
    "talents.wizard_burn_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: wizard_burn_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Brand</keyword>-Angriffe verursachen mit <value id=\"quantity_1\">%1$lld</value>%% Chance doppelten Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Burn</keyword> attacks have a <value id=\"quantity_1\">%1$lld</value>%% chance to deal double damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques de <keyword id=\"burn\">Quemadura</keyword> tienen un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de infligir el doble de daño"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques de <keyword id=\"burn\">Brûlure</keyword> ont <value id=\"quantity_1\">%1$lld</value>%% de chances d’infliger le double de dégâts"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">炎上</keyword>攻撃が<value id=\"quantity_1\">%1$lld</value>%%の確率で2倍のダメージを与える"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">화상</keyword> 공격이 <value id=\"quantity_1\">%1$lld</value>%% 확률로 두 배의 피해"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques de <keyword id=\"burn\">Queimadura</keyword> têm <value id=\"quantity_1\">%1$lld</value>%% de chance de causar o dobro de dano"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">燃燒</keyword>攻擊有<value id=\"quantity_1\">%1$lld</value>%%機率造成雙倍傷害"}}
      }
    },
    "talents.wizard_burn_t3_1.name": {
      "comment": "ContentManifest/talents.tsv: wizard_burn_t3_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Supernova"}},
        "en": {"stringUnit": {"state": "translated", "value": "Supernova"}},
        "es": {"stringUnit": {"state": "translated", "value": "Supernova"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Supernova"}},
        "ja": {"stringUnit": {"state": "translated", "value": "超新星"}},
        "ko": {"stringUnit": {"state": "translated", "value": "초신성"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Supernova"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "超新星"}}
      }
    },
    "talents.wizard_burn_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: wizard_burn_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Verstärken von <keyword id=\"burn\">Brand</keyword>-Angriffen kostet <value id=\"quantity_1\">%1$lld</value> weniger <keyword id=\"mana\">Mana</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Empowering <keyword id=\"burn\">Burn</keyword> attacks costs <value id=\"quantity_1\">%1$lld</value> less <keyword id=\"mana\">Mana</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Potenciar ataques de <keyword id=\"burn\">Quemadura</keyword> cuesta <value id=\"quantity_1\">%1$lld</value> menos de <keyword id=\"mana\">Maná</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Renforcer une attaque de <keyword id=\"burn\">Brûlure</keyword> coûte <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword> de moins"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">炎上</keyword>攻撃の強化に必要な<keyword id=\"mana\">マナ</keyword>が<value id=\"quantity_1\">%1$lld</value>減少"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">화상</keyword> 공격 강화의 <keyword id=\"mana\">마나</keyword> 소모량 <value id=\"quantity_1\">%1$lld</value> 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Fortalecer ataques de <keyword id=\"burn\">Queimadura</keyword> custa <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"mana\">Mana</keyword> a menos"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "強化<keyword id=\"burn\">燃燒</keyword>攻擊所需<keyword id=\"mana\">魔力</keyword>減少<value id=\"quantity_1\">%1$lld</value>點"}}
      }
    },
    "talents.wizard_burn_t3_2.name": {
      "comment": "ContentManifest/talents.tsv: wizard_burn_t3_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Pyromantenfunke"}},
        "en": {"stringUnit": {"state": "translated", "value": "Pyromancer's Spark"}},
        "es": {"stringUnit": {"state": "translated", "value": "Chispa del piromante"}},
