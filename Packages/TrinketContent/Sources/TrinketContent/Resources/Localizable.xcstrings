    "homestead_nodes.leylineenergy.1.bonus_description": {
      "comment": "ContentManifest/homestead_nodes.tsv: leylineEnergy.1, bonus_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle <value id=\"quantity_1\">%1$lld</value>%% mehr <keyword id=\"mana\">Mana</keyword> wieder her\nProduziere <value id=\"quantity_2\">%2$lld</value> Edelsteine pro Tag"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore <value id=\"quantity_1\">%1$lld</value>%% more <keyword id=\"mana\">Mana</keyword>\nProduce <value id=\"quantity_2\">%2$lld</value> Gems per Day"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"mana\">Mana</keyword> restauré augmenté de <value id=\"quantity_1\">%1$lld</value>%%\nProduit <value id=\"quantity_2\">%2$lld</value> gemmes par jour"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"mana\">マナ</keyword>回復量が<value id=\"quantity_1\">%1$lld</value>%%増加\n1日に宝石を<value id=\"quantity_2\">%2$lld</value>生産"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"mana\">마나</keyword> 회복량 <value id=\"quantity_1\">%1$lld</value>%% 증가\n하루에 보석 <value id=\"quantity_2\">%2$lld</value>개 생산"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復的<keyword id=\"mana\">魔力</keyword>增加<value id=\"quantity_1\">%1$lld</value>%%\n每天生產<value id=\"quantity_2\">%2$lld</value>寶石"
          }
        }
      }
    },
