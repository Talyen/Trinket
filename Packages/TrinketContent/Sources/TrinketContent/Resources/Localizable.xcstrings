    "talents.ranger_burn_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: ranger_burn_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Brennende</keyword> Gegner gewähren beiden Verbündeten +<value id=\"quantity_1\">%1$lld</value>%% Chance auf <keyword id=\"dodge\">Ausweichen</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Burning</keyword> enemies grant both allies +<value id=\"quantity_1\">%1$lld</value>%% <keyword id=\"dodge\">Dodge</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los enemigos con <keyword id=\"burn\">Quemadura</keyword> otorgan a ambos aliados +<value id=\"quantity_1\">%1$lld</value>%% de <keyword id=\"dodge\">Evasión</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les ennemis sous <keyword id=\"burn\">Brûlure</keyword> octroient aux deux alliés +<value id=\"quantity_1\">%1$lld</value>%% d’<keyword id=\"dodge\">Esquive</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">炎上</keyword>状態の敵は味方2人に<value id=\"quantity_1\">%1$lld</value>%%の<keyword id=\"dodge\">回避</keyword>率を付与"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">화상</keyword> 상태의 적은 두 아군에게 <keyword id=\"dodge\">회피</keyword> +<value id=\"quantity_1\">%1$lld</value>%% 부여"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Inimigos <keyword id=\"burn\">Em Chamas</keyword> concedem +<value id=\"quantity_1\">%1$lld</value>%% de <keyword id=\"dodge\">Esquiva</keyword> a ambos os aliados"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">燃燒</keyword>中的敵人使兩名友方<keyword id=\"dodge\">閃避</keyword>機率提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
