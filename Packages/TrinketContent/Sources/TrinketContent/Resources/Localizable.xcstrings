      "comment": "ContentManifest/talents.tsv: mana_moth_mana_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verstärken mit <keyword id=\"mana\">Mana</keyword> verursacht mit <value id=\"quantity_1\">%1$lld</value>%% Chance <value id=\"quantity_2\">%2$lld</value>%% mehr Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">Mana</keyword> empowerment has a <value id=\"quantity_1\">%1$lld</value>%% chance to deal <value id=\"quantity_2\">%2$lld</value>%% more damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Potenciar con <keyword id=\"mana\">Maná</keyword> tiene un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de infligir un <value id=\"quantity_2\">%2$lld</value>%% más de daño"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Un renforcement au <keyword id=\"mana\">Mana</keyword> a <value id=\"quantity_1\">%1$lld</value>%% de chances d’infliger <value id=\"quantity_2\">%2$lld</value>%% de dégâts en plus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">マナ</keyword>強化が<value id=\"quantity_1\">%1$lld</value>%%の確率でダメージを<value id=\"quantity_2\">%2$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">마나</keyword>로 강화 시 <value id=\"quantity_1\">%1$lld</value>%% 확률로 피해 <value id=\"quantity_2\">%2$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Fortalecer com <keyword id=\"mana\">Mana</keyword> tem <value id=\"quantity_1\">%1$lld</value>%% de chance de causar <value id=\"quantity_2\">%2$lld</value>%% mais dano"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">魔力</keyword>強化有<value id=\"quantity_1\">%1$lld</value>%%機率額外造成<value id=\"quantity_2\">%2$lld</value>%%傷害"}}
      }
    },
