        "de": {"stringUnit": {"state": "translated", "value": "Vitalinfusion"}},
        "en": {"stringUnit": {"state": "translated", "value": "Vital Infusion"}},
        "es": {"stringUnit": {"state": "translated", "value": "Infusión vital"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Infusion vitale"}},
        "ja": {"stringUnit": {"state": "translated", "value": "生命の注入"}},
        "ko": {"stringUnit": {"state": "translated", "value": "생명 주입"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Infusão Vital"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "生命灌注"}}
      }
    },
    "talents.pixie_health_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: pixie_health_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Überschüssige Heilung, die du gewährst, wird für ihren Empfänger zu <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Excess healing you provide becomes <keyword id=\"block\">Block</keyword> for its recipient"}},
        "es": {"stringUnit": {"state": "translated", "value": "La curación sobrante que proporcionas se convierte en <keyword id=\"block\">Bloqueo</keyword> para su receptor"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les soins excédentaires que vous prodiguez deviennent du <keyword id=\"block\">Blocage</keyword> pour leur bénéficiaire"}},
        "ja": {"stringUnit": {"state": "translated", "value": "自分が行う過剰回復を、回復対象の<keyword id=\"block\">ブロック</keyword>に変換"}},
        "ko": {"stringUnit": {"state": "translated", "value": "자신이 제공한 초과 치유량을 치유 대상의 <keyword id=\"block\">방어도</keyword>로 전환"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "A cura excedente que você fornece se torna <keyword id=\"block\">Bloqueio</keyword> para quem a recebe"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "自身施予的過量治療轉為受治者的<keyword id=\"block\">格擋</keyword>"}}
      }
    },
    "talents.pixie_health_t3_2.name": {
      "comment": "ContentManifest/talents.tsv: pixie_health_t3_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Barrierensegen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Barrier Blessing"}},
        "es": {"stringUnit": {"state": "translated", "value": "Bendición de barrera"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Bénédiction protectrice"}},
        "ja": {"stringUnit": {"state": "translated", "value": "障壁の祝福"}},
        "ko": {"stringUnit": {"state": "translated", "value": "장벽의 축복"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Bênção de Barreira"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "屏障祝福"}}
      }
    },
    "talents.pixie_health_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: pixie_health_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Deine überschüssige Heilung macht dein nächstes Verstärken mit <keyword id=\"mana\">Mana</keyword> kostenlos"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your excess healing makes your next <keyword id=\"mana\">Mana</keyword> empowerment free"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu curación sobrante hace que tu siguiente potenciación con <keyword id=\"mana\">Maná</keyword> sea gratuita"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Vos soins excédentaires rendent votre prochain renforcement au <keyword id=\"mana\">Mana</keyword> gratuit"}},
        "ja": {"stringUnit": {"state": "translated", "value": "自分が過剰回復を行うと、次の<keyword id=\"mana\">マナ</keyword>強化の消費がなくなる"}},
        "ko": {"stringUnit": {"state": "translated", "value": "초과 치유 시 다음 <keyword id=\"mana\">마나</keyword> 강화가 무료"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Sua cura excedente torna gratuito seu próximo fortalecimento com <keyword id=\"mana\">Mana</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "自身造成過量治療後，下次<keyword id=\"mana\">魔力</keyword>強化無需消耗"}}
      }
    },
    "talents.pixie_health_t4_1.name": {
      "comment": "ContentManifest/talents.tsv: pixie_health_t4_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wunschquelle"}},
        "en": {"stringUnit": {"state": "translated", "value": "Wishspring"}},
        "es": {"stringUnit": {"state": "translated", "value": "Manantial de deseos"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Source des souhaits"}},
        "ja": {"stringUnit": {"state": "translated", "value": "願いの泉"}},
        "ko": {"stringUnit": {"state": "translated", "value": "소원의 샘"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Nascente dos Desejos"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "許願之泉"}}
      }
    },
    "talents.pixie_holy_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: pixie_holy_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">Heilige</keyword> Angriffe erhalten +<value id=\"quantity_1\">%1$lld</value>%% Chance auf kritische Treffer"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">Holy</keyword> attacks gain +<value id=\"quantity_1\">%1$lld</value>%% Critical Hit chance"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques <keyword id=\"holy\">sagrados</keyword> obtienen +<value id=\"quantity_1\">%1$lld</value>%% de probabilidad de golpe crítico"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques de type <keyword id=\"holy\">Sacré</keyword> gagnent +<value id=\"quantity_1\">%1$lld</value>%% de chances de coup critique"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">聖</keyword>攻撃のクリティカル率が<value id=\"quantity_1\">%1$lld</value>%%上昇"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">신성</keyword> 공격의 치명타 확률 +<value id=\"quantity_1\">%1$lld</value>%%"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques <keyword id=\"holy\">Sagrados</keyword> ganham +<value id=\"quantity_1\">%1$lld</value>%% de chance de golpe crítico"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">神聖</keyword>攻擊的暴擊機率提高<value id=\"quantity_1\">%1$lld</value>%%"}}
