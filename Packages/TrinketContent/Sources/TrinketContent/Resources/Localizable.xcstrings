        "ko": {"stringUnit": {"state": "translated", "value": "아군에게 <keyword id=\"block\">방어도</keyword>가 있으면 얻는 <keyword id=\"block\">방어도</keyword>가 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ganhe <value id=\"quantity_1\">%1$lld</value>%% mais <keyword id=\"block\">Bloqueio</keyword> enquanto seu aliado tiver <keyword id=\"block\">Bloqueio</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "盟友擁有<keyword id=\"block\">格擋</keyword>時，獲得的<keyword id=\"block\">格擋</keyword>提高<value id=\"quantity_1\">%1$lld</value>%%"}}
