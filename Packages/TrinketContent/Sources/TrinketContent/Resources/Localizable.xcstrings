    "affixes.resonant_chimes.astral_description": {
      "comment": "ContentManifest/affixes.tsv: resonant_chimes, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword>, wenn du deine zweite Karte in einem Zug spielst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gain <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword> when you play your second card each turn"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagnez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword> en jouant votre deuxième carte de chaque tour"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ターンに2枚目のカードを使うと<keyword id=\"mana\">マナ</keyword>を<value id=\"quantity_1\">%1$lld</value>獲得"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매 턴 두 번째 카드 사용 시 <keyword id=\"mana\">마나</keyword> <value id=\"quantity_1\">%1$lld</value> 획득"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每回合打出第二張牌時，獲得<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"mana\">魔力</keyword>"
          }
        }
      }
    },
    "affixes.resonant_chimes.basic_description": {
      "comment": "ContentManifest/affixes.tsv: resonant_chimes, basic_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword>, wenn du deine zweite Karte in einem Zug spielst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gain <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword> when you play your second card each turn"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagnez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword> en jouant votre deuxième carte de chaque tour"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ターンに2枚目のカードを使うと<keyword id=\"mana\">マナ</keyword>を<value id=\"quantity_1\">%1$lld</value>獲得"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매 턴 두 번째 카드 사용 시 <keyword id=\"mana\">마나</keyword> <value id=\"quantity_1\">%1$lld</value> 획득"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每回合打出第二張牌時，獲得<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"mana\">魔力</keyword>"
          }
        }
      }
    },
