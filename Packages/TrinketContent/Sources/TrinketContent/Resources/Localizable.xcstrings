    "talents.wildcard_gold_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: wildcard_gold_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Erhalt von <keyword id=\"gold\">Gold</keyword> stellt mit <value id=\"quantity_1\">%1$lld</value>%% Chance <value id=\"quantity_2\">%2$lld</value> <keyword id=\"health\">Gesundheit</keyword> wieder her"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaining <keyword id=\"gold\">Gold</keyword> has a <value id=\"quantity_1\">%1$lld</value>%% chance to restore <value id=\"quantity_2\">%2$lld</value> <keyword id=\"health\">Health</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagner de l’<keyword id=\"gold\">Or</keyword> a <value id=\"quantity_1\">%1$lld</value>%% de chances de restaurer <value id=\"quantity_2\">%2$lld</value> <keyword id=\"health\">Santé</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"gold\">ゴールド</keyword>を獲得すると<value id=\"quantity_1\">%1$lld</value>%%の確率で<keyword id=\"health\">体力</keyword>を<value id=\"quantity_2\">%2$lld</value>回復"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"gold\">골드</keyword> 획득 시 <value id=\"quantity_1\">%1$lld</value>%% 확률로 <keyword id=\"health\">체력</keyword> <value id=\"quantity_2\">%2$lld</value> 회복"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "獲得<keyword id=\"gold\">金幣</keyword>時，有<value id=\"quantity_1\">%1$lld</value>%%機率恢復<value id=\"quantity_2\">%2$lld</value>點<keyword id=\"health\">生命值</keyword>"
          }
        }
      }
    },
    "talents.wildcard_gold_t1_2.name": {
      "comment": "ContentManifest/talents.tsv: wildcard_gold_t1_2, name",
