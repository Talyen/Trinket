        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Erleiden von <keyword id=\"health\">Gesundheits</keyword>schaden verringert den nächsten verursachten Schaden um <value id=\"quantity_1\">%1$lld</value>"
