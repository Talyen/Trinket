    "authored.0580f476b6077cea": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog+Ranged.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal pro Zug: Wenn du dein letztes <keyword id=\"mana\">Mana</keyword> zum Verstärken einer <keyword id=\"burn\">Brand</keyword>- oder <keyword id=\"freeze\">Frost</keyword>-Karte ausgibst, wird ihr Schaden wiederholt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once per turn, spending your last <keyword id=\"mana\">Mana</keyword> to empower a <keyword id=\"burn\">Burn</keyword> or <keyword id=\"freeze\">Freeze</keyword> card repeats its damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois par tour, dépenser votre dernier <keyword id=\"mana\">Mana</keyword> pour renforcer une carte de <keyword id=\"burn\">Brûlure</keyword> ou de <keyword id=\"freeze\">Gel</keyword> répète ses dégâts"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1ターンに1回、最後の<keyword id=\"mana\">マナ</keyword>を消費して<keyword id=\"burn\">炎上</keyword>か<keyword id=\"freeze\">凍結</keyword>カードを強化すると、そのダメージをもう一度与える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "턴마다 한 번, 마지막 <keyword id=\"mana\">마나</keyword>를 소모해 <keyword id=\"burn\">화상</keyword> 또는 <keyword id=\"freeze\">빙결</keyword> 카드를 강화하면 해당 피해를 반복"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每回合一次，消耗最後的<keyword id=\"mana\">魔力</keyword>強化<keyword id=\"burn\">燃燒</keyword>或<keyword id=\"freeze\">冰凍</keyword>卡牌時，重複造成該牌傷害"
          }
        }
      }
    },
