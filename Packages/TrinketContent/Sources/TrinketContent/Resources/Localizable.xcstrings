      }
    },
    "traits.blighted_pulse.description": {
      "comment": "ContentManifest/traits.tsv: blighted_pulse, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verursacht jeden zweiten Zug <value id=\"quantity_1\">%1$lld</value> Schaden durch <keyword id=\"poison\">Gift</keyword> oder <keyword id=\"bleed\">Blutung</keyword>."}},
        "en": {"stringUnit": {"state": "translated", "value": "Deals <value id=\"quantity_1\">%1$lld</value> <keyword id=\"poison\">Poison</keyword> or <keyword id=\"bleed\">Bleed</keyword> damage every other turn."}},
        "es": {"stringUnit": {"state": "translated", "value": "Inflige <value id=\"quantity_1\">%1$lld</value> de daño de <keyword id=\"poison\">Veneno</keyword> o <keyword id=\"bleed\">Sangrado</keyword> cada dos turnos."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Inflige <value id=\"quantity_1\">%1$lld</value> de dégâts de <keyword id=\"poison\">Poison</keyword> ou de <keyword id=\"bleed\">Saignement</keyword> un tour sur deux."}},
        "ja": {"stringUnit": {"state": "translated", "value": "1ターンおきに<keyword id=\"poison\">毒</keyword>か<keyword id=\"bleed\">出血</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "한 턴 걸러 <keyword id=\"poison\">독</keyword> 또는 <keyword id=\"bleed\">출혈</keyword> 피해를 <value id=\"quantity_1\">%1$lld</value> 준다."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Causa <value id=\"quantity_1\">%1$lld</value> de dano de <keyword id=\"poison\">Veneno</keyword> ou de <keyword id=\"bleed\">Sangramento</keyword> a cada dois turnos."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每隔一回合造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"poison\">中毒</keyword>或<keyword id=\"bleed\">流血</keyword>傷害。"}}
      }
    },
    "traits.blighted_pulse.name": {
      "comment": "ContentManifest/traits.tsv: blighted_pulse, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Pestpuls"}},
        "en": {"stringUnit": {"state": "translated", "value": "Blighted Pulse"}},
        "es": {"stringUnit": {"state": "translated", "value": "Pulso de plaga"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Pulsation flétrie"}},
        "ja": {"stringUnit": {"state": "translated", "value": "疫病の脈動"}},
        "ko": {"stringUnit": {"state": "translated", "value": "역병의 파동"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Pulso da Praga"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "枯萎脈衝"}}
      }
    },
    "traits.blood_scent.description": {
      "comment": "ContentManifest/traits.tsv: blood_scent, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Angriffe gegen <keyword id=\"bleed\">blutende</keyword> Gegner verursachen <value id=\"quantity_1\">%1$lld</value> zusätzlichen Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Attacks against <keyword id=\"bleed\">Bleeding</keyword> enemies deal <value id=\"quantity_1\">%1$lld</value> additional damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques contra enemigos con <keyword id=\"bleed\">Sangrado</keyword> infligen <value id=\"quantity_1\">%1$lld</value> de daño adicional"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques contre les ennemis sous <keyword id=\"bleed\">Saignement</keyword> infligent <value id=\"quantity_1\">%1$lld</value> dégâts supplémentaires"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">出血</keyword>状態の敵への攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">출혈</keyword> 상태의 적을 대상으로 하는 공격의 추가 피해 <value id=\"quantity_1\">%1$lld</value>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques contra inimigos com <keyword id=\"bleed\">Sangramento</keyword> causam <value id=\"quantity_1\">%1$lld</value> de dano adicional"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "對<keyword id=\"bleed\">流血</keyword>敵人的攻擊額外造成<value id=\"quantity_1\">%1$lld</value>點傷害"}}
      }
    },
    "traits.blood_scent.name": {
      "comment": "ContentManifest/traits.tsv: blood_scent, name",
