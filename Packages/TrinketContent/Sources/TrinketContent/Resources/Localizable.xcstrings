    "traits.gathering_zeal.description": {
      "comment": "ContentManifest/traits.tsv: gathering_zeal, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Jeder Treffer vom Typ <keyword id=\"holy\">Heilig</keyword> fügt dem nächsten eigenen Angriff <value id=\"quantity_1\">%1$lld</value> Schaden vom Typ <keyword id=\"holy\">Heilig</keyword> hinzu."}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">Holy</keyword> hits add <value id=\"quantity_1\">%1$lld</value> <keyword id=\"holy\">Holy</keyword> damage to its next attack."}},
        "es": {"stringUnit": {"state": "translated", "value": "Cada impacto <keyword id=\"holy\">Sagrado</keyword> añade <value id=\"quantity_1\">%1$lld</value> de daño <keyword id=\"holy\">Sagrado</keyword> al siguiente ataque de quien lo realiza."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Chaque coup de type <keyword id=\"holy\">Sacré</keyword> ajoute <value id=\"quantity_1\">%1$lld</value> de dégâts de type <keyword id=\"holy\">Sacré</keyword> à la prochaine attaque de son auteur."}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">聖</keyword>ダメージの各ヒットで、自身の次の攻撃に<keyword id=\"holy\">聖</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>追加する。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">신성</keyword> 타격이 적중할 때마다 자신의 다음 공격에 <keyword id=\"holy\">신성</keyword> 피해를 <value id=\"quantity_1\">%1$lld</value> 추가한다."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cada acerto <keyword id=\"holy\">Sagrado</keyword> adiciona <value id=\"quantity_1\">%1$lld</value> de dano <keyword id=\"holy\">Sagrado</keyword> ao próximo ataque de quem o realiza."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每次<keyword id=\"holy\">神聖</keyword>打擊命中時，為自身下次攻擊增加<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"holy\">神聖</keyword>傷害。"}}
      }
    },
    "traits.gathering_zeal.name": {
      "comment": "ContentManifest/traits.tsv: gathering_zeal, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wachsender Eifer"}},
        "en": {"stringUnit": {"state": "translated", "value": "Gathering Zeal"}},
        "es": {"stringUnit": {"state": "translated", "value": "Fervor creciente"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Zèle croissant"}},
        "ja": {"stringUnit": {"state": "translated", "value": "高まる熱意"}},
        "ko": {"stringUnit": {"state": "translated", "value": "쌓이는 열의"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Zelo Crescente"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "熱忱累積"}}
      }
    },
    "traits.gelatinous_body.description": {
      "comment": "ContentManifest/traits.tsv: gelatinous_body, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erlittener <keyword id=\"physical\">physischer</keyword> Schaden um <value id=\"quantity_1\">%1$lld</value>%% verringert"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">Physical</keyword> damage taken reduced by <value id=\"quantity_1\">%1$lld</value>%%"}},
        "es": {"stringUnit": {"state": "translated", "value": "Daño <keyword id=\"physical\">físico</keyword> recibido reducido en un <value id=\"quantity_1\">%1$lld</value>%%"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Dégâts de type <keyword id=\"physical\">Physique</keyword> subis réduits de <value id=\"quantity_1\">%1$lld</value>%%"}},
        "ja": {"stringUnit": {"state": "translated", "value": "受ける<keyword id=\"physical\">物理</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%減少"}},
        "ko": {"stringUnit": {"state": "translated", "value": "받는 <keyword id=\"physical\">물리</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>%% 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Dano <keyword id=\"physical\">Físico</keyword> recebido reduzido em <value id=\"quantity_1\">%1$lld</value>%%"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "承受的<keyword id=\"physical\">物理</keyword>傷害降低<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "traits.gelatinous_body.name": {
      "comment": "ContentManifest/traits.tsv: gelatinous_body, name",
