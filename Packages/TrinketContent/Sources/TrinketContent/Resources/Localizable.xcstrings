    "talents.golden_retriever_block_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: golden_retriever_block_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wenn du in einem Zug erstmals <keyword id=\"block\">Block</keyword> erhältst, erhält dein Verbündeter ebenso viel"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your first <keyword id=\"block\">Block</keyword> gain each turn is shared with your ally"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu primera obtención de <keyword id=\"block\">Bloqueo</keyword> de cada turno se comparte con tu aliado"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre premier gain de <keyword id=\"block\">Blocage</keyword> de chaque tour est partagé avec votre allié"}},
        "ja": {"stringUnit": {"state": "translated", "value": "各ターンで最初の<keyword id=\"block\">ブロック</keyword>獲得量を味方とも共有"}},
        "ko": {"stringUnit": {"state": "translated", "value": "매 턴 첫 <keyword id=\"block\">방어도</keyword> 획득량을 아군과 공유"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seu primeiro ganho de <keyword id=\"block\">Bloqueio</keyword> de cada turno é compartilhado com seu aliado"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每回合首次獲得的<keyword id=\"block\">格擋</keyword>與友方共享"}}
      }
    },
    "talents.golden_retriever_block_t2_1.name": {
      "comment": "ContentManifest/talents.tsv: golden_retriever_block_t2_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Schildbund"}},
        "en": {"stringUnit": {"state": "translated", "value": "Shield Bond"}},
        "es": {"stringUnit": {"state": "translated", "value": "Vínculo de escudo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Lien du bouclier"}},
        "ja": {"stringUnit": {"state": "translated", "value": "盾の絆"}},
        "ko": {"stringUnit": {"state": "translated", "value": "방패의 유대"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Laço de Escudo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "護盾羈絆"}}
      }
    },
    "talents.golden_retriever_block_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: golden_retriever_block_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verbündete mit <keyword id=\"block\">Block</keyword> erhalten +<value id=\"quantity_1\">%1$lld</value>%% <keyword id=\"dodge\">Ausweichen</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Allies with <keyword id=\"block\">Block</keyword> gain +<value id=\"quantity_1\">%1$lld</value>%% <keyword id=\"dodge\">Dodge</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los aliados con <keyword id=\"block\">Bloqueo</keyword> obtienen +<value id=\"quantity_1\">%1$lld</value>%% de <keyword id=\"dodge\">Esquiva</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les alliés ayant du <keyword id=\"block\">Blocage</keyword> gagnent +<value id=\"quantity_1\">%1$lld</value>%% d’<keyword id=\"dodge\">Esquive</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">ブロック</keyword>を持つ味方は<keyword id=\"dodge\">回避</keyword>が+<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">방어도</keyword>가 있는 아군의 <keyword id=\"dodge\">회피</keyword>가 +<value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Aliados com <keyword id=\"block\">Bloqueio</keyword> recebem +<value id=\"quantity_1\">%1$lld</value>%% de <keyword id=\"dodge\">Esquiva</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "擁有<keyword id=\"block\">格擋</keyword>的盟友獲得+<value id=\"quantity_1\">%1$lld</value>%%<keyword id=\"dodge\">閃避</keyword>"}}
      }
    },
    "talents.golden_retriever_block_t2_2.name": {
      "comment": "ContentManifest/talents.tsv: golden_retriever_block_t2_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Warnbellen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Warning Bark"}},
        "es": {"stringUnit": {"state": "translated", "value": "Ladrido de aviso"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Aboiement d’alerte"}},
        "ja": {"stringUnit": {"state": "translated", "value": "警告の吠え声"}},
        "ko": {"stringUnit": {"state": "translated", "value": "경고의 짖음"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Latido de Alerta"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "警告吠聲"}}
      }
    },
    "talents.golden_retriever_block_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: golden_retriever_block_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dein <keyword id=\"block\">Block</keyword> absorbiert auch Schaden an deinem Verbündeten"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your <keyword id=\"block\">Block</keyword> also absorbs damage dealt to your ally"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu <keyword id=\"block\">Bloqueo</keyword> también absorbe el daño infligido a tu aliado"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre <keyword id=\"block\">Blocage</keyword> absorbe aussi les dégâts infligés à votre allié"}},
        "ja": {"stringUnit": {"state": "translated", "value": "自分の<keyword id=\"block\">ブロック</keyword>が味方へのダメージも吸収"}},
        "ko": {"stringUnit": {"state": "translated", "value": "내 <keyword id=\"block\">방어도</keyword>가 아군에게 가해지는 피해도 흡수"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seu <keyword id=\"block\">Bloqueio</keyword> também absorve dano causado ao seu aliado"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "自身<keyword id=\"block\">格擋</keyword>也會吸收友方承受的傷害"}}
      }
    },
    "talents.golden_retriever_block_t3_1.name": {
      "comment": "ContentManifest/talents.tsv: golden_retriever_block_t3_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Aufopfernder Schutz"}},
        "en": {"stringUnit": {"state": "translated", "value": "Sacrificial Guard"}},
        "es": {"stringUnit": {"state": "translated", "value": "Guardia de sacrificio"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Garde sacrificielle"}},
        "ja": {"stringUnit": {"state": "translated", "value": "献身の守り"}},
        "ko": {"stringUnit": {"state": "translated", "value": "희생의 수호"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Guarda Sacrificial"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "犧牲守護"}}
      }
    },
    "talents.golden_retriever_block_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: golden_retriever_block_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Solange du <keyword id=\"block\">Block</keyword> hast, verhindere den Aufbau von <keyword id=\"stun\">Betäubung</keyword> und <keyword id=\"freeze\">Frost</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "While you have <keyword id=\"block\">Block</keyword>, prevent <keyword id=\"stun\">Stun</keyword> and <keyword id=\"freeze\">Freeze</keyword> build-up"}},
        "es": {"stringUnit": {"state": "translated", "value": "Mientras tienes <keyword id=\"block\">Bloqueo</keyword>, impide la acumulación de <keyword id=\"stun\">Aturdimiento</keyword> y <keyword id=\"freeze\">Congelación</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Tant que vous avez du <keyword id=\"block\">Blocage</keyword>, empêchez l’accumulation d’<keyword id=\"stun\">Étourdissement</keyword> et de <keyword id=\"freeze\">Gel</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">ブロック</keyword>がある間、<keyword id=\"stun\">スタン</keyword>と<keyword id=\"freeze\">凍結</keyword>の蓄積を防ぐ"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">방어도</keyword>가 있으면 <keyword id=\"stun\">기절</keyword> 및 <keyword id=\"freeze\">빙결</keyword> 축적 방지"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Enquanto tiver <keyword id=\"block\">Bloqueio</keyword>, impeça acúmulo de <keyword id=\"stun\">Atordoamento</keyword> e de <keyword id=\"freeze\">Congelamento</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "擁有<keyword id=\"block\">格擋</keyword>時，防止<keyword id=\"stun\">暈眩</keyword>與<keyword id=\"freeze\">冰凍</keyword>累積"}}
      }
    },
    "talents.golden_retriever_block_t3_2.name": {
      "comment": "ContentManifest/talents.tsv: golden_retriever_block_t3_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Standhaft"}},
        "en": {"stringUnit": {"state": "translated", "value": "Steadfast"}},
        "es": {"stringUnit": {"state": "translated", "value": "Inquebrantable"}},
