    "talents.ranger_poison_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: ranger_poison_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Vergiftete</keyword> Gegner haben <value id=\"quantity_1\">%1$lld</value>%% weniger Treffergenauigkeit"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Poisoned</keyword> enemies have <value id=\"quantity_1\">%1$lld</value>%% less accuracy"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los enemigos <keyword id=\"poison\">envenenados</keyword> tienen un <value id=\"quantity_1\">%1$lld</value>%% menos de precisión"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les ennemis sous <keyword id=\"poison\">Poison</keyword> ont <value id=\"quantity_1\">%1$lld</value>%% de précision en moins"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">毒</keyword>状態の敵の命中率が<value id=\"quantity_1\">%1$lld</value>%%低下"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">독</keyword> 상태의 적의 명중률 <value id=\"quantity_1\">%1$lld</value>%% 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Inimigos <keyword id=\"poison\">Envenenados</keyword> têm <value id=\"quantity_1\">%1$lld</value>%% menos precisão"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">中毒</keyword>的敵人命中率降低<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
