    "affixes.frozen_pocketwatch.astral_description": {
      "comment": "ContentManifest/affixes.tsv: frozen_pocketwatch, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"freeze\">Frost</keyword> hält mit <value id=\"quantity_1\">%1$lld</value>%% Chance einen zusätzlichen Zug an"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"freeze\">Freeze</keyword> has a <value id=\"quantity_1\">%1$lld</value>%% chance to last an additional turn"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le <keyword id=\"freeze\">Gel</keyword> a <value id=\"quantity_1\">%1$lld</value>%% de chances de durer un tour de plus"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"freeze\">凍結</keyword>が<value id=\"quantity_1\">%1$lld</value>%%の確率でさらに1ターン持続"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"freeze\">빙결</keyword>이 <value id=\"quantity_1\">%1$lld</value>%% 확률로 1턴 더 지속"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"freeze\">冰凍</keyword>有<value id=\"quantity_1\">%1$lld</value>%%機率額外持續一回合"
          }
        }
      }
    },
