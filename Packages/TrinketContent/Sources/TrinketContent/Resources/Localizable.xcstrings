        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos soins excédentaires rendent votre prochain renforcement au <keyword id=\"mana\">Mana</keyword> gratuit"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分が過剰回復を行うと、次の<keyword id=\"mana\">マナ</keyword>強化の消費がなくなる"
          }
