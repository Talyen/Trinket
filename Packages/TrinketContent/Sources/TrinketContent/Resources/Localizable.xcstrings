        "ja": {"stringUnit": {"state": "translated", "value": "死角"}},
        "ko": {"stringUnit": {"state": "translated", "value": "사각지대"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ponto Cego"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "死角"}}
