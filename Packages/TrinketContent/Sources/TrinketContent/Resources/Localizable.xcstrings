    "talents.wolf_dodge_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: wolf_dodge_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
