    "talents.wizard_burn_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: wizard_burn_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
