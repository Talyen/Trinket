    "traits.crimson_pulse.description": {
      "comment": "ContentManifest/traits.tsv: crimson_pulse, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verursacht jeden zweiten Zug <value id=\"quantity_1\">%1$lld</value> Schaden durch <keyword id=\"bleed\">Blutung</keyword>."}},
        "en": {"stringUnit": {"state": "translated", "value": "Deals <value id=\"quantity_1\">%1$lld</value> <keyword id=\"bleed\">Bleed</keyword> damage every other turn."}},
        "es": {"stringUnit": {"state": "translated", "value": "Inflige <value id=\"quantity_1\">%1$lld</value> de daño de <keyword id=\"bleed\">Sangrado</keyword> cada dos turnos."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Inflige <value id=\"quantity_1\">%1$lld</value> de dégâts de <keyword id=\"bleed\">Saignement</keyword> un tour sur deux."}},
        "ja": {"stringUnit": {"state": "translated", "value": "1ターンおきに<keyword id=\"bleed\">出血</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "한 턴 걸러 <keyword id=\"bleed\">출혈</keyword> 피해를 <value id=\"quantity_1\">%1$lld</value> 준다."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Causa <value id=\"quantity_1\">%1$lld</value> de dano de <keyword id=\"bleed\">Sangramento</keyword> a cada dois turnos."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每隔一回合造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"bleed\">流血</keyword>傷害。"}}
      }
    },
    "traits.crimson_pulse.name": {
      "comment": "ContentManifest/traits.tsv: crimson_pulse, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Blutroter Puls"}},
        "en": {"stringUnit": {"state": "translated", "value": "Crimson Pulse"}},
        "es": {"stringUnit": {"state": "translated", "value": "Pulso carmesí"}},
