    "affixes.meteorite.astral_description": {
      "comment": "ContentManifest/affixes.tsv: meteorite, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">Brand</keyword>-Karten können zusätzliches <keyword id=\"mana\">Mana</keyword> ausgeben, um mehr Schaden zu verursachen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">Burn</keyword> cards can spend additional <keyword id=\"mana\">Mana</keyword> to deal more damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cartes de <keyword id=\"burn\">Brûlure</keyword> peuvent dépenser du <keyword id=\"mana\">Mana</keyword> supplémentaire pour infliger plus de dégâts"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">炎上</keyword>カードで追加の<keyword id=\"mana\">マナ</keyword>を消費し、ダメージを増加できる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">화상</keyword> 카드가 <keyword id=\"mana\">마나</keyword>를 추가로 소모해 더 큰 피해를 줄 수 있음"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">燃燒</keyword>卡牌可消耗額外<keyword id=\"mana\">魔力</keyword>，造成更多傷害"
          }
        }
      }
    },
