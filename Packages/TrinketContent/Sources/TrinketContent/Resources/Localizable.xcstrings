        "de": {"stringUnit": {"state": "translated", "value": "Überladung"}},
        "en": {"stringUnit": {"state": "translated", "value": "Overcharge"}},
        "es": {"stringUnit": {"state": "translated", "value": "Sobrecarga"}},
