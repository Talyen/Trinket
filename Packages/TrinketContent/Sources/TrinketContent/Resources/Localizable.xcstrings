    "talents.mana_moth_freeze_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: mana_moth_freeze_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Kritische <keyword id=\"freeze\">Frost</keyword>-Treffer verringern die Treffergenauigkeit des nächsten gegnerischen Angriffs um <value id=\"quantity_1\">%1$lld</value>%%"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">Freeze</keyword> Critical Hits reduce the enemy's next attack accuracy by <value id=\"quantity_1\">%1$lld</value>%%"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los golpes críticos de <keyword id=\"freeze\">Congelación</keyword> reducen la precisión del siguiente ataque del enemigo en un <value id=\"quantity_1\">%1$lld</value>%%"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les coups critiques de <keyword id=\"freeze\">Gel</keyword> réduisent de <value id=\"quantity_1\">%1$lld</value>%% la précision de la prochaine attaque ennemie"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">凍結</keyword>クリティカルヒットで敵の次の攻撃の命中率が<value id=\"quantity_1\">%1$lld</value>%%低下"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">빙결</keyword> 치명타가 적의 다음 공격 명중률 <value id=\"quantity_1\">%1$lld</value>%% 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Golpes críticos de <keyword id=\"freeze\">Congelamento</keyword> reduzem a precisão do próximo ataque inimigo em <value id=\"quantity_1\">%1$lld</value>%%"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">冰凍</keyword>暴擊使敵人下次攻擊的命中率降低<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
