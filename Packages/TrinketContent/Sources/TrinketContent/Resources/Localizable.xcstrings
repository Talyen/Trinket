    "authored.aa0189767d847d85": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Encounters/Mystery/MysteryEventPool+Events.swift: narrative",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glitzernde Kristalle enthüllen „%1$@“, während massiver Stein „%2$@“ umklammert"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glittering crystals reveal “%1$@” while thick stone grips “%2$@”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des cristaux scintillants révèlent « %1$@ », tandis qu’une épaisse gangue de pierre retient « %2$@ »"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "きらめく水晶が「%1$@」を明かし、分厚い岩が「%2$@」をつかんでいる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반짝이는 수정이 드러낸 것은 ‘%1$@’, 두꺼운 돌이 붙잡은 것은 ‘%2$@’입니다"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "閃爍水晶顯露出「%1$@」，厚重岩石緊握著「%2$@」"
          }
        }
      }
    },
