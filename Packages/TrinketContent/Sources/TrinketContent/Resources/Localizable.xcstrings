    "authored.95448989a64f2d08": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kritische Treffer lassen den gesamten verbleibenden <keyword id=\"bleed\">Blutungs</keyword>- und <keyword id=\"poison\">Gift</keyword>schaden detonieren und verbrauchen ihn"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Critical Hits detonate and consume all remaining <keyword id=\"bleed\">Bleed</keyword> and <keyword id=\"poison\">Poison</keyword> damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les coups critiques font exploser et consomment tous les dégâts restants de <keyword id=\"bleed\">Saignement</keyword> et de <keyword id=\"poison\">Poison</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリティカルヒット時に残りの<keyword id=\"bleed\">出血</keyword>と<keyword id=\"poison\">毒</keyword>ダメージをすべて炸裂させて消費"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "치명타가 남아 있는 모든 <keyword id=\"bleed\">출혈</keyword> 및 <keyword id=\"poison\">독</keyword> 피해를 폭발시키고 소모"
          }
        },
        "zh-Hant": {
