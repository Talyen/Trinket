    "talents.panther_leech_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: panther_leech_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gegner können durch <keyword id=\"leech\">Lebensraub</keyword> gegen dich keine Gesundheit wiederherstellen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enemies cannot <keyword id=\"leech\">Leech</keyword> from you"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les ennemis ne peuvent pas vous infliger de <keyword id=\"leech\">Vol de vie</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "敵は自分から<keyword id=\"leech\">吸収</keyword>できない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적이 내게서 <keyword id=\"leech\">흡혈</keyword>할 수 없음"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "敵人無法從你身上<keyword id=\"leech\">吸血</keyword>"
          }
        }
      }
    },
