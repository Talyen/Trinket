    "talents.panther_dodge_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: panther_dodge_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte Chance auf kritische Treffer in Höhe der Hälfte deiner Chance auf <keyword id=\"dodge\">Ausweichen</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gain Critical Hit chance equal to half your <keyword id=\"dodge\">Dodge</keyword> chance"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagnez des chances de coup critique à hauteur de la moitié de vos chances d’<keyword id=\"dodge\">Esquive</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の<keyword id=\"dodge\">回避</keyword>率の半分に等しいクリティカル率を獲得"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 <keyword id=\"dodge\">회피</keyword> 확률의 절반만큼 치명타 확률 증가"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "獲得相當於自身<keyword id=\"dodge\">閃避</keyword>機率一半的暴擊機率"
          }
        }
      }
    },
