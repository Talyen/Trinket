    "talents.pixie_cleanse_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: pixie_cleanse_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Reinigen entfernt auch den gesamten <keyword id=\"freeze\">Frost</keyword>-Aufbau des Ziels"}},
        "en": {"stringUnit": {"state": "translated", "value": "Cleansing also removes all <keyword id=\"freeze\">Freeze</keyword> build-up from the target"}},
        "es": {"stringUnit": {"state": "translated", "value": "Purificar también elimina toda la acumulación de <keyword id=\"freeze\">Congelación</keyword> del objetivo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Purifier retire aussi toute l’accumulation de <keyword id=\"freeze\">Gel</keyword> de la cible"}},
        "ja": {"stringUnit": {"state": "translated", "value": "浄化すると対象の<keyword id=\"freeze\">凍結</keyword>蓄積もすべて除去"}},
        "ko": {"stringUnit": {"state": "translated", "value": "정화 시 대상의 모든 <keyword id=\"freeze\">빙결</keyword> 축적량도 제거"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Purificar também remove todo o acúmulo de <keyword id=\"freeze\">Congelamento</keyword> do alvo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "淨化時也會移除目標所有<keyword id=\"freeze\">冰凍</keyword>累積量"}}
      }
    },
