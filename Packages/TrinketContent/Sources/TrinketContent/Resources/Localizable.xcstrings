        "zh-Hant": {"stringUnit": {"state": "translated", "value": "閃避時有<value id=\"quantity_1\">%1$lld</value>%%機率造成<value id=\"quantity_2\">%2$lld</value>點<keyword id=\"physical\">物理</keyword>傷害"}}
