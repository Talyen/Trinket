    "affixes.lastlight.astral_description": {
      "comment": "ContentManifest/affixes.tsv: lastlight, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erhalte <value id=\"quantity_1\">%1$lld</value>%% Chance auf kritische Treffer, solange du an der <keyword id=\"deathsdoor\">Todesschwelle</keyword> stehst"}},
        "en": {"stringUnit": {"state": "translated", "value": "Gain <value id=\"quantity_1\">%1$lld</value>%% Critical chance while on <keyword id=\"deathsdoor\">Death's Door</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Obtén un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de crítico mientras estás a las <keyword id=\"deathsdoor\">Puertas de la Muerte</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Gagnez <value id=\"quantity_1\">%1$lld</value>%% de chances de coup critique au <keyword id=\"deathsdoor\">Seuil de la mort</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">死の淵</keyword>の間、クリティカル率が<value id=\"quantity_1\">%1$lld</value>%%上昇"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">죽음의 문턱</keyword> 상태이면 치명타 확률 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ganhe <value id=\"quantity_1\">%1$lld</value>%% de chance de crítico enquanto estiver <keyword id=\"deathsdoor\">À Beira da Morte</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "處於<keyword id=\"deathsdoor\">瀕死之門</keyword>時，暴擊機率提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
