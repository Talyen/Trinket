    "affixes.sanctum.title": {
      "comment": "ContentManifest/affixes.tsv: sanctum, title",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Heiligtum"}},
        "en": {"stringUnit": {"state": "translated", "value": "Sanctum"}},
        "es": {"stringUnit": {"state": "translated", "value": "Santuario"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Sanctuaire intérieur"}},
        "ja": {"stringUnit": {"state": "translated", "value": "聖域"}},
        "ko": {"stringUnit": {"state": "translated", "value": "성소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Santuário Sagrado"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "聖所"}}
      }
    },
    "affixes.scarfeast.astral_description": {
      "comment": "ContentManifest/affixes.tsv: scarfeast, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">Physische</keyword> Angriffe erhalten <keyword id=\"leech\">Lebensraub</keyword>, solange du unter halber <keyword id=\"health\">Gesundheit</keyword> bist"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">Physical</keyword> attacks gain <keyword id=\"leech\">Leech</keyword> while you're below half <keyword id=\"health\">Health</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques <keyword id=\"physical\">físicos</keyword> obtienen <keyword id=\"leech\">Absorción</keyword> mientras estás por debajo de la mitad de <keyword id=\"health\">Salud</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques de type <keyword id=\"physical\">Physique</keyword> bénéficient de <keyword id=\"leech\">Vol de vie</keyword> sous la moitié de votre <keyword id=\"health\">Santé</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>が半分未満の間、<keyword id=\"physical\">物理</keyword>攻撃に<keyword id=\"leech\">吸収</keyword>を付与"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword>이 절반 미만이면 <keyword id=\"physical\">물리</keyword> 공격에 <keyword id=\"leech\">흡혈</keyword> 부여"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques <keyword id=\"physical\">Físicos</keyword> ganham <keyword id=\"leech\">Drenagem</keyword> enquanto você estiver abaixo de metade da <keyword id=\"health\">Vida</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "自身<keyword id=\"health\">生命值</keyword>低於一半時，<keyword id=\"physical\">物理</keyword>攻擊獲得<keyword id=\"leech\">吸血</keyword>"}}
      }
    },
    "affixes.scarfeast.basic_description": {
