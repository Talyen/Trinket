    "talents.lizard_scout_poison_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: lizard_scout_poison_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Gift</keyword> auf Gegnern nimmt mit <value id=\"quantity_1\">%1$lld</value>%% Chance nicht ab"}},
        "en": {"stringUnit": {"state": "translated", "value": "Enemy <keyword id=\"poison\">Poison</keyword> has a <value id=\"quantity_1\">%1$lld</value>%% chance to avoid fading"}},
        "es": {"stringUnit": {"state": "translated", "value": "El <keyword id=\"poison\">Veneno</keyword> que afecta al enemigo tiene un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de no disminuir"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le <keyword id=\"poison\">Poison</keyword> affectant l’ennemi a <value id=\"quantity_1\">%1$lld</value>%% de chances de ne pas diminuer"}},
        "ja": {"stringUnit": {"state": "translated", "value": "敵にかかった<keyword id=\"poison\">毒</keyword>が<value id=\"quantity_1\">%1$lld</value>%%の確率で減衰しない"}},
        "ko": {"stringUnit": {"state": "translated", "value": "적에게 걸린 <keyword id=\"poison\">독</keyword>이 <value id=\"quantity_1\">%1$lld</value>%% 확률로 감소하지 않음"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O <keyword id=\"poison\">Veneno</keyword> no inimigo tem <value id=\"quantity_1\">%1$lld</value>%% de chance de não diminuir"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "敵人身上的<keyword id=\"poison\">中毒</keyword>有<value id=\"quantity_1\">%1$lld</value>%%機率不衰減"}}
      }
    },
    "talents.lizard_scout_poison_t3_2.name": {
