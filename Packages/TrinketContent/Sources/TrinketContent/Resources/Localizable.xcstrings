    "authored.12fdafc7a89108bc": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog+Ranged.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du deine zweite Karte in einem Zug spielst, ziehe eine Karte und erhalte bis zu deinem nächsten Zug <value id=\"quantity_1\">%1$lld</value>%% Chance auf <keyword id=\"dodge\">Ausweichen</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Playing your second card each turn draws a card and grants <value id=\"quantity_1\">%1$lld</value>%% <keyword id=\"dodge\">Dodge</keyword> until your next turn"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouer votre deuxième carte de chaque tour fait piocher une carte et octroie <value id=\"quantity_1\">%1$lld</value>%% d’<keyword id=\"dodge\">Esquive</keyword> jusqu’à votre prochain tour"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ターンに2枚目のカードを使うと、カードを1枚引き、次の自分のターンまで<keyword id=\"dodge\">回避</keyword>率が<value id=\"quantity_1\">%1$lld</value>%%上昇"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매 턴 두 번째 카드 사용 시 카드 한 장을 뽑고 다음 내 턴까지 <keyword id=\"dodge\">회피</keyword> 확률 <value id=\"quantity_1\">%1$lld</value>%% 증가"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每回合打出第二張牌時，抽一張牌，且<keyword id=\"dodge\">閃避</keyword>機率提高<value id=\"quantity_1\">%1$lld</value>%%，直到下個自身回合"
          }
        }
      }
    },
