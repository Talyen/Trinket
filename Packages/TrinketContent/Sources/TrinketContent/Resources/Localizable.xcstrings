    "affixes.vanguards_crest.astral_description": {
      "comment": "ContentManifest/affixes.tsv: vanguards_crest, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erhalte <keyword id=\"block\">Block</keyword> in Höhe der Hälfte deines <keyword id=\"physical\">physischen</keyword> Schadens"}},
        "en": {"stringUnit": {"state": "translated", "value": "Gain <keyword id=\"block\">Block</keyword> equal to half your <keyword id=\"physical\">Physical</keyword> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Obtén <keyword id=\"block\">Bloqueo</keyword> equivalente a la mitad de tu daño <keyword id=\"physical\">físico</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Gagnez du <keyword id=\"block\">Blocage</keyword> à hauteur de la moitié de vos dégâts de type <keyword id=\"physical\">Physique</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "自分の<keyword id=\"physical\">物理</keyword>ダメージの半分に等しい<keyword id=\"block\">ブロック</keyword>を獲得"}},
        "ko": {"stringUnit": {"state": "translated", "value": "내 <keyword id=\"physical\">물리</keyword> 피해의 절반만큼 <keyword id=\"block\">방어도</keyword> 획득"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ganhe <keyword id=\"block\">Bloqueio</keyword> equivalente à metade do seu dano <keyword id=\"physical\">Físico</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "獲得相當於自身<keyword id=\"physical\">物理</keyword>傷害一半的<keyword id=\"block\">格擋</keyword>"}}
      }
    },
    "affixes.vanguards_crest.basic_description": {
      "comment": "ContentManifest/affixes.tsv: vanguards_crest, basic_description",
      "extractionState": "manual",
      "localizations": {
