    "talents.fox_stun_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: fox_stun_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Betäuben eines Gegners lässt deinen nächsten Angriff kritisch treffen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stunning an enemy makes your next attack Critically Hit"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Étourdir un ennemi garantit un coup critique à votre prochaine attaque"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "敵をスタン状態にすると、次の攻撃が必ずクリティカルヒット"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적을 기절시키면 다음 공격이 반드시 치명타"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使敵人暈眩後，下次攻擊必定暴擊"
          }
        }
      }
    },
