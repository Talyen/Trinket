    "talents.mana_moth_freeze_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: mana_moth_freeze_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verstärken mit <keyword id=\"mana\">Mana</keyword> erhöht den <keyword id=\"freeze\">Frost</keyword>-Aufbau um <value id=\"quantity_1\">%1$lld</value>%%"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">Mana</keyword> empowerment increases <keyword id=\"freeze\">Freeze</keyword> build-up by <value id=\"quantity_1\">%1$lld</value>%%"}},
        "es": {"stringUnit": {"state": "translated", "value": "Potenciar con <keyword id=\"mana\">Maná</keyword> aumenta la acumulación de <keyword id=\"freeze\">Congelación</keyword> en un <value id=\"quantity_1\">%1$lld</value>%%"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Un renforcement au <keyword id=\"mana\">Mana</keyword> augmente l’accumulation de <keyword id=\"freeze\">Gel</keyword> de <value id=\"quantity_1\">%1$lld</value>%%"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">マナ</keyword>で強化すると<keyword id=\"freeze\">凍結</keyword>蓄積量が<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">마나</keyword>로 강화 시 <keyword id=\"freeze\">빙결</keyword> 축적량 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Fortalecer com <keyword id=\"mana\">Mana</keyword> aumenta o acúmulo de <keyword id=\"freeze\">Congelamento</keyword> em <value id=\"quantity_1\">%1$lld</value>%%"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "以<keyword id=\"mana\">魔力</keyword>強化時，<keyword id=\"freeze\">冰凍</keyword>累積量增加<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
