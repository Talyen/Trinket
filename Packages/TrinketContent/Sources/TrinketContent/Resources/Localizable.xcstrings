    "talents.risen_skeleton_deathsdoor_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_deathsdoor_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angriffe erhalten <keyword id=\"leech\">Lebensraub</keyword>, solange du an der <keyword id=\"deathsdoor\">Todesschwelle</keyword> stehst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attacks gain <keyword id=\"leech\">Leech</keyword> while on <keyword id=\"deathsdoor\">Death's Door</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les attaques bénéficient de <keyword id=\"leech\">Vol de vie</keyword> au <keyword id=\"deathsdoor\">Seuil de la mort</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"deathsdoor\">死の淵</keyword>の間、攻撃に<keyword id=\"leech\">吸収</keyword>を付与"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"deathsdoor\">죽음의 문턱</keyword> 상태이면 공격에 <keyword id=\"leech\">흡혈</keyword> 부여"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "處於<keyword id=\"deathsdoor\">瀕死之門</keyword>時，攻擊獲得<keyword id=\"leech\">吸血</keyword>"
          }
        }
      }
    },
