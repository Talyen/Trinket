    "talents.golden_retriever_health_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: golden_retriever_health_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fange in jedem Kampf den ersten Schaden ab, der die <keyword id=\"health\">Gesundheit</keyword> deines Verbündeten auf null senken würde"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Intercept the first damage each combat that would reduce your ally's <keyword id=\"health\">Health</keyword> to zero"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Interceptez les premiers dégâts de chaque combat qui réduiraient la <keyword id=\"health\">Santé</keyword> de votre allié à zéro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各戦闘で初めて味方の<keyword id=\"health\">体力</keyword>を0にするダメージを引き受ける"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매 전투 아군의 <keyword id=\"health\">체력</keyword>을 0으로 만들 첫 피해를 대신 받음"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每場戰鬥首次有傷害將使友方<keyword id=\"health\">生命值</keyword>歸零時，代為承受"
          }
        }
      }
    },
