    "authored.62f91beb09391622": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog+Offhand.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Behalte <keyword id=\"block\">Block</keyword> zwischen deinen Zügen\nAusweichen verbraucht die Hälfte deines <keyword id=\"block\">Blocks</keyword>, um ebenso viel <keyword id=\"physical\">physischen</keyword> Schaden zu verursachen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Keep <keyword id=\"block\">Block</keyword> between turns\nDodging spends half your <keyword id=\"block\">Block</keyword> to deal that much <keyword id=\"physical\">Physical</keyword> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Conserva <keyword id=\"block\">Bloqueo</keyword> entre turnos\nEsquivar gasta la mitad de tu <keyword id=\"block\">Bloqueo</keyword> para infligir esa cantidad de daño <keyword id=\"physical\">físico</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Conservez le <keyword id=\"block\">Blocage</keyword> entre les tours\nUne esquive dépense la moitié de votre <keyword id=\"block\">Blocage</keyword> pour infliger autant de dégâts de type <keyword id=\"physical\">Physique</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "ターンをまたいで<keyword id=\"block\">ブロック</keyword>を保持\n回避すると<keyword id=\"block\">ブロック</keyword>の半分を消費し、同量の<keyword id=\"physical\">物理</keyword>ダメージを与える"}},
        "ko": {"stringUnit": {"state": "translated", "value": "턴이 바뀌어도 <keyword id=\"block\">방어도</keyword> 유지\n회피 시 내 <keyword id=\"block\">방어도</keyword>의 절반을 소모해 그만큼 <keyword id=\"physical\">물리</keyword> 피해"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Mantenha <keyword id=\"block\">Bloqueio</keyword> entre turnos\nEsquivar gasta metade do seu <keyword id=\"block\">Bloqueio</keyword> para causar essa quantidade de dano <keyword id=\"physical\">Físico</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "回合之間保留<keyword id=\"block\">格擋</keyword>\n閃避時消耗一半<keyword id=\"block\">格擋</keyword>，造成等量<keyword id=\"physical\">物理</keyword>傷害"}}
      }
    },
    "authored.631c19c743a036ed": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Encounters/Mystery/MysteryEventPool+Events.swift: narrative",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Heilpilze umgeben „%1$@“, während treibende Sporen sich über „%2$@“ sammeln"}},
        "en": {"stringUnit": {"state": "translated", "value": "Medicinal caps surround “%1$@” as drifting spores gather above “%2$@”"}},
        "es": {"stringUnit": {"state": "translated", "value": "Sombreros de hongos medicinales rodean «%1$@» mientras esporas flotantes se acumulan sobre «%2$@»"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Des chapeaux de champignons médicinaux entourent « %1$@ », tandis que des spores en suspension se rassemblent au-dessus de « %2$@ »"}},
        "ja": {"stringUnit": {"state": "translated", "value": "薬効のあるキノコが「%1$@」を囲み、漂う胞子が「%2$@」の上に集まっている"}},
        "ko": {"stringUnit": {"state": "translated", "value": "약용 버섯이 ‘%1$@’ 주위를 둘러싸고, 흩날리는 포자가 ‘%2$@’ 위에 모입니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Chapéus de cogumelos medicinais cercam “%1$@” enquanto esporos flutuantes se reúnem acima de “%2$@”"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "藥用菌蓋圍繞著「%1$@」，飄散的孢子在「%2$@」上方聚集"}}
      }
    },
    "authored.6498fb8aed5dfb99": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Encounters/Mystery/MysteryEventPool+Events.swift: narrative",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Kristallblüten umgeben „%1$@“, während Gartensteine neben „%2$@“ singen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Crystal blooms surround “%1$@” while garden stones sing beside “%2$@”"}},
        "es": {"stringUnit": {"state": "translated", "value": "Flores de cristal rodean «%1$@» mientras las piedras del jardín cantan junto a «%2$@»"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Des fleurs de cristal entourent « %1$@ », tandis que les pierres du jardin chantent près de « %2$@ »"}},
        "ja": {"stringUnit": {"state": "translated", "value": "水晶の花が「%1$@」を囲み、庭石が「%2$@」の傍らで歌っている"}},
        "ko": {"stringUnit": {"state": "translated", "value": "수정 꽃이 ‘%1$@’ 주위를 둘러싸고, 정원 돌이 ‘%2$@’ 곁에서 노래합니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Flores de cristal cercam “%1$@” enquanto pedras do jardim cantam ao lado de “%2$@”"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "水晶花圍繞著「%1$@」，庭園石頭在「%2$@」旁歌唱"}}
      }
    },
