    "affixes.bloodletting.astral_description": {
      "comment": "ContentManifest/affixes.tsv: bloodletting, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">Physische</keyword> Angriffe, die <keyword id=\"health\">Gesundheit</keyword> schädigen, verursachen mit <value id=\"quantity_1\">%1$lld</value>%% Chance <value id=\"quantity_2\">%2$lld</value> <keyword id=\"bleed\">Blutungsschaden</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">Physical</keyword> attacks that damage <keyword id=\"health\">Health</keyword> have a <value id=\"quantity_1\">%1$lld</value>%% chance to deal <value id=\"quantity_2\">%2$lld</value> <keyword id=\"bleed\">Bleed</keyword> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques <keyword id=\"physical\">físicos</keyword> que dañan la <keyword id=\"health\">Salud</keyword> tienen un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de infligir <value id=\"quantity_2\">%2$lld</value> de daño de <keyword id=\"bleed\">Sangrado</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques <keyword id=\"physical\">physiques</keyword> qui infligent des dégâts à la <keyword id=\"health\">Santé</keyword> ont <value id=\"quantity_1\">%1$lld</value>%% de chances d’infliger <value id=\"quantity_2\">%2$lld</value> dégâts de <keyword id=\"bleed\">Saignement</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>にダメージを与えた<keyword id=\"physical\">物理</keyword>攻撃は<value id=\"quantity_1\">%1$lld</value>%%の確率で<value id=\"quantity_2\">%2$lld</value>の<keyword id=\"bleed\">出血</keyword>ダメージを与える"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword>에 피해를 준 <keyword id=\"physical\">물리</keyword> 공격은 <value id=\"quantity_1\">%1$lld</value>%% 확률로 <keyword id=\"bleed\">출혈</keyword> 피해 <value id=\"quantity_2\">%2$lld</value> 추가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques <keyword id=\"physical\">físicos</keyword> que causam dano à <keyword id=\"health\">Vida</keyword> têm <value id=\"quantity_1\">%1$lld</value>%% de chance de causar <value id=\"quantity_2\">%2$lld</value> de dano de <keyword id=\"bleed\">Sangramento</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "對<keyword id=\"health\">生命值</keyword>造成傷害的<keyword id=\"physical\">物理</keyword>攻擊有<value id=\"quantity_1\">%1$lld</value>%%機率造成<value id=\"quantity_2\">%2$lld</value>點<keyword id=\"bleed\">流血</keyword>傷害"}}
      }
    },
