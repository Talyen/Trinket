    "talents.wizard_mana_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: wizard_mana_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Mit <keyword id=\"mana\">Mana</keyword> verstärkte Angriffe verursachen mit <value id=\"quantity_1\">%1$lld</value>%% Chance doppelten Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">Mana</keyword>-empowered attacks have a <value id=\"quantity_1\">%1$lld</value>%% chance to deal double damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques potenciados con <keyword id=\"mana\">Maná</keyword> tienen un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de infligir el doble de daño"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques renforcées au <keyword id=\"mana\">Mana</keyword> ont <value id=\"quantity_1\">%1$lld</value>%% de chances d’infliger le double de dégâts"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">マナ</keyword>で強化した攻撃が<value id=\"quantity_1\">%1$lld</value>%%の確率で2倍のダメージを与える"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">마나</keyword>로 강화한 공격이 <value id=\"quantity_1\">%1$lld</value>%% 확률로 두 배의 피해"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques fortalecidos com <keyword id=\"mana\">Mana</keyword> têm <value id=\"quantity_1\">%1$lld</value>%% de chance de causar o dobro de dano"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">魔力</keyword>強化的攻擊有<value id=\"quantity_1\">%1$lld</value>%%機率造成雙倍傷害"}}
      }
    },
    "talents.wizard_mana_t3_2.name": {
      "comment": "ContentManifest/talents.tsv: wizard_mana_t3_2, name",
