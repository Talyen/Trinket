        "es": {"stringUnit": {"state": "translated", "value": "Flor del rencor"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Fleur de rancune"}},
        "ja": {"stringUnit": {"state": "translated", "value": "怨嗟の花"}},
        "ko": {"stringUnit": {"state": "translated", "value": "원한꽃"}},
