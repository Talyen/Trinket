    "talents.ranger_bleed_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: ranger_bleed_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Betäuben eines <keyword id=\"bleed\">blutenden</keyword> Gegners verdoppelt seinen nächsten <keyword id=\"bleed\">Blutungs</keyword>schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stunning a <keyword id=\"bleed\">Bleeding</keyword> enemy doubles its next <keyword id=\"bleed\">Bleed</keyword> damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Étourdir un ennemi sous <keyword id=\"bleed\">Saignement</keyword> double ses prochains dégâts de <keyword id=\"bleed\">Saignement</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"bleed\">出血</keyword>状態の敵をスタンさせると、その敵が次に受ける<keyword id=\"bleed\">出血</keyword>ダメージが2倍になる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"bleed\">출혈</keyword> 상태의 적을 기절시키면 다음 <keyword id=\"bleed\">출혈</keyword> 피해가 두 배"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使<keyword id=\"bleed\">流血</keyword>的敵人暈眩時，該敵人下次承受的<keyword id=\"bleed\">流血</keyword>傷害加倍"
          }
        }
      }
    },
