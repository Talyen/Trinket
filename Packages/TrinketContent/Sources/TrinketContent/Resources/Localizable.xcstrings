    "talents.warlock_burn_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: warlock_burn_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter halber <keyword id=\"health\">Gesundheit</keyword> wird <keyword id=\"burn\">Brand</keyword>schaden um <value id=\"quantity_1\">%1$lld</value>%% erhöht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Below half <keyword id=\"health\">Health</keyword>, <keyword id=\"burn\">Burn</keyword> damage is increased by <value id=\"quantity_1\">%1$lld</value>%%"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sous la moitié de votre <keyword id=\"health\">Santé</keyword>, les dégâts de <keyword id=\"burn\">Brûlure</keyword> augmentent de <value id=\"quantity_1\">%1$lld</value>%%"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">体力</keyword>が半分未満なら、<keyword id=\"burn\">炎上</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">체력</keyword>이 절반 미만이면 <keyword id=\"burn\">화상</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">生命值</keyword>低於一半時，<keyword id=\"burn\">燃燒</keyword>傷害提高<value id=\"quantity_1\">%1$lld</value>%%"
          }
        }
      }
    },
