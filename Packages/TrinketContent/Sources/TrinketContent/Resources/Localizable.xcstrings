        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "弱体効果を<value id=\"quantity_2\">%2$lld</value>個<keyword id=\"cleanse\">浄化</keyword>すると<keyword id=\"mana\">マナ</keyword>を<value id=\"quantity_1\">%1$lld</value>得る"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약화 효과 <value id=\"quantity_2\">%2$lld</value>개를 <keyword id=\"cleanse\">정화</keyword>하면 <keyword id=\"mana\">마나</keyword> <value id=\"quantity_1\">%1$lld</value> 획득"
          }
