    "talents.wolf_physical_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: wolf_physical_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Kritische <keyword id=\"physical\">physische</keyword> Treffer entfernen den gesamten gegnerischen <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">Physical</keyword> Critical Hits remove all enemy <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los golpes críticos <keyword id=\"physical\">físicos</keyword> eliminan todo el <keyword id=\"block\">Bloqueo</keyword> del enemigo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les coups critiques de type <keyword id=\"physical\">Physique</keyword> retirent tout le <keyword id=\"block\">Blocage</keyword> ennemi"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">物理</keyword>クリティカルヒットで敵の<keyword id=\"block\">ブロック</keyword>をすべて除去"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">물리</keyword> 치명타가 적의 모든 <keyword id=\"block\">방어도</keyword> 제거"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Golpes críticos <keyword id=\"physical\">Físicos</keyword> removem todo o <keyword id=\"block\">Bloqueio</keyword> inimigo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">物理</keyword>暴擊移除敵人所有<keyword id=\"block\">格擋</keyword>"}}
      }
    },
    "talents.wolf_physical_t2_1.name": {
      "comment": "ContentManifest/talents.tsv: wolf_physical_t2_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Knochenbrechender Biss"}},
        "en": {"stringUnit": {"state": "translated", "value": "Bone-Crushing Bite"}},
        "es": {"stringUnit": {"state": "translated", "value": "Mordisco rompehuesos"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Morsure brise-os"}},
        "ja": {"stringUnit": {"state": "translated", "value": "骨砕きの噛みつき"}},
        "ko": {"stringUnit": {"state": "translated", "value": "뼈를 으깨는 물기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Mordida Esmaga-Ossos"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "碎骨咬擊"}}
      }
    },
    "talents.wolf_physical_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: wolf_physical_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">Physische</keyword> Angriffe verursachen <value id=\"quantity_1\">%1$lld</value> zusätzlichen Schaden an Gegnern unter halber <keyword id=\"health\">Gesundheit</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">Physical</keyword> attacks deal <value id=\"quantity_1\">%1$lld</value> additional damage to enemies below half <keyword id=\"health\">Health</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques <keyword id=\"physical\">físicos</keyword> infligen <value id=\"quantity_1\">%1$lld</value> de daño adicional a enemigos por debajo de la mitad de <keyword id=\"health\">Salud</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques de type <keyword id=\"physical\">Physique</keyword> infligent <value id=\"quantity_1\">%1$lld</value> dégâts supplémentaires aux ennemis sous la moitié de leur <keyword id=\"health\">Santé</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>が半分未満の敵への<keyword id=\"physical\">物理</keyword>攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword>이 절반 미만인 적을 대상으로 하는 <keyword id=\"physical\">물리</keyword> 공격의 추가 피해 <value id=\"quantity_1\">%1$lld</value>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques <keyword id=\"physical\">Físicos</keyword> causam <value id=\"quantity_1\">%1$lld</value> de dano adicional a inimigos abaixo de metade da <keyword id=\"health\">Vida</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">物理</keyword>攻擊對<keyword id=\"health\">生命值</keyword>低於一半的敵人額外造成<value id=\"quantity_1\">%1$lld</value>點傷害"}}
      }
    },
    "talents.wolf_physical_t2_2.name": {
      "comment": "ContentManifest/talents.tsv: wolf_physical_t2_2, name",
      "extractionState": "manual",
      "localizations": {
