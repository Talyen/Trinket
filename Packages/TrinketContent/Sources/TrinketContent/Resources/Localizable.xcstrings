        "es": {"stringUnit": {"state": "translated", "value": "Fondo de escape"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Fonds de fuite"}},
        "ja": {"stringUnit": {"state": "translated", "value": "逃走資金"}},
