    "homestead_nodes.sparringgrounds.1.bonus_description": {
      "comment": "ContentManifest/homestead_nodes.tsv: sparringGrounds.1, bonus_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erhalte <value id=\"quantity_1\">%1$lld</value>%% mehr <keyword id=\"block\">Block</keyword>\nProduziere <value id=\"quantity_2\">%2$lld</value> Eisen pro Tag"}},
        "en": {"stringUnit": {"state": "translated", "value": "Gain <value id=\"quantity_1\">%1$lld</value>%% more <keyword id=\"block\">Block</keyword>\nProduce <value id=\"quantity_2\">%2$lld</value> Iron per Day"}},
        "es": {"stringUnit": {"state": "translated", "value": "Obtén un <value id=\"quantity_1\">%1$lld</value>%% más de <keyword id=\"block\">Bloqueo</keyword>\nProduce <value id=\"quantity_2\">%2$lld</value> de hierro al día"}},
        "fr": {"stringUnit": {"state": "translated", "value": "<value id=\"quantity_1\">%1$lld</value>%% de <keyword id=\"block\">Blocage</keyword> gagné en plus\nProduction quotidienne de fer : <value id=\"quantity_2\">%2$lld</value>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">ブロック</keyword>の獲得量が<value id=\"quantity_1\">%1$lld</value>%%増加\n1日に鉄を<value id=\"quantity_2\">%2$lld</value>生産"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">방어도</keyword> 획득량 <value id=\"quantity_1\">%1$lld</value>%% 증가\n하루에 철 <value id=\"quantity_2\">%2$lld</value>개 생산"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ganhe <value id=\"quantity_1\">%1$lld</value>%% mais <keyword id=\"block\">Bloqueio</keyword>\nProduza <value id=\"quantity_2\">%2$lld</value> de Ferro por Dia"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "獲得的<keyword id=\"block\">格擋</keyword>增加<value id=\"quantity_1\">%1$lld</value>%%\n每天生產<value id=\"quantity_2\">%2$lld</value>鐵"}}
      }
    },
