      "comment": "ContentManifest/homestead_nodes.tsv: sparringGrounds.1, summary",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ein sandiger Kampfplatz für Nahkampfparaden und Schildübungen"}},
        "en": {"stringUnit": {"state": "translated", "value": "A sandy martial yard for close-quarters parrying and shield drills"}},
        "es": {"stringUnit": {"state": "translated", "value": "Un patio marcial arenoso para practicar paradas a corta distancia y ejercicios de escudo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Une cour martiale sablonneuse pour les parades rapprochées et l’entraînement au bouclier"}},
        "ja": {"stringUnit": {"state": "translated", "value": "近接戦の受け流しや盾の訓練を行う、砂地の道場"}},
        "ko": {"stringUnit": {"state": "translated", "value": "근접 받아치기와 방패 훈련을 위한 모래 무술장"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Um pátio de areia para aparar golpes de perto e treinar com escudos"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "在沙地上練習近身招架與盾術的武場"}}
      }
    },
