    "authored.e490f38a43edadca": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Abilities/AbilityCatalog+Ultimate.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>\nStelle beim Verbündeten mit der niedrigsten <keyword id=\"health\">Gesundheit</keyword> <value id=\"quantity_2\">%2$lld</value> <keyword id=\"health\">Gesundheit</keyword> wieder her\nVerursache <value id=\"quantity_3\">%3$lld</value> <keyword id=\"holy\">heiligen</keyword> Schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gain <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>\nRestore <value id=\"quantity_2\">%2$lld</value> <keyword id=\"health\">Health</keyword> to the lowest-<keyword id=\"health\">Health</keyword> ally\nDeal <value id=\"quantity_3\">%3$lld</value> <keyword id=\"holy\">Holy</keyword> damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagnez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Blocage</keyword>\nRestaurez <value id=\"quantity_2\">%2$lld</value> <keyword id=\"health\">Santé</keyword> à l’allié ayant le moins de <keyword id=\"health\">Santé</keyword>\nInfligez <value id=\"quantity_3\">%3$lld</value> dégâts de type <keyword id=\"holy\">Sacré</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>獲得\n<keyword id=\"health\">体力</keyword>が最も低い味方の<keyword id=\"health\">体力</keyword>を<value id=\"quantity_2\">%2$lld</value>回復\n<keyword id=\"holy\">聖</keyword>ダメージを<value id=\"quantity_3\">%3$lld</value>与える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 획득\n<keyword id=\"health\">체력</keyword>이 가장 낮은 아군의 <keyword id=\"health\">체력</keyword> <value id=\"quantity_2\">%2$lld</value> 회복\n<keyword id=\"holy\">신성</keyword> 피해 <value id=\"quantity_3\">%3$lld</value>"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "獲得<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>\n為<keyword id=\"health\">生命值</keyword>最低的友方恢復<value id=\"quantity_2\">%2$lld</value>點<keyword id=\"health\">生命值</keyword>\n造成<value id=\"quantity_3\">%3$lld</value>點<keyword id=\"holy\">神聖</keyword>傷害"
          }
        }
      }
    },
    "authored.e50fac6e0e71e51c": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Encounters/Mystery/MysteryEventPool+Events.swift: narrative",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rote Kristalle umhüllen „%1$@“, während Phönixglut „%2$@“ wärmt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Red crystals cradle “%1$@” as phoenix embers warm “%2$@”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des cristaux rouges abritent « %1$@ », tandis que des braises de phénix réchauffent « %2$@ »"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "赤い水晶が「%1$@」を包み、不死鳥の残り火が「%2$@」を温めている"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "붉은 수정이 품은 것은 ‘%1$@’, 불사조의 잿불이 데우는 것은 ‘%2$@’입니다"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "紅色水晶環抱著「%1$@」，鳳凰餘燼溫暖著「%2$@」"
          }
        }
      }
    },
    "authored.e55c61a0f1884430": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Encounters/Mystery/MysteryEventPool+Events.swift: narrative",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kern des Meteoriten umschließt „%1$@“, während sein Einschlag „%2$@“ in Stein begräbt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The meteorite’s core cradles “%1$@” as its impact buries “%2$@” in stone"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cœur de la météorite abrite « %1$@ », tandis que l’impact enfouit « %2$@ » dans la pierre"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "隕石の核が「%1$@」を包み、その衝撃で「%2$@」が岩に埋もれている"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운석의 중심부가 품은 것은 ‘%1$@’, 충돌로 돌 속에 묻힌 것은 ‘%2$@’입니다"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隕石核心環抱著「%1$@」，撞擊將「%2$@」埋進岩石"
          }
        }
      }
    },
