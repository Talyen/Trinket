        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"mana\">Mana</keyword>-empowered <keyword id=\"burn\">Burn</keyword> attacks deal <value id=\"quantity_1\">%1$lld</value> additional damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les attaques de <keyword id=\"burn\">Brûlure</keyword> renforcées au <keyword id=\"mana\">Mana</keyword> infligent <value id=\"quantity_1\">%1$lld</value> dégâts supplémentaires"
          }
