        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allies with <keyword id=\"thorns\">Thorns</keyword> take <value id=\"quantity_1\">%1$lld</value>%% less damage above half <keyword id=\"health\">Health</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alliés ayant des <keyword id=\"thorns\">Épines</keyword> subissent <value id=\"quantity_1\">%1$lld</value>%% de dégâts en moins au-dessus de la moitié de leur <keyword id=\"health\">Santé</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"thorns\">棘</keyword>を持つ味方は、<keyword id=\"health\">体力</keyword>が半分を超えている間、受けるダメージが<value id=\"quantity_1\">%1$lld</value>%%減少"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"thorns\">가시</keyword>가 있는 아군의 <keyword id=\"health\">체력</keyword>이 절반 초과이면 받는 피해 <value id=\"quantity_1\">%1$lld</value>%% 감소"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擁有<keyword id=\"thorns\">荊棘</keyword>且<keyword id=\"health\">生命值</keyword>高於一半的友方，承受的傷害降低<value id=\"quantity_1\">%1$lld</value>%%"
          }
        }
      }
    },
