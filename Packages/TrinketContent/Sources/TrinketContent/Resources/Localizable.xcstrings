    "talents.library_owl_holy_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: library_owl_holy_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"variations": {"plural": {"one": {"stringUnit": {"state": "translated", "value": "Kritische <keyword id=\"holy\">heilige</keyword> Treffer <keyword id=\"purge\">entzaubern</keyword> <value id=\"quantity_1\">%1$lld</value> Verstärkung"}}, "other": {"stringUnit": {"state": "translated", "value": "Kritische <keyword id=\"holy\">heilige</keyword> Treffer <keyword id=\"purge\">entzaubern</keyword> <value id=\"quantity_1\">%1$lld</value> Verstärkungen"}}}}},
        "en": {"variations": {"plural": {"one": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">Holy</keyword> Critical Hits <keyword id=\"purge\">Purge</keyword> <value id=\"quantity_1\">%1$lld</value> buff"}}, "other": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">Holy</keyword> Critical Hits <keyword id=\"purge\">Purge</keyword> <value id=\"quantity_1\">%1$lld</value> buffs"}}}}},
        "es": {"variations": {"plural": {"many": {"stringUnit": {"state": "translated", "value": "Los golpes críticos <keyword id=\"holy\">sagrados</keyword> <keyword id=\"purge\">purgan</keyword> <value id=\"quantity_1\">%1$lld</value> mejoras"}}, "one": {"stringUnit": {"state": "translated", "value": "Los golpes críticos <keyword id=\"holy\">sagrados</keyword> <keyword id=\"purge\">purgan</keyword> <value id=\"quantity_1\">%1$lld</value> mejora"}}, "other": {"stringUnit": {"state": "translated", "value": "Los golpes críticos <keyword id=\"holy\">sagrados</keyword> <keyword id=\"purge\">purgan</keyword> <value id=\"quantity_1\">%1$lld</value> mejoras"}}}}},
        "fr": {"variations": {"plural": {"many": {"stringUnit": {"state": "translated", "value": "Les coups Critiques de type <keyword id=\"holy\">Sacré</keyword> déclenchent la <keyword id=\"purge\">Dissipation</keyword> de <value id=\"quantity_1\">%1$lld</value> bonus"}}, "one": {"stringUnit": {"state": "translated", "value": "Les coups Critiques de type <keyword id=\"holy\">Sacré</keyword> déclenchent la <keyword id=\"purge\">Dissipation</keyword> de <value id=\"quantity_1\">%1$lld</value> bonus"}}, "other": {"stringUnit": {"state": "translated", "value": "Les coups Critiques de type <keyword id=\"holy\">Sacré</keyword> déclenchent la <keyword id=\"purge\">Dissipation</keyword> de <value id=\"quantity_1\">%1$lld</value> bonus"}}}}},
        "ja": {"variations": {"plural": {"other": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">聖</keyword>のクリティカルヒットは強化効果を<value id=\"quantity_1\">%1$lld</value>個<keyword id=\"purge\">強化解除</keyword>"}}}}},
        "ko": {"variations": {"plural": {"other": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">신성</keyword> 치명타 적중 시 <keyword id=\"purge\">강화 해제</keyword>로 강화 효과 <value id=\"quantity_1\">%1$lld</value>개 제거"}}}}},
        "pt-BR": {"variations": {"plural": {"many": {"stringUnit": {"state": "translated", "value": "Golpes críticos <keyword id=\"holy\">Sagrados</keyword> <keyword id=\"purge\">Expurgam</keyword> <value id=\"quantity_1\">%1$lld</value> efeitos positivos"}}, "one": {"stringUnit": {"state": "translated", "value": "Golpes críticos <keyword id=\"holy\">Sagrados</keyword> <keyword id=\"purge\">Expurgam</keyword> <value id=\"quantity_1\">%1$lld</value> efeito positivo"}}, "other": {"stringUnit": {"state": "translated", "value": "Golpes críticos <keyword id=\"holy\">Sagrados</keyword> <keyword id=\"purge\">Expurgam</keyword> <value id=\"quantity_1\">%1$lld</value> efeitos positivos"}}}}},
        "zh-Hant": {"variations": {"plural": {"other": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">神聖</keyword>暴擊會<keyword id=\"purge\">驅散</keyword><value id=\"quantity_1\">%1$lld</value>項增益效果"}}}}}
