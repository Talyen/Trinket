        "de": {"stringUnit": {"state": "translated", "value": "Erhöhe <keyword id=\"poison\">Gift</keyword>schaden um <value id=\"quantity_1\">%1$lld</value>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Increase <keyword id=\"poison\">Poison</keyword> damage by <value id=\"quantity_1\">%1$lld</value>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Aumenta el daño de <keyword id=\"poison\">Veneno</keyword> en <value id=\"quantity_1\">%1$lld</value>"}},
