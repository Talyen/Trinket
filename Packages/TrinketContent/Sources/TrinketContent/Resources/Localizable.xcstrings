    "affixes.breakthrough.astral_description": {
      "comment": "ContentManifest/affixes.tsv: breakthrough, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Angriffe, die gegnerischen <keyword id=\"block\">Block</keyword> brechen, verursachen <value id=\"quantity_1\">%1$lld</value>%% mehr Schaden an <keyword id=\"health\">Gesundheit</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Attacks that break enemy <keyword id=\"block\">Block</keyword> deal <value id=\"quantity_1\">%1$lld</value>%% more damage to <keyword id=\"health\">Health</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques que rompen el <keyword id=\"block\">Bloqueo</keyword> enemigo infligen un <value id=\"quantity_1\">%1$lld</value>%% más de daño a la <keyword id=\"health\">Salud</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques qui brisent le <keyword id=\"block\">Blocage</keyword> ennemi infligent <value id=\"quantity_1\">%1$lld</value>%% de dégâts supplémentaires à la <keyword id=\"health\">Santé</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "敵の<keyword id=\"block\">ブロック</keyword>を破壊する攻撃は、<keyword id=\"health\">体力</keyword>に与えるダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "적의 <keyword id=\"block\">방어도</keyword>를 깨뜨리는 공격이 <keyword id=\"health\">체력</keyword>에 주는 피해가 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques que quebram o <keyword id=\"block\">Bloqueio</keyword> inimigo causam <value id=\"quantity_1\">%1$lld</value>%% mais dano à <keyword id=\"health\">Vida</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "擊破敵人<keyword id=\"block\">格擋</keyword>的攻擊，對<keyword id=\"health\">生命值</keyword>造成的傷害提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
