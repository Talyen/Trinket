    "affixes.bloodroot.astral_description": {
      "comment": "ContentManifest/affixes.tsv: bloodroot, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn <keyword id=\"leech\">Lebensraub</keyword> <keyword id=\"health\">Gesundheit</keyword> wiederherstellt, während du keine <keyword id=\"thorns\">Dornen</keyword> hast, erhalte <value id=\"quantity_1\">%1$lld</value> <keyword id=\"thorns\">Dornen</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When <keyword id=\"leech\">Leech</keyword> restores <keyword id=\"health\">Health</keyword> while you have no <keyword id=\"thorns\">Thorns</keyword>, gain <value id=\"quantity_1\">%1$lld</value> <keyword id=\"thorns\">Thorns</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un <keyword id=\"leech\">Vol de vie</keyword> restaure de la <keyword id=\"health\">Santé</keyword> alors que vous n’avez pas d’<keyword id=\"thorns\">Épines</keyword>, gagnez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"thorns\">Épines</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"thorns\">棘</keyword>がない状態で<keyword id=\"leech\">吸収</keyword>により<keyword id=\"health\">体力</keyword>を回復すると、<keyword id=\"thorns\">棘</keyword>を<value id=\"quantity_1\">%1$lld</value>獲得"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"thorns\">가시</keyword>가 없을 때 <keyword id=\"leech\">흡혈</keyword>로 <keyword id=\"health\">체력</keyword>을 회복하면 <keyword id=\"thorns\">가시</keyword> <value id=\"quantity_1\">%1$lld</value> 획득"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有<keyword id=\"thorns\">荊棘</keyword>時，若<keyword id=\"leech\">吸血</keyword>恢復<keyword id=\"health\">生命值</keyword>，則獲得<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"thorns\">荊棘</keyword>"
          }
        }
      }
    },
