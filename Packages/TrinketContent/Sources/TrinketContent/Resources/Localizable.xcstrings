        "fr": {"stringUnit": {"state": "translated", "value": "Gagnez <value id=\"quantity_1\">%1$lld</value>%% de chances d’<keyword id=\"dodge\">Esquive</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"dodge\">回避</keyword>率が<value id=\"quantity_1\">%1$lld</value>%%上昇"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"dodge\">회피</keyword> 확률 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ganhe <value id=\"quantity_1\">%1$lld</value>%% de chance de <keyword id=\"dodge\">Esquiva</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"dodge\">閃避</keyword>機率提高<value id=\"quantity_1\">%1$lld</value>%%"}}
