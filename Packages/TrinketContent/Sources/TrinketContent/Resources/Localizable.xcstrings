    "talents.fox_dodge_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: fox_dodge_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein erstes <keyword id=\"dodge\">Ausweichen</keyword> in jedem Zug fügt deinem nächsten Angriff <value id=\"quantity_1\">%1$lld</value> Schaden hinzu"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your first <keyword id=\"dodge\">Dodge</keyword> each turn adds <value id=\"quantity_1\">%1$lld</value> damage to your next attack"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre première <keyword id=\"dodge\">Esquive</keyword> de chaque tour ajoute <value id=\"quantity_1\">%1$lld</value> dégâts à votre prochaine attaque"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ターンで最初の<keyword id=\"dodge\">回避</keyword>で、次の攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>増加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매 턴 첫 <keyword id=\"dodge\">회피</keyword> 시 다음 공격의 피해 <value id=\"quantity_1\">%1$lld</value> 증가"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每回合首次<keyword id=\"dodge\">閃避</keyword>時，下次攻擊的傷害增加<value id=\"quantity_1\">%1$lld</value>點"
          }
        }
      }
    },
