    "traits.loose_rubble.description": {
      "comment": "ContentManifest/traits.tsv: loose_rubble, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Schaden an seiner <keyword id=\"health\">Gesundheit</keyword> verringert den Schaden seines nächsten Angriffs um <value id=\"quantity_1\">%1$lld</value>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Taking <keyword id=\"health\">Health</keyword> damage reduces the next attack’s damage by <value id=\"quantity_1\">%1$lld</value>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Recibir daño a la <keyword id=\"health\">Salud</keyword> reduce el daño de su siguiente ataque en <value id=\"quantity_1\">%1$lld</value>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Subir des dégâts à la <keyword id=\"health\">Santé</keyword> réduit de <value id=\"quantity_1\">%1$lld</value> les dégâts de sa prochaine attaque"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>へのダメージを受けると、次の攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>減少"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword> 피해를 받으면 다음 공격의 피해가 <value id=\"quantity_1\">%1$lld</value> 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Receber dano à <keyword id=\"health\">Vida</keyword> reduz em <value id=\"quantity_1\">%1$lld</value> o dano do seu próximo ataque"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">生命值</keyword>受到傷害時，下次攻擊的傷害降低<value id=\"quantity_1\">%1$lld</value>點"}}
      }
    },
    "traits.loose_rubble.name": {
      "comment": "ContentManifest/traits.tsv: loose_rubble, name",
