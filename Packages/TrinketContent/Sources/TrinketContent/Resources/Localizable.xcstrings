    "talents.panther_bleed_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: panther_bleed_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Kritische <keyword id=\"bleed\">Blutungs</keyword>-Treffer verursachen <value id=\"quantity_1\">%1$lld</value>%% mehr Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">Bleed</keyword> Critical Hits deal <value id=\"quantity_1\">%1$lld</value>%% more damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los golpes críticos de <keyword id=\"bleed\">Sangrado</keyword> infligen un <value id=\"quantity_1\">%1$lld</value>%% más de daño"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les coups critiques de <keyword id=\"bleed\">Saignement</keyword> infligent <value id=\"quantity_1\">%1$lld</value>%% de dégâts en plus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">出血</keyword>クリティカルヒットのダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">출혈</keyword> 치명타 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Golpes críticos de <keyword id=\"bleed\">Sangramento</keyword> causam <value id=\"quantity_1\">%1$lld</value>%% mais dano"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">流血</keyword>暴擊傷害提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
