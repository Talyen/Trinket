    "traits.thunderous_tremor.description": {
      "comment": "ContentManifest/traits.tsv: thunderous_tremor, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verursacht jeden zweiten Zug <value id=\"quantity_1\">%1$lld</value> <keyword id=\"physical\">physischen</keyword> Schaden oder <value id=\"quantity_2\">%2$lld</value> <keyword id=\"stun\">Betäubungs</keyword>schaden an allen Gegnern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deals <value id=\"quantity_1\">%1$lld</value> <keyword id=\"physical\">Physical</keyword> or <value id=\"quantity_2\">%2$lld</value> <keyword id=\"stun\">Stun</keyword> damage every other turn to all enemies"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inflige <value id=\"quantity_1\">%1$lld</value> dégâts de type <keyword id=\"physical\">Physique</keyword> ou <value id=\"quantity_2\">%2$lld</value> dégâts d’<keyword id=\"stun\">Étourdissement</keyword> à tous les ennemis un tour sur deux"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
