    "talents.library_owl_health_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: library_owl_health_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Wiederherstellen von <keyword id=\"health\">Gesundheit</keyword> verringert den nächsten erlittenen Schaden dieses Verbündeten um <value id=\"quantity_1\">%1$lld</value>%%"}},
        "en": {"stringUnit": {"state": "translated", "value": "Restoring <keyword id=\"health\">Health</keyword> reduces that ally's next incoming damage by <value id=\"quantity_1\">%1$lld</value>%%"}},
        "es": {"stringUnit": {"state": "translated", "value": "Restaurar <keyword id=\"health\">Salud</keyword> reduce el siguiente daño que reciba ese aliado en un <value id=\"quantity_1\">%1$lld</value>%%"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Restaurer de la <keyword id=\"health\">Santé</keyword> réduit de <value id=\"quantity_1\">%1$lld</value>%% les prochains dégâts reçus par cet allié"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>を回復すると、その味方が次に受けるダメージが<value id=\"quantity_1\">%1$lld</value>%%減少"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword> 회복 시 해당 아군이 다음에 받는 피해 <value id=\"quantity_1\">%1$lld</value>%% 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Restaurar <keyword id=\"health\">Vida</keyword> reduz em <value id=\"quantity_1\">%1$lld</value>%% o próximo dano que esse aliado receber"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "恢復<keyword id=\"health\">生命值</keyword>後，該友方下次承受的傷害降低<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.library_owl_health_t1_2.name": {
