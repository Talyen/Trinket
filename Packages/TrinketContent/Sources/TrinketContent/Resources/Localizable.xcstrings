    "talents.risen_skeleton_deathsdoor_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_deathsdoor_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An der <keyword id=\"deathsdoor\">Todesschwelle</keyword> erhältst du +<value id=\"quantity_1\">%1$lld</value>%% Chance auf kritische Treffer"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While on <keyword id=\"deathsdoor\">Death's Door</keyword>, gain +<value id=\"quantity_1\">%1$lld</value>%% Critical Hit chance"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au <keyword id=\"deathsdoor\">Seuil de la mort</keyword>, gagnez +<value id=\"quantity_1\">%1$lld</value>%% de chances de coup critique"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"deathsdoor\">死の淵</keyword>の間、クリティカル率が<value id=\"quantity_1\">%1$lld</value>%%上昇"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"deathsdoor\">죽음의 문턱</keyword> 상태이면 치명타 확률 +<value id=\"quantity_1\">%1$lld</value>%%"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "處於<keyword id=\"deathsdoor\">瀕死之門</keyword>時，暴擊機率提高<value id=\"quantity_1\">%1$lld</value>%%"
          }
        }
      }
    },
