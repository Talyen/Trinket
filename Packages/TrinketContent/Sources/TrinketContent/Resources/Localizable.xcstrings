    "talents.shield_scarab_stun_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: shield_scarab_stun_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dein <keyword id=\"block\">Block</keyword> in einem Kampf erstmals durchbrochen wird, verdoppelt sich dein nächster <keyword id=\"stun\">Betäubungs</keyword>-Angriff"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your first <keyword id=\"block\">Block</keyword> break each combat doubles your next <keyword id=\"stun\">Stun</keyword> attack"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier bris de votre <keyword id=\"block\">Blocage</keyword> de chaque combat double votre prochaine attaque d’<keyword id=\"stun\">Étourdissement</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各戦闘で初めて自分の<keyword id=\"block\">ブロック</keyword>が崩れると、次の<keyword id=\"stun\">スタン</keyword>攻撃が2倍になる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매 전투 처음으로 내 <keyword id=\"block\">방어도</keyword>가 깨지면 다음 <keyword id=\"stun\">기절</keyword> 공격이 두 배"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每場戰鬥自身<keyword id=\"block\">格擋</keyword>首次被擊破時，下次<keyword id=\"stun\">暈眩</keyword>攻擊加倍"
          }
        }
      }
    },
