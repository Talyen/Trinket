    "talents.frost_whelp_mana_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: frost_whelp_mana_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ausgegebenes <keyword id=\"mana\">Mana</keyword> wird mit <value id=\"quantity_1\">%1$lld</value>%% Chance erstattet"}},
        "en": {"stringUnit": {"state": "translated", "value": "Spending <keyword id=\"mana\">Mana</keyword> has a <value id=\"quantity_1\">%1$lld</value>%% chance to refund it"}},
        "es": {"stringUnit": {"state": "translated", "value": "Gastar <keyword id=\"mana\">Maná</keyword> tiene un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de reembolsarlo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Dépenser du <keyword id=\"mana\">Mana</keyword> a <value id=\"quantity_1\">%1$lld</value>%% de chances de le rembourser"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">マナ</keyword>を消費すると<value id=\"quantity_1\">%1$lld</value>%%の確率でその消費分が戻る"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">마나</keyword> 소모 시 <value id=\"quantity_1\">%1$lld</value>%% 확률로 소모한 마나 반환"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Gastar <keyword id=\"mana\">Mana</keyword> tem <value id=\"quantity_1\">%1$lld</value>%% de chance de devolvê-la"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "消耗<keyword id=\"mana\">魔力</keyword>時，有<value id=\"quantity_1\">%1$lld</value>%%機率返還消耗量"}}
      }
    },
    "talents.frost_whelp_mana_t3_1.name": {
      "comment": "ContentManifest/talents.tsv: frost_whelp_mana_t3_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">Mana</keyword>-Fluss"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">Mana</keyword> Flow"}},
        "es": {"stringUnit": {"state": "translated", "value": "Flujo de <keyword id=\"mana\">Maná</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Flux de <keyword id=\"mana\">Mana</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">マナ</keyword>の流れ"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">마나</keyword>의 흐름"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Fluxo de <keyword id=\"mana\">Mana</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">魔力</keyword>流動"}}
      }
    },
    "talents.frost_whelp_mana_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: frost_whelp_mana_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verstärken mit <keyword id=\"mana\">Mana</keyword> kostet <value id=\"quantity_1\">%1$lld</value> weniger <keyword id=\"mana\">Mana</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">Mana</keyword> empowerment costs <value id=\"quantity_1\">%1$lld</value> less <keyword id=\"mana\">Mana</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Potenciar con <keyword id=\"mana\">Maná</keyword> cuesta <value id=\"quantity_1\">%1$lld</value> menos de <keyword id=\"mana\">Maná</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Un renforcement au <keyword id=\"mana\">Mana</keyword> coûte <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword> de moins"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">マナ</keyword>強化に必要な<keyword id=\"mana\">マナ</keyword>が<value id=\"quantity_1\">%1$lld</value>減少"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">마나</keyword> 강화의 <keyword id=\"mana\">마나</keyword> 소모량 <value id=\"quantity_1\">%1$lld</value> 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Fortalecer com <keyword id=\"mana\">Mana</keyword> custa <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"mana\">Mana</keyword> a menos"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">魔力</keyword>強化所需<keyword id=\"mana\">魔力</keyword>減少<value id=\"quantity_1\">%1$lld</value>點"}}
      }
    },
    "talents.frost_whelp_mana_t3_2.name": {
      "comment": "ContentManifest/talents.tsv: frost_whelp_mana_t3_2, name",
      "extractionState": "manual",
