    "talents.knight_block_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: knight_block_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"physical\">Physischer</keyword> Schaden wird um <value id=\"quantity_1\">%1$lld</value>%% deines <keyword id=\"block\">Blocks</keyword> erhöht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"physical\">Physical</keyword> damage is increased by <value id=\"quantity_1\">%1$lld</value>%% of your <keyword id=\"block\">Block</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos dégâts de type <keyword id=\"physical\">Physique</keyword> augmentent de <value id=\"quantity_1\">%1$lld</value>%% de votre <keyword id=\"block\">Blocage</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"physical\">物理</keyword>ダメージが自分の<keyword id=\"block\">ブロック</keyword>の<value id=\"quantity_1\">%1$lld</value>%%分増加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 <keyword id=\"block\">방어도</keyword>의 <value id=\"quantity_1\">%1$lld</value>%%만큼 <keyword id=\"physical\">물리</keyword> 피해 증가"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"physical\">物理</keyword>傷害增加相當於自身<keyword id=\"block\">格擋</keyword>的<value id=\"quantity_1\">%1$lld</value>%%"
          }
        }
      }
    },
