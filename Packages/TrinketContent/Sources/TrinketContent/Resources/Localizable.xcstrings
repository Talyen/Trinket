    "homestead_nodes.moonlitsanctum.1.bonus_description": {
      "comment": "ContentManifest/homestead_nodes.tsv: moonlitSanctum.1, bonus_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Die Fundrate astraler Gegenstände steigt um <value id=\"quantity_1\">%1$lld</value>%%\nFinde <value id=\"quantity_2\">%2$lld</value>%% mehr Edelsteine"}},
        "en": {"stringUnit": {"state": "translated", "value": "Astral drop rates rise by <value id=\"quantity_1\">%1$lld</value>%%\nFind <value id=\"quantity_2\">%2$lld</value>%% more Gems"}},
        "es": {"stringUnit": {"state": "translated", "value": "Las tasas de obtención astral aumentan en un <value id=\"quantity_1\">%1$lld</value>%%\nEncuentra un <value id=\"quantity_2\">%2$lld</value>%% más de gemas"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Taux de butin astral augmenté de <value id=\"quantity_1\">%1$lld</value>%%\nTrouvez <value id=\"quantity_2\">%2$lld</value>%% de gemmes en plus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "星界級のドロップ率が<value id=\"quantity_1\">%1$lld</value>%%上昇\n宝石の発見量が<value id=\"quantity_2\">%2$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "성운 등급 드롭률 <value id=\"quantity_1\">%1$lld</value>%% 증가\n보석 발견량 <value id=\"quantity_2\">%2$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "As taxas de obtenção Astral aumentam em <value id=\"quantity_1\">%1$lld</value>%%\nEncontre <value id=\"quantity_2\">%2$lld</value>%% mais Gemas"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "星界級掉落率提高<value id=\"quantity_1\">%1$lld</value>%%\n發現的寶石增加<value id=\"quantity_2\">%2$lld</value>%%"}}
      }
    },
