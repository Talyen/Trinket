    "talents.druid_health_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: druid_health_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Wiederherstellen von <keyword id=\"health\">Gesundheit</keyword> reinigt auch <keyword id=\"poison\">Gift</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restoring <keyword id=\"health\">Health</keyword> also Cleanses <keyword id=\"poison\">Poison</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurer de la <keyword id=\"health\">Santé</keyword> purifie aussi le <keyword id=\"poison\">Poison</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">体力</keyword>を回復すると<keyword id=\"poison\">毒</keyword>も浄化"
