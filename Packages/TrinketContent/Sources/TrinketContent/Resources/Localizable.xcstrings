        "ja": {"stringUnit": {"state": "translated", "value": "戦闘を開始できませんでした。もう一度お試しください。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "이 전투를 시작하지 못했습니다. 다시 시도하세요."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Não foi possível iniciar esta batalha. Tente novamente."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法開始此戰鬥，請再試一次。"}}
      }
    },
