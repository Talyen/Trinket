    "talents.warlock_burn_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: warlock_burn_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte +<value id=\"quantity_1\">%1$lld</value>%% Chance auf kritische Treffer gegen <keyword id=\"burn\">brennende</keyword> Gegner"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gain +<value id=\"quantity_1\">%1$lld</value>%% Critical Hit chance against <keyword id=\"burn\">Burning</keyword> enemies"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagnez +<value id=\"quantity_1\">%1$lld</value>%% de chances de coup critique contre les ennemis sous <keyword id=\"burn\">Brûlure</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">炎上</keyword>状態の敵へのクリティカル率が<value id=\"quantity_1\">%1$lld</value>%%上昇"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">화상</keyword> 상태의 적을 상대로 치명타 확률 +<value id=\"quantity_1\">%1$lld</value>%%"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對<keyword id=\"burn\">燃燒</keyword>中敵人的暴擊機率提高<value id=\"quantity_1\">%1$lld</value>%%"
          }
        }
      }
    },
