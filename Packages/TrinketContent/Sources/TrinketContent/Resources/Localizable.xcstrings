    "talents.bear_stun_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: bear_stun_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein erster <keyword id=\"stun\">Betäubungs</keyword>-Angriff in jedem Zug verursacht <value id=\"quantity_1\">%1$lld</value> zusätzlichen Schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your first <keyword id=\"stun\">Stun</keyword> attack each turn deals <value id=\"quantity_1\">%1$lld</value> additional damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre première attaque d’<keyword id=\"stun\">Étourdissement</keyword> de chaque tour inflige <value id=\"quantity_1\">%1$lld</value> dégâts supplémentaires"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ターンで最初の<keyword id=\"stun\">スタン</keyword>攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>増加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매 턴 첫 <keyword id=\"stun\">기절</keyword> 공격의 추가 피해 <value id=\"quantity_1\">%1$lld</value>"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每回合首次<keyword id=\"stun\">暈眩</keyword>攻擊額外造成<value id=\"quantity_1\">%1$lld</value>點傷害"
