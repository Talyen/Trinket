    "talents.bear_stun_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: bear_stun_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"stun\">Betäubung</keyword> hält mit <value id=\"quantity_1\">%1$lld</value>%% Chance einen weiteren Zug an"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"stun\">Stun</keyword> has a <value id=\"quantity_1\">%1$lld</value>%% chance to last another turn"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’<keyword id=\"stun\">Étourdissement</keyword> a <value id=\"quantity_1\">%1$lld</value>%% de chances de durer un tour de plus"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"stun\">スタン</keyword>が<value id=\"quantity_1\">%1$lld</value>%%の確率でさらに1ターン持続"
          }
