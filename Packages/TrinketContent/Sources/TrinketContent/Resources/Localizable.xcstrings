        },
        "ja": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "<keyword id=\"health\">体力</keyword>を回復するアビリティは弱体効果も<value id=\"quantity_1\">%1$lld</value>個<keyword id=\"cleanse\">浄化</keyword>"
