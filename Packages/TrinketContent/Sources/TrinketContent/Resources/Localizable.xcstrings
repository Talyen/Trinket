    "talents.library_owl_health_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: library_owl_health_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn einer der Verbündeten die <keyword id=\"deathsdoor\">Todesschwelle</keyword> erreicht, stellt er <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Gesundheit</keyword> wieder her"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When either ally enters <keyword id=\"deathsdoor\">Death's Door</keyword>, they restore <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Health</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsqu’un des alliés atteint le <keyword id=\"deathsdoor\">Seuil de la mort</keyword>, il restaure <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Santé</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "味方のどちらかが<keyword id=\"deathsdoor\">死の淵</keyword>に入ると、その味方の<keyword id=\"health\">体力</keyword>を<value id=\"quantity_1\">%1$lld</value>回復"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 아군이든 <keyword id=\"deathsdoor\">죽음의 문턱</keyword>에 들어서면 해당 아군의 <keyword id=\"health\">체력</keyword> <value id=\"quantity_1\">%1$lld</value> 회복"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任一友方進入<keyword id=\"deathsdoor\">瀕死之門</keyword>時，該友方恢復<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"health\">生命值</keyword>"
          }
        }
      }
    },
