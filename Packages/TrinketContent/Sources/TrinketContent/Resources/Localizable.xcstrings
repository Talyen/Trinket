    "talents.frost_whelp_dodge_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: frost_whelp_dodge_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
