    "talents.bear_block_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: bear_block_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dein Verbündeter erstmals unter halbe <keyword id=\"health\">Gesundheit</keyword> fällt, gewähre <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When your ally first falls below half <keyword id=\"health\">Health</keyword>, grant <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque votre allié passe pour la première fois sous la moitié de sa <keyword id=\"health\">Santé</keyword>, octroyez-lui <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Blocage</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "味方の<keyword id=\"health\">体力</keyword>が初めて半分未満になると、その味方に<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>付与"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아군의 <keyword id=\"health\">체력</keyword>이 처음으로 절반 미만이 되면 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 부여"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "友方<keyword id=\"health\">生命值</keyword>首次低於一半時，賦予該友方<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>"
          }
        }
      }
    },
