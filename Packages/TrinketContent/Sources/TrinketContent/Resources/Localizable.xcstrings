    "talents.wizard_freeze_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: wizard_freeze_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>, wenn ein Gegner <keyword id=\"freeze\">eingefroren</keyword> wird"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gain <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword> whenever an enemy becomes <keyword id=\"freeze\">Frozen</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagnez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Blocage</keyword> chaque fois qu’un ennemi subit un <keyword id=\"freeze\">Gel</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "敵が<keyword id=\"freeze\">凍結</keyword>状態になるたび、<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>獲得"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적이 <keyword id=\"freeze\">빙결</keyword> 상태가 될 때마다 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 획득"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每當敵人陷入<keyword id=\"freeze\">冰凍</keyword>，獲得<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>"
          }
        }
      }
    },
