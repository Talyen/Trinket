      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Massen<keyword id=\"cleanse\">reinigung</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Mass <keyword id=\"cleanse\">Cleanse</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "<keyword id=\"cleanse\">Purificación</keyword> masiva"}},
        "fr": {"stringUnit": {"state": "translated", "value": "<keyword id=\"cleanse\">Purification</keyword> de masse"}},
        "ja": {"stringUnit": {"state": "translated", "value": "全体<keyword id=\"cleanse\">浄化</keyword>"}},
        "ko": {"stringUnit": {"state": "translated", "value": "광역 <keyword id=\"cleanse\">정화</keyword>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "<keyword id=\"cleanse\">Purificação</keyword> em Massa"}},
