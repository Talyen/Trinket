    "talents.pixie_holy_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: pixie_holy_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Beide Verbündeten verursachen <value id=\"quantity_1\">%1$lld</value>%% mehr <keyword id=\"holy\">heiligen</keyword> Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Both allies deal <value id=\"quantity_1\">%1$lld</value>%% more <keyword id=\"holy\">Holy</keyword> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Ambos aliados infligen un <value id=\"quantity_1\">%1$lld</value>%% más de daño <keyword id=\"holy\">sagrado</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les deux alliés infligent <value id=\"quantity_1\">%1$lld</value>%% de dégâts de type <keyword id=\"holy\">Sacré</keyword> en plus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "味方2人の<keyword id=\"holy\">聖</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "두 아군의 <keyword id=\"holy\">신성</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ambos os aliados causam <value id=\"quantity_1\">%1$lld</value>%% mais dano <keyword id=\"holy\">Sagrado</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "兩名友方的<keyword id=\"holy\">神聖</keyword>傷害提高<value id=\"quantity_1\">%1$lld</value>%%"}}
