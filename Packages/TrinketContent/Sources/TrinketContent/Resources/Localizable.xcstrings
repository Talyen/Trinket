        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"physical\">Physical</keyword> Critical Hits deal <value id=\"quantity_1\">%1$lld</value>%% more damage to <keyword id=\"poison\">Poisoned</keyword> enemies"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les coups critiques de type <keyword id=\"physical\">Physique</keyword> infligent <value id=\"quantity_1\">%1$lld</value>%% de dégâts en plus aux ennemis sous <keyword id=\"poison\">Poison</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"poison\">毒</keyword>状態の敵への<keyword id=\"physical\">物理</keyword>クリティカルヒットのダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"poison\">독</keyword> 상태의 적에게 <keyword id=\"physical\">물리</keyword> 치명타 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"
          }
