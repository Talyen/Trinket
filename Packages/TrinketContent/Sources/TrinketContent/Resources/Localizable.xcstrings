    "talents.warlock_mana_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: warlock_mana_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword> stellt <keyword id=\"leech\">Lebensraub</keyword> <value id=\"quantity_2\">%2$lld</value>%% mehr <keyword id=\"health\">Gesundheit</keyword> wieder her"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword>, <keyword id=\"leech\">Leech</keyword> restores <value id=\"quantity_2\">%2$lld</value>%% more <keyword id=\"health\">Health</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword>, le <keyword id=\"leech\">Vol de vie</keyword> restaure <value id=\"quantity_2\">%2$lld</value>%% de <keyword id=\"health\">Santé</keyword> en plus"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"mana\">マナ</keyword>が<value id=\"quantity_1\">%1$lld</value>の時、<keyword id=\"leech\">吸収</keyword>による<keyword id=\"health\">体力</keyword>回復量が<value id=\"quantity_2\">%2$lld</value>%%増加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"mana\">마나</keyword>가 <value id=\"quantity_1\">%1$lld</value>일 때 <keyword id=\"leech\">흡혈</keyword>의 <keyword id=\"health\">체력</keyword> 회복량 <value id=\"quantity_2\">%2$lld</value>%% 증가"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擁有<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"mana\">魔力</keyword>時，<keyword id=\"leech\">吸血</keyword>恢復的<keyword id=\"health\">生命值</keyword>增加<value id=\"quantity_2\">%2$lld</value>%%"
          }
        }
      }
    },
