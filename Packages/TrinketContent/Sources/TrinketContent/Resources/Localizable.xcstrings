    "affixes.sanctum.astral_description": {
      "comment": "ContentManifest/affixes.tsv: sanctum, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erhalte <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>, wenn du <keyword id=\"holy\">heiligen</keyword> Schaden verursachst"}},
        "en": {"stringUnit": {"state": "translated", "value": "Gain <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword> when you deal <keyword id=\"holy\">Holy</keyword> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Obtén <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueo</keyword> cuando infliges daño <keyword id=\"holy\">sagrado</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Gagnez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Blocage</keyword> lorsque vous infligez des dégâts de type <keyword id=\"holy\">Sacré</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">聖</keyword>ダメージを与えると<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>獲得"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">신성</keyword> 피해를 주면 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 획득"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ganhe <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueio</keyword> ao causar dano <keyword id=\"holy\">Sagrado</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "造成<keyword id=\"holy\">神聖</keyword>傷害時，獲得<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>"}}
      }
    },
    "affixes.sanctum.basic_description": {
      "comment": "ContentManifest/affixes.tsv: sanctum, basic_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erhalte <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>, wenn du <keyword id=\"holy\">heiligen</keyword> Schaden verursachst"}},
        "en": {"stringUnit": {"state": "translated", "value": "Gain <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword> when you deal <keyword id=\"holy\">Holy</keyword> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Obtén <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueo</keyword> cuando infliges daño <keyword id=\"holy\">sagrado</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Gagnez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Blocage</keyword> lorsque vous infligez des dégâts de type <keyword id=\"holy\">Sacré</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">聖</keyword>ダメージを与えると<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>獲得"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">신성</keyword> 피해를 주면 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 획득"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ganhe <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueio</keyword> ao causar dano <keyword id=\"holy\">Sagrado</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "造成<keyword id=\"holy\">神聖</keyword>傷害時，獲得<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>"}}
