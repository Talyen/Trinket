    "affixes.vanguards_crest.title": {
      "comment": "ContentManifest/affixes.tsv: vanguards_crest, title",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Kampfschutz"}},
        "en": {"stringUnit": {"state": "translated", "value": "Martial Guard"}},
        "es": {"stringUnit": {"state": "translated", "value": "Guardia marcial"}},
