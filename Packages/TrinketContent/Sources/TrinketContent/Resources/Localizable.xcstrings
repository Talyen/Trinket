    "talents.druid_poison_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: druid_poison_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"poison\">Vergiftete</keyword> Gegner erleiden <value id=\"quantity_1\">%1$lld</value> zusätzlichen <keyword id=\"freeze\">Frost</keyword>schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"poison\">Poisoned</keyword> enemies take <value id=\"quantity_1\">%1$lld</value> additional <keyword id=\"freeze\">Freeze</keyword> damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les ennemis sous <keyword id=\"poison\">Poison</keyword> subissent <value id=\"quantity_1\">%1$lld</value> dégâts de <keyword id=\"freeze\">Gel</keyword> supplémentaires"
          }
