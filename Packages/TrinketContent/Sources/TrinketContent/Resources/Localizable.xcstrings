    "talents.panther_bleed_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: panther_bleed_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Kritische Treffer lassen <keyword id=\"bleed\">Blutung</keyword> detonieren"}},
        "en": {"stringUnit": {"state": "translated", "value": "Critical Hits detonate <keyword id=\"bleed\">Bleed</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los golpes críticos detonan <keyword id=\"bleed\">Sangrado</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les coups critiques font exploser le <keyword id=\"bleed\">Saignement</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "クリティカルヒットで<keyword id=\"bleed\">出血</keyword>を炸裂させる"}},
        "ko": {"stringUnit": {"state": "translated", "value": "치명타가 <keyword id=\"bleed\">출혈</keyword>을 폭발시킴"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Golpes críticos detonam <keyword id=\"bleed\">Sangramento</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "暴擊引爆<keyword id=\"bleed\">流血</keyword>"}}
      }
    },
    "talents.panther_bleed_t4_1.name": {
      "comment": "ContentManifest/talents.tsv: panther_bleed_t4_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Arterienkaskade"}},
        "en": {"stringUnit": {"state": "translated", "value": "Arterial Cascade"}},
        "es": {"stringUnit": {"state": "translated", "value": "Cascada arterial"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Cascade artérielle"}},
        "ja": {"stringUnit": {"state": "translated", "value": "動脈の奔流"}},
        "ko": {"stringUnit": {"state": "translated", "value": "동맥의 폭류"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cascata Arterial"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "動脈奔流"}}
