    "talents.frost_whelp_mana_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: frost_whelp_mana_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erhalte <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword> pro überschüssig wiederhergestelltem <keyword id=\"mana\">Mana</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Gain <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword> for each excess <keyword id=\"mana\">Mana</keyword> restored"}},
        "es": {"stringUnit": {"state": "translated", "value": "Obtén <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueo</keyword> por cada punto de <keyword id=\"mana\">Maná</keyword> sobrante restaurado"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre <keyword id=\"block\">Blocage</keyword> augmente de <value id=\"quantity_1\">%1$lld</value> par point de <keyword id=\"mana\">Mana</keyword> restauré en excès"}},
        "ja": {"stringUnit": {"state": "translated", "value": "過剰に回復した<keyword id=\"mana\">マナ</keyword>1につき、<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>獲得"}},
        "ko": {"stringUnit": {"state": "translated", "value": "초과 회복한 <keyword id=\"mana\">마나</keyword> 1당 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 획득"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ganhe <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueio</keyword> por <keyword id=\"mana\">Mana</keyword> restaurada em excesso"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每點超額恢復的<keyword id=\"mana\">魔力</keyword>使你獲得<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>"}}
      }
    },
    "talents.frost_whelp_mana_t2_1.name": {
      "comment": "ContentManifest/talents.tsv: frost_whelp_mana_t2_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">Mana</keyword>-Absorption"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">Mana</keyword> Absorption"}},
        "es": {"stringUnit": {"state": "translated", "value": "Absorción de <keyword id=\"mana\">Maná</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Absorption de <keyword id=\"mana\">Mana</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">マナ</keyword>吸収"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">마나</keyword> 흡수"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Absorção de <keyword id=\"mana\">Mana</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">魔力</keyword>吸收"}}
      }
    },
    "talents.frost_whelp_mana_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: frost_whelp_mana_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Solange du <keyword id=\"mana\">Mana</keyword> hast, erleide <value id=\"quantity_1\">%1$lld</value>%% weniger Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "While you have <keyword id=\"mana\">Mana</keyword>, take <value id=\"quantity_1\">%1$lld</value>%% less damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Mientras tienes <keyword id=\"mana\">Maná</keyword>, recibes un <value id=\"quantity_1\">%1$lld</value>%% menos de daño"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Tant que vous avez du <keyword id=\"mana\">Mana</keyword>, subissez <value id=\"quantity_1\">%1$lld</value>%% de dégâts en moins"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">マナ</keyword>がある間、受けるダメージが<value id=\"quantity_1\">%1$lld</value>%%減少"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">마나</keyword>가 있으면 받는 피해 <value id=\"quantity_1\">%1$lld</value>%% 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Enquanto tiver <keyword id=\"mana\">Mana</keyword>, receba <value id=\"quantity_1\">%1$lld</value>%% menos dano"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "擁有<keyword id=\"mana\">魔力</keyword>時，承受的傷害降低<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.frost_whelp_mana_t2_2.name": {
      "comment": "ContentManifest/talents.tsv: frost_whelp_mana_t2_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ätherrüstung"}},
        "en": {"stringUnit": {"state": "translated", "value": "Aetherial Armor"}},
        "es": {"stringUnit": {"state": "translated", "value": "Armadura etérea"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Armure éthérée"}},
        "ja": {"stringUnit": {"state": "translated", "value": "霊気の鎧"}},
        "ko": {"stringUnit": {"state": "translated", "value": "에테르 갑옷"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Armadura Etérea"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "以太護甲"}}
      }
