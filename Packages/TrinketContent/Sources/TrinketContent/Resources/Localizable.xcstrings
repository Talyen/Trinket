    "affixes.kinbound.astral_description": {
      "comment": "ContentManifest/affixes.tsv: kinbound, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Unter halber <keyword id=\"health\">Gesundheit</keyword> heilst du <keyword id=\"health\">Gesundheit</keyword> in Höhe von <value id=\"quantity_1\">%1$lld</value>%% des Angriffsschadens deines Verbündeten"}},
        "en": {"stringUnit": {"state": "translated", "value": "Below half <keyword id=\"health\">Health</keyword>, restore <keyword id=\"health\">Health</keyword> equal to <value id=\"quantity_1\">%1$lld</value>%% of your ally's attack damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Con menos de la mitad de tu <keyword id=\"health\">Salud</keyword>, recupera <keyword id=\"health\">Salud</keyword> equivalente al <value id=\"quantity_1\">%1$lld</value>%% del daño de ataque de tu aliado"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Sous la moitié de votre <keyword id=\"health\">Santé</keyword>, restaurez de la <keyword id=\"health\">Santé</keyword> à hauteur de <value id=\"quantity_1\">%1$lld</value>%% des dégâts d’attaque de votre allié"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>が半分未満の間、味方の攻撃ダメージの<value id=\"quantity_1\">%1$lld</value>%%に相当する<keyword id=\"health\">体力</keyword>を回復"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword>이 절반 미만일 때 아군 공격 피해의 <value id=\"quantity_1\">%1$lld</value>%%만큼 <keyword id=\"health\">체력</keyword> 회복"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Com menos da metade da sua <keyword id=\"health\">Vida</keyword>, restaure <keyword id=\"health\">Vida</keyword> igual a <value id=\"quantity_1\">%1$lld</value>%% do dano de ataque do seu aliado"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">生命值</keyword>低於一半時，恢復相當於盟友攻擊傷害<value id=\"quantity_1\">%1$lld</value>%%的<keyword id=\"health\">生命值</keyword>"}}
      }
    },
