    "talents.frost_whelp_freeze_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: frost_whelp_freeze_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wenn du Schaden erleidest, wirfst du mit <value id=\"quantity_1\">%1$lld</value>%% Chance <value id=\"quantity_2\">%2$lld</value> <keyword id=\"freeze\">Frost</keyword>schaden zurück"}},
        "en": {"stringUnit": {"state": "translated", "value": "Taking damage has a <value id=\"quantity_1\">%1$lld</value>%% chance to return <value id=\"quantity_2\">%2$lld</value> <keyword id=\"freeze\">Freeze</keyword> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Recibir daño tiene un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de devolver <value id=\"quantity_2\">%2$lld</value> de daño de <keyword id=\"freeze\">Congelación</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Subir des dégâts a <value id=\"quantity_1\">%1$lld</value>%% de chances de renvoyer <value id=\"quantity_2\">%2$lld</value> dégâts de <keyword id=\"freeze\">Gel</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "ダメージを受けると<value id=\"quantity_1\">%1$lld</value>%%の確率で<keyword id=\"freeze\">凍結</keyword>ダメージを<value id=\"quantity_2\">%2$lld</value>返す"}},
        "ko": {"stringUnit": {"state": "translated", "value": "피해를 받으면 <value id=\"quantity_1\">%1$lld</value>%% 확률로 <keyword id=\"freeze\">빙결</keyword> 피해 <value id=\"quantity_2\">%2$lld</value> 반사"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Receber dano tem <value id=\"quantity_1\">%1$lld</value>%% de chance de devolver <value id=\"quantity_2\">%2$lld</value> de dano de <keyword id=\"freeze\">Congelamento</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "受到傷害時，有<value id=\"quantity_1\">%1$lld</value>%%機率回敬<value id=\"quantity_2\">%2$lld</value>點<keyword id=\"freeze\">冰凍</keyword>傷害"}}
      }
    },
