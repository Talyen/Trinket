    "affixes.unraveling.astral_description": {
      "comment": "ContentManifest/affixes.tsv: unraveling, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>, wenn du einen Gegner <keyword id=\"purge\">entzauberst</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gain <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword> when you <keyword id=\"purge\">Purge</keyword> an enemy"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagnez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Blocage</keyword> lors d’une <keyword id=\"purge\">Dissipation</keyword> sur un ennemi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "敵を<keyword id=\"purge\">強化解除</keyword>すると<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>獲得"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적에게 <keyword id=\"purge\">강화 해제</keyword> 적용 시 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 획득"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"purge\">驅散</keyword>敵人時，獲得<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>"
          }
        }
      }
    },
