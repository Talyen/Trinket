    "talents.knight_stun_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: knight_stun_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Kritische <keyword id=\"stun\">Betäubungs</keyword>-Treffer verursachen doppelten Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">Stun</keyword> Critical Hits deal double damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los golpes críticos de <keyword id=\"stun\">Aturdimiento</keyword> infligen el doble de daño"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les coups critiques d’<keyword id=\"stun\">Étourdissement</keyword> infligent le double de dégâts"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">スタン</keyword>クリティカルヒットのダメージが2倍になる"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">기절</keyword> 치명타가 두 배의 피해"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Golpes críticos de <keyword id=\"stun\">Atordoamento</keyword> causam o dobro de dano"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">暈眩</keyword>暴擊造成雙倍傷害"}}
      }
    },
