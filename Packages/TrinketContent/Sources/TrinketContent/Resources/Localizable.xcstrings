    "affixes.rimed.astral_description": {
      "comment": "ContentManifest/affixes.tsv: rimed, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erleide <value id=\"quantity_1\">%1$lld</value>%% weniger <keyword id=\"freeze\">Frost</keyword>schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take <value id=\"quantity_1\">%1$lld</value>%% less <keyword id=\"freeze\">Freeze</keyword> damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dégâts de <keyword id=\"freeze\">Gel</keyword> subis réduits de <value id=\"quantity_1\">%1$lld</value>%%"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受ける<keyword id=\"freeze\">凍結</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%減少"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받는 <keyword id=\"freeze\">빙결</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>%% 감소"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "承受的<keyword id=\"freeze\">冰凍</keyword>傷害降低<value id=\"quantity_1\">%1$lld</value>%%"
          }
        }
      }
    },
    "affixes.rimed.basic_description": {
