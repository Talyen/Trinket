    "traits.furnace_pulse.description": {
      "comment": "ContentManifest/traits.tsv: furnace_pulse, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verursacht jeden zweiten Zug <value id=\"quantity_1\">%1$lld</value> <keyword id=\"stun\">Betäubungs</keyword>- oder <value id=\"quantity_2\">%2$lld</value> <keyword id=\"burn\">Brand</keyword>schaden an allen Gegnern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deals <value id=\"quantity_1\">%1$lld</value> <keyword id=\"stun\">Stun</keyword> or <value id=\"quantity_2\">%2$lld</value> <keyword id=\"burn\">Burn</keyword> damage every other turn to all enemies"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inflige <value id=\"quantity_1\">%1$lld</value> dégâts d’<keyword id=\"stun\">Étourdissement</keyword> ou <value id=\"quantity_2\">%2$lld</value> dégâts de <keyword id=\"burn\">Brûlure</keyword> à tous les ennemis un tour sur deux"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1ターンおきに敵全体へ<value id=\"quantity_1\">%1$lld</value>の<keyword id=\"stun\">スタン</keyword>ダメージか<value id=\"quantity_2\">%2$lld</value>の<keyword id=\"burn\">炎上</keyword>ダメージを与える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 턴 걸러 모든 적에게 <keyword id=\"stun\">기절</keyword> 피해 <value id=\"quantity_1\">%1$lld</value> 또는 <keyword id=\"burn\">화상</keyword> 피해 <value id=\"quantity_2\">%2$lld</value>"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每隔一回合，對所有敵人造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"stun\">暈眩</keyword>或<value id=\"quantity_2\">%2$lld</value>點<keyword id=\"burn\">燃燒</keyword>傷害"
          }
        }
      }
    },
    "traits.furnace_pulse.name": {
      "comment": "ContentManifest/traits.tsv: furnace_pulse, name",
      "extractionState": "manual",
      "localizations": {
