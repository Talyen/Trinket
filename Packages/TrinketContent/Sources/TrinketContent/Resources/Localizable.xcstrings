        "ko": {"stringUnit": {"state": "translated", "value": "마지막 내기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Última Aposta"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "最後一賭"}}
      }
