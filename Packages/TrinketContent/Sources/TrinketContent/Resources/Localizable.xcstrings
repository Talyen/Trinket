        "en": {"stringUnit": {"state": "translated", "value": "Blood Scent"}},
        "es": {"stringUnit": {"state": "translated", "value": "Aroma de sangre"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Flair du sang"}},
        "ja": {"stringUnit": {"state": "translated", "value": "血の臭い"}},
        "ko": {"stringUnit": {"state": "translated", "value": "피의 냄새"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cheiro de Sangue"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "血腥嗅覺"}}
