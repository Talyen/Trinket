    "talents.shield_scarab_block_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: shield_scarab_block_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Behalte <value id=\"quantity_1\">%1$lld</value>%% deines <keyword id=\"block\">Blocks</keyword> zwischen deinen Zügen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Retain <value id=\"quantity_1\">%1$lld</value>%% of your <keyword id=\"block\">Block</keyword> between turns"}},
        "es": {"stringUnit": {"state": "translated", "value": "Conserva un <value id=\"quantity_1\">%1$lld</value>%% de tu <keyword id=\"block\">Bloqueo</keyword> entre turnos"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Conservez <value id=\"quantity_1\">%1$lld</value>%% de votre <keyword id=\"block\">Blocage</keyword> entre les tours"}},
        "ja": {"stringUnit": {"state": "translated", "value": "ターンをまたいで<keyword id=\"block\">ブロック</keyword>の<value id=\"quantity_1\">%1$lld</value>%%を保持"}},
        "ko": {"stringUnit": {"state": "translated", "value": "턴이 바뀌어도 내 <keyword id=\"block\">방어도</keyword>의 <value id=\"quantity_1\">%1$lld</value>%% 유지"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Retenha <value id=\"quantity_1\">%1$lld</value>%% do seu <keyword id=\"block\">Bloqueio</keyword> entre turnos"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "回合之間保留<value id=\"quantity_1\">%1$lld</value>%%的<keyword id=\"block\">格擋</keyword>"}}
      }
    },
    "talents.shield_scarab_block_t2_1.name": {
      "comment": "ContentManifest/talents.tsv: shield_scarab_block_t2_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Beständiger Panzer"}},
        "en": {"stringUnit": {"state": "translated", "value": "Enduring Shell"}},
        "es": {"stringUnit": {"state": "translated", "value": "Caparazón duradero"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Carapace endurante"}},
