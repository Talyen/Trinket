    "affixes.hallowguard.astral_description": {
      "comment": "ContentManifest/affixes.tsv: hallowguard, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein <keyword id=\"holy\">heiliger</keyword> Angriff einem Gegner schadet, während du keinen <keyword id=\"block\">Block</keyword> hast, erhalte <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a <keyword id=\"holy\">Holy</keyword> attack damages an enemy while you have no <keyword id=\"block\">Block</keyword>, gain <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si une attaque de type <keyword id=\"holy\">Sacré</keyword> blesse un ennemi alors que vous n’avez pas de <keyword id=\"block\">Blocage</keyword>, gagnez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Blocage</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分に<keyword id=\"block\">ブロック</keyword>がない状態で<keyword id=\"holy\">聖</keyword>攻撃が敵にダメージを与えると、<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>獲得"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"block\">방어도</keyword>가 없을 때 <keyword id=\"holy\">신성</keyword> 공격으로 적에게 피해를 주면 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 획득"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自身沒有<keyword id=\"block\">格擋</keyword>時，若<keyword id=\"holy\">神聖</keyword>攻擊傷害敵人，則獲得<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>"
          }
        }
      }
    },
