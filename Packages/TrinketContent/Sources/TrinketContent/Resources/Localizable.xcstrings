    "talents.frost_whelp_dodge_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: frost_whelp_dodge_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Ausweichen ignoriert dein nächster <keyword id=\"freeze\">Frost</keyword>-Angriff gegnerischen <keyword id=\"block\">Block</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodging makes your next <keyword id=\"freeze\">Freeze</keyword> attack ignore enemy <keyword id=\"block\">Block</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une esquive fait ignorer le <keyword id=\"block\">Blocage</keyword> ennemi à votre prochaine attaque de <keyword id=\"freeze\">Gel</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回避すると、次の<keyword id=\"freeze\">凍結</keyword>攻撃が敵の<keyword id=\"block\">ブロック</keyword>を無視"
