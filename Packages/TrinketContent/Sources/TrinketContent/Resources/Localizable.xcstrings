    "talents.wolf_dodge_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: wolf_dodge_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausweichen verursacht mit <value id=\"quantity_1\">%1$lld</value>%% Chance <value id=\"quantity_2\">%2$lld</value> <keyword id=\"physical\">physischen</keyword> Schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodging has a <value id=\"quantity_1\">%1$lld</value>%% chance to deal <value id=\"quantity_2\">%2$lld</value> <keyword id=\"physical\">Physical</keyword> damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une esquive a <value id=\"quantity_1\">%1$lld</value>%% de chances d’infliger <value id=\"quantity_2\">%2$lld</value> dégâts de type <keyword id=\"physical\">Physique</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回避すると<value id=\"quantity_1\">%1$lld</value>%%の確率で<keyword id=\"physical\">物理</keyword>ダメージを<value id=\"quantity_2\">%2$lld</value>与える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회피 시 <value id=\"quantity_1\">%1$lld</value>%% 확률로 <keyword id=\"physical\">물리</keyword> 피해 <value id=\"quantity_2\">%2$lld</value>"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "閃避時有<value id=\"quantity_1\">%1$lld</value>%%機率造成<value id=\"quantity_2\">%2$lld</value>點<keyword id=\"physical\">物理</keyword>傷害"
          }
        }
      }
    },
