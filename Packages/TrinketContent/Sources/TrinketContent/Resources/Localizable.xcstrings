    "authored.4449bb838ee32271": {
      "comment": "Packages/TrinketAppState/Sources/TrinketAppState/Play/PlayBattleCoordinator+Launch.swift: player-facing failure message",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dieser Kampf ist noch nicht bereit."}},
        "en": {"stringUnit": {"state": "translated", "value": "This battle is not ready yet."}},
        "es": {"stringUnit": {"state": "translated", "value": "Esta batalla aún no está lista."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Ce combat n’est pas encore prêt."}},
        "ja": {"stringUnit": {"state": "translated", "value": "この戦闘はまだ準備できていません。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "이 전투는 아직 준비되지 않았습니다."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Esta batalha ainda não está pronta."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "此戰鬥尚未準備就緒。"}}
      }
    },
    "authored.444aa5f030ead1ef": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog+Accessory.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Im Kampf erhaltenes <keyword id=\"gold\">Gold</keyword> verstärkt deinen nächsten <keyword id=\"holy\">heiligen</keyword> Treffer einer manuell gespielten Karte um ebenso viel Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"gold\">Gold</keyword> gained in combat adds equal damage to your next <keyword id=\"holy\">Holy</keyword> hit from a manually played card"}},
        "es": {"stringUnit": {"state": "translated", "value": "El <keyword id=\"gold\">Oro</keyword> obtenido en combate añade una cantidad igual de daño a tu siguiente impacto <keyword id=\"holy\">sagrado</keyword> de una carta jugada manualmente"}},
        "fr": {"stringUnit": {"state": "translated", "value": "L’<keyword id=\"gold\">Or</keyword> gagné en combat ajoute autant de dégâts au prochain coup de type <keyword id=\"holy\">Sacré</keyword> d’une carte jouée manuellement"}},
        "ja": {"stringUnit": {"state": "translated", "value": "戦闘中に獲得した<keyword id=\"gold\">ゴールド</keyword>と同量のダメージを、手動で使ったカードによる次の<keyword id=\"holy\">聖</keyword>ヒットに追加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "전투에서 획득한 <keyword id=\"gold\">골드</keyword>만큼, 직접 사용한 카드의 다음 <keyword id=\"holy\">신성</keyword> 적중 피해 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O <keyword id=\"gold\">Ouro</keyword> obtido em combate adiciona a mesma quantidade de dano ao seu próximo acerto <keyword id=\"holy\">Sagrado</keyword> com uma carta jogada manualmente"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "戰鬥中獲得的<keyword id=\"gold\">金幣</keyword>，會為手動打出的牌所造成的下一次<keyword id=\"holy\">神聖</keyword>命中增加等量傷害"}}
      }
    },
