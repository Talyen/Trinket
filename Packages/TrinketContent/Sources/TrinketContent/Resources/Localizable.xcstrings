    "authored.69434fce448a56c6": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Encounters/Mystery/MysteryEventPool+Events.swift: narrative",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Unter „%1$@“ liegt ein Geldbeutel, während zerrissenes Leder „%2$@“ verbirgt"}},
        "en": {"stringUnit": {"state": "translated", "value": "A coinpurse rests beneath “%1$@” as torn leather conceals “%2$@”"}},
        "es": {"stringUnit": {"state": "translated", "value": "Una bolsa de monedas descansa bajo «%1$@» mientras cuero rasgado oculta «%2$@»"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Une bourse repose sous « %1$@ », tandis qu’un cuir déchiré dissimule « %2$@ »"}},
        "ja": {"stringUnit": {"state": "translated", "value": "「%1$@」の下には小銭入れがあり、破れた革が「%2$@」を隠している"}},
        "ko": {"stringUnit": {"state": "translated", "value": "‘%1$@’ 아래 동전 주머니가 놓여 있고, 찢어진 가죽이 감춘 것은 ‘%2$@’입니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Uma bolsa de moedas repousa sob “%1$@” enquanto couro rasgado esconde “%2$@”"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "錢袋靜躺在「%1$@」下方，破舊皮革掩藏著「%2$@」"}}
      }
    },
    "authored.698b9e43bd7a1a9f": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Abilities/AbilityCatalog+Basic.swift: name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Zerfleischen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Maul"}},
        "es": {"stringUnit": {"state": "translated", "value": "Desgarrar"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Mutilation"}},
        "ja": {"stringUnit": {"state": "translated", "value": "噛み砕き"}},
        "ko": {"stringUnit": {"state": "translated", "value": "후려치기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Dilacerar"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "撕咬"}}
      }
    },
    "authored.69b5403a1ea2efdc": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Encounters/Mystery/MysteryEventPool+Events.swift: narrative",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Heilkräuterbeete umgeben „%1$@“, während Behandlungsnotizen unter „%2$@“ liegen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Medicinal beds surround “%1$@” as treatment notes lie beneath “%2$@”"}},
        "es": {"stringUnit": {"state": "translated", "value": "Bancales medicinales rodean «%1$@» mientras notas de tratamiento yacen bajo «%2$@»"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Des parterres médicinaux entourent « %1$@ », tandis que des notes de traitement reposent sous « %2$@ »"}},
        "ja": {"stringUnit": {"state": "translated", "value": "薬草の花壇が「%1$@」を囲み、「%2$@」の下には治療の覚え書きがある"}},
        "ko": {"stringUnit": {"state": "translated", "value": "약초밭이 ‘%1$@’ 주위를 둘러싸고, 치료 기록은 ‘%2$@’ 아래 놓여 있습니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Canteiros medicinais cercam “%1$@” enquanto anotações de tratamentos repousam sob “%2$@”"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "藥草苗床圍繞著「%1$@」，治療筆記藏在「%2$@」下方"}}
      }
    },
    "authored.6a177ba3f04a910d": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Encounters/Rewards/RewardModifier.swift: computed title",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erntepakt"}},
        "en": {"stringUnit": {"state": "translated", "value": "Harvest Pact"}},
        "es": {"stringUnit": {"state": "translated", "value": "Pacto de la cosecha"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Pacte des récoltes"}},
        "ja": {"stringUnit": {"state": "translated", "value": "収穫の契約"}},
        "ko": {"stringUnit": {"state": "translated", "value": "수확의 계약"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Pacto da Colheita"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "豐收契約"}}
      }
    },
    "authored.6a206b91727070b3": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Encounters/Mystery/MysteryEventPool+Events.swift: narrative",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Heilblüten umgeben „%1$@“, und freiliegende Wurzeln zeichnen neben „%2$@“ Heilriten nach"}},
        "en": {"stringUnit": {"state": "translated", "value": "Medicinal blooms surround “%1$@”, and exposed roots trace healing rites near “%2$@”"}},
        "es": {"stringUnit": {"state": "translated", "value": "Flores medicinales rodean «%1$@», y raíces expuestas trazan ritos curativos cerca de «%2$@»"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Des fleurs médicinales entourent « %1$@ », tandis que des racines exposées tracent des rites de guérison près de « %2$@ »"}},
        "ja": {"stringUnit": {"state": "translated", "value": "薬効のある花が「%1$@」を囲み、むき出しの根が「%2$@」の近くに癒やしの儀式を描いている"}},
        "ko": {"stringUnit": {"state": "translated", "value": "약용 꽃이 ‘%1$@’ 주위를 둘러싸고, 드러난 뿌리가 ‘%2$@’ 근처에 치유 의식을 그립니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Flores medicinais cercam “%1$@”, e raízes expostas traçam ritos de cura perto de “%2$@”"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "藥用花朵圍繞著「%1$@」，外露的根鬚在「%2$@」附近勾勒出療癒儀式"}}
      }
    },
    "authored.6ad421ff35f8ad4b": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">Entzaubere</keyword> alle Verstärkungen, wenn du einen Gegner <keyword id=\"stun\">betäubst</keyword>\nVerursache pro entfernter Verstärkung <value id=\"quantity_1\">%1$lld</value> <keyword id=\"holy\">heiligen</keyword> Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">Purge</keyword> all buffs when you <keyword id=\"stun\">Stun</keyword> an enemy\nDeal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"holy\">Holy</keyword> damage per buff removed"}},
        "es": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">Purga</keyword> todas las mejoras cuando <keyword id=\"stun\">aturdes</keyword> a un enemigo\nInflige <value id=\"quantity_1\">%1$lld</value> de daño <keyword id=\"holy\">sagrado</keyword> por cada mejora eliminada"}},
        "fr": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">Dissipation</keyword> de tous les bonus lorsque vous infligez un <keyword id=\"stun\">Étourdissement</keyword> à un ennemi\nInfligez <value id=\"quantity_1\">%1$lld</value> dégâts de type <keyword id=\"holy\">Sacré</keyword> par bonus retiré"}},
        "ja": {"stringUnit": {"state": "translated", "value": "敵を<keyword id=\"stun\">スタン</keyword>状態にすると、すべての強化効果を<keyword id=\"purge\">強化解除</keyword>\n解除した強化効果1つにつき<keyword id=\"holy\">聖</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える"}},
        "ko": {"stringUnit": {"state": "translated", "value": "적을 <keyword id=\"stun\">기절</keyword>시키면 <keyword id=\"purge\">강화 해제</keyword>로 모든 강화 효과 제거\n제거한 강화 효과마다 <keyword id=\"holy\">신성</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">Expurgue</keyword> todos os efeitos positivos ao <keyword id=\"stun\">Atordoar</keyword> um inimigo\nCause <value id=\"quantity_1\">%1$lld</value> de dano <keyword id=\"holy\">Sagrado</keyword> por efeito positivo removido"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "使敵人<keyword id=\"stun\">暈眩</keyword>時，<keyword id=\"purge\">驅散</keyword>所有增益效果\n每移除一項增益效果，造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"holy\">神聖</keyword>傷害"}}
      }
    },
