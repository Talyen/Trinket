    "talents.shield_scarab_holy_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: shield_scarab_holy_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"holy\">Heilige</keyword> Angriffe beider Verbündeten erhalten +<value id=\"quantity_1\">%1$lld</value>%% Chance auf kritische Treffer"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both allies' <keyword id=\"holy\">Holy</keyword> attacks gain +<value id=\"quantity_1\">%1$lld</value>%% Critical Hit chance"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les attaques de type <keyword id=\"holy\">Sacré</keyword> des deux alliés gagnent +<value id=\"quantity_1\">%1$lld</value>%% de chances de coup critique"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "味方2人の<keyword id=\"holy\">聖</keyword>攻撃のクリティカル率が<value id=\"quantity_1\">%1$lld</value>%%上昇"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 아군의 <keyword id=\"holy\">신성</keyword> 공격 치명타 확률 +<value id=\"quantity_1\">%1$lld</value>%%"
          }
        },
        "zh-Hant": {
