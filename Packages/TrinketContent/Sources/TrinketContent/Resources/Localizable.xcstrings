    "talents.library_owl_health_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: library_owl_health_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Wiederherstellen von <keyword id=\"health\">Gesundheit</keyword> verringert den nächsten erlittenen Schaden dieses Verbündeten um <value id=\"quantity_1\">%1$lld</value>%%"
          }
