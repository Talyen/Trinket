    "talents.risen_skeleton_physical_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_physical_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dein <keyword id=\"block\">Block</keyword> durchbrochen wird, erhält dein nächster <keyword id=\"physical\">physischer</keyword> Angriff <value id=\"quantity_1\">%1$lld</value> Schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When your <keyword id=\"block\">Block</keyword> breaks, your next <keyword id=\"physical\">Physical</keyword> attack gains <value id=\"quantity_1\">%1$lld</value> damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque votre <keyword id=\"block\">Blocage</keyword> est brisé, votre prochaine attaque de type <keyword id=\"physical\">Physique</keyword> gagne <value id=\"quantity_1\">%1$lld</value> dégâts"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の<keyword id=\"block\">ブロック</keyword>が崩れると、次の<keyword id=\"physical\">物理</keyword>攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>増加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 <keyword id=\"block\">방어도</keyword>가 깨지면 다음 <keyword id=\"physical\">물리</keyword> 공격의 피해 <value id=\"quantity_1\">%1$lld</value> 증가"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自身<keyword id=\"block\">格擋</keyword>被擊破時，下次<keyword id=\"physical\">物理</keyword>攻擊的傷害增加<value id=\"quantity_1\">%1$lld</value>點"
          }
        }
      }
    },
