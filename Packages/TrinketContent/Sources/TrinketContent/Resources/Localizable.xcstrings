    "authored.df13c103f38b46a4": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/InventoryItem+Compatibility.swift: canonical numeric compatibility description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">Blutung</keyword>sschaden hat eine Chance von <value id=\"quantity_1\">%1$lld</value>%%, zusätzlich <keyword id=\"gold\">Gold</keyword> zu stehlen"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">Bleed</keyword> damage has a <value id=\"quantity_1\">%1$lld</value>%% chance to also steal <keyword id=\"gold\">Gold</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "El daño de <keyword id=\"bleed\">Sangrado</keyword> tiene un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de robar también <keyword id=\"gold\">Oro</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les dégâts de <keyword id=\"bleed\">Saignement</keyword> ont <value id=\"quantity_1\">%1$lld</value>%% de chances de voler aussi de l’<keyword id=\"gold\">Or</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">出血</keyword>ダメージ時、<value id=\"quantity_1\">%1$lld</value>%%の確率でさらに<keyword id=\"gold\">ゴールド</keyword>を盗む"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">출혈</keyword> 피해가 <value id=\"quantity_1\">%1$lld</value>%% 확률로 <keyword id=\"gold\">골드</keyword>도 훔침"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O dano de <keyword id=\"bleed\">Sangramento</keyword> tem <value id=\"quantity_1\">%1$lld</value>%% de chance de também roubar <keyword id=\"gold\">Ouro</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">流血</keyword>傷害有<value id=\"quantity_1\">%1$lld</value>%%機率同時偷取<keyword id=\"gold\">金幣</keyword>"}}
      }
    },
    "authored.df85700321f0bc10": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Abilities/AbilityCatalog+Skill.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verursache <value id=\"quantity_1\">%1$lld</value> <keyword id=\"stun\">Betäubungs</keyword>schaden, im ersten Kampfzug verdoppelt"}},
        "en": {"stringUnit": {"state": "translated", "value": "Deal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"stun\">Stun</keyword> damage, doubled on the first combat turn"}},
        "es": {"stringUnit": {"state": "translated", "value": "Inflige <value id=\"quantity_1\">%1$lld</value> de daño de <keyword id=\"stun\">Aturdimiento</keyword>, que se duplica en el primer turno de combate"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Infligez <value id=\"quantity_1\">%1$lld</value> dégâts d’<keyword id=\"stun\">Étourdissement</keyword>, doublés au premier tour du combat"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">スタン</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える（戦闘の最初のターンは2倍）"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">기절</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>. 전투 첫 턴에는 두 배"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cause <value id=\"quantity_1\">%1$lld</value> de dano de <keyword id=\"stun\">Atordoamento</keyword>, dobrado no primeiro turno de combate"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"stun\">暈眩</keyword>傷害，戰鬥首回合傷害加倍"}}
      }
    },
    "authored.e027aff0c3f42240": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wenn dein <keyword id=\"block\">Block</keyword> in einer Runde erstmals durchbrochen wird, verursache beim Angreifer <value id=\"quantity_1\">%1$lld</value> <keyword id=\"holy\">heiligen</keyword> Schaden und <value id=\"quantity_2\">%2$lld</value> <keyword id=\"stun\">Betäubungs</keyword>schaden und stelle dann <value id=\"quantity_3\">%3$lld</value> <keyword id=\"health\">Gesundheit</keyword> wieder her"}},
        "en": {"stringUnit": {"state": "translated", "value": "The first time each round your <keyword id=\"block\">Block</keyword> is broken, deal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"holy\">Holy</keyword> and <value id=\"quantity_2\">%2$lld</value> <keyword id=\"stun\">Stun</keyword> damage to the attacker, then restore <value id=\"quantity_3\">%3$lld</value> <keyword id=\"health\">Health</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "La primera vez de cada ronda que se rompe tu <keyword id=\"block\">Bloqueo</keyword>, inflige <value id=\"quantity_1\">%1$lld</value> de daño <keyword id=\"holy\">sagrado</keyword> y <value id=\"quantity_2\">%2$lld</value> de daño de <keyword id=\"stun\">Aturdimiento</keyword> al atacante; luego restaura <value id=\"quantity_3\">%3$lld</value> de <keyword id=\"health\">Salud</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "La première fois que votre <keyword id=\"block\">Blocage</keyword> est brisé à chaque manche, infligez <value id=\"quantity_1\">%1$lld</value> dégâts de type <keyword id=\"holy\">Sacré</keyword> et <value id=\"quantity_2\">%2$lld</value> dégâts d’<keyword id=\"stun\">Étourdissement</keyword> à l’attaquant, puis restaurez <value id=\"quantity_3\">%3$lld</value> <keyword id=\"health\">Santé</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "各ラウンドに初めて自分の<keyword id=\"block\">ブロック</keyword>が崩れると、攻撃者に<keyword id=\"holy\">聖</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>、<keyword id=\"stun\">スタン</keyword>ダメージを<value id=\"quantity_2\">%2$lld</value>与え、その後<keyword id=\"health\">体力</keyword>を<value id=\"quantity_3\">%3$lld</value>回復"}},
        "ko": {"stringUnit": {"state": "translated", "value": "매 라운드 처음으로 내 <keyword id=\"block\">방어도</keyword>가 깨지면 공격자에게 <keyword id=\"holy\">신성</keyword> 피해 <value id=\"quantity_1\">%1$lld</value> 및 <keyword id=\"stun\">기절</keyword> 피해 <value id=\"quantity_2\">%2$lld</value>, 이후 <keyword id=\"health\">체력</keyword> <value id=\"quantity_3\">%3$lld</value> 회복"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Na primeira vez a cada rodada em que seu <keyword id=\"block\">Bloqueio</keyword> for quebrado, cause <value id=\"quantity_1\">%1$lld</value> de dano <keyword id=\"holy\">Sagrado</keyword> e <value id=\"quantity_2\">%2$lld</value> de dano de <keyword id=\"stun\">Atordoamento</keyword> ao atacante, depois restaure <value id=\"quantity_3\">%3$lld</value> de <keyword id=\"health\">Vida</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每輪自身<keyword id=\"block\">格擋</keyword>首次被擊破時，對攻擊者造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"holy\">神聖</keyword>及<value id=\"quantity_2\">%2$lld</value>點<keyword id=\"stun\">暈眩</keyword>傷害，再恢復<value id=\"quantity_3\">%3$lld</value>點<keyword id=\"health\">生命值</keyword>"}}
      }
    },
    "authored.e0de7af20ffca551": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/InventoryItem+Compatibility.swift: canonical numeric compatibility description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Deine <keyword id=\"bleed\">Blutung</keyword> verursacht <value id=\"quantity_1\">%1$lld</value> zusätzlichen Schaden bei <keyword id=\"poison\">vergifteten</keyword> Gegnern"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your <keyword id=\"bleed\">Bleed</keyword> deals <value id=\"quantity_1\">%1$lld</value> additional damage to <keyword id=\"poison\">Poisoned</keyword> enemies"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu <keyword id=\"bleed\">Sangrado</keyword> inflige <value id=\"quantity_1\">%1$lld</value> de daño adicional a enemigos <keyword id=\"poison\">envenenados</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre <keyword id=\"bleed\">Saignement</keyword> inflige <value id=\"quantity_1\">%1$lld</value> dégâts supplémentaires aux ennemis <keyword id=\"poison\">empoisonnés</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "あなたの<keyword id=\"bleed\">出血</keyword>は、<keyword id=\"poison\">毒</keyword>状態の敵に<value id=\"quantity_1\">%1$lld</value>の追加ダメージを与える"}},
        "ko": {"stringUnit": {"state": "translated", "value": "자신의 <keyword id=\"bleed\">출혈</keyword>이 <keyword id=\"poison\">독</keyword>에 걸린 적에게 <value id=\"quantity_1\">%1$lld</value>의 추가 피해를 줍니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seu <keyword id=\"bleed\">Sangramento</keyword> causa <value id=\"quantity_1\">%1$lld</value> de dano adicional a inimigos <keyword id=\"poison\">Envenenados</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "你的<keyword id=\"bleed\">流血</keyword>對<keyword id=\"poison\">中毒</keyword>的敵人額外造成<value id=\"quantity_1\">%1$lld</value>點傷害"}}
      }
    },
