    "talents.lizard_scout_gold_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: lizard_scout_gold_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Gestohlenes <keyword id=\"gold\">Gold</keyword> fügt deinem nächsten Angriff ebenso viel Schaden hinzu"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"gold\">Gold</keyword> stolen adds equal damage to your next attack"}},
        "es": {"stringUnit": {"state": "translated", "value": "El <keyword id=\"gold\">Oro</keyword> robado añade una cantidad igual de daño a tu siguiente ataque"}},
        "fr": {"stringUnit": {"state": "translated", "value": "L’<keyword id=\"gold\">Or</keyword> volé ajoute autant de dégâts à votre prochaine attaque"}},
        "ja": {"stringUnit": {"state": "translated", "value": "盗んだ<keyword id=\"gold\">ゴールド</keyword>と同量のダメージを次の攻撃に追加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "훔친 <keyword id=\"gold\">골드</keyword>만큼 다음 공격의 피해 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O <keyword id=\"gold\">Ouro</keyword> roubado adiciona a mesma quantidade de dano ao seu próximo ataque"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "偷取的<keyword id=\"gold\">金幣</keyword>為下次攻擊增加等量傷害"}}
      }
