        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">출혈</keyword> 중인 적에게 <keyword id=\"burn\">화상</keyword> 피해 <value id=\"quantity_1\">%1$lld</value> 추가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "A <keyword id=\"burn\">Queimadura</keyword> causa <value id=\"quantity_1\">%1$lld</value> de dano adicional a inimigos com <keyword id=\"bleed\">Sangramento</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">燃燒</keyword>對<keyword id=\"bleed\">流血</keyword>中的敵人額外造成<value id=\"quantity_1\">%1$lld</value>點傷害"}}
