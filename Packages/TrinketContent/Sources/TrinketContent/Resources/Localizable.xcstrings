        "ja": {"stringUnit": {"state": "translated", "value": "撒きびし"}},
        "ko": {"stringUnit": {"state": "translated", "value": "흩뿌린 마름쇠"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Estrepes Espalhados"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "散落鐵蒺藜"}}
      }
    },
    "talents.wildcard_dodge_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: wildcard_dodge_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ausweichen verursacht mit <value id=\"quantity_1\">%1$lld</value>%% Chance <value id=\"quantity_2\">%2$lld</value> <keyword id=\"burn\">Brand</keyword>schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Dodging has a <value id=\"quantity_1\">%1$lld</value>%% chance to deal <value id=\"quantity_2\">%2$lld</value> <keyword id=\"burn\">Burn</keyword> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Esquivar tiene un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de infligir <value id=\"quantity_2\">%2$lld</value> de daño de <keyword id=\"burn\">Quemadura</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Une esquive a <value id=\"quantity_1\">%1$lld</value>%% de chances d’infliger <value id=\"quantity_2\">%2$lld</value> dégâts de <keyword id=\"burn\">Brûlure</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "回避すると<value id=\"quantity_1\">%1$lld</value>%%の確率で<keyword id=\"burn\">炎上</keyword>ダメージを<value id=\"quantity_2\">%2$lld</value>与える"}},
        "ko": {"stringUnit": {"state": "translated", "value": "회피 시 <value id=\"quantity_1\">%1$lld</value>%% 확률로 <keyword id=\"burn\">화상</keyword> 피해 <value id=\"quantity_2\">%2$lld</value>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Esquivar tem <value id=\"quantity_1\">%1$lld</value>%% de chance de causar <value id=\"quantity_2\">%2$lld</value> de dano de <keyword id=\"burn\">Queimadura</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "閃避時有<value id=\"quantity_1\">%1$lld</value>%%機率造成<value id=\"quantity_2\">%2$lld</value>點<keyword id=\"burn\">燃燒</keyword>傷害"}}
      }
    },
    "talents.wildcard_dodge_t3_1.name": {
      "comment": "ContentManifest/talents.tsv: wildcard_dodge_t3_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Rauchtrick"}},
        "en": {"stringUnit": {"state": "translated", "value": "Smoke Trick"}},
        "es": {"stringUnit": {"state": "translated", "value": "Truco de humo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Tour de fumée"}},
        "ja": {"stringUnit": {"state": "translated", "value": "煙の術"}},
        "ko": {"stringUnit": {"state": "translated", "value": "연막 속임수"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Truque de Fumaça"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "煙霧戲法"}}
      }
    },
    "talents.wildcard_dodge_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: wildcard_dodge_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Jeder Angriff, dem du nicht ausweichst, erhöht deine Chance auf <keyword id=\"dodge\">Ausweichen</keyword> um <value id=\"quantity_1\">%1$lld</value>%%\nAusweichen setzt diesen Bonus zurück"}},
        "en": {"stringUnit": {"state": "translated", "value": "Each undodged attack increases your <keyword id=\"dodge\">Dodge</keyword> chance by <value id=\"quantity_1\">%1$lld</value>%%\nDodging resets this bonus"}},
        "es": {"stringUnit": {"state": "translated", "value": "Cada ataque que no esquivas aumenta tu probabilidad de <keyword id=\"dodge\">Evasión</keyword> en un <value id=\"quantity_1\">%1$lld</value>%%\nEsquivar restablece esta bonificación"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Chaque attaque non esquivée augmente vos chances d’<keyword id=\"dodge\">Esquive</keyword> de <value id=\"quantity_1\">%1$lld</value>%%\nUne esquive réinitialise ce bonus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "回避しなかった攻撃1回につき<keyword id=\"dodge\">回避</keyword>率が<value id=\"quantity_1\">%1$lld</value>%%上昇\n回避するとこのボーナスはリセット"}},
        "ko": {"stringUnit": {"state": "translated", "value": "공격을 회피하지 못할 때마다 <keyword id=\"dodge\">회피</keyword> 확률 <value id=\"quantity_1\">%1$lld</value>%% 증가\n회피 시 이 보너스 초기화"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cada ataque não esquivado aumenta sua chance de <keyword id=\"dodge\">Esquiva</keyword> em <value id=\"quantity_1\">%1$lld</value>%%\nEsquivar redefine esse bônus"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每次未閃避攻擊，<keyword id=\"dodge\">閃避</keyword>機率提高<value id=\"quantity_1\">%1$lld</value>%%\n閃避會重設此加成"}}
      }
    },
    "talents.wildcard_dodge_t3_2.name": {
      "comment": "ContentManifest/talents.tsv: wildcard_dodge_t3_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Steigende Chancen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Improving Odds"}},
        "es": {"stringUnit": {"state": "translated", "value": "Probabilidades crecientes"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Chances croissantes"}},
        "ja": {"stringUnit": {"state": "translated", "value": "高まる勝算"}},
        "ko": {"stringUnit": {"state": "translated", "value": "높아지는 승산"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Chances Crescentes"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "勝算提升"}}
      }
    },
    "talents.wildcard_dodge_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: wildcard_dodge_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Nach dem Ausweichen ignoriert dein nächster <keyword id=\"physical\">physischer</keyword> Angriff gegnerischen <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Dodging makes your next <keyword id=\"physical\">Physical</keyword> attack ignore enemy <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Esquivar hace que tu siguiente ataque <keyword id=\"physical\">físico</keyword> ignore el <keyword id=\"block\">Bloqueo</keyword> del enemigo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Une esquive fait ignorer le <keyword id=\"block\">Blocage</keyword> ennemi à votre prochaine attaque de type <keyword id=\"physical\">Physique</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "回避すると、次の<keyword id=\"physical\">物理</keyword>攻撃が敵の<keyword id=\"block\">ブロック</keyword>を無視"}},
        "ko": {"stringUnit": {"state": "translated", "value": "회피 시 다음 <keyword id=\"physical\">물리</keyword> 공격이 적의 <keyword id=\"block\">방어도</keyword> 무시"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Esquivar faz seu próximo ataque <keyword id=\"physical\">Físico</keyword> ignorar o <keyword id=\"block\">Bloqueio</keyword> inimigo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "閃避後，下次<keyword id=\"physical\">物理</keyword>攻擊無視敵人<keyword id=\"block\">格擋</keyword>"}}
      }
    },
    "talents.wildcard_dodge_t4_1.name": {
      "comment": "ContentManifest/talents.tsv: wildcard_dodge_t4_1, name",
      "extractionState": "manual",
      "localizations": {
