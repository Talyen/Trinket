          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復<keyword id=\"health\">生命值</keyword>時，也會淨化<keyword id=\"burn\">燃燒</keyword>"
          }
        }
      }
    },
