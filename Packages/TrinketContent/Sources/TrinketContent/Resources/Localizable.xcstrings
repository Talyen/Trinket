        "es": {"stringUnit": {"state": "translated", "value": "Temerario"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Téméraire"}},
        "ja": {"stringUnit": {"state": "translated", "value": "無謀"}},
        "ko": {"stringUnit": {"state": "translated", "value": "무모함"}},
