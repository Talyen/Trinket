    "authored.9906a5272a76a37d": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Encounters/Mystery/MysteryEventPool+Events.swift: narrative",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ein verlassenes Wolfslager birgt „%1$@“, während neben „%2$@“ Trockenfleisch wartet"}},
        "en": {"stringUnit": {"state": "translated", "value": "A wolf’s abandoned camp holds “%1$@” while dried meat waits beside “%2$@”"}},
        "es": {"stringUnit": {"state": "translated", "value": "El campamento abandonado de un lobo alberga «%1$@» mientras carne seca espera junto a «%2$@»"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Un camp abandonné par un loup renferme « %1$@ », tandis que de la viande séchée attend près de « %2$@ »"}},
        "ja": {"stringUnit": {"state": "translated", "value": "狼が去った野営地に「%1$@」が残され、「%2$@」の横には干し肉がある"}},
        "ko": {"stringUnit": {"state": "translated", "value": "늑대의 버려진 야영지에 있는 것은 ‘%1$@’, 말린 고기는 ‘%2$@’ 곁에서 기다리고 있습니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O acampamento abandonado de um lobo contém “%1$@” enquanto carne seca aguarda ao lado de “%2$@”"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "狼的廢棄營地藏著「%1$@」，乾肉在「%2$@」旁等候"}}
      }
    },
