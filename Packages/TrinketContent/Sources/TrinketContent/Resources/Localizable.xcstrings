    "affixes.shredding.astral_description": {
      "comment": "ContentManifest/affixes.tsv: shredding, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein <keyword id=\"physical\">physischer</keyword> Schaden ignoriert <value id=\"quantity_1\">%1$lld</value>%% der gegnerischen Schadensreduktion"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your <keyword id=\"physical\">Physical</keyword> damage ignores <value id=\"quantity_1\">%1$lld</value>%% of enemy damage reduction"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos dégâts de type <keyword id=\"physical\">Physique</keyword> ignorent <value id=\"quantity_1\">%1$lld</value>%% de la réduction des dégâts ennemie"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の<keyword id=\"physical\">物理</keyword>ダメージが敵のダメージ軽減を<value id=\"quantity_1\">%1$lld</value>%%無視"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 <keyword id=\"physical\">물리</keyword> 피해가 적의 피해 감소 <value id=\"quantity_1\">%1$lld</value>%% 무시"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自身<keyword id=\"physical\">物理</keyword>傷害無視敵人<value id=\"quantity_1\">%1$lld</value>%%的傷害減免"
          }
        }
      }
    },
