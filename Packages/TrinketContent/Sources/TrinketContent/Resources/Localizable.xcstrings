    "affixes.bloodward.astral_description": {
      "comment": "ContentManifest/affixes.tsv: bloodward, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">Lebensraub</keyword> gewährt mit <value id=\"quantity_1\">%1$lld</value>%% Chance zusätzlich ebenso viel <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">Leech</keyword> has a <value id=\"quantity_1\">%1$lld</value>%% chance to also grant an equal amount of <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">Absorción</keyword> tiene un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de otorgar también una cantidad igual de <keyword id=\"block\">Bloqueo</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le <keyword id=\"leech\">Vol de vie</keyword> a <value id=\"quantity_1\">%1$lld</value>%% de chances d’octroyer aussi autant de <keyword id=\"block\">Blocage</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">吸収</keyword>すると<value id=\"quantity_1\">%1$lld</value>%%の確率で同量の<keyword id=\"block\">ブロック</keyword>も獲得"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">흡혈</keyword> 시 <value id=\"quantity_1\">%1$lld</value>%% 확률로 같은 양의 <keyword id=\"block\">방어도</keyword>도 획득"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">Drenagem</keyword> tem <value id=\"quantity_1\">%1$lld</value>%% de chance de também conceder uma quantidade igual de <keyword id=\"block\">Bloqueio</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">吸血</keyword>有<value id=\"quantity_1\">%1$lld</value>%%機率同時賦予等量<keyword id=\"block\">格擋</keyword>"}}
      }
    },
