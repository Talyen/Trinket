    "talents.knight_stun_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: knight_stun_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">Betäubungs</keyword>schaden wird um die Hälfte deines <keyword id=\"block\">Blocks</keyword> erhöht"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">Stun</keyword> damage is increased by half your <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "El daño de <keyword id=\"stun\">Aturdimiento</keyword> aumenta en la mitad de tu <keyword id=\"block\">Bloqueo</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les dégâts d’<keyword id=\"stun\">Étourdissement</keyword> augmentent à hauteur de la moitié de votre <keyword id=\"block\">Blocage</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">スタン</keyword>ダメージが自分の<keyword id=\"block\">ブロック</keyword>の半分増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "내 <keyword id=\"block\">방어도</keyword>의 절반만큼 <keyword id=\"stun\">기절</keyword> 피해 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O dano de <keyword id=\"stun\">Atordoamento</keyword> aumenta em metade do seu <keyword id=\"block\">Bloqueio</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">暈眩</keyword>傷害增加相當於自身<keyword id=\"block\">格擋</keyword>的一半"}}
      }
    },
