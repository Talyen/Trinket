    "traits.hidden_fangs.description": {
      "comment": "ContentManifest/traits.tsv: hidden_fangs, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Der erste Angriff verursacht <value id=\"quantity_1\">%1$lld</value> zusätzlichen <keyword id=\"bleed\">Blutungs</keyword>schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "The first attack deals <value id=\"quantity_1\">%1$lld</value> additional <keyword id=\"bleed\">Bleed</keyword> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "El primer ataque inflige <value id=\"quantity_1\">%1$lld</value> de daño adicional de <keyword id=\"bleed\">Sangrado</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "La première attaque inflige <value id=\"quantity_1\">%1$lld</value> dégâts de <keyword id=\"bleed\">Saignement</keyword> supplémentaires"}},
        "ja": {"stringUnit": {"state": "translated", "value": "最初の攻撃で追加の<keyword id=\"bleed\">出血</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える"}},
        "ko": {"stringUnit": {"state": "translated", "value": "첫 공격이 <keyword id=\"bleed\">출혈</keyword> 추가 피해를 <value id=\"quantity_1\">%1$lld</value> 준다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O primeiro ataque causa <value id=\"quantity_1\">%1$lld</value> de dano de <keyword id=\"bleed\">Sangramento</keyword> adicional"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "首次攻擊額外造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"bleed\">流血</keyword>傷害"}}
      }
    },
