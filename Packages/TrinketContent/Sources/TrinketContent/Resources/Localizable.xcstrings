        "es": {"stringUnit": {"state": "translated", "value": "Los enemigos <keyword id=\"poison\">envenenados</keyword> reciben un <value id=\"quantity_1\">%1$lld</value>%% más de daño de <keyword id=\"bleed\">Sangrado</keyword>"}},
