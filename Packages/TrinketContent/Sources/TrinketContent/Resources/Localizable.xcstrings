    "talents.mana_moth_mana_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: mana_moth_mana_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Ausgeben von <keyword id=\"mana\">Mana</keyword> fügt deinem nächsten Angriff <value id=\"quantity_1\">%1$lld</value> Schaden hinzu"}},
        "en": {"stringUnit": {"state": "translated", "value": "Spending <keyword id=\"mana\">Mana</keyword> adds <value id=\"quantity_1\">%1$lld</value> damage to your next attack"}},
        "es": {"stringUnit": {"state": "translated", "value": "Gastar <keyword id=\"mana\">Maná</keyword> añade <value id=\"quantity_1\">%1$lld</value> de daño a tu siguiente ataque"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Dépenser du <keyword id=\"mana\">Mana</keyword> ajoute <value id=\"quantity_1\">%1$lld</value> dégâts à votre prochaine attaque"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">マナ</keyword>を消費すると、次の攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">마나</keyword> 소모 시 다음 공격의 피해 <value id=\"quantity_1\">%1$lld</value> 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Gastar <keyword id=\"mana\">Mana</keyword> adiciona <value id=\"quantity_1\">%1$lld</value> de dano ao seu próximo ataque"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "消耗<keyword id=\"mana\">魔力</keyword>時，下次攻擊的傷害增加<value id=\"quantity_1\">%1$lld</value>點"}}
      }
    },
