    "talents.library_owl_holy_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: library_owl_holy_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Nach kritischen <keyword id=\"holy\">heiligen</keyword> Treffern ignoriert der nächste Angriff deines Verbündeten gegnerischen <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">Holy</keyword> Critical Hits make your ally's next attack ignore enemy <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los golpes críticos <keyword id=\"holy\">sagrados</keyword> hacen que el siguiente ataque de tu aliado ignore el <keyword id=\"block\">Bloqueo</keyword> del enemigo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les coups critiques de type <keyword id=\"holy\">Sacré</keyword> font ignorer le <keyword id=\"block\">Blocage</keyword> ennemi à la prochaine attaque de votre allié"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">聖</keyword>クリティカルヒットで、味方の次の攻撃が敵の<keyword id=\"block\">ブロック</keyword>を無視"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">신성</keyword> 치명타 적중 시 아군의 다음 공격이 적의 <keyword id=\"block\">방어도</keyword> 무시"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Golpes críticos <keyword id=\"holy\">Sagrados</keyword> fazem o próximo ataque do seu aliado ignorar o <keyword id=\"block\">Bloqueio</keyword> inimigo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">神聖</keyword>暴擊使友方下次攻擊無視敵人<keyword id=\"block\">格擋</keyword>"}}
      }
    },
    "talents.library_owl_holy_t1_1.name": {
      "comment": "ContentManifest/talents.tsv: library_owl_holy_t1_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Enthüllte Schwäche"}},
        "en": {"stringUnit": {"state": "translated", "value": "Revealed Flaw"}},
        "es": {"stringUnit": {"state": "translated", "value": "Fallo revelado"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Faille révélée"}},
        "ja": {"stringUnit": {"state": "translated", "value": "見抜いた弱点"}},
        "ko": {"stringUnit": {"state": "translated", "value": "드러난 약점"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Falha Revelada"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "揭露弱點"}}
      }
    },
    "talents.library_owl_holy_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: library_owl_holy_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">Heilige</keyword> Angriffe erhalten +<value id=\"quantity_1\">%1$lld</value>%% Chance auf kritische Treffer"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">Holy</keyword> attacks gain +<value id=\"quantity_1\">%1$lld</value>%% Critical Hit chance"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques <keyword id=\"holy\">sagrados</keyword> obtienen +<value id=\"quantity_1\">%1$lld</value>%% de probabilidad de golpe crítico"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques de type <keyword id=\"holy\">Sacré</keyword> gagnent +<value id=\"quantity_1\">%1$lld</value>%% de chances de coup critique"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">聖</keyword>攻撃のクリティカル率が<value id=\"quantity_1\">%1$lld</value>%%上昇"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">신성</keyword> 공격의 치명타 확률 +<value id=\"quantity_1\">%1$lld</value>%%"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques <keyword id=\"holy\">Sagrados</keyword> ganham +<value id=\"quantity_1\">%1$lld</value>%% de chance de golpe crítico"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">神聖</keyword>攻擊的暴擊機率提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.library_owl_holy_t1_2.name": {
      "comment": "ContentManifest/talents.tsv: library_owl_holy_t1_2, name",
      "extractionState": "manual",
