    "talents.bear_stun_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: bear_stun_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dein <keyword id=\"block\">Block</keyword> durchbrochen wird, wirf den absorbierten Schaden als <keyword id=\"stun\">Betäubungs</keyword>schaden zurück"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When your <keyword id=\"block\">Block</keyword> breaks, return absorbed damage as <keyword id=\"stun\">Stun</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque votre <keyword id=\"block\">Blocage</keyword> est brisé, renvoyez les dégâts absorbés en dégâts d’<keyword id=\"stun\">Étourdissement</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の<keyword id=\"block\">ブロック</keyword>が崩れると、吸収したダメージを<keyword id=\"stun\">スタン</keyword>として返す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 <keyword id=\"block\">방어도</keyword>가 깨지면 흡수한 피해를 <keyword id=\"stun\">기절</keyword>로 되돌림"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自身<keyword id=\"block\">格擋</keyword>被擊破時，將吸收的傷害以<keyword id=\"stun\">暈眩</keyword>返還"
          }
        }
      }
    },
