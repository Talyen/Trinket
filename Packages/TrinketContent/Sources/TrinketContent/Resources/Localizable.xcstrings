    "affixes.blood_price.astral_description": {
      "comment": "ContentManifest/affixes.tsv: blood_price, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Gold</keyword>, wenn du <keyword id=\"leech\">Lebensraub</keyword> einsetzt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gain <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Gold</keyword> when you <keyword id=\"leech\">Leech</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagnez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Or</keyword> lors d’un <keyword id=\"leech\">Vol de vie</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">吸収</keyword>すると<keyword id=\"gold\">ゴールド</keyword>を<value id=\"quantity_1\">%1$lld</value>獲得"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">흡혈</keyword> 시 <keyword id=\"gold\">골드</keyword> <value id=\"quantity_1\">%1$lld</value> 획득"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">吸血</keyword>時獲得<value id=\"quantity_1\">%1$lld</value><keyword id=\"gold\">金幣</keyword>"
          }
        }
      }
