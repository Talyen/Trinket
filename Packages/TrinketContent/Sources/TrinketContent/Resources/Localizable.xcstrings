    "talents.rogue_bleed_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: rogue_bleed_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"bleed\">Blutung</keyword> durch kritische Treffer hält <value id=\"quantity_1\">%1$lld</value> zusätzlichen Zug an"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"bleed\">Bleed</keyword> from Critical Hits lasts <value id=\"quantity_1\">%1$lld</value> extra turn"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le <keyword id=\"bleed\">Saignement</keyword> infligé par des coups critiques dure <value id=\"quantity_1\">%1$lld</value> tour de plus"
          }
