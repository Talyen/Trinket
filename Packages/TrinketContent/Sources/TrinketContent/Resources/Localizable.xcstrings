    "talents.panther_bleed_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: panther_bleed_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du verursachst <value id=\"quantity_1\">%1$lld</value>%% mehr Schaden an <keyword id=\"bleed\">blutenden</keyword> Gegnern unter halber <keyword id=\"health\">Gesundheit</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You deal <value id=\"quantity_1\">%1$lld</value>%% more damage to <keyword id=\"bleed\">Bleeding</keyword> enemies below half <keyword id=\"health\">Health</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous infligez <value id=\"quantity_1\">%1$lld</value>%% de dégâts en plus aux ennemis sous <keyword id=\"bleed\">Saignement</keyword> et sous la moitié de leur <keyword id=\"health\">Santé</keyword>"
          }
