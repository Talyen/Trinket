        "ja": {"stringUnit": {"state": "translated", "value": "返り咲き"}},
        "ko": {"stringUnit": {"state": "translated", "value": "되돌아오는 꽃"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Flor que Retorna"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "返還之花"}}
      }
    },
    "talents.druid_poison_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: druid_poison_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Gift</keyword>-Angriffe ignorieren gegnerischen <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Poison</keyword> attacks ignore enemy <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques de <keyword id=\"poison\">Veneno</keyword> ignoran el <keyword id=\"block\">Bloqueo</keyword> del enemigo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques de <keyword id=\"poison\">Poison</keyword> ignorent le <keyword id=\"block\">Blocage</keyword> ennemi"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">毒</keyword>攻撃が敵の<keyword id=\"block\">ブロック</keyword>を無視"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">독</keyword> 공격이 적의 <keyword id=\"block\">방어도</keyword> 무시"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques de <keyword id=\"poison\">Veneno</keyword> ignoram o <keyword id=\"block\">Bloqueio</keyword> inimigo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">中毒</keyword>攻擊無視敵人<keyword id=\"block\">格擋</keyword>"}}
      }
    },
    "talents.druid_poison_t3_1.name": {
      "comment": "ContentManifest/talents.tsv: druid_poison_t3_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wurzelpfad"}},
        "en": {"stringUnit": {"state": "translated", "value": "Root Passage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Paso de raíces"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Passage des racines"}},
        "ja": {"stringUnit": {"state": "translated", "value": "根の抜け道"}},
        "ko": {"stringUnit": {"state": "translated", "value": "뿌리 통로"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Passagem das Raízes"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "根系通道"}}
      }
