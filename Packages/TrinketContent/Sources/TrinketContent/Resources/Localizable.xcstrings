    "talents.bear_block_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: bear_block_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Betäuben eines Gegners verdoppelt deinen nächsten Erhalt von <keyword id=\"block\">Block</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stunning an enemy doubles your next <keyword id=\"block\">Block</keyword> gain"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Étourdir un ennemi double votre prochain gain de <keyword id=\"block\">Blocage</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "敵をスタン状態にすると、次に獲得する<keyword id=\"block\">ブロック</keyword>が2倍になる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적을 기절시키면 다음 <keyword id=\"block\">방어도</keyword> 획득량이 두 배"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使敵人暈眩時，下次獲得的<keyword id=\"block\">格擋</keyword>加倍"
          }
        }
      }
