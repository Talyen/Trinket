    "authored.df85700321f0bc10": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Abilities/AbilityCatalog+Skill.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verursache <value id=\"quantity_1\">%1$lld</value> <keyword id=\"stun\">Betäubungs</keyword>schaden, im ersten Kampfzug verdoppelt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"stun\">Stun</keyword> damage, doubled on the first combat turn"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Infligez <value id=\"quantity_1\">%1$lld</value> dégâts d’<keyword id=\"stun\">Étourdissement</keyword>, doublés au premier tour du combat"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"stun\">スタン</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える（戦闘の最初のターンは2倍）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"stun\">기절</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>. 전투 첫 턴에는 두 배"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"stun\">暈眩</keyword>傷害，戰鬥首回合傷害加倍"
          }
        }
      }
    },
    "authored.e027aff0c3f42240": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dein <keyword id=\"block\">Block</keyword> in einer Runde erstmals durchbrochen wird, verursache beim Angreifer <value id=\"quantity_1\">%1$lld</value> <keyword id=\"holy\">heiligen</keyword> Schaden und <value id=\"quantity_2\">%2$lld</value> <keyword id=\"stun\">Betäubungs</keyword>schaden und stelle dann <value id=\"quantity_3\">%3$lld</value> <keyword id=\"health\">Gesundheit</keyword> wieder her"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first time each round your <keyword id=\"block\">Block</keyword> is broken, deal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"holy\">Holy</keyword> and <value id=\"quantity_2\">%2$lld</value> <keyword id=\"stun\">Stun</keyword> damage to the attacker, then restore <value id=\"quantity_3\">%3$lld</value> <keyword id=\"health\">Health</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La première fois que votre <keyword id=\"block\">Blocage</keyword> est brisé à chaque manche, infligez <value id=\"quantity_1\">%1$lld</value> dégâts de type <keyword id=\"holy\">Sacré</keyword> et <value id=\"quantity_2\">%2$lld</value> dégâts d’<keyword id=\"stun\">Étourdissement</keyword> à l’attaquant, puis restaurez <value id=\"quantity_3\">%3$lld</value> <keyword id=\"health\">Santé</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ラウンドに初めて自分の<keyword id=\"block\">ブロック</keyword>が崩れると、攻撃者に<keyword id=\"holy\">聖</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>、<keyword id=\"stun\">スタン</keyword>ダメージを<value id=\"quantity_2\">%2$lld</value>与え、その後<keyword id=\"health\">体力</keyword>を<value id=\"quantity_3\">%3$lld</value>回復"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매 라운드 처음으로 내 <keyword id=\"block\">방어도</keyword>가 깨지면 공격자에게 <keyword id=\"holy\">신성</keyword> 피해 <value id=\"quantity_1\">%1$lld</value> 및 <keyword id=\"stun\">기절</keyword> 피해 <value id=\"quantity_2\">%2$lld</value>, 이후 <keyword id=\"health\">체력</keyword> <value id=\"quantity_3\">%3$lld</value> 회복"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每輪自身<keyword id=\"block\">格擋</keyword>首次被擊破時，對攻擊者造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"holy\">神聖</keyword>及<value id=\"quantity_2\">%2$lld</value>點<keyword id=\"stun\">暈眩</keyword>傷害，再恢復<value id=\"quantity_3\">%3$lld</value>點<keyword id=\"health\">生命值</keyword>"
          }
        }
      }
    },
