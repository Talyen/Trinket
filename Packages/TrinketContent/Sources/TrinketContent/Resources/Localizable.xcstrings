    "authored.364abd48f467507a": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/InventoryItem+Compatibility.swift: canonical numeric compatibility description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Deine <keyword id=\"thorns\">Dornen</keyword> verursachen <value id=\"quantity_1\">%1$lld</value> zusätzlichen Schaden bei <keyword id=\"poison\">vergifteten</keyword> Gegnern"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your <keyword id=\"thorns\">Thorns</keyword> deal <value id=\"quantity_1\">%1$lld</value> additional damage to <keyword id=\"poison\">Poisoned</keyword> enemies"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tus <keyword id=\"thorns\">Espinas</keyword> infligen <value id=\"quantity_1\">%1$lld</value> de daño adicional a enemigos <keyword id=\"poison\">envenenados</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Vos <keyword id=\"thorns\">Épines</keyword> infligent <value id=\"quantity_1\">%1$lld</value> dégâts supplémentaires aux ennemis <keyword id=\"poison\">empoisonnés</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "あなたの<keyword id=\"thorns\">棘</keyword>は、<keyword id=\"poison\">毒</keyword>状態の敵に<value id=\"quantity_1\">%1$lld</value>の追加ダメージを与える"}},
        "ko": {"stringUnit": {"state": "translated", "value": "자신의 <keyword id=\"thorns\">가시</keyword>가 <keyword id=\"poison\">독</keyword>에 걸린 적에게 <value id=\"quantity_1\">%1$lld</value>의 추가 피해를 줍니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seus <keyword id=\"thorns\">Espinhos</keyword> causam <value id=\"quantity_1\">%1$lld</value> de dano adicional a inimigos <keyword id=\"poison\">Envenenados</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "你的<keyword id=\"thorns\">荊棘</keyword>對<keyword id=\"poison\">中毒</keyword>的敵人額外造成<value id=\"quantity_1\">%1$lld</value>點傷害"}}
      }
    },
