      "comment": "Packages/TrinketContent/Sources/TrinketContent/Abilities/AbilityCatalog+Ultimate.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verursache <value id=\"quantity_1\">%1$lld</value> <keyword id=\"burn\">Brand</keyword>schaden\nErhalte je <value id=\"quantity_2\">%2$lld</value> <keyword id=\"block\">Block</keyword> und <keyword id=\"thorns\">Dornen</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"burn\">Burn</keyword> damage\nGain <value id=\"quantity_2\">%2$lld</value> <keyword id=\"block\">Block</keyword> and <keyword id=\"thorns\">Thorns</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Infligez <value id=\"quantity_1\">%1$lld</value> dégâts de <keyword id=\"burn\">Brûlure</keyword>\nGagnez <value id=\"quantity_2\">%2$lld</value> <keyword id=\"block\">Blocage</keyword> et autant d’<keyword id=\"thorns\">Épines</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">炎上</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える\n<keyword id=\"block\">ブロック</keyword>と<keyword id=\"thorns\">棘</keyword>をそれぞれ<value id=\"quantity_2\">%2$lld</value>獲得"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">화상</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>\n<keyword id=\"block\">방어도</keyword>와 <keyword id=\"thorns\">가시</keyword> 각각 <value id=\"quantity_2\">%2$lld</value> 획득"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"burn\">燃燒</keyword>傷害\n獲得<value id=\"quantity_2\">%2$lld</value>點<keyword id=\"block\">格擋</keyword>與<keyword id=\"thorns\">荊棘</keyword>"
          }
        }
      }
    },
