    "talents.alchemist_cleanse_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: alchemist_cleanse_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Reinigen von Schwächungseffekten verhindert neue Schwächungseffekte bis zu deinem nächsten Zug"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleansing debuffs prevents new debuffs until your next turn"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Purifier des malus empêche les nouveaux malus jusqu’à votre prochain tour"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "弱体効果を浄化すると、次の自分のターンまで新たな弱体効果を防ぐ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약화 효과 정화 시 다음 내 턴까지 새로운 약화 효과 방지"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "淨化減益效果後，防止新減益效果，直到下個自身回合"
          }
        }
      }
    },
