    "talents.wildcard_physical_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: wildcard_physical_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"physical\">Physische</keyword> Angriffe verursachen zufällig doppelten oder halben Schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"physical\">Physical</keyword> attacks randomly deal double or half damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les attaques de type <keyword id=\"physical\">Physique</keyword> infligent aléatoirement le double ou la moitié des dégâts"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"physical\">物理</keyword>攻撃のダメージがランダムに2倍か半分になる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"physical\">물리</keyword> 공격이 무작위로 두 배 또는 절반의 피해"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"physical\">物理</keyword>攻擊隨機造成雙倍或半量傷害"
          }
        }
      }
    },
