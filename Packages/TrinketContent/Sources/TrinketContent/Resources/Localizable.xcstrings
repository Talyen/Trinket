    "talents.bear_physical_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: bear_physical_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Unter halber <keyword id=\"health\">Gesundheit</keyword> erhalten <keyword id=\"physical\">physische</keyword> Angriffe +<value id=\"quantity_1\">%1$lld</value>%% Chance auf kritische Treffer"}},
        "en": {"stringUnit": {"state": "translated", "value": "Below half <keyword id=\"health\">Health</keyword>, <keyword id=\"physical\">Physical</keyword> attacks gain +<value id=\"quantity_1\">%1$lld</value>%% Critical Hit chance"}},
        "es": {"stringUnit": {"state": "translated", "value": "Por debajo de la mitad de <keyword id=\"health\">Salud</keyword>, los ataques <keyword id=\"physical\">físicos</keyword> obtienen +<value id=\"quantity_1\">%1$lld</value>%% de probabilidad de golpe crítico"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Sous la moitié de votre <keyword id=\"health\">Santé</keyword>, les attaques de type <keyword id=\"physical\">Physique</keyword> gagnent +<value id=\"quantity_1\">%1$lld</value>%% de chances de coup critique"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>が半分未満なら、<keyword id=\"physical\">物理</keyword>攻撃のクリティカル率が<value id=\"quantity_1\">%1$lld</value>%%上昇"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword>이 절반 미만이면 <keyword id=\"physical\">물리</keyword> 공격의 치명타 확률 +<value id=\"quantity_1\">%1$lld</value>%%"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Abaixo de metade da <keyword id=\"health\">Vida</keyword>, ataques <keyword id=\"physical\">Físicos</keyword> ganham +<value id=\"quantity_1\">%1$lld</value>%% de chance de golpe crítico"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">生命值</keyword>低於一半時，<keyword id=\"physical\">物理</keyword>攻擊的暴擊機率提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
