    "talents.risen_skeleton_deathsdoor_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_deathsdoor_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tod nach der <keyword id=\"deathsdoor\">Todesschwelle</keyword> verursacht <value id=\"quantity_1\">%1$lld</value> <keyword id=\"physical\">physischen</keyword> Schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dying after <keyword id=\"deathsdoor\">Death's Door</keyword> deals <value id=\"quantity_1\">%1$lld</value> <keyword id=\"physical\">Physical</keyword> damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mourir après le <keyword id=\"deathsdoor\">Seuil de la mort</keyword> inflige <value id=\"quantity_1\">%1$lld</value> dégâts de type <keyword id=\"physical\">Physique</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"deathsdoor\">死の淵</keyword>の後に死亡すると<keyword id=\"physical\">物理</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"deathsdoor\">죽음의 문턱</keyword> 이후 죽으면 <keyword id=\"physical\">물리</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "經歷<keyword id=\"deathsdoor\">瀕死之門</keyword>後死亡時，造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"physical\">物理</keyword>傷害"
          }
        }
      }
    },
