    "talents.phoenix_health_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: phoenix_health_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">Brand</keyword>-Angriffe stellen mit <value id=\"quantity_1\">%1$lld</value>%% Chance <value id=\"quantity_2\">%2$lld</value> <keyword id=\"health\">Gesundheit</keyword> beim Verbündeten mit der niedrigsten Gesundheit wieder her"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">Burn</keyword> attacks have a <value id=\"quantity_1\">%1$lld</value>%% chance to restore <value id=\"quantity_2\">%2$lld</value> <keyword id=\"health\">Health</keyword> to the lowest ally"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les attaques de <keyword id=\"burn\">Brûlure</keyword> ont <value id=\"quantity_1\">%1$lld</value>%% de chances de restaurer <value id=\"quantity_2\">%2$lld</value> <keyword id=\"health\">Santé</keyword> à l’allié ayant le moins de Santé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">炎上</keyword>攻撃が<value id=\"quantity_1\">%1$lld</value>%%の確率で最も体力の低い味方の<keyword id=\"health\">体力</keyword>を<value id=\"quantity_2\">%2$lld</value>回復"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">화상</keyword> 공격 시 <value id=\"quantity_1\">%1$lld</value>%% 확률로 체력이 가장 낮은 아군의 <keyword id=\"health\">체력</keyword> <value id=\"quantity_2\">%2$lld</value> 회복"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">燃燒</keyword>攻擊有<value id=\"quantity_1\">%1$lld</value>%%機率為生命值最低的友方恢復<value id=\"quantity_2\">%2$lld</value>點<keyword id=\"health\">生命值</keyword>"
          }
