        "ko": {"stringUnit": {"state": "translated", "value": "끈질긴 껍질"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Casco Duradouro"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "持久甲殼"}}
      }
