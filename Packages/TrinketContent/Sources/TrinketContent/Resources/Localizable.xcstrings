    "talents.frost_whelp_dodge_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: frost_whelp_dodge_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Ausweichen ist dein nächstes Verstärken mit <keyword id=\"mana\">Mana</keyword> kostenlos"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
