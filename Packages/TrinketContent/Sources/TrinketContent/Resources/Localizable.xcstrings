    "talents.rogue_gold_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: rogue_gold_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verdopple nach dem Ausweichen das nächste <keyword id=\"gold\">Gold</keyword>, das du stiehlst"}},
        "en": {"stringUnit": {"state": "translated", "value": "After Dodging, double the next <keyword id=\"gold\">Gold</keyword> you steal"}},
        "es": {"stringUnit": {"state": "translated", "value": "Después de esquivar, duplica el siguiente <keyword id=\"gold\">Oro</keyword> que robes"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Après une esquive, doublez votre prochain vol d’<keyword id=\"gold\">Or</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "回避後、次に盗む<keyword id=\"gold\">ゴールド</keyword>が2倍になる"}},
        "ko": {"stringUnit": {"state": "translated", "value": "회피 후 다음 <keyword id=\"gold\">골드</keyword> 훔치기 획득량이 두 배"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Após esquivar, dobre o próximo <keyword id=\"gold\">Ouro</keyword> que roubar"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "閃避後，下次偷取的<keyword id=\"gold\">金幣</keyword>加倍"}}
      }
    },
    "talents.rogue_gold_t2_2.name": {
