    "authored.449ef1fc60522bc9": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Abilities/AbilityCatalog+Ultimate.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verursache <value id=\"quantity_1\">%1$lld</value> <keyword id=\"holy\">heiligen</keyword> Schaden oder <keyword id=\"burn\">Brand</keyword>schaden\nStelle bei jedem Verbündeten <value id=\"quantity_2\">%2$lld</value> <keyword id=\"health\">Gesundheit</keyword> wieder her"}},
        "en": {"stringUnit": {"state": "translated", "value": "Deal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"holy\">Holy</keyword> or <keyword id=\"burn\">Burn</keyword> damage\nRestore <value id=\"quantity_2\">%2$lld</value> <keyword id=\"health\">Health</keyword> to each ally"}},
        "es": {"stringUnit": {"state": "translated", "value": "Inflige <value id=\"quantity_1\">%1$lld</value> de daño <keyword id=\"holy\">sagrado</keyword> o de <keyword id=\"burn\">Quemadura</keyword>\nRestaura <value id=\"quantity_2\">%2$lld</value> de <keyword id=\"health\">Salud</keyword> a cada aliado"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Infligez <value id=\"quantity_1\">%1$lld</value> dégâts de type <keyword id=\"holy\">Sacré</keyword> ou de <keyword id=\"burn\">Brûlure</keyword>\nRestaurez <value id=\"quantity_2\">%2$lld</value> <keyword id=\"health\">Santé</keyword> à chaque allié"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">聖</keyword>か<keyword id=\"burn\">炎上</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える\n味方全員の<keyword id=\"health\">体力</keyword>を<value id=\"quantity_2\">%2$lld</value>回復"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">신성</keyword> 또는 <keyword id=\"burn\">화상</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>\n각 아군의 <keyword id=\"health\">체력</keyword> <value id=\"quantity_2\">%2$lld</value> 회복"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cause <value id=\"quantity_1\">%1$lld</value> de dano <keyword id=\"holy\">Sagrado</keyword> ou de <keyword id=\"burn\">Queimadura</keyword>\nRestaure <value id=\"quantity_2\">%2$lld</value> de <keyword id=\"health\">Vida</keyword> de cada aliado"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"holy\">神聖</keyword>或<keyword id=\"burn\">燃燒</keyword>傷害\n為每名友方恢復<value id=\"quantity_2\">%2$lld</value>點<keyword id=\"health\">生命值</keyword>"}}
      }
    },
