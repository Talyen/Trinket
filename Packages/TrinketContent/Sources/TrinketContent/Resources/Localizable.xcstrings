    "talents.mana_moth_mana_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: mana_moth_mana_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dein erstes Ausgeben von <keyword id=\"mana\">Mana</keyword> in jedem Zug erstattet <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your first <keyword id=\"mana\">Mana</keyword> spend each turn refunds <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu primer gasto de <keyword id=\"mana\">Maná</keyword> de cada turno reembolsa <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"mana\">Maná</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre première dépense de <keyword id=\"mana\">Mana</keyword> de chaque tour rembourse <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "各ターンで最初に<keyword id=\"mana\">マナ</keyword>を消費すると<keyword id=\"mana\">マナ</keyword>が<value id=\"quantity_1\">%1$lld</value>戻る"}},
        "ko": {"stringUnit": {"state": "translated", "value": "매 턴 첫 <keyword id=\"mana\">마나</keyword> 소모 시 <keyword id=\"mana\">마나</keyword> <value id=\"quantity_1\">%1$lld</value> 반환"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seu primeiro gasto de <keyword id=\"mana\">Mana</keyword> de cada turno devolve <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"mana\">Mana</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每回合首次消耗<keyword id=\"mana\">魔力</keyword>時，返還<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"mana\">魔力</keyword>"}}
      }
