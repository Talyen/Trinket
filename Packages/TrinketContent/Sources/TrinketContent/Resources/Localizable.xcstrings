        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cause dano do tipo %1$@ equivalente a 1/<value id=\"divisor\">%2$lld</value> do seu <keyword id=\"block\">Bloqueio</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "造成相當於自身<keyword id=\"block\">格擋</keyword>的1/<value id=\"divisor\">%2$lld</value>的%1$@傷害"}}
