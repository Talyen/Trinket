    "talents.pixie_cleanse_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: pixie_cleanse_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dein erstes <keyword id=\"cleanse\">Reinigen</keyword> in jedem Zug entfernt einen zusätzlichen Schwächungseffekt"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your first <keyword id=\"cleanse\">Cleanse</keyword> each turn removes one extra debuff"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu primera <keyword id=\"cleanse\">Purificación</keyword> de cada turno elimina un perjuicio adicional"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre première <keyword id=\"cleanse\">Purification</keyword> de chaque tour retire un malus supplémentaire"}},
        "ja": {"stringUnit": {"state": "translated", "value": "各ターンで最初の<keyword id=\"cleanse\">浄化</keyword>で弱体効果を追加で1つ解除"}},
        "ko": {"stringUnit": {"state": "translated", "value": "매 턴 첫 <keyword id=\"cleanse\">정화</keyword>가 약화 효과 하나 추가 제거"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Sua primeira <keyword id=\"cleanse\">Purificação</keyword> de cada turno remove um efeito negativo extra"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每回合首次<keyword id=\"cleanse\">淨化</keyword>額外移除一項減益效果"}}
      }
    },
