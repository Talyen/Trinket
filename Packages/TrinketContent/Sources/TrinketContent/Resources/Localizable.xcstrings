        "fr": {"stringUnit": {"state": "translated", "value": "Butin : objets de type <keyword id=\"purge\">Dissipation</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">強化解除</keyword>アイテムをドロップ"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">강화 해제</keyword> 아이템 드롭"}},
