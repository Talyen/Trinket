        "fr": {"stringUnit": {"state": "translated", "value": "Les ennemis sous <keyword id=\"stun\">Étourdissement</keyword> subissent <value id=\"quantity_1\">%1$lld</value>%% de dégâts de type <keyword id=\"holy\">Sacré</keyword> en plus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">スタン</keyword>状態の敵が受ける<keyword id=\"holy\">聖</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">기절</keyword> 상태의 적이 받는 <keyword id=\"holy\">신성</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Inimigos <keyword id=\"stun\">Atordoados</keyword> recebem <value id=\"quantity_1\">%1$lld</value>%% mais dano <keyword id=\"holy\">Sagrado</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">暈眩</keyword>的敵人承受的<keyword id=\"holy\">神聖</keyword>傷害增加<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "affixes.hallowbreak.title": {
      "comment": "ContentManifest/affixes.tsv: hallowbreak, title",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Heiliger Bruch"}},
        "en": {"stringUnit": {"state": "translated", "value": "Hallowbreak"}},
        "es": {"stringUnit": {"state": "translated", "value": "Ruptura sagrada"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Brèche sacrée"}},
        "ja": {"stringUnit": {"state": "translated", "value": "聖なる破砕"}},
        "ko": {"stringUnit": {"state": "translated", "value": "성역 파괴"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ruptura Sagrada"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "聖光破擊"}}
      }
    },
    "affixes.hallowguard.astral_description": {
      "comment": "ContentManifest/affixes.tsv: hallowguard, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wenn ein <keyword id=\"holy\">heiliger</keyword> Angriff einem Gegner schadet, während du keinen <keyword id=\"block\">Block</keyword> hast, erhalte <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "When a <keyword id=\"holy\">Holy</keyword> attack damages an enemy while you have no <keyword id=\"block\">Block</keyword>, gain <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Cuando un ataque <keyword id=\"holy\">sagrado</keyword> daña a un enemigo mientras no tienes <keyword id=\"block\">Bloqueo</keyword>, obtén <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueo</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Si une attaque de type <keyword id=\"holy\">Sacré</keyword> blesse un ennemi alors que vous n’avez pas de <keyword id=\"block\">Blocage</keyword>, gagnez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Blocage</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "自分に<keyword id=\"block\">ブロック</keyword>がない状態で<keyword id=\"holy\">聖</keyword>攻撃が敵にダメージを与えると、<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>獲得"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">방어도</keyword>가 없을 때 <keyword id=\"holy\">신성</keyword> 공격으로 적에게 피해를 주면 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 획득"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Quando um ataque <keyword id=\"holy\">Sagrado</keyword> causar dano a um inimigo enquanto você estiver sem <keyword id=\"block\">Bloqueio</keyword>, ganhe <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueio</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "自身沒有<keyword id=\"block\">格擋</keyword>時，若<keyword id=\"holy\">神聖</keyword>攻擊傷害敵人，則獲得<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>"}}
      }
    },
