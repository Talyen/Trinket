    "authored.83333795ca476074": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog+Ranged.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal pro Zug: Ausweichen bringt deine zuletzt gespielte Karte auf deine Hand zurück"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once per turn, Dodging returns the last card you played to your hand"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois par tour, une esquive renvoie dans votre main la dernière carte que vous avez jouée"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1ターンに1回、回避すると最後に使ったカードが手札に戻る"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "턴마다 한 번, 회피 시 마지막으로 사용한 카드를 손으로 반환"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每回合一次，閃避時將上張打出的牌返回手牌"
          }
        }
      }
    },
