    "homestead_nodes.alchemylab.1.bonus_description": {
      "comment": "ContentManifest/homestead_nodes.tsv: alchemyLab.1, bonus_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhöhe <keyword id=\"poison\">Gift</keyword>schaden um <value id=\"quantity_1\">%1$lld</value>%%\nProduziere <value id=\"quantity_2\">%2$lld</value> Kräuter pro Tag"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Increase <keyword id=\"poison\">Poison</keyword> damage by <value id=\"quantity_1\">%1$lld</value>%%\nProduce <value id=\"quantity_2\">%2$lld</value> Herbs per Day"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dégâts de <keyword id=\"poison\">Poison</keyword> augmentés de <value id=\"quantity_1\">%1$lld</value>%%\nProduit <value id=\"quantity_2\">%2$lld</value> herbes par jour"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"poison\">毒</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%増加\n1日に薬草を<value id=\"quantity_2\">%2$lld</value>生産"
          }
        },
        "ko": {
