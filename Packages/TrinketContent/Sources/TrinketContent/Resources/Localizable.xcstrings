    "talents.phoenix_deathsdoor_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: phoenix_deathsdoor_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Überleben der <keyword id=\"deathsdoor\">Todesschwelle</keyword> verdoppelt deinen nächsten Angriff"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Surviving <keyword id=\"deathsdoor\">Death's Door</keyword> doubles your next attack"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Survivre au <keyword id=\"deathsdoor\">Seuil de la mort</keyword> double votre prochaine attaque"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"deathsdoor\">死の淵</keyword>を生き延びると次の攻撃が2倍になる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"deathsdoor\">죽음의 문턱</keyword>에서 살아남으면 다음 공격이 두 배"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從<keyword id=\"deathsdoor\">瀕死之門</keyword>生還後，下次攻擊加倍"
          }
        }
      }
    },
