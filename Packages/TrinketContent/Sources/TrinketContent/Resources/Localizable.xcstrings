    "traits.righteous_guard.description": {
      "comment": "ContentManifest/traits.tsv: righteous_guard, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>, wenn du <keyword id=\"stun\">Betäubungs</keyword>schaden oder <keyword id=\"holy\">heiligen</keyword> Schaden verursachst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gain <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword> when dealing <keyword id=\"stun\">Stun</keyword> or <keyword id=\"holy\">Holy</keyword> damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagnez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Blocage</keyword> en infligeant des dégâts d’<keyword id=\"stun\">Étourdissement</keyword> ou de type <keyword id=\"holy\">Sacré</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"stun\">スタン</keyword>か<keyword id=\"holy\">聖</keyword>ダメージを与えると<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>獲得"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"stun\">기절</keyword> 또는 <keyword id=\"holy\">신성</keyword> 피해를 주면 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 획득"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "造成<keyword id=\"stun\">暈眩</keyword>或<keyword id=\"holy\">神聖</keyword>傷害時，獲得<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>"
          }
        }
      }
    },
