        "ja": {"stringUnit": {"state": "translated", "value": "絡みつく繁茂"}},
        "ko": {"stringUnit": {"state": "translated", "value": "휘감는 성장"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Crescimento Enredante"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "糾纏生長"}}
      }
    },
    "talents.druid_poison_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: druid_poison_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"thorns\">Dornen</keyword> verursachen einmal pro Zug <value id=\"quantity_1\">%1$lld</value> zusätzlichen <keyword id=\"poison\">Gift</keyword>schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"thorns\">Thorns</keyword> deal <value id=\"quantity_1\">%1$lld</value> bonus <keyword id=\"poison\">Poison</keyword> damage once per turn"}},
        "es": {"stringUnit": {"state": "translated", "value": "Las <keyword id=\"thorns\">Espinas</keyword> infligen <value id=\"quantity_1\">%1$lld</value> de daño adicional de <keyword id=\"poison\">Veneno</keyword> una vez por turno"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les <keyword id=\"thorns\">Épines</keyword> infligent <value id=\"quantity_1\">%1$lld</value> dégâts de <keyword id=\"poison\">Poison</keyword> supplémentaires une fois par tour"}},
        "ja": {"stringUnit": {"state": "translated", "value": "1ターンに1回、<keyword id=\"thorns\">棘</keyword>が追加の<keyword id=\"poison\">毒</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える"}},
        "ko": {"stringUnit": {"state": "translated", "value": "턴마다 한 번, <keyword id=\"thorns\">가시</keyword>가 <keyword id=\"poison\">독</keyword> 추가 피해를 <value id=\"quantity_1\">%1$lld</value> 줌"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "<keyword id=\"thorns\">Espinhos</keyword> causam <value id=\"quantity_1\">%1$lld</value> de dano de <keyword id=\"poison\">Veneno</keyword> adicional uma vez por turno"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每回合一次，<keyword id=\"thorns\">荊棘</keyword>額外造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"poison\">中毒</keyword>傷害"}}
      }
    },
    "talents.druid_poison_t4_1.name": {
      "comment": "ContentManifest/talents.tsv: druid_poison_t4_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dornabwurf"}},
        "en": {"stringUnit": {"state": "translated", "value": "Thorn Shedding"}},
        "es": {"stringUnit": {"state": "translated", "value": "Muda de espinas"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Mue épineuse"}},
        "ja": {"stringUnit": {"state": "translated", "value": "棘の脱落"}},
        "ko": {"stringUnit": {"state": "translated", "value": "가시 탈피"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Queda de Espinhos"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "荊棘脫落"}}
      }
    },
    "talents.fox_dodge_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: fox_dodge_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dein erstes <keyword id=\"dodge\">Ausweichen</keyword> in jedem Zug fügt deinem nächsten Angriff <value id=\"quantity_1\">%1$lld</value> Schaden hinzu"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your first <keyword id=\"dodge\">Dodge</keyword> each turn adds <value id=\"quantity_1\">%1$lld</value> damage to your next attack"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu primera <keyword id=\"dodge\">Evasión</keyword> de cada turno añade <value id=\"quantity_1\">%1$lld</value> de daño a tu siguiente ataque"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre première <keyword id=\"dodge\">Esquive</keyword> de chaque tour ajoute <value id=\"quantity_1\">%1$lld</value> dégâts à votre prochaine attaque"}},
        "ja": {"stringUnit": {"state": "translated", "value": "各ターンで最初の<keyword id=\"dodge\">回避</keyword>で、次の攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "매 턴 첫 <keyword id=\"dodge\">회피</keyword> 시 다음 공격의 피해 <value id=\"quantity_1\">%1$lld</value> 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Sua primeira <keyword id=\"dodge\">Esquiva</keyword> de cada turno adiciona <value id=\"quantity_1\">%1$lld</value> de dano ao seu próximo ataque"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每回合首次<keyword id=\"dodge\">閃避</keyword>時，下次攻擊的傷害增加<value id=\"quantity_1\">%1$lld</value>點"}}
      }
    },
    "talents.fox_dodge_t1_1.name": {
      "comment": "ContentManifest/talents.tsv: fox_dodge_t1_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Fintenschlag"}},
        "en": {"stringUnit": {"state": "translated", "value": "Feint Strike"}},
        "es": {"stringUnit": {"state": "translated", "value": "Golpe de finta"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Frappe feinte"}},
        "ja": {"stringUnit": {"state": "translated", "value": "フェイントの一撃"}},
        "ko": {"stringUnit": {"state": "translated", "value": "위장 일격"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Golpe de Finta"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "佯攻打擊"}}
      }
    },
    "talents.fox_dodge_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: fox_dodge_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ausweichen verursacht mit <value id=\"quantity_1\">%1$lld</value>%% Chance <value id=\"quantity_2\">%2$lld</value> <keyword id=\"poison\">Gift</keyword>schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Dodging has a <value id=\"quantity_1\">%1$lld</value>%% chance to deal <value id=\"quantity_2\">%2$lld</value> <keyword id=\"poison\">Poison</keyword> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Esquivar tiene un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de infligir <value id=\"quantity_2\">%2$lld</value> de daño de <keyword id=\"poison\">Veneno</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Une esquive a <value id=\"quantity_1\">%1$lld</value>%% de chances d’infliger <value id=\"quantity_2\">%2$lld</value> dégâts de <keyword id=\"poison\">Poison</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "回避すると<value id=\"quantity_1\">%1$lld</value>%%の確率で<keyword id=\"poison\">毒</keyword>ダメージを<value id=\"quantity_2\">%2$lld</value>与える"}},
        "ko": {"stringUnit": {"state": "translated", "value": "회피 시 <value id=\"quantity_1\">%1$lld</value>%% 확률로 <keyword id=\"poison\">독</keyword> 피해 <value id=\"quantity_2\">%2$lld</value>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Esquivar tem <value id=\"quantity_1\">%1$lld</value>%% de chance de causar <value id=\"quantity_2\">%2$lld</value> de dano de <keyword id=\"poison\">Veneno</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "閃避時有<value id=\"quantity_1\">%1$lld</value>%%機率造成<value id=\"quantity_2\">%2$lld</value>點<keyword id=\"poison\">中毒</keyword>傷害"}}
      }
    },
    "talents.fox_dodge_t1_2.name": {
      "comment": "ContentManifest/talents.tsv: fox_dodge_t1_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Giftiger Sprint"}},
        "en": {"stringUnit": {"state": "translated", "value": "Poisonous Dash"}},
        "es": {"stringUnit": {"state": "translated", "value": "Carrera venenosa"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Ruée venimeuse"}},
        "ja": {"stringUnit": {"state": "translated", "value": "毒の疾走"}},
        "ko": {"stringUnit": {"state": "translated", "value": "맹독 질주"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Arrancada Venenosa"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "劇毒衝刺"}}
      }
    },
    "talents.fox_dodge_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: fox_dodge_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"dodge\">Weiche</keyword> dem ersten Angriff gegen dich in jedem Kampf aus"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"dodge\">Dodge</keyword> the first attack against you each combat"}},
        "es": {"stringUnit": {"state": "translated", "value": "<keyword id=\"dodge\">Esquiva</keyword> el primer ataque contra ti de cada combate"}},
        "fr": {"stringUnit": {"state": "translated", "value": "<keyword id=\"dodge\">Esquive</keyword> de la première attaque qui vous vise à chaque combat"}},
        "ja": {"stringUnit": {"state": "translated", "value": "各戦闘で自分への最初の攻撃を<keyword id=\"dodge\">回避</keyword>"}},
        "ko": {"stringUnit": {"state": "translated", "value": "매 전투 자신을 향한 첫 공격을 <keyword id=\"dodge\">회피</keyword>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "<keyword id=\"dodge\">Esquive</keyword> do primeiro ataque contra você em cada combate"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每場戰鬥<keyword id=\"dodge\">閃避</keyword>首次針對自身的攻擊"}}
      }
    },
    "talents.fox_dodge_t2_1.name": {
      "comment": "ContentManifest/talents.tsv: fox_dodge_t2_1, name",
