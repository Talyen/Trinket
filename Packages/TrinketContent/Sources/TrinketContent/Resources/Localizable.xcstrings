    "talents.phoenix_health_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: phoenix_health_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei voller <keyword id=\"health\">Gesundheit</keyword> erhalten beide Verbündeten +<value id=\"quantity_1\">%1$lld</value>%% Chance auf kritische Treffer"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At full <keyword id=\"health\">Health</keyword>, both allies gain +<value id=\"quantity_1\">%1$lld</value>%% Critical Hit chance"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À pleine <keyword id=\"health\">Santé</keyword>, les deux alliés gagnent +<value id=\"quantity_1\">%1$lld</value>%% de chances de coup critique"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">体力</keyword>が満タンの間、味方2人のクリティカル率が<value id=\"quantity_1\">%1$lld</value>%%上昇"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">체력</keyword>이 가득 차 있으면 두 아군의 치명타 확률 +<value id=\"quantity_1\">%1$lld</value>%%"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自身<keyword id=\"health\">生命值</keyword>全滿時，兩名友方的暴擊機率提高<value id=\"quantity_1\">%1$lld</value>%%"
          }
        }
      }
    },
