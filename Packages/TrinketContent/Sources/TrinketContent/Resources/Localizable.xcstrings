    "talents.wildcard_dodge_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: wildcard_dodge_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Ausweichen ignoriert dein nächster <keyword id=\"physical\">physischer</keyword> Angriff gegnerischen <keyword id=\"block\">Block</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodging makes your next <keyword id=\"physical\">Physical</keyword> attack ignore enemy <keyword id=\"block\">Block</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une esquive fait ignorer le <keyword id=\"block\">Blocage</keyword> ennemi à votre prochaine attaque de type <keyword id=\"physical\">Physique</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回避すると、次の<keyword id=\"physical\">物理</keyword>攻撃が敵の<keyword id=\"block\">ブロック</keyword>を無視"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회피 시 다음 <keyword id=\"physical\">물리</keyword> 공격이 적의 <keyword id=\"block\">방어도</keyword> 무시"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "閃避後，下次<keyword id=\"physical\">物理</keyword>攻擊無視敵人<keyword id=\"block\">格擋</keyword>"
          }
        }
      }
    },
