    "talents.rogue_poison_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: rogue_poison_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kritische <keyword id=\"poison\">Gift</keyword>-Treffer lassen deinen nächsten <keyword id=\"bleed\">Blutungs</keyword>-Angriff kritisch treffen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"poison\">Poison</keyword> Critical Hits make your next <keyword id=\"bleed\">Bleed</keyword> attack Critically Hit"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les coups critiques de <keyword id=\"poison\">Poison</keyword> garantissent un coup critique à votre prochaine attaque de <keyword id=\"bleed\">Saignement</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
