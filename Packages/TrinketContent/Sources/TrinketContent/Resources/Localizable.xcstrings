    "affixes.thornwrought.astral_description": {
      "comment": "ContentManifest/affixes.tsv: thornwrought, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte zu Kampfbeginn <value id=\"quantity_1\">%1$lld</value> <keyword id=\"thorns\">Dornen</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gain <value id=\"quantity_1\">%1$lld</value> <keyword id=\"thorns\">Thorns</keyword> at the start of combat"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
