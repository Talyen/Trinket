          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">燃燒</keyword>對沒有<keyword id=\"block\">格擋</keyword>的敵人造成的傷害增加<value id=\"quantity_1\">%1$lld</value>%%"
          }
