    "talents.wolf_dodge_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: wolf_dodge_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Beide Verbündeten erhalten +<value id=\"quantity_1\">%1$lld</value>%% Chance auf <keyword id=\"dodge\">Ausweichen</keyword>"}},
