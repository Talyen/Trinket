    "affixes.infected.astral_description": {
      "comment": "ContentManifest/affixes.tsv: infected, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"bleed\">Blutungs</keyword>schaden: <value id=\"quantity_1\">%1$lld</value>%% Chance, einmal pro Zug <value id=\"quantity_2\">%2$lld</value> <keyword id=\"poison\">Gift</keyword>schaden zu verursachen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"bleed\">Bleed</keyword> damage: <value id=\"quantity_1\">%1$lld</value>%% chance to deal <value id=\"quantity_2\">%2$lld</value> <keyword id=\"poison\">Poison</keyword> damage once per turn"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dégâts de <keyword id=\"bleed\">Saignement</keyword> : <value id=\"quantity_1\">%1$lld</value>%% de chances d’infliger <value id=\"quantity_2\">%2$lld</value> dégâts de <keyword id=\"poison\">Poison</keyword>, une fois par tour"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"bleed\">出血</keyword>ダメージを与えると、1ターンに1回、<value id=\"quantity_1\">%1$lld</value>%%の確率で<keyword id=\"poison\">毒</keyword>ダメージを<value id=\"quantity_2\">%2$lld</value>与える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"bleed\">출혈</keyword> 피해: 턴마다 한 번, <value id=\"quantity_1\">%1$lld</value>%% 확률로 <keyword id=\"poison\">독</keyword> 피해 <value id=\"quantity_2\">%2$lld</value>"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "造成<keyword id=\"bleed\">流血</keyword>傷害時，有<value id=\"quantity_1\">%1$lld</value>%%機率造成<value id=\"quantity_2\">%2$lld</value>點<keyword id=\"poison\">中毒</keyword>傷害，每回合一次"
          }
        }
      }
    },
