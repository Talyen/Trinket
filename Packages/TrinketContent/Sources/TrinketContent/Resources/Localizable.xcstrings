      "comment": "ContentManifest/talents.tsv: fox_stun_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausweichen verursacht mit <value id=\"quantity_1\">%1$lld</value>%% Chance <value id=\"quantity_2\">%2$lld</value> <keyword id=\"stun\">Betäubungs</keyword>schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodging has a <value id=\"quantity_1\">%1$lld</value>%% chance to deal <value id=\"quantity_2\">%2$lld</value> <keyword id=\"stun\">Stun</keyword> damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une esquive a <value id=\"quantity_1\">%1$lld</value>%% de chances d’infliger <value id=\"quantity_2\">%2$lld</value> dégâts d’<keyword id=\"stun\">Étourdissement</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回避すると<value id=\"quantity_1\">%1$lld</value>%%の確率で<keyword id=\"stun\">スタン</keyword>ダメージを<value id=\"quantity_2\">%2$lld</value>与える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회피 시 <value id=\"quantity_1\">%1$lld</value>%% 확률로 <keyword id=\"stun\">기절</keyword> 피해 <value id=\"quantity_2\">%2$lld</value>"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "閃避時有<value id=\"quantity_1\">%1$lld</value>%%機率造成<value id=\"quantity_2\">%2$lld</value>點<keyword id=\"stun\">暈眩</keyword>傷害"
          }
        }
      }
    },
