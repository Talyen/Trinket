    "talents.rogue_gold_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: rogue_gold_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Kritische <keyword id=\"stun\">Betäubungs</keyword>-Treffer stehlen <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Gold</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">Stun</keyword> Critical Hits steal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Gold</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los golpes críticos de <keyword id=\"stun\">Aturdimiento</keyword> roban <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"gold\">Oro</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les coups critiques d’<keyword id=\"stun\">Étourdissement</keyword> volent <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Or</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">スタン</keyword>クリティカルヒットで<keyword id=\"gold\">ゴールド</keyword>を<value id=\"quantity_1\">%1$lld</value>盗む"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">기절</keyword> 치명타 적중 시 <keyword id=\"gold\">골드</keyword> <value id=\"quantity_1\">%1$lld</value> 훔치기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Golpes críticos de <keyword id=\"stun\">Atordoamento</keyword> roubam <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"gold\">Ouro</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">暈眩</keyword>暴擊偷取<value id=\"quantity_1\">%1$lld</value><keyword id=\"gold\">金幣</keyword>"}}
      }
    },
