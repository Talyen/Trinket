    "homestead_nodes.alchemylab.1.bonus_description": {
      "comment": "ContentManifest/homestead_nodes.tsv: alchemyLab.1, bonus_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erhöhe <keyword id=\"poison\">Gift</keyword>schaden um <value id=\"quantity_1\">%1$lld</value>%%\nProduziere <value id=\"quantity_2\">%2$lld</value> Kräuter pro Tag"}},
        "en": {"stringUnit": {"state": "translated", "value": "Increase <keyword id=\"poison\">Poison</keyword> damage by <value id=\"quantity_1\">%1$lld</value>%%\nProduce <value id=\"quantity_2\">%2$lld</value> Herbs per Day"}},
        "es": {"stringUnit": {"state": "translated", "value": "Aumenta el daño de <keyword id=\"poison\">Veneno</keyword> en un <value id=\"quantity_1\">%1$lld</value>%%\nProducción diaria de hierbas: <value id=\"quantity_2\">%2$lld</value>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Dégâts de <keyword id=\"poison\">Poison</keyword> augmentés de <value id=\"quantity_1\">%1$lld</value>%%\nProduit <value id=\"quantity_2\">%2$lld</value> herbes par jour"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">毒</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%増加\n1日に薬草を<value id=\"quantity_2\">%2$lld</value>生産"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">독</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가\n하루에 약초 <value id=\"quantity_2\">%2$lld</value>개 생산"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Aumente o dano de <keyword id=\"poison\">Veneno</keyword> em <value id=\"quantity_1\">%1$lld</value>%%\nProduza <value id=\"quantity_2\">%2$lld</value> Ervas por Dia"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">中毒</keyword>傷害提高<value id=\"quantity_1\">%1$lld</value>%%\n每天生產<value id=\"quantity_2\">%2$lld</value>藥草"}}
      }
    },
