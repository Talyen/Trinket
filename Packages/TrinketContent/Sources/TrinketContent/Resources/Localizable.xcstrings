        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"holy\">Holy</keyword> Critical Hits reduce the enemy's next attack accuracy by <value id=\"quantity_1\">%1$lld</value>%%"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les coups critiques de type <keyword id=\"holy\">Sacré</keyword> réduisent de <value id=\"quantity_1\">%1$lld</value>%% la précision de la prochaine attaque ennemie"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"holy\">聖</keyword>クリティカルヒットで敵の次の攻撃の命中率が<value id=\"quantity_1\">%1$lld</value>%%低下"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"holy\">신성</keyword> 치명타가 적의 다음 공격 명중률 <value id=\"quantity_1\">%1$lld</value>%% 감소"
          }
