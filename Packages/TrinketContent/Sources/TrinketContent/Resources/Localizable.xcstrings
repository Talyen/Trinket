    "talents.lizard_scout_gold_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: lizard_scout_gold_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Stehlen von <keyword id=\"gold\">Gold</keyword> gewährt mit <value id=\"quantity_1\">%1$lld</value>%% Chance <value id=\"quantity_2\">%2$lld</value> <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Stealing <keyword id=\"gold\">Gold</keyword> has a <value id=\"quantity_1\">%1$lld</value>%% chance to grant <value id=\"quantity_2\">%2$lld</value> <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Robar <keyword id=\"gold\">Oro</keyword> tiene un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de otorgar <value id=\"quantity_2\">%2$lld</value> de <keyword id=\"block\">Bloqueo</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Voler de l’<keyword id=\"gold\">Or</keyword> a <value id=\"quantity_1\">%1$lld</value>%% de chances d’octroyer <value id=\"quantity_2\">%2$lld</value> <keyword id=\"block\">Blocage</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"gold\">ゴールド</keyword>を盗むと<value id=\"quantity_1\">%1$lld</value>%%の確率で<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_2\">%2$lld</value>獲得"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"gold\">골드</keyword>를 훔치면 <value id=\"quantity_1\">%1$lld</value>%% 확률로 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_2\">%2$lld</value> 획득"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Roubar <keyword id=\"gold\">Ouro</keyword> tem <value id=\"quantity_1\">%1$lld</value>%% de chance de conceder <value id=\"quantity_2\">%2$lld</value> de <keyword id=\"block\">Bloqueio</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "偷取<keyword id=\"gold\">金幣</keyword>時，有<value id=\"quantity_1\">%1$lld</value>%%機率獲得<value id=\"quantity_2\">%2$lld</value>點<keyword id=\"block\">格擋</keyword>"}}
      }
    },
