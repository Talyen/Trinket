      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Angriffe deines Verbündeten lösen mit <value id=\"quantity_1\">%1$lld</value>%% Chance <keyword id=\"leech\">Lebensraub</keyword> aus"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your ally's attacks have a <value id=\"quantity_1\">%1$lld</value>%% chance to <keyword id=\"leech\">Leech</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les attaques de votre allié ont <value id=\"quantity_1\">%1$lld</value>%% de chances de bénéficier de <keyword id=\"leech\">Vol de vie</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "味方の攻撃が<value id=\"quantity_1\">%1$lld</value>%%の確率で<keyword id=\"leech\">吸収</keyword>する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아군의 공격에 <value id=\"quantity_1\">%1$lld</value>%% 확률로 <keyword id=\"leech\">흡혈</keyword> 적용"
