        "zh-Hant": {"stringUnit": {"state": "translated", "value": "發現的<keyword id=\"gold\">金幣</keyword>增加<value id=\"quantity_1\">%1$lld</value>%%\n每天生產<value id=\"quantity_2\">%2$lld</value><keyword id=\"gold\">金幣</keyword>"}}
