    "talents.bear_block_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: bear_block_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Angriffe, die deinen <keyword id=\"block\">Block</keyword> durchbrechen, verursachen nur die Hälfte ihres verbleibenden Schadens"}},
        "en": {"stringUnit": {"state": "translated", "value": "Attacks that break your <keyword id=\"block\">Block</keyword> deal half their remaining damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques que rompen tu <keyword id=\"block\">Bloqueo</keyword> infligen la mitad de su daño restante"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques qui brisent votre <keyword id=\"block\">Blocage</keyword> infligent la moitié de leurs dégâts restants"}},
        "ja": {"stringUnit": {"state": "translated", "value": "自分の<keyword id=\"block\">ブロック</keyword>を崩した攻撃の残りのダメージが半減"}},
        "ko": {"stringUnit": {"state": "translated", "value": "내 <keyword id=\"block\">방어도</keyword>를 깨뜨리는 공격의 남은 피해가 절반으로 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques que quebram seu <keyword id=\"block\">Bloqueio</keyword> causam metade do dano restante"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "擊破自身<keyword id=\"block\">格擋</keyword>的攻擊，其剩餘傷害減半"}}
      }
    },
    "talents.bear_block_t3_1.name": {
      "comment": "ContentManifest/talents.tsv: bear_block_t3_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Eisenhaut"}},
        "en": {"stringUnit": {"state": "translated", "value": "Ironhide"}},
        "es": {"stringUnit": {"state": "translated", "value": "Piel de hierro"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Peau de fer"}},
        "ja": {"stringUnit": {"state": "translated", "value": "鉄の皮膚"}},
        "ko": {"stringUnit": {"state": "translated", "value": "강철 가죽"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Pele de Ferro"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "鐵皮"}}
      }
    },
    "talents.bear_block_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: bear_block_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Unter halber <keyword id=\"health\">Gesundheit</keyword> erhältst du <value id=\"quantity_1\">%1$lld</value>%% mehr <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Below half <keyword id=\"health\">Health</keyword>, gain <value id=\"quantity_1\">%1$lld</value>%% more <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Por debajo de la mitad de <keyword id=\"health\">Salud</keyword>, obtén un <value id=\"quantity_1\">%1$lld</value>%% más de <keyword id=\"block\">Bloqueo</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Sous la moitié de votre <keyword id=\"health\">Santé</keyword>, gagnez <value id=\"quantity_1\">%1$lld</value>%% de <keyword id=\"block\">Blocage</keyword> en plus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>が半分未満なら、<keyword id=\"block\">ブロック</keyword>の獲得量が<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword>이 절반 미만이면 <keyword id=\"block\">방어도</keyword> 획득량 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Abaixo de metade da <keyword id=\"health\">Vida</keyword>, ganhe <value id=\"quantity_1\">%1$lld</value>%% mais <keyword id=\"block\">Bloqueio</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">生命值</keyword>低於一半時，獲得的<keyword id=\"block\">格擋</keyword>增加<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.bear_block_t3_2.name": {
      "comment": "ContentManifest/talents.tsv: bear_block_t3_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Vitalpanzer"}},
        "en": {"stringUnit": {"state": "translated", "value": "Vital Armor"}},
        "es": {"stringUnit": {"state": "translated", "value": "Armadura vital"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Armure vitale"}},
        "ja": {"stringUnit": {"state": "translated", "value": "生命の鎧"}},
        "ko": {"stringUnit": {"state": "translated", "value": "생명의 갑옷"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Armadura Vital"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "生命護甲"}}
      }
    },
    "talents.bear_block_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: bear_block_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Betäuben eines Gegners verdoppelt deinen nächsten Erhalt von <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Stunning an enemy doubles your next <keyword id=\"block\">Block</keyword> gain"}},
        "es": {"stringUnit": {"state": "translated", "value": "Aturdir a un enemigo duplica tu siguiente obtención de <keyword id=\"block\">Bloqueo</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Étourdir un ennemi double votre prochain gain de <keyword id=\"block\">Blocage</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "敵をスタン状態にすると、次に獲得する<keyword id=\"block\">ブロック</keyword>が2倍になる"}},
        "ko": {"stringUnit": {"state": "translated", "value": "적을 기절시키면 다음 <keyword id=\"block\">방어도</keyword> 획득량이 두 배"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Atordoar um inimigo dobra seu próximo ganho de <keyword id=\"block\">Bloqueio</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "使敵人暈眩時，下次獲得的<keyword id=\"block\">格擋</keyword>加倍"}}
      }
    },
    "talents.bear_block_t4_1.name": {
      "comment": "ContentManifest/talents.tsv: bear_block_t4_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Nachbebenschutz"}},
        "en": {"stringUnit": {"state": "translated", "value": "Aftershock Guard"}},
        "es": {"stringUnit": {"state": "translated", "value": "Guardia de réplica"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Garde de réplique"}},
        "ja": {"stringUnit": {"state": "translated", "value": "余震の守り"}},
        "ko": {"stringUnit": {"state": "translated", "value": "여진의 수호"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Guarda do Abalo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "餘震守護"}}
      }
    },
    "talents.bear_physical_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: bear_physical_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">Physische</keyword> Angriffe verursachen doppelten Schaden an gegnerischem <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">Physical</keyword> attacks deal double damage to enemy <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques <keyword id=\"physical\">físicos</keyword> infligen el doble de daño al <keyword id=\"block\">Bloqueo</keyword> del enemigo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques de type <keyword id=\"physical\">Physique</keyword> infligent le double de dégâts au <keyword id=\"block\">Blocage</keyword> ennemi"}},
        "ja": {"stringUnit": {"state": "translated", "value": "敵の<keyword id=\"block\">ブロック</keyword>への<keyword id=\"physical\">物理</keyword>攻撃のダメージが2倍になる"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">물리</keyword> 공격이 적의 <keyword id=\"block\">방어도</keyword>에 두 배의 피해"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques <keyword id=\"physical\">Físicos</keyword> causam o dobro de dano ao <keyword id=\"block\">Bloqueio</keyword> inimigo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">物理</keyword>攻擊對敵人<keyword id=\"block\">格擋</keyword>造成雙倍傷害"}}
      }
    },
    "talents.bear_physical_t1_1.name": {
      "comment": "ContentManifest/talents.tsv: bear_physical_t1_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Schildbrecher"}},
        "en": {"stringUnit": {"state": "translated", "value": "Shield Breaker"}},
        "es": {"stringUnit": {"state": "translated", "value": "Rompeescudos"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Brise-bouclier"}},
        "ja": {"stringUnit": {"state": "translated", "value": "盾砕き"}},
        "ko": {"stringUnit": {"state": "translated", "value": "방패 파괴자"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Quebra-Escudo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "破盾者"}}
      }
    },
    "talents.bear_physical_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: bear_physical_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wenn <keyword id=\"block\">Block</keyword> durchbrochen wird, verursacht dein nächster <keyword id=\"physical\">physischer</keyword> Angriff <value id=\"quantity_1\">%1$lld</value> zusätzlichen Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "When <keyword id=\"block\">Block</keyword> breaks, your next <keyword id=\"physical\">Physical</keyword> attack gains <value id=\"quantity_1\">%1$lld</value> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Cuando se rompe <keyword id=\"block\">Bloqueo</keyword>, tu siguiente ataque <keyword id=\"physical\">físico</keyword> obtiene <value id=\"quantity_1\">%1$lld</value> de daño"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Lorsque le <keyword id=\"block\">Blocage</keyword> est brisé, les dégâts de votre prochaine attaque de type <keyword id=\"physical\">Physique</keyword> augmentent de <value id=\"quantity_1\">%1$lld</value>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">ブロック</keyword>が崩れると、次の<keyword id=\"physical\">物理</keyword>攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">방어도</keyword>가 깨지면 다음 <keyword id=\"physical\">물리</keyword> 공격의 피해 <value id=\"quantity_1\">%1$lld</value> 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Quando o <keyword id=\"block\">Bloqueio</keyword> quebrar, seu próximo ataque <keyword id=\"physical\">Físico</keyword> ganha <value id=\"quantity_1\">%1$lld</value> de dano"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">格擋</keyword>被擊破時，下次<keyword id=\"physical\">物理</keyword>攻擊的傷害增加<value id=\"quantity_1\">%1$lld</value>點"}}
      }
    },
    "talents.bear_physical_t1_2.name": {
      "comment": "ContentManifest/talents.tsv: bear_physical_t1_2, name",
      "extractionState": "manual",
      "localizations": {
