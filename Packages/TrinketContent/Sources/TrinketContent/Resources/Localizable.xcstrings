    "affixes.unburdened.astral_description": {
      "comment": "ContentManifest/affixes.tsv: unburdened, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Angriffe verursachen <value id=\"quantity_1\">%1$lld</value>%% mehr Schaden, solange du keine Schwächungen hast"}},
        "en": {"stringUnit": {"state": "translated", "value": "Attacks deal <value id=\"quantity_1\">%1$lld</value>%% more damage while you have no debuffs"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques infligen un <value id=\"quantity_1\">%1$lld</value>%% más de daño mientras no tengas efectos negativos"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques infligent <value id=\"quantity_1\">%1$lld</value>%% de dégâts supplémentaires si vous n’avez aucun effet néfaste"}},
        "ja": {"stringUnit": {"state": "translated", "value": "自分に弱体効果がない間、攻撃ダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "자신에게 약화 효과가 없으면 공격 피해가 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques causam <value id=\"quantity_1\">%1$lld</value>%% mais dano enquanto você não tiver efeitos negativos"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "你沒有減益效果時，攻擊傷害提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "affixes.unburdened.basic_description": {
      "comment": "ContentManifest/affixes.tsv: unburdened, basic_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Angriffe verursachen <value id=\"quantity_1\">%1$lld</value>%% mehr Schaden, solange du keine Schwächungen hast"}},
        "en": {"stringUnit": {"state": "translated", "value": "Attacks deal <value id=\"quantity_1\">%1$lld</value>%% more damage while you have no debuffs"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques infligen un <value id=\"quantity_1\">%1$lld</value>%% más de daño mientras no tengas efectos negativos"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques infligent <value id=\"quantity_1\">%1$lld</value>%% de dégâts supplémentaires si vous n’avez aucun effet néfaste"}},
        "ja": {"stringUnit": {"state": "translated", "value": "自分に弱体効果がない間、攻撃ダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "자신에게 약화 효과가 없으면 공격 피해가 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques causam <value id=\"quantity_1\">%1$lld</value>%% mais dano enquanto você não tiver efeitos negativos"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "你沒有減益效果時，攻擊傷害提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "affixes.unburdened.title": {
      "comment": "ContentManifest/affixes.tsv: unburdened, title",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Unbelastet"}},
        "en": {"stringUnit": {"state": "translated", "value": "Unburdened"}},
        "es": {"stringUnit": {"state": "translated", "value": "Sin cargas"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Sans entrave"}},
        "ja": {"stringUnit": {"state": "translated", "value": "無垢"}},
        "ko": {"stringUnit": {"state": "translated", "value": "홀가분"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Sem fardos"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "無負"}}
      }
    },
    "affixes.unmaking.astral_description": {
      "comment": "ContentManifest/affixes.tsv: unmaking, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verursache <value id=\"quantity_1\">%1$lld</value> zusätzlichen <keyword id=\"physical\">physischen</keyword> Schaden. <keyword id=\"purge\">Entzaubere</keyword> alle Verstärkungen des Gegners, wenn du kritisch triffst"}},
        "en": {"stringUnit": {"state": "translated", "value": "Deal <value id=\"quantity_1\">%1$lld</value> bonus <keyword id=\"physical\">Physical</keyword> damage. <keyword id=\"purge\">Purge</keyword> all buffs from the enemy when you Critically Hit"}},
        "es": {"stringUnit": {"state": "translated", "value": "Inflige <value id=\"quantity_1\">%1$lld</value> de daño <keyword id=\"physical\">físico</keyword> adicional. <keyword id=\"purge\">Purga</keyword> todas las mejoras del enemigo cuando asestas un golpe crítico"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Dégâts de type <keyword id=\"physical\">Physique</keyword> augmentés de <value id=\"quantity_1\">%1$lld</value>. <keyword id=\"purge\">Dissipation</keyword> de tous les bonus de l’ennemi lors d’un coup critique"}},
        "ja": {"stringUnit": {"state": "translated", "value": "与える<keyword id=\"physical\">物理</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>増加。クリティカルヒット時に敵の強化効果をすべて<keyword id=\"purge\">強化解除</keyword>"}},
        "ko": {"stringUnit": {"state": "translated", "value": "가하는 <keyword id=\"physical\">물리</keyword> 피해 <value id=\"quantity_1\">%1$lld</value> 증가. 치명타 적중 시 <keyword id=\"purge\">강화 해제</keyword>로 적의 모든 강화 효과 제거"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cause <value id=\"quantity_1\">%1$lld</value> de dano <keyword id=\"physical\">Físico</keyword> adicional. <keyword id=\"purge\">Expurgue</keyword> todos os efeitos positivos do inimigo ao acertar um golpe crítico"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "造成的<keyword id=\"physical\">物理</keyword>傷害增加<value id=\"quantity_1\">%1$lld</value>。暴擊命中時，<keyword id=\"purge\">驅散</keyword>敵人所有增益效果"}}
      }
    },
    "affixes.unmaking.basic_description": {
      "comment": "ContentManifest/affixes.tsv: unmaking, basic_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verursache <value id=\"quantity_1\">%1$lld</value> zusätzlichen <keyword id=\"physical\">physischen</keyword> Schaden. <keyword id=\"purge\">Entzaubere</keyword> beim kritischen Treffer gegnerische Verstärkungen (Anzahl: <value id=\"quantity_2\">%2$lld</value>)"}},
        "en": {"stringUnit": {"state": "translated", "value": "Deal <value id=\"quantity_1\">%1$lld</value> bonus <keyword id=\"physical\">Physical</keyword> damage. <keyword id=\"purge\">Purge</keyword> <value id=\"quantity_2\">%2$lld</value> buff from the enemy when you Critically Hit"}},
        "es": {"stringUnit": {"state": "translated", "value": "Inflige <value id=\"quantity_1\">%1$lld</value> de daño <keyword id=\"physical\">físico</keyword> adicional. <keyword id=\"purge\">Purga</keyword> <value id=\"quantity_2\">%2$lld</value> mejora del enemigo cuando asestas un golpe crítico"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Dégâts de type <keyword id=\"physical\">Physique</keyword> augmentés de <value id=\"quantity_1\">%1$lld</value>. <keyword id=\"purge\">Dissipation</keyword> de <value id=\"quantity_2\">%2$lld</value> bonus de l’ennemi lors d’un coup critique"}},
        "ja": {"stringUnit": {"state": "translated", "value": "与える<keyword id=\"physical\">物理</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>増加。クリティカルヒットすると敵の強化効果を<value id=\"quantity_2\">%2$lld</value>個<keyword id=\"purge\">強化解除</keyword>"}},
        "ko": {"stringUnit": {"state": "translated", "value": "가하는 <keyword id=\"physical\">물리</keyword> 피해 <value id=\"quantity_1\">%1$lld</value> 증가. 치명타 적중 시 <keyword id=\"purge\">강화 해제</keyword>로 적의 강화 효과 <value id=\"quantity_2\">%2$lld</value>개 제거"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cause <value id=\"quantity_1\">%1$lld</value> de dano <keyword id=\"physical\">Físico</keyword> adicional. <keyword id=\"purge\">Expurgue</keyword> <value id=\"quantity_2\">%2$lld</value> efeito positivo do inimigo ao acertar um golpe crítico"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "造成的<keyword id=\"physical\">物理</keyword>傷害增加<value id=\"quantity_1\">%1$lld</value>。暴擊命中時，<keyword id=\"purge\">驅散</keyword>敵人的<value id=\"quantity_2\">%2$lld</value>項增益效果"}}
      }
    },
    "affixes.unmaking.title": {
      "comment": "ContentManifest/affixes.tsv: unmaking, title",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Auflösung"}},
        "en": {"stringUnit": {"state": "translated", "value": "Unmaking"}},
        "es": {"stringUnit": {"state": "translated", "value": "Deshacer"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Anéantissement"}},
        "ja": {"stringUnit": {"state": "translated", "value": "崩壊"}},
        "ko": {"stringUnit": {"state": "translated", "value": "소멸"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Desfazer"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "湮滅"}}
      }
    },
    "affixes.unraveling.astral_description": {
      "comment": "ContentManifest/affixes.tsv: unraveling, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erhalte <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>, wenn du einen Gegner <keyword id=\"purge\">entzauberst</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Gain <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword> when you <keyword id=\"purge\">Purge</keyword> an enemy"}},
        "es": {"stringUnit": {"state": "translated", "value": "Obtén <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueo</keyword> cuando <keyword id=\"purge\">purgas</keyword> a un enemigo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Gagnez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Blocage</keyword> lors d’une <keyword id=\"purge\">Dissipation</keyword> sur un ennemi"}},
        "ja": {"stringUnit": {"state": "translated", "value": "敵を<keyword id=\"purge\">強化解除</keyword>すると<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>獲得"}},
        "ko": {"stringUnit": {"state": "translated", "value": "적에게 <keyword id=\"purge\">강화 해제</keyword> 적용 시 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 획득"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ganhe <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueio</keyword> ao <keyword id=\"purge\">Expurgar</keyword> um inimigo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">驅散</keyword>敵人時，獲得<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>"}}
      }
    },
    "affixes.unraveling.basic_description": {
      "comment": "ContentManifest/affixes.tsv: unraveling, basic_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erhalte <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>, wenn du einen Gegner <keyword id=\"purge\">entzauberst</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Gain <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword> when you <keyword id=\"purge\">Purge</keyword> an enemy"}},
        "es": {"stringUnit": {"state": "translated", "value": "Obtén <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueo</keyword> cuando <keyword id=\"purge\">purgas</keyword> a un enemigo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Gagnez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Blocage</keyword> lors d’une <keyword id=\"purge\">Dissipation</keyword> sur un ennemi"}},
        "ja": {"stringUnit": {"state": "translated", "value": "敵を<keyword id=\"purge\">強化解除</keyword>すると<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>獲得"}},
        "ko": {"stringUnit": {"state": "translated", "value": "적에게 <keyword id=\"purge\">강화 해제</keyword> 적용 시 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 획득"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ganhe <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueio</keyword> ao <keyword id=\"purge\">Expurgar</keyword> um inimigo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">驅散</keyword>敵人時，獲得<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>"}}
      }
    },
