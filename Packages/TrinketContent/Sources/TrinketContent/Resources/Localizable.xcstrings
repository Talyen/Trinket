    "talents.library_owl_cleanse_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: library_owl_cleanse_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"variations": {"plural": {"one": {"stringUnit": {"state": "translated", "value": "Das Reinigen von <value id=\"quantity_1\">%1$lld</value> Schwächungseffekt gewährt pro entferntem Effekt <value id=\"quantity_2\">%2$lld</value> <keyword id=\"block\">Block</keyword>"}}, "other": {"stringUnit": {"state": "translated", "value": "Das Reinigen von <value id=\"quantity_1\">%1$lld</value> Schwächungseffekten gewährt pro entferntem Effekt <value id=\"quantity_2\">%2$lld</value> <keyword id=\"block\">Block</keyword>"}}}}},
        "en": {"variations": {"plural": {"one": {"stringUnit": {"state": "translated", "value": "Cleansing <value id=\"quantity_1\">%1$lld</value> debuff grants <value id=\"quantity_2\">%2$lld</value> <keyword id=\"block\">Block</keyword> per effect removed"}}, "other": {"stringUnit": {"state": "translated", "value": "Cleansing <value id=\"quantity_1\">%1$lld</value> debuffs grants <value id=\"quantity_2\">%2$lld</value> <keyword id=\"block\">Block</keyword> per effect removed"}}}}},
        "es": {"variations": {"plural": {"many": {"stringUnit": {"state": "translated", "value": "Purificar <value id=\"quantity_1\">%1$lld</value> perjuicios otorga <value id=\"quantity_2\">%2$lld</value> de <keyword id=\"block\">Bloqueo</keyword> por cada efecto eliminado"}}, "one": {"stringUnit": {"state": "translated", "value": "Purificar <value id=\"quantity_1\">%1$lld</value> perjuicio otorga <value id=\"quantity_2\">%2$lld</value> de <keyword id=\"block\">Bloqueo</keyword> por cada efecto eliminado"}}, "other": {"stringUnit": {"state": "translated", "value": "Purificar <value id=\"quantity_1\">%1$lld</value> perjuicios otorga <value id=\"quantity_2\">%2$lld</value> de <keyword id=\"block\">Bloqueo</keyword> por cada efecto eliminado"}}}}},
        "fr": {"variations": {"plural": {"many": {"stringUnit": {"state": "translated", "value": "Purifier <value id=\"quantity_1\">%1$lld</value> malus octroie <value id=\"quantity_2\">%2$lld</value> de <keyword id=\"block\">Blocage</keyword> par effet retiré"}}, "one": {"stringUnit": {"state": "translated", "value": "Purifier <value id=\"quantity_1\">%1$lld</value> malus octroie <value id=\"quantity_2\">%2$lld</value> de <keyword id=\"block\">Blocage</keyword> par effet retiré"}}, "other": {"stringUnit": {"state": "translated", "value": "Purifier <value id=\"quantity_1\">%1$lld</value> malus octroie <value id=\"quantity_2\">%2$lld</value> de <keyword id=\"block\">Blocage</keyword> par effet retiré"}}}}},
        "ja": {"variations": {"plural": {"other": {"stringUnit": {"state": "translated", "value": "弱体効果を<value id=\"quantity_1\">%1$lld</value>個浄化すると、解除した効果1つにつき<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_2\">%2$lld</value>得る"}}}}},
        "ko": {"variations": {"plural": {"other": {"stringUnit": {"state": "translated", "value": "약화 효과 <value id=\"quantity_1\">%1$lld</value>개 정화 시 제거한 효과마다 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_2\">%2$lld</value> 획득"}}}}},
        "pt-BR": {"variations": {"plural": {"many": {"stringUnit": {"state": "translated", "value": "Purificar <value id=\"quantity_1\">%1$lld</value> efeitos negativos concede <value id=\"quantity_2\">%2$lld</value> de <keyword id=\"block\">Bloqueio</keyword> por efeito removido"}}, "one": {"stringUnit": {"state": "translated", "value": "Purificar <value id=\"quantity_1\">%1$lld</value> efeito negativo concede <value id=\"quantity_2\">%2$lld</value> de <keyword id=\"block\">Bloqueio</keyword> por efeito removido"}}, "other": {"stringUnit": {"state": "translated", "value": "Purificar <value id=\"quantity_1\">%1$lld</value> efeitos negativos concede <value id=\"quantity_2\">%2$lld</value> de <keyword id=\"block\">Bloqueio</keyword> por efeito removido"}}}}},
        "zh-Hant": {"variations": {"plural": {"other": {"stringUnit": {"state": "translated", "value": "淨化<value id=\"quantity_1\">%1$lld</value>項減益效果時，每移除一項效果獲得<value id=\"quantity_2\">%2$lld</value>點<keyword id=\"block\">格擋</keyword>"}}}}}
      }
    },
