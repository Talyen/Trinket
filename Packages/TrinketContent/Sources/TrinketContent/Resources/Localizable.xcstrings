        "ja": {"stringUnit": {"state": "translated", "value": "地獄の炎"}},
        "ko": {"stringUnit": {"state": "translated", "value": "지옥불"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Fogo Infernal"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "地獄火"}}
