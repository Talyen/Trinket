    "talents.rogue_poison_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: rogue_poison_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Gift</keyword> auf Gegnern nimmt mit <value id=\"quantity_1\">%1$lld</value>%% Chance zu, statt abzunehmen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Enemy <keyword id=\"poison\">Poison</keyword> has a <value id=\"quantity_1\">%1$lld</value>%% chance to grow instead of fading"}},
        "es": {"stringUnit": {"state": "translated", "value": "El <keyword id=\"poison\">Veneno</keyword> que afecta al enemigo tiene un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de aumentar en vez de disminuir"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le <keyword id=\"poison\">Poison</keyword> affectant l’ennemi a <value id=\"quantity_1\">%1$lld</value>%% de chances d’augmenter au lieu de diminuer"}},
        "ja": {"stringUnit": {"state": "translated", "value": "敵にかかった<keyword id=\"poison\">毒</keyword>が<value id=\"quantity_1\">%1$lld</value>%%の確率で減衰せず増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "적에게 걸린 <keyword id=\"poison\">독</keyword>이 <value id=\"quantity_1\">%1$lld</value>%% 확률로 감소하는 대신 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O <keyword id=\"poison\">Veneno</keyword> no inimigo tem <value id=\"quantity_1\">%1$lld</value>%% de chance de crescer em vez de diminuir"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "敵人身上的<keyword id=\"poison\">中毒</keyword>有<value id=\"quantity_1\">%1$lld</value>%%機率不衰減反而增加"}}
      }
    },
