        "fr": {"stringUnit": {"state": "translated", "value": "Rend <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Santé</keyword> un tour sur deux"}},
        "ja": {"stringUnit": {"state": "translated", "value": "1ターンおきに<keyword id=\"health\">体力</keyword>を<value id=\"quantity_1\">%1$lld</value>回復"}},
