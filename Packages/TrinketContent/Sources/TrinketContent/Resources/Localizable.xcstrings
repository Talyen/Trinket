        "ja": {"stringUnit": {"state": "translated", "value": "すり抜け"}},
        "ko": {"stringUnit": {"state": "translated", "value": "빠져나가기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Escapar"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "溜走"}}
      }
