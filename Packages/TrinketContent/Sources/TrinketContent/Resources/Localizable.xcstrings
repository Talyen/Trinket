    "affixes.smugglers_map.astral_description": {
      "comment": "ContentManifest/affixes.tsv: smugglers_map, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Stehlen von <keyword id=\"gold\">Gold</keyword> hat eine Chance von <value id=\"quantity_1\">%1$lld</value>%%,\neine Karte zu ziehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stealing <keyword id=\"gold\">Gold</keyword> has a <value id=\"quantity_1\">%1$lld</value>%% chance\nto draw a card"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voler de l’<keyword id=\"gold\">Or</keyword> a <value id=\"quantity_1\">%1$lld</value>%% de chances\nde faire piocher une carte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"gold\">ゴールド</keyword>を盗むと<value id=\"quantity_1\">%1$lld</value>%%の確率で\nカードを1枚引く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"gold\">골드</keyword>를 훔치면 <value id=\"quantity_1\">%1$lld</value>%% 확률로\n카드 한 장 뽑기"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偷取<keyword id=\"gold\">金幣</keyword>時，有<value id=\"quantity_1\">%1$lld</value>%%機率\n抽一張牌"
          }
        }
      }
    },
