    "affixes.frostburn.astral_description": {
      "comment": "ContentManifest/affixes.tsv: frostburn, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhöhe <keyword id=\"freeze\">Frost</keyword>schaden gegen <keyword id=\"burn\">brennende</keyword> Gegner um <value id=\"quantity_1\">%1$lld</value>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Increase <keyword id=\"freeze\">Freeze</keyword> damage by <value id=\"quantity_1\">%1$lld</value> against <keyword id=\"burn\">Burning</keyword> enemies"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dégâts de <keyword id=\"freeze\">Gel</keyword> augmentés de <value id=\"quantity_1\">%1$lld</value> contre les ennemis sous <keyword id=\"burn\">Brûlure</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">炎上</keyword>状態の敵に与える<keyword id=\"freeze\">凍結</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>増加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">화상</keyword> 상태의 적에게 주는 <keyword id=\"freeze\">빙결</keyword> 피해 <value id=\"quantity_1\">%1$lld</value> 증가"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對<keyword id=\"burn\">燃燒</keyword>中的敵人造成的<keyword id=\"freeze\">冰凍</keyword>傷害增加<value id=\"quantity_1\">%1$lld</value>點"
          }
        }
      }
    },
