        "ja": {"stringUnit": {"state": "translated", "value": "反応性コーティング"}},
        "ko": {"stringUnit": {"state": "translated", "value": "반응성 코팅"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Revestimento Reativo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "反應塗層"}}
      }
