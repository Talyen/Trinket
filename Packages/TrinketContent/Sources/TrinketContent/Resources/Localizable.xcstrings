    "affixes.sundering_charm.astral_description": {
      "comment": "ContentManifest/affixes.tsv: sundering_charm, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"physical\">Physischer</keyword> Schaden und <keyword id=\"stun\">Betäubungs</keyword>schaden entfernen doppelt so viel <keyword id=\"block\">Block</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"physical\">Physical</keyword> and <keyword id=\"stun\">Stun</keyword> damage remove twice as much <keyword id=\"block\">Block</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dégâts de type <keyword id=\"physical\">Physique</keyword> et d’<keyword id=\"stun\">Étourdissement</keyword> retirent deux fois plus de <keyword id=\"block\">Blocage</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"physical\">物理</keyword>と<keyword id=\"stun\">スタン</keyword>ダメージで削る<keyword id=\"block\">ブロック</keyword>量が2倍になる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"physical\">물리</keyword> 및 <keyword id=\"stun\">기절</keyword> 피해가 <keyword id=\"block\">방어도</keyword>를 두 배로 제거"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"physical\">物理</keyword>與<keyword id=\"stun\">暈眩</keyword>傷害削除的<keyword id=\"block\">格擋</keyword>加倍"
          }
        }
      }
    },
