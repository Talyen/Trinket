    "affixes.emberwake.astral_description": {
      "comment": "ContentManifest/affixes.tsv: emberwake, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verursache <value id=\"quantity_1\">%1$lld</value> <keyword id=\"burn\">Brand</keyword>schaden, wenn du die <keyword id=\"deathsdoor\">Todesschwelle</keyword> erreichst"}},
        "en": {"stringUnit": {"state": "translated", "value": "Deal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"burn\">Burn</keyword> damage when you enter <keyword id=\"deathsdoor\">Death's Door</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Inflige <value id=\"quantity_1\">%1$lld</value> de daño de <keyword id=\"burn\">Quemadura</keyword> cuando entras en las <keyword id=\"deathsdoor\">Puertas de la Muerte</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Infligez <value id=\"quantity_1\">%1$lld</value> dégâts de <keyword id=\"burn\">Brûlure</keyword> lorsque vous atteignez le <keyword id=\"deathsdoor\">Seuil de la mort</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">死の淵</keyword>に入ると<keyword id=\"burn\">炎上</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">죽음의 문턱</keyword>에 들어서면 <keyword id=\"burn\">화상</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cause <value id=\"quantity_1\">%1$lld</value> de dano de <keyword id=\"burn\">Queimadura</keyword> ao ficar <keyword id=\"deathsdoor\">À Beira da Morte</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "進入<keyword id=\"deathsdoor\">瀕死之門</keyword>時，造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"burn\">燃燒</keyword>傷害"}}
      }
    },
