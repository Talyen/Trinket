    "affixes.wishing_well_coin.astral_description": {
      "comment": "ContentManifest/affixes.tsv: wishing_well_coin, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erhalte bei einem Sieg <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Gold</keyword> oder <value id=\"quantity_2\">%2$lld</value> <keyword id=\"gold\">Gold</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "On victory, gain <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Gold</keyword> or gain <value id=\"quantity_2\">%2$lld</value> <keyword id=\"gold\">Gold</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Al vencer, obtén <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"gold\">Oro</keyword> u obtén <value id=\"quantity_2\">%2$lld</value> de <keyword id=\"gold\">Oro</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "À la victoire, gagnez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Or</keyword> ou <value id=\"quantity_2\">%2$lld</value> <keyword id=\"gold\">Or</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "勝利時に<keyword id=\"gold\">ゴールド</keyword>を<value id=\"quantity_1\">%1$lld</value>獲得するか、<keyword id=\"gold\">ゴールド</keyword>を<value id=\"quantity_2\">%2$lld</value>獲得"}},
        "ko": {"stringUnit": {"state": "translated", "value": "승리 시 <keyword id=\"gold\">골드</keyword> <value id=\"quantity_1\">%1$lld</value> 또는 <keyword id=\"gold\">골드</keyword> <value id=\"quantity_2\">%2$lld</value> 획득"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Na vitória, ganhe <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"gold\">Ouro</keyword> ou ganhe <value id=\"quantity_2\">%2$lld</value> de <keyword id=\"gold\">Ouro</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "勝利時獲得<value id=\"quantity_1\">%1$lld</value><keyword id=\"gold\">金幣</keyword>或<value id=\"quantity_2\">%2$lld</value><keyword id=\"gold\">金幣</keyword>"}}
      }
    },
