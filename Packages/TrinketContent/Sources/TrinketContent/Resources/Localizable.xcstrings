    "affixes.knockout.astral_description": {
      "comment": "ContentManifest/affixes.tsv: knockout, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verursache <value id=\"quantity_1\">%1$lld</value> <keyword id=\"physical\">physischen</keyword> Schaden, wenn du den Gegner <keyword id=\"stun\">betäubst</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Deal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"physical\">Physical</keyword> damage when you <keyword id=\"stun\">Stun</keyword> the enemy"}},
        "es": {"stringUnit": {"state": "translated", "value": "Inflige <value id=\"quantity_1\">%1$lld</value> de daño <keyword id=\"physical\">físico</keyword> cuando <keyword id=\"stun\">aturdes</keyword> al enemigo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Infligez <value id=\"quantity_1\">%1$lld</value> dégâts de type <keyword id=\"physical\">Physique</keyword> lorsque vous infligez un <keyword id=\"stun\">Étourdissement</keyword> à l’ennemi"}},
        "ja": {"stringUnit": {"state": "translated", "value": "敵を<keyword id=\"stun\">スタン</keyword>状態にすると<keyword id=\"physical\">物理</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える"}},
        "ko": {"stringUnit": {"state": "translated", "value": "적을 <keyword id=\"stun\">기절</keyword>시키면 <keyword id=\"physical\">물리</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cause <value id=\"quantity_1\">%1$lld</value> de dano <keyword id=\"physical\">Físico</keyword> ao <keyword id=\"stun\">Atordoar</keyword> o inimigo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "使敵人<keyword id=\"stun\">暈眩</keyword>時，造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"physical\">物理</keyword>傷害"}}
      }
    },
