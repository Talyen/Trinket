    "talents.lizard_scout_bleed_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: lizard_scout_bleed_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "+<value id=\"quantity_1\">%1$lld</value>%% Chance auf kritische Treffer gegen <keyword id=\"bleed\">blutende</keyword> Gegner"}},
        "en": {"stringUnit": {"state": "translated", "value": "+<value id=\"quantity_1\">%1$lld</value>%% Critical Hit chance against <keyword id=\"bleed\">Bleeding</keyword> enemies"}},
        "es": {"stringUnit": {"state": "translated", "value": "+<value id=\"quantity_1\">%1$lld</value>%% de probabilidad de golpe crítico contra enemigos con <keyword id=\"bleed\">Sangrado</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "+<value id=\"quantity_1\">%1$lld</value>%% de chances de coup critique contre les ennemis sous <keyword id=\"bleed\">Saignement</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">出血</keyword>状態の敵へのクリティカル率が<value id=\"quantity_1\">%1$lld</value>%%上昇"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">출혈</keyword> 상태의 적을 상대로 치명타 확률 +<value id=\"quantity_1\">%1$lld</value>%%"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "+<value id=\"quantity_1\">%1$lld</value>%% de chance de golpe crítico contra inimigos com <keyword id=\"bleed\">Sangramento</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "對<keyword id=\"bleed\">流血</keyword>敵人的暴擊機率提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
