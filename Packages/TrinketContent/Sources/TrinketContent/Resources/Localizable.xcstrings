    "talents.wildcard_physical_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: wildcard_physical_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kritische <keyword id=\"physical\">physische</keyword> Treffer ignorieren gegnerischen <keyword id=\"block\">Block</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"physical\">Physical</keyword> Critical Hits ignore enemy <keyword id=\"block\">Block</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les coups critiques de type <keyword id=\"physical\">Physique</keyword> ignorent le <keyword id=\"block\">Blocage</keyword> ennemi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"physical\">物理</keyword>クリティカルヒットが敵の<keyword id=\"block\">ブロック</keyword>を無視"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"physical\">물리</keyword> 치명타가 적의 <keyword id=\"block\">방어도</keyword> 무시"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"physical\">物理</keyword>暴擊無視敵人<keyword id=\"block\">格擋</keyword>"
          }
        }
      }
    },
