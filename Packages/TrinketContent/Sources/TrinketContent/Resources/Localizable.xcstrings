    "talents.wolf_bleed_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: wolf_bleed_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Gegner unter halber <keyword id=\"health\">Gesundheit</keyword> erleiden <value id=\"quantity_1\">%1$lld</value>%% mehr <keyword id=\"bleed\">Blutungs</keyword>schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Enemies below half <keyword id=\"health\">Health</keyword> take <value id=\"quantity_1\">%1$lld</value>%% increased <keyword id=\"bleed\">Bleed</keyword> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los enemigos por debajo de la mitad de <keyword id=\"health\">Salud</keyword> reciben un <value id=\"quantity_1\">%1$lld</value>%% más de daño de <keyword id=\"bleed\">Sangrado</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les ennemis sous la moitié de leur <keyword id=\"health\">Santé</keyword> subissent <value id=\"quantity_1\">%1$lld</value>%% de dégâts de <keyword id=\"bleed\">Saignement</keyword> en plus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>が半分未満の敵が受ける<keyword id=\"bleed\">出血</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword>이 절반 미만인 적이 받는 <keyword id=\"bleed\">출혈</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Inimigos abaixo de metade da <keyword id=\"health\">Vida</keyword> recebem <value id=\"quantity_1\">%1$lld</value>%% mais dano de <keyword id=\"bleed\">Sangramento</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">生命值</keyword>低於一半的敵人，承受的<keyword id=\"bleed\">流血</keyword>傷害增加<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
