        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurer de la <keyword id=\"health\">Santé</keyword> retire <value id=\"quantity_1\">%1$lld</value> <keyword id=\"thorns\">Épines</keyword> ennemies"
          }
