    "affixes.plague_doctors_mask.astral_description": {
      "comment": "ContentManifest/affixes.tsv: plague_doctors_mask, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erleide <value id=\"quantity_1\">%1$lld</value>%% weniger <keyword id=\"poison\">Gift</keyword>schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Take <value id=\"quantity_1\">%1$lld</value>%% less <keyword id=\"poison\">Poison</keyword> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Recibe un <value id=\"quantity_1\">%1$lld</value>%% menos de daño de <keyword id=\"poison\">Veneno</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Dégâts de <keyword id=\"poison\">Poison</keyword> subis réduits de <value id=\"quantity_1\">%1$lld</value>%%"}},
        "ja": {"stringUnit": {"state": "translated", "value": "受ける<keyword id=\"poison\">毒</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%減少"}},
        "ko": {"stringUnit": {"state": "translated", "value": "받는 <keyword id=\"poison\">독</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>%% 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Receba <value id=\"quantity_1\">%1$lld</value>%% menos dano de <keyword id=\"poison\">Veneno</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "承受的<keyword id=\"poison\">中毒</keyword>傷害降低<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
