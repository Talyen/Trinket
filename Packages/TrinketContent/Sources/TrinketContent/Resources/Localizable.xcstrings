    "rule.ability.conditional_bonus": {
      "comment": "Ability rule template. Integer arguments have semantic value labels. String arguments are complete localized rule/condition clauses or keyword names, in source order. Preserve actor, enemy/ally target, condition, chance and quantity.",
      "extractionState": "manual",
      "localizations": {
