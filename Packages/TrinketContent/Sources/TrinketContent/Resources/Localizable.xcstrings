      "comment": "ContentManifest/talents.tsv: golden_retriever_gold_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Stehlen von <keyword id=\"gold\">Gold</keyword> erhöht deinen nächsten Erhalt von <keyword id=\"block\">Block</keyword> um <value id=\"quantity_1\">%1$lld</value>%%"
