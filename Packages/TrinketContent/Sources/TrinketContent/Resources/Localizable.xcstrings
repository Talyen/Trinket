    "talents.phoenix_deathsdoor_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: phoenix_deathsdoor_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die <keyword id=\"deathsdoor\">Todesschwelle</keyword> hält <value id=\"quantity_1\">%1$lld</value> zusätzlichen Zug an"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
