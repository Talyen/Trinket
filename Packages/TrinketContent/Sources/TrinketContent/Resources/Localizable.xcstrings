    "talents.wildcard_gold_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: wildcard_gold_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Erhalt von <keyword id=\"gold\">Gold</keyword> unter halber <keyword id=\"health\">Gesundheit</keyword> lässt dich eine Karte ziehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaining <keyword id=\"gold\">Gold</keyword> while below half <keyword id=\"health\">Health</keyword> draws a card"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagner de l’<keyword id=\"gold\">Or</keyword> sous la moitié de votre <keyword id=\"health\">Santé</keyword> fait piocher une carte"
          }
