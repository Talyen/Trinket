    "talents.lizard_scout_gold_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: lizard_scout_gold_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Stehlen von <keyword id=\"gold\">Gold</keyword> lässt dich mit <value id=\"quantity_1\">%1$lld</value>%% Chance eine Karte ziehen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Stealing <keyword id=\"gold\">Gold</keyword> has a <value id=\"quantity_1\">%1$lld</value>%% chance to draw a card"}},
        "es": {"stringUnit": {"state": "translated", "value": "Robar <keyword id=\"gold\">Oro</keyword> tiene un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de hacer que robes una carta"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Voler de l’<keyword id=\"gold\">Or</keyword> a <value id=\"quantity_1\">%1$lld</value>%% de chances de faire piocher une carte"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"gold\">ゴールド</keyword>を盗むと<value id=\"quantity_1\">%1$lld</value>%%の確率でカードを1枚引く"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"gold\">골드</keyword>를 훔치면 <value id=\"quantity_1\">%1$lld</value>%% 확률로 카드 한 장 뽑기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Roubar <keyword id=\"gold\">Ouro</keyword> tem <value id=\"quantity_1\">%1$lld</value>%% de chance de comprar uma carta"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "偷取<keyword id=\"gold\">金幣</keyword>時，有<value id=\"quantity_1\">%1$lld</value>%%機率抽一張牌"}}
