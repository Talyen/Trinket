    "affixes.bristling.astral_description": {
      "comment": "ContentManifest/affixes.tsv: bristling, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhöhe <keyword id=\"thorns\">Dornen</keyword>schaden um <value id=\"quantity_1\">%1$lld</value>, solange du <keyword id=\"block\">Block</keyword> hast"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Increase <keyword id=\"thorns\">Thorns</keyword> damage by <value id=\"quantity_1\">%1$lld</value> while you have <keyword id=\"block\">Block</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dégâts d’<keyword id=\"thorns\">Épines</keyword> augmentés de <value id=\"quantity_1\">%1$lld</value> tant que vous avez du <keyword id=\"block\">Blocage</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"block\">ブロック</keyword>がある間、<keyword id=\"thorns\">棘</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>増加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"block\">방어도</keyword>가 있으면 <keyword id=\"thorns\">가시</keyword> 피해 <value id=\"quantity_1\">%1$lld</value> 증가"
