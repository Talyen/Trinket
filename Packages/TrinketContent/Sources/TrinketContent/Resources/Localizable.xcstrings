    "affixes.spellrending.astral_description": {
      "comment": "ContentManifest/affixes.tsv: spellrending, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"variations": {"plural": {"one": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">Entzaubere</keyword> <value id=\"quantity_1\">%1$lld</value> Verstärkung des Gegners, wenn du eine Karte mit <keyword id=\"mana\">Mana</keyword> verstärkst"}}, "other": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">Entzaubere</keyword> <value id=\"quantity_1\">%1$lld</value> Verstärkungen des Gegners, wenn du eine Karte mit <keyword id=\"mana\">Mana</keyword> verstärkst"}}}}},
        "en": {"variations": {"plural": {"one": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">Purge</keyword> <value id=\"quantity_1\">%1$lld</value> buff from the enemy when you empower a card with <keyword id=\"mana\">Mana</keyword>"}}, "other": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">Purge</keyword> <value id=\"quantity_1\">%1$lld</value> buffs from the enemy when you empower a card with <keyword id=\"mana\">Mana</keyword>"}}}}},
        "es": {"variations": {"plural": {"many": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">Purga</keyword> <value id=\"quantity_1\">%1$lld</value> mejoras del enemigo cuando potencias una carta con <keyword id=\"mana\">Maná</keyword>"}}, "one": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">Purga</keyword> <value id=\"quantity_1\">%1$lld</value> mejora del enemigo cuando potencias una carta con <keyword id=\"mana\">Maná</keyword>"}}, "other": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">Purga</keyword> <value id=\"quantity_1\">%1$lld</value> mejoras del enemigo cuando potencias una carta con <keyword id=\"mana\">Maná</keyword>"}}}}},
        "fr": {"variations": {"plural": {"many": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">Dissipation</keyword> de <value id=\"quantity_1\">%1$lld</value> bonus de l’ennemi lorsque vous renforcez une carte avec du <keyword id=\"mana\">Mana</keyword>"}}, "one": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">Dissipation</keyword> de <value id=\"quantity_1\">%1$lld</value> bonus de l’ennemi lorsque vous renforcez une carte avec du <keyword id=\"mana\">Mana</keyword>"}}, "other": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">Dissipation</keyword> de <value id=\"quantity_1\">%1$lld</value> bonus de l’ennemi lorsque vous renforcez une carte avec du <keyword id=\"mana\">Mana</keyword>"}}}}},
        "ja": {"variations": {"plural": {"other": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">マナ</keyword>でカードを強化すると敵の強化効果を<value id=\"quantity_1\">%1$lld</value>個<keyword id=\"purge\">強化解除</keyword>"}}}}},
        "ko": {"variations": {"plural": {"other": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">마나</keyword>로 카드 강화 시 <keyword id=\"purge\">강화 해제</keyword>로 적의 강화 효과 <value id=\"quantity_1\">%1$lld</value>개 제거"}}}}},
        "pt-BR": {"variations": {"plural": {"many": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">Expurgue</keyword> <value id=\"quantity_1\">%1$lld</value> efeitos positivos do inimigo ao fortalecer uma carta com <keyword id=\"mana\">Mana</keyword>"}}, "one": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">Expurgue</keyword> <value id=\"quantity_1\">%1$lld</value> efeito positivo do inimigo ao fortalecer uma carta com <keyword id=\"mana\">Mana</keyword>"}}, "other": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">Expurgue</keyword> <value id=\"quantity_1\">%1$lld</value> efeitos positivos do inimigo ao fortalecer uma carta com <keyword id=\"mana\">Mana</keyword>"}}}}},
        "zh-Hant": {"variations": {"plural": {"other": {"stringUnit": {"state": "translated", "value": "用<keyword id=\"mana\">魔力</keyword>強化卡牌時，<keyword id=\"purge\">驅散</keyword>敵人的<value id=\"quantity_1\">%1$lld</value>項增益效果"}}}}}
      }
    },
