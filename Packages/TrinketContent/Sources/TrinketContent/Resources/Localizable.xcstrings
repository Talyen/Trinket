          "stringUnit": {
            "state": "translated",
            "value": "Un renforcement au <keyword id=\"mana\">Mana</keyword> coûte <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword> de moins"
