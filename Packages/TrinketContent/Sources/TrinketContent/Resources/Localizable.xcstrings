    "authored.e68f3b8807de2555": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Abilities/AbilityCatalog+Skill.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verursache <value id=\"quantity_1\">%1$lld</value> <keyword id=\"physical\">physischen</keyword> Schaden\nErhalte zufällig <value id=\"quantity_2\">%2$lld</value> <keyword id=\"block\">Block</keyword> oder <keyword id=\"thorns\">Dornen</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Deal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"physical\">Physical</keyword> damage\nGain <value id=\"quantity_2\">%2$lld</value> <keyword id=\"block\">Block</keyword> or <keyword id=\"thorns\">Thorns</keyword> at random"}},
        "es": {"stringUnit": {"state": "translated", "value": "Inflige <value id=\"quantity_1\">%1$lld</value> de daño <keyword id=\"physical\">físico</keyword>\nObtén <value id=\"quantity_2\">%2$lld</value> de <keyword id=\"block\">Bloqueo</keyword> o <keyword id=\"thorns\">Espinas</keyword> al azar"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Infligez <value id=\"quantity_1\">%1$lld</value> dégâts de type <keyword id=\"physical\">Physique</keyword>\nGagnez aléatoirement <value id=\"quantity_2\">%2$lld</value> en <keyword id=\"block\">Blocage</keyword> ou en <keyword id=\"thorns\">Épines</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">物理</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える\n<keyword id=\"block\">ブロック</keyword>か<keyword id=\"thorns\">棘</keyword>をランダムに<value id=\"quantity_2\">%2$lld</value>獲得"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">물리</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>\n무작위로 <keyword id=\"block\">방어도</keyword> 또는 <keyword id=\"thorns\">가시</keyword> <value id=\"quantity_2\">%2$lld</value> 획득"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cause <value id=\"quantity_1\">%1$lld</value> de dano <keyword id=\"physical\">Físico</keyword>\nGanhe <value id=\"quantity_2\">%2$lld</value> de <keyword id=\"block\">Bloqueio</keyword> ou de <keyword id=\"thorns\">Espinhos</keyword>, aleatoriamente"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"physical\">物理</keyword>傷害\n隨機獲得<value id=\"quantity_2\">%2$lld</value>點<keyword id=\"block\">格擋</keyword>或<keyword id=\"thorns\">荊棘</keyword>"}}
      }
    },
