        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"block\">ブロック</keyword>のない敵への<keyword id=\"burn\">炎上</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"
          }
