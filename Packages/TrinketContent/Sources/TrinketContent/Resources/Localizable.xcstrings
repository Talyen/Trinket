    "talents.knight_holy_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: knight_holy_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"holy\">Heiliger</keyword> Schaden gewährt deinem Gefährten mit <value id=\"quantity_1\">%1$lld</value>%% Chance ebenso viel <keyword id=\"block\">Block</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"holy\">Holy</keyword> damage has a <value id=\"quantity_1\">%1$lld</value>%% chance to grant equal <keyword id=\"block\">Block</keyword> to your Companion"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dégâts de type <keyword id=\"holy\">Sacré</keyword> ont <value id=\"quantity_1\">%1$lld</value>%% de chances d’octroyer autant de <keyword id=\"block\">Blocage</keyword> à votre Compagnon"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"holy\">聖</keyword>ダメージを与えると<value id=\"quantity_1\">%1$lld</value>%%の確率で同量の<keyword id=\"block\">ブロック</keyword>を仲間に付与"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"holy\">신성</keyword> 피해를 주면 <value id=\"quantity_1\">%1$lld</value>%% 확률로 동료에게 같은 양의 <keyword id=\"block\">방어도</keyword> 부여"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"holy\">神聖</keyword>傷害有<value id=\"quantity_1\">%1$lld</value>%%機率為夥伴賦予等量<keyword id=\"block\">格擋</keyword>"
          }
        }
      }
    },
