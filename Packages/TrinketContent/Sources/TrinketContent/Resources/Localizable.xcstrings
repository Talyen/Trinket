    "talents.shield_scarab_holy_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: shield_scarab_holy_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geblockter Schaden wird mit <value id=\"quantity_1\">%1$lld</value>%% Chance als <keyword id=\"holy\">heiliger</keyword> Schaden zurückgeworfen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocking damage has a <value id=\"quantity_1\">%1$lld</value>%% chance to reflect it as <keyword id=\"holy\">Holy</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquer des dégâts a <value id=\"quantity_1\">%1$lld</value>%% de chances de les renvoyer en dégâts de type <keyword id=\"holy\">Sacré</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダメージをブロックすると<value id=\"quantity_1\">%1$lld</value>%%の確率でそのダメージを<keyword id=\"holy\">聖</keyword>として反射"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피해를 막으면 <value id=\"quantity_1\">%1$lld</value>%% 확률로 그 피해를 <keyword id=\"holy\">신성</keyword> 피해로 반사"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "格擋傷害時，有<value id=\"quantity_1\">%1$lld</value>%%機率將其反射為<keyword id=\"holy\">神聖</keyword>傷害"
          }
        }
      }
    },
