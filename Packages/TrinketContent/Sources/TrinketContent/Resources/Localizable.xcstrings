    "talents.frost_whelp_dodge_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: frost_whelp_dodge_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oberhalb halber <keyword id=\"health\">Gesundheit</keyword> erhältst du +<value id=\"quantity_1\">%1$lld</value>%% Chance auf <keyword id=\"dodge\">Ausweichen</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Above half <keyword id=\"health\">Health</keyword>, gain +<value id=\"quantity_1\">%1$lld</value>%% <keyword id=\"dodge\">Dodge</keyword> chance"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au-dessus de la moitié de votre <keyword id=\"health\">Santé</keyword>, gagnez +<value id=\"quantity_1\">%1$lld</value>%% de chances d’<keyword id=\"dodge\">Esquive</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">体力</keyword>が半分を超えている間、<keyword id=\"dodge\">回避</keyword>率が<value id=\"quantity_1\">%1$lld</value>%%上昇"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">체력</keyword>이 절반 초과이면 <keyword id=\"dodge\">회피</keyword> 확률 +<value id=\"quantity_1\">%1$lld</value>%%"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">生命值</keyword>高於一半時，<keyword id=\"dodge\">閃避</keyword>機率提高<value id=\"quantity_1\">%1$lld</value>%%"
          }
        }
      }
    },
