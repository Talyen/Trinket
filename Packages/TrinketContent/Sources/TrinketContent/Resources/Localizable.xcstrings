    "talents.shield_scarab_block_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: shield_scarab_block_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Solange du <keyword id=\"block\">Block</keyword> hast, erleidet dein Verbündeter <value id=\"quantity_1\">%1$lld</value>%% weniger Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "While you have <keyword id=\"block\">Block</keyword>, your ally takes <value id=\"quantity_1\">%1$lld</value>%% less damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Mientras tienes <keyword id=\"block\">Bloqueo</keyword>, tu aliado recibe un <value id=\"quantity_1\">%1$lld</value>%% menos de daño"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Tant que vous avez du <keyword id=\"block\">Blocage</keyword>, votre allié subit <value id=\"quantity_1\">%1$lld</value>%% de dégâts en moins"}},
        "ja": {"stringUnit": {"state": "translated", "value": "自分に<keyword id=\"block\">ブロック</keyword>がある間、味方が受けるダメージが<value id=\"quantity_1\">%1$lld</value>%%減少"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">방어도</keyword>가 있으면 아군이 받는 피해 <value id=\"quantity_1\">%1$lld</value>%% 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Enquanto você tiver <keyword id=\"block\">Bloqueio</keyword>, seu aliado recebe <value id=\"quantity_1\">%1$lld</value>%% menos dano"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "自身擁有<keyword id=\"block\">格擋</keyword>時，友方承受的傷害降低<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
