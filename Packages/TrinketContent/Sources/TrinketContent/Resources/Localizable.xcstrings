        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">炎上</keyword>攻撃が<value id=\"quantity_1\">%1$lld</value>%%の確率で<keyword id=\"bleed\">出血</keyword>ダメージを<value id=\"quantity_2\">%2$lld</value>与える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">화상</keyword> 공격이 <value id=\"quantity_1\">%1$lld</value>%% 확률로 <keyword id=\"bleed\">출혈</keyword> 피해 <value id=\"quantity_2\">%2$lld</value>"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">燃燒</keyword>攻擊有<value id=\"quantity_1\">%1$lld</value>%%機率造成<value id=\"quantity_2\">%2$lld</value>點<keyword id=\"bleed\">流血</keyword>傷害"
          }
