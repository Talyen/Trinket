        "ja": {"stringUnit": {"state": "translated", "value": "庇護の種"}},
        "ko": {"stringUnit": {"state": "translated", "value": "피난처의 씨앗"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Semente de Abrigo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "庇護之種"}}
      }
    },
    "talents.druid_health_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: druid_health_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Wiederherstellen von <keyword id=\"health\">Gesundheit</keyword> reinigt auch <keyword id=\"poison\">Gift</keyword> und <keyword id=\"bleed\">Blutung</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Restoring <keyword id=\"health\">Health</keyword> also Cleanses <keyword id=\"poison\">Poison</keyword> and <keyword id=\"bleed\">Bleed</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Restaurar <keyword id=\"health\">Salud</keyword> también purifica <keyword id=\"poison\">Veneno</keyword> y <keyword id=\"bleed\">Sangrado</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Restaurer de la <keyword id=\"health\">Santé</keyword> purifie aussi le <keyword id=\"poison\">Poison</keyword> et le <keyword id=\"bleed\">Saignement</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>を回復すると<keyword id=\"poison\">毒</keyword>と<keyword id=\"bleed\">出血</keyword>も浄化"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword> 회복 시 <keyword id=\"poison\">독</keyword>과 <keyword id=\"bleed\">출혈</keyword>도 정화"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Restaurar <keyword id=\"health\">Vida</keyword> também Purifica <keyword id=\"poison\">Veneno</keyword> e <keyword id=\"bleed\">Sangramento</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "恢復<keyword id=\"health\">生命值</keyword>時，也會淨化<keyword id=\"poison\">中毒</keyword>和<keyword id=\"bleed\">流血</keyword>"}}
      }
    },
    "talents.druid_health_t3_1.name": {
      "comment": "ContentManifest/talents.tsv: druid_health_t3_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Reinigender Tau"}},
        "en": {"stringUnit": {"state": "translated", "value": "Cleansing Dew"}},
        "es": {"stringUnit": {"state": "translated", "value": "Rocío purificador"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Rosée purificatrice"}},
        "ja": {"stringUnit": {"state": "translated", "value": "清めの露"}},
        "ko": {"stringUnit": {"state": "translated", "value": "정화의 이슬"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Orvalho Purificador"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "淨化露水"}}
      }
    },
    "talents.druid_health_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: druid_health_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wenn du deinen Gefährten heilst, stelle auch halb so viel eigene <keyword id=\"health\">Gesundheit</keyword> wieder her"}},
        "en": {"stringUnit": {"state": "translated", "value": "Healing your Companion also restores half as much of your <keyword id=\"health\">Health</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Curar a tu compañero también restaura la mitad de esa cantidad de tu <keyword id=\"health\">Salud</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Soigner votre Compagnon restaure aussi la moitié de ce montant à votre <keyword id=\"health\">Santé</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "仲間を回復すると、その半分の量だけ自分の<keyword id=\"health\">体力</keyword>も回復"}},
        "ko": {"stringUnit": {"state": "translated", "value": "동료 치유 시 그 절반만큼 내 <keyword id=\"health\">체력</keyword>도 회복"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Curar seu Companheiro também restaura metade dessa quantidade da sua <keyword id=\"health\">Vida</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "治療夥伴時，也為自身恢復相當於該治療量一半的<keyword id=\"health\">生命值</keyword>"}}
      }
    },
    "talents.druid_health_t3_2.name": {
      "comment": "ContentManifest/talents.tsv: druid_health_t3_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Gemeinsame Wurzeln"}},
        "en": {"stringUnit": {"state": "translated", "value": "Shared Roots"}},
        "es": {"stringUnit": {"state": "translated", "value": "Raíces compartidas"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Racines partagées"}},
        "ja": {"stringUnit": {"state": "translated", "value": "根のつながり"}},
        "ko": {"stringUnit": {"state": "translated", "value": "공유하는 뿌리"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Raízes Compartilhadas"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "共享根系"}}
      }
    },
    "talents.druid_health_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: druid_health_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verbündete mit <keyword id=\"thorns\">Dornen</keyword> erleiden oberhalb halber <keyword id=\"health\">Gesundheit</keyword> <value id=\"quantity_1\">%1$lld</value>%% weniger Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Allies with <keyword id=\"thorns\">Thorns</keyword> take <value id=\"quantity_1\">%1$lld</value>%% less damage above half <keyword id=\"health\">Health</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los aliados con <keyword id=\"thorns\">Espinas</keyword> reciben un <value id=\"quantity_1\">%1$lld</value>%% menos de daño por encima de la mitad de <keyword id=\"health\">Salud</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les alliés ayant des <keyword id=\"thorns\">Épines</keyword> subissent <value id=\"quantity_1\">%1$lld</value>%% de dégâts en moins au-dessus de la moitié de leur <keyword id=\"health\">Santé</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"thorns\">棘</keyword>を持つ味方は、<keyword id=\"health\">体力</keyword>が半分を超えている間、受けるダメージが<value id=\"quantity_1\">%1$lld</value>%%減少"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"thorns\">가시</keyword>가 있는 아군의 <keyword id=\"health\">체력</keyword>이 절반 초과이면 받는 피해 <value id=\"quantity_1\">%1$lld</value>%% 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Aliados com <keyword id=\"thorns\">Espinhos</keyword> recebem <value id=\"quantity_1\">%1$lld</value>%% menos dano acima de metade da <keyword id=\"health\">Vida</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "擁有<keyword id=\"thorns\">荊棘</keyword>且<keyword id=\"health\">生命值</keyword>高於一半的友方，承受的傷害降低<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.druid_health_t4_1.name": {
      "comment": "ContentManifest/talents.tsv: druid_health_t4_1, name",
