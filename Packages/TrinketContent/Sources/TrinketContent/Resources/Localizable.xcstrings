        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"stun\">기절</keyword> 치명타가 적의 <keyword id=\"block\">방어도</keyword> 무시"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"stun\">暈眩</keyword>暴擊無視敵人<keyword id=\"block\">格擋</keyword>"
          }
        }
      }
    },
