    "affixes.denouncing.astral_description": {
      "comment": "ContentManifest/affixes.tsv: denouncing, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verursache <value id=\"quantity_1\">%1$lld</value> <keyword id=\"holy\">heiligen</keyword> Schaden, wenn du einen Gegner <keyword id=\"purge\">entzauberst</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"holy\">Holy</keyword> damage when you <keyword id=\"purge\">Purge</keyword> an enemy"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Infligez <value id=\"quantity_1\">%1$lld</value> dégâts de type <keyword id=\"holy\">Sacré</keyword> lors d’une <keyword id=\"purge\">Dissipation</keyword> sur un ennemi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "敵を<keyword id=\"purge\">強化解除</keyword>すると<keyword id=\"holy\">聖</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적에게 <keyword id=\"purge\">강화 해제</keyword> 적용 시 <keyword id=\"holy\">신성</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"purge\">驅散</keyword>敵人時，造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"holy\">神聖</keyword>傷害"
          }
        }
      }
    },
