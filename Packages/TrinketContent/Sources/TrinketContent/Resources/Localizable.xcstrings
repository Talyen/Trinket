        "pt-BR": {"stringUnit": {"state": "translated", "value": "Máscara da peste"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "瘟疫面具"}}
      }
    },
    "traits.profane.description": {
      "comment": "ContentManifest/traits.tsv: profane, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erlittener <keyword id=\"holy\">heiliger</keyword> Schaden um <value id=\"quantity_1\">%1$lld</value>%% erhöht"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">Holy</keyword> damage taken increased by <value id=\"quantity_1\">%1$lld</value>%%"}},
        "es": {"stringUnit": {"state": "translated", "value": "Daño <keyword id=\"holy\">sagrado</keyword> recibido aumentado en un <value id=\"quantity_1\">%1$lld</value>%%"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Dégâts de type <keyword id=\"holy\">Sacré</keyword> subis augmentés de <value id=\"quantity_1\">%1$lld</value>%%"}},
        "ja": {"stringUnit": {"state": "translated", "value": "受ける<keyword id=\"holy\">聖</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "받는 <keyword id=\"holy\">신성</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Dano <keyword id=\"holy\">Sagrado</keyword> recebido aumentado em <value id=\"quantity_1\">%1$lld</value>%%"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "承受的<keyword id=\"holy\">神聖</keyword>傷害增加<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "traits.profane.name": {
      "comment": "ContentManifest/traits.tsv: profane, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Profan"}},
        "en": {"stringUnit": {"state": "translated", "value": "Profane"}},
        "es": {"stringUnit": {"state": "translated", "value": "Profano"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Profane"}},
        "ja": {"stringUnit": {"state": "translated", "value": "冒涜"}},
        "ko": {"stringUnit": {"state": "translated", "value": "불경함"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Profano"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "褻瀆"}}
      }
    },
    "traits.pyromancy.description": {
      "comment": "ContentManifest/traits.tsv: pyromancy, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Jeder <keyword id=\"burn\">Brand</keyword>treffer verursacht <value id=\"quantity_1\">%1$lld</value> zusätzlichen Schaden."}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Burn</keyword> hits deal <value id=\"quantity_1\">%1$lld</value> additional damage."}},
        "es": {"stringUnit": {"state": "translated", "value": "Cada impacto de <keyword id=\"burn\">Quemadura</keyword> inflige <value id=\"quantity_1\">%1$lld</value> de daño adicional."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Chaque occurrence de dégâts de <keyword id=\"burn\">Brûlure</keyword> inflige <value id=\"quantity_1\">%1$lld</value> de dégâts supplémentaires."}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">炎上</keyword>ダメージは1ヒットごとに<value id=\"quantity_1\">%1$lld</value>増加する。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">화상</keyword> 피해가 발생할 때마다 해당 피해가 <value id=\"quantity_1\">%1$lld</value> 증가한다."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cada acerto de <keyword id=\"burn\">Queimadura</keyword> causa <value id=\"quantity_1\">%1$lld</value> de dano adicional."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每次<keyword id=\"burn\">燃燒</keyword>傷害均額外增加<value id=\"quantity_1\">%1$lld</value>點。"}}
      }
    },
    "traits.pyromancy.name": {
      "comment": "ContentManifest/traits.tsv: pyromancy, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Pyromantie"}},
        "en": {"stringUnit": {"state": "translated", "value": "Pyromancy"}},
        "es": {"stringUnit": {"state": "translated", "value": "Piromancia"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Pyromancie"}},
        "ja": {"stringUnit": {"state": "translated", "value": "火術"}},
