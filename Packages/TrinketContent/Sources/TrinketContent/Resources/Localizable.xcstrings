    "authored.d8dc8b523964f2d6": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">Heiliger</keyword> Schaden baut <keyword id=\"stun\">Betäubung</keyword> auf und stiehlt <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Gold</keyword>, wenn er einen Gegner betäubt"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">Holy</keyword> damage causes <keyword id=\"stun\">Stun</keyword> build-up and steals <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Gold</keyword> when it Stuns an enemy"}},
        "es": {"stringUnit": {"state": "translated", "value": "El daño <keyword id=\"holy\">sagrado</keyword> acumula <keyword id=\"stun\">Aturdimiento</keyword> y roba <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"gold\">Oro</keyword> cuando aturde a un enemigo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les dégâts de type <keyword id=\"holy\">Sacré</keyword> accumulent de l’<keyword id=\"stun\">Étourdissement</keyword> et volent <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Or</keyword> lorsqu’ils étourdissent un ennemi"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">聖</keyword>ダメージで<keyword id=\"stun\">スタン</keyword>を蓄積し、敵をスタン状態にすると<keyword id=\"gold\">ゴールド</keyword>を<value id=\"quantity_1\">%1$lld</value>盗む"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">신성</keyword> 피해가 <keyword id=\"stun\">기절</keyword>을 축적하며, 이로 적을 기절시키면 <keyword id=\"gold\">골드</keyword> <value id=\"quantity_1\">%1$lld</value> 훔치기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Dano <keyword id=\"holy\">Sagrado</keyword> causa acúmulo de <keyword id=\"stun\">Atordoamento</keyword> e rouba <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"gold\">Ouro</keyword> ao Atordoar um inimigo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">神聖</keyword>傷害會累積<keyword id=\"stun\">暈眩</keyword>，並在使敵人暈眩時偷取<value id=\"quantity_1\">%1$lld</value><keyword id=\"gold\">金幣</keyword>"}}
      }
    },
    "authored.d9cffbda49267e68": {
      "comment": "Packages/TrinketAppState/Sources/TrinketAppState/Play/Modes/SpiresPlayMode.swift: player-facing failure title",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Turm fehlt"}},
        "en": {"stringUnit": {"state": "translated", "value": "Spire Missing"}},
        "es": {"stringUnit": {"state": "translated", "value": "Falta la Aguja"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Tour introuvable"}},
        "ja": {"stringUnit": {"state": "translated", "value": "尖塔が見つかりません"}},
        "ko": {"stringUnit": {"state": "translated", "value": "첨탑을 찾을 수 없음"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Torre ausente"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "找不到高塔"}}
      }
    },
    "authored.da79c9f484e5e210": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Brand</keyword>schaden verursacht mit <value id=\"quantity_1\">%1$lld</value>%% Chance <value id=\"quantity_2\">%2$lld</value> <keyword id=\"bleed\">Blutungs</keyword>schaden und umgekehrt\n<keyword id=\"burn\">Brand</keyword>- und <keyword id=\"bleed\">Blutungs</keyword>schaden erhalten <keyword id=\"leech\">Lebensraub</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Dealing <keyword id=\"burn\">Burn</keyword> damage has a <value id=\"quantity_1\">%1$lld</value>%% chance to deal <value id=\"quantity_2\">%2$lld</value> <keyword id=\"bleed\">Bleed</keyword> damage, and vice versa\n<keyword id=\"burn\">Burn</keyword> and <keyword id=\"bleed\">Bleed</keyword> damage gain <keyword id=\"leech\">Leech</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Infligir daño de <keyword id=\"burn\">Quemadura</keyword> tiene un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de infligir <value id=\"quantity_2\">%2$lld</value> de daño de <keyword id=\"bleed\">Sangrado</keyword>, y viceversa\nEl daño de <keyword id=\"burn\">Quemadura</keyword> y <keyword id=\"bleed\">Sangrado</keyword> obtiene <keyword id=\"leech\">Absorción</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les dégâts de <keyword id=\"burn\">Brûlure</keyword> ont <value id=\"quantity_1\">%1$lld</value>%% de chances d’infliger <value id=\"quantity_2\">%2$lld</value> dégâts de <keyword id=\"bleed\">Saignement</keyword>, et inversement\nLes dégâts de <keyword id=\"burn\">Brûlure</keyword> et de <keyword id=\"bleed\">Saignement</keyword> bénéficient de <keyword id=\"leech\">Vol de vie</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">炎上</keyword>ダメージを与えると、<value id=\"quantity_1\">%1$lld</value>%%の確率で<keyword id=\"bleed\">出血</keyword>ダメージを<value id=\"quantity_2\">%2$lld</value>与える（逆の場合も同様）\n<keyword id=\"burn\">炎上</keyword>と<keyword id=\"bleed\">出血</keyword>ダメージに<keyword id=\"leech\">吸収</keyword>を付与"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">화상</keyword> 피해를 주면 <value id=\"quantity_1\">%1$lld</value>%% 확률로 <keyword id=\"bleed\">출혈</keyword> 피해 <value id=\"quantity_2\">%2$lld</value>. 반대의 경우도 적용\n<keyword id=\"burn\">화상</keyword> 및 <keyword id=\"bleed\">출혈</keyword> 피해에 <keyword id=\"leech\">흡혈</keyword> 부여"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Causar dano de <keyword id=\"burn\">Queimadura</keyword> tem <value id=\"quantity_1\">%1$lld</value>%% de chance de causar <value id=\"quantity_2\">%2$lld</value> de dano de <keyword id=\"bleed\">Sangramento</keyword>, e vice-versa\nDano de <keyword id=\"burn\">Queimadura</keyword> e de <keyword id=\"bleed\">Sangramento</keyword> ganha <keyword id=\"leech\">Drenagem</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "造成<keyword id=\"burn\">燃燒</keyword>傷害時，有<value id=\"quantity_1\">%1$lld</value>%%機率造成<value id=\"quantity_2\">%2$lld</value>點<keyword id=\"bleed\">流血</keyword>傷害，反之亦然\n<keyword id=\"burn\">燃燒</keyword>與<keyword id=\"bleed\">流血</keyword>傷害獲得<keyword id=\"leech\">吸血</keyword>"}}
      }
    },
