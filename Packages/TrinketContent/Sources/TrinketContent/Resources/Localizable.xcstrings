    "talents.wolf_bleed_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: wolf_bleed_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"bleed\">Blutungs</keyword>-Angriffe beider Verbündeten erhalten +<value id=\"quantity_1\">%1$lld</value>%% Chance auf kritische Treffer"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both allies' <keyword id=\"bleed\">Bleed</keyword> attacks gain +<value id=\"quantity_1\">%1$lld</value>%% Critical Hit chance"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les attaques de <keyword id=\"bleed\">Saignement</keyword> des deux alliés gagnent +<value id=\"quantity_1\">%1$lld</value>%% de chances de coup critique"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "味方2人の<keyword id=\"bleed\">出血</keyword>攻撃のクリティカル率が<value id=\"quantity_1\">%1$lld</value>%%上昇"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 아군의 <keyword id=\"bleed\">출혈</keyword> 공격 치명타 확률 +<value id=\"quantity_1\">%1$lld</value>%%"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩名友方的<keyword id=\"bleed\">流血</keyword>攻擊暴擊機率提高<value id=\"quantity_1\">%1$lld</value>%%"
          }
        }
      }
    },
