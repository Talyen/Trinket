    "talents.wildcard_physical_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: wildcard_physical_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein Gegner deinen Angriff vollständig blockt, wird dein nächster <keyword id=\"physical\">physischer</keyword> Angriff verdoppelt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An enemy fully Blocking your attack doubles your next <keyword id=\"physical\">Physical</keyword> attack"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un ennemi bloque entièrement votre attaque, votre prochaine attaque de type <keyword id=\"physical\">Physique</keyword> est doublée"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の攻撃を敵が完全にブロックすると、次の<keyword id=\"physical\">物理</keyword>攻撃が2倍になる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적이 내 공격을 완전히 막으면 다음 <keyword id=\"physical\">물리</keyword> 공격이 두 배"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自身攻擊被敵人完全格擋後，下次<keyword id=\"physical\">物理</keyword>攻擊加倍"
          }
        }
      }
    },
