    "talents.lizard_scout_bleed_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: lizard_scout_bleed_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Kritische <keyword id=\"bleed\">Blutungs</keyword>-Treffer gewähren <value id=\"quantity_1\">%1$lld</value> <keyword id=\"thorns\">Dornen</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">Bleed</keyword> Critical Hits grant <value id=\"quantity_1\">%1$lld</value> <keyword id=\"thorns\">Thorns</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los golpes críticos de <keyword id=\"bleed\">Sangrado</keyword> otorgan <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"thorns\">Espinas</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les coups critiques de <keyword id=\"bleed\">Saignement</keyword> octroient <value id=\"quantity_1\">%1$lld</value> <keyword id=\"thorns\">Épines</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">出血</keyword>クリティカルヒットで<keyword id=\"thorns\">棘</keyword>を<value id=\"quantity_1\">%1$lld</value>獲得"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">출혈</keyword> 치명타 적중 시 <keyword id=\"thorns\">가시</keyword> <value id=\"quantity_1\">%1$lld</value> 획득"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Golpes críticos de <keyword id=\"bleed\">Sangramento</keyword> concedem <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"thorns\">Espinhos</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">流血</keyword>暴擊賦予<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"thorns\">荊棘</keyword>"}}
      }
    },
