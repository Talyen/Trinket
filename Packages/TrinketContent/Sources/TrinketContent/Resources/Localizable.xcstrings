    "homestead_nodes.pasture.3.summary": {
      "comment": "ContentManifest/homestead_nodes.tsv: pasture.3, summary",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offenes Weideland für größere Vorräte und langsamere, stärkere Unterstützung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open grazing land for larger stores and slower, stronger support"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des pâturages ouverts pour de plus grandes réserves et un soutien lent mais puissant"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "蓄えを増やし、着実で力強い支援をもたらす放牧地"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 넉넉한 비축과 느리지만 강한 지원을 위한 탁 트인 방목지"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開闊牧地可增加物資儲備，提供較緩慢卻更有力的支援"
          }
        }
      }
    },
