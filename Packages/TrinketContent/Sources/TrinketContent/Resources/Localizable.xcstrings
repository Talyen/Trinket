    "talents.pixie_cleanse_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: pixie_cleanse_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Reinigen gewährt dem Ziel <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Cleansing grants the target <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Purificar otorga al objetivo <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueo</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Purifier octroie <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Blocage</keyword> à la cible"}},
        "ja": {"stringUnit": {"state": "translated", "value": "浄化すると対象に<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>付与"}},
        "ko": {"stringUnit": {"state": "translated", "value": "정화 시 대상에게 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 부여"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Purificar concede <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueio</keyword> ao alvo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "淨化時賦予目標<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>"}}
      }
    },
