    "talents.wolf_bleed_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: wolf_bleed_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">Blutungs</keyword>-Angriffe ignorieren die Hälfte des gegnerischen <keyword id=\"block\">Blocks</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">Bleed</keyword> attacks ignore half enemy <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques de <keyword id=\"bleed\">Sangrado</keyword> ignoran la mitad del <keyword id=\"block\">Bloqueo</keyword> del enemigo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques de <keyword id=\"bleed\">Saignement</keyword> ignorent la moitié du <keyword id=\"block\">Blocage</keyword> ennemi"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">出血</keyword>攻撃が敵の<keyword id=\"block\">ブロック</keyword>を半分無視"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">출혈</keyword> 공격이 적의 <keyword id=\"block\">방어도</keyword> 절반 무시"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques de <keyword id=\"bleed\">Sangramento</keyword> ignoram metade do <keyword id=\"block\">Bloqueio</keyword> inimigo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">流血</keyword>攻擊無視敵人一半<keyword id=\"block\">格擋</keyword>"}}
      }
    },
