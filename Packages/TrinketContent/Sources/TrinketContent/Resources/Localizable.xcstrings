    "talents.mana_moth_freeze_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: mana_moth_freeze_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kritische <keyword id=\"freeze\">Frost</keyword>-Treffer verringern die Treffergenauigkeit des nächsten gegnerischen Angriffs um <value id=\"quantity_1\">%1$lld</value>%%"
          }
