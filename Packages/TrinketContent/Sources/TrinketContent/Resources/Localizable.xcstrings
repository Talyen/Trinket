        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"bleed\">출혈</keyword> 상태의 적에게 <keyword id=\"leech\">흡혈</keyword> 공격의 치명타 확률 +<value id=\"quantity_1\">%1$lld</value>%%"
          }
