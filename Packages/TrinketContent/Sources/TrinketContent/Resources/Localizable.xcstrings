          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"mana\">魔力</keyword>強化的<keyword id=\"burn\">燃燒</keyword>攻擊額外造成<value id=\"quantity_1\">%1$lld</value>點傷害"
          }
        }
      }
    },
