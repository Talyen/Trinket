    "talents.frost_whelp_mana_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: frost_whelp_mana_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verstärken mit <keyword id=\"mana\">Mana</keyword> kostet <value id=\"quantity_1\">%1$lld</value> weniger <keyword id=\"mana\">Mana</keyword>"
          }
        },
        "en": {
          "stringUnit": {
