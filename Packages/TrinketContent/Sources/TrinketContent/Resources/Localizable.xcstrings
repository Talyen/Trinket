    "affixes.contagion.astral_description": {
      "comment": "ContentManifest/affixes.tsv: contagion, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Gift</keyword> nimmt mit <value id=\"quantity_1\">%1$lld</value>%% Chance zu, statt abzunehmen"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Poison</keyword> has a <value id=\"quantity_1\">%1$lld</value>%% chance to increase instead of decreasing"}},
        "es": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Veneno</keyword> tiene un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de aumentar en vez de disminuir"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le <keyword id=\"poison\">Poison</keyword> a <value id=\"quantity_1\">%1$lld</value>%% de chances d’augmenter au lieu de diminuer"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">毒</keyword>が<value id=\"quantity_1\">%1$lld</value>%%の確率で減少せず増加する"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">독</keyword>이 <value id=\"quantity_1\">%1$lld</value>%% 확률로 감소하는 대신 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Veneno</keyword> tem <value id=\"quantity_1\">%1$lld</value>%% de chance de aumentar em vez de diminuir"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">中毒</keyword>有<value id=\"quantity_1\">%1$lld</value>%%機率不減反增"}}
      }
    },
    "affixes.contagion.basic_description": {
      "comment": "ContentManifest/affixes.tsv: contagion, basic_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Gift</keyword> nimmt mit <value id=\"quantity_1\">%1$lld</value>%% Chance zu, statt abzunehmen"}},
