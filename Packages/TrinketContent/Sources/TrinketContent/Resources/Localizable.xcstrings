    "talents.wildcard_gold_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: wildcard_gold_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Der Erhalt von <keyword id=\"gold\">Gold</keyword> <keyword id=\"cleanse\">reinigt</keyword> mit <value id=\"quantity_1\">%1$lld</value>%% Chance <value id=\"quantity_2\">%2$lld</value> Schwächungseffekt"}},
        "en": {"stringUnit": {"state": "translated", "value": "Gaining <keyword id=\"gold\">Gold</keyword> has a <value id=\"quantity_1\">%1$lld</value>%% chance to <keyword id=\"cleanse\">Cleanse</keyword> <value id=\"quantity_2\">%2$lld</value> debuff"}},
        "es": {"stringUnit": {"state": "translated", "value": "Obtener <keyword id=\"gold\">Oro</keyword> tiene un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de <keyword id=\"cleanse\">purificar</keyword> <value id=\"quantity_2\">%2$lld</value> perjuicio"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Gagner de l’<keyword id=\"gold\">Or</keyword> a <value id=\"quantity_1\">%1$lld</value>%% de chances de déclencher la <keyword id=\"cleanse\">Purification</keyword> de <value id=\"quantity_2\">%2$lld</value> malus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"gold\">ゴールド</keyword>を得ると<value id=\"quantity_1\">%1$lld</value>%%の確率で弱体効果を<value id=\"quantity_2\">%2$lld</value>個<keyword id=\"cleanse\">浄化</keyword>"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"gold\">골드</keyword> 획득 시 <value id=\"quantity_1\">%1$lld</value>%% 확률로 약화 효과 <value id=\"quantity_2\">%2$lld</value>개를 <keyword id=\"cleanse\">정화</keyword>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ganhar <keyword id=\"gold\">Ouro</keyword> tem <value id=\"quantity_1\">%1$lld</value>%% de chance de <keyword id=\"cleanse\">Purificar</keyword> <value id=\"quantity_2\">%2$lld</value> efeito negativo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "獲得<keyword id=\"gold\">金幣</keyword>時有<value id=\"quantity_1\">%1$lld</value>%%機率<keyword id=\"cleanse\">淨化</keyword><value id=\"quantity_2\">%2$lld</value>項減益效果"}}
      }
    },
