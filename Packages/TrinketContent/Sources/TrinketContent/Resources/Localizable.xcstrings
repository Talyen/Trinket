    "talents.warlock_burn_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: warlock_burn_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Deine <keyword id=\"burn\">Brand</keyword>angriffe verursachen bei <keyword id=\"bleed\">blutenden</keyword> Gegnern <value id=\"quantity_1\">%1$lld</value>%% mehr Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your <keyword id=\"burn\">Burn</keyword> attacks deal <value id=\"quantity_1\">%1$lld</value>%% more damage to <keyword id=\"bleed\">Bleeding</keyword> enemies"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tus ataques de <keyword id=\"burn\">Quemadura</keyword> infligen un <value id=\"quantity_1\">%1$lld</value>%% más de daño a enemigos con <keyword id=\"bleed\">Sangrado</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Vos attaques de <keyword id=\"burn\">Brûlure</keyword> infligent <value id=\"quantity_1\">%1$lld</value>%% de dégâts supplémentaires aux ennemis affectés par un <keyword id=\"bleed\">Saignement</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "あなたの<keyword id=\"burn\">炎上</keyword>攻撃は、<keyword id=\"bleed\">出血</keyword>状態の敵に与えるダメージが<value id=\"quantity_1\">%1$lld</value>%%増加する"}},
        "ko": {"stringUnit": {"state": "translated", "value": "자신의 <keyword id=\"burn\">화상</keyword> 공격이 <keyword id=\"bleed\">출혈</keyword>에 걸린 적에게 주는 피해가 <value id=\"quantity_1\">%1$lld</value>%% 증가합니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seus ataques de <keyword id=\"burn\">Queimadura</keyword> causam <value id=\"quantity_1\">%1$lld</value>%% mais dano a inimigos com <keyword id=\"bleed\">Sangramento</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "你的<keyword id=\"burn\">燃燒</keyword>攻擊對<keyword id=\"bleed\">流血</keyword>的敵人造成的傷害提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.warlock_burn_t1_1.name": {
      "comment": "ContentManifest/talents.tsv: warlock_burn_t1_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Blutfeuer"}},
        "en": {"stringUnit": {"state": "translated", "value": "Bloodfire"}},
        "es": {"stringUnit": {"state": "translated", "value": "Fuego sanguíneo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Feu sanglant"}},
        "ja": {"stringUnit": {"state": "translated", "value": "血炎"}},
        "ko": {"stringUnit": {"state": "translated", "value": "혈화"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Sangue e Fogo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "血焰"}}
      }
    },
    "talents.warlock_burn_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: warlock_burn_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Unter halber <keyword id=\"health\">Gesundheit</keyword> wird <keyword id=\"burn\">Brand</keyword>schaden um <value id=\"quantity_1\">%1$lld</value>%% erhöht"}},
        "en": {"stringUnit": {"state": "translated", "value": "Below half <keyword id=\"health\">Health</keyword>, <keyword id=\"burn\">Burn</keyword> damage is increased by <value id=\"quantity_1\">%1$lld</value>%%"}},
        "es": {"stringUnit": {"state": "translated", "value": "Por debajo de la mitad de <keyword id=\"health\">Salud</keyword>, el daño de <keyword id=\"burn\">Quemadura</keyword> aumenta en un <value id=\"quantity_1\">%1$lld</value>%%"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Sous la moitié de votre <keyword id=\"health\">Santé</keyword>, les dégâts de <keyword id=\"burn\">Brûlure</keyword> augmentent de <value id=\"quantity_1\">%1$lld</value>%%"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>が半分未満なら、<keyword id=\"burn\">炎上</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword>이 절반 미만이면 <keyword id=\"burn\">화상</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Abaixo de metade da <keyword id=\"health\">Vida</keyword>, o dano de <keyword id=\"burn\">Queimadura</keyword> aumenta em <value id=\"quantity_1\">%1$lld</value>%%"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">生命值</keyword>低於一半時，<keyword id=\"burn\">燃燒</keyword>傷害提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.warlock_burn_t1_2.name": {
      "comment": "ContentManifest/talents.tsv: warlock_burn_t1_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Sengende Asche"}},
        "en": {"stringUnit": {"state": "translated", "value": "Scorching Ash"}},
        "es": {"stringUnit": {"state": "translated", "value": "Ceniza abrasadora"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Cendres brûlantes"}},
        "ja": {"stringUnit": {"state": "translated", "value": "灼熱の灰"}},
        "ko": {"stringUnit": {"state": "translated", "value": "작열하는 잿더미"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cinza Escaldante"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "灼熱灰燼"}}
      }
    },
    "talents.warlock_burn_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: warlock_burn_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Brennende</keyword> Gegner stellen halb so viel <keyword id=\"health\">Gesundheit</keyword> wieder her"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Burning</keyword> enemies restore half as much <keyword id=\"health\">Health</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los enemigos con <keyword id=\"burn\">Quemadura</keyword> restauran la mitad de la cantidad normal de <keyword id=\"health\">Salud</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les ennemis sous <keyword id=\"burn\">Brûlure</keyword> restaurent moitié moins de <keyword id=\"health\">Santé</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">炎上</keyword>状態の敵の<keyword id=\"health\">体力</keyword>回復量が半減"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">화상</keyword> 상태인 적의 <keyword id=\"health\">체력</keyword> 회복량이 절반으로 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Inimigos <keyword id=\"burn\">Em Chamas</keyword> restauram apenas metade da quantidade normal de <keyword id=\"health\">Vida</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">燃燒</keyword>中的敵人恢復的<keyword id=\"health\">生命值</keyword>減半"}}
      }
    },
    "talents.warlock_burn_t2_1.name": {
      "comment": "ContentManifest/talents.tsv: warlock_burn_t2_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Auszehrende Flamme"}},
        "en": {"stringUnit": {"state": "translated", "value": "Withering Flame"}},
        "es": {"stringUnit": {"state": "translated", "value": "Llama marchitante"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Flamme flétrissante"}},
        "ja": {"stringUnit": {"state": "translated", "value": "衰弱の炎"}},
        "ko": {"stringUnit": {"state": "translated", "value": "쇠약의 불꽃"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Chama Definhante"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "凋零之火"}}
      }
    },
    "talents.warlock_burn_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: warlock_burn_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Ausgeben deines letzten <keyword id=\"mana\">Mana</keyword> erhöht den Schaden deines nächsten <keyword id=\"burn\">Brand</keyword>-Angriffs um <value id=\"quantity_1\">%1$lld</value>%%"}},
        "en": {"stringUnit": {"state": "translated", "value": "Spending your last <keyword id=\"mana\">Mana</keyword> increases your next <keyword id=\"burn\">Burn</keyword> attack’s damage by <value id=\"quantity_1\">%1$lld</value>%%"}},
        "es": {"stringUnit": {"state": "translated", "value": "Gastar tu último punto de <keyword id=\"mana\">Maná</keyword> aumenta el daño de tu siguiente ataque de <keyword id=\"burn\">Quemadura</keyword> en un <value id=\"quantity_1\">%1$lld</value>%%"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Dépenser votre dernier <keyword id=\"mana\">Mana</keyword> augmente de <value id=\"quantity_1\">%1$lld</value>%% les dégâts de votre prochaine attaque de <keyword id=\"burn\">Brûlure</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "最後の<keyword id=\"mana\">マナ</keyword>を消費すると、次の<keyword id=\"burn\">炎上</keyword>攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "마지막 <keyword id=\"mana\">마나</keyword> 소모 시 다음 <keyword id=\"burn\">화상</keyword> 공격의 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Gastar sua última <keyword id=\"mana\">Mana</keyword> aumenta o dano do seu próximo ataque de <keyword id=\"burn\">Queimadura</keyword> em <value id=\"quantity_1\">%1$lld</value>%%"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "消耗最後的<keyword id=\"mana\">魔力</keyword>時，下次<keyword id=\"burn\">燃燒</keyword>攻擊的傷害提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.warlock_burn_t2_2.name": {
      "comment": "ContentManifest/talents.tsv: warlock_burn_t2_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Seelen<keyword id=\"burn\">brand</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Soul <keyword id=\"burn\">Burn</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Quemadura</keyword> del alma"}},
        "fr": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Brûlure</keyword> d’âme"}},
        "ja": {"stringUnit": {"state": "translated", "value": "魂の<keyword id=\"burn\">炎上</keyword>"}},
        "ko": {"stringUnit": {"state": "translated", "value": "영혼 <keyword id=\"burn\">화상</keyword>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Queimadura</keyword> da Alma"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "靈魂<keyword id=\"burn\">燃燒</keyword>"}}
      }
    },
    "talents.warlock_burn_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: warlock_burn_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Brennende</keyword> Gegner erleiden <value id=\"quantity_1\">%1$lld</value>%% zusätzlichen Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Burning</keyword> enemies take <value id=\"quantity_1\">%1$lld</value>%% additional damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los enemigos con <keyword id=\"burn\">Quemadura</keyword> reciben un <value id=\"quantity_1\">%1$lld</value>%% de daño adicional"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les ennemis sous <keyword id=\"burn\">Brûlure</keyword> subissent <value id=\"quantity_1\">%1$lld</value>%% de dégâts supplémentaires"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">炎上</keyword>状態の敵が受けるダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">화상</keyword> 상태의 적이 받는 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Inimigos <keyword id=\"burn\">Em Chamas</keyword> recebem <value id=\"quantity_1\">%1$lld</value>%% mais dano"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">燃燒</keyword>中的敵人承受的傷害增加<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.warlock_burn_t3_1.name": {
