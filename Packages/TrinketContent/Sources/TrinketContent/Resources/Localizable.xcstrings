          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les attaques de <keyword id=\"leech\">Vol de vie</keyword> gagnent +<value id=\"quantity_1\">%1$lld</value>%% de chances de coup critique contre les ennemis sous <keyword id=\"bleed\">Saignement</keyword>"
