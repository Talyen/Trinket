        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurer de la <keyword id=\"health\">Santé</keyword> réduit de <value id=\"quantity_1\">%1$lld</value>%% les prochains dégâts reçus par cet allié"
          }
