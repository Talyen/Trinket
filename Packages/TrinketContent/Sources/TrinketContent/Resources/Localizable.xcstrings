    "talents.risen_skeleton_physical_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_physical_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Kritische <keyword id=\"physical\">physische</keyword> Treffer verursachen <value id=\"quantity_1\">%1$lld</value> <keyword id=\"bleed\">Blutungs</keyword>schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">Physical</keyword> Critical Hits deal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"bleed\">Bleed</keyword> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los golpes críticos <keyword id=\"physical\">físicos</keyword> infligen <value id=\"quantity_1\">%1$lld</value> de daño de <keyword id=\"bleed\">Sangrado</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les coups critiques de type <keyword id=\"physical\">Physique</keyword> infligent <value id=\"quantity_1\">%1$lld</value> dégâts de <keyword id=\"bleed\">Saignement</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">物理</keyword>クリティカルヒットで<keyword id=\"bleed\">出血</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">물리</keyword> 치명타가 <keyword id=\"bleed\">출혈</keyword> 피해를 <value id=\"quantity_1\">%1$lld</value> 줌"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Golpes críticos <keyword id=\"physical\">Físicos</keyword> causam <value id=\"quantity_1\">%1$lld</value> de dano de <keyword id=\"bleed\">Sangramento</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">物理</keyword>暴擊造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"bleed\">流血</keyword>傷害"}}
      }
    },
    "talents.risen_skeleton_physical_t3_1.name": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_physical_t3_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Spaltende Knochen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Cleaving Bones"}},
        "es": {"stringUnit": {"state": "translated", "value": "Huesos hendedores"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Os tranchants"}},
        "ja": {"stringUnit": {"state": "translated", "value": "断ち割る骨"}},
        "ko": {"stringUnit": {"state": "translated", "value": "가르는 뼈"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ossos Cortantes"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "劈裂骨刃"}}
      }
    },
    "talents.risen_skeleton_physical_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_physical_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Solange du <keyword id=\"block\">Block</keyword> hast, erleide <value id=\"quantity_1\">%1$lld</value> weniger <keyword id=\"physical\">physischen</keyword> Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "While you have <keyword id=\"block\">Block</keyword>, take <value id=\"quantity_1\">%1$lld</value> less <keyword id=\"physical\">Physical</keyword> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Mientras tienes <keyword id=\"block\">Bloqueo</keyword>, recibes <value id=\"quantity_1\">%1$lld</value> menos de daño <keyword id=\"physical\">físico</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Tant que vous avez du <keyword id=\"block\">Blocage</keyword>, les dégâts de type <keyword id=\"physical\">Physique</keyword> subis sont réduits de <value id=\"quantity_1\">%1$lld</value>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">ブロック</keyword>がある間、受ける<keyword id=\"physical\">物理</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>減少"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">방어도</keyword>가 있으면 받는 <keyword id=\"physical\">물리</keyword> 피해 <value id=\"quantity_1\">%1$lld</value> 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Enquanto tiver <keyword id=\"block\">Bloqueio</keyword>, receba <value id=\"quantity_1\">%1$lld</value> de dano <keyword id=\"physical\">Físico</keyword> a menos"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "擁有<keyword id=\"block\">格擋</keyword>時，承受的<keyword id=\"physical\">物理</keyword>傷害降低<value id=\"quantity_1\">%1$lld</value>點"}}
      }
    },
    "talents.risen_skeleton_physical_t3_2.name": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_physical_t3_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Knochenrüstung"}},
        "en": {"stringUnit": {"state": "translated", "value": "Bone Armor"}},
        "es": {"stringUnit": {"state": "translated", "value": "Armadura de hueso"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Armure d’os"}},
        "ja": {"stringUnit": {"state": "translated", "value": "骨の鎧"}},
        "ko": {"stringUnit": {"state": "translated", "value": "뼈 갑옷"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Armadura de Ossos"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "骨甲"}}
      }
    },
    "talents.risen_skeleton_physical_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_physical_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Kritische <keyword id=\"physical\">physische</keyword> Treffer verursachen <value id=\"quantity_1\">%1$lld</value>%% mehr Schaden an <keyword id=\"poison\">vergifteten</keyword> Gegnern"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">Physical</keyword> Critical Hits deal <value id=\"quantity_1\">%1$lld</value>%% more damage to <keyword id=\"poison\">Poisoned</keyword> enemies"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los golpes críticos <keyword id=\"physical\">físicos</keyword> infligen un <value id=\"quantity_1\">%1$lld</value>%% más de daño a enemigos <keyword id=\"poison\">envenenados</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les coups critiques de type <keyword id=\"physical\">Physique</keyword> infligent <value id=\"quantity_1\">%1$lld</value>%% de dégâts en plus aux ennemis sous <keyword id=\"poison\">Poison</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">毒</keyword>状態の敵への<keyword id=\"physical\">物理</keyword>クリティカルヒットのダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">독</keyword> 상태의 적에게 <keyword id=\"physical\">물리</keyword> 치명타 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Golpes críticos <keyword id=\"physical\">Físicos</keyword> causam <value id=\"quantity_1\">%1$lld</value>%% mais dano a inimigos <keyword id=\"poison\">Envenenados</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">物理</keyword>暴擊對<keyword id=\"poison\">中毒</keyword>敵人的傷害提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.risen_skeleton_physical_t4_1.name": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_physical_t4_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Druckpunkt"}},
        "en": {"stringUnit": {"state": "translated", "value": "Pressure Point"}},
        "es": {"stringUnit": {"state": "translated", "value": "Punto de presión"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Point de pression"}},
        "ja": {"stringUnit": {"state": "translated", "value": "急所"}},
        "ko": {"stringUnit": {"state": "translated", "value": "급소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ponto de Pressão"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "要害"}}
      }
    },
    "talents.rogue_bleed_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: rogue_bleed_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">Blutung</keyword> durch kritische Treffer hält <value id=\"quantity_1\">%1$lld</value> zusätzlichen Zug an"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">Bleed</keyword> from Critical Hits lasts <value id=\"quantity_1\">%1$lld</value> extra turn"}},
        "es": {"stringUnit": {"state": "translated", "value": "El <keyword id=\"bleed\">Sangrado</keyword> de golpes críticos dura <value id=\"quantity_1\">%1$lld</value> turno adicional"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le <keyword id=\"bleed\">Saignement</keyword> infligé par des coups critiques dure <value id=\"quantity_1\">%1$lld</value> tour de plus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "クリティカルヒットによる<keyword id=\"bleed\">出血</keyword>がさらに<value id=\"quantity_1\">%1$lld</value>ターン持続"}},
        "ko": {"stringUnit": {"state": "translated", "value": "치명타로 적용된 <keyword id=\"bleed\">출혈</keyword> 지속 시간 <value id=\"quantity_1\">%1$lld</value>턴 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">Sangramento</keyword> de golpes críticos dura <value id=\"quantity_1\">%1$lld</value> turno adicional"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "暴擊造成的<keyword id=\"bleed\">流血</keyword>額外持續<value id=\"quantity_1\">%1$lld</value>回合"}}
      }
    },
