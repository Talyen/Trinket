    "talents.pixie_health_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: pixie_health_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überschüssige Heilung, die du gewährst, wird für ihren Empfänger zu <keyword id=\"block\">Block</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Excess healing you provide becomes <keyword id=\"block\">Block</keyword> for its recipient"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les soins excédentaires que vous prodiguez deviennent du <keyword id=\"block\">Blocage</keyword> pour leur bénéficiaire"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分が行う過剰回復を、回復対象の<keyword id=\"block\">ブロック</keyword>に変換"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자신이 제공한 초과 치유량을 치유 대상의 <keyword id=\"block\">방어도</keyword>로 전환"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自身施予的過量治療轉為受治者的<keyword id=\"block\">格擋</keyword>"
          }
        }
      }
    },
