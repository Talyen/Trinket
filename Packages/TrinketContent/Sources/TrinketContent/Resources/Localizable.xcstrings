        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques de type <keyword id=\"physical\">Physique</keyword> bénéficient de <keyword id=\"leech\">Vol de vie</keyword> sous la moitié de votre <keyword id=\"health\">Santé</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>が半分未満の間、<keyword id=\"physical\">物理</keyword>攻撃に<keyword id=\"leech\">吸収</keyword>を付与"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword>이 절반 미만이면 <keyword id=\"physical\">물리</keyword> 공격에 <keyword id=\"leech\">흡혈</keyword> 부여"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques <keyword id=\"physical\">Físicos</keyword> ganham <keyword id=\"leech\">Drenagem</keyword> enquanto você estiver abaixo de metade da <keyword id=\"health\">Vida</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "自身<keyword id=\"health\">生命值</keyword>低於一半時，<keyword id=\"physical\">物理</keyword>攻擊獲得<keyword id=\"leech\">吸血</keyword>"}}
      }
    },
