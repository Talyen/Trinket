    "homestead_nodes.crystalgarden.3.summary": {
      "comment": "ContentManifest/homestead_nodes.tsv: crystalGarden.3, summary",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ein leuchtender Garten, in dem seltene Gebilde durch stille Magie wachsen"}},
        "en": {"stringUnit": {"state": "translated", "value": "A luminous garden where rare formations grow around quiet magic"}},
        "es": {"stringUnit": {"state": "translated", "value": "Un jardín luminoso donde crecen formaciones raras en torno a una magia serena"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Un jardin lumineux où de rares formations poussent autour d’une magie paisible"}},
        "ja": {"stringUnit": {"state": "translated", "value": "静かな魔力の周りに希少な結晶が育つ、光り輝く庭"}},
        "ko": {"stringUnit": {"state": "translated", "value": "고요한 마법을 품고 희귀한 결정이 자라는 빛나는 정원"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Um jardim luminoso onde formações raras crescem em torno de uma magia serena"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "稀有晶體圍繞靜謐魔法生長的發光花園"}}
      }
    },
