        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">スタン</keyword>状態の敵に与えるダメージが2倍になる"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">기절</keyword> 상태의 적에게 두 배의 피해"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cause o dobro de dano a inimigos <keyword id=\"stun\">Atordoados</keyword>"}},
