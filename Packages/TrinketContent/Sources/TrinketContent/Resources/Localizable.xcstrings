        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allies with <keyword id=\"thorns\">Thorns</keyword> restore <value id=\"quantity_1\">%1$lld</value> additional <keyword id=\"health\">Health</keyword>"
          }
