    "talents.risen_skeleton_leech_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_leech_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebensraub verringert den Schaden des nächsten gegnerischen Treffers um <value id=\"quantity_1\">%1$lld</value>%%"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leeching causes the enemy's next hit to deal <value id=\"quantity_1\">%1$lld</value>%% less damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vol de vie réduit de <value id=\"quantity_1\">%1$lld</value>%% les dégâts du prochain coup de l’ennemi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "吸収すると、敵の次のヒットのダメージが<value id=\"quantity_1\">%1$lld</value>%%減少"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흡혈 시 적의 다음 적중 피해 <value id=\"quantity_1\">%1$lld</value>%% 감소"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "吸血後，敵人下次命中的傷害降低<value id=\"quantity_1\">%1$lld</value>%%"
          }
        }
      }
    },
