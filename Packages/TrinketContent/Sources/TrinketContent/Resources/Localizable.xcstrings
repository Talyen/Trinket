    "authored.675d5c34d8158e0e": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du <keyword id=\"dodge\">ausweichst</keyword>, ziehe und spiele sofort eine Karte\nBei einem kritischen Treffer wiederhole diesen Effekt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you <keyword id=\"dodge\">Dodge</keyword>, immediately draw and play a card\nIf it's a Critical Hit, repeat this effect"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lors d’une <keyword id=\"dodge\">Esquive</keyword>, piochez et jouez immédiatement une carte\nSi c’est un coup critique, répétez cet effet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"dodge\">回避</keyword>すると即座にカードを1枚引いて使う\nそれがクリティカルヒットなら、この効果を繰り返す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"dodge\">회피</keyword> 시 즉시 카드 한 장을 뽑아 사용\n치명타이면 이 효과 반복"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"dodge\">閃避</keyword>時，立刻抽一張牌並打出\n若造成暴擊，重複此效果"
          }
        }
      }
    },
    "authored.680eb778440a9065": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog+Accessory.swift: description",
      "extractionState": "manual",
      "localizations": {
