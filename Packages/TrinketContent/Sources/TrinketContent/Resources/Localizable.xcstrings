    "talents.phoenix_health_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: phoenix_health_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Überleben der <keyword id=\"deathsdoor\">Todesschwelle</keyword> stellt <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Gesundheit</keyword> beider Verbündeten wieder her"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Surviving <keyword id=\"deathsdoor\">Death's Door</keyword> restores <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Health</keyword> to both allies"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Survivre au <keyword id=\"deathsdoor\">Seuil de la mort</keyword> restaure <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Santé</keyword> aux deux alliés"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"deathsdoor\">死の淵</keyword>を生き延びると、味方2人の<keyword id=\"health\">体力</keyword>を<value id=\"quantity_1\">%1$lld</value>回復"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"deathsdoor\">죽음의 문턱</keyword>에서 살아남으면 두 아군의 <keyword id=\"health\">체력</keyword> <value id=\"quantity_1\">%1$lld</value> 회복"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從<keyword id=\"deathsdoor\">瀕死之門</keyword>生還時，為兩名友方恢復<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"health\">生命值</keyword>"
          }
        }
      }
    },
