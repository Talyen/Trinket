    "talents.pixie_health_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: pixie_health_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verbündete mit voller <keyword id=\"health\">Gesundheit</keyword> erhalten +<value id=\"quantity_1\">%1$lld</value>%% Chance auf <keyword id=\"dodge\">Ausweichen</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Allies at full <keyword id=\"health\">Health</keyword> gain +<value id=\"quantity_1\">%1$lld</value>%% <keyword id=\"dodge\">Dodge</keyword> chance"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los aliados con toda la <keyword id=\"health\">Salud</keyword> obtienen +<value id=\"quantity_1\">%1$lld</value>%% de probabilidad de <keyword id=\"dodge\">Evasión</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les alliés à pleine <keyword id=\"health\">Santé</keyword> gagnent +<value id=\"quantity_1\">%1$lld</value>%% de chances d’<keyword id=\"dodge\">Esquive</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>が満タンの味方の<keyword id=\"dodge\">回避</keyword>率が<value id=\"quantity_1\">%1$lld</value>%%上昇"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword>이 가득 찬 아군의 <keyword id=\"dodge\">회피</keyword> 확률 +<value id=\"quantity_1\">%1$lld</value>%%"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Aliados com <keyword id=\"health\">Vida</keyword> cheia ganham +<value id=\"quantity_1\">%1$lld</value>%% de chance de <keyword id=\"dodge\">Esquiva</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">生命值</keyword>全滿的友方<keyword id=\"dodge\">閃避</keyword>機率提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.pixie_health_t2_2.name": {
      "comment": "ContentManifest/talents.tsv: pixie_health_t2_2, name",
