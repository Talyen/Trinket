    "affixes.concussive.astral_description": {
      "comment": "ContentManifest/affixes.tsv: concussive, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erhöhe <keyword id=\"stun\">Betäubungs</keyword>schaden um <value id=\"quantity_1\">%1$lld</value>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Increase <keyword id=\"stun\">Stun</keyword> damage by <value id=\"quantity_1\">%1$lld</value>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Aumenta el daño de <keyword id=\"stun\">Aturdimiento</keyword> en <value id=\"quantity_1\">%1$lld</value>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Dégâts d’<keyword id=\"stun\">Étourdissement</keyword> augmentés de <value id=\"quantity_1\">%1$lld</value>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">スタン</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">기절</keyword> 피해 <value id=\"quantity_1\">%1$lld</value> 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Aumente o dano de <keyword id=\"stun\">Atordoamento</keyword> em <value id=\"quantity_1\">%1$lld</value>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">暈眩</keyword>傷害增加<value id=\"quantity_1\">%1$lld</value>點"}}
      }
    },
