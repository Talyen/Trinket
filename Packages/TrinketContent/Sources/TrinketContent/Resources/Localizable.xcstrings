    "authored.2700bf8d31da5a5b": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/InventoryItem+Compatibility.swift: canonical numeric compatibility description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erhöhe den <keyword id=\"physical\">physischen</keyword> Schaden deines Gefährten um <value id=\"quantity_1\">%1$lld</value>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Increase your Companion's <keyword id=\"physical\">Physical</keyword> damage by <value id=\"quantity_1\">%1$lld</value>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Aumenta el daño <keyword id=\"physical\">físico</keyword> de tu compañero en <value id=\"quantity_1\">%1$lld</value>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Augmente de <value id=\"quantity_1\">%1$lld</value> les dégâts de type <keyword id=\"physical\">Physique</keyword> de votre Compagnon"}},
        "ja": {"stringUnit": {"state": "translated", "value": "仲間の<keyword id=\"physical\">物理</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "동료의 <keyword id=\"physical\">물리</keyword> 피해 <value id=\"quantity_1\">%1$lld</value> 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Aumente o dano <keyword id=\"physical\">Físico</keyword> do seu Companheiro em <value id=\"quantity_1\">%1$lld</value>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "夥伴造成的<keyword id=\"physical\">物理</keyword>傷害提高<value id=\"quantity_1\">%1$lld</value>點"}}
      }
    },
