        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"stun\">暈眩</keyword>的敵人受到你的攻擊時，承受的傷害增加<value id=\"quantity_1\">%1$lld</value>%%"
          }
