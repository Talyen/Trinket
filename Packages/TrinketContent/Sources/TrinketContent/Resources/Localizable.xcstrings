      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ein erstes Feld, das stille Erde in verlässliche Vorräte verwandelt"}},
        "en": {"stringUnit": {"state": "translated", "value": "A first field that turns quiet earth into dependable stores"}},
        "es": {"stringUnit": {"state": "translated", "value": "Un primer campo que convierte la tierra tranquila en reservas fiables"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Un premier champ qui transforme la terre paisible en provisions fiables"}},
        "ja": {"stringUnit": {"state": "translated", "value": "静かな大地を頼もしい蓄えへと変える最初の畑"}},
        "ko": {"stringUnit": {"state": "translated", "value": "고요한 땅을 든든한 비축물로 바꾸는 첫 밭"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Um primeiro campo que transforma a terra tranquila em reservas confiáveis"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "將寧靜土地轉化為可靠儲備的第一片農田"}}
      }
    },
    "homestead_nodes.wheatfield.1.title": {
      "comment": "ContentManifest/homestead_nodes.tsv: wheatField.1, title",
