    "talents.warlock_leech_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: warlock_leech_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">Lebensraub</keyword> heilt auch durch Schaden, den gegnerischer <keyword id=\"block\">Block</keyword> absorbiert"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">Leech</keyword> also heals from damage absorbed by enemy <keyword id=\"block\">Block</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le <keyword id=\"leech\">Vol de vie</keyword> soigne aussi à partir des dégâts absorbés par le <keyword id=\"block\">Blocage</keyword> ennemi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "敵の<keyword id=\"block\">ブロック</keyword>が吸収したダメージからも<keyword id=\"leech\">吸収</keyword>で回復"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">흡혈</keyword>이 적의 <keyword id=\"block\">방어도</keyword>가 흡수한 피해로도 치유"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">吸血</keyword>也會從敵人<keyword id=\"block\">格擋</keyword>吸收的傷害中恢復生命值"
          }
        }
      }
    },
