    "homestead_nodes.alchemylab.1.summary": {
      "comment": "ContentManifest/homestead_nodes.tsv: alchemyLab.1, summary",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ein präzise eingerichteter Arbeitsplatz für Reagenzien, Tonika und Heilversuche"}},
        "en": {"stringUnit": {"state": "translated", "value": "A precise workspace for reagents, tonics, and restorative experiments"}},
        "es": {"stringUnit": {"state": "translated", "value": "Un espacio de precisión para reactivos, tónicos y experimentos restauradores"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Un espace précis pour les réactifs, les toniques et les expériences réparatrices"}},
        "ja": {"stringUnit": {"state": "translated", "value": "試薬や強壮薬、回復薬の実験に適した精密な作業場"}},
        "ko": {"stringUnit": {"state": "translated", "value": "시약, 강장제, 회복 실험을 위한 정밀 작업 공간"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Um espaço de trabalho preciso para reagentes, tônicos e experimentos restauradores"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "適合試劑、補藥與恢復實驗的精密工作空間"}}
      }
    },
