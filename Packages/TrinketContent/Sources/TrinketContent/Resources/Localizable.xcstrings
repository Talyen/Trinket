    "affixes.unmaking.astral_description": {
      "comment": "ContentManifest/affixes.tsv: unmaking, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"purge\">Entzaubere</keyword> alle Verstärkungen des Gegners, wenn du kritisch triffst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"purge\">Purge</keyword> all buffs from the enemy when you Critically Hit"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"purge\">Dissipation</keyword> de tous les bonus de l’ennemi lors d’un coup critique"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリティカルヒット時に敵の強化効果をすべて<keyword id=\"purge\">強化解除</keyword>"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "치명타 적중 시 <keyword id=\"purge\">강화 해제</keyword>로 적의 모든 강화 효과 제거"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暴擊命中時，<keyword id=\"purge\">驅散</keyword>敵人所有增益效果"
          }
        }
      }
    },
