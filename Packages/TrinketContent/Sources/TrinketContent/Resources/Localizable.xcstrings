    "talents.panther_leech_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: panther_leech_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">Lebensraub</keyword> stellt gegen <keyword id=\"bleed\">blutende</keyword> Gegner <value id=\"quantity_1\">%1$lld</value>%% mehr <keyword id=\"health\">Gesundheit</keyword> wieder her"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">Leech</keyword> restores <value id=\"quantity_1\">%1$lld</value>%% more <keyword id=\"health\">Health</keyword> against <keyword id=\"bleed\">Bleeding</keyword> enemies"}},
        "es": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">Absorción</keyword> restaura un <value id=\"quantity_1\">%1$lld</value>%% más de <keyword id=\"health\">Salud</keyword> contra enemigos con <keyword id=\"bleed\">Sangrado</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le <keyword id=\"leech\">Vol de vie</keyword> restaure <value id=\"quantity_1\">%1$lld</value>%% de <keyword id=\"health\">Santé</keyword> en plus contre les ennemis sous <keyword id=\"bleed\">Saignement</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">出血</keyword>状態の敵に対する<keyword id=\"leech\">吸収</keyword>の<keyword id=\"health\">体力</keyword>回復量が<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">출혈</keyword> 상태의 적을 상대로 <keyword id=\"leech\">흡혈</keyword>의 <keyword id=\"health\">체력</keyword> 회복량 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">Drenagem</keyword> restaura <value id=\"quantity_1\">%1$lld</value>%% mais <keyword id=\"health\">Vida</keyword> contra inimigos com <keyword id=\"bleed\">Sangramento</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "對<keyword id=\"bleed\">流血</keyword>的敵人，<keyword id=\"leech\">吸血</keyword>恢復的<keyword id=\"health\">生命值</keyword>增加<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
