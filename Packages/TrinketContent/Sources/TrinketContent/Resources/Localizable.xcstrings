    "talents.fox_stun_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: fox_stun_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kritische Treffer gegen <keyword id=\"stun\">betäubte</keyword> Gegner stehlen <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Gold</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Critical Hits against <keyword id=\"stun\">Stunned</keyword> enemies steal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Gold</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les coups critiques contre les ennemis sous <keyword id=\"stun\">Étourdissement</keyword> volent <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Or</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"stun\">スタン</keyword>状態の敵へのクリティカルヒットで<keyword id=\"gold\">ゴールド</keyword>を<value id=\"quantity_1\">%1$lld</value>盗む"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"stun\">기절</keyword> 상태의 적에게 치명타 적중 시 <keyword id=\"gold\">골드</keyword> <value id=\"quantity_1\">%1$lld</value> 훔치기"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對<keyword id=\"stun\">暈眩</keyword>敵人暴擊時，偷取<value id=\"quantity_1\">%1$lld</value><keyword id=\"gold\">金幣</keyword>"
          }
