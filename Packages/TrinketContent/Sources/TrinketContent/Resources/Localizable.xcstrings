    "talents.shield_scarab_stun_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: shield_scarab_stun_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Betäuben eines Gegners entfernt seinen gesamten <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Stunning an enemy removes all their <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Aturdir a un enemigo elimina todo su <keyword id=\"block\">Bloqueo</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Étourdir un ennemi retire tout son <keyword id=\"block\">Blocage</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "敵をスタン状態にすると、その敵の<keyword id=\"block\">ブロック</keyword>をすべて除去"}},
        "ko": {"stringUnit": {"state": "translated", "value": "적을 기절시키면 해당 적의 모든 <keyword id=\"block\">방어도</keyword> 제거"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Atordoar um inimigo remove todo o <keyword id=\"block\">Bloqueio</keyword> dele"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "使敵人暈眩時，移除其所有<keyword id=\"block\">格擋</keyword>"}}
      }
    },
