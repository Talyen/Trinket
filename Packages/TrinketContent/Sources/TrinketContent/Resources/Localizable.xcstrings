    "authored.da79c9f484e5e210": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">Brand</keyword>schaden verursacht mit <value id=\"quantity_1\">%1$lld</value>%% Chance <value id=\"quantity_2\">%2$lld</value> <keyword id=\"bleed\">Blutungs</keyword>schaden und umgekehrt\n<keyword id=\"burn\">Brand</keyword>- und <keyword id=\"bleed\">Blutungs</keyword>schaden erhalten <keyword id=\"leech\">Lebensraub</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dealing <keyword id=\"burn\">Burn</keyword> damage has a <value id=\"quantity_1\">%1$lld</value>%% chance to deal <value id=\"quantity_2\">%2$lld</value> <keyword id=\"bleed\">Bleed</keyword> damage, and vice versa\n<keyword id=\"burn\">Burn</keyword> and <keyword id=\"bleed\">Bleed</keyword> damage gain <keyword id=\"leech\">Leech</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dégâts de <keyword id=\"burn\">Brûlure</keyword> ont <value id=\"quantity_1\">%1$lld</value>%% de chances d’infliger <value id=\"quantity_2\">%2$lld</value> dégâts de <keyword id=\"bleed\">Saignement</keyword>, et inversement\nLes dégâts de <keyword id=\"burn\">Brûlure</keyword> et de <keyword id=\"bleed\">Saignement</keyword> bénéficient de <keyword id=\"leech\">Vol de vie</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">炎上</keyword>ダメージを与えると、<value id=\"quantity_1\">%1$lld</value>%%の確率で<keyword id=\"bleed\">出血</keyword>ダメージを<value id=\"quantity_2\">%2$lld</value>与える（逆の場合も同様）\n<keyword id=\"burn\">炎上</keyword>と<keyword id=\"bleed\">出血</keyword>ダメージに<keyword id=\"leech\">吸収</keyword>を付与"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">화상</keyword> 피해를 주면 <value id=\"quantity_1\">%1$lld</value>%% 확률로 <keyword id=\"bleed\">출혈</keyword> 피해 <value id=\"quantity_2\">%2$lld</value>. 반대의 경우도 적용\n<keyword id=\"burn\">화상</keyword> 및 <keyword id=\"bleed\">출혈</keyword> 피해에 <keyword id=\"leech\">흡혈</keyword> 부여"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "造成<keyword id=\"burn\">燃燒</keyword>傷害時，有<value id=\"quantity_1\">%1$lld</value>%%機率造成<value id=\"quantity_2\">%2$lld</value>點<keyword id=\"bleed\">流血</keyword>傷害，反之亦然\n<keyword id=\"burn\">燃燒</keyword>與<keyword id=\"bleed\">流血</keyword>傷害獲得<keyword id=\"leech\">吸血</keyword>"
          }
        }
      }
    },
