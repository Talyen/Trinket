    "talents.library_owl_health_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: library_owl_health_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Wiederherstellen von <keyword id=\"health\">Gesundheit</keyword> oder <keyword id=\"mana\">Mana</keyword> lässt dich mit <value id=\"quantity_1\">%1$lld</value>%% Chance eine Karte ziehen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Restoring <keyword id=\"health\">Health</keyword> or <keyword id=\"mana\">Mana</keyword> has a <value id=\"quantity_1\">%1$lld</value>%% chance to draw a card"}},
        "es": {"stringUnit": {"state": "translated", "value": "Restaurar <keyword id=\"health\">Salud</keyword> o <keyword id=\"mana\">Maná</keyword> tiene un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de hacer que robes una carta"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Restaurer de la <keyword id=\"health\">Santé</keyword> ou du <keyword id=\"mana\">Mana</keyword> a <value id=\"quantity_1\">%1$lld</value>%% de chances de faire piocher une carte"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>か<keyword id=\"mana\">マナ</keyword>を回復すると<value id=\"quantity_1\">%1$lld</value>%%の確率でカードを1枚引く"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword> 또는 <keyword id=\"mana\">마나</keyword> 회복 시 <value id=\"quantity_1\">%1$lld</value>%% 확률로 카드 한 장 뽑기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Restaurar <keyword id=\"health\">Vida</keyword> ou <keyword id=\"mana\">Mana</keyword> tem <value id=\"quantity_1\">%1$lld</value>%% de chance de comprar uma carta"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "恢復<keyword id=\"health\">生命值</keyword>或<keyword id=\"mana\">魔力</keyword>時，有<value id=\"quantity_1\">%1$lld</value>%%機率抽一張牌"}}
      }
    },
