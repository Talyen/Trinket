    "authored.168295b2ac4c0f17": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Abilities/AbilityCatalog+Basic.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verursache zweimal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"freeze\">Frost</keyword>schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"freeze\">Freeze</keyword> damage, twice"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Infligez <value id=\"quantity_1\">%1$lld</value> dégâts de <keyword id=\"freeze\">Gel</keyword>, deux fois"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"freeze\">凍結</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>ずつ2回与える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"freeze\">빙결</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>, 두 번"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"freeze\">冰凍</keyword>傷害兩次"
          }
        }
      }
    },
    "authored.16e8ca25942c1fef": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Encounters/Mystery/MysteryEventPool+Events.swift: narrative",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine verlassene Jagdhütte birgt „%1$@“, und draußen liegt gespaltenes Holz um „%2$@“"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A deserted lodge shelters “%1$@”, and split logs surround “%2$@” outside"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pavillon désert abrite « %1$@ », tandis que des bûches fendues entourent « %2$@ » à l’extérieur"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無人の山小屋が「%1$@」をかくまい、外では割れた薪が「%2$@」を囲んでいる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버려진 오두막이 품은 것은 ‘%1$@’, 바깥쪽 쪼갠 통나무는 ‘%2$@’ 주위를 둘러쌉니다"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "廢棄小屋庇護著「%1$@」，屋外劈開的木頭圍繞著「%2$@」"
          }
        }
      }
    },
