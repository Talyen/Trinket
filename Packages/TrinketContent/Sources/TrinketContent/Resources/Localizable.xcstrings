    "talents.fox_stun_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: fox_stun_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Kritische <keyword id=\"stun\">Betäubungs</keyword>-Treffer ignorieren gegnerischen <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">Stun</keyword> Critical Hits ignore enemy <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los golpes críticos de <keyword id=\"stun\">Aturdimiento</keyword> ignoran el <keyword id=\"block\">Bloqueo</keyword> del enemigo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les coups critiques d’<keyword id=\"stun\">Étourdissement</keyword> ignorent le <keyword id=\"block\">Blocage</keyword> ennemi"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">スタン</keyword>クリティカルヒットが敵の<keyword id=\"block\">ブロック</keyword>を無視"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">기절</keyword> 치명타가 적의 <keyword id=\"block\">방어도</keyword> 무시"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Golpes críticos de <keyword id=\"stun\">Atordoamento</keyword> ignoram o <keyword id=\"block\">Bloqueio</keyword> inimigo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">暈眩</keyword>暴擊無視敵人<keyword id=\"block\">格擋</keyword>"}}
      }
    },
