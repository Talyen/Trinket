    "talents.knight_block_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: knight_block_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit <keyword id=\"block\">Block</keyword> erleidest du halben <keyword id=\"burn\">Brand</keyword>-, <keyword id=\"poison\">Gift</keyword>- und <keyword id=\"bleed\">Blutungs</keyword>schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With <keyword id=\"block\">Block</keyword>, take half <keyword id=\"burn\">Burn</keyword>, <keyword id=\"poison\">Poison</keyword>, and <keyword id=\"bleed\">Bleed</keyword> damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec du <keyword id=\"block\">Blocage</keyword>, les dégâts de <keyword id=\"burn\">Brûlure</keyword>, de <keyword id=\"poison\">Poison</keyword> et de <keyword id=\"bleed\">Saignement</keyword> subis sont réduits de moitié"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"block\">ブロック</keyword>がある間、受ける<keyword id=\"burn\">炎上</keyword>、<keyword id=\"poison\">毒</keyword>、<keyword id=\"bleed\">出血</keyword>ダメージが半減"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"block\">방어도</keyword>가 있으면 받는 <keyword id=\"burn\">화상</keyword>, <keyword id=\"poison\">독</keyword>, <keyword id=\"bleed\">출혈</keyword> 피해가 절반으로 감소"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擁有<keyword id=\"block\">格擋</keyword>時，承受的<keyword id=\"burn\">燃燒</keyword>、<keyword id=\"poison\">中毒</keyword>與<keyword id=\"bleed\">流血</keyword>傷害減半"
          }
        }
      }
    },
