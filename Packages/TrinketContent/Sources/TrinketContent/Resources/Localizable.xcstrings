    "talents.ranger_poison_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: ranger_poison_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Gefährtenangriffe verursachen <value id=\"quantity_1\">%1$lld</value>%% mehr Schaden an <keyword id=\"poison\">vergifteten</keyword> Gegnern"}},
        "en": {"stringUnit": {"state": "translated", "value": "Companion attacks deal <value id=\"quantity_1\">%1$lld</value>%% more damage to <keyword id=\"poison\">Poisoned</keyword> enemies"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques del compañero infligen un <value id=\"quantity_1\">%1$lld</value>%% más de daño a enemigos <keyword id=\"poison\">envenenados</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques du Compagnon infligent <value id=\"quantity_1\">%1$lld</value>%% de dégâts en plus aux ennemis sous <keyword id=\"poison\">Poison</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">毒</keyword>状態の敵への仲間の攻撃ダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">독</keyword> 상태의 적에게 동료 공격의 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques do Companheiro causam <value id=\"quantity_1\">%1$lld</value>%% mais dano a inimigos <keyword id=\"poison\">Envenenados</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "夥伴對<keyword id=\"poison\">中毒</keyword>敵人的攻擊傷害提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.ranger_poison_t2_1.name": {
      "comment": "ContentManifest/talents.tsv: ranger_poison_t2_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Die Schwachen jagen"}},
