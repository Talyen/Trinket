    "talents.wolf_physical_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: wolf_physical_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dein erster <keyword id=\"physical\">physischer</keyword> Angriff in jedem Kampf verursacht doppelten Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your first <keyword id=\"physical\">Physical</keyword> attack each combat deals double damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu primer ataque <keyword id=\"physical\">físico</keyword> de cada combate inflige el doble de daño"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre première attaque de type <keyword id=\"physical\">Physique</keyword> de chaque combat inflige le double de dégâts"}},
        "ja": {"stringUnit": {"state": "translated", "value": "各戦闘で最初の<keyword id=\"physical\">物理</keyword>攻撃のダメージが2倍になる"}},
        "ko": {"stringUnit": {"state": "translated", "value": "매 전투 첫 <keyword id=\"physical\">물리</keyword> 공격이 두 배의 피해"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seu primeiro ataque <keyword id=\"physical\">Físico</keyword> de cada combate causa o dobro de dano"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每場戰鬥首次<keyword id=\"physical\">物理</keyword>攻擊造成雙倍傷害"}}
      }
    },
    "talents.wolf_physical_t4_1.name": {
