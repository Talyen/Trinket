    "authored.7765b5fc60c36522": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Encounters/Mystery/MysteryEventPool+Events.swift: narrative",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Lose Seiten enthüllen „%1$@“, während ein Kristallsiegel „%2$@“ gefangen hält"}},
        "en": {"stringUnit": {"state": "translated", "value": "Loose pages reveal “%1$@” while a crystal seal imprisons “%2$@”"}},
        "es": {"stringUnit": {"state": "translated", "value": "Páginas sueltas revelan «%1$@» mientras un sello de cristal aprisiona «%2$@»"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Des pages éparses révèlent « %1$@ », tandis qu’un sceau de cristal emprisonne « %2$@ »"}},
        "ja": {"stringUnit": {"state": "translated", "value": "散らばった頁が「%1$@」を明かし、水晶の封印が「%2$@」を閉じ込めている"}},
        "ko": {"stringUnit": {"state": "translated", "value": "흩어진 낱장이 드러낸 것은 ‘%1$@’, 수정 봉인에 갇힌 것은 ‘%2$@’입니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Páginas soltas revelam “%1$@” enquanto um selo de cristal aprisiona “%2$@”"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "散落的書頁顯露出「%1$@」，水晶封印囚禁著「%2$@」"}}
      }
    },
