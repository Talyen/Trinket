    "authored.314177feec6f4a17": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Encounters/Mystery/MysteryEventPool+Events.swift: narrative",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Räucherkräuter umgeben „%1$@“, während ein Weihrauchfass inmitten von Pilgermünzen „%2$@“ birgt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Incense herbs surround “%1$@” while a censer shelters “%2$@” among pilgrims’ coins"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des herbes à encens entourent « %1$@ », tandis qu’un encensoir abrite « %2$@ » parmi les pièces des pèlerins"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "香草が「%1$@」を囲み、香炉が巡礼者の硬貨の中で「%2$@」を包んでいる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "향을 내는 약초가 ‘%1$@’ 주위를 둘러싸고, 순례자의 동전 사이 향로가 품은 것은 ‘%2$@’입니다"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "香草圍繞著「%1$@」，香爐在朝聖者的錢幣間庇護著「%2$@」"
          }
        }
      }
    },
