    "talents.ranger_poison_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: ranger_poison_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"poison\">Gift</keyword> verursacht einmalig doppelten Schaden, nachdem ein <keyword id=\"poison\">vergifteter</keyword> Gegner deinem Gefährten geschadet hat"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"poison\">Poison</keyword> deals double damage once after a <keyword id=\"poison\">Poisoned</keyword> enemy hurts your Companion"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le <keyword id=\"poison\">Poison</keyword> inflige une fois le double de dégâts après qu’un ennemi sous <keyword id=\"poison\">Poison</keyword> blesse votre Compagnon"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"poison\">毒</keyword>状態の敵が仲間を傷つけると、その後1回の<keyword id=\"poison\">毒</keyword>ダメージが2倍になる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"poison\">독</keyword> 상태의 적이 동료에게 피해를 주면 다음 <keyword id=\"poison\">독</keyword> 피해가 한 번 두 배"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"poison\">中毒</keyword>的敵人傷害夥伴後，下一次<keyword id=\"poison\">中毒</keyword>傷害加倍"
          }
        }
      }
    },
