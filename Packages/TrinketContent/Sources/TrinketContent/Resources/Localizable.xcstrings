        "fr": {"stringUnit": {"state": "translated", "value": "Voler de l’<keyword id=\"gold\">Or</keyword> octroie +<value id=\"quantity_1\">%1$lld</value>%% de chances de coup critique à votre prochaine attaque"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"gold\">ゴールド</keyword>を盗むと、次の攻撃のクリティカル率が<value id=\"quantity_1\">%1$lld</value>%%上昇"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"gold\">골드</keyword>를 훔치면 다음 공격의 치명타 확률 +<value id=\"quantity_1\">%1$lld</value>%%"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Roubar <keyword id=\"gold\">Ouro</keyword> concede +<value id=\"quantity_1\">%1$lld</value>%% de chance de golpe crítico no seu próximo ataque"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "偷取<keyword id=\"gold\">金幣</keyword>後，下次攻擊的暴擊機率提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.fox_gold_t3_1.name": {
      "comment": "ContentManifest/talents.tsv: fox_gold_t3_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Meisterdieb"}},
        "en": {"stringUnit": {"state": "translated", "value": "Master Thief"}},
        "es": {"stringUnit": {"state": "translated", "value": "Ladrón maestro"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Maître voleur"}},
        "ja": {"stringUnit": {"state": "translated", "value": "大盗賊"}},
        "ko": {"stringUnit": {"state": "translated", "value": "대도"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Mestre Ladrão"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "神偷"}}
