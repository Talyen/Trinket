    "authored.0808ca57dd2cdb14": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Encounters/Mystery/MysteryEventPool+Events.swift: narrative",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Eine Eisenader legt „%1$@“ frei, und umgestürzte Stämme halten in der Nähe „%2$@“ fest"}},
        "en": {"stringUnit": {"state": "translated", "value": "An iron seam reveals “%1$@”, and fallen timber traps “%2$@” nearby"}},
        "es": {"stringUnit": {"state": "translated", "value": "Una veta de hierro revela «%1$@», y un tronco caído atrapa «%2$@» cerca"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Un filon de fer révèle « %1$@ », tandis que du bois tombé emprisonne « %2$@ » à proximité"}},
        "ja": {"stringUnit": {"state": "translated", "value": "鉄の鉱脈から「%1$@」が現れ、近くでは倒木が「%2$@」を閉じ込めている"}},
        "ko": {"stringUnit": {"state": "translated", "value": "철광맥이 드러낸 것은 ‘%1$@’, 근처 쓰러진 나무에 갇힌 것은 ‘%2$@’입니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Um veio de ferro revela “%1$@”, e troncos caídos prendem “%2$@” por perto"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "鐵礦脈顯露出「%1$@」，附近倒下的木材困住了「%2$@」"}}
      }
    },
