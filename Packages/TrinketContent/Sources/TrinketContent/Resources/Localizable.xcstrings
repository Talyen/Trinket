    "homestead_nodes.pasture.2.bonus_description": {
      "comment": "ContentManifest/homestead_nodes.tsv: pasture.2, bonus_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erleide <value id=\"quantity_1\">%1$lld</value>%% weniger <keyword id=\"physical\">physischen</keyword> Schaden\nProduziere <value id=\"quantity_2\">%2$lld</value> Fell pro Tag"}},
        "en": {"stringUnit": {"state": "translated", "value": "Take <value id=\"quantity_1\">%1$lld</value>%% less <keyword id=\"physical\">Physical</keyword> damage\nProduce <value id=\"quantity_2\">%2$lld</value> Hide per Day"}},
        "es": {"stringUnit": {"state": "translated", "value": "Recibe un <value id=\"quantity_1\">%1$lld</value>%% menos de daño <keyword id=\"physical\">físico</keyword>\nProduce <value id=\"quantity_2\">%2$lld</value> de piel al día"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Dégâts de type <keyword id=\"physical\">Physique</keyword> subis réduits de <value id=\"quantity_1\">%1$lld</value>%%\nPeaux produites par jour : <value id=\"quantity_2\">%2$lld</value>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "受ける<keyword id=\"physical\">物理</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%減少\n1日に皮を<value id=\"quantity_2\">%2$lld</value>生産"}},
        "ko": {"stringUnit": {"state": "translated", "value": "받는 <keyword id=\"physical\">물리</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>%% 감소\n하루에 가죽 <value id=\"quantity_2\">%2$lld</value>개 생산"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Receba <value id=\"quantity_1\">%1$lld</value>%% menos dano <keyword id=\"physical\">Físico</keyword>\nProduza <value id=\"quantity_2\">%2$lld</value> de Couro por Dia"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "承受的<keyword id=\"physical\">物理</keyword>傷害降低<value id=\"quantity_1\">%1$lld</value>%%\n每天生產<value id=\"quantity_2\">%2$lld</value>獸皮"}}
      }
    },
