    "affixes.obsidian_hammer.astral_description": {
      "comment": "ContentManifest/affixes.tsv: obsidian_hammer, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">Physischer</keyword> Schaden baut ebenso viel <keyword id=\"stun\">Betäubung</keyword> auf"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">Physical</keyword> damage builds an equal amount of <keyword id=\"stun\">Stun</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "El daño <keyword id=\"physical\">físico</keyword> acumula una cantidad igual de <keyword id=\"stun\">Aturdimiento</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les dégâts de type <keyword id=\"physical\">Physique</keyword> accumulent autant d’<keyword id=\"stun\">Étourdissement</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">物理</keyword>ダメージと同量の<keyword id=\"stun\">スタン</keyword>を蓄積"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">물리</keyword> 피해와 같은 양의 <keyword id=\"stun\">기절</keyword> 축적"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Dano <keyword id=\"physical\">Físico</keyword> acumula uma quantidade igual de <keyword id=\"stun\">Atordoamento</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">物理</keyword>傷害累積等量<keyword id=\"stun\">暈眩</keyword>"}}
      }
    },
