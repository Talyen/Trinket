    "talents.bear_stun_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: bear_stun_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter halber <keyword id=\"health\">Gesundheit</keyword> steigt dein <keyword id=\"stun\">Betäubungs</keyword>aufbau um <value id=\"quantity_1\">%1$lld</value>%%"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Below half <keyword id=\"health\">Health</keyword>, your <keyword id=\"stun\">Stun</keyword> build-up increases by <value id=\"quantity_1\">%1$lld</value>%%"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sous la moitié de votre <keyword id=\"health\">Santé</keyword>, votre accumulation d’<keyword id=\"stun\">Étourdissement</keyword> augmente de <value id=\"quantity_1\">%1$lld</value>%%"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">体力</keyword>が半分未満なら、自分の<keyword id=\"stun\">スタン</keyword>蓄積量が<value id=\"quantity_1\">%1$lld</value>%%増加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">체력</keyword>이 절반 미만이면 내 <keyword id=\"stun\">기절</keyword> 축적량 <value id=\"quantity_1\">%1$lld</value>%% 증가"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">生命值</keyword>低於一半時，自身<keyword id=\"stun\">暈眩</keyword>累積量增加<value id=\"quantity_1\">%1$lld</value>%%"
          }
        }
      }
    },
