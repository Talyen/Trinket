    "affixes.blur.astral_description": {
      "comment": "ContentManifest/affixes.tsv: blur, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte <value id=\"quantity_1\">%1$lld</value>%% Chance auf <keyword id=\"dodge\">Ausweichen</keyword>, solange du unter <value id=\"quantity_2\">%2$lld</value>%% <keyword id=\"health\">Gesundheit</keyword> bist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gain <value id=\"quantity_1\">%1$lld</value>%% <keyword id=\"dodge\">Dodge</keyword> chance while below <value id=\"quantity_2\">%2$lld</value>%% <keyword id=\"health\">Health</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagnez <value id=\"quantity_1\">%1$lld</value>%% de chances d’<keyword id=\"dodge\">Esquive</keyword> sous <value id=\"quantity_2\">%2$lld</value>%% de <keyword id=\"health\">Santé</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">体力</keyword>が<value id=\"quantity_2\">%2$lld</value>%%未満の間、<keyword id=\"dodge\">回避</keyword>率が<value id=\"quantity_1\">%1$lld</value>%%上昇"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">체력</keyword>이 <value id=\"quantity_2\">%2$lld</value>%% 미만이면 <keyword id=\"dodge\">회피</keyword> 확률 <value id=\"quantity_1\">%1$lld</value>%% 증가"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">生命值</keyword>低於<value id=\"quantity_2\">%2$lld</value>%%時，<keyword id=\"dodge\">閃避</keyword>機率提高<value id=\"quantity_1\">%1$lld</value>%%"
          }
        }
      }
    },
