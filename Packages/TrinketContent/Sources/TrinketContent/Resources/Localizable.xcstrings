        "es": {"stringUnit": {"state": "translated", "value": "Obtén +<value id=\"quantity_1\">%1$lld</value>%% de probabilidad de <keyword id=\"dodge\">Evasión</keyword> contra enemigos con <keyword id=\"bleed\">Sangrado</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Gagnez +<value id=\"quantity_1\">%1$lld</value>%% de chances d’<keyword id=\"dodge\">Esquive</keyword> contre les ennemis sous <keyword id=\"bleed\">Saignement</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">出血</keyword>状態の敵に対する<keyword id=\"dodge\">回避</keyword>率が<value id=\"quantity_1\">%1$lld</value>%%上昇"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">출혈</keyword> 상태의 적을 상대로 <keyword id=\"dodge\">회피</keyword> 확률 +<value id=\"quantity_1\">%1$lld</value>%%"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ganhe +<value id=\"quantity_1\">%1$lld</value>%% de chance de <keyword id=\"dodge\">Esquiva</keyword> contra inimigos com <keyword id=\"bleed\">Sangramento</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "對<keyword id=\"bleed\">流血</keyword>敵人的<keyword id=\"dodge\">閃避</keyword>機率提高<value id=\"quantity_1\">%1$lld</value>%%"}}
