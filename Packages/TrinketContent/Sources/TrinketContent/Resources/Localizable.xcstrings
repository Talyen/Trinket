    "talents.golden_retriever_block_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: golden_retriever_block_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"dodge\">Weiche</keyword> dem ersten gegnerischen Angriff in jedem Kampf aus, ohne <keyword id=\"block\">Block</keyword> zu verbrauchen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"dodge\">Dodge</keyword> the first enemy attack each combat without spending <keyword id=\"block\">Block</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"dodge\">Esquive</keyword> de la première attaque ennemie de chaque combat sans dépenser de <keyword id=\"block\">Blocage</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各戦闘で最初の敵の攻撃を、<keyword id=\"block\">ブロック</keyword>を消費せずに<keyword id=\"dodge\">回避</keyword>"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매 전투 적의 첫 공격을 <keyword id=\"block\">방어도</keyword> 소모 없이 <keyword id=\"dodge\">회피</keyword>"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每場戰鬥<keyword id=\"dodge\">閃避</keyword>敵人首次攻擊，且不消耗<keyword id=\"block\">格擋</keyword>"
          }
        }
      }
    },
