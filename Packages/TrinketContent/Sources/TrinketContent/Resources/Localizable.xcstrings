    "talents.wolf_dodge_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: wolf_dodge_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ausweichen gewährt dem nächsten Angriff deines Verbündeten +<value id=\"quantity_1\">%1$lld</value>%% Chance auf kritische Treffer"}},
        "en": {"stringUnit": {"state": "translated", "value": "Dodging gives your ally's next attack +<value id=\"quantity_1\">%1$lld</value>%% Critical Hit chance"}},
        "es": {"stringUnit": {"state": "translated", "value": "Esquivar otorga al siguiente ataque de tu aliado +<value id=\"quantity_1\">%1$lld</value>%% de probabilidad de golpe crítico"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Une esquive octroie +<value id=\"quantity_1\">%1$lld</value>%% de chances de coup critique à la prochaine attaque de votre allié"}},
        "ja": {"stringUnit": {"state": "translated", "value": "回避すると、味方の次の攻撃のクリティカル率が<value id=\"quantity_1\">%1$lld</value>%%上昇"}},
        "ko": {"stringUnit": {"state": "translated", "value": "회피 시 아군의 다음 공격 치명타 확률 +<value id=\"quantity_1\">%1$lld</value>%%"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Esquivar concede +<value id=\"quantity_1\">%1$lld</value>%% de chance de golpe crítico ao próximo ataque do seu aliado"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "閃避後，友方下次攻擊的暴擊機率提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
