    "talents.panther_dodge_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: panther_dodge_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausweichen lässt dich mit <value id=\"quantity_1\">%1$lld</value>%% Chance eine Karte ziehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodging has a <value id=\"quantity_1\">%1$lld</value>%% chance to draw a card"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une esquive a <value id=\"quantity_1\">%1$lld</value>%% de chances de faire piocher une carte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
