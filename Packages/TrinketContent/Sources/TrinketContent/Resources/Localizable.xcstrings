    "talents.fox_stun_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: fox_stun_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn <keyword id=\"stun\">Betäubung</keyword> endet, verursache <value id=\"quantity_1\">%1$lld</value> <keyword id=\"poison\">Gift</keyword>schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When <keyword id=\"stun\">Stun</keyword> ends, deal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"poison\">Poison</keyword> damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À la fin de l’<keyword id=\"stun\">Étourdissement</keyword>, infligez <value id=\"quantity_1\">%1$lld</value> dégâts de <keyword id=\"poison\">Poison</keyword>"
