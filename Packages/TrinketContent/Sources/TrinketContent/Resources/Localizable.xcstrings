    "talents.warlock_burn_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: warlock_burn_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ausgeben deines letzten <keyword id=\"mana\">Mana</keyword> erhöht den Schaden deines nächsten <keyword id=\"burn\">Brand</keyword>-Angriffs um <value id=\"quantity_1\">%1$lld</value>%%"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spending your last <keyword id=\"mana\">Mana</keyword> increases your next <keyword id=\"burn\">Burn</keyword> attack’s damage by <value id=\"quantity_1\">%1$lld</value>%%"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dépenser votre dernier <keyword id=\"mana\">Mana</keyword> augmente de <value id=\"quantity_1\">%1$lld</value>%% les dégâts de votre prochaine attaque de <keyword id=\"burn\">Brûlure</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後の<keyword id=\"mana\">マナ</keyword>を消費すると、次の<keyword id=\"burn\">炎上</keyword>攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 <keyword id=\"mana\">마나</keyword> 소모 시 다음 <keyword id=\"burn\">화상</keyword> 공격의 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "消耗最後的<keyword id=\"mana\">魔力</keyword>時，下次<keyword id=\"burn\">燃燒</keyword>攻擊的傷害提高<value id=\"quantity_1\">%1$lld</value>%%"
          }
        }
      }
    },
