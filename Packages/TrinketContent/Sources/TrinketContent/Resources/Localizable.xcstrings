    "affixes.restorative.astral_description": {
      "comment": "ContentManifest/affixes.tsv: restorative, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Wiederherstellen von <keyword id=\"health\">Gesundheit</keyword> hat eine Chance von <value id=\"quantity_1\">%1$lld</value>%%, <value id=\"quantity_2\">%2$lld</value> Schwächungseffekt des Ziels zu <keyword id=\"cleanse\">reinigen</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Restoring <keyword id=\"health\">Health</keyword> has a <value id=\"quantity_1\">%1$lld</value>%% chance to <keyword id=\"cleanse\">Cleanse</keyword> <value id=\"quantity_2\">%2$lld</value> debuff from the target"}},
        "es": {"stringUnit": {"state": "translated", "value": "Restaurar <keyword id=\"health\">Salud</keyword> tiene un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de <keyword id=\"cleanse\">purificar</keyword> <value id=\"quantity_2\">%2$lld</value> perjuicio del objetivo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Rendre de la <keyword id=\"health\">Santé</keyword> a <value id=\"quantity_1\">%1$lld</value>%% de chances de déclencher la <keyword id=\"cleanse\">Purification</keyword> de <value id=\"quantity_2\">%2$lld</value> malus de la cible"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>を回復すると<value id=\"quantity_1\">%1$lld</value>%%の確率で対象の弱体効果を<value id=\"quantity_2\">%2$lld</value>個<keyword id=\"cleanse\">浄化</keyword>"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword> 회복 시 <value id=\"quantity_1\">%1$lld</value>%% 확률로 대상의 약화 효과 <value id=\"quantity_2\">%2$lld</value>개를 <keyword id=\"cleanse\">정화</keyword>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Restaurar <keyword id=\"health\">Vida</keyword> tem <value id=\"quantity_1\">%1$lld</value>%% de chance de <keyword id=\"cleanse\">Purificar</keyword> <value id=\"quantity_2\">%2$lld</value> efeito negativo do alvo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "恢復<keyword id=\"health\">生命值</keyword>時，有<value id=\"quantity_1\">%1$lld</value>%%機率<keyword id=\"cleanse\">淨化</keyword>目標的<value id=\"quantity_2\">%2$lld</value>項減益效果"}}
      }
    },
