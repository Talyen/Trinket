    "affixes.beacon.astral_description": {
      "comment": "ContentManifest/affixes.tsv: beacon, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dein erster <keyword id=\"holy\">heiliger</keyword> Angriff pro Zug, der <keyword id=\"health\">Gesundheit</keyword>sschaden verursacht, stellt beim Verbündeten mit der niedrigsten <keyword id=\"health\">Gesundheit</keyword> <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Gesundheit</keyword> wieder her"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your first <keyword id=\"holy\">Holy</keyword> attack that deals <keyword id=\"health\">Health</keyword> damage each turn restores <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Health</keyword> to the lowest-<keyword id=\"health\">Health</keyword> ally"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu primer ataque <keyword id=\"holy\">sagrado</keyword> de cada turno que inflige daño a la <keyword id=\"health\">Salud</keyword> restaura <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Salud</keyword> al aliado con menos <keyword id=\"health\">Salud</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "À chaque tour, votre première attaque <keyword id=\"holy\">sacrée</keyword> qui inflige des dégâts à la <keyword id=\"health\">Santé</keyword> rend <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Santé</keyword> à l’allié ayant le moins de <keyword id=\"health\">Santé</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "各ターン、<keyword id=\"health\">体力</keyword>にダメージを与えた最初の<keyword id=\"holy\">聖</keyword>攻撃で、<keyword id=\"health\">体力</keyword>が最も低い味方の<keyword id=\"health\">体力</keyword>を<value id=\"quantity_1\">%1$lld</value>回復する"}},
        "ko": {"stringUnit": {"state": "translated", "value": "매 턴 <keyword id=\"health\">체력</keyword> 피해를 주는 첫 <keyword id=\"holy\">신성</keyword> 공격이 <keyword id=\"health\">체력</keyword>이 가장 낮은 아군의 <keyword id=\"health\">체력</keyword>을 <value id=\"quantity_1\">%1$lld</value> 회복합니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seu primeiro ataque <keyword id=\"holy\">Sagrado</keyword> de cada turno que causar dano à <keyword id=\"health\">Vida</keyword> restaura <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Vida</keyword> do aliado com menos <keyword id=\"health\">Vida</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每回合，你首次造成<keyword id=\"health\">生命值</keyword>傷害的<keyword id=\"holy\">神聖</keyword>攻擊，會為目前<keyword id=\"health\">生命值</keyword>最低的盟友恢復<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"health\">生命值</keyword>"}}
      }
    },
