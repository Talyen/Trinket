    "talents.warlock_burn_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: warlock_burn_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Brand</keyword>-Angriffe, die kritisch treffen, lassen dich eine Karte ziehen"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Burn</keyword> attacks that Critically Hit draw a card"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques de <keyword id=\"burn\">Quemadura</keyword> que asestan un golpe crítico hacen que robes una carta"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques de <keyword id=\"burn\">Brûlure</keyword> qui infligent un coup critique font piocher une carte"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">炎上</keyword>攻撃がクリティカルヒットするとカードを1枚引く"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">화상</keyword> 공격이 치명타로 적중하면 카드 한 장 뽑기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques de <keyword id=\"burn\">Queimadura</keyword> que acertam golpes críticos fazem você comprar uma carta"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">燃燒</keyword>攻擊暴擊時，抽一張牌"}}
      }
    },
    "talents.warlock_burn_t4_1.name": {
      "comment": "ContentManifest/talents.tsv: warlock_burn_t4_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Aschearsenal"}},
        "en": {"stringUnit": {"state": "translated", "value": "Ashen Arsenal"}},
        "es": {"stringUnit": {"state": "translated", "value": "Arsenal de ceniza"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Arsenal de cendres"}},
        "ja": {"stringUnit": {"state": "translated", "value": "灰の武器庫"}},
        "ko": {"stringUnit": {"state": "translated", "value": "잿빛 무기고"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Arsenal de Cinzas"}},
