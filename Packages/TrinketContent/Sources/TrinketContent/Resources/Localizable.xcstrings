        "en": {"stringUnit": {"state": "translated", "value": "Leyline Energy"}},
        "es": {"stringUnit": {"state": "translated", "value": "Energía de líneas ley"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Énergie tellurique"}},
        "ja": {"stringUnit": {"state": "translated", "value": "地脈の力"}},
        "ko": {"stringUnit": {"state": "translated", "value": "지맥의 에너지"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Energia das Linhas de Ley"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "地脈能量"}}
      }
    },
