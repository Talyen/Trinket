    "talents.risen_skeleton_physical_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_physical_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kritische <keyword id=\"physical\">physische</keyword> Treffer verursachen <value id=\"quantity_1\">%1$lld</value>%% mehr Schaden an <keyword id=\"poison\">vergifteten</keyword> Gegnern"
          }
