      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">Blutungs</keyword>-Angriffe verursachen <value id=\"quantity_1\">%1$lld</value>%% mehr Schaden an gegnerischem <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">Bleed</keyword> attacks deal <value id=\"quantity_1\">%1$lld</value>%% more damage to enemy <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques de <keyword id=\"bleed\">Sangrado</keyword> infligen un <value id=\"quantity_1\">%1$lld</value>%% más de daño al <keyword id=\"block\">Bloqueo</keyword> del enemigo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques de <keyword id=\"bleed\">Saignement</keyword> infligent <value id=\"quantity_1\">%1$lld</value>%% de dégâts en plus au <keyword id=\"block\">Blocage</keyword> ennemi"}},
        "ja": {"stringUnit": {"state": "translated", "value": "敵の<keyword id=\"block\">ブロック</keyword>への<keyword id=\"bleed\">出血</keyword>攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">출혈</keyword> 공격이 적의 <keyword id=\"block\">방어도</keyword>에 주는 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques de <keyword id=\"bleed\">Sangramento</keyword> causam <value id=\"quantity_1\">%1$lld</value>%% mais dano ao <keyword id=\"block\">Bloqueio</keyword> inimigo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">流血</keyword>攻擊對敵人<keyword id=\"block\">格擋</keyword>造成的傷害增加<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
