    "talents.wildcard_physical_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: wildcard_physical_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Deine kritischen Treffer ignorieren gegnerischen <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your Critical Hits ignore enemy <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tus golpes críticos ignoran el <keyword id=\"block\">Bloqueo</keyword> del enemigo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Vos coups critiques ignorent le <keyword id=\"block\">Blocage</keyword> ennemi"}},
        "ja": {"stringUnit": {"state": "translated", "value": "あなたのクリティカルヒットは敵の<keyword id=\"block\">ブロック</keyword>を無視する"}},
        "ko": {"stringUnit": {"state": "translated", "value": "자신의 치명타가 적의 <keyword id=\"block\">방어도</keyword>를 무시합니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seus golpes críticos ignoram o <keyword id=\"block\">Bloqueio</keyword> inimigo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "你的暴擊無視敵人的<keyword id=\"block\">格擋</keyword>"}}
      }
    },
    "talents.wildcard_physical_t2_1.name": {
      "comment": "ContentManifest/talents.tsv: wildcard_physical_t2_1, name",
      "extractionState": "manual",
      "localizations": {
