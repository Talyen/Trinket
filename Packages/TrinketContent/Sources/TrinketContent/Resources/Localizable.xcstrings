        "pt-BR": {"stringUnit": {"state": "translated", "value": "Dano de <keyword id=\"burn\">Queimadura</keyword> recebido aumentado em <value id=\"quantity_1\">%1$lld</value>%%"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "承受的<keyword id=\"burn\">燃燒</keyword>傷害增加<value id=\"quantity_1\">%1$lld</value>%%"}}
