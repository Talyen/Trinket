    "talents.risen_skeleton_deathsdoor_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_deathsdoor_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Erreichen der <keyword id=\"deathsdoor\">Todesschwelle</keyword> lässt dich eine Karte ziehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Entering <keyword id=\"deathsdoor\">Death's Door</keyword> draws a card"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atteindre le <keyword id=\"deathsdoor\">Seuil de la mort</keyword> fait piocher une carte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"deathsdoor\">死の淵</keyword>に入るとカードを1枚引く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"deathsdoor\">죽음의 문턱</keyword>에 들어서면 카드 한 장 뽑기"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "進入<keyword id=\"deathsdoor\">瀕死之門</keyword>時，抽一張牌"
          }
        }
      }
    },
