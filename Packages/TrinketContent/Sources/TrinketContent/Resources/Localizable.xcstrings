    "affixes.nullifying.astral_description": {
      "comment": "ContentManifest/affixes.tsv: nullifying, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "<keyword id=\"purge\">Entzaubere</keyword> <value id=\"quantity_1\">%1$lld</value> Verstärkung, wenn du <keyword id=\"holy\">heiligen</keyword> Schaden verursachst"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "<keyword id=\"purge\">Entzaubere</keyword> <value id=\"quantity_1\">%1$lld</value> Verstärkungen, wenn du <keyword id=\"holy\">heiligen</keyword> Schaden verursachst"
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "<keyword id=\"purge\">Purge</keyword> <value id=\"quantity_1\">%1$lld</value> buff when you deal <keyword id=\"holy\">Holy</keyword> damage"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "<keyword id=\"purge\">Purge</keyword> <value id=\"quantity_1\">%1$lld</value> buffs when you deal <keyword id=\"holy\">Holy</keyword> damage"
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "<keyword id=\"purge\">Dissipation</keyword> de <value id=\"quantity_1\">%1$lld</value> bonus lorsque vous infligez des dégâts de type <keyword id=\"holy\">Sacré</keyword>"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "<keyword id=\"purge\">Dissipation</keyword> de <value id=\"quantity_1\">%1$lld</value> bonus lorsque vous infligez des dégâts de type <keyword id=\"holy\">Sacré</keyword>"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "<keyword id=\"purge\">Dissipation</keyword> de <value id=\"quantity_1\">%1$lld</value> bonus lorsque vous infligez des dégâts de type <keyword id=\"holy\">Sacré</keyword>"
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "<keyword id=\"holy\">聖</keyword>ダメージを与えると強化効果を<value id=\"quantity_1\">%1$lld</value>個<keyword id=\"purge\">強化解除</keyword>"
                }
              }
            }
          }
        },
        "ko": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "<keyword id=\"holy\">신성</keyword> 피해를 주면 <keyword id=\"purge\">강화 해제</keyword>로 강화 효과 <value id=\"quantity_1\">%1$lld</value>개 제거"
                }
              }
            }
          }
        },
        "zh-Hant": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "造成<keyword id=\"holy\">神聖</keyword>傷害時，<keyword id=\"purge\">驅散</keyword><value id=\"quantity_1\">%1$lld</value>項增益效果"
                }
              }
            }
          }
        }
      }
    },
