    "talents.shield_scarab_block_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: shield_scarab_block_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange du <keyword id=\"block\">Block</keyword> hast, erleidet dein Verbündeter <value id=\"quantity_1\">%1$lld</value>%% weniger Schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While you have <keyword id=\"block\">Block</keyword>, your ally takes <value id=\"quantity_1\">%1$lld</value>%% less damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que vous avez du <keyword id=\"block\">Blocage</keyword>, votre allié subit <value id=\"quantity_1\">%1$lld</value>%% de dégâts en moins"
