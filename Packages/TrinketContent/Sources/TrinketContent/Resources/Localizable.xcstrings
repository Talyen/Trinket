    "talents.pixie_holy_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: pixie_holy_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Solange du <keyword id=\"block\">Block</keyword> hast, ignorieren <keyword id=\"holy\">heilige</keyword> Angriffe gegnerischen <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "While you have <keyword id=\"block\">Block</keyword>, <keyword id=\"holy\">Holy</keyword> attacks ignore enemy <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Mientras tienes <keyword id=\"block\">Bloqueo</keyword>, los ataques <keyword id=\"holy\">sagrados</keyword> ignoran el <keyword id=\"block\">Bloqueo</keyword> del enemigo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Tant que vous avez du <keyword id=\"block\">Blocage</keyword>, les attaques de type <keyword id=\"holy\">Sacré</keyword> ignorent le <keyword id=\"block\">Blocage</keyword> ennemi"}},
        "ja": {"stringUnit": {"state": "translated", "value": "自分に<keyword id=\"block\">ブロック</keyword>がある間、<keyword id=\"holy\">聖</keyword>攻撃が敵の<keyword id=\"block\">ブロック</keyword>を無視"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">방어도</keyword>가 있으면 <keyword id=\"holy\">신성</keyword> 공격이 적의 <keyword id=\"block\">방어도</keyword> 무시"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Enquanto tiver <keyword id=\"block\">Bloqueio</keyword>, ataques <keyword id=\"holy\">Sagrados</keyword> ignoram o <keyword id=\"block\">Bloqueio</keyword> inimigo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "自身擁有<keyword id=\"block\">格擋</keyword>時，<keyword id=\"holy\">神聖</keyword>攻擊無視敵人<keyword id=\"block\">格擋</keyword>"}}
      }
    },
