    "traits.blighted_pulse.description": {
      "comment": "ContentManifest/traits.tsv: blighted_pulse, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verursacht jeden zweiten Zug <value id=\"quantity_1\">%1$lld</value> <keyword id=\"poison\">Gift</keyword>- oder <keyword id=\"bleed\">Blutungs</keyword>schaden an allen Gegnern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deals <value id=\"quantity_1\">%1$lld</value> <keyword id=\"poison\">Poison</keyword> or <keyword id=\"bleed\">Bleed</keyword> damage every other turn to all enemies"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inflige <value id=\"quantity_1\">%1$lld</value> dégâts de <keyword id=\"poison\">Poison</keyword> ou de <keyword id=\"bleed\">Saignement</keyword> à tous les ennemis un tour sur deux"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1ターンおきに敵全体へ<keyword id=\"poison\">毒</keyword>か<keyword id=\"bleed\">出血</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 턴 걸러 모든 적에게 <keyword id=\"poison\">독</keyword> 또는 <keyword id=\"bleed\">출혈</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每隔一回合，對所有敵人造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"poison\">中毒</keyword>或<keyword id=\"bleed\">流血</keyword>傷害"
          }
        }
      }
    },
