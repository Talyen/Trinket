        "es": {"stringUnit": {"state": "translated", "value": "Restaura un <value id=\"quantity_1\">%1$lld</value>%% más de <keyword id=\"health\">Salud</keyword>\nProduce <value id=\"quantity_2\">%2$lld</value> de comida al día"}},
        "fr": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">Santé</keyword> restaurée augmentée de <value id=\"quantity_1\">%1$lld</value>%%\nNourriture produite par jour : <value id=\"quantity_2\">%2$lld</value>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>回復量が<value id=\"quantity_1\">%1$lld</value>%%増加\n1日に食料を<value id=\"quantity_2\">%2$lld</value>生産"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword> 회복량 <value id=\"quantity_1\">%1$lld</value>%% 증가\n하루에 식량 <value id=\"quantity_2\">%2$lld</value>개 생산"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Restaure <value id=\"quantity_1\">%1$lld</value>%% mais <keyword id=\"health\">Vida</keyword>\nProduza <value id=\"quantity_2\">%2$lld</value> de Comida por Dia"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "恢復的<keyword id=\"health\">生命值</keyword>增加<value id=\"quantity_1\">%1$lld</value>%%\n每天生產<value id=\"quantity_2\">%2$lld</value>食物"}}
      }
