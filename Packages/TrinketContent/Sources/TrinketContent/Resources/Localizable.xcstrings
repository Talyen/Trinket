    "traits.pilfer.description": {
      "comment": "ContentManifest/traits.tsv: pilfer, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Stiehlt vor jedem Angriffstreffer <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>."}},
        "en": {"stringUnit": {"state": "translated", "value": "Steals <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword> before each attack hit."}},
        "es": {"stringUnit": {"state": "translated", "value": "Roba <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueo</keyword> antes de cada impacto de ataque."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Vole <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Blocage</keyword> avant chaque coup d’une attaque."}},
        "ja": {"stringUnit": {"state": "translated", "value": "攻撃の各ヒットの前に<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>奪う。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "공격의 각 타격 전에 <keyword id=\"block\">방어도</keyword>를 <value id=\"quantity_1\">%1$lld</value> 훔친다."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Rouba <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueio</keyword> antes de cada acerto de ataque."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "在攻擊的每次命中前，竊取<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>。"}}
      }
    },
    "traits.pilfer.name": {
