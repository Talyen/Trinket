      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"bleed\">Blutung</keyword> hält <value id=\"quantity_1\">%1$lld</value> zusätzliche Züge an"
