    "affixes.beacon.astral_description": {
      "comment": "ContentManifest/affixes.tsv: beacon, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Gesundheit</keyword> wieder her, wenn du <keyword id=\"holy\">heiligen</keyword> Schaden verursachst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Health</keyword> when you deal <keyword id=\"holy\">Holy</keyword> damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Santé</keyword> lorsque vous infligez des dégâts de type <keyword id=\"holy\">Sacré</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"holy\">聖</keyword>ダメージを与えると<keyword id=\"health\">体力</keyword>を<value id=\"quantity_1\">%1$lld</value>回復"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"holy\">신성</keyword> 피해를 주면 <keyword id=\"health\">체력</keyword> <value id=\"quantity_1\">%1$lld</value> 회복"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "造成<keyword id=\"holy\">神聖</keyword>傷害時，恢復<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"health\">生命值</keyword>"
          }
        }
      }
    },
