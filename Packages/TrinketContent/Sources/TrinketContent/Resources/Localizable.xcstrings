    "homestead_nodes.blacksmithforge.1.bonus_description": {
      "comment": "ContentManifest/homestead_nodes.tsv: blacksmithForge.1, bonus_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erhöhe <keyword id=\"physical\">physischen</keyword> Schaden um <value id=\"quantity_1\">%1$lld</value>%%\nProduziere <value id=\"quantity_2\">%2$lld</value> Eisen pro Tag"}},
        "en": {"stringUnit": {"state": "translated", "value": "Increase <keyword id=\"physical\">Physical</keyword> damage by <value id=\"quantity_1\">%1$lld</value>%%\nProduce <value id=\"quantity_2\">%2$lld</value> Iron per Day"}},
        "es": {"stringUnit": {"state": "translated", "value": "Aumenta el daño <keyword id=\"physical\">físico</keyword> en un <value id=\"quantity_1\">%1$lld</value>%%\nProduce <value id=\"quantity_2\">%2$lld</value> de hierro al día"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Dégâts de type <keyword id=\"physical\">Physique</keyword> augmentés de <value id=\"quantity_1\">%1$lld</value>%%\nProduction quotidienne de fer : <value id=\"quantity_2\">%2$lld</value>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">物理</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%増加\n1日に鉄を<value id=\"quantity_2\">%2$lld</value>生産"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">물리</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가\n하루에 철 <value id=\"quantity_2\">%2$lld</value>개 생산"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Aumente o dano <keyword id=\"physical\">Físico</keyword> em <value id=\"quantity_1\">%1$lld</value>%%\nProduza <value id=\"quantity_2\">%2$lld</value> de Ferro por Dia"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">物理</keyword>傷害提高<value id=\"quantity_1\">%1$lld</value>%%\n每天生產<value id=\"quantity_2\">%2$lld</value>鐵"}}
      }
    },
