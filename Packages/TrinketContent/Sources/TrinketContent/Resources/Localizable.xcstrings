    "talents.mana_moth_mana_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: mana_moth_mana_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Wiederherstellen von <keyword id=\"mana\">Mana</keyword> wird mit <value id=\"quantity_1\">%1$lld</value>%% Chance verdoppelt"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">Mana</keyword> restoration has a <value id=\"quantity_1\">%1$lld</value>%% chance to double"}},
        "es": {"stringUnit": {"state": "translated", "value": "La restauración de <keyword id=\"mana\">Maná</keyword> tiene un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de duplicarse"}},
        "fr": {"stringUnit": {"state": "translated", "value": "La restauration de <keyword id=\"mana\">Mana</keyword> a <value id=\"quantity_1\">%1$lld</value>%% de chances de doubler"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">マナ</keyword>回復量が<value id=\"quantity_1\">%1$lld</value>%%の確率で2倍になる"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">마나</keyword> 회복량이 <value id=\"quantity_1\">%1$lld</value>%% 확률로 두 배"}},
