    "talents.library_owl_holy_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: library_owl_holy_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach kritischen <keyword id=\"holy\">heiligen</keyword> Treffern ignoriert der nächste Angriff deines Verbündeten gegnerischen <keyword id=\"block\">Block</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"holy\">Holy</keyword> Critical Hits make your ally's next attack ignore enemy <keyword id=\"block\">Block</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les coups critiques de type <keyword id=\"holy\">Sacré</keyword> font ignorer le <keyword id=\"block\">Blocage</keyword> ennemi à la prochaine attaque de votre allié"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"holy\">聖</keyword>クリティカルヒットで、味方の次の攻撃が敵の<keyword id=\"block\">ブロック</keyword>を無視"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"holy\">신성</keyword> 치명타 적중 시 아군의 다음 공격이 적의 <keyword id=\"block\">방어도</keyword> 무시"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"holy\">神聖</keyword>暴擊使友方下次攻擊無視敵人<keyword id=\"block\">格擋</keyword>"
          }
        }
      }
    },
