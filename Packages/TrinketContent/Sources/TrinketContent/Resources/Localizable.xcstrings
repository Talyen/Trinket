        "en": {"stringUnit": {"state": "translated", "value": "Counter Pounce"}},
        "es": {"stringUnit": {"state": "translated", "value": "Salto de contraataque"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Bond en riposte"}},
        "ja": {"stringUnit": {"state": "translated", "value": "飛びかかり返し"}},
        "ko": {"stringUnit": {"state": "translated", "value": "반격 덮치기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Contrabote"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "反撲"}}
      }
    },
    "talents.panther_dodge_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: panther_dodge_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Unter halber <keyword id=\"health\">Gesundheit</keyword> erhältst du +<value id=\"quantity_1\">%1$lld</value>%% Chance auf <keyword id=\"dodge\">Ausweichen</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Below half <keyword id=\"health\">Health</keyword>, gain +<value id=\"quantity_1\">%1$lld</value>%% <keyword id=\"dodge\">Dodge</keyword> chance"}},
        "es": {"stringUnit": {"state": "translated", "value": "Por debajo de la mitad de <keyword id=\"health\">Salud</keyword>, obtén +<value id=\"quantity_1\">%1$lld</value>%% de probabilidad de <keyword id=\"dodge\">Evasión</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Sous la moitié de votre <keyword id=\"health\">Santé</keyword>, gagnez +<value id=\"quantity_1\">%1$lld</value>%% de chances d’<keyword id=\"dodge\">Esquive</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>が半分未満なら、<keyword id=\"dodge\">回避</keyword>率が<value id=\"quantity_1\">%1$lld</value>%%上昇"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword>이 절반 미만이면 <keyword id=\"dodge\">회피</keyword> 확률 +<value id=\"quantity_1\">%1$lld</value>%%"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Abaixo de metade da <keyword id=\"health\">Vida</keyword>, ganhe +<value id=\"quantity_1\">%1$lld</value>%% de chance de <keyword id=\"dodge\">Esquiva</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">生命值</keyword>低於一半時，<keyword id=\"dodge\">閃避</keyword>機率提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.panther_dodge_t2_1.name": {
      "comment": "ContentManifest/talents.tsv: panther_dodge_t2_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Überlebensinstinkt"}},
        "en": {"stringUnit": {"state": "translated", "value": "Survival Instinct"}},
        "es": {"stringUnit": {"state": "translated", "value": "Instinto de supervivencia"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Instinct de survie"}},
        "ja": {"stringUnit": {"state": "translated", "value": "生存本能"}},
        "ko": {"stringUnit": {"state": "translated", "value": "생존 본능"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Instinto de Sobrevivência"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "求生本能"}}
      }
    },
    "talents.panther_dodge_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: panther_dodge_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Nach dem Ausweichen ignoriert dein nächster Angriff gegnerischen <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Dodging makes your next attack ignore enemy <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Esquivar hace que tu siguiente ataque ignore el <keyword id=\"block\">Bloqueo</keyword> del enemigo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Une esquive fait ignorer le <keyword id=\"block\">Blocage</keyword> ennemi à votre prochaine attaque"}},
        "ja": {"stringUnit": {"state": "translated", "value": "回避すると、次の攻撃が敵の<keyword id=\"block\">ブロック</keyword>を無視"}},
        "ko": {"stringUnit": {"state": "translated", "value": "회피 시 다음 공격이 적의 <keyword id=\"block\">방어도</keyword> 무시"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Esquivar faz seu próximo ataque ignorar o <keyword id=\"block\">Bloqueio</keyword> inimigo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "閃避後，下次攻擊無視敵人<keyword id=\"block\">格擋</keyword>"}}
      }
    },
    "talents.panther_dodge_t2_2.name": {
      "comment": "ContentManifest/talents.tsv: panther_dodge_t2_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Präzision des Jägers"}},
        "en": {"stringUnit": {"state": "translated", "value": "Stalker’s Precision"}},
        "es": {"stringUnit": {"state": "translated", "value": "Precisión del acechador"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Précision du traqueur"}},
        "ja": {"stringUnit": {"state": "translated", "value": "追跡者の精密さ"}},
        "ko": {"stringUnit": {"state": "translated", "value": "추적자의 정밀함"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Precisão do Espreitador"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "潛獵者的精準"}}
      }
    },
    "talents.panther_dodge_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: panther_dodge_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ausweichen lässt dich mit <value id=\"quantity_1\">%1$lld</value>%% Chance eine Karte ziehen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Dodging has a <value id=\"quantity_1\">%1$lld</value>%% chance to draw a card"}},
        "es": {"stringUnit": {"state": "translated", "value": "Esquivar tiene un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de hacer que robes una carta"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Une esquive a <value id=\"quantity_1\">%1$lld</value>%% de chances de faire piocher une carte"}},
        "ja": {"stringUnit": {"state": "translated", "value": "回避すると<value id=\"quantity_1\">%1$lld</value>%%の確率でカードを1枚引く"}},
        "ko": {"stringUnit": {"state": "translated", "value": "회피 시 <value id=\"quantity_1\">%1$lld</value>%% 확률로 카드 한 장 뽑기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Esquivar tem <value id=\"quantity_1\">%1$lld</value>%% de chance de comprar uma carta"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "閃避時有<value id=\"quantity_1\">%1$lld</value>%%機率抽一張牌"}}
      }
    },
    "talents.panther_dodge_t3_1.name": {
      "comment": "ContentManifest/talents.tsv: panther_dodge_t3_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Neu formieren"}},
        "en": {"stringUnit": {"state": "translated", "value": "Regroup"}},
        "es": {"stringUnit": {"state": "translated", "value": "Reagruparse"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Regroupement"}},
        "ja": {"stringUnit": {"state": "translated", "value": "態勢立て直し"}},
        "ko": {"stringUnit": {"state": "translated", "value": "재정비"}},
