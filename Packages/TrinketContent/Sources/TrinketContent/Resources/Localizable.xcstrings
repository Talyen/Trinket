    "talents.alchemist_health_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: alchemist_health_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Wiederherstellen von <keyword id=\"health\">Gesundheit</keyword> reinigt auch <keyword id=\"burn\">Brand</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restoring <keyword id=\"health\">Health</keyword> also Cleanses <keyword id=\"burn\">Burn</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurer de la <keyword id=\"health\">Santé</keyword> purifie aussi la <keyword id=\"burn\">Brûlure</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">体力</keyword>を回復すると<keyword id=\"burn\">炎上</keyword>も浄化"
