    "talents.wizard_freeze_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: wizard_freeze_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"freeze\">Frost</keyword> hält mit <value id=\"quantity_1\">%1$lld</value>%% Chance <value id=\"quantity_2\">%2$lld</value> zusätzlichen Zug an"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"freeze\">Freeze</keyword> has a <value id=\"quantity_1\">%1$lld</value>%% chance to last <value id=\"quantity_2\">%2$lld</value> extra turn"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le <keyword id=\"freeze\">Gel</keyword> a <value id=\"quantity_1\">%1$lld</value>%% de chances de durer <value id=\"quantity_2\">%2$lld</value> tour de plus"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"freeze\">凍結</keyword>が<value id=\"quantity_1\">%1$lld</value>%%の確率でさらに<value id=\"quantity_2\">%2$lld</value>ターン持続"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"freeze\">빙결</keyword>이 <value id=\"quantity_1\">%1$lld</value>%% 확률로 <value id=\"quantity_2\">%2$lld</value>턴 더 지속"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"freeze\">冰凍</keyword>有<value id=\"quantity_1\">%1$lld</value>%%機率額外持續<value id=\"quantity_2\">%2$lld</value>回合"
          }
        }
      }
    },
