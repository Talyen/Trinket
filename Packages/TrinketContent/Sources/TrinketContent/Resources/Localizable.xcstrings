        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alliés ayant des <keyword id=\"thorns\">Épines</keyword> restaurent <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Santé</keyword> de plus"
