    "affixes.mortar_and_pestle.title": {
      "comment": "ContentManifest/affixes.tsv: mortar_and_pestle, title",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Giftige Arznei"}},
        "en": {"stringUnit": {"state": "translated", "value": "Toxic Remedy"}},
        "es": {"stringUnit": {"state": "translated", "value": "Remedio tóxico"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Remède toxique"}},
        "ja": {"stringUnit": {"state": "translated", "value": "毒の妙薬"}},
        "ko": {"stringUnit": {"state": "translated", "value": "독성 치료제"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Remédio Tóxico"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "劇毒療方"}}
      }
    },
    "affixes.mutual.astral_description": {
      "comment": "ContentManifest/affixes.tsv: mutual, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erhalte <value id=\"quantity_1\">%1$lld</value>%% mehr <keyword id=\"block\">Block</keyword>, solange dein Verbündeter <keyword id=\"block\">Block</keyword> hat"}},
        "en": {"stringUnit": {"state": "translated", "value": "Gain <value id=\"quantity_1\">%1$lld</value>%% more <keyword id=\"block\">Block</keyword> while your ally has <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Obtén un <value id=\"quantity_1\">%1$lld</value>%% más de <keyword id=\"block\">Bloqueo</keyword> mientras tu aliado tenga <keyword id=\"block\">Bloqueo</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Gagnez <value id=\"quantity_1\">%1$lld</value>%% de <keyword id=\"block\">Blocage</keyword> supplémentaire si votre allié a du <keyword id=\"block\">Blocage</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "味方に<keyword id=\"block\">ブロック</keyword>がある間、獲得する<keyword id=\"block\">ブロック</keyword>が<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "아군에게 <keyword id=\"block\">방어도</keyword>가 있으면 얻는 <keyword id=\"block\">방어도</keyword>가 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ganhe <value id=\"quantity_1\">%1$lld</value>%% mais <keyword id=\"block\">Bloqueio</keyword> enquanto seu aliado tiver <keyword id=\"block\">Bloqueio</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "盟友擁有<keyword id=\"block\">格擋</keyword>時，獲得的<keyword id=\"block\">格擋</keyword>提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "affixes.mutual.basic_description": {
      "comment": "ContentManifest/affixes.tsv: mutual, basic_description",
