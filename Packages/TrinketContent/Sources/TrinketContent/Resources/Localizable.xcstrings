    "talents.druid_poison_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: druid_poison_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"poison\">Gift</keyword>-Angriffe ignorieren gegnerischen <keyword id=\"block\">Block</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"poison\">Poison</keyword> attacks ignore enemy <keyword id=\"block\">Block</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les attaques de <keyword id=\"poison\">Poison</keyword> ignorent le <keyword id=\"block\">Blocage</keyword> ennemi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"poison\">毒</keyword>攻撃が敵の<keyword id=\"block\">ブロック</keyword>を無視"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"poison\">독</keyword> 공격이 적의 <keyword id=\"block\">방어도</keyword> 무시"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"poison\">中毒</keyword>攻擊無視敵人<keyword id=\"block\">格擋</keyword>"
          }
        }
      }
    },
    "talents.druid_poison_t3_1.name": {
