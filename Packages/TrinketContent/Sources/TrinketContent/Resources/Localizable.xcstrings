            "state": "translated",
            "value": "<keyword id=\"bleed\">出血</keyword>状態の敵への<keyword id=\"leech\">吸収</keyword>攻撃のクリティカル率が<value id=\"quantity_1\">%1$lld</value>%%上昇"
          }
