    "legacy.affixes.martyrs.description": {
      "comment": "Localization/legacy-content.json: saved equipment description affixes.martyrs.description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erleide <value id=\"quantity_1\">%1$lld</value>%% weniger <keyword id=\"holy\">heiligen</keyword> Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Take <value id=\"quantity_1\">%1$lld</value>%% less <keyword id=\"holy\">Holy</keyword> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Recibe un <value id=\"quantity_1\">%1$lld</value>%% menos de daño <keyword id=\"holy\">sagrado</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Dégâts de type <keyword id=\"holy\">Sacré</keyword> subis réduits de <value id=\"quantity_1\">%1$lld</value>%%"}},
        "ja": {"stringUnit": {"state": "translated", "value": "受ける<keyword id=\"holy\">聖</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%減少"}},
        "ko": {"stringUnit": {"state": "translated", "value": "받는 <keyword id=\"holy\">신성</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>%% 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Receba <value id=\"quantity_1\">%1$lld</value>%% menos dano <keyword id=\"holy\">Sagrado</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "承受的<keyword id=\"holy\">神聖</keyword>傷害降低<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "legacy.affixes.sundering_charm.description": {
      "comment": "Localization/legacy-content.json: saved equipment description affixes.sundering_charm.description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">Physischer</keyword> Schaden und <keyword id=\"stun\">Betäubungs</keyword>schaden entfernen doppelt so viel <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">Physical</keyword> and <keyword id=\"stun\">Stun</keyword> damage remove twice as much <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "El daño <keyword id=\"physical\">físico</keyword> y de <keyword id=\"stun\">Aturdimiento</keyword> elimina el doble de <keyword id=\"block\">Bloqueo</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les dégâts de type <keyword id=\"physical\">Physique</keyword> et d’<keyword id=\"stun\">Étourdissement</keyword> retirent deux fois plus de <keyword id=\"block\">Blocage</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">物理</keyword>と<keyword id=\"stun\">スタン</keyword>ダメージで削る<keyword id=\"block\">ブロック</keyword>量が2倍になる"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">물리</keyword> 및 <keyword id=\"stun\">기절</keyword> 피해가 <keyword id=\"block\">방어도</keyword>를 두 배로 제거"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Dano <keyword id=\"physical\">Físico</keyword> e de <keyword id=\"stun\">Atordoamento</keyword> remove o dobro de <keyword id=\"block\">Bloqueio</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">物理</keyword>與<keyword id=\"stun\">暈眩</keyword>傷害削除的<keyword id=\"block\">格擋</keyword>加倍"}}
      }
    },
    "legacy.affixes.unmaking.astral_description": {
      "comment": "Localization/legacy-content.json: saved equipment description affixes.unmaking.astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">Entzaubere</keyword> alle Verstärkungen des Gegners, wenn du kritisch triffst"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">Purge</keyword> all buffs from the enemy when you Critically Hit"}},
        "es": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">Purga</keyword> todas las mejoras del enemigo cuando asestas un golpe crítico"}},
        "fr": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">Dissipation</keyword> de tous les bonus de l’ennemi lors d’un coup critique"}},
        "ja": {"stringUnit": {"state": "translated", "value": "クリティカルヒット時に敵の強化効果をすべて<keyword id=\"purge\">強化解除</keyword>"}},
        "ko": {"stringUnit": {"state": "translated", "value": "치명타 적중 시 <keyword id=\"purge\">강화 해제</keyword>로 적의 모든 강화 효과 제거"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">Expurgue</keyword> todos os efeitos positivos do inimigo ao acertar um golpe crítico"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "暴擊命中時，<keyword id=\"purge\">驅散</keyword>敵人所有增益效果"}}
      }
    },
    "legacy.affixes.unmaking.basic_description": {
      "comment": "Localization/legacy-content.json: saved equipment description affixes.unmaking.basic_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"variations": {"plural": {"one": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">Entzaubere</keyword> <value id=\"quantity_1\">%1$lld</value> Verstärkung des Gegners, wenn du kritisch triffst"}}, "other": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">Entzaubere</keyword> <value id=\"quantity_1\">%1$lld</value> Verstärkungen des Gegners, wenn du kritisch triffst"}}}}},
        "en": {"variations": {"plural": {"one": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">Purge</keyword> <value id=\"quantity_1\">%1$lld</value> buff from the enemy when you Critically Hit"}}, "other": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">Purge</keyword> <value id=\"quantity_1\">%1$lld</value> buffs from the enemy when you Critically Hit"}}}}},
        "es": {"variations": {"plural": {"many": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">Purga</keyword> <value id=\"quantity_1\">%1$lld</value> mejoras del enemigo cuando asestas un golpe crítico"}}, "one": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">Purga</keyword> <value id=\"quantity_1\">%1$lld</value> mejora del enemigo cuando asestas un golpe crítico"}}, "other": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">Purga</keyword> <value id=\"quantity_1\">%1$lld</value> mejoras del enemigo cuando asestas un golpe crítico"}}}}},
        "fr": {"variations": {"plural": {"many": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">Dissipation</keyword> de <value id=\"quantity_1\">%1$lld</value> bonus de l’ennemi lorsque vous infligez un coup Critique"}}, "one": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">Dissipation</keyword> de <value id=\"quantity_1\">%1$lld</value> bonus de l’ennemi lorsque vous infligez un coup Critique"}}, "other": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">Dissipation</keyword> de <value id=\"quantity_1\">%1$lld</value> bonus de l’ennemi lorsque vous infligez un coup Critique"}}}}},
        "ja": {"variations": {"plural": {"other": {"stringUnit": {"state": "translated", "value": "クリティカルヒットすると敵の強化効果を<value id=\"quantity_1\">%1$lld</value>個<keyword id=\"purge\">強化解除</keyword>"}}}}},
        "ko": {"variations": {"plural": {"other": {"stringUnit": {"state": "translated", "value": "치명타 적중 시 <keyword id=\"purge\">강화 해제</keyword>로 적의 강화 효과 <value id=\"quantity_1\">%1$lld</value>개 제거"}}}}},
        "pt-BR": {"variations": {"plural": {"many": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">Expurgue</keyword> <value id=\"quantity_1\">%1$lld</value> efeitos positivos do inimigo ao acertar um golpe crítico"}}, "one": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">Expurgue</keyword> <value id=\"quantity_1\">%1$lld</value> efeito positivo do inimigo ao acertar um golpe crítico"}}, "other": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">Expurgue</keyword> <value id=\"quantity_1\">%1$lld</value> efeitos positivos do inimigo ao acertar um golpe crítico"}}}}},
        "zh-Hant": {"variations": {"plural": {"other": {"stringUnit": {"state": "translated", "value": "造成暴擊時，<keyword id=\"purge\">驅散</keyword>敵人的<value id=\"quantity_1\">%1$lld</value>項增益效果"}}}}}
