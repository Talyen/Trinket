    "talents.golden_retriever_block_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: golden_retriever_block_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange du <keyword id=\"block\">Block</keyword> hast, verhindere den Aufbau von <keyword id=\"stun\">Betäubung</keyword> und <keyword id=\"freeze\">Frost</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While you have <keyword id=\"block\">Block</keyword>, prevent <keyword id=\"stun\">Stun</keyword> and <keyword id=\"freeze\">Freeze</keyword> build-up"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que vous avez du <keyword id=\"block\">Blocage</keyword>, empêchez l’accumulation d’<keyword id=\"stun\">Étourdissement</keyword> et de <keyword id=\"freeze\">Gel</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"block\">ブロック</keyword>がある間、<keyword id=\"stun\">スタン</keyword>と<keyword id=\"freeze\">凍結</keyword>の蓄積を防ぐ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"block\">방어도</keyword>가 있으면 <keyword id=\"stun\">기절</keyword> 및 <keyword id=\"freeze\">빙결</keyword> 축적 방지"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擁有<keyword id=\"block\">格擋</keyword>時，防止<keyword id=\"stun\">暈眩</keyword>與<keyword id=\"freeze\">冰凍</keyword>累積"
          }
        }
      }
