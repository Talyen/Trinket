        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sous la moitié de votre <keyword id=\"health\">Santé</keyword>, votre premier gain d’<keyword id=\"gold\">Or</keyword> de chaque tour restaure <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Santé</keyword>"
