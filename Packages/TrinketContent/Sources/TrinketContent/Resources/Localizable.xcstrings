    "affixes.sundering_charm.astral_description": {
      "comment": "ContentManifest/affixes.tsv: sundering_charm, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verursache <value id=\"quantity_1\">%1$lld</value> zusätzlichen <keyword id=\"physical\">physischen</keyword> Schaden. <keyword id=\"physical\">Physischer</keyword> Schaden und <keyword id=\"stun\">Betäubungs</keyword>schaden entfernen doppelt so viel <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Increase <keyword id=\"physical\">Physical</keyword> damage by <value id=\"quantity_1\">%1$lld</value>. <keyword id=\"physical\">Physical</keyword> and <keyword id=\"stun\">Stun</keyword> damage remove twice as much <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Aumenta el daño <keyword id=\"physical\">físico</keyword> en <value id=\"quantity_1\">%1$lld</value>. El daño <keyword id=\"physical\">físico</keyword> y de <keyword id=\"stun\">Aturdimiento</keyword> elimina el doble de <keyword id=\"block\">Bloqueo</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Dégâts de type <keyword id=\"physical\">Physique</keyword> augmentés de <value id=\"quantity_1\">%1$lld</value>. Les dégâts de type <keyword id=\"physical\">Physique</keyword> et d’<keyword id=\"stun\">Étourdissement</keyword> retirent deux fois plus de <keyword id=\"block\">Blocage</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "与える<keyword id=\"physical\">物理</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>増加。<keyword id=\"physical\">物理</keyword>と<keyword id=\"stun\">スタン</keyword>ダメージで削る<keyword id=\"block\">ブロック</keyword>量が2倍になる"}},
        "ko": {"stringUnit": {"state": "translated", "value": "가하는 <keyword id=\"physical\">물리</keyword> 피해 <value id=\"quantity_1\">%1$lld</value> 증가. <keyword id=\"physical\">물리</keyword> 및 <keyword id=\"stun\">기절</keyword> 피해가 <keyword id=\"block\">방어도</keyword>를 두 배로 제거"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Aumente o dano <keyword id=\"physical\">Físico</keyword> em <value id=\"quantity_1\">%1$lld</value>. Dano <keyword id=\"physical\">Físico</keyword> e de <keyword id=\"stun\">Atordoamento</keyword> remove o dobro de <keyword id=\"block\">Bloqueio</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "造成的<keyword id=\"physical\">物理</keyword>傷害增加<value id=\"quantity_1\">%1$lld</value>。<keyword id=\"physical\">物理</keyword>與<keyword id=\"stun\">暈眩</keyword>傷害削除的<keyword id=\"block\">格擋</keyword>加倍"}}
      }
    },
