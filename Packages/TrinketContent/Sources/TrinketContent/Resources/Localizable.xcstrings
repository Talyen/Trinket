    "talents.alchemist_cleanse_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: alchemist_cleanse_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe eine Karte, wenn du <keyword id=\"cleanse\">reinigst</keyword>,\nwährend du kein <keyword id=\"mana\">Mana</keyword> hast"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw a card when you <keyword id=\"cleanse\">Cleanse</keyword>\nwhile out of <keyword id=\"mana\">Mana</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Piochez une carte lors d’une <keyword id=\"cleanse\">Purification</keyword>\nsi vous n’avez plus de <keyword id=\"mana\">Mana</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"mana\">マナ</keyword>がない状態で<keyword id=\"cleanse\">浄化</keyword>すると\nカードを1枚引く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"mana\">마나</keyword>가 없을 때 <keyword id=\"cleanse\">정화</keyword>하면\n카드 한 장 뽑기"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有<keyword id=\"mana\">魔力</keyword>時\n<keyword id=\"cleanse\">淨化</keyword>會抽一張牌"
          }
        }
      }
    },
