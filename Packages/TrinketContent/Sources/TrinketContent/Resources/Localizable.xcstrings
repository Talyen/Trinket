    "talents.warlock_leech_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: warlock_leech_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überschüssige Heilung durch <keyword id=\"leech\">Lebensraub</keyword> stellt die <keyword id=\"health\">Gesundheit</keyword> deines Gefährten wieder her"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Excess <keyword id=\"leech\">Leech</keyword> healing restores your Companion’s <keyword id=\"health\">Health</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les soins de <keyword id=\"leech\">Vol de vie</keyword> excédentaires restaurent la <keyword id=\"health\">Santé</keyword> de votre Compagnon"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">吸収</keyword>による過剰回復で仲間の<keyword id=\"health\">体力</keyword>を回復"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">흡혈</keyword>의 초과 치유량만큼 동료의 <keyword id=\"health\">체력</keyword> 회복"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">吸血</keyword>過量治療恢復夥伴的<keyword id=\"health\">生命值</keyword>"
          }
        }
      }
