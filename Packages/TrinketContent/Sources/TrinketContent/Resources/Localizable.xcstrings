    "talents.wildcard_physical_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: wildcard_physical_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Deine Angriffe verursachen mit <value id=\"quantity_1\">%1$lld</value>%% Chance doppelten Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your attacks have a <value id=\"quantity_1\">%1$lld</value>%% chance to deal double damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tus ataques tienen un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de infligir el doble de daño"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Vos attaques ont <value id=\"quantity_1\">%1$lld</value>%% de chances d’infliger le double de dégâts"}},
        "ja": {"stringUnit": {"state": "translated", "value": "あなたの攻撃は<value id=\"quantity_1\">%1$lld</value>%%の確率で2倍のダメージを与える"}},
        "ko": {"stringUnit": {"state": "translated", "value": "자신의 공격이 <value id=\"quantity_1\">%1$lld</value>%% 확률로 두 배의 피해를 줍니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seus ataques têm <value id=\"quantity_1\">%1$lld</value>%% de chance de causar o dobro de dano"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "你的攻擊有<value id=\"quantity_1\">%1$lld</value>%%機率造成雙倍傷害"}}
      }
    },
