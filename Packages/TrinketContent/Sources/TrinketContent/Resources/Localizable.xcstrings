          "stringUnit": {
            "state": "translated",
            "value": "Critical Hits steal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Gold</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les coups critiques volent <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Or</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリティカルヒットで<keyword id=\"gold\">ゴールド</keyword>を<value id=\"quantity_1\">%1$lld</value>盗む"
