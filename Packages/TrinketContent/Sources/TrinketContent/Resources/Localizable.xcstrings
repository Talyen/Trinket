    "authored.6cb87c0ea83f01c9": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/InventoryItem+Compatibility.swift: canonical numeric compatibility description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Stehlen von <keyword id=\"gold\">Gold</keyword> hat eine Chance von <value id=\"quantity_1\">%1$lld</value>%%,\neine Karte zu ziehen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Stealing <keyword id=\"gold\">Gold</keyword> has a <value id=\"quantity_1\">%1$lld</value>%% chance\nto draw a card"}},
        "es": {"stringUnit": {"state": "translated", "value": "Robar <keyword id=\"gold\">Oro</keyword> tiene un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad\nde hacer que robes una carta"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Voler de l’<keyword id=\"gold\">Or</keyword> a <value id=\"quantity_1\">%1$lld</value>%% de chances\nde faire piocher une carte"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"gold\">ゴールド</keyword>を盗むと<value id=\"quantity_1\">%1$lld</value>%%の確率で\nカードを1枚引く"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"gold\">골드</keyword>를 훔치면 <value id=\"quantity_1\">%1$lld</value>%% 확률로\n카드 한 장 뽑기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Roubar <keyword id=\"gold\">Ouro</keyword> tem <value id=\"quantity_1\">%1$lld</value>%% de chance\nde comprar uma carta"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "偷取<keyword id=\"gold\">金幣</keyword>時有<value id=\"quantity_1\">%1$lld</value>%%機率\n抽一張牌"}}
      }
    },
