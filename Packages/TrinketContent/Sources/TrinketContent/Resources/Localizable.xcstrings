    "talents.phoenix_deathsdoor_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: phoenix_deathsdoor_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die <keyword id=\"deathsdoor\">Todesschwelle</keyword> verhindert Schwächungseffekte"
