    "homestead_nodes.herbgarden.4.bonus_description": {
      "comment": "ContentManifest/homestead_nodes.tsv: herbGarden.4, bonus_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erleide <value id=\"quantity_1\">%1$lld</value>%% weniger <keyword id=\"poison\">Gift</keyword>schaden\nProduziere <value id=\"quantity_2\">%2$lld</value> Kräuter pro Tag"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take <value id=\"quantity_1\">%1$lld</value>%% less <keyword id=\"poison\">Poison</keyword> damage\nProduce <value id=\"quantity_2\">%2$lld</value> Herbs per Day"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dégâts de <keyword id=\"poison\">Poison</keyword> subis réduits de <value id=\"quantity_1\">%1$lld</value>%%\nProduit <value id=\"quantity_2\">%2$lld</value> herbes par jour"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受ける<keyword id=\"poison\">毒</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%減少\n1日に薬草を<value id=\"quantity_2\">%2$lld</value>生産"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받는 <keyword id=\"poison\">독</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>%% 감소\n하루에 약초 <value id=\"quantity_2\">%2$lld</value>개 생산"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "承受的<keyword id=\"poison\">中毒</keyword>傷害降低<value id=\"quantity_1\">%1$lld</value>%%\n每天生產<value id=\"quantity_2\">%2$lld</value>藥草"
          }
        }
      }
    },
