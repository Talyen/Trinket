    "affixes.martyrs.astral_description": {
      "comment": "ContentManifest/affixes.tsv: martyrs, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verursache <value id=\"quantity_1\">%1$lld</value> zusätzlichen <keyword id=\"holy\">heiligen</keyword> Schaden. Erleide <value id=\"quantity_2\">%2$lld</value>%% weniger <keyword id=\"holy\">heiligen</keyword> Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Deal <value id=\"quantity_1\">%1$lld</value> bonus <keyword id=\"holy\">Holy</keyword> damage. Take <value id=\"quantity_2\">%2$lld</value>%% less <keyword id=\"holy\">Holy</keyword> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Inflige <value id=\"quantity_1\">%1$lld</value> de daño <keyword id=\"holy\">sagrado</keyword> adicional. Recibe un <value id=\"quantity_2\">%2$lld</value>%% menos de daño <keyword id=\"holy\">sagrado</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Dégâts de type <keyword id=\"holy\">Sacré</keyword> augmentés de <value id=\"quantity_1\">%1$lld</value>. Dégâts de type <keyword id=\"holy\">Sacré</keyword> subis réduits de <value id=\"quantity_2\">%2$lld</value>%%"}},
        "ja": {"stringUnit": {"state": "translated", "value": "与える<keyword id=\"holy\">聖</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>増加。受ける<keyword id=\"holy\">聖</keyword>ダメージが<value id=\"quantity_2\">%2$lld</value>%%減少"}},
        "ko": {"stringUnit": {"state": "translated", "value": "가하는 <keyword id=\"holy\">신성</keyword> 피해 <value id=\"quantity_1\">%1$lld</value> 증가. 받는 <keyword id=\"holy\">신성</keyword> 피해 <value id=\"quantity_2\">%2$lld</value>%% 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cause <value id=\"quantity_1\">%1$lld</value> de dano <keyword id=\"holy\">Sagrado</keyword> adicional. Receba <value id=\"quantity_2\">%2$lld</value>%% menos dano <keyword id=\"holy\">Sagrado</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "造成的<keyword id=\"holy\">神聖</keyword>傷害增加<value id=\"quantity_1\">%1$lld</value>。承受的<keyword id=\"holy\">神聖</keyword>傷害降低<value id=\"quantity_2\">%2$lld</value>%%"}}
      }
    },
