    "talents.fox_gold_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: fox_gold_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dein erster <keyword id=\"gold\">Gold</keyword>diebstahl pro Zug stiehlt auch die Hälfte des gegnerischen <keyword id=\"block\">Blocks</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your first <keyword id=\"gold\">Gold</keyword> steal each turn also steals half the enemy's <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu primer robo de <keyword id=\"gold\">Oro</keyword> de cada turno también roba la mitad del <keyword id=\"block\">Bloqueo</keyword> del enemigo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre premier vol d’<keyword id=\"gold\">Or</keyword> de chaque tour vole aussi la moitié du <keyword id=\"block\">Blocage</keyword> de l’ennemi"}},
        "ja": {"stringUnit": {"state": "translated", "value": "各ターンで最初に<keyword id=\"gold\">ゴールド</keyword>を盗むと、敵の<keyword id=\"block\">ブロック</keyword>も半分奪う"}},
        "ko": {"stringUnit": {"state": "translated", "value": "매 턴 처음 <keyword id=\"gold\">골드</keyword>를 훔칠 때 적의 <keyword id=\"block\">방어도</keyword>도 절반 훔칩니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seu primeiro roubo de <keyword id=\"gold\">Ouro</keyword> de cada turno também rouba metade do <keyword id=\"block\">Bloqueio</keyword> inimigo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每回合首次竊取<keyword id=\"gold\">金幣</keyword>時，也會竊取敵人一半的<keyword id=\"block\">格擋</keyword>"}}
      }
    },
    "talents.fox_gold_t4_1.name": {
      "comment": "ContentManifest/talents.tsv: fox_gold_t4_1, name",
