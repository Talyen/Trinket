    "talents.risen_skeleton_deathsdoor_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_deathsdoor_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Angriffe erhalten <keyword id=\"leech\">Lebensraub</keyword>, solange du an der <keyword id=\"deathsdoor\">Todesschwelle</keyword> stehst"}},
        "en": {"stringUnit": {"state": "translated", "value": "Attacks gain <keyword id=\"leech\">Leech</keyword> while on <keyword id=\"deathsdoor\">Death's Door</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques obtienen <keyword id=\"leech\">Absorción</keyword> mientras estás a las <keyword id=\"deathsdoor\">Puertas de la Muerte</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques bénéficient de <keyword id=\"leech\">Vol de vie</keyword> au <keyword id=\"deathsdoor\">Seuil de la mort</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">死の淵</keyword>の間、攻撃に<keyword id=\"leech\">吸収</keyword>を付与"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">죽음의 문턱</keyword> 상태이면 공격에 <keyword id=\"leech\">흡혈</keyword> 부여"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques ganham <keyword id=\"leech\">Drenagem</keyword> enquanto você estiver <keyword id=\"deathsdoor\">À Beira da Morte</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "處於<keyword id=\"deathsdoor\">瀕死之門</keyword>時，攻擊獲得<keyword id=\"leech\">吸血</keyword>"}}
      }
    },
    "talents.risen_skeleton_deathsdoor_t4_1.name": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_deathsdoor_t4_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Geliehenes Leben"}},
        "en": {"stringUnit": {"state": "translated", "value": "Borrowed Life"}},
        "es": {"stringUnit": {"state": "translated", "value": "Vida prestada"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Vie empruntée"}},
        "ja": {"stringUnit": {"state": "translated", "value": "借りた命"}},
        "ko": {"stringUnit": {"state": "translated", "value": "빌린 생명"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Vida Emprestada"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "借來的生命"}}
      }
    },
    "talents.risen_skeleton_leech_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_leech_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Lebensraub verringert den Schaden des nächsten gegnerischen Treffers um <value id=\"quantity_1\">%1$lld</value>%%"}},
        "en": {"stringUnit": {"state": "translated", "value": "Leeching causes the enemy's next hit to deal <value id=\"quantity_1\">%1$lld</value>%% less damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Usar Absorción hace que el siguiente impacto del enemigo inflija un <value id=\"quantity_1\">%1$lld</value>%% menos de daño"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Un vol de vie réduit de <value id=\"quantity_1\">%1$lld</value>%% les dégâts du prochain coup de l’ennemi"}},
        "ja": {"stringUnit": {"state": "translated", "value": "吸収すると、敵の次のヒットのダメージが<value id=\"quantity_1\">%1$lld</value>%%減少"}},
        "ko": {"stringUnit": {"state": "translated", "value": "흡혈 시 적의 다음 적중 피해 <value id=\"quantity_1\">%1$lld</value>%% 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Drenar faz o próximo acerto inimigo causar <value id=\"quantity_1\">%1$lld</value>%% menos dano"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "吸血後，敵人下次命中的傷害降低<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.risen_skeleton_leech_t1_1.name": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_leech_t1_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Seele schwächen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Weaken Soul"}},
        "es": {"stringUnit": {"state": "translated", "value": "Debilitar alma"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Affaiblissement d’âme"}},
        "ja": {"stringUnit": {"state": "translated", "value": "魂の弱体化"}},
        "ko": {"stringUnit": {"state": "translated", "value": "영혼 약화"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Enfraquecer Alma"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "虛弱靈魂"}}
      }
    },
    "talents.risen_skeleton_leech_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_leech_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Kritische <keyword id=\"leech\">Lebensraub</keyword>-Treffer erhöhen den Schaden deines nächsten <keyword id=\"poison\">Gift</keyword>angriffs um <value id=\"quantity_1\">%1$lld</value>"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">Leech</keyword> Critical Hits add <value id=\"quantity_1\">%1$lld</value> damage to your next <keyword id=\"poison\">Poison</keyword> attack"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los golpes críticos de <keyword id=\"leech\">Absorción</keyword> añaden <value id=\"quantity_1\">%1$lld</value> de daño a tu siguiente ataque de <keyword id=\"poison\">Veneno</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les coups critiques de <keyword id=\"leech\">Vol de vie</keyword> ajoutent <value id=\"quantity_1\">%1$lld</value> dégâts à votre prochaine attaque de <keyword id=\"poison\">Poison</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">吸収</keyword>クリティカルヒットで、次の<keyword id=\"poison\">毒</keyword>攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>増加する"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">흡혈</keyword> 치명타가 다음 <keyword id=\"poison\">독</keyword> 공격의 피해를 <value id=\"quantity_1\">%1$lld</value> 증가시킵니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Golpes críticos de <keyword id=\"leech\">Drenagem</keyword> adicionam <value id=\"quantity_1\">%1$lld</value> de dano ao seu próximo ataque de <keyword id=\"poison\">Veneno</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">吸血</keyword>暴擊使你的下一次<keyword id=\"poison\">中毒</keyword>攻擊傷害提高<value id=\"quantity_1\">%1$lld</value>點"}}
      }
    },
    "talents.risen_skeleton_leech_t1_2.name": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_leech_t1_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Giftige Berührung"}},
        "en": {"stringUnit": {"state": "translated", "value": "Toxic Touch"}},
        "es": {"stringUnit": {"state": "translated", "value": "Toque tóxico"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Toucher toxique"}},
        "ja": {"stringUnit": {"state": "translated", "value": "毒の手"}},
        "ko": {"stringUnit": {"state": "translated", "value": "맹독의 손길"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Toque Tóxico"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "劇毒之觸"}}
      }
    },
    "talents.risen_skeleton_leech_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_leech_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">Lebensraub</keyword> stellt gegen Gegner unter halber <keyword id=\"health\">Gesundheit</keyword> <value id=\"quantity_1\">%1$lld</value>%% mehr <keyword id=\"health\">Gesundheit</keyword> wieder her"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">Leech</keyword> restores <value id=\"quantity_1\">%1$lld</value>%% more <keyword id=\"health\">Health</keyword> against enemies below half <keyword id=\"health\">Health</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">Absorción</keyword> restaura un <value id=\"quantity_1\">%1$lld</value>%% más de <keyword id=\"health\">Salud</keyword> contra enemigos por debajo de la mitad de <keyword id=\"health\">Salud</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le <keyword id=\"leech\">Vol de vie</keyword> restaure <value id=\"quantity_1\">%1$lld</value>%% de <keyword id=\"health\">Santé</keyword> en plus contre les ennemis sous la moitié de leur <keyword id=\"health\">Santé</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>が半分未満の敵に対する<keyword id=\"leech\">吸収</keyword>の<keyword id=\"health\">体力</keyword>回復量が<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword>이 절반 미만인 적을 상대로 <keyword id=\"leech\">흡혈</keyword>의 <keyword id=\"health\">체력</keyword> 회복량 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">Drenagem</keyword> restaura <value id=\"quantity_1\">%1$lld</value>%% mais <keyword id=\"health\">Vida</keyword> contra inimigos abaixo de metade da <keyword id=\"health\">Vida</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "對<keyword id=\"health\">生命值</keyword>低於一半的敵人，<keyword id=\"leech\">吸血</keyword>恢復的<keyword id=\"health\">生命值</keyword>增加<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.risen_skeleton_leech_t2_1.name": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_leech_t2_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Grabernte"}},
        "en": {"stringUnit": {"state": "translated", "value": "Grave Harvest"}},
        "es": {"stringUnit": {"state": "translated", "value": "Cosecha de ultratumba"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Moisson funèbre"}},
        "ja": {"stringUnit": {"state": "translated", "value": "墓場の収穫"}},
        "ko": {"stringUnit": {"state": "translated", "value": "무덤 수확"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Colheita do Túmulo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "墓地收穫"}}
      }
    },
    "talents.risen_skeleton_leech_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_leech_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Deine erste Heilung durch <keyword id=\"leech\">Lebensraub</keyword> in jedem Zug heilt auch deinen Verbündeten um ebenso viel"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your first <keyword id=\"leech\">Leech</keyword> restoration each turn also heals your ally equally"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu primera restauración de <keyword id=\"leech\">Absorción</keyword> de cada turno también cura a tu aliado en la misma cantidad"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre première restauration par <keyword id=\"leech\">Vol de vie</keyword> de chaque tour soigne aussi votre allié d’autant"}},
        "ja": {"stringUnit": {"state": "translated", "value": "各ターンで最初の<keyword id=\"leech\">吸収</keyword>回復で、味方も同量回復"}},
        "ko": {"stringUnit": {"state": "translated", "value": "매 턴 첫 <keyword id=\"leech\">흡혈</keyword> 회복 시 아군도 같은 양만큼 치유"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Sua primeira restauração de <keyword id=\"leech\">Drenagem</keyword> de cada turno também cura seu aliado na mesma quantidade"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每回合首次<keyword id=\"leech\">吸血</keyword>恢復也會為友方恢復等量生命值"}}
      }
    },
    "talents.risen_skeleton_leech_t2_2.name": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_leech_t2_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Seelenteilung"}},
        "en": {"stringUnit": {"state": "translated", "value": "Soul Sharing"}},
        "es": {"stringUnit": {"state": "translated", "value": "Alma compartida"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Partage d’âme"}},
        "ja": {"stringUnit": {"state": "translated", "value": "魂の分かち合い"}},
        "ko": {"stringUnit": {"state": "translated", "value": "영혼 나누기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Alma Compartilhada"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "共享靈魂"}}
      }
    },
    "talents.risen_skeleton_leech_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_leech_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">Lebensraub</keyword> stellt bei <keyword id=\"poison\">vergifteten</keyword> Gegnern <value id=\"quantity_1\">%1$lld</value>%% mehr <keyword id=\"health\">Gesundheit</keyword> wieder her"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">Leech</keyword> restores <value id=\"quantity_1\">%1$lld</value>%% more <keyword id=\"health\">Health</keyword> from <keyword id=\"poison\">Poisoned</keyword> enemies"}},
        "es": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">Absorción</keyword> restaura un <value id=\"quantity_1\">%1$lld</value>%% más de <keyword id=\"health\">Salud</keyword> de enemigos <keyword id=\"poison\">envenenados</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le <keyword id=\"leech\">Vol de vie</keyword> restaure <value id=\"quantity_1\">%1$lld</value>%% de <keyword id=\"health\">Santé</keyword> en plus sur les ennemis sous <keyword id=\"poison\">Poison</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">毒</keyword>状態の敵に対する<keyword id=\"leech\">吸収</keyword>の<keyword id=\"health\">体力</keyword>回復量が<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">독</keyword> 상태의 적에게 <keyword id=\"leech\">흡혈</keyword> 시 <keyword id=\"health\">체력</keyword> 회복량 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">Drenagem</keyword> restaura <value id=\"quantity_1\">%1$lld</value>%% mais <keyword id=\"health\">Vida</keyword> de inimigos <keyword id=\"poison\">Envenenados</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "從<keyword id=\"poison\">中毒</keyword>敵人<keyword id=\"leech\">吸血</keyword>恢復的<keyword id=\"health\">生命值</keyword>增加<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.risen_skeleton_leech_t3_1.name": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_leech_t3_1, name",
