    "talents.knight_holy_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: knight_holy_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"purge\">Entzaubern</keyword> lässt dich eine Karte ziehen,\nwährend du unter halber <keyword id=\"health\">Gesundheit</keyword> bist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"purge\">Purge</keyword> draws a card while you're\nbelow half <keyword id=\"health\">Health</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une <keyword id=\"purge\">Dissipation</keyword> fait piocher une carte\nsi vous êtes sous la moitié de votre <keyword id=\"health\">Santé</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">体力</keyword>が半分未満の間に\n<keyword id=\"purge\">強化解除</keyword>すると、カードを1枚引く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">체력</keyword>이 절반 미만일 때\n<keyword id=\"purge\">강화 해제</keyword> 시 카드 한 장 뽑기"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自身<keyword id=\"health\">生命值</keyword>低於一半時\n<keyword id=\"purge\">驅散</keyword>會抽一張牌"
          }
        }
      }
    },
