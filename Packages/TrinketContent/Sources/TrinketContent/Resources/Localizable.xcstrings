        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Burn</keyword> deals <value id=\"quantity_1\">%1$lld</value> more damage to <keyword id=\"bleed\">Bleeding</keyword> enemies"}},
        "es": {"stringUnit": {"state": "translated", "value": "La <keyword id=\"burn\">Quemadura</keyword> inflige <value id=\"quantity_1\">%1$lld</value> de daño adicional a enemigos con <keyword id=\"bleed\">Sangrado</keyword>"}},
