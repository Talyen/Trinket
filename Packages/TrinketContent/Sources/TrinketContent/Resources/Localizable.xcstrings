        "ja": {"stringUnit": {"state": "translated", "value": "荒れ狂う業火"}},
        "ko": {"stringUnit": {"state": "translated", "value": "맹렬한 지옥불"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Inferno Furioso"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "狂烈煉獄"}}
      }
