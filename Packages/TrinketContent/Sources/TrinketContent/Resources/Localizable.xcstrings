    "authored.5c7a38e94657a628": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wenn du <keyword id=\"mana\">Mana</keyword> zum Verstärken einer <keyword id=\"burn\">Brand</keyword>-Karte ausgibst, ziehe eine <keyword id=\"freeze\">Frost</keyword>-Karte und umgekehrt"}},
        "en": {"stringUnit": {"state": "translated", "value": "After you spend <keyword id=\"mana\">Mana</keyword> to empower a <keyword id=\"burn\">Burn</keyword> card, draw a <keyword id=\"freeze\">Freeze</keyword> card, and vice versa"}},
        "es": {"stringUnit": {"state": "translated", "value": "Después de gastar <keyword id=\"mana\">Maná</keyword> para potenciar una carta de <keyword id=\"burn\">Quemadura</keyword>, roba una carta de <keyword id=\"freeze\">Congelación</keyword>, y viceversa"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Après avoir dépensé du <keyword id=\"mana\">Mana</keyword> pour renforcer une carte de <keyword id=\"burn\">Brûlure</keyword>, piochez une carte de <keyword id=\"freeze\">Gel</keyword>, et inversement"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">マナ</keyword>を消費して<keyword id=\"burn\">炎上</keyword>カードを強化すると、<keyword id=\"freeze\">凍結</keyword>カードを1枚引く（逆の場合も同様）"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">마나</keyword>를 소모해 <keyword id=\"burn\">화상</keyword> 카드를 강화하면 <keyword id=\"freeze\">빙결</keyword> 카드 한 장 뽑기. 반대의 경우도 적용"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Após gastar <keyword id=\"mana\">Mana</keyword> para fortalecer uma carta de <keyword id=\"burn\">Queimadura</keyword>, compre uma carta de <keyword id=\"freeze\">Congelamento</keyword>, e vice-versa"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "消耗<keyword id=\"mana\">魔力</keyword>強化<keyword id=\"burn\">燃燒</keyword>卡牌後，抽一張<keyword id=\"freeze\">冰凍</keyword>牌；反之亦然"}}
      }
    },
