        "ko": {"stringUnit": {"state": "translated", "value": "회피 시 <value id=\"quantity_1\">%1$lld</value>%% 확률로 <keyword id=\"physical\">물리</keyword> 피해 <value id=\"quantity_2\">%2$lld</value>"}},
