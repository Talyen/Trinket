    "talents.shield_scarab_block_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: shield_scarab_block_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange du <keyword id=\"block\">Block</keyword> hast, erleide <value id=\"quantity_1\">%1$lld</value> weniger nicht-<keyword id=\"physical\">physischen</keyword> Schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While you have <keyword id=\"block\">Block</keyword>, take <value id=\"quantity_1\">%1$lld</value> less non-<keyword id=\"physical\">Physical</keyword> damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que vous avez du <keyword id=\"block\">Blocage</keyword>, les dégâts autres que de type <keyword id=\"physical\">Physique</keyword> subis sont réduits de <value id=\"quantity_1\">%1$lld</value>"
