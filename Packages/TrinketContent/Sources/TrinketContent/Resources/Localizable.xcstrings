    "authored.31f730a52db51c68": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog+Melee.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du einen Gegner betäubst, bleibt ein Viertel des auslösenden <keyword id=\"stun\">Betäubungs</keyword>aufbaus erhalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stunning an enemy preserves a quarter of the <keyword id=\"stun\">Stun</keyword> buildup that triggered it"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Étourdir un ennemi conserve un quart de l’accumulation d’<keyword id=\"stun\">Étourdissement</keyword> qui l’a déclenché"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "敵をスタン状態にすると、発動に使われた<keyword id=\"stun\">スタン</keyword>蓄積量の4分の1が残る"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적을 기절시키면 기절을 유발한 <keyword id=\"stun\">기절</keyword> 축적량의 4분의 1 유지"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使敵人暈眩時，保留觸發該狀態的<keyword id=\"stun\">暈眩</keyword>累積量的四分之一"
          }
        }
      }
    },
