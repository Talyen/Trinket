    "talents.druid_poison_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: druid_poison_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erleide halben <keyword id=\"poison\">Gift</keyword>schaden, solange du <keyword id=\"thorns\">Dornen</keyword> hast"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take half <keyword id=\"poison\">Poison</keyword> damage while you have <keyword id=\"thorns\">Thorns</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Subissez la moitié des dégâts de <keyword id=\"poison\">Poison</keyword> tant que vous avez des <keyword id=\"thorns\">Épines</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"thorns\">棘</keyword>がある間、受ける<keyword id=\"poison\">毒</keyword>ダメージが半減"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"thorns\">가시</keyword>가 있으면 받는 <keyword id=\"poison\">독</keyword> 피해가 절반으로 감소"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擁有<keyword id=\"thorns\">荊棘</keyword>時，承受的<keyword id=\"poison\">中毒</keyword>傷害減半"
          }
        }
      }
    },
