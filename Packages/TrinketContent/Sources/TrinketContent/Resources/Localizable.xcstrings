    "talents.phoenix_burn_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: phoenix_burn_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Kritische <keyword id=\"burn\">Brand</keyword>-Treffer verursachen <value id=\"quantity_1\">%1$lld</value> zusätzlichen Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Burn</keyword> Critical Hits deal <value id=\"quantity_1\">%1$lld</value> additional damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los golpes críticos de <keyword id=\"burn\">Quemadura</keyword> infligen <value id=\"quantity_1\">%1$lld</value> de daño adicional"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les coups critiques de <keyword id=\"burn\">Brûlure</keyword> infligent <value id=\"quantity_1\">%1$lld</value> dégâts supplémentaires"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">炎上</keyword>クリティカルヒットのダメージが<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">화상</keyword> 치명타의 추가 피해 <value id=\"quantity_1\">%1$lld</value>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Golpes críticos de <keyword id=\"burn\">Queimadura</keyword> causam <value id=\"quantity_1\">%1$lld</value> de dano adicional"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">燃燒</keyword>暴擊額外造成<value id=\"quantity_1\">%1$lld</value>點傷害"}}
