    "talents.bear_block_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: bear_block_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beende deinen Zug mit <keyword id=\"block\">Block</keyword>, um <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Gesundheit</keyword> wiederherzustellen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End your turn with <keyword id=\"block\">Block</keyword> to restore <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Health</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez votre tour avec du <keyword id=\"block\">Blocage</keyword> pour restaurer <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Santé</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"block\">ブロック</keyword>を持ってターンを終えると<keyword id=\"health\">体力</keyword>を<value id=\"quantity_1\">%1$lld</value>回復"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"block\">방어도</keyword>가 있는 채로 턴을 마치면 <keyword id=\"health\">체력</keyword> <value id=\"quantity_1\">%1$lld</value> 회복"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回合結束時若有<keyword id=\"block\">格擋</keyword>，恢復<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"health\">生命值</keyword>"
          }
        }
      }
    },
