        "ja": {"stringUnit": {"state": "translated", "value": "その選択肢はもう利用できません。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "이 선택지는 더 이상 이용할 수 없습니다."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Essa escolha não está mais disponível."}},
