    "talents.mana_moth_mana_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: mana_moth_mana_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verstärken mit <keyword id=\"mana\">Mana</keyword> erhöht <keyword id=\"burn\">Brand</keyword>- und <keyword id=\"freeze\">Frost</keyword>schaden um <value id=\"quantity_1\">%1$lld</value>%%"
