            "value": "承受的<keyword id=\"freeze\">冰凍</keyword>傷害降低<value id=\"quantity_1\">%1$lld</value>%%\n承受的<keyword id=\"burn\">燃燒</keyword>傷害降低<value id=\"quantity_2\">%2$lld</value>%%\n每天生產<value id=\"quantity_3\">%3$lld</value><keyword id=\"gold\">金幣</keyword>"
          }
        }
      }
    },
    "homestead_nodes.wooltailoring.4.bonus_title": {
      "comment": "ContentManifest/homestead_nodes.tsv: woolTailoring.4, bonus_title",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erleide <value id=\"quantity_1\">%1$lld</value>%% weniger <keyword id=\"freeze\">Frost</keyword>schaden"
          }
        },
        "en": {
          "stringUnit": {
