        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagnez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Blocage</keyword> lorsque votre <keyword id=\"block\">Blocage</keyword> est brisé"
          }
