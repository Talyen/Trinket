        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매 전투 두 아군 각각의 첫 <keyword id=\"physical\">물리</keyword> 공격 치명타 확률 +<value id=\"quantity_1\">%1$lld</value>%%"
          }
        },
        "zh-Hant": {
