    "talents.bear_physical_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: bear_physical_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">Betäubte</keyword> Gegner erleiden <value id=\"quantity_1\">%1$lld</value>%% mehr <keyword id=\"physical\">physischen</keyword> Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">Stunned</keyword> enemies take <value id=\"quantity_1\">%1$lld</value>%% increased <keyword id=\"physical\">Physical</keyword> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los enemigos <keyword id=\"stun\">aturdidos</keyword> reciben un <value id=\"quantity_1\">%1$lld</value>%% más de daño <keyword id=\"physical\">físico</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les ennemis sous <keyword id=\"stun\">Étourdissement</keyword> subissent <value id=\"quantity_1\">%1$lld</value>%% de dégâts de type <keyword id=\"physical\">Physique</keyword> en plus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">スタン</keyword>状態の敵が受ける<keyword id=\"physical\">物理</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">기절</keyword> 상태의 적이 받는 <keyword id=\"physical\">물리</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Inimigos <keyword id=\"stun\">Atordoados</keyword> recebem <value id=\"quantity_1\">%1$lld</value>%% mais dano <keyword id=\"physical\">Físico</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">暈眩</keyword>的敵人承受的<keyword id=\"physical\">物理</keyword>傷害增加<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
