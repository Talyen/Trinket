    "talents.lizard_scout_gold_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: lizard_scout_gold_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">Lebensraub</keyword> wandelt mit <value id=\"quantity_1\">%1$lld</value>%% Wahrscheinlichkeit überschüssige Heilung in <keyword id=\"gold\">Gold</keyword> um"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">Leech</keyword> has a <value id=\"quantity_1\">%1$lld</value>%% chance to convert excess healing into <keyword id=\"gold\">Gold</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "La <keyword id=\"leech\">Absorción</keyword> tiene un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de convertir la curación excedente en <keyword id=\"gold\">Oro</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le <keyword id=\"leech\">Vol de vie</keyword> a <value id=\"quantity_1\">%1$lld</value>%% de chances de convertir les soins excédentaires en <keyword id=\"gold\">Or</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">吸収</keyword>時、<value id=\"quantity_1\">%1$lld</value>%%の確率で過剰回復を<keyword id=\"gold\">ゴールド</keyword>に変換"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">흡혈</keyword> 시 <value id=\"quantity_1\">%1$lld</value>%% 확률로 초과 치유량을 <keyword id=\"gold\">골드</keyword>로 전환"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "A <keyword id=\"leech\">Drenagem</keyword> tem <value id=\"quantity_1\">%1$lld</value>%% de chance de converter a cura excedente em <keyword id=\"gold\">Ouro</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">吸血</keyword>有<value id=\"quantity_1\">%1$lld</value>%%機率將溢出治療轉換為<keyword id=\"gold\">金幣</keyword>"}}
      }
    },
