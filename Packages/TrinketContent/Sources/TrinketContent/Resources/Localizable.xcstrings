    "talents.library_owl_cleanse_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: library_owl_cleanse_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Gereinigte Effekte können bis zu deinem nächsten Zug nicht wiederkehren"}},
        "en": {"stringUnit": {"state": "translated", "value": "Cleansed effects cannot return until your next turn"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los efectos purificados no pueden regresar hasta tu siguiente turno"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les effets purifiés ne peuvent pas revenir avant votre prochain tour"}},
        "ja": {"stringUnit": {"state": "translated", "value": "浄化した効果は次の自分のターンまで再付与されない"}},
        "ko": {"stringUnit": {"state": "translated", "value": "정화된 효과는 다음 내 턴까지 다시 적용되지 않음"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Efeitos Purificados não podem voltar até seu próximo turno"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "被淨化的效果無法再次施加，直到下個自身回合"}}
      }
    },
