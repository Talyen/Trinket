    "talents.lizard_scout_gold_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: lizard_scout_gold_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Stiehl <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Gold</keyword>, wenn dein <keyword id=\"block\">Block</keyword> durchbrochen wird"}},
        "en": {"stringUnit": {"state": "translated", "value": "Steal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Gold</keyword> when your <keyword id=\"block\">Block</keyword> is broken"}},
        "es": {"stringUnit": {"state": "translated", "value": "Roba <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"gold\">Oro</keyword> cuando se rompe tu <keyword id=\"block\">Bloqueo</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Volez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Or</keyword> lorsque votre <keyword id=\"block\">Blocage</keyword> est brisé"}},
        "ja": {"stringUnit": {"state": "translated", "value": "自分の<keyword id=\"block\">ブロック</keyword>が崩れると<keyword id=\"gold\">ゴールド</keyword>を<value id=\"quantity_1\">%1$lld</value>盗む"}},
        "ko": {"stringUnit": {"state": "translated", "value": "내 <keyword id=\"block\">방어도</keyword>가 깨지면 <keyword id=\"gold\">골드</keyword> <value id=\"quantity_1\">%1$lld</value> 훔치기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Roube <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"gold\">Ouro</keyword> quando seu <keyword id=\"block\">Bloqueio</keyword> for quebrado"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "自身<keyword id=\"block\">格擋</keyword>被擊破時，偷取<value id=\"quantity_1\">%1$lld</value><keyword id=\"gold\">金幣</keyword>"}}
      }
    },
