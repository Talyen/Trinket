    "affixes.solace.astral_description": {
      "comment": "ContentManifest/affixes.tsv: solace, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erhalte <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword>, wenn du <value id=\"quantity_2\">%2$lld</value> Schwächungseffekt <keyword id=\"cleanse\">reinigst</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Gain <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword> when you <keyword id=\"cleanse\">Cleanse</keyword> <value id=\"quantity_2\">%2$lld</value> debuff"}},
        "es": {"stringUnit": {"state": "translated", "value": "Obtén <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"mana\">Maná</keyword> cuando <keyword id=\"cleanse\">purificas</keyword> <value id=\"quantity_2\">%2$lld</value> perjuicio"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Gagne <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"mana\">Mana</keyword> lors de la <keyword id=\"cleanse\">Purification</keyword> de <value id=\"quantity_2\">%2$lld</value> malus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "弱体効果を<value id=\"quantity_2\">%2$lld</value>個<keyword id=\"cleanse\">浄化</keyword>すると<keyword id=\"mana\">マナ</keyword>を<value id=\"quantity_1\">%1$lld</value>得る"}},
        "ko": {"stringUnit": {"state": "translated", "value": "약화 효과 <value id=\"quantity_2\">%2$lld</value>개를 <keyword id=\"cleanse\">정화</keyword>하면 <keyword id=\"mana\">마나</keyword> <value id=\"quantity_1\">%1$lld</value> 획득"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ganhe <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"mana\">Mana</keyword> ao <keyword id=\"cleanse\">Purificar</keyword> <value id=\"quantity_2\">%2$lld</value> efeito negativo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"cleanse\">淨化</keyword><value id=\"quantity_2\">%2$lld</value>項減益效果時，獲得<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"mana\">魔力</keyword>"}}
      }
    },
    "affixes.solace.basic_description": {
      "comment": "ContentManifest/affixes.tsv: solace, basic_description",
      "extractionState": "manual",
      "localizations": {
