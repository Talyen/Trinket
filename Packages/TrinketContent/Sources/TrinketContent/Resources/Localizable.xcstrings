    "talents.warlock_burn_t4_2.description": {
      "comment": "ContentManifest/talents.tsv: warlock_burn_t4_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Brand</keyword>-Angriffe fügen deinem nächsten <keyword id=\"bleed\">Blutungs</keyword>-Angriff <value id=\"quantity_1\">%1$lld</value> Schaden hinzu"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Burn</keyword> attacks add <value id=\"quantity_1\">%1$lld</value> damage to your next <keyword id=\"bleed\">Bleed</keyword> attack"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques de <keyword id=\"burn\">Quemadura</keyword> añaden <value id=\"quantity_1\">%1$lld</value> de daño a tu siguiente ataque de <keyword id=\"bleed\">Sangrado</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques de <keyword id=\"burn\">Brûlure</keyword> ajoutent <value id=\"quantity_1\">%1$lld</value> dégâts à votre prochaine attaque de <keyword id=\"bleed\">Saignement</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">炎上</keyword>攻撃で次の<keyword id=\"bleed\">出血</keyword>攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">화상</keyword> 공격 시 다음 <keyword id=\"bleed\">출혈</keyword> 공격의 피해 <value id=\"quantity_1\">%1$lld</value> 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques de <keyword id=\"burn\">Queimadura</keyword> adicionam <value id=\"quantity_1\">%1$lld</value> de dano ao seu próximo ataque de <keyword id=\"bleed\">Sangramento</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">燃燒</keyword>攻擊使下次<keyword id=\"bleed\">流血</keyword>攻擊的傷害增加<value id=\"quantity_1\">%1$lld</value>點"}}
      }
    },
    "talents.warlock_burn_t4_2.name": {
      "comment": "ContentManifest/talents.tsv: warlock_burn_t4_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Blutzunder"}},
        "en": {"stringUnit": {"state": "translated", "value": "Bloodkindling"}},
        "es": {"stringUnit": {"state": "translated", "value": "Yesca de sangre"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Braise sanguine"}},
        "ja": {"stringUnit": {"state": "translated", "value": "血の焚き付け"}},
        "ko": {"stringUnit": {"state": "translated", "value": "피의 불쏘시개"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Sangue Inflamável"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "鮮血引火"}}
      }
    },
    "talents.warlock_leech_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: warlock_leech_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">Lebensraub</keyword> heilt auch durch Schaden, den gegnerischer <keyword id=\"block\">Block</keyword> absorbiert"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">Leech</keyword> also heals from damage absorbed by enemy <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">Absorción</keyword> también cura a partir del daño absorbido por el <keyword id=\"block\">Bloqueo</keyword> del enemigo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le <keyword id=\"leech\">Vol de vie</keyword> soigne aussi à partir des dégâts absorbés par le <keyword id=\"block\">Blocage</keyword> ennemi"}},
        "ja": {"stringUnit": {"state": "translated", "value": "敵の<keyword id=\"block\">ブロック</keyword>が吸収したダメージからも<keyword id=\"leech\">吸収</keyword>で回復"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">흡혈</keyword>이 적의 <keyword id=\"block\">방어도</keyword>가 흡수한 피해로도 치유"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">Drenagem</keyword> também cura com o dano absorvido pelo <keyword id=\"block\">Bloqueio</keyword> inimigo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">吸血</keyword>也會從敵人<keyword id=\"block\">格擋</keyword>吸收的傷害中恢復生命值"}}
      }
    },
    "talents.warlock_leech_t1_1.name": {
      "comment": "ContentManifest/talents.tsv: warlock_leech_t1_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Vampirische Berührung"}},
        "en": {"stringUnit": {"state": "translated", "value": "Vampiric Touch"}},
        "es": {"stringUnit": {"state": "translated", "value": "Toque vampírico"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Toucher vampirique"}},
        "ja": {"stringUnit": {"state": "translated", "value": "吸血の手"}},
        "ko": {"stringUnit": {"state": "translated", "value": "흡혈의 손길"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Toque Vampírico"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "吸血之觸"}}
      }
    },
    "talents.warlock_leech_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: warlock_leech_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">Lebensraub</keyword>-Angriffe ignorieren die Hälfte des gegnerischen <keyword id=\"block\">Blocks</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">Leech</keyword> attacks ignore half enemy <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques de <keyword id=\"leech\">Absorción</keyword> ignoran la mitad del <keyword id=\"block\">Bloqueo</keyword> del enemigo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques de <keyword id=\"leech\">Vol de vie</keyword> ignorent la moitié du <keyword id=\"block\">Blocage</keyword> ennemi"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">吸収</keyword>攻撃が敵の<keyword id=\"block\">ブロック</keyword>を半分無視"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">흡혈</keyword> 공격이 적의 <keyword id=\"block\">방어도</keyword> 절반 무시"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques com <keyword id=\"leech\">Drenagem</keyword> ignoram metade do <keyword id=\"block\">Bloqueio</keyword> inimigo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">吸血</keyword>攻擊無視敵人一半<keyword id=\"block\">格擋</keyword>"}}
      }
    },
    "talents.warlock_leech_t1_2.name": {
      "comment": "ContentManifest/talents.tsv: warlock_leech_t1_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Seelendurchbohrer"}},
        "en": {"stringUnit": {"state": "translated", "value": "Soulpiercer"}},
        "es": {"stringUnit": {"state": "translated", "value": "Perforaalmas"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Perce-âme"}},
        "ja": {"stringUnit": {"state": "translated", "value": "魂貫き"}},
        "ko": {"stringUnit": {"state": "translated", "value": "영혼 관통자"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Perfura-Almas"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "穿魂者"}}
      }
    },
    "talents.warlock_leech_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: warlock_leech_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Überschüssige Heilung durch <keyword id=\"leech\">Lebensraub</keyword> stellt die <keyword id=\"health\">Gesundheit</keyword> deines Gefährten wieder her"}},
        "en": {"stringUnit": {"state": "translated", "value": "Excess <keyword id=\"leech\">Leech</keyword> healing restores your Companion’s <keyword id=\"health\">Health</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "La curación sobrante de <keyword id=\"leech\">Absorción</keyword> restaura la <keyword id=\"health\">Salud</keyword> de tu compañero"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les soins de <keyword id=\"leech\">Vol de vie</keyword> excédentaires restaurent la <keyword id=\"health\">Santé</keyword> de votre Compagnon"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">吸収</keyword>による過剰回復で仲間の<keyword id=\"health\">体力</keyword>を回復"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">흡혈</keyword>의 초과 치유량만큼 동료의 <keyword id=\"health\">체력</keyword> 회복"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "A cura excedente de <keyword id=\"leech\">Drenagem</keyword> restaura a <keyword id=\"health\">Vida</keyword> do seu Companheiro"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">吸血</keyword>過量治療恢復夥伴的<keyword id=\"health\">生命值</keyword>"}}
      }
    },
    "talents.warlock_leech_t2_1.name": {
      "comment": "ContentManifest/talents.tsv: warlock_leech_t2_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Blutverbindung"}},
        "en": {"stringUnit": {"state": "translated", "value": "Blood Link"}},
        "es": {"stringUnit": {"state": "translated", "value": "Vínculo sanguíneo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Lien sanguin"}},
        "ja": {"stringUnit": {"state": "translated", "value": "血のつながり"}},
        "ko": {"stringUnit": {"state": "translated", "value": "피의 연결"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Elo de Sangue"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "鮮血連結"}}
      }
    },
    "talents.warlock_leech_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: warlock_leech_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Überschüssige Heilung durch <keyword id=\"leech\">Lebensraub</keyword> stellt ebenso viel <keyword id=\"mana\">Mana</keyword> wieder her"}},
        "en": {"stringUnit": {"state": "translated", "value": "Excess <keyword id=\"leech\">Leech</keyword> healing restores equal <keyword id=\"mana\">Mana</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "La curación sobrante de <keyword id=\"leech\">Absorción</keyword> restaura una cantidad igual de <keyword id=\"mana\">Maná</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les soins de <keyword id=\"leech\">Vol de vie</keyword> excédentaires restaurent autant de <keyword id=\"mana\">Mana</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">吸収</keyword>による過剰回復と同量の<keyword id=\"mana\">マナ</keyword>を回復"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">흡혈</keyword>의 초과 치유량만큼 <keyword id=\"mana\">마나</keyword> 회복"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "A cura excedente de <keyword id=\"leech\">Drenagem</keyword> restaura a mesma quantidade de <keyword id=\"mana\">Mana</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">吸血</keyword>過量治療恢復等量<keyword id=\"mana\">魔力</keyword>"}}
      }
    },
    "talents.warlock_leech_t2_2.name": {
      "comment": "ContentManifest/talents.tsv: warlock_leech_t2_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Seelenentzug"}},
        "en": {"stringUnit": {"state": "translated", "value": "Soul Drain"}},
        "es": {"stringUnit": {"state": "translated", "value": "Drenar alma"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Drain d’âme"}},
        "ja": {"stringUnit": {"state": "translated", "value": "魂の吸引"}},
        "ko": {"stringUnit": {"state": "translated", "value": "영혼 흡수"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Drenar Alma"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "靈魂吸取"}}
      }
    },
    "talents.warlock_leech_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: warlock_leech_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wenn Lebensraub deine <keyword id=\"health\">Gesundheit</keyword> vollständig auffüllt, erhält dein nächster Angriff <value id=\"quantity_1\">%1$lld</value> zusätzlichen Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Leeching to full <keyword id=\"health\">Health</keyword> adds <value id=\"quantity_1\">%1$lld</value> bonus damage to your next attack"}},
        "es": {"stringUnit": {"state": "translated", "value": "Usar Absorción hasta tener toda la <keyword id=\"health\">Salud</keyword> añade <value id=\"quantity_1\">%1$lld</value> de daño adicional a tu siguiente ataque"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Atteindre la pleine <keyword id=\"health\">Santé</keyword> par un vol de vie ajoute <value id=\"quantity_1\">%1$lld</value> dégâts à votre prochaine attaque"}},
        "ja": {"stringUnit": {"state": "translated", "value": "吸収で<keyword id=\"health\">体力</keyword>が満タンになると、次の攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "흡혈로 <keyword id=\"health\">체력</keyword>을 가득 채우면 다음 공격의 추가 피해 <value id=\"quantity_1\">%1$lld</value>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Drenar até encher a <keyword id=\"health\">Vida</keyword> adiciona <value id=\"quantity_1\">%1$lld</value> de dano extra ao seu próximo ataque"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "吸血使<keyword id=\"health\">生命值</keyword>全滿時，下次攻擊的傷害增加<value id=\"quantity_1\">%1$lld</value>點"}}
      }
    },
    "talents.warlock_leech_t3_1.name": {
      "comment": "ContentManifest/talents.tsv: warlock_leech_t3_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Blutüberschuss"}},
        "en": {"stringUnit": {"state": "translated", "value": "Sanguine Overflow"}},
        "es": {"stringUnit": {"state": "translated", "value": "Desbordamiento sanguíneo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Débordement sanguin"}},
        "ja": {"stringUnit": {"state": "translated", "value": "溢れる血潮"}},
        "ko": {"stringUnit": {"state": "translated", "value": "넘치는 혈기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Transbordamento Sanguíneo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "鮮血滿溢"}}
      }
    },
    "talents.warlock_leech_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: warlock_leech_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">Lebensraub</keyword> gewährt unter halber <keyword id=\"health\">Gesundheit</keyword> auch <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">Leech</keyword> also grants <keyword id=\"block\">Block</keyword> when below half <keyword id=\"health\">Health</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">Absorción</keyword> también otorga <keyword id=\"block\">Bloqueo</keyword> cuando estás por debajo de la mitad de <keyword id=\"health\">Salud</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le <keyword id=\"leech\">Vol de vie</keyword> octroie aussi du <keyword id=\"block\">Blocage</keyword> sous la moitié de votre <keyword id=\"health\">Santé</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>が半分未満なら、<keyword id=\"leech\">吸収</keyword>で<keyword id=\"block\">ブロック</keyword>も獲得"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword>이 절반 미만이면 <keyword id=\"leech\">흡혈</keyword> 시 <keyword id=\"block\">방어도</keyword>도 획득"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">Drenagem</keyword> também concede <keyword id=\"block\">Bloqueio</keyword> quando você está abaixo de metade da <keyword id=\"health\">Vida</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">生命值</keyword>低於一半時，<keyword id=\"leech\">吸血</keyword>也會賦予<keyword id=\"block\">格擋</keyword>"}}
      }
    },
    "talents.warlock_leech_t3_2.name": {
      "comment": "ContentManifest/talents.tsv: warlock_leech_t3_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Seelenschutz"}},
        "en": {"stringUnit": {"state": "translated", "value": "Soul Ward"}},
        "es": {"stringUnit": {"state": "translated", "value": "Protección del alma"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Protection de l’âme"}},
        "ja": {"stringUnit": {"state": "translated", "value": "魂の守り"}},
        "ko": {"stringUnit": {"state": "translated", "value": "영혼 수호"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Proteção da Alma"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "靈魂守護"}}
      }
    },
    "talents.warlock_leech_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: warlock_leech_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dein erster <keyword id=\"burn\">Brand</keyword>angriff pro Zug erhält <keyword id=\"leech\">Lebensraub</keyword>, wenn du weniger als die Hälfte deiner <keyword id=\"health\">Gesundheit</keyword> hast"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your first <keyword id=\"burn\">Burn</keyword> attack each turn gains <keyword id=\"leech\">Leech</keyword> if you are below half <keyword id=\"health\">Health</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu primer ataque de <keyword id=\"burn\">Quemadura</keyword> de cada turno obtiene <keyword id=\"leech\">Absorción</keyword> si estás por debajo de la mitad de <keyword id=\"health\">Salud</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre première attaque de <keyword id=\"burn\">Brûlure</keyword> de chaque tour gagne <keyword id=\"leech\">Vol de vie</keyword> si votre <keyword id=\"health\">Santé</keyword> est inférieure à la moitié de son maximum"}},
        "ja": {"stringUnit": {"state": "translated", "value": "各ターンで最初の<keyword id=\"burn\">炎上</keyword>攻撃時、<keyword id=\"health\">体力</keyword>が半分未満なら<keyword id=\"leech\">吸収</keyword>を付与"}},
        "ko": {"stringUnit": {"state": "translated", "value": "매 턴 첫 <keyword id=\"burn\">화상</keyword> 공격은 <keyword id=\"health\">체력</keyword>이 절반 미만이면 <keyword id=\"leech\">흡혈</keyword>을 얻습니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seu primeiro ataque de <keyword id=\"burn\">Queimadura</keyword> de cada turno ganha <keyword id=\"leech\">Drenagem</keyword> se você estiver abaixo de metade da <keyword id=\"health\">Vida</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每回合的首次<keyword id=\"burn\">燃燒</keyword>攻擊，若你當時的<keyword id=\"health\">生命值</keyword>低於一半，便會獲得<keyword id=\"leech\">吸血</keyword>"}}
      }
    },
    "talents.warlock_leech_t4_1.name": {
      "comment": "ContentManifest/talents.tsv: warlock_leech_t4_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Gluttrinker"}},
        "en": {"stringUnit": {"state": "translated", "value": "Emberdrinker"}},
        "es": {"stringUnit": {"state": "translated", "value": "Bebedor de brasas"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Buveur de braise"}},
        "ja": {"stringUnit": {"state": "translated", "value": "残り火喰らい"}},
        "ko": {"stringUnit": {"state": "translated", "value": "잿불 포식자"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Bebedor de Brasas"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "飲燼者"}}
      }
    },
    "talents.warlock_mana_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: warlock_mana_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Bei <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword> stellt <keyword id=\"leech\">Lebensraub</keyword> <value id=\"quantity_2\">%2$lld</value>%% mehr <keyword id=\"health\">Gesundheit</keyword> wieder her"}},
        "en": {"stringUnit": {"state": "translated", "value": "At <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword>, <keyword id=\"leech\">Leech</keyword> restores <value id=\"quantity_2\">%2$lld</value>%% more <keyword id=\"health\">Health</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Con <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"mana\">Maná</keyword>, <keyword id=\"leech\">Absorción</keyword> restaura un <value id=\"quantity_2\">%2$lld</value>%% más de <keyword id=\"health\">Salud</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "À <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword>, le <keyword id=\"leech\">Vol de vie</keyword> restaure <value id=\"quantity_2\">%2$lld</value>%% de <keyword id=\"health\">Santé</keyword> en plus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">マナ</keyword>が<value id=\"quantity_1\">%1$lld</value>の時、<keyword id=\"leech\">吸収</keyword>による<keyword id=\"health\">体力</keyword>回復量が<value id=\"quantity_2\">%2$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">마나</keyword>가 <value id=\"quantity_1\">%1$lld</value>일 때 <keyword id=\"leech\">흡혈</keyword>의 <keyword id=\"health\">체력</keyword> 회복량 <value id=\"quantity_2\">%2$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Com <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"mana\">Mana</keyword>, <keyword id=\"leech\">Drenagem</keyword> restaura <value id=\"quantity_2\">%2$lld</value>%% mais <keyword id=\"health\">Vida</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "擁有<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"mana\">魔力</keyword>時，<keyword id=\"leech\">吸血</keyword>恢復的<keyword id=\"health\">生命值</keyword>增加<value id=\"quantity_2\">%2$lld</value>%%"}}
