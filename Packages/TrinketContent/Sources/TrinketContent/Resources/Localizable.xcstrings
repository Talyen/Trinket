    "talents.risen_skeleton_deathsdoor_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_deathsdoor_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die <keyword id=\"deathsdoor\">Todesschwelle</keyword> hält einen zusätzlichen Zug an"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"deathsdoor\">Death's Door</keyword> lasts one additional turn"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le <keyword id=\"deathsdoor\">Seuil de la mort</keyword> dure un tour de plus"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"deathsdoor\">死の淵</keyword>がさらに1ターン持続"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"deathsdoor\">죽음의 문턱</keyword> 지속 시간 1턴 증가"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"deathsdoor\">瀕死之門</keyword>額外持續一回合"
          }
        }
      }
    },
