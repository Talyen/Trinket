    "talents.fox_gold_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: fox_gold_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Unter halber <keyword id=\"health\">Gesundheit</keyword> stellt dein erster Erhalt von <keyword id=\"gold\">Gold</keyword> in jedem Zug <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Gesundheit</keyword> wieder her"}},
        "en": {"stringUnit": {"state": "translated", "value": "Below half <keyword id=\"health\">Health</keyword>, your first <keyword id=\"gold\">Gold</keyword> gain each turn restores <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Health</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Por debajo de la mitad de <keyword id=\"health\">Salud</keyword>, tu primera obtención de <keyword id=\"gold\">Oro</keyword> de cada turno restaura <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Salud</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Sous la moitié de votre <keyword id=\"health\">Santé</keyword>, votre premier gain d’<keyword id=\"gold\">Or</keyword> de chaque tour restaure <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Santé</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>が半分未満なら、各ターンで初めて<keyword id=\"gold\">ゴールド</keyword>を獲得すると<keyword id=\"health\">体力</keyword>を<value id=\"quantity_1\">%1$lld</value>回復"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword>이 절반 미만이면 매 턴 첫 <keyword id=\"gold\">골드</keyword> 획득 시 <keyword id=\"health\">체력</keyword> <value id=\"quantity_1\">%1$lld</value> 회복"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Abaixo de metade da <keyword id=\"health\">Vida</keyword>, seu primeiro ganho de <keyword id=\"gold\">Ouro</keyword> de cada turno restaura <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Vida</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">生命值</keyword>低於一半時，每回合首次獲得<keyword id=\"gold\">金幣</keyword>恢復<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"health\">生命值</keyword>"}}
      }
    },
    "talents.fox_gold_t3_2.name": {
      "comment": "ContentManifest/talents.tsv: fox_gold_t3_2, name",
      "extractionState": "manual",
      "localizations": {
