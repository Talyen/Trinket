        "fr": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">Saignement</keyword> nécrotique"}},
        "ja": {"stringUnit": {"state": "translated", "value": "壊死の<keyword id=\"bleed\">出血</keyword>"}},
