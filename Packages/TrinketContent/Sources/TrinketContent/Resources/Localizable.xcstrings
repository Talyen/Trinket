    "talents.phoenix_deathsdoor_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: phoenix_deathsdoor_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Erreichen der <keyword id=\"deathsdoor\">Todesschwelle</keyword> verursacht beim Gegner <value id=\"quantity_1\">%1$lld</value> <keyword id=\"burn\">Brand</keyword>schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Entering <keyword id=\"deathsdoor\">Death's Door</keyword> deals <value id=\"quantity_1\">%1$lld</value> <keyword id=\"burn\">Burn</keyword> damage to the enemy"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atteindre le <keyword id=\"deathsdoor\">Seuil de la mort</keyword> inflige <value id=\"quantity_1\">%1$lld</value> dégâts de <keyword id=\"burn\">Brûlure</keyword> à l’ennemi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"deathsdoor\">死の淵</keyword>に入ると敵に<keyword id=\"burn\">炎上</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"deathsdoor\">죽음의 문턱</keyword>에 들어서면 적에게 <keyword id=\"burn\">화상</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "進入<keyword id=\"deathsdoor\">瀕死之門</keyword>時，對敵人造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"burn\">燃燒</keyword>傷害"
          }
        }
      }
    },
