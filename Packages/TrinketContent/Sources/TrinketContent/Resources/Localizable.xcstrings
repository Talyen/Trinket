    "authored.444aa5f030ead1ef": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog+Accessory.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Kampf erhaltenes <keyword id=\"gold\">Gold</keyword> verstärkt deinen nächsten <keyword id=\"holy\">heiligen</keyword> Treffer einer manuell gespielten Karte um ebenso viel Schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"gold\">Gold</keyword> gained in combat adds equal damage to your next <keyword id=\"holy\">Holy</keyword> hit from a manually played card"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’<keyword id=\"gold\">Or</keyword> gagné en combat ajoute autant de dégâts au prochain coup de type <keyword id=\"holy\">Sacré</keyword> d’une carte jouée manuellement"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "戦闘中に獲得した<keyword id=\"gold\">ゴールド</keyword>と同量のダメージを、次に手動で使うカードの<keyword id=\"holy\">聖</keyword>ヒットに追加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전투에서 획득한 <keyword id=\"gold\">골드</keyword>만큼, 직접 사용한 카드의 다음 <keyword id=\"holy\">신성</keyword> 적중 피해 증가"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "戰鬥中獲得的<keyword id=\"gold\">金幣</keyword>，會為下次手動出牌造成的<keyword id=\"holy\">神聖</keyword>命中增加等量傷害"
          }
        }
      }
    },
