    "talents.druid_poison_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: druid_poison_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"poison\">Vergiftete</keyword> Gegner erleiden <value id=\"quantity_1\">%1$lld</value>%% mehr <keyword id=\"thorns\">Dornen</keyword>schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"poison\">Poisoned</keyword> enemies take <value id=\"quantity_1\">%1$lld</value>%% increased <keyword id=\"thorns\">Thorns</keyword> damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les ennemis sous <keyword id=\"poison\">Poison</keyword> subissent <value id=\"quantity_1\">%1$lld</value>%% de dégâts d’<keyword id=\"thorns\">Épines</keyword> en plus"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"poison\">毒</keyword>状態の敵が受ける<keyword id=\"thorns\">棘</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"poison\">독</keyword> 상태의 적이 받는 <keyword id=\"thorns\">가시</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"poison\">中毒</keyword>的敵人承受的<keyword id=\"thorns\">荊棘</keyword>傷害增加<value id=\"quantity_1\">%1$lld</value>%%"
          }
        }
      }
    },
