    "talents.panther_bleed_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: panther_bleed_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kritische Treffer lassen <keyword id=\"bleed\">Blutung</keyword> detonieren"
