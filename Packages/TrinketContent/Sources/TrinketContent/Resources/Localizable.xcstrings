        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre première dépense de <keyword id=\"mana\">Mana</keyword> de chaque tour rembourse <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword>"
