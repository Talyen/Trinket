    "authored.42ebbca84976791e": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Abilities/AbilityCatalog+Basic.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verursache <value id=\"quantity_1\">%1$lld</value> <keyword id=\"physical\">physischen</keyword> Schaden\nTriff Gegner mit voller <keyword id=\"health\">Gesundheit</keyword> kritisch"}},
        "en": {"stringUnit": {"state": "translated", "value": "Deal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"physical\">Physical</keyword> damage\nCritically Hit enemies at full <keyword id=\"health\">Health</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Inflige <value id=\"quantity_1\">%1$lld</value> de daño <keyword id=\"physical\">físico</keyword>\nAsesta un golpe crítico a enemigos con toda la <keyword id=\"health\">Salud</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Infligez <value id=\"quantity_1\">%1$lld</value> dégâts de type <keyword id=\"physical\">Physique</keyword>\nCoup critique garanti contre les ennemis à pleine <keyword id=\"health\">Santé</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">物理</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える\n<keyword id=\"health\">体力</keyword>が満タンの敵には必ずクリティカルヒット"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">물리</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>\n<keyword id=\"health\">체력</keyword>이 가득 찬 적에게 반드시 치명타"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cause <value id=\"quantity_1\">%1$lld</value> de dano <keyword id=\"physical\">Físico</keyword>\nAcerte golpes críticos em inimigos com <keyword id=\"health\">Vida</keyword> cheia"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"physical\">物理</keyword>傷害\n對<keyword id=\"health\">生命值</keyword>全滿的敵人必定暴擊"}}
      }
    },
