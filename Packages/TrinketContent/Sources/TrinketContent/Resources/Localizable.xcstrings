    "talents.wizard_freeze_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: wizard_freeze_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verursache <value id=\"quantity_1\">%1$lld</value> zusätzlichen <keyword id=\"freeze\">Frost</keyword>schaden an <keyword id=\"freeze\">eingefrorenen</keyword> Gegnern"}},
        "en": {"stringUnit": {"state": "translated", "value": "Deal <value id=\"quantity_1\">%1$lld</value> additional <keyword id=\"freeze\">Freeze</keyword> damage to <keyword id=\"freeze\">Frozen</keyword> enemies"}},
        "es": {"stringUnit": {"state": "translated", "value": "Inflige <value id=\"quantity_1\">%1$lld</value> de daño adicional de <keyword id=\"freeze\">Congelación</keyword> a enemigos <keyword id=\"freeze\">congelados</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Infligez <value id=\"quantity_1\">%1$lld</value> dégâts de <keyword id=\"freeze\">Gel</keyword> supplémentaires aux ennemis sous <keyword id=\"freeze\">Gel</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">凍結</keyword>状態の敵への<keyword id=\"freeze\">凍結</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">빙결</keyword> 상태의 적에게 <keyword id=\"freeze\">빙결</keyword> 추가 피해 <value id=\"quantity_1\">%1$lld</value>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cause <value id=\"quantity_1\">%1$lld</value> de dano de <keyword id=\"freeze\">Congelamento</keyword> adicional a inimigos <keyword id=\"freeze\">Congelados</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "對<keyword id=\"freeze\">冰凍</keyword>敵人額外造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"freeze\">冰凍</keyword>傷害"}}
      }
    },
    "talents.wizard_freeze_t1_1.name": {
      "comment": "ContentManifest/talents.tsv: wizard_freeze_t1_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Beharrlicher Frost"}},
        "en": {"stringUnit": {"state": "translated", "value": "Persistent Frost"}},
        "es": {"stringUnit": {"state": "translated", "value": "Escarcha persistente"}},
