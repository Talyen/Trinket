        "ja": {"stringUnit": {"state": "translated", "value": "秘術の浄化"}},
        "ko": {"stringUnit": {"state": "translated", "value": "비전 정화"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Purificação Arcana"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "秘法淨化"}}
      }
    },
    "talents.wizard_mana_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: wizard_mana_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Ausgeben deines letzten <keyword id=\"mana\">Mana</keyword> lässt dich eine Karte ziehen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Spending your last <keyword id=\"mana\">Mana</keyword> draws a card"}},
        "es": {"stringUnit": {"state": "translated", "value": "Gastar tu último punto de <keyword id=\"mana\">Maná</keyword> hace que robes una carta"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Dépenser votre dernier <keyword id=\"mana\">Mana</keyword> fait piocher une carte"}},
        "ja": {"stringUnit": {"state": "translated", "value": "最後の<keyword id=\"mana\">マナ</keyword>を消費するとカードを1枚引く"}},
        "ko": {"stringUnit": {"state": "translated", "value": "마지막 <keyword id=\"mana\">마나</keyword> 소모 시 카드 한 장 뽑기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Gastar sua última <keyword id=\"mana\">Mana</keyword> faz você comprar uma carta"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "消耗最後的<keyword id=\"mana\">魔力</keyword>時，抽一張牌"}}
      }
    },
