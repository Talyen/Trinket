    "traits.shattering_impact.description": {
      "comment": "ContentManifest/traits.tsv: shattering_impact, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Durchbrechen des <keyword id=\"block\">Blocks</keyword> eines Gegners verursacht bei ihm <value id=\"quantity_1\">%1$lld</value> <keyword id=\"physical\">physischen</keyword> Schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Breaking an enemy's <keyword id=\"block\">Block</keyword> deals <value id=\"quantity_1\">%1$lld</value> <keyword id=\"physical\">Physical</keyword> damage to them"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Briser le <keyword id=\"block\">Blocage</keyword> d’un ennemi lui inflige <value id=\"quantity_1\">%1$lld</value> dégâts de type <keyword id=\"physical\">Physique</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "敵の<keyword id=\"block\">ブロック</keyword>を崩すと、その敵に<keyword id=\"physical\">物理</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적의 <keyword id=\"block\">방어도</keyword>를 깨뜨리면 해당 적에게 <keyword id=\"physical\">물리</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擊破敵人<keyword id=\"block\">格擋</keyword>時，對其造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"physical\">物理</keyword>傷害"
          }
        }
      }
    },
    "traits.shattering_impact.name": {
      "comment": "ContentManifest/traits.tsv: shattering_impact, name",
