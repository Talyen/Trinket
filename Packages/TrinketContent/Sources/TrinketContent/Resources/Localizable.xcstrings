    "authored.28d1d781324c2c4f": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Abilities/AbilityCatalog+Basic.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verursache <value id=\"quantity_1\">%1$lld</value> <keyword id=\"burn\">Brand</keyword>schaden\nVerdoppelt, wenn der Gegner zuvor nicht <keyword id=\"burn\">brannte</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"burn\">Burn</keyword> damage\nDoubled if enemy was not <keyword id=\"burn\">Burning</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Infligez <value id=\"quantity_1\">%1$lld</value> dégâts de <keyword id=\"burn\">Brûlure</keyword>\nDoublés si l’ennemi n’était pas sous <keyword id=\"burn\">Brûlure</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">炎上</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える\n敵が<keyword id=\"burn\">炎上</keyword>状態でなければ2倍"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">화상</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>\n적이 <keyword id=\"burn\">화상</keyword> 상태가 아니었다면 두 배"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"burn\">燃燒</keyword>傷害\n若敵人原本未<keyword id=\"burn\">燃燒</keyword>，傷害加倍"
          }
        }
      }
    },
