    "talents.panther_leech_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: panther_leech_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kritische <keyword id=\"leech\">Lebensraub</keyword>-Treffer gewähren deinem Verbündeten <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">Leech</keyword> Critical Hits grant your ally <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les coups critiques de <keyword id=\"leech\">Vol de vie</keyword> octroient <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Blocage</keyword> à votre allié"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">吸収</keyword>クリティカルヒットで味方に<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>付与"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">흡혈</keyword> 치명타 적중 시 아군에게 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 부여"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">吸血</keyword>暴擊賦予友方<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>"
          }
        }
      }
    },
