        "es": {"stringUnit": {"state": "translated", "value": "Ungüento refrescante"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Baume rafraîchissant"}},
        "ja": {"stringUnit": {"state": "translated", "value": "冷却軟膏"}},
        "ko": {"stringUnit": {"state": "translated", "value": "냉각 연고"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Pomada Refrescante"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "清涼藥膏"}}
