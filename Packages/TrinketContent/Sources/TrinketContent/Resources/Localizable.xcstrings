    "talents.wolf_physical_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: wolf_physical_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der jeweils erste <keyword id=\"physical\">physische</keyword> Angriff der beiden Verbündeten in jedem Kampf erhält +<value id=\"quantity_1\">%1$lld</value>%% Chance auf kritische Treffer"
          }
