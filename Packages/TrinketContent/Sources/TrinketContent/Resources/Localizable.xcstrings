    "affixes.cascading.astral_description": {
      "comment": "ContentManifest/affixes.tsv: cascading, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>, wenn dein <keyword id=\"block\">Block</keyword> durchbrochen wird"
