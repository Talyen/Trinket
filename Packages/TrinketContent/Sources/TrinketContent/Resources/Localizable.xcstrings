    "talents.wizard_burn_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: wizard_burn_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit <keyword id=\"mana\">Mana</keyword> verstärkte <keyword id=\"burn\">Brand</keyword>-Angriffe verursachen <value id=\"quantity_1\">%1$lld</value> zusätzlichen Schaden"
          }
