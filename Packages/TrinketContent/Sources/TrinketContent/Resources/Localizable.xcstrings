    "talents.panther_dodge_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: panther_dodge_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein erstes <keyword id=\"dodge\">Ausweichen</keyword> in jedem Kampf verdoppelt deinen nächsten Angriff"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your first <keyword id=\"dodge\">Dodge</keyword> each combat doubles your next attack"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre première <keyword id=\"dodge\">Esquive</keyword> de chaque combat double votre prochaine attaque"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各戦闘で最初の<keyword id=\"dodge\">回避</keyword>で次の攻撃が2倍になる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매 전투 첫 <keyword id=\"dodge\">회피</keyword> 시 다음 공격이 두 배"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每場戰鬥首次<keyword id=\"dodge\">閃避</keyword>使下次攻擊加倍"
          }
        }
      }
    },
