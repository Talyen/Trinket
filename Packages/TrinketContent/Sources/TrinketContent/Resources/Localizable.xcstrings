    "affixes.resourceful.astral_description": {
      "comment": "ContentManifest/affixes.tsv: resourceful, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ziehe eine Karte, wenn dein <keyword id=\"block\">Block</keyword> durchbrochen wird,\nwährend du unter halber <keyword id=\"health\">Gesundheit</keyword> bist"}},
        "en": {"stringUnit": {"state": "translated", "value": "Draw a card when your <keyword id=\"block\">Block</keyword> breaks\nwhile below half <keyword id=\"health\">Health</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Roba una carta cuando se rompe tu <keyword id=\"block\">Bloqueo</keyword>\nmientras estás por debajo de la mitad de <keyword id=\"health\">Salud</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Piochez une carte lorsque votre <keyword id=\"block\">Blocage</keyword> est brisé\nsi vous êtes sous la moitié de votre <keyword id=\"health\">Santé</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>が半分未満の間に\n自分の<keyword id=\"block\">ブロック</keyword>が崩れると、カードを1枚引く"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword>이 절반 미만일 때\n내 <keyword id=\"block\">방어도</keyword>가 깨지면 카드 한 장 뽑기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Compre uma carta quando seu <keyword id=\"block\">Bloqueio</keyword> quebrar\nenquanto estiver abaixo de metade da <keyword id=\"health\">Vida</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">生命值</keyword>低於一半時\n若自身<keyword id=\"block\">格擋</keyword>被擊破，則抽一張牌"}}
      }
    },
