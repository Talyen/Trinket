    "talents.rogue_bleed_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: rogue_bleed_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"bleed\">Blutung</keyword> hält bei <keyword id=\"poison\">vergifteten</keyword> Gegnern <value id=\"quantity_1\">%1$lld</value> zusätzlichen Zug an"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"bleed\">Bleed</keyword> lasts <value id=\"quantity_1\">%1$lld</value> extra turn on <keyword id=\"poison\">Poisoned</keyword> enemies"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le <keyword id=\"bleed\">Saignement</keyword> dure <value id=\"quantity_1\">%1$lld</value> tour de plus sur les ennemis sous <keyword id=\"poison\">Poison</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"poison\">毒</keyword>状態の敵への<keyword id=\"bleed\">出血</keyword>がさらに<value id=\"quantity_1\">%1$lld</value>ターン持続"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"poison\">독</keyword> 상태의 적에게 <keyword id=\"bleed\">출혈</keyword> 지속 시간 <value id=\"quantity_1\">%1$lld</value>턴 증가"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對<keyword id=\"poison\">中毒</keyword>的敵人，<keyword id=\"bleed\">流血</keyword>額外持續<value id=\"quantity_1\">%1$lld</value>回合"
          }
        }
      }
    },
