    "authored.6ed460d0356d5e78": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog+Melee.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Boni auf <keyword id=\"physical\">physischen</keyword> Schaden verstärken auch <keyword id=\"holy\">heiligen</keyword> Schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your <keyword id=\"physical\">Physical</keyword> damage bonuses also strengthen <keyword id=\"holy\">Holy</keyword> damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos bonus aux dégâts de type <keyword id=\"physical\">Physique</keyword> renforcent aussi les dégâts de type <keyword id=\"holy\">Sacré</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の<keyword id=\"physical\">物理</keyword>ダメージボーナスが<keyword id=\"holy\">聖</keyword>ダメージも強化"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 <keyword id=\"physical\">물리</keyword> 피해 보너스가 <keyword id=\"holy\">신성</keyword> 피해도 강화"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自身<keyword id=\"physical\">物理</keyword>傷害加成也會強化<keyword id=\"holy\">神聖</keyword>傷害"
          }
        }
      }
    },
    "authored.6ee786aa7f7a23c9": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Abilities/AbilityCatalog+Skill.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verursache <value id=\"quantity_1\">%1$lld</value> <keyword id=\"bleed\">Blutungs</keyword>schaden\nVerringert die von Gegnern wiederhergestellte <keyword id=\"health\">Gesundheit</keyword> für <value id=\"quantity_3\">%3$lld</value> Züge um <value id=\"quantity_2\">%2$lld</value>%%"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"bleed\">Bleed</keyword> damage\nReduces <keyword id=\"health\">Health</keyword> restored by enemies by <value id=\"quantity_2\">%2$lld</value>%% for <value id=\"quantity_3\">%3$lld</value> turns"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Infligez <value id=\"quantity_1\">%1$lld</value> dégâts de <keyword id=\"bleed\">Saignement</keyword>\nRéduit de <value id=\"quantity_2\">%2$lld</value>%% la <keyword id=\"health\">Santé</keyword> restaurée par les ennemis pendant <value id=\"quantity_3\">%3$lld</value> tours"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"bleed\">出血</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える\n<value id=\"quantity_3\">%3$lld</value>ターンの間、敵の<keyword id=\"health\">体力</keyword>回復量が<value id=\"quantity_2\">%2$lld</value>%%減少"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"bleed\">출혈</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>\n<value id=\"quantity_3\">%3$lld</value>턴 동안 적의 <keyword id=\"health\">체력</keyword> 회복량 <value id=\"quantity_2\">%2$lld</value>%% 감소"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"bleed\">流血</keyword>傷害\n使敵人恢復的<keyword id=\"health\">生命值</keyword>降低<value id=\"quantity_2\">%2$lld</value>%%，持續<value id=\"quantity_3\">%3$lld</value>回合"
          }
        }
      }
    },
    "authored.6ff43388c95c88b3": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/InventoryItem+Compatibility.swift: canonical numeric compatibility description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
