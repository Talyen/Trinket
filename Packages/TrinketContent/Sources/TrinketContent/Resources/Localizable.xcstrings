    "talents.warlock_mana_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: warlock_mana_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">Gesundheits</keyword>kosten senken die Kosten deines nächsten Verstärkens mit <keyword id=\"mana\">Mana</keyword> um <value id=\"quantity_1\">%1$lld</value>"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">Health</keyword> costs reduce your next <keyword id=\"mana\">Mana</keyword> empowerment cost by <value id=\"quantity_1\">%1$lld</value>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los costes de <keyword id=\"health\">Salud</keyword> reducen el coste de tu siguiente potenciación con <keyword id=\"mana\">Maná</keyword> en <value id=\"quantity_1\">%1$lld</value>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les coûts en <keyword id=\"health\">Santé</keyword> réduisent de <value id=\"quantity_1\">%1$lld</value> le coût de votre prochain renforcement au <keyword id=\"mana\">Mana</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>をコストとして支払うと、次の<keyword id=\"mana\">マナ</keyword>強化の消費が<value id=\"quantity_1\">%1$lld</value>減少"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword> 소모 시 다음 <keyword id=\"mana\">마나</keyword> 강화 소모량 <value id=\"quantity_1\">%1$lld</value> 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Custos de <keyword id=\"health\">Vida</keyword> reduzem em <value id=\"quantity_1\">%1$lld</value> o custo do seu próximo fortalecimento com <keyword id=\"mana\">Mana</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "支付<keyword id=\"health\">生命值</keyword>費用時，下次<keyword id=\"mana\">魔力</keyword>強化費用減少<value id=\"quantity_1\">%1$lld</value>點"}}
      }
    },
