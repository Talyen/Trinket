    "homestead_nodes.agilitytraining.1.summary": {
      "comment": "ContentManifest/homestead_nodes.tsv: agilityTraining.1, summary",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ein Übungsplatz, der Beinarbeit und Reflexe der Gefährten schärft"}},
        "en": {"stringUnit": {"state": "translated", "value": "A practice yard that sharpens companion footwork and reflexes"}},
        "es": {"stringUnit": {"state": "translated", "value": "Un patio de práctica que mejora los pasos y reflejos del compañero"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Une cour d’exercice qui aiguise les appuis et les réflexes des compagnons"}},
        "ja": {"stringUnit": {"state": "translated", "value": "仲間の足運びと反射神経を磨く練習場"}},
        "ko": {"stringUnit": {"state": "translated", "value": "동료의 발놀림과 반사 신경을 단련하는 연습 마당"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Um pátio de prática que aperfeiçoa os passos e reflexos dos companheiros"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "磨練夥伴步法與反應的練習場"}}
      }
    },
