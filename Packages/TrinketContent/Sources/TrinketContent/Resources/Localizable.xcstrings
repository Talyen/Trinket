        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les attaques de <keyword id=\"leech\">Vol de vie</keyword> infligent <value id=\"quantity_1\">%1$lld</value>%% de dégâts en plus contre les ennemis sous <keyword id=\"bleed\">Saignement</keyword>"
          }
