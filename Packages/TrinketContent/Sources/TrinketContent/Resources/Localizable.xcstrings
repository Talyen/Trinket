        "de": {"stringUnit": {"state": "translated", "value": "Gallertkörper"}},
        "en": {"stringUnit": {"state": "translated", "value": "Gelatinous Body"}},
        "es": {"stringUnit": {"state": "translated", "value": "Cuerpo gelatinoso"}},
