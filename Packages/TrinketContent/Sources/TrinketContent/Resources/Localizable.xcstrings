        "en": {"variations": {"plural": {"one": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">Mana</keyword> empowerment Purges <value id=\"quantity_1\">%1$lld</value> buff"}}, "other": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">Mana</keyword> empowerment Purges <value id=\"quantity_1\">%1$lld</value> buffs"}}}}},
        "es": {"variations": {"plural": {"many": {"stringUnit": {"state": "translated", "value": "Potenciar con <keyword id=\"mana\">Maná</keyword> purga <value id=\"quantity_1\">%1$lld</value> mejoras"}}, "one": {"stringUnit": {"state": "translated", "value": "Potenciar con <keyword id=\"mana\">Maná</keyword> purga <value id=\"quantity_1\">%1$lld</value> mejora"}}, "other": {"stringUnit": {"state": "translated", "value": "Potenciar con <keyword id=\"mana\">Maná</keyword> purga <value id=\"quantity_1\">%1$lld</value> mejoras"}}}}},
        "fr": {"variations": {"plural": {"many": {"stringUnit": {"state": "translated", "value": "Le renforcement au <keyword id=\"mana\">Mana</keyword> dissipe <value id=\"quantity_1\">%1$lld</value> bonus"}}, "one": {"stringUnit": {"state": "translated", "value": "Le renforcement au <keyword id=\"mana\">Mana</keyword> dissipe <value id=\"quantity_1\">%1$lld</value> bonus"}}, "other": {"stringUnit": {"state": "translated", "value": "Le renforcement au <keyword id=\"mana\">Mana</keyword> dissipe <value id=\"quantity_1\">%1$lld</value> bonus"}}}}},
        "ja": {"variations": {"plural": {"other": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">マナ</keyword>で強化すると強化効果を<value id=\"quantity_1\">%1$lld</value>個解除"}}}}},
        "ko": {"variations": {"plural": {"other": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">마나</keyword>로 강화 시 강화 해제로 적의 강화 효과 <value id=\"quantity_1\">%1$lld</value>개 제거"}}}}},
        "pt-BR": {"variations": {"plural": {"many": {"stringUnit": {"state": "translated", "value": "Fortalecer com <keyword id=\"mana\">Mana</keyword> Expurga <value id=\"quantity_1\">%1$lld</value> efeitos positivos"}}, "one": {"stringUnit": {"state": "translated", "value": "Fortalecer com <keyword id=\"mana\">Mana</keyword> Expurga <value id=\"quantity_1\">%1$lld</value> efeito positivo"}}, "other": {"stringUnit": {"state": "translated", "value": "Fortalecer com <keyword id=\"mana\">Mana</keyword> Expurga <value id=\"quantity_1\">%1$lld</value> efeitos positivos"}}}}},
        "zh-Hant": {"variations": {"plural": {"other": {"stringUnit": {"state": "translated", "value": "用<keyword id=\"mana\">魔力</keyword>強化時，驅散<value id=\"quantity_1\">%1$lld</value>項增益效果"}}}}}
