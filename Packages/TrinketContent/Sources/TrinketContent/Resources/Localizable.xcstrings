    "talents.shield_scarab_block_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: shield_scarab_block_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange du <keyword id=\"block\">Block</keyword> hast, verursachen <keyword id=\"thorns\">Dornen</keyword> <value id=\"quantity_1\">%1$lld</value>%% mehr Schaden"
