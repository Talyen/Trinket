    "affixes.spiteful.astral_description": {
      "comment": "ContentManifest/affixes.tsv: spiteful, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Gesundheit</keyword> wieder her, wenn <keyword id=\"thorns\">Dornen</keyword> in einem Zug erstmals Schaden verursachen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Health</keyword> the first time <keyword id=\"thorns\">Thorns</keyword> deals damage each turn"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Santé</keyword> la première fois que les <keyword id=\"thorns\">Épines</keyword> infligent des dégâts à chaque tour"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ターンに初めて<keyword id=\"thorns\">棘</keyword>がダメージを与えると<keyword id=\"health\">体力</keyword>を<value id=\"quantity_1\">%1$lld</value>回復"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매 턴 처음으로 <keyword id=\"thorns\">가시</keyword>가 피해를 주면 <keyword id=\"health\">체력</keyword> <value id=\"quantity_1\">%1$lld</value> 회복"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每回合<keyword id=\"thorns\">荊棘</keyword>首次造成傷害時，恢復<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"health\">生命值</keyword>"
          }
        }
      }
    },
