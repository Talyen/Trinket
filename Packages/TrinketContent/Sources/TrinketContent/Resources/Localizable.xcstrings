      "comment": "ContentManifest/affixes.tsv: kinbound, title",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verbunden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Kinbound"}},
        "es": {"stringUnit": {"state": "translated", "value": "Vinculado"}},
