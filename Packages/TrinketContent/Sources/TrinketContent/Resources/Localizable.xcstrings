    "homestead_nodes.crystalgarden.1.bonus_description": {
      "comment": "ContentManifest/homestead_nodes.tsv: crystalGarden.1, bonus_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhöhe kritischen Schaden um <value id=\"quantity_1\">%1$lld</value>%%\nProduziere <value id=\"quantity_2\">%2$lld</value> Edelsteine pro Tag\nProduziere <value id=\"quantity_3\">%3$lld</value> Stein pro Tag"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Increase Critical damage by <value id=\"quantity_1\">%1$lld</value>%%\nProduce <value id=\"quantity_2\">%2$lld</value> Gems per Day\nProduce <value id=\"quantity_3\">%3$lld</value> Stone per Day"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dégâts critiques augmentés de <value id=\"quantity_1\">%1$lld</value>%%\nProduit <value id=\"quantity_2\">%2$lld</value> gemmes par jour\nProduit <value id=\"quantity_3\">%3$lld</value> pierre par jour"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリティカルダメージが<value id=\"quantity_1\">%1$lld</value>%%増加\n1日に宝石を<value id=\"quantity_2\">%2$lld</value>生産\n1日に石材を<value id=\"quantity_3\">%3$lld</value>生産"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "치명타 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가\n하루에 보석 <value id=\"quantity_2\">%2$lld</value>개 생산\n하루에 석재 <value id=\"quantity_3\">%3$lld</value>개 생산"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暴擊傷害提高<value id=\"quantity_1\">%1$lld</value>%%\n每天生產<value id=\"quantity_2\">%2$lld</value>寶石\n每天生產<value id=\"quantity_3\">%3$lld</value>石材"
          }
        }
      }
    },
