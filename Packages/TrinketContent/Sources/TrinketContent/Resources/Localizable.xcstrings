    "affixes.steelsong.astral_description": {
      "comment": "ContentManifest/affixes.tsv: steelsong, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ein gespielter Angriff erhöht deinen nächsten <keyword id=\"block\">Block</keyword>-Gewinn um <value id=\"quantity_1\">%1$lld</value>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Playing an attack adds <value id=\"quantity_1\">%1$lld</value> to your next <keyword id=\"block\">Block</keyword> gain"}},
        "es": {"stringUnit": {"state": "translated", "value": "Jugar un ataque añade <value id=\"quantity_1\">%1$lld</value> a tu próxima ganancia de <keyword id=\"block\">Bloqueo</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Jouer une attaque ajoute <value id=\"quantity_1\">%1$lld</value> à votre prochain gain de <keyword id=\"block\">Blocage</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "攻撃カードを使うと、次に獲得する<keyword id=\"block\">ブロック</keyword>が<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "공격 카드를 사용하면 다음에 얻는 <keyword id=\"block\">방어도</keyword>가 <value id=\"quantity_1\">%1$lld</value> 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Jogar um ataque adiciona <value id=\"quantity_1\">%1$lld</value> ao seu próximo ganho de <keyword id=\"block\">Bloqueio</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "打出攻擊牌後，下一次獲得的<keyword id=\"block\">格擋</keyword>提高<value id=\"quantity_1\">%1$lld</value>"}}
      }
    },
