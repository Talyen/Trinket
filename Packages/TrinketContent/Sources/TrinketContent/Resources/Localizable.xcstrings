    "talents.frost_whelp_dodge_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: frost_whelp_dodge_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein erstes <keyword id=\"dodge\">Ausweichen</keyword> in jedem Kampf lässt deinen Verbündeten eine Karte ziehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your first <keyword id=\"dodge\">Dodge</keyword> each combat draws a card for your ally"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre première <keyword id=\"dodge\">Esquive</keyword> de chaque combat fait piocher une carte à votre allié"
          }
        },
        "ja": {
          "stringUnit": {
