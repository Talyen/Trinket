    "affixes.smoldering.astral_description": {
      "comment": "ContentManifest/affixes.tsv: smoldering, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erhöhe <keyword id=\"burn\">Brand</keyword>schaden um <value id=\"quantity_1\">%1$lld</value>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Increase <keyword id=\"burn\">Burn</keyword> damage by <value id=\"quantity_1\">%1$lld</value>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Aumenta el daño de <keyword id=\"burn\">Quemadura</keyword> en <value id=\"quantity_1\">%1$lld</value>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Dégâts de <keyword id=\"burn\">Brûlure</keyword> augmentés de <value id=\"quantity_1\">%1$lld</value>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">炎上</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">화상</keyword> 피해 <value id=\"quantity_1\">%1$lld</value> 증가"}},
