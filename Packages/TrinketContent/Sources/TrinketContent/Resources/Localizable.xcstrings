      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein erstes Ausgeben von <keyword id=\"mana\">Mana</keyword> in jedem Zug erstattet <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword>"
