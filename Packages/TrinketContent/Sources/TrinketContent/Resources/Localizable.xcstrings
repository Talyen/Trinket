    "talents.mana_moth_mana_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: mana_moth_mana_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verstärken mit <keyword id=\"mana\">Mana</keyword> erhöht <keyword id=\"burn\">Brand</keyword>- und <keyword id=\"freeze\">Frost</keyword>schaden um <value id=\"quantity_1\">%1$lld</value>%%"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">Mana</keyword> empowerment increases <keyword id=\"burn\">Burn</keyword> and <keyword id=\"freeze\">Freeze</keyword> damage by <value id=\"quantity_1\">%1$lld</value>%%"}},
        "es": {"stringUnit": {"state": "translated", "value": "Potenciar con <keyword id=\"mana\">Maná</keyword> aumenta el daño de <keyword id=\"burn\">Quemadura</keyword> y <keyword id=\"freeze\">Congelación</keyword> en un <value id=\"quantity_1\">%1$lld</value>%%"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Un renforcement au <keyword id=\"mana\">Mana</keyword> augmente les dégâts de <keyword id=\"burn\">Brûlure</keyword> et de <keyword id=\"freeze\">Gel</keyword> de <value id=\"quantity_1\">%1$lld</value>%%"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">マナ</keyword>で強化すると<keyword id=\"burn\">炎上</keyword>と<keyword id=\"freeze\">凍結</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">마나</keyword>로 강화 시 <keyword id=\"burn\">화상</keyword> 및 <keyword id=\"freeze\">빙결</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Fortalecer com <keyword id=\"mana\">Mana</keyword> aumenta o dano de <keyword id=\"burn\">Queimadura</keyword> e de <keyword id=\"freeze\">Congelamento</keyword> em <value id=\"quantity_1\">%1$lld</value>%%"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "以<keyword id=\"mana\">魔力</keyword>強化時，<keyword id=\"burn\">燃燒</keyword>與<keyword id=\"freeze\">冰凍</keyword>傷害提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
