        "es": {"stringUnit": {"state": "translated", "value": "Canalización de hechizos"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Canalisation de sort"}},
        "ja": {"stringUnit": {"state": "translated", "value": "魔力詠唱"}},
        "ko": {"stringUnit": {"state": "translated", "value": "주문 집중"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Canalização de Feitiços"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "法術引導"}}
      }
    },
    "talents.frost_whelp_mana_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: frost_whelp_mana_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verstärken mit <keyword id=\"mana\">Mana</keyword> gewährt deinem Verbündeten <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">Mana</keyword> empowerment grants your ally <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Potenciar con <keyword id=\"mana\">Maná</keyword> otorga a tu aliado <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueo</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Un renforcement au <keyword id=\"mana\">Mana</keyword> octroie <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Blocage</keyword> à votre allié"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">マナ</keyword>で強化すると、味方に<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>付与"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">마나</keyword>로 강화 시 아군에게 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 부여"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Fortalecer com <keyword id=\"mana\">Mana</keyword> concede <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueio</keyword> ao seu aliado"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "以<keyword id=\"mana\">魔力</keyword>強化時，賦予友方<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>"}}
      }
    },
    "talents.frost_whelp_mana_t4_1.name": {
      "comment": "ContentManifest/talents.tsv: frost_whelp_mana_t4_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Drachengunst"}},
        "en": {"stringUnit": {"state": "translated", "value": "Dragon’s Patronage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Patrocinio del dragón"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Mécénat du dragon"}},
        "ja": {"stringUnit": {"state": "translated", "value": "竜の庇護"}},
        "ko": {"stringUnit": {"state": "translated", "value": "용의 후원"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Patrocínio do Dragão"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "龍之庇護"}}
      }
    },
    "talents.golden_retriever_block_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: golden_retriever_block_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Gewähre deinem Verbündeten vor dem ersten Angriff gegen ihn <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Grant your ally <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword> before their first incoming attack"}},
        "es": {"stringUnit": {"state": "translated", "value": "Otorga a tu aliado <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueo</keyword> antes del primer ataque que reciba"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Octroyez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Blocage</keyword> à votre allié avant la première attaque qu’il reçoit"}},
        "ja": {"stringUnit": {"state": "translated", "value": "味方が最初の攻撃を受ける前に、その味方に<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>付与"}},
        "ko": {"stringUnit": {"state": "translated", "value": "아군이 처음 공격받기 전에 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 부여"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Conceda <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueio</keyword> ao seu aliado antes do primeiro ataque que ele receber"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "友方首次受到攻擊前，賦予其<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>"}}
      }
    },
    "talents.golden_retriever_block_t1_1.name": {
      "comment": "ContentManifest/talents.tsv: golden_retriever_block_t1_1, name",
