    "talents.pixie_cleanse_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: pixie_cleanse_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Stelle <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Gesundheit</keyword> beim Verbündeten mit der niedrigsten <keyword id=\"health\">Gesundheit</keyword> wieder her, wenn du <keyword id=\"cleanse\">reinigst</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Restore <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Health</keyword> to the lowest <keyword id=\"health\">Health</keyword> ally when you <keyword id=\"cleanse\">Cleanse</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Restaura <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Salud</keyword> al aliado con menos <keyword id=\"health\">Salud</keyword> cuando usas <keyword id=\"cleanse\">Purificación</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Restaurez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Santé</keyword> à l’allié ayant le moins de <keyword id=\"health\">Santé</keyword> lors d’une <keyword id=\"cleanse\">Purification</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"cleanse\">浄化</keyword>すると、<keyword id=\"health\">体力</keyword>が最も低い味方の<keyword id=\"health\">体力</keyword>を<value id=\"quantity_1\">%1$lld</value>回復"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"cleanse\">정화</keyword> 시 <keyword id=\"health\">체력</keyword>이 가장 낮은 아군의 <keyword id=\"health\">체력</keyword> <value id=\"quantity_1\">%1$lld</value> 회복"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Restaure <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Vida</keyword> do aliado com menos <keyword id=\"health\">Vida</keyword> ao <keyword id=\"cleanse\">Purificar</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"cleanse\">淨化</keyword>時，為<keyword id=\"health\">生命值</keyword>最低的友方恢復<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"health\">生命值</keyword>"}}
      }
    },
