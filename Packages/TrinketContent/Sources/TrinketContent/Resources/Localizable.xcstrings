            "value": "치명타로 적용된 <keyword id=\"bleed\">출혈</keyword> 지속 시간 <value id=\"quantity_1\">%1$lld</value>턴 증가"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暴擊造成的<keyword id=\"bleed\">流血</keyword>額外持續<value id=\"quantity_1\">%1$lld</value>回合"
          }
        }
      }
    },
