    "talents.rogue_gold_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: rogue_gold_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kritische Treffer stehlen <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Gold</keyword>"
          }
        },
