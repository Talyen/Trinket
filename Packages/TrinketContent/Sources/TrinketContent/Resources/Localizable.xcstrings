    "talents.wildcard_gold_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: wildcard_gold_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Der Erhalt von <keyword id=\"gold\">Gold</keyword> unter halber <keyword id=\"health\">Gesundheit</keyword> lässt dich eine Karte ziehen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Gaining <keyword id=\"gold\">Gold</keyword> while below half <keyword id=\"health\">Health</keyword> draws a card"}},
        "es": {"stringUnit": {"state": "translated", "value": "Obtener <keyword id=\"gold\">Oro</keyword> mientras estás por debajo de la mitad de <keyword id=\"health\">Salud</keyword> hace que robes una carta"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Gagner de l’<keyword id=\"gold\">Or</keyword> sous la moitié de votre <keyword id=\"health\">Santé</keyword> fait piocher une carte"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>が半分未満の間に<keyword id=\"gold\">ゴールド</keyword>を獲得すると、カードを1枚引く"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword>이 절반 미만일 때 <keyword id=\"gold\">골드</keyword>를 획득하면 카드 한 장 뽑기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ganhar <keyword id=\"gold\">Ouro</keyword> enquanto estiver abaixo de metade da <keyword id=\"health\">Vida</keyword> faz você comprar uma carta"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">生命值</keyword>低於一半時獲得<keyword id=\"gold\">金幣</keyword>，抽一張牌"}}
      }
    },
    "talents.wildcard_gold_t3_1.name": {
      "comment": "ContentManifest/talents.tsv: wildcard_gold_t3_1, name",
