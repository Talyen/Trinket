    "authored.d291ed3cae9b5488": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog+Ranged.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Deine <keyword id=\"physical\">physischen</keyword> kritischen Treffer, die <keyword id=\"health\">Gesundheit</keyword> abziehen, lassen dich vom Deck deines Gefährten ziehen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your <keyword id=\"physical\">Physical</keyword> Critical Hits that remove <keyword id=\"health\">Health</keyword> draw from your Companion's deck"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tus golpes críticos <keyword id=\"physical\">físicos</keyword> que reducen <keyword id=\"health\">Salud</keyword> hacen que robes del mazo de tu compañero"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Vos coups critiques de type <keyword id=\"physical\">Physique</keyword> qui retirent de la <keyword id=\"health\">Santé</keyword> font piocher dans le paquet de votre Compagnon"}},
        "ja": {"stringUnit": {"state": "translated", "value": "自分の<keyword id=\"physical\">物理</keyword>クリティカルヒットで<keyword id=\"health\">体力</keyword>を減らすと、仲間のデッキからカードを1枚引く"}},
        "ko": {"stringUnit": {"state": "translated", "value": "내 <keyword id=\"physical\">물리</keyword> 치명타가 <keyword id=\"health\">체력</keyword>을 깎으면 동료의 덱에서 카드 뽑기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seus golpes críticos <keyword id=\"physical\">Físicos</keyword> que removem <keyword id=\"health\">Vida</keyword> fazem você comprar do baralho do seu Companheiro"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "自身<keyword id=\"physical\">物理</keyword>暴擊使敵人失去<keyword id=\"health\">生命值</keyword>時，從夥伴牌組抽牌"}}
      }
    },
    "authored.d2e58983fcedb971": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/InventoryItem+Compatibility.swift: canonical numeric compatibility description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Einmal pro Zug: Ausweichen bringt deine zuletzt gespielte Angriffskarte auf deine Hand zurück"}},
        "en": {"stringUnit": {"state": "translated", "value": "Once per turn, Dodging returns your last attack card"}},
        "es": {"stringUnit": {"state": "translated", "value": "Una vez por turno, esquivar devuelve a tu mano la última carta de ataque que jugaste"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Une fois par tour, une esquive renvoie dans votre main la dernière carte d’attaque que vous avez jouée"}},
        "ja": {"stringUnit": {"state": "translated", "value": "1ターンに1回、回避すると最後に使った攻撃カードが手札に戻る"}},
        "ko": {"stringUnit": {"state": "translated", "value": "턴마다 한 번, 회피 시 마지막으로 사용한 공격 카드를 손패로 반환"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Uma vez por turno, esquivar devolve à sua mão a última carta de ataque que você jogou"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每回合一次，閃避時將你最後打出的攻擊卡牌返回手牌"}}
      }
    },
    "authored.d3657c570dbd1675": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/InventoryItem+Compatibility.swift: canonical numeric compatibility description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dein <keyword id=\"burn\">Brand</keyword> verursacht <value id=\"quantity_1\">%1$lld</value> zusätzlichen Schaden bei <keyword id=\"poison\">vergifteten</keyword> Gegnern"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your <keyword id=\"burn\">Burn</keyword> deals <value id=\"quantity_1\">%1$lld</value> additional damage to <keyword id=\"poison\">Poisoned</keyword> enemies"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu <keyword id=\"burn\">Quemadura</keyword> inflige <value id=\"quantity_1\">%1$lld</value> de daño adicional a enemigos <keyword id=\"poison\">envenenados</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre <keyword id=\"burn\">Brûlure</keyword> inflige <value id=\"quantity_1\">%1$lld</value> dégâts supplémentaires aux ennemis <keyword id=\"poison\">empoisonnés</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "あなたの<keyword id=\"burn\">炎上</keyword>は、<keyword id=\"poison\">毒</keyword>状態の敵に<value id=\"quantity_1\">%1$lld</value>の追加ダメージを与える"}},
        "ko": {"stringUnit": {"state": "translated", "value": "자신의 <keyword id=\"burn\">화상</keyword>이 <keyword id=\"poison\">독</keyword>에 걸린 적에게 <value id=\"quantity_1\">%1$lld</value>의 추가 피해를 줍니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Sua <keyword id=\"burn\">Queimadura</keyword> causa <value id=\"quantity_1\">%1$lld</value> de dano adicional a inimigos <keyword id=\"poison\">Envenenados</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "你的<keyword id=\"burn\">燃燒</keyword>對<keyword id=\"poison\">中毒</keyword>的敵人額外造成<value id=\"quantity_1\">%1$lld</value>點傷害"}}
      }
    },
