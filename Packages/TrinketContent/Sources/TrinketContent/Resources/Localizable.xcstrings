    "affixes.manabound.astral_description": {
      "comment": "ContentManifest/affixes.tsv: manabound, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erhöhe maximales <keyword id=\"mana\">Mana</keyword> um <value id=\"quantity_1\">%1$lld</value>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Increase Maximum <keyword id=\"mana\">Mana</keyword> by <value id=\"quantity_1\">%1$lld</value>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Aumenta el <keyword id=\"mana\">Maná</keyword> máximo en <value id=\"quantity_1\">%1$lld</value>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">Mana</keyword> maximal augmenté de <value id=\"quantity_1\">%1$lld</value>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "最大<keyword id=\"mana\">マナ</keyword>が<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "최대 <keyword id=\"mana\">마나</keyword> <value id=\"quantity_1\">%1$lld</value> 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Aumente a <keyword id=\"mana\">Mana</keyword> máxima em <value id=\"quantity_1\">%1$lld</value>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "最大<keyword id=\"mana\">魔力</keyword>增加<value id=\"quantity_1\">%1$lld</value>點"}}
      }
    },
