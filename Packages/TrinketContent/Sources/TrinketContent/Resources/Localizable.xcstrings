    "affixes.reactive.astral_description": {
      "comment": "ContentManifest/affixes.tsv: reactive, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wenn dein <keyword id=\"block\">Block</keyword> bricht, füge dem Angreifer <value id=\"quantity_1\">%1$lld</value> <keyword id=\"stun\">Betäubungsschaden</keyword> zu"}},
        "en": {"stringUnit": {"state": "translated", "value": "When your <keyword id=\"block\">Block</keyword> breaks, deal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"stun\">Stun</keyword> damage to the attacker"}},
        "es": {"stringUnit": {"state": "translated", "value": "Cuando se rompe tu <keyword id=\"block\">Bloqueo</keyword>, inflige <value id=\"quantity_1\">%1$lld</value> de daño de <keyword id=\"stun\">Aturdimiento</keyword> al atacante"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Quand votre <keyword id=\"block\">Blocage</keyword> est brisé, infligez <value id=\"quantity_1\">%1$lld</value> dégâts d’<keyword id=\"stun\">Étourdissement</keyword> à l’attaquant"}},
        "ja": {"stringUnit": {"state": "translated", "value": "自分の<keyword id=\"block\">ブロック</keyword>が破られると、攻撃者に<value id=\"quantity_1\">%1$lld</value>の<keyword id=\"stun\">スタン</keyword>ダメージを与える"}},
        "ko": {"stringUnit": {"state": "translated", "value": "자신의 <keyword id=\"block\">방어도</keyword>가 깨지면 공격자에게 <keyword id=\"stun\">기절</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Quando seu <keyword id=\"block\">Bloqueio</keyword> se rompe, cause <value id=\"quantity_1\">%1$lld</value> de dano de <keyword id=\"stun\">Atordoamento</keyword> ao atacante"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "自身<keyword id=\"block\">格擋</keyword>被擊破時，對攻擊者造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"stun\">暈眩</keyword>傷害"}}
      }
    },
