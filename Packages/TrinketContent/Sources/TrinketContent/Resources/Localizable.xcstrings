    "talents.panther_bleed_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: panther_bleed_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Gegner mit mindestens <value id=\"quantity_1\">%1$lld</value> <keyword id=\"bleed\">Blutungs</keyword>stapeln verursachen <value id=\"quantity_2\">%2$lld</value>%% weniger Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Enemies with <value id=\"quantity_1\">%1$lld</value> or more <keyword id=\"bleed\">Bleed</keyword> stacks deal <value id=\"quantity_2\">%2$lld</value>%% less damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los enemigos con <value id=\"quantity_1\">%1$lld</value> o más acumulaciones de <keyword id=\"bleed\">Sangrado</keyword> infligen un <value id=\"quantity_2\">%2$lld</value>%% menos de daño"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les ennemis ayant au moins <value id=\"quantity_1\">%1$lld</value> cumuls de <keyword id=\"bleed\">Saignement</keyword> infligent <value id=\"quantity_2\">%2$lld</value>%% de dégâts en moins"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">出血</keyword>が<value id=\"quantity_1\">%1$lld</value>以上蓄積した敵の与えるダメージが<value id=\"quantity_2\">%2$lld</value>%%減少"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">출혈</keyword>이 <value id=\"quantity_1\">%1$lld</value>중첩 이상인 적이 주는 피해 <value id=\"quantity_2\">%2$lld</value>%% 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Inimigos com <value id=\"quantity_1\">%1$lld</value> ou mais acúmulos de <keyword id=\"bleed\">Sangramento</keyword> causam <value id=\"quantity_2\">%2$lld</value>%% menos dano"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">流血</keyword>累積達<value id=\"quantity_1\">%1$lld</value>層以上的敵人，造成的傷害降低<value id=\"quantity_2\">%2$lld</value>%%"}}
      }
    },
