    "talents.warlock_burn_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: warlock_burn_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">Brennende</keyword> Gegner erleiden <value id=\"quantity_1\">%1$lld</value>%% zusätzlichen Schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">Burning</keyword> enemies take <value id=\"quantity_1\">%1$lld</value>%% additional damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les ennemis sous <keyword id=\"burn\">Brûlure</keyword> subissent <value id=\"quantity_1\">%1$lld</value>%% de dégâts supplémentaires"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">炎上</keyword>状態の敵が受けるダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">화상</keyword> 상태의 적이 받는 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">燃燒</keyword>中的敵人承受的傷害增加<value id=\"quantity_1\">%1$lld</value>%%"
          }
        }
      }
    },
