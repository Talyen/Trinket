    "talents.golden_retriever_block_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: golden_retriever_block_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du in einem Zug erstmals <keyword id=\"block\">Block</keyword> erhältst, erhält dein Verbündeter ebenso viel"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your first <keyword id=\"block\">Block</keyword> gain each turn is shared with your ally"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre premier gain de <keyword id=\"block\">Blocage</keyword> de chaque tour est partagé avec votre allié"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ターンで最初の<keyword id=\"block\">ブロック</keyword>獲得量を味方とも共有"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매 턴 첫 <keyword id=\"block\">방어도</keyword> 획득량을 아군과 공유"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每回合首次獲得的<keyword id=\"block\">格擋</keyword>與友方共享"
          }
        }
      }
    },
