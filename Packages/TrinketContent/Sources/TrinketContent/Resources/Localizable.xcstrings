    "affixes.shatter.astral_description": {
      "comment": "ContentManifest/affixes.tsv: shatter, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verursache <value id=\"quantity_1\">%1$lld</value> zusätzlichen Schaden, solange der Gegner <keyword id=\"freeze\">eingefroren</keyword> ist"}},
        "en": {"stringUnit": {"state": "translated", "value": "Deal <value id=\"quantity_1\">%1$lld</value> additional damage while the enemy is <keyword id=\"freeze\">Frozen</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Inflige <value id=\"quantity_1\">%1$lld</value> de daño adicional mientras el enemigo está <keyword id=\"freeze\">congelado</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Infligez <value id=\"quantity_1\">%1$lld</value> dégâts supplémentaires à un ennemi sous <keyword id=\"freeze\">Gel</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "敵が<keyword id=\"freeze\">凍結</keyword>状態の間、与えるダメージが<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "적이 <keyword id=\"freeze\">빙결</keyword> 상태이면 추가 피해 <value id=\"quantity_1\">%1$lld</value>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cause <value id=\"quantity_1\">%1$lld</value> de dano adicional enquanto o inimigo estiver <keyword id=\"freeze\">Congelado</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "敵人<keyword id=\"freeze\">冰凍</keyword>時，額外造成<value id=\"quantity_1\">%1$lld</value>點傷害"}}
      }
    },
