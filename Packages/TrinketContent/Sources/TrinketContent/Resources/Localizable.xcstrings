    "talents.wildcard_dodge_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: wildcard_dodge_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ausweichen gewährt deinem nächsten Angriff +<value id=\"quantity_1\">%1$lld</value>%% Chance auf kritische Treffer"}},
        "en": {"stringUnit": {"state": "translated", "value": "Dodging grants +<value id=\"quantity_1\">%1$lld</value>%% Critical Hit chance on your next attack"}},
        "es": {"stringUnit": {"state": "translated", "value": "Esquivar otorga +<value id=\"quantity_1\">%1$lld</value>%% de probabilidad de golpe crítico en tu siguiente ataque"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Une esquive octroie +<value id=\"quantity_1\">%1$lld</value>%% de chances de coup critique à votre prochaine attaque"}},
        "ja": {"stringUnit": {"state": "translated", "value": "回避すると、次の攻撃のクリティカル率が<value id=\"quantity_1\">%1$lld</value>%%上昇"}},
        "ko": {"stringUnit": {"state": "translated", "value": "회피 시 다음 공격의 치명타 확률 +<value id=\"quantity_1\">%1$lld</value>%%"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Esquivar concede +<value id=\"quantity_1\">%1$lld</value>%% de chance de golpe crítico no seu próximo ataque"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "閃避後，下次攻擊的暴擊機率提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
