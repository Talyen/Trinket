    "affixes.solace.astral_description": {
      "comment": "ContentManifest/affixes.tsv: solace, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword>, wenn du <value id=\"quantity_2\">%2$lld</value> Schwächungseffekt <keyword id=\"cleanse\">reinigst</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gain <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword> when you <keyword id=\"cleanse\">Cleanse</keyword> <value id=\"quantity_2\">%2$lld</value> debuff"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagne <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"mana\">Mana</keyword> lors de la <keyword id=\"cleanse\">Purification</keyword> de <value id=\"quantity_2\">%2$lld</value> malus"
          }
