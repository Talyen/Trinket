    "talents.druid_poison_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: druid_poison_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wenn dein <keyword id=\"poison\">Gift</keyword> von selbst endet, heile den Verbündeten mit der niedrigsten <keyword id=\"health\">Gesundheit</keyword> um <value id=\"quantity_1\">%1$lld</value>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your <keyword id=\"poison\">Poison</keyword> naturally expiring heals the lowest-<keyword id=\"health\">Health</keyword> ally for <value id=\"quantity_1\">%1$lld</value>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Cuando tu <keyword id=\"poison\">Veneno</keyword> expira de forma natural, cura <value id=\"quantity_1\">%1$lld</value> al aliado con menos <keyword id=\"health\">Salud</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "La fin naturelle de votre <keyword id=\"poison\">Poison</keyword> soigne l’allié ayant le moins de <keyword id=\"health\">Santé</keyword> de <value id=\"quantity_1\">%1$lld</value>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "自分が与えた<keyword id=\"poison\">毒</keyword>が自然消滅すると、<keyword id=\"health\">体力</keyword>が最も低い味方を<value id=\"quantity_1\">%1$lld</value>回復"}},
        "ko": {"stringUnit": {"state": "translated", "value": "내 <keyword id=\"poison\">독</keyword>이 자연적으로 끝나면 <keyword id=\"health\">체력</keyword>이 가장 낮은 아군을 <value id=\"quantity_1\">%1$lld</value> 치유"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seu <keyword id=\"poison\">Veneno</keyword> expirar naturalmente cura em <value id=\"quantity_1\">%1$lld</value> o aliado com menos <keyword id=\"health\">Vida</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "自身施加的<keyword id=\"poison\">中毒</keyword>自然消退時，為<keyword id=\"health\">生命值</keyword>最低的友方恢復<value id=\"quantity_1\">%1$lld</value>點生命值"}}
      }
    },
    "talents.druid_poison_t2_2.name": {
      "comment": "ContentManifest/talents.tsv: druid_poison_t2_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wiederkehrende Blüte"}},
        "en": {"stringUnit": {"state": "translated", "value": "Returning Bloom"}},
        "es": {"stringUnit": {"state": "translated", "value": "Flor que regresa"}},
