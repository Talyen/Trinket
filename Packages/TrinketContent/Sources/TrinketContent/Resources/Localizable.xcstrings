        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>耐性"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword> 저항"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Resistência a <keyword id=\"health\">Vida</keyword>"}},
