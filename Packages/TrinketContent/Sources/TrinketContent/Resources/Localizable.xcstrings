    "authored.0808ca57dd2cdb14": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Encounters/Mystery/MysteryEventPool+Events.swift: narrative",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Eisenader legt „%1$@“ frei, und umgestürzte Stämme halten in der Nähe „%2$@“ fest"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An iron seam reveals “%1$@”, and fallen timber traps “%2$@” nearby"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un filon de fer révèle « %1$@ », tandis que du bois tombé emprisonne « %2$@ » à proximité"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鉄の鉱脈から「%1$@」が現れ、近くでは倒木が「%2$@」を閉じ込めている"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "철광맥이 드러낸 것은 ‘%1$@’, 근처 쓰러진 나무에 갇힌 것은 ‘%2$@’입니다"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鐵礦脈顯露出「%1$@」，附近倒下的木材困住了「%2$@」"
          }
        }
      }
    },
    "authored.08f41d507a8f1751": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Encounters/Mystery/MysteryEventPool+Events.swift: narrative",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter der Quelle umschließen Kristalle „%1$@“, während heilende Wellen „%2$@“ enthüllen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Beneath the spring, crystal traps “%1$@” while healing ripples reveal “%2$@”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sous la source, le cristal emprisonne « %1$@ », tandis que des ondulations curatives révèlent « %2$@ »"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "泉の底では水晶が「%1$@」を閉じ込め、癒やしの波紋が「%2$@」を浮かび上がらせる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샘 아래 수정에 갇힌 것은 ‘%1$@’, 치유의 물결이 드러낸 것은 ‘%2$@’입니다"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "泉水之下，水晶困住了「%1$@」，療癒的漣漪則顯露出「%2$@」"
          }
        }
      }
    },
