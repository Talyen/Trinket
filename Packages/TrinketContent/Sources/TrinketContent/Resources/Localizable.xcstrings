    "affixes.second_wind.astral_description": {
      "comment": "ContentManifest/affixes.tsv: second_wind, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Gesundheit</keyword> wieder her, wenn du erstmals unter <value id=\"quantity_2\">%2$lld</value>%% <keyword id=\"health\">Gesundheit</keyword> fällst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Health</keyword> the first time you fall below <value id=\"quantity_2\">%2$lld</value>%% <keyword id=\"health\">Health</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Santé</keyword> la première fois que vous passez sous <value id=\"quantity_2\">%2$lld</value>%% de <keyword id=\"health\">Santé</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初めて<keyword id=\"health\">体力</keyword>が<value id=\"quantity_2\">%2$lld</value>%%未満になると<keyword id=\"health\">体力</keyword>を<value id=\"quantity_1\">%1$lld</value>回復"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처음으로 <keyword id=\"health\">체력</keyword>이 <value id=\"quantity_2\">%2$lld</value>%% 미만이 되면 <keyword id=\"health\">체력</keyword> <value id=\"quantity_1\">%1$lld</value> 회복"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">生命值</keyword>首次低於<value id=\"quantity_2\">%2$lld</value>%%時，恢復<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"health\">生命值</keyword>"
          }
        }
      }
    },
