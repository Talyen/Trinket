    "talents.risen_skeleton_physical_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_physical_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"block\">Block</keyword> absorbiert doppelt so viel <keyword id=\"physical\">physischen</keyword> Schaden"
