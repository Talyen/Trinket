    "talents.alchemist_health_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: alchemist_health_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbündete unter halber <keyword id=\"health\">Gesundheit</keyword> stellen <value id=\"quantity_1\">%1$lld</value> zusätzliche <keyword id=\"health\">Gesundheit</keyword> wieder her"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allies below half <keyword id=\"health\">Health</keyword> restore <value id=\"quantity_1\">%1$lld</value> additional <keyword id=\"health\">Health</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alliés sous la moitié de leur <keyword id=\"health\">Santé</keyword> restaurent <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Santé</keyword> de plus"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">体力</keyword>が半分未満の味方の<keyword id=\"health\">体力</keyword>回復量が<value id=\"quantity_1\">%1$lld</value>増加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">체력</keyword>이 절반 미만인 아군의 <keyword id=\"health\">체력</keyword> <value id=\"quantity_1\">%1$lld</value> 추가 회복"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">生命值</keyword>低於一半的友方額外恢復<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"health\">生命值</keyword>"
          }
        }
      }
    },
