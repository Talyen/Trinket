    "talents.shield_scarab_block_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: shield_scarab_block_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Solange du <keyword id=\"block\">Block</keyword> hast, verursachen <keyword id=\"thorns\">Dornen</keyword> <value id=\"quantity_1\">%1$lld</value>%% mehr Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "While you have <keyword id=\"block\">Block</keyword>, <keyword id=\"thorns\">Thorns</keyword> deal <value id=\"quantity_1\">%1$lld</value>%% more damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Mientras tienes <keyword id=\"block\">Bloqueo</keyword>, <keyword id=\"thorns\">Espinas</keyword> infligen un <value id=\"quantity_1\">%1$lld</value>%% más de daño"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Tant que vous avez du <keyword id=\"block\">Blocage</keyword>, les <keyword id=\"thorns\">Épines</keyword> infligent <value id=\"quantity_1\">%1$lld</value>%% de dégâts en plus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">ブロック</keyword>がある間、<keyword id=\"thorns\">棘</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">방어도</keyword>가 있으면 <keyword id=\"thorns\">가시</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Enquanto tiver <keyword id=\"block\">Bloqueio</keyword>, <keyword id=\"thorns\">Espinhos</keyword> causam <value id=\"quantity_1\">%1$lld</value>%% mais dano"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "擁有<keyword id=\"block\">格擋</keyword>時，<keyword id=\"thorns\">荊棘</keyword>傷害提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.shield_scarab_block_t3_1.name": {
      "comment": "ContentManifest/talents.tsv: shield_scarab_block_t3_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Stachelpanzer"}},
        "en": {"stringUnit": {"state": "translated", "value": "Spiked Shell"}},
        "es": {"stringUnit": {"state": "translated", "value": "Caparazón de púas"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Carapace à pointes"}},
        "ja": {"stringUnit": {"state": "translated", "value": "棘の甲羅"}},
        "ko": {"stringUnit": {"state": "translated", "value": "가시 껍질"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Casco Espinhoso"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "尖刺殼"}}
      }
    },
    "talents.shield_scarab_block_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: shield_scarab_block_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wenn dein <keyword id=\"block\">Block</keyword> durchbrochen wird, verursacht dein nächster <keyword id=\"holy\">heiliger</keyword> Treffer doppelten Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "When your <keyword id=\"block\">Block</keyword> breaks, your next <keyword id=\"holy\">Holy</keyword> hit deals double damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Cuando se rompe tu <keyword id=\"block\">Bloqueo</keyword>, tu siguiente impacto <keyword id=\"holy\">sagrado</keyword> inflige el doble de daño"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Lorsque votre <keyword id=\"block\">Blocage</keyword> est brisé, votre prochain coup de type <keyword id=\"holy\">Sacré</keyword> inflige le double de dégâts"}},
        "ja": {"stringUnit": {"state": "translated", "value": "自分の<keyword id=\"block\">ブロック</keyword>が崩れると、次の<keyword id=\"holy\">聖</keyword>ヒットのダメージが2倍になる"}},
        "ko": {"stringUnit": {"state": "translated", "value": "내 <keyword id=\"block\">방어도</keyword>가 깨지면 다음 <keyword id=\"holy\">신성</keyword> 적중이 두 배의 피해를 줌"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Quando seu <keyword id=\"block\">Bloqueio</keyword> quebrar, seu próximo acerto <keyword id=\"holy\">Sagrado</keyword> causa o dobro de dano"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "自身<keyword id=\"block\">格擋</keyword>被擊破後，下次<keyword id=\"holy\">神聖</keyword>命中的傷害加倍"}}
      }
    },
    "talents.shield_scarab_block_t3_2.name": {
      "comment": "ContentManifest/talents.tsv: shield_scarab_block_t3_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Sonnengetroffener Panzer"}},
        "en": {"stringUnit": {"state": "translated", "value": "Sun-Struck Shell"}},
        "es": {"stringUnit": {"state": "translated", "value": "Caparazón tocado por el sol"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Carapace solaire"}},
        "ja": {"stringUnit": {"state": "translated", "value": "陽を浴びた甲羅"}},
        "ko": {"stringUnit": {"state": "translated", "value": "태양을 머금은 껍질"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Casco Banhado de Sol"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "日耀甲殼"}}
      }
    },
    "talents.shield_scarab_block_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: shield_scarab_block_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dein <keyword id=\"block\">Block</keyword> absorbiert <value id=\"quantity_1\">%1$lld</value>%% mehr Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your <keyword id=\"block\">Block</keyword> absorbs <value id=\"quantity_1\">%1$lld</value>%% more damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu <keyword id=\"block\">Bloqueo</keyword> absorbe un <value id=\"quantity_1\">%1$lld</value>%% más de daño"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre <keyword id=\"block\">Blocage</keyword> absorbe <value id=\"quantity_1\">%1$lld</value>%% de dégâts en plus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "自分の<keyword id=\"block\">ブロック</keyword>のダメージ吸収量が<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "내 <keyword id=\"block\">방어도</keyword>의 피해 흡수량 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seu <keyword id=\"block\">Bloqueio</keyword> absorve <value id=\"quantity_1\">%1$lld</value>%% mais dano"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "自身<keyword id=\"block\">格擋</keyword>吸收的傷害提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.shield_scarab_block_t4_1.name": {
      "comment": "ContentManifest/talents.tsv: shield_scarab_block_t4_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Unbeugsamer Chitinpanzer"}},
        "en": {"stringUnit": {"state": "translated", "value": "Adamant Carapace"}},
        "es": {"stringUnit": {"state": "translated", "value": "Caparazón adamantino"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Carapace adamantine"}},
        "ja": {"stringUnit": {"state": "translated", "value": "金剛の甲殻"}},
        "ko": {"stringUnit": {"state": "translated", "value": "금강 갑각"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Carapaça Adamantina"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "金剛甲殼"}}
      }
