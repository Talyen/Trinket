    "talents.druid_health_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: druid_health_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Wiederherstellen von <keyword id=\"health\">Gesundheit</keyword> entfernt <value id=\"quantity_1\">%1$lld</value> gegnerische <keyword id=\"thorns\">Dornen</keyword>"
          }
