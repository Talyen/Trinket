    "traits.firestarter.description": {
      "comment": "ContentManifest/traits.tsv: firestarter, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Jeder Angriffstreffer verursacht <value id=\"quantity_1\">%1$lld</value> <keyword id=\"burn\">Brand</keyword>."}},
        "en": {"stringUnit": {"state": "translated", "value": "Attack hits inflict <value id=\"quantity_1\">%1$lld</value> <keyword id=\"burn\">Burn</keyword>."}},
        "es": {"stringUnit": {"state": "translated", "value": "Cada impacto de ataque aplica <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"burn\">Quemadura</keyword>."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Chaque coup d’une attaque applique <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"burn\">Brûlure</keyword>."}},
        "ja": {"stringUnit": {"state": "translated", "value": "攻撃の各ヒットで<keyword id=\"burn\">炎上</keyword>を<value id=\"quantity_1\">%1$lld</value>付与する。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "공격이 적중할 때마다 <keyword id=\"burn\">화상</keyword>을 <value id=\"quantity_1\">%1$lld</value> 부여한다."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cada acerto de ataque aplica <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"burn\">Queimadura</keyword>."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每次攻擊命中時，施加<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"burn\">燃燒</keyword>。"}}
      }
    },
    "traits.firestarter.name": {
      "comment": "ContentManifest/traits.tsv: firestarter, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Brandstifter"}},
        "en": {"stringUnit": {"state": "translated", "value": "Firestarter"}},
        "es": {"stringUnit": {"state": "translated", "value": "Incendiario"}},
