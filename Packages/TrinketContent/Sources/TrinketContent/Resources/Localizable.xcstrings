        "pt-BR": {"stringUnit": {"state": "translated", "value": "Esquivar aumenta o dano do seu próximo golpe crítico em <value id=\"quantity_1\">%1$lld</value>%%"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "閃避後，下次暴擊的傷害提高<value id=\"quantity_1\">%1$lld</value>%%"}}
