        "ko": {"stringUnit": {"state": "translated", "value": "약화 효과 <value id=\"quantity_2\">%2$lld</value>개를 <keyword id=\"cleanse\">정화</keyword>하면 <keyword id=\"mana\">마나</keyword> <value id=\"quantity_1\">%1$lld</value> 획득"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ganhe <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"mana\">Mana</keyword> ao <keyword id=\"cleanse\">Purificar</keyword> <value id=\"quantity_2\">%2$lld</value> efeito negativo"}},
