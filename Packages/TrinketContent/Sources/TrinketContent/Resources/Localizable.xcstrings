        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">화상</keyword> 상태의 적이 받는 <keyword id=\"poison\">독</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"
          }
