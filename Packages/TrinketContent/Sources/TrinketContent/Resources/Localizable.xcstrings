    "authored.ac407f97f61aff74": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/InventoryItem+Compatibility.swift: canonical numeric compatibility description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wenn du einen Gegner entzauberst, verursacht dein nächster <keyword id=\"holy\">heiliger</keyword> Angriff <value id=\"quantity_1\">%1$lld</value> zusätzlichen Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Purging an enemy adds <value id=\"quantity_1\">%1$lld</value> damage to your next <keyword id=\"holy\">Holy</keyword> attack"}},
        "es": {"stringUnit": {"state": "translated", "value": "Purgar a un enemigo añade <value id=\"quantity_1\">%1$lld</value> de daño a tu siguiente ataque <keyword id=\"holy\">sagrado</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Une Dissipation sur un ennemi ajoute <value id=\"quantity_1\">%1$lld</value> dégâts à votre prochaine attaque <keyword id=\"holy\">sacrée</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "敵の強化を解除すると、次の<keyword id=\"holy\">聖</keyword>攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>増加する"}},
        "ko": {"stringUnit": {"state": "translated", "value": "적의 강화를 해제하면 다음 <keyword id=\"holy\">신성</keyword> 공격의 피해가 <value id=\"quantity_1\">%1$lld</value> 증가합니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Expurgar um inimigo adiciona <value id=\"quantity_1\">%1$lld</value> de dano ao seu próximo ataque <keyword id=\"holy\">Sagrado</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "驅散敵人後，你的下一次<keyword id=\"holy\">神聖</keyword>攻擊傷害提高<value id=\"quantity_1\">%1$lld</value>點"}}
      }
    },
    "authored.ac6e0bc76ccbb455": {
      "comment": "Packages/TrinketAppState/Sources/TrinketAppState/Play/Modes/ContractsPlayMode.swift: player-facing failure message",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Aktualisiere das Auftragsbrett und wähle einen anderen Auftrag."}},
        "en": {"stringUnit": {"state": "translated", "value": "Refresh the board and choose another contract."}},
        "es": {"stringUnit": {"state": "translated", "value": "Renueva el tablón y elige otro contrato."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Actualisez le tableau et choisissez un autre Contrat."}},
        "ja": {"stringUnit": {"state": "translated", "value": "掲示板を更新して、別の依頼を選んでください。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "의뢰 게시판을 새로고침하고 다른 의뢰를 선택하세요."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Atualize o quadro e escolha outro contrato."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "請重新整理委託板並選擇另一份委託。"}}
      }
    },
