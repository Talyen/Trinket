    "talents.golden_retriever_gold_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: golden_retriever_gold_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Gestohlenes <keyword id=\"gold\">Gold</keyword> gewährt deinem Helden ebenso viel <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"gold\">Gold</keyword> stolen grants equal <keyword id=\"block\">Block</keyword> to your Hero"}},
        "es": {"stringUnit": {"state": "translated", "value": "El <keyword id=\"gold\">Oro</keyword> robado otorga una cantidad igual de <keyword id=\"block\">Bloqueo</keyword> a tu héroe"}},
        "fr": {"stringUnit": {"state": "translated", "value": "L’<keyword id=\"gold\">Or</keyword> volé octroie autant de <keyword id=\"block\">Blocage</keyword> à votre Héros"}},
        "ja": {"stringUnit": {"state": "translated", "value": "盗んだ<keyword id=\"gold\">ゴールド</keyword>と同量の<keyword id=\"block\">ブロック</keyword>をヒーローに付与"}},
        "ko": {"stringUnit": {"state": "translated", "value": "훔친 <keyword id=\"gold\">골드</keyword>만큼 영웅에게 <keyword id=\"block\">방어도</keyword> 부여"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O <keyword id=\"gold\">Ouro</keyword> roubado concede a mesma quantidade de <keyword id=\"block\">Bloqueio</keyword> ao seu Herói"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "偷取的<keyword id=\"gold\">金幣</keyword>為英雄賦予等量<keyword id=\"block\">格擋</keyword>"}}
      }
    },
