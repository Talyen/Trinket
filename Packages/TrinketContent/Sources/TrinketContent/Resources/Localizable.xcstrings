    "talents.shield_scarab_block_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: shield_scarab_block_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange du <keyword id=\"block\">Block</keyword> hast, erleide <value id=\"quantity_1\">%1$lld</value>%% weniger Schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While you have <keyword id=\"block\">Block</keyword>, take <value id=\"quantity_1\">%1$lld</value>%% less damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que vous avez du <keyword id=\"block\">Blocage</keyword>, subissez <value id=\"quantity_1\">%1$lld</value>%% de dégâts en moins"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"block\">ブロック</keyword>がある間、受けるダメージが<value id=\"quantity_1\">%1$lld</value>%%減少"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"block\">방어도</keyword>가 있으면 받는 피해 <value id=\"quantity_1\">%1$lld</value>%% 감소"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擁有<keyword id=\"block\">格擋</keyword>時，承受的傷害降低<value id=\"quantity_1\">%1$lld</value>%%"
          }
        }
      }
    },
