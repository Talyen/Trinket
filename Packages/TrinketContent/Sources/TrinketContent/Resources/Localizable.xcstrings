    "talents.warlock_leech_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: warlock_leech_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überschüssige Heilung durch <keyword id=\"leech\">Lebensraub</keyword> stellt ebenso viel <keyword id=\"mana\">Mana</keyword> wieder her"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Excess <keyword id=\"leech\">Leech</keyword> healing restores equal <keyword id=\"mana\">Mana</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les soins de <keyword id=\"leech\">Vol de vie</keyword> excédentaires restaurent autant de <keyword id=\"mana\">Mana</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">吸収</keyword>による過剰回復と同量の<keyword id=\"mana\">マナ</keyword>を回復"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">흡혈</keyword>의 초과 치유량만큼 <keyword id=\"mana\">마나</keyword> 회복"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">吸血</keyword>過量治療恢復等量<keyword id=\"mana\">魔力</keyword>"
          }
        }
      }
    },
