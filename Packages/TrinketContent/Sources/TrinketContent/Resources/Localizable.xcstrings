    "talents.bear_stun_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: bear_stun_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"stun\">Betäubte</keyword> Gegner erleiden <value id=\"quantity_1\">%1$lld</value>%% mehr Schaden durch deinen Verbündeten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"stun\">Stunned</keyword> enemies take <value id=\"quantity_1\">%1$lld</value>%% more damage from your ally"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les ennemis sous <keyword id=\"stun\">Étourdissement</keyword> subissent <value id=\"quantity_1\">%1$lld</value>%% de dégâts en plus de votre allié"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"stun\">スタン</keyword>状態の敵が自分の味方から受けるダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"stun\">기절</keyword> 상태의 적이 아군에게 받는 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"stun\">暈眩</keyword>的敵人受到你的友方攻擊時，承受的傷害增加<value id=\"quantity_1\">%1$lld</value>%%"
          }
        }
      }
    },
