    "talents.pixie_cleanse_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: pixie_cleanse_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"variations": {"plural": {"one": {"stringUnit": {"state": "translated", "value": "<keyword id=\"cleanse\">Reinige</keyword> jeden zweiten Zug <value id=\"quantity_1\">%1$lld</value> Schwächungseffekt jedes Verbündeten"}}, "other": {"stringUnit": {"state": "translated", "value": "<keyword id=\"cleanse\">Reinige</keyword> jeden zweiten Zug <value id=\"quantity_1\">%1$lld</value> Schwächungseffekte jedes Verbündeten"}}}}},
        "en": {"variations": {"plural": {"one": {"stringUnit": {"state": "translated", "value": "<keyword id=\"cleanse\">Cleanse</keyword> <value id=\"quantity_1\">%1$lld</value> debuff from each ally every other turn"}}, "other": {"stringUnit": {"state": "translated", "value": "<keyword id=\"cleanse\">Cleanse</keyword> <value id=\"quantity_1\">%1$lld</value> debuffs from each ally every other turn"}}}}},
        "es": {"variations": {"plural": {"many": {"stringUnit": {"state": "translated", "value": "<keyword id=\"cleanse\">Purifica</keyword> <value id=\"quantity_1\">%1$lld</value> perjuicios de cada aliado cada dos turnos"}}, "one": {"stringUnit": {"state": "translated", "value": "<keyword id=\"cleanse\">Purifica</keyword> <value id=\"quantity_1\">%1$lld</value> perjuicio de cada aliado cada dos turnos"}}, "other": {"stringUnit": {"state": "translated", "value": "<keyword id=\"cleanse\">Purifica</keyword> <value id=\"quantity_1\">%1$lld</value> perjuicios de cada aliado cada dos turnos"}}}}},
        "fr": {"variations": {"plural": {"many": {"stringUnit": {"state": "translated", "value": "<keyword id=\"cleanse\">Purification</keyword> de <value id=\"quantity_1\">%1$lld</value> malus de chaque allié un tour sur deux"}}, "one": {"stringUnit": {"state": "translated", "value": "<keyword id=\"cleanse\">Purification</keyword> de <value id=\"quantity_1\">%1$lld</value> malus de chaque allié un tour sur deux"}}, "other": {"stringUnit": {"state": "translated", "value": "<keyword id=\"cleanse\">Purification</keyword> de <value id=\"quantity_1\">%1$lld</value> malus de chaque allié un tour sur deux"}}}}},
        "ja": {"variations": {"plural": {"other": {"stringUnit": {"state": "translated", "value": "1ターンおきに各味方の弱体効果を<value id=\"quantity_1\">%1$lld</value>個<keyword id=\"cleanse\">浄化</keyword>"}}}}},
        "ko": {"variations": {"plural": {"other": {"stringUnit": {"state": "translated", "value": "한 턴 걸러 각 아군의 약화 효과 <value id=\"quantity_1\">%1$lld</value>개를 <keyword id=\"cleanse\">정화</keyword>"}}}}},
        "pt-BR": {"variations": {"plural": {"many": {"stringUnit": {"state": "translated", "value": "<keyword id=\"cleanse\">Purifique</keyword> <value id=\"quantity_1\">%1$lld</value> efeitos negativos de cada aliado a cada dois turnos"}}, "one": {"stringUnit": {"state": "translated", "value": "<keyword id=\"cleanse\">Purifique</keyword> <value id=\"quantity_1\">%1$lld</value> efeito negativo de cada aliado a cada dois turnos"}}, "other": {"stringUnit": {"state": "translated", "value": "<keyword id=\"cleanse\">Purifique</keyword> <value id=\"quantity_1\">%1$lld</value> efeitos negativos de cada aliado a cada dois turnos"}}}}},
        "zh-Hant": {"variations": {"plural": {"other": {"stringUnit": {"state": "translated", "value": "每隔一回合，<keyword id=\"cleanse\">淨化</keyword>每位隊友的<value id=\"quantity_1\">%1$lld</value>項減益效果"}}}}}
