    "talents.frost_whelp_freeze_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: frost_whelp_freeze_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Treffer mit <keyword id=\"freeze\">Frost</keyword>-Karten, die <keyword id=\"health\">Gesundheit</keyword> abziehen, lassen dich mit <value id=\"quantity_1\">%1$lld</value>%% Chance eine Karte ziehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"freeze\">Freeze</keyword> card hits that remove <keyword id=\"health\">Health</keyword> have a <value id=\"quantity_1\">%1$lld</value>%% chance to draw a card"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les coups de cartes de <keyword id=\"freeze\">Gel</keyword> qui retirent de la <keyword id=\"health\">Santé</keyword> ont <value id=\"quantity_1\">%1$lld</value>%% de chances de faire piocher une carte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"freeze\">凍結</keyword>カードのヒットで<keyword id=\"health\">体力</keyword>を減らすと、<value id=\"quantity_1\">%1$lld</value>%%の確率でカードを1枚引く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"freeze\">빙결</keyword> 카드 적중으로 <keyword id=\"health\">체력</keyword>을 깎으면 <value id=\"quantity_1\">%1$lld</value>%% 확률로 카드 한 장 뽑기"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"freeze\">冰凍</keyword>卡牌命中並使敵人失去<keyword id=\"health\">生命值</keyword>時，有<value id=\"quantity_1\">%1$lld</value>%%機率抽一張牌"
          }
        }
      }
    },
