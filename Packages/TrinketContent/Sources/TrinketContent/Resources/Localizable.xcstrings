    "authored.3ef7c3f4c4af4866": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Encounters/Mystery/MysteryEventPool.swift: narrative",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ein violetter Altar formt Ausrüstung dauerhaft um und bietet Verderbnis oder Flucht"}},
        "en": {"stringUnit": {"state": "translated", "value": "A violet altar remakes gear forever, offering corruption or escape"}},
        "es": {"stringUnit": {"state": "translated", "value": "Un altar violeta transforma el equipo para siempre y ofrece corrupción o escape"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Un autel violet remodèle l’équipement à jamais : choisissez la corruption ou la fuite"}},
        "ja": {"stringUnit": {"state": "translated", "value": "紫の祭壇が装備を永久に作り替える。汚染を受け入れるか、立ち去るか"}},
        "ko": {"stringUnit": {"state": "translated", "value": "보랏빛 제단은 장비를 영원히 바꿉니다. 타락을 받아들이거나 떠날 수 있습니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Um altar violeta transforma equipamentos para sempre, oferecendo corrupção ou fuga"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "紫色祭壇會永久重塑裝備，你可以選擇腐化，或就此離開"}}
      }
    },
