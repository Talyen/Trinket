      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"physical\">Physische</keyword> Angriffe verursachen doppelten Schaden an gegnerischem <keyword id=\"block\">Block</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"physical\">Physical</keyword> attacks deal double damage to enemy <keyword id=\"block\">Block</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les attaques de type <keyword id=\"physical\">Physique</keyword> infligent le double de dégâts au <keyword id=\"block\">Blocage</keyword> ennemi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "敵の<keyword id=\"block\">ブロック</keyword>への<keyword id=\"physical\">物理</keyword>攻撃のダメージが2倍になる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"physical\">물리</keyword> 공격이 적의 <keyword id=\"block\">방어도</keyword>에 두 배의 피해"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"physical\">物理</keyword>攻擊對敵人<keyword id=\"block\">格擋</keyword>造成雙倍傷害"
          }
        }
      }
    },
