        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seu <keyword id=\"bleed\">Sangramento</keyword> causa <value id=\"quantity_1\">%1$lld</value> de dano adicional a inimigos <keyword id=\"poison\">Envenenados</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "你的<keyword id=\"bleed\">流血</keyword>對<keyword id=\"poison\">中毒</keyword>的敵人額外造成<value id=\"quantity_1\">%1$lld</value>點傷害"}}
