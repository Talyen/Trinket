      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verursacht jeden zweiten Zug <value id=\"quantity_1\">%1$lld</value> Schaden vom Typ <keyword id=\"stun\">Betäubung</keyword> oder <keyword id=\"burn\">Brand</keyword>."}},
        "en": {"stringUnit": {"state": "translated", "value": "Deals <value id=\"quantity_1\">%1$lld</value> <keyword id=\"stun\">Stun</keyword> or <keyword id=\"burn\">Burn</keyword> damage every other turn."}},
        "es": {"stringUnit": {"state": "translated", "value": "Inflige <value id=\"quantity_1\">%1$lld</value> de daño de <keyword id=\"stun\">Aturdimiento</keyword> o <keyword id=\"burn\">Quemadura</keyword> cada dos turnos."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Inflige <value id=\"quantity_1\">%1$lld</value> de dégâts d’<keyword id=\"stun\">Étourdissement</keyword> ou de <keyword id=\"burn\">Brûlure</keyword> un tour sur deux."}},
