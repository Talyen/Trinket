        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>, wenn ein Gegner <keyword id=\"freeze\">eingefroren</keyword> wird"
          }
        },
        "en": {
