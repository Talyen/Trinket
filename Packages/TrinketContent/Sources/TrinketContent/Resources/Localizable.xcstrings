    "traits.seismic_pulse.description": {
      "comment": "ContentManifest/traits.tsv: seismic_pulse, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verursacht jeden zweiten Zug <value id=\"quantity_1\">%1$lld</value> <keyword id=\"physical\">physischen</keyword> Schaden an allen Gegnern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deals <value id=\"quantity_1\">%1$lld</value> <keyword id=\"physical\">Physical</keyword> damage every other turn to all enemies"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inflige <value id=\"quantity_1\">%1$lld</value> dégâts de type <keyword id=\"physical\">Physique</keyword> à tous les ennemis un tour sur deux"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1ターンおきに敵全体へ<keyword id=\"physical\">物理</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 턴 걸러 모든 적에게 <keyword id=\"physical\">물리</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每隔一回合，對所有敵人造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"physical\">物理</keyword>傷害"
          }
        }
      }
    },
    "traits.seismic_pulse.name": {
      "comment": "ContentManifest/traits.tsv: seismic_pulse, name",
