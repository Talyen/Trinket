    "affixes.measured.title": {
      "comment": "ContentManifest/affixes.tsv: measured, title",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Bedacht"}},
        "en": {"stringUnit": {"state": "translated", "value": "Measured"}},
        "es": {"stringUnit": {"state": "translated", "value": "Mesurado"}},
