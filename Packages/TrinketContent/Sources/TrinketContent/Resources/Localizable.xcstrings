    "affixes.thunderstone.astral_description": {
      "comment": "ContentManifest/affixes.tsv: thunderstone, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verursache doppelten Schaden an <keyword id=\"stun\">betäubten</keyword> Gegnern"}},
        "en": {"stringUnit": {"state": "translated", "value": "Deal double damage to <keyword id=\"stun\">Stunned</keyword> enemies"}},
        "es": {"stringUnit": {"state": "translated", "value": "Inflige el doble de daño a enemigos <keyword id=\"stun\">aturdidos</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Infligez le double de dégâts aux ennemis sous <keyword id=\"stun\">Étourdissement</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">スタン</keyword>状態の敵に与えるダメージが2倍になる"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">기절</keyword> 상태의 적에게 두 배의 피해"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cause o dobro de dano a inimigos <keyword id=\"stun\">Atordoados</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "對<keyword id=\"stun\">暈眩</keyword>的敵人造成雙倍傷害"}}
      }
    },
    "affixes.thunderstone.basic_description": {
      "comment": "ContentManifest/affixes.tsv: thunderstone, basic_description",
      "extractionState": "manual",
      "localizations": {
