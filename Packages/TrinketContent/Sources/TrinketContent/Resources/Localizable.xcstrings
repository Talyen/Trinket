    "traits.unquenchable_flame.description": {
      "comment": "ContentManifest/traits.tsv: unquenchable_flame, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">Brand</keyword>schaden ignoriert den gesamten gegnerischen <keyword id=\"block\">Block</keyword> und sämtliche Schadensreduktion"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">Burn</keyword> damage ignores all enemy <keyword id=\"block\">Block</keyword> and damage reduction"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dégâts de <keyword id=\"burn\">Brûlure</keyword> ignorent tout le <keyword id=\"block\">Blocage</keyword> et toute la réduction des dégâts ennemis"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">炎上</keyword>ダメージが敵の<keyword id=\"block\">ブロック</keyword>とダメージ軽減をすべて無視"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">화상</keyword> 피해가 적의 모든 <keyword id=\"block\">방어도</keyword>와 피해 감소 무시"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">燃燒</keyword>傷害無視敵人所有<keyword id=\"block\">格擋</keyword>與傷害減免"
          }
        }
      }
    },
