    "talents.alchemist_health_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: alchemist_health_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Wiederherstellen von <keyword id=\"health\">Gesundheit</keyword> fügt deinem nächsten <keyword id=\"poison\">Gift</keyword>-Angriff <value id=\"quantity_1\">%1$lld</value> Schaden hinzu"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restoring <keyword id=\"health\">Health</keyword> adds <value id=\"quantity_1\">%1$lld</value> damage to your next <keyword id=\"poison\">Poison</keyword> attack"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurer de la <keyword id=\"health\">Santé</keyword> ajoute <value id=\"quantity_1\">%1$lld</value> dégâts à votre prochaine attaque de <keyword id=\"poison\">Poison</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">体力</keyword>を回復すると、次の<keyword id=\"poison\">毒</keyword>攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>増加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">체력</keyword> 회복 시 다음 <keyword id=\"poison\">독</keyword> 공격의 피해 <value id=\"quantity_1\">%1$lld</value> 증가"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復<keyword id=\"health\">生命值</keyword>時，下次<keyword id=\"poison\">中毒</keyword>攻擊的傷害增加<value id=\"quantity_1\">%1$lld</value>點"
          }
        }
      }
    },
