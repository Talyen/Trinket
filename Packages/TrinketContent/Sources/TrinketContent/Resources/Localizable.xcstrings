    "talents.alchemist_poison_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: alchemist_poison_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein erster <keyword id=\"poison\">Gift</keyword>-Angriff in jedem Kampf verursacht doppelten Schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your first <keyword id=\"poison\">Poison</keyword> attack each combat deals double damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre première attaque de <keyword id=\"poison\">Poison</keyword> de chaque combat inflige le double de dégâts"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各戦闘で最初の<keyword id=\"poison\">毒</keyword>攻撃のダメージが2倍になる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매 전투 첫 <keyword id=\"poison\">독</keyword> 공격이 두 배의 피해"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每場戰鬥首次<keyword id=\"poison\">中毒</keyword>攻擊造成雙倍傷害"
          }
        }
      }
    },
