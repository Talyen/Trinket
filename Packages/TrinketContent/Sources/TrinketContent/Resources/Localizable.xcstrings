        "de": {"stringUnit": {"state": "translated", "value": "Plündererglück"}},
        "en": {"stringUnit": {"state": "translated", "value": "Scavenger's Luck"}},
        "es": {"stringUnit": {"state": "translated", "value": "Suerte del carroñero"}},
