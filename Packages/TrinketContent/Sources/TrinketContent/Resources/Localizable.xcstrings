    "talents.phoenix_deathsdoor_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: phoenix_deathsdoor_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">Brand</keyword>schaden erhält <keyword id=\"leech\">Lebensraub</keyword>, solange du an der <keyword id=\"deathsdoor\">Todesschwelle</keyword> stehst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">Burn</keyword> damage gains <keyword id=\"leech\">Leech</keyword> while you're on <keyword id=\"deathsdoor\">Death's Door</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dégâts de <keyword id=\"burn\">Brûlure</keyword> bénéficient de <keyword id=\"leech\">Vol de vie</keyword> lorsque vous êtes au <keyword id=\"deathsdoor\">Seuil de la mort</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"deathsdoor\">死の淵</keyword>の間、<keyword id=\"burn\">炎上</keyword>ダメージに<keyword id=\"leech\">吸収</keyword>を付与"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"deathsdoor\">죽음의 문턱</keyword> 상태이면 <keyword id=\"burn\">화상</keyword> 피해에 <keyword id=\"leech\">흡혈</keyword> 부여"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "處於<keyword id=\"deathsdoor\">瀕死之門</keyword>時，<keyword id=\"burn\">燃燒</keyword>傷害獲得<keyword id=\"leech\">吸血</keyword>"
          }
        }
      }
    },
