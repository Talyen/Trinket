    "traits.sated_fury.description": {
      "comment": "ContentManifest/traits.tsv: sated_fury, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Erreichen voller <keyword id=\"health\">Gesundheit</keyword> lässt den nächsten Angriff <value id=\"quantity_1\">%1$lld</value> zusätzlichen Schaden verursachen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reaching full <keyword id=\"health\">Health</keyword> makes the next attack deal <value id=\"quantity_1\">%1$lld</value> additional damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atteindre la pleine <keyword id=\"health\">Santé</keyword> ajoute <value id=\"quantity_1\">%1$lld</value> dégâts à la prochaine attaque"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">体力</keyword>が満タンになると、次の攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>増加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">체력</keyword>이 가득 차면 다음 공격의 추가 피해 <value id=\"quantity_1\">%1$lld</value>"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">生命值</keyword>恢復全滿時，下次攻擊額外造成<value id=\"quantity_1\">%1$lld</value>點傷害"
          }
        }
      }
    },
