        "pt-BR": {"stringUnit": {"state": "translated", "value": "Aumente o acúmulo de <keyword id=\"freeze\">Congelamento</keyword> em <value id=\"quantity_1\">%1$lld</value>%%"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">冰凍</keyword>累積量增加<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
