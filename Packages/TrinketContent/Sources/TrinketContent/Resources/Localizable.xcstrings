        "ja": {"stringUnit": {"state": "translated", "value": "太陽の烙印"}},
        "ko": {"stringUnit": {"state": "translated", "value": "태양의 낙인"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Marca Solar"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "太陽烙印"}}
