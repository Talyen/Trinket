    "talents.rogue_gold_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: rogue_gold_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kritische Treffer, die <keyword id=\"gold\">Gold</keyword> stehlen, lassen dich eine Karte ziehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Critical Hits that steal <keyword id=\"gold\">Gold</keyword> draw a card"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les coups critiques qui volent de l’<keyword id=\"gold\">Or</keyword> font piocher une carte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"gold\">ゴールド</keyword>を盗むクリティカルヒットで、カードを1枚引く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"gold\">골드</keyword>를 훔치는 치명타 적중 시 카드 한 장 뽑기"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偷取<keyword id=\"gold\">金幣</keyword>的暴擊會抽一張牌"
          }
        }
      }
    },
