    "affixes.merchants_favor.astral_description": {
      "comment": "ContentManifest/affixes.tsv: merchants_favor, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erhalte bei einem Sieg für jede unterschiedliche Karte, die du in diesem Kampf gespielt hast, <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Gold</keyword>, bis zu <value id=\"quantity_2\">%2$lld</value>"}},
        "en": {"stringUnit": {"state": "translated", "value": "On victory, gain <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Gold</keyword> for each different card you played, up to <value id=\"quantity_2\">%2$lld</value>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Al vencer, obtén <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"gold\">Oro</keyword> por cada carta diferente que hayas jugado en este combate, hasta <value id=\"quantity_2\">%2$lld</value>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "À la victoire, gagnez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Or</keyword> par carte différente que vous avez jouée pendant ce combat, jusqu’à <value id=\"quantity_2\">%2$lld</value>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "勝利時、この戦闘で使った異なるカード1種類につき<keyword id=\"gold\">ゴールド</keyword>を<value id=\"quantity_1\">%1$lld</value>獲得（最大<value id=\"quantity_2\">%2$lld</value>）"}},
        "ko": {"stringUnit": {"state": "translated", "value": "승리 시 이번 전투에서 사용한 서로 다른 카드마다 <keyword id=\"gold\">골드</keyword> <value id=\"quantity_1\">%1$lld</value> 획득 (최대 <value id=\"quantity_2\">%2$lld</value>)"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ao vencer, ganhe <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"gold\">Ouro</keyword> por cada carta diferente que você jogou neste combate, até <value id=\"quantity_2\">%2$lld</value>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "勝利時，本場戰鬥中你每使用一種不同卡牌，獲得<value id=\"quantity_1\">%1$lld</value><keyword id=\"gold\">金幣</keyword>，最多<value id=\"quantity_2\">%2$lld</value>"}}
      }
    },
    "affixes.merchants_favor.basic_description": {
      "comment": "ContentManifest/affixes.tsv: merchants_favor, basic_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erhalte bei einem Sieg für jede unterschiedliche Karte, die du in diesem Kampf gespielt hast, <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Gold</keyword>, bis zu <value id=\"quantity_2\">%2$lld</value>"}},
        "en": {"stringUnit": {"state": "translated", "value": "On victory, gain <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Gold</keyword> for each different card you played, up to <value id=\"quantity_2\">%2$lld</value>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Al vencer, obtén <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"gold\">Oro</keyword> por cada carta diferente que hayas jugado en este combate, hasta <value id=\"quantity_2\">%2$lld</value>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "À la victoire, gagnez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Or</keyword> par carte différente que vous avez jouée pendant ce combat, jusqu’à <value id=\"quantity_2\">%2$lld</value>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "勝利時、この戦闘で使った異なるカード1種類につき<keyword id=\"gold\">ゴールド</keyword>を<value id=\"quantity_1\">%1$lld</value>獲得（最大<value id=\"quantity_2\">%2$lld</value>）"}},
        "ko": {"stringUnit": {"state": "translated", "value": "승리 시 이번 전투에서 사용한 서로 다른 카드마다 <keyword id=\"gold\">골드</keyword> <value id=\"quantity_1\">%1$lld</value> 획득 (최대 <value id=\"quantity_2\">%2$lld</value>)"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ao vencer, ganhe <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"gold\">Ouro</keyword> por cada carta diferente que você jogou neste combate, até <value id=\"quantity_2\">%2$lld</value>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "勝利時，本場戰鬥中你每使用一種不同卡牌，獲得<value id=\"quantity_1\">%1$lld</value><keyword id=\"gold\">金幣</keyword>，最多<value id=\"quantity_2\">%2$lld</value>"}}
      }
    },
    "affixes.merchants_favor.title": {
      "comment": "ContentManifest/affixes.tsv: merchants_favor, title",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Passives Einkommen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Passive Income"}},
        "es": {"stringUnit": {"state": "translated", "value": "Ingresos pasivos"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Revenu passif"}},
        "ja": {"stringUnit": {"state": "translated", "value": "不労所得"}},
        "ko": {"stringUnit": {"state": "translated", "value": "고정 수입"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Renda Passiva"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "被動收入"}}
      }
    },
    "affixes.merciful.astral_description": {
      "comment": "ContentManifest/affixes.tsv: merciful, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Stelle <value id=\"quantity_1\">%1$lld</value> zusätzliche <keyword id=\"health\">Gesundheit</keyword> wieder her, solange der Gegner <keyword id=\"stun\">betäubt</keyword> oder <keyword id=\"freeze\">eingefroren</keyword> ist"}},
        "en": {"stringUnit": {"state": "translated", "value": "Restore <value id=\"quantity_1\">%1$lld</value> additional <keyword id=\"health\">Health</keyword> while the enemy is <keyword id=\"stun\">Stunned</keyword> or <keyword id=\"freeze\">Frozen</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Restaura <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Salud</keyword> adicional mientras el enemigo esté <keyword id=\"stun\">aturdido</keyword> o <keyword id=\"freeze\">congelado</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Restaurez <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Santé</keyword> supplémentaire tant que l’ennemi est <keyword id=\"stun\">étourdi</keyword> ou <keyword id=\"freeze\">gelé</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "敵が<keyword id=\"stun\">スタン</keyword>または<keyword id=\"freeze\">凍結</keyword>している間、<keyword id=\"health\">体力</keyword>の回復量が<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "적이 <keyword id=\"stun\">기절</keyword> 또는 <keyword id=\"freeze\">빙결</keyword> 상태이면 <keyword id=\"health\">체력</keyword> 회복량이 <value id=\"quantity_1\">%1$lld</value> 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Restaure <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Vida</keyword> adicional enquanto o inimigo estiver <keyword id=\"stun\">atordoado</keyword> ou <keyword id=\"freeze\">congelado</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "敵人處於<keyword id=\"stun\">暈眩</keyword>或<keyword id=\"freeze\">冰凍</keyword>狀態時，恢復的<keyword id=\"health\">生命值</keyword>提高<value id=\"quantity_1\">%1$lld</value>"}}
      }
    },
