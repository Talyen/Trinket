        "de": {"stringUnit": {"state": "translated", "value": "Erhalte <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>, wenn du <keyword id=\"dodge\">ausweichst</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Gain <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword> when you <keyword id=\"dodge\">Dodge</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Obtén <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueo</keyword> cuando <keyword id=\"dodge\">evades</keyword> un ataque"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Gagnez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Blocage</keyword> lors d’une <keyword id=\"dodge\">Esquive</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"dodge\">回避</keyword>すると<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>獲得"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"dodge\">회피</keyword> 시 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 획득"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ganhe <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueio</keyword> ao se <keyword id=\"dodge\">esquivar</keyword> de um ataque"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"dodge\">閃避</keyword>時獲得<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>"}}
      }
    },
