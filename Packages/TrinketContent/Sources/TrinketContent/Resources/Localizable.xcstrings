    "authored.fceb6fdb9529a2ea": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog+Accessory.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Brand</keyword> und <keyword id=\"bleed\">Blutung</keyword> teilen ihre Schadensboni"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Burn</keyword> and <keyword id=\"bleed\">Bleed</keyword> share their damage bonuses"}},
        "es": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Quemadura</keyword> y <keyword id=\"bleed\">Sangrado</keyword> comparten sus bonificaciones de daño"}},
        "fr": {"stringUnit": {"state": "translated", "value": "La <keyword id=\"burn\">Brûlure</keyword> et le <keyword id=\"bleed\">Saignement</keyword> partagent leurs bonus de dégâts"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">炎上</keyword>と<keyword id=\"bleed\">出血</keyword>が互いのダメージボーナスを共有"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">화상</keyword>과 <keyword id=\"bleed\">출혈</keyword>이 피해 보너스를 공유"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Queimadura</keyword> e <keyword id=\"bleed\">Sangramento</keyword> compartilham seus bônus de dano"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">燃燒</keyword>與<keyword id=\"bleed\">流血</keyword>共享彼此的傷害加成"}}
      }
    },
