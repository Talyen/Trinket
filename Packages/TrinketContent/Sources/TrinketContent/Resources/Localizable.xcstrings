        "fr": {"stringUnit": {"state": "translated", "value": "Soin de moelle"}},
        "ja": {"stringUnit": {"state": "translated", "value": "骨髄の癒やし"}},
        "ko": {"stringUnit": {"state": "translated", "value": "골수 치유"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Reparo da Medula"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "骨髓修復"}}
