    "homestead_nodes.moonlitsanctum.3.summary": {
      "comment": "ContentManifest/homestead_nodes.tsv: moonlitSanctum.3, summary",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ein stilles Heiligtum zum Aufspüren seltener Funde und widernatürlicher Gefahren"}},
        "en": {"stringUnit": {"state": "translated", "value": "A quiet sanctum for sensing rare finds and unnatural threats"}},
        "es": {"stringUnit": {"state": "translated", "value": "Un santuario tranquilo para percibir hallazgos raros y amenazas sobrenaturales"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Un sanctuaire paisible pour déceler les trouvailles rares et les menaces surnaturelles"}},
        "ja": {"stringUnit": {"state": "translated", "value": "希少な発見と異形の脅威を感じ取る、静かな聖所"}},
        "ko": {"stringUnit": {"state": "translated", "value": "희귀한 물건과 불길한 위협을 감지하는 고요한 성소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Um santuário tranquilo para perceber achados raros e ameaças sobrenaturais"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "感知稀有發現與異常威脅的寧靜聖所"}}
      }
    },
