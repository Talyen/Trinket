        "pt-BR": {"stringUnit": {"state": "translated", "value": "Remendo Feérico"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "妖精修復"}}
      }
    },
    "talents.pixie_cleanse_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: pixie_cleanse_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Reinigen <keyword id=\"purge\">entzaubert</keyword> mit <value id=\"quantity_1\">%1$lld</value>%% Chance <value id=\"quantity_2\">%2$lld</value> Verstärkung eines Gegners"}},
        "en": {"stringUnit": {"state": "translated", "value": "Cleansing has a <value id=\"quantity_1\">%1$lld</value>%% chance to <keyword id=\"purge\">Purge</keyword> <value id=\"quantity_2\">%2$lld</value> buff from an enemy"}},
        "es": {"stringUnit": {"state": "translated", "value": "Purificar tiene un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de <keyword id=\"purge\">purgar</keyword> <value id=\"quantity_2\">%2$lld</value> mejora de un enemigo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Purifier a <value id=\"quantity_1\">%1$lld</value>%% de chances de déclencher la <keyword id=\"purge\">Dissipation</keyword> de <value id=\"quantity_2\">%2$lld</value> bonus d’un ennemi"}},
        "ja": {"stringUnit": {"state": "translated", "value": "浄化すると<value id=\"quantity_1\">%1$lld</value>%%の確率で敵の強化効果を<value id=\"quantity_2\">%2$lld</value>個<keyword id=\"purge\">強化解除</keyword>"}},
        "ko": {"stringUnit": {"state": "translated", "value": "정화 시 적의 강화 효과 <value id=\"quantity_2\">%2$lld</value>개를 <keyword id=\"purge\">강화 해제</keyword>할 확률 <value id=\"quantity_1\">%1$lld</value>%%"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Purificar tem <value id=\"quantity_1\">%1$lld</value>%% de chance de <keyword id=\"purge\">Expurgar</keyword> <value id=\"quantity_2\">%2$lld</value> efeito positivo de um inimigo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "淨化時有<value id=\"quantity_1\">%1$lld</value>%%機率<keyword id=\"purge\">驅散</keyword>一名敵人的<value id=\"quantity_2\">%2$lld</value>項增益效果"}}
      }
    },
