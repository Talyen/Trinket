    "authored.d291ed3cae9b5488": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog+Ranged.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine <keyword id=\"physical\">physischen</keyword> kritischen Treffer, die <keyword id=\"health\">Gesundheit</keyword> abziehen, lassen dich vom Deck deines Gefährten ziehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your <keyword id=\"physical\">Physical</keyword> Critical Hits that remove <keyword id=\"health\">Health</keyword> draw from your Companion's deck"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos coups critiques de type <keyword id=\"physical\">Physique</keyword> qui retirent de la <keyword id=\"health\">Santé</keyword> font piocher dans le paquet de votre Compagnon"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の<keyword id=\"physical\">物理</keyword>クリティカルヒットで<keyword id=\"health\">体力</keyword>を減らすと、仲間のデッキからカードを1枚引く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 <keyword id=\"physical\">물리</keyword> 치명타가 <keyword id=\"health\">체력</keyword>을 깎으면 동료의 덱에서 카드 뽑기"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自身<keyword id=\"physical\">物理</keyword>暴擊使敵人失去<keyword id=\"health\">生命值</keyword>時，從夥伴牌組抽牌"
          }
        }
      }
    },
    "authored.d2e58983fcedb971": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/InventoryItem+Compatibility.swift: canonical numeric compatibility description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal pro Zug: Ausweichen bringt deine zuletzt gespielte Karte auf deine Hand zurück"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once per turn, Dodging returns the last card you played to your hand"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois par tour, une Esquive renvoie dans votre main la dernière carte que vous avez jouée"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1ターンに1回、回避すると最後に使ったカードが手札に戻る"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "턴마다 한 번, 회피 시 마지막으로 사용한 카드를 손으로 반환"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每回合一次，閃避時將最後打出的卡牌返回手牌"
          }
        }
      }
    },
