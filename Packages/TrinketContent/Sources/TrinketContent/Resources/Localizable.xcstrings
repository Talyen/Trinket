    "talents.risen_skeleton_deathsdoor_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_deathsdoor_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die <keyword id=\"deathsdoor\">Todesschwelle</keyword> erhält deinen <keyword id=\"block\">Block</keyword> zwischen deinen Zügen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"deathsdoor\">Death's Door</keyword> preserves your <keyword id=\"block\">Block</keyword> between turns"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le <keyword id=\"deathsdoor\">Seuil de la mort</keyword> conserve votre <keyword id=\"block\">Blocage</keyword> entre les tours"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"deathsdoor\">死の淵</keyword>の間、ターンをまたいで自分の<keyword id=\"block\">ブロック</keyword>を保持"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"deathsdoor\">죽음의 문턱</keyword> 상태에서는 턴이 바뀌어도 내 <keyword id=\"block\">방어도</keyword> 유지"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"deathsdoor\">瀕死之門</keyword>使自身<keyword id=\"block\">格擋</keyword>在回合之間保留"
          }
        }
      }
    },
