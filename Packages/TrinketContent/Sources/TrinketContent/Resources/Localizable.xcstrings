    "talents.panther_dodge_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: panther_dodge_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ausweichen lässt deinen nächsten Angriff kritisch treffen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Dodging makes your next attack Critically Hit"}},
        "es": {"stringUnit": {"state": "translated", "value": "Esquivar hace que tu siguiente ataque aseste un golpe crítico"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Une esquive garantit un coup critique à votre prochaine attaque"}},
        "ja": {"stringUnit": {"state": "translated", "value": "回避すると、次の攻撃が必ずクリティカルヒット"}},
        "ko": {"stringUnit": {"state": "translated", "value": "회피 시 다음 공격이 반드시 치명타"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Esquivar faz seu próximo ataque acertar um golpe crítico"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "閃避後，下次攻擊必定暴擊"}}
      }
    },
    "talents.panther_dodge_t3_2.name": {
      "comment": "ContentManifest/talents.tsv: panther_dodge_t3_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verschwinden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Vanish"}},
        "es": {"stringUnit": {"state": "translated", "value": "Desvanecerse"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Disparition"}},
        "ja": {"stringUnit": {"state": "translated", "value": "姿消し"}},
        "ko": {"stringUnit": {"state": "translated", "value": "자취 감추기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Desaparecer"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "消失"}}
      }
    },
    "talents.panther_dodge_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: panther_dodge_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erhalte Chance auf kritische Treffer in Höhe der Hälfte deiner Chance auf <keyword id=\"dodge\">Ausweichen</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Gain Critical Hit chance equal to half your <keyword id=\"dodge\">Dodge</keyword> chance"}},
        "es": {"stringUnit": {"state": "translated", "value": "Obtén probabilidad de golpe crítico equivalente a la mitad de tu probabilidad de <keyword id=\"dodge\">Evasión</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Gagnez des chances de coup critique à hauteur de la moitié de vos chances d’<keyword id=\"dodge\">Esquive</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "自分の<keyword id=\"dodge\">回避</keyword>率の半分に等しいクリティカル率を獲得"}},
        "ko": {"stringUnit": {"state": "translated", "value": "내 <keyword id=\"dodge\">회피</keyword> 확률의 절반만큼 치명타 확률 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ganhe chance de golpe crítico igual à metade da sua chance de <keyword id=\"dodge\">Esquiva</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "獲得相當於自身<keyword id=\"dodge\">閃避</keyword>機率一半的暴擊機率"}}
      }
    },
    "talents.panther_dodge_t4_1.name": {
      "comment": "ContentManifest/talents.tsv: panther_dodge_t4_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Tödliche Anmut"}},
        "en": {"stringUnit": {"state": "translated", "value": "Killing Grace"}},
        "es": {"stringUnit": {"state": "translated", "value": "Gracia letal"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Grâce meurtrière"}},
        "ja": {"stringUnit": {"state": "translated", "value": "殺しの優美"}},
        "ko": {"stringUnit": {"state": "translated", "value": "살육의 우아함"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Graça Mortal"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "殺戮優雅"}}
      }
    },
    "talents.panther_leech_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: panther_leech_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">Blutungs</keyword>-Angriffe erhalten <keyword id=\"leech\">Lebensraub</keyword>, solange du unter <value id=\"quantity_1\">%1$lld</value>%% <keyword id=\"health\">Gesundheit</keyword> bist"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">Bleed</keyword> attacks gain <keyword id=\"leech\">Leech</keyword> while below <value id=\"quantity_1\">%1$lld</value>%% <keyword id=\"health\">Health</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques de <keyword id=\"bleed\">Sangrado</keyword> obtienen <keyword id=\"leech\">Absorción</keyword> mientras estás por debajo del <value id=\"quantity_1\">%1$lld</value>%% de <keyword id=\"health\">Salud</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques de <keyword id=\"bleed\">Saignement</keyword> bénéficient de <keyword id=\"leech\">Vol de vie</keyword> sous <value id=\"quantity_1\">%1$lld</value>%% de <keyword id=\"health\">Santé</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>が<value id=\"quantity_1\">%1$lld</value>%%未満の間、<keyword id=\"bleed\">出血</keyword>攻撃に<keyword id=\"leech\">吸収</keyword>を付与"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword>이 <value id=\"quantity_1\">%1$lld</value>%% 미만이면 <keyword id=\"bleed\">출혈</keyword> 공격에 <keyword id=\"leech\">흡혈</keyword> 부여"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques de <keyword id=\"bleed\">Sangramento</keyword> ganham <keyword id=\"leech\">Drenagem</keyword> enquanto você estiver abaixo de <value id=\"quantity_1\">%1$lld</value>%% de <keyword id=\"health\">Vida</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">生命值</keyword>低於<value id=\"quantity_1\">%1$lld</value>%%時，<keyword id=\"bleed\">流血</keyword>攻擊獲得<keyword id=\"leech\">吸血</keyword>"}}
      }
    },
    "talents.panther_leech_t1_1.name": {
      "comment": "ContentManifest/talents.tsv: panther_leech_t1_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Bluthunger"}},
        "en": {"stringUnit": {"state": "translated", "value": "Blood Hunger"}},
        "es": {"stringUnit": {"state": "translated", "value": "Hambre de sangre"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Faim de sang"}},
        "ja": {"stringUnit": {"state": "translated", "value": "血への飢え"}},
        "ko": {"stringUnit": {"state": "translated", "value": "피의 갈증"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Fome de Sangue"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "鮮血飢渴"}}
      }
    },
    "talents.panther_leech_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: panther_leech_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Überschüssige Wiederherstellung deiner <keyword id=\"health\">Gesundheit</keyword> durch <keyword id=\"leech\">Lebensraub</keyword> heilt deinen Verbündeten"}},
        "en": {"stringUnit": {"state": "translated", "value": "Excess <keyword id=\"leech\">Leech</keyword> <keyword id=\"health\">Health</keyword> restoration is shared with your ally"}},
        "es": {"stringUnit": {"state": "translated", "value": "La restauración sobrante de <keyword id=\"health\">Salud</keyword> de <keyword id=\"leech\">Absorción</keyword> se comparte con tu aliado"}},
        "fr": {"stringUnit": {"state": "translated", "value": "La <keyword id=\"health\">Santé</keyword> restaurée en excès par <keyword id=\"leech\">Vol de vie</keyword> est partagée avec votre allié"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">吸収</keyword>による<keyword id=\"health\">体力</keyword>の過剰回復を味方と共有"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">흡혈</keyword>의 초과 <keyword id=\"health\">체력</keyword> 회복량을 아군과 공유"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "A restauração excedente de <keyword id=\"health\">Vida</keyword> por <keyword id=\"leech\">Drenagem</keyword> é compartilhada com seu aliado"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">吸血</keyword>對<keyword id=\"health\">生命值</keyword>的過量恢復與友方共享"}}
      }
    },
    "talents.panther_leech_t1_2.name": {
      "comment": "ContentManifest/talents.tsv: panther_leech_t1_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Geteiltes Festmahl"}},
        "en": {"stringUnit": {"state": "translated", "value": "Shared Feast"}},
        "es": {"stringUnit": {"state": "translated", "value": "Festín compartido"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Festin partagé"}},
        "ja": {"stringUnit": {"state": "translated", "value": "分かち合う饗宴"}},
        "ko": {"stringUnit": {"state": "translated", "value": "함께하는 향연"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Banquete Compartilhado"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "共享盛宴"}}
      }
    },
    "talents.panther_leech_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: panther_leech_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Kritische <keyword id=\"leech\">Lebensraub</keyword>-Treffer gewähren deinem Verbündeten <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">Leech</keyword> Critical Hits grant your ally <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los golpes críticos de <keyword id=\"leech\">Absorción</keyword> otorgan a tu aliado <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueo</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les coups critiques de <keyword id=\"leech\">Vol de vie</keyword> octroient <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Blocage</keyword> à votre allié"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">吸収</keyword>クリティカルヒットで味方に<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>付与"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">흡혈</keyword> 치명타 적중 시 아군에게 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 부여"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Golpes críticos de <keyword id=\"leech\">Drenagem</keyword> concedem <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueio</keyword> ao seu aliado"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">吸血</keyword>暴擊賦予友方<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>"}}
      }
    },
    "talents.panther_leech_t2_1.name": {
      "comment": "ContentManifest/talents.tsv: panther_leech_t2_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Vitalitätsinfusion"}},
        "en": {"stringUnit": {"state": "translated", "value": "Vitality Infusion"}},
        "es": {"stringUnit": {"state": "translated", "value": "Infusión de vitalidad"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Infusion de vitalité"}},
        "ja": {"stringUnit": {"state": "translated", "value": "活力の注入"}},
        "ko": {"stringUnit": {"state": "translated", "value": "활력 주입"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Infusão de Vitalidade"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "活力灌注"}}
      }
    },
    "talents.panther_leech_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: panther_leech_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Gegner können durch <keyword id=\"leech\">Lebensraub</keyword> gegen dich keine Gesundheit wiederherstellen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Enemies cannot <keyword id=\"leech\">Leech</keyword> from you"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los enemigos no pueden usar <keyword id=\"leech\">Absorción</keyword> contra ti"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les ennemis ne peuvent pas récupérer de Santé grâce au <keyword id=\"leech\">Vol de vie</keyword> contre vous"}},
        "ja": {"stringUnit": {"state": "translated", "value": "敵は自分から<keyword id=\"leech\">吸収</keyword>できない"}},
        "ko": {"stringUnit": {"state": "translated", "value": "적이 내게서 <keyword id=\"leech\">흡혈</keyword>할 수 없음"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Inimigos não podem aplicar <keyword id=\"leech\">Drenagem</keyword> em você"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "敵人無法從你身上<keyword id=\"leech\">吸血</keyword>"}}
      }
    },
    "talents.panther_leech_t2_2.name": {
