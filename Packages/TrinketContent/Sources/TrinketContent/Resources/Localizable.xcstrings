    "affixes.disrupting.astral_description": {
      "comment": "ContentManifest/affixes.tsv: disrupting, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"purge\">Entzaubere</keyword> alle Verstärkungen, wenn du den Gegner <keyword id=\"stun\">betäubst</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"purge\">Purge</keyword> all buffs when you <keyword id=\"stun\">Stun</keyword> the enemy"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"purge\">Dissipation</keyword> de tous les bonus lorsque vous infligez un <keyword id=\"stun\">Étourdissement</keyword> à l’ennemi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "敵を<keyword id=\"stun\">スタン</keyword>状態にすると、すべての強化効果を<keyword id=\"purge\">強化解除</keyword>"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적을 <keyword id=\"stun\">기절</keyword>시키면 <keyword id=\"purge\">강화 해제</keyword>로 모든 강화 효과 제거"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使敵人<keyword id=\"stun\">暈眩</keyword>時，<keyword id=\"purge\">驅散</keyword>所有增益效果"
          }
        }
      }
    },
