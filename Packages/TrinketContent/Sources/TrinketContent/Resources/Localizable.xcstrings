        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La <keyword id=\"burn\">Brûlure</keyword> inflige <value id=\"quantity_1\">%1$lld</value>%% de dégâts en plus aux ennemis sans <keyword id=\"block\">Blocage</keyword>"
          }
