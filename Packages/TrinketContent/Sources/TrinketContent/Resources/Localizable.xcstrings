        "ko": {"stringUnit": {"state": "translated", "value": "길을 찾을 수 없음"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Caminho ausente"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "找不到路徑"}}
      }
    },
    "authored.c5e4b6080cacb46a": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Encounters/Rewards/RewardModifier.swift: computed title",
