    "talents.rogue_gold_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: rogue_gold_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du im Kampf <keyword id=\"gold\">Gold</keyword> erhältst, erhalte <keyword id=\"block\">Block</keyword> in Höhe der Hälfte dieses Betrags"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whenever you gain <keyword id=\"gold\">Gold</keyword> in combat, gain <keyword id=\"block\">Block</keyword> equal to half that amount"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque gain d’<keyword id=\"gold\">Or</keyword> en combat octroie du <keyword id=\"block\">Blocage</keyword> à hauteur de la moitié de ce montant"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "戦闘中に<keyword id=\"gold\">ゴールド</keyword>を獲得するたび、その半分に等しい<keyword id=\"block\">ブロック</keyword>を獲得"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전투에서 <keyword id=\"gold\">골드</keyword> 획득 시 그 절반만큼 <keyword id=\"block\">방어도</keyword> 획득"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "戰鬥中每次獲得<keyword id=\"gold\">金幣</keyword>時，獲得相當於該數量一半的<keyword id=\"block\">格擋</keyword>"
          }
        }
      }
    },
