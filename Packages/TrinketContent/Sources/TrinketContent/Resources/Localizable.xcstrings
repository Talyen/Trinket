        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagnez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword> lorsque vous perdez de la <keyword id=\"health\">Santé</keyword>"
          }
