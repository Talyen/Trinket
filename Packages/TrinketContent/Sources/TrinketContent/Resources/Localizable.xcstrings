    "affixes.tattered_pages.astral_description": {
      "comment": "ContentManifest/affixes.tsv: tattered_pages, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verliere jeden zweiten Zug <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Gesundheit</keyword> und ziehe eine Karte"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every other turn, lose <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Health</keyword> and draw a card"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tour sur deux, perdez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Santé</keyword> et piochez une carte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1ターンおきに<keyword id=\"health\">体力</keyword>を<value id=\"quantity_1\">%1$lld</value>失い、カードを1枚引く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 턴 걸러 <keyword id=\"health\">체력</keyword> <value id=\"quantity_1\">%1$lld</value> 소모 후 카드 한 장 뽑기"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每隔一回合失去<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"health\">生命值</keyword>並抽一張牌"
          }
        }
      }
    },
