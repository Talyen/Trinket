    "affixes.retaliatory.astral_description": {
      "comment": "ContentManifest/affixes.tsv: retaliatory, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wirf <value id=\"quantity_1\">%1$lld</value>%% der verlorenen <keyword id=\"health\">Gesundheit</keyword> als <keyword id=\"physical\">physischen</keyword> Schaden zurück"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reflect <value id=\"quantity_1\">%1$lld</value>%% of <keyword id=\"health\">Health</keyword> lost as <keyword id=\"physical\">Physical</keyword> damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renvoyez <value id=\"quantity_1\">%1$lld</value>%% de la <keyword id=\"health\">Santé</keyword> perdue en dégâts de type <keyword id=\"physical\">Physique</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "失った<keyword id=\"health\">体力</keyword>の<value id=\"quantity_1\">%1$lld</value>%%を<keyword id=\"physical\">物理</keyword>ダメージとして反射"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잃은 <keyword id=\"health\">체력</keyword>의 <value id=\"quantity_1\">%1$lld</value>%%를 <keyword id=\"physical\">물리</keyword> 피해로 반사"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將失去的<keyword id=\"health\">生命值</keyword>的<value id=\"quantity_1\">%1$lld</value>%%反射為<keyword id=\"physical\">物理</keyword>傷害"
          }
        }
      }
    },
