    "authored.396d8d761b8ce3b3": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Abilities/AbilityCatalog+Skill.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verursache zufällig <value id=\"quantity_1\">%1$lld</value> <keyword id=\"burn\">Brand</keyword>- oder <keyword id=\"poison\">Gift</keyword>schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Deal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"burn\">Burn</keyword> or <keyword id=\"poison\">Poison</keyword> damage at random"}},
        "es": {"stringUnit": {"state": "translated", "value": "Inflige <value id=\"quantity_1\">%1$lld</value> de daño de <keyword id=\"burn\">Quemadura</keyword> o <keyword id=\"poison\">Veneno</keyword> al azar"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Infligez aléatoirement <value id=\"quantity_1\">%1$lld</value> dégâts de <keyword id=\"burn\">Brûlure</keyword> ou de <keyword id=\"poison\">Poison</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">炎上</keyword>か<keyword id=\"poison\">毒</keyword>ダメージをランダムに<value id=\"quantity_1\">%1$lld</value>与える"}},
        "ko": {"stringUnit": {"state": "translated", "value": "무작위로 <keyword id=\"burn\">화상</keyword> 또는 <keyword id=\"poison\">독</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cause <value id=\"quantity_1\">%1$lld</value> de dano de <keyword id=\"burn\">Queimadura</keyword> ou de <keyword id=\"poison\">Veneno</keyword>, aleatoriamente"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "隨機造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"burn\">燃燒</keyword>或<keyword id=\"poison\">中毒</keyword>傷害"}}
      }
    },
