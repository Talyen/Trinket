    "authored.9f6f435f174e9ffd": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Encounters/Mystery/MysteryEventPool+Events.swift: narrative",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein unvollendeter Zauber umgibt „%1$@“, und ein zersplitterter Schrank verbirgt „%2$@“"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An unfinished spell surrounds “%1$@”, and a splintered cabinet hides “%2$@”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un sort inachevé entoure « %1$@ », tandis qu’une armoire fendue cache « %2$@ »"
