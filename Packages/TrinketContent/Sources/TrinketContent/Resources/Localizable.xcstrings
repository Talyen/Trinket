    "talents.wolf_dodge_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: wolf_dodge_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ausweichen lässt deinen nächsten <keyword id=\"bleed\">Blutungs</keyword>-Angriff <value id=\"quantity_1\">%1$lld</value>%% mehr Schaden verursachen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Dodging makes your next <keyword id=\"bleed\">Bleed</keyword> attack deal <value id=\"quantity_1\">%1$lld</value>%% more damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Esquivar hace que tu siguiente ataque de <keyword id=\"bleed\">Sangrado</keyword> inflija un <value id=\"quantity_1\">%1$lld</value>%% más de daño"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Une esquive augmente de <value id=\"quantity_1\">%1$lld</value>%% les dégâts de votre prochaine attaque de <keyword id=\"bleed\">Saignement</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "回避すると、次の<keyword id=\"bleed\">出血</keyword>攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "회피 시 다음 <keyword id=\"bleed\">출혈</keyword> 공격의 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Esquivar faz seu próximo ataque de <keyword id=\"bleed\">Sangramento</keyword> causar <value id=\"quantity_1\">%1$lld</value>%% mais dano"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "閃避後，下次<keyword id=\"bleed\">流血</keyword>攻擊的傷害提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
