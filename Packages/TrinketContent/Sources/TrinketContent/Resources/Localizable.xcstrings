    "affixes.sin_eaters_lantern.astral_description": {
      "comment": "ContentManifest/affixes.tsv: sin_eaters_lantern, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Stelle <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Gesundheit</keyword> wieder her, wenn du <value id=\"quantity_2\">%2$lld</value> Schwächungseffekt entfernst"}},
        "en": {"stringUnit": {"state": "translated", "value": "Restore <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Health</keyword> when you remove <value id=\"quantity_2\">%2$lld</value> debuff"}},
        "es": {"stringUnit": {"state": "translated", "value": "Restaura <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Salud</keyword> cuando eliminas <value id=\"quantity_2\">%2$lld</value> perjuicio"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Rend <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Santé</keyword> lorsque vous retirez <value id=\"quantity_2\">%2$lld</value> malus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "弱体効果を<value id=\"quantity_2\">%2$lld</value>個解除すると<keyword id=\"health\">体力</keyword>を<value id=\"quantity_1\">%1$lld</value>回復"}},
        "ko": {"stringUnit": {"state": "translated", "value": "약화 효과 <value id=\"quantity_2\">%2$lld</value>개 제거 시 <keyword id=\"health\">체력</keyword> <value id=\"quantity_1\">%1$lld</value> 회복"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Restaure <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Vida</keyword> ao remover <value id=\"quantity_2\">%2$lld</value> efeito negativo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "移除<value id=\"quantity_2\">%2$lld</value>項減益效果時，恢復<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"health\">生命值</keyword>"}}
      }
    },
