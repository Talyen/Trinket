    "talents.ranger_burn_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: ranger_burn_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Gefährtenangriffe erhalten gegen <keyword id=\"burn\">brennende</keyword> Gegner +<value id=\"quantity_1\">%1$lld</value>%% Chance auf kritische Treffer"}},
        "en": {"stringUnit": {"state": "translated", "value": "Companion attacks gain +<value id=\"quantity_1\">%1$lld</value>%% Critical chance against <keyword id=\"burn\">Burning</keyword> enemies"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques del compañero obtienen +<value id=\"quantity_1\">%1$lld</value>%% de probabilidad de crítico contra enemigos con <keyword id=\"burn\">Quemadura</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques du Compagnon gagnent +<value id=\"quantity_1\">%1$lld</value>%% de chances de coup critique contre les ennemis sous <keyword id=\"burn\">Brûlure</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">炎上</keyword>状態の敵への仲間の攻撃のクリティカル率が<value id=\"quantity_1\">%1$lld</value>%%上昇"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">화상</keyword> 상태의 적에게 동료 공격의 치명타 확률 +<value id=\"quantity_1\">%1$lld</value>%%"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques do Companheiro ganham +<value id=\"quantity_1\">%1$lld</value>%% de chance de crítico contra inimigos <keyword id=\"burn\">Em Chamas</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "夥伴對<keyword id=\"burn\">燃燒</keyword>中敵人的攻擊暴擊機率提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
