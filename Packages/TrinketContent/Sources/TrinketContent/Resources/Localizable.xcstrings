    "talents.knight_stun_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: knight_stun_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">Betäubung</keyword> hält bei <keyword id=\"burn\">brennenden</keyword> Gegnern <value id=\"quantity_1\">%1$lld</value> zusätzlichen Zug an"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">Stun</keyword> lasts <value id=\"quantity_1\">%1$lld</value> extra turn on <keyword id=\"burn\">Burning</keyword> enemies"}},
        "es": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">Aturdimiento</keyword> dura <value id=\"quantity_1\">%1$lld</value> turno adicional en enemigos con <keyword id=\"burn\">Quemadura</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "L’<keyword id=\"stun\">Étourdissement</keyword> dure <value id=\"quantity_1\">%1$lld</value> tour de plus sur les ennemis sous <keyword id=\"burn\">Brûlure</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">炎上</keyword>状態の敵への<keyword id=\"stun\">スタン</keyword>がさらに<value id=\"quantity_1\">%1$lld</value>ターン持続"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">화상</keyword> 상태의 적에게 <keyword id=\"stun\">기절</keyword>이 <value id=\"quantity_1\">%1$lld</value>턴 더 지속"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">Atordoamento</keyword> dura <value id=\"quantity_1\">%1$lld</value> turno adicional em inimigos <keyword id=\"burn\">Em Chamas</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "對<keyword id=\"burn\">燃燒</keyword>中的敵人，<keyword id=\"stun\">暈眩</keyword>額外持續<value id=\"quantity_1\">%1$lld</value>回合"}}
      }
    },
    "talents.knight_stun_t3_1.name": {
      "comment": "ContentManifest/talents.tsv: knight_stun_t3_1, name",
      "extractionState": "manual",
