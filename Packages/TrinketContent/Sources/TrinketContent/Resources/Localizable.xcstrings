    "affixes.bounty.astral_description": {
      "comment": "ContentManifest/affixes.tsv: bounty, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Gold</keyword>, wenn du einen Gegner besiegst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gain <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Gold</keyword> when you defeat an enemy"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagnez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"gold\">Or</keyword> lorsque vous terrassez un ennemi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "敵を倒すと<keyword id=\"gold\">ゴールド</keyword>を<value id=\"quantity_1\">%1$lld</value>獲得"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적 처치 시 <keyword id=\"gold\">골드</keyword> <value id=\"quantity_1\">%1$lld</value> 획득"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擊敗敵人時，獲得<value id=\"quantity_1\">%1$lld</value><keyword id=\"gold\">金幣</keyword>"
          }
        }
      }
    },
