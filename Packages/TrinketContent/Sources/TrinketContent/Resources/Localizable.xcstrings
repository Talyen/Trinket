    "talents.wildcard_dodge_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: wildcard_dodge_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Angriff, dem du nicht ausweichst, erhöht deine Chance auf <keyword id=\"dodge\">Ausweichen</keyword> um <value id=\"quantity_1\">%1$lld</value>%%\nAusweichen setzt diesen Bonus zurück"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each undodged attack increases your <keyword id=\"dodge\">Dodge</keyword> chance by <value id=\"quantity_1\">%1$lld</value>%%\nDodging resets this bonus"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque attaque non esquivée augmente vos chances d’<keyword id=\"dodge\">Esquive</keyword> de <value id=\"quantity_1\">%1$lld</value>%%\nUne esquive réinitialise ce bonus"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回避しなかった攻撃1回につき<keyword id=\"dodge\">回避</keyword>率が<value id=\"quantity_1\">%1$lld</value>%%上昇\n回避するとこのボーナスはリセット"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공격을 회피하지 못할 때마다 <keyword id=\"dodge\">회피</keyword> 확률 <value id=\"quantity_1\">%1$lld</value>%% 증가\n회피 시 이 보너스 초기화"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次未閃避攻擊，<keyword id=\"dodge\">閃避</keyword>機率提高<value id=\"quantity_1\">%1$lld</value>%%\n閃避會重設此加成"
          }
        }
      }
    },
