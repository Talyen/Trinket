    "affixes.ashen_wake.astral_description": {
      "comment": "ContentManifest/affixes.tsv: ashen_wake, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">Brand</keyword>schaden verursacht mit <value id=\"quantity_1\">%1$lld</value>%% Chance <value id=\"quantity_2\">%2$lld</value> <keyword id=\"poison\">Gift</keyword>schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dealing <keyword id=\"burn\">Burn</keyword> damage has a <value id=\"quantity_1\">%1$lld</value>%% chance to deal <value id=\"quantity_2\">%2$lld</value> <keyword id=\"poison\">Poison</keyword> damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dégâts de <keyword id=\"burn\">Brûlure</keyword> ont <value id=\"quantity_1\">%1$lld</value>%% de chances d’infliger <value id=\"quantity_2\">%2$lld</value> dégâts de <keyword id=\"poison\">Poison</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">炎上</keyword>ダメージを与えると、<value id=\"quantity_1\">%1$lld</value>%%の確率で<keyword id=\"poison\">毒</keyword>ダメージを<value id=\"quantity_2\">%2$lld</value>与える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">화상</keyword> 피해를 주면 <value id=\"quantity_1\">%1$lld</value>%% 확률로 <keyword id=\"poison\">독</keyword> 피해 <value id=\"quantity_2\">%2$lld</value>"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "造成<keyword id=\"burn\">燃燒</keyword>傷害時，有<value id=\"quantity_1\">%1$lld</value>%%機率造成<value id=\"quantity_2\">%2$lld</value>點<keyword id=\"poison\">中毒</keyword>傷害"
          }
        }
      }
    },
