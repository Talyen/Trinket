        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"cleanse\">淨化</keyword><value id=\"quantity_2\">%2$lld</value>項減益效果時，獲得<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"mana\">魔力</keyword>"
          }
