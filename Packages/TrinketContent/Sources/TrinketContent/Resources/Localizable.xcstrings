    "affixes.hardened.astral_description": {
      "comment": "ContentManifest/affixes.tsv: hardened, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erleide <value id=\"quantity_1\">%1$lld</value>%% weniger <keyword id=\"physical\">physischen</keyword> Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Take <value id=\"quantity_1\">%1$lld</value>%% less <keyword id=\"physical\">Physical</keyword> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Recibe un <value id=\"quantity_1\">%1$lld</value>%% menos de daño <keyword id=\"physical\">físico</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Dégâts de type <keyword id=\"physical\">Physique</keyword> subis réduits de <value id=\"quantity_1\">%1$lld</value>%%"}},
        "ja": {"stringUnit": {"state": "translated", "value": "受ける<keyword id=\"physical\">物理</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%減少"}},
        "ko": {"stringUnit": {"state": "translated", "value": "받는 <keyword id=\"physical\">물리</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>%% 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Receba <value id=\"quantity_1\">%1$lld</value>%% menos dano <keyword id=\"physical\">Físico</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "承受的<keyword id=\"physical\">物理</keyword>傷害降低<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
