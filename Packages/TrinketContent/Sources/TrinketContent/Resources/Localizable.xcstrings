    "homestead_nodes.runesmithworkshop.1.summary": {
      "comment": "ContentManifest/homestead_nodes.tsv: runesmithWorkshop.1, summary",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Eine sorgfältig eingerichtete Werkstatt, in der Metallhandwerk und Kristallkunde zusammenfinden"}},
        "en": {"stringUnit": {"state": "translated", "value": "A careful workshop where metalwork and crystal study meet"}},
        "es": {"stringUnit": {"state": "translated", "value": "Un taller minucioso donde se unen la metalurgia y el estudio del cristal"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Un atelier minutieux où le travail du métal rencontre l’étude du cristal"}},
        "ja": {"stringUnit": {"state": "translated", "value": "金属加工と水晶研究を組み合わせる、精緻な工房"}},
        "ko": {"stringUnit": {"state": "translated", "value": "금속 가공과 수정 연구가 만나는 정교한 작업장"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Uma oficina meticulosa onde o trabalho em metal encontra o estudo de cristais"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "結合金屬加工與水晶研究的精細工坊"}}
      }
    },
    "homestead_nodes.runesmithworkshop.1.title": {
      "comment": "ContentManifest/homestead_nodes.tsv: runesmithWorkshop.1, title",
      "extractionState": "manual",
      "localizations": {
