      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kritische <keyword id=\"physical\">physische</keyword> Treffer verursachen <value id=\"quantity_1\">%1$lld</value>%% mehr Schaden an <keyword id=\"bleed\">blutenden</keyword> Gegnern"
