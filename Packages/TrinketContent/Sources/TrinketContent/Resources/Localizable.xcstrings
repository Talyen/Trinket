    "talents.alchemist_health_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: alchemist_health_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine überschüssige Heilung stellt <keyword id=\"health\">Gesundheit</keyword> beim Partner des Empfängers wieder her"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your excess healing restores <keyword id=\"health\">Health</keyword> to the recipient’s partner"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos soins excédentaires restaurent la <keyword id=\"health\">Santé</keyword> du partenaire du bénéficiaire"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の過剰回復で、回復対象の相棒の<keyword id=\"health\">体力</keyword>を回復"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초과 치유량만큼 치유 대상의 파트너의 <keyword id=\"health\">체력</keyword> 회복"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自身過量治療會恢復受治者搭檔的<keyword id=\"health\">生命值</keyword>"
          }
        }
      }
    },
