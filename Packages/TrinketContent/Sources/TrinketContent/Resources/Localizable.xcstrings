    "talents.wildcard_gold_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: wildcard_gold_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Erhalt von <keyword id=\"gold\">Gold</keyword> lässt dich mit <value id=\"quantity_1\">%1$lld</value>%% Chance eine Karte ziehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaining <keyword id=\"gold\">Gold</keyword> has a <value id=\"quantity_1\">%1$lld</value>%% chance to draw a card"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagner de l’<keyword id=\"gold\">Or</keyword> a <value id=\"quantity_1\">%1$lld</value>%% de chances de faire piocher une carte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"gold\">ゴールド</keyword>を獲得すると<value id=\"quantity_1\">%1$lld</value>%%の確率でカードを1枚引く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"gold\">골드</keyword> 획득 시 <value id=\"quantity_1\">%1$lld</value>%% 확률로 카드 한 장 뽑기"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "獲得<keyword id=\"gold\">金幣</keyword>時，有<value id=\"quantity_1\">%1$lld</value>%%機率抽一張牌"
          }
        }
      }
    },
