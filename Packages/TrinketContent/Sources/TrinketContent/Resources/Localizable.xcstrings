    "talents.risen_skeleton_leech_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_leech_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine erste Heilung durch <keyword id=\"leech\">Lebensraub</keyword> in jedem Zug heilt auch deinen Verbündeten um ebenso viel"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your first <keyword id=\"leech\">Leech</keyword> restoration each turn also heals your ally equally"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre première restauration par <keyword id=\"leech\">Vol de vie</keyword> de chaque tour soigne aussi votre allié d’autant"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ターンで最初の<keyword id=\"leech\">吸収</keyword>回復で、味方も同量回復"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매 턴 첫 <keyword id=\"leech\">흡혈</keyword> 회복 시 아군도 같은 양만큼 치유"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每回合首次<keyword id=\"leech\">吸血</keyword>恢復也會為友方恢復等量生命值"
          }
        }
      }
    },
