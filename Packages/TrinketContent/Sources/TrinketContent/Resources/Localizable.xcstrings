        "en": {"stringUnit": {"state": "translated", "value": "Clean Cut"}},
        "es": {"stringUnit": {"state": "translated", "value": "Corte limpio"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Coupe nette"}},
        "ja": {"stringUnit": {"state": "translated", "value": "鮮やかな切断"}},
        "ko": {"stringUnit": {"state": "translated", "value": "깔끔한 절단"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Corte Limpo"}},
