    "talents.bear_stun_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: bear_stun_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"stun\">Betäubungs</keyword>-Angriffe ignorieren die Hälfte des gegnerischen <keyword id=\"block\">Blocks</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"stun\">Stun</keyword> attacks ignore half enemy <keyword id=\"block\">Block</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les attaques d’<keyword id=\"stun\">Étourdissement</keyword> ignorent la moitié du <keyword id=\"block\">Blocage</keyword> ennemi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"stun\">スタン</keyword>攻撃が敵の<keyword id=\"block\">ブロック</keyword>を半分無視"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"stun\">기절</keyword> 공격이 적의 <keyword id=\"block\">방어도</keyword> 절반 무시"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"stun\">暈眩</keyword>攻擊無視敵人一半<keyword id=\"block\">格擋</keyword>"
          }
        }
      }
    },
