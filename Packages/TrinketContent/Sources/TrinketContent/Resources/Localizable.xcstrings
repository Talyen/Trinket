    "talents.warlock_leech_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: warlock_leech_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">Lebensraub</keyword> gewährt unter halber <keyword id=\"health\">Gesundheit</keyword> auch <keyword id=\"block\">Block</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">Leech</keyword> also grants <keyword id=\"block\">Block</keyword> when below half <keyword id=\"health\">Health</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le <keyword id=\"leech\">Vol de vie</keyword> octroie aussi du <keyword id=\"block\">Blocage</keyword> sous la moitié de votre <keyword id=\"health\">Santé</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">体力</keyword>が半分未満なら、<keyword id=\"leech\">吸収</keyword>で<keyword id=\"block\">ブロック</keyword>も獲得"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">체력</keyword>이 절반 미만이면 <keyword id=\"leech\">흡혈</keyword> 시 <keyword id=\"block\">방어도</keyword>도 획득"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">生命值</keyword>低於一半時，<keyword id=\"leech\">吸血</keyword>也會賦予<keyword id=\"block\">格擋</keyword>"
          }
        }
      }
    },
