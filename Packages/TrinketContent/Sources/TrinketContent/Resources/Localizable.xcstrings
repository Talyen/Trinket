    "affixes.mortar_and_pestle.astral_description": {
      "comment": "ContentManifest/affixes.tsv: mortar_and_pestle, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verursache <keyword id=\"poison\">Gift</keyword>schaden in Höhe der Hälfte deiner wiederhergestellten <keyword id=\"health\">Gesundheit</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deal <keyword id=\"poison\">Poison</keyword> damage equal to half your <keyword id=\"health\">Health</keyword> restored"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Infligez des dégâts de <keyword id=\"poison\">Poison</keyword> à hauteur de la moitié de la <keyword id=\"health\">Santé</keyword> restaurée"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回復した<keyword id=\"health\">体力</keyword>の半分に等しい<keyword id=\"poison\">毒</keyword>ダメージを与える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회복한 <keyword id=\"health\">체력</keyword>의 절반만큼 <keyword id=\"poison\">독</keyword> 피해"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "造成相當於恢復的<keyword id=\"health\">生命值</keyword>一半的<keyword id=\"poison\">中毒</keyword>傷害"
          }
        }
      }
    },
