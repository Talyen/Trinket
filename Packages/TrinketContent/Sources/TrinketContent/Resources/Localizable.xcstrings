    "talents.panther_leech_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: panther_leech_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"bleed\">Blutungs</keyword>-Angriffe erhalten <keyword id=\"leech\">Lebensraub</keyword>, solange du unter <value id=\"quantity_1\">%1$lld</value>%% <keyword id=\"health\">Gesundheit</keyword> bist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"bleed\">Bleed</keyword> attacks gain <keyword id=\"leech\">Leech</keyword> while below <value id=\"quantity_1\">%1$lld</value>%% <keyword id=\"health\">Health</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les attaques de <keyword id=\"bleed\">Saignement</keyword> bénéficient de <keyword id=\"leech\">Vol de vie</keyword> sous <value id=\"quantity_1\">%1$lld</value>%% de <keyword id=\"health\">Santé</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">体力</keyword>が<value id=\"quantity_1\">%1$lld</value>%%未満の間、<keyword id=\"bleed\">出血</keyword>攻撃に<keyword id=\"leech\">吸収</keyword>を付与"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">체력</keyword>이 <value id=\"quantity_1\">%1$lld</value>%% 미만이면 <keyword id=\"bleed\">출혈</keyword> 공격에 <keyword id=\"leech\">흡혈</keyword> 부여"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">生命值</keyword>低於<value id=\"quantity_1\">%1$lld</value>%%時，<keyword id=\"bleed\">流血</keyword>攻擊獲得<keyword id=\"leech\">吸血</keyword>"
          }
        }
      }
    },
