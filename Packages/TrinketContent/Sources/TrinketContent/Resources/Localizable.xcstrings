    "homestead_nodes.blacksmithforge.2.bonus_description": {
      "comment": "ContentManifest/homestead_nodes.tsv: blacksmithForge.2, bonus_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erhöhe <keyword id=\"physical\">physischen</keyword> Schaden um <value id=\"quantity_1\">%1$lld</value>%%\nDie Chance auf astrale Schmiedestücke steigt um <value id=\"quantity_2\">%2$lld</value>%%\nProduziere <value id=\"quantity_3\">%3$lld</value> Eisen pro Tag"}},
        "en": {"stringUnit": {"state": "translated", "value": "Increase <keyword id=\"physical\">Physical</keyword> damage by <value id=\"quantity_1\">%1$lld</value>%%\nAstral forge odds rise by <value id=\"quantity_2\">%2$lld</value>%%\nProduce <value id=\"quantity_3\">%3$lld</value> Iron per Day"}},
        "es": {"stringUnit": {"state": "translated", "value": "Aumenta el daño <keyword id=\"physical\">físico</keyword> en un <value id=\"quantity_1\">%1$lld</value>%%\nLa probabilidad astral al forjar aumenta en un <value id=\"quantity_2\">%2$lld</value>%%\nProduce <value id=\"quantity_3\">%3$lld</value> de hierro al día"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Dégâts de type <keyword id=\"physical\">Physique</keyword> augmentés de <value id=\"quantity_1\">%1$lld</value>%%\nChances de forge astrale augmentées de <value id=\"quantity_2\">%2$lld</value>%%\nProduction quotidienne de fer : <value id=\"quantity_3\">%3$lld</value>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">物理</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%増加\n星界級の鍛造確率が<value id=\"quantity_2\">%2$lld</value>%%上昇\n1日に鉄を<value id=\"quantity_3\">%3$lld</value>生産"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">물리</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가\n성운 등급 제작 확률 <value id=\"quantity_2\">%2$lld</value>%% 증가\n하루에 철 <value id=\"quantity_3\">%3$lld</value>개 생산"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Aumente o dano <keyword id=\"physical\">Físico</keyword> em <value id=\"quantity_1\">%1$lld</value>%%\nA chance de forjar itens Astrais aumenta em <value id=\"quantity_2\">%2$lld</value>%%\nProduza <value id=\"quantity_3\">%3$lld</value> de Ferro por Dia"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">物理</keyword>傷害提高<value id=\"quantity_1\">%1$lld</value>%%\n星界級鍛造機率提高<value id=\"quantity_2\">%2$lld</value>%%\n每天生產<value id=\"quantity_3\">%3$lld</value>鐵"}}
      }
    },
