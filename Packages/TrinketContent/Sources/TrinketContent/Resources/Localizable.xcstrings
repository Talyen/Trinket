    "talents.mana_moth_freeze_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: mana_moth_freeze_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">Frost</keyword>-Angriffe erhalten +<value id=\"quantity_1\">%1$lld</value>%% Chance auf kritische Treffer"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">Freeze</keyword> attacks gain +<value id=\"quantity_1\">%1$lld</value>%% Critical Hit chance"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques de <keyword id=\"freeze\">Congelación</keyword> obtienen +<value id=\"quantity_1\">%1$lld</value>%% de probabilidad de golpe crítico"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques de <keyword id=\"freeze\">Gel</keyword> gagnent +<value id=\"quantity_1\">%1$lld</value>%% de chances de coup critique"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">凍結</keyword>攻撃のクリティカル率が<value id=\"quantity_1\">%1$lld</value>%%上昇"}},
