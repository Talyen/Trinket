    "affixes.insulated.astral_description": {
      "comment": "ContentManifest/affixes.tsv: insulated, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erleide <value id=\"quantity_1\">%1$lld</value>%% weniger <keyword id=\"stun\">Betäubungs</keyword>schaden"
