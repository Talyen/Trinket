    "talents.wildcard_physical_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: wildcard_physical_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Durchbrechen gegnerischen <keyword id=\"block\">Blocks</keyword> mit <keyword id=\"physical\">physischem</keyword> Schaden lässt deinen nächsten Angriff kritisch treffen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Breaking enemy <keyword id=\"block\">Block</keyword> with <keyword id=\"physical\">Physical</keyword> damage makes your next attack Critically Hit"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Briser le <keyword id=\"block\">Blocage</keyword> ennemi avec des dégâts de type <keyword id=\"physical\">Physique</keyword> garantit un coup critique à votre prochaine attaque"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"physical\">物理</keyword>ダメージで敵の<keyword id=\"block\">ブロック</keyword>を崩すと、次の攻撃が必ずクリティカルヒット"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"physical\">물리</keyword> 피해로 적의 <keyword id=\"block\">방어도</keyword>를 깨뜨리면 다음 공격이 반드시 치명타"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以<keyword id=\"physical\">物理</keyword>傷害擊破敵人<keyword id=\"block\">格擋</keyword>後，下次攻擊必定暴擊"
          }
        }
      }
    },
