    "talents.wildcard_gold_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: wildcard_gold_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dein erster vollständig geblockter Angriff in jedem Kampf\nfügt deiner Hand eine zufällige Karte hinzu"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your first fully Blocked attack each combat\nadds a random card to your hand"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu primer ataque completamente bloqueado de cada combate\nañade una carta aleatoria a tu mano"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre première attaque entièrement bloquée de chaque combat\najoute une carte aléatoire à votre main"}},
        "ja": {"stringUnit": {"state": "translated", "value": "各戦闘で初めて自分の攻撃が完全にブロックされると\nランダムなカードを1枚手札に追加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "매 전투 내 공격이 처음으로 완전히 막히면\n손에 무작위 카드 한 장 추가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seu primeiro ataque totalmente Bloqueado de cada combate\nadiciona uma carta aleatória à sua mão"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每場戰鬥自身攻擊首次被完全格擋時\n將一張隨機卡牌加入手牌"}}
      }
    },
    "talents.wildcard_gold_t1_1.name": {
      "comment": "ContentManifest/talents.tsv: wildcard_gold_t1_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Trostpreis"}},
        "en": {"stringUnit": {"state": "translated", "value": "Consolation Prize"}},
        "es": {"stringUnit": {"state": "translated", "value": "Premio de consolación"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Lot de consolation"}},
        "ja": {"stringUnit": {"state": "translated", "value": "残念賞"}},
        "ko": {"stringUnit": {"state": "translated", "value": "위로상"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Prêmio de Consolação"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "安慰獎"}}
      }
    },
    "talents.wildcard_gold_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: wildcard_gold_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Der Erhalt von <keyword id=\"gold\">Gold</keyword> stellt mit <value id=\"quantity_1\">%1$lld</value>%% Chance <value id=\"quantity_2\">%2$lld</value> <keyword id=\"health\">Gesundheit</keyword> wieder her"}},
        "en": {"stringUnit": {"state": "translated", "value": "Gaining <keyword id=\"gold\">Gold</keyword> has a <value id=\"quantity_1\">%1$lld</value>%% chance to restore <value id=\"quantity_2\">%2$lld</value> <keyword id=\"health\">Health</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Obtener <keyword id=\"gold\">Oro</keyword> tiene un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de restaurar <value id=\"quantity_2\">%2$lld</value> de <keyword id=\"health\">Salud</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Gagner de l’<keyword id=\"gold\">Or</keyword> a <value id=\"quantity_1\">%1$lld</value>%% de chances de restaurer <value id=\"quantity_2\">%2$lld</value> <keyword id=\"health\">Santé</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"gold\">ゴールド</keyword>を獲得すると<value id=\"quantity_1\">%1$lld</value>%%の確率で<keyword id=\"health\">体力</keyword>を<value id=\"quantity_2\">%2$lld</value>回復"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"gold\">골드</keyword> 획득 시 <value id=\"quantity_1\">%1$lld</value>%% 확률로 <keyword id=\"health\">체력</keyword> <value id=\"quantity_2\">%2$lld</value> 회복"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ganhar <keyword id=\"gold\">Ouro</keyword> tem <value id=\"quantity_1\">%1$lld</value>%% de chance de restaurar <value id=\"quantity_2\">%2$lld</value> de <keyword id=\"health\">Vida</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "獲得<keyword id=\"gold\">金幣</keyword>時，有<value id=\"quantity_1\">%1$lld</value>%%機率恢復<value id=\"quantity_2\">%2$lld</value>點<keyword id=\"health\">生命值</keyword>"}}
      }
    },
    "talents.wildcard_gold_t1_2.name": {
      "comment": "ContentManifest/talents.tsv: wildcard_gold_t1_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">Gesundheit</keyword> ist Reichtum"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">Health</keyword> is Wealth"}},
        "es": {"stringUnit": {"state": "translated", "value": "La <keyword id=\"health\">Salud</keyword> es riqueza"}},
        "fr": {"stringUnit": {"state": "translated", "value": "La <keyword id=\"health\">Santé</keyword>, c’est la richesse"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>こそ富"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword>이 재산"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">Vida</keyword> É Riqueza"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">生命值</keyword>就是財富"}}
      }
    },
    "talents.wildcard_gold_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: wildcard_gold_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Kritische Treffer, die <keyword id=\"gold\">Gold</keyword> stehlen, gewähren <value id=\"quantity_1\">%1$lld</value> zusätzliches <keyword id=\"gold\">Gold</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Critical Hits that steal <keyword id=\"gold\">Gold</keyword> grant <value id=\"quantity_1\">%1$lld</value> additional <keyword id=\"gold\">Gold</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los golpes críticos que roban <keyword id=\"gold\">Oro</keyword> otorgan <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"gold\">Oro</keyword> adicional"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les coups critiques qui volent de l’<keyword id=\"gold\">Or</keyword> octroient <value id=\"quantity_1\">%1$lld</value> d’<keyword id=\"gold\">Or</keyword> supplémentaire"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"gold\">ゴールド</keyword>を盗むクリティカルヒットで、<keyword id=\"gold\">ゴールド</keyword>を追加で<value id=\"quantity_1\">%1$lld</value>獲得"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"gold\">골드</keyword>를 훔치는 치명타 적중 시 <keyword id=\"gold\">골드</keyword> <value id=\"quantity_1\">%1$lld</value> 추가 획득"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Golpes críticos que roubam <keyword id=\"gold\">Ouro</keyword> concedem <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"gold\">Ouro</keyword> adicional"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "偷取<keyword id=\"gold\">金幣</keyword>的暴擊額外賦予<value id=\"quantity_1\">%1$lld</value><keyword id=\"gold\">金幣</keyword>"}}
      }
    },
