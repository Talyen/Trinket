          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"block\">방어도</keyword>가 있으면 <keyword id=\"physical\">물리</keyword> 외의 받는 피해 <value id=\"quantity_1\">%1$lld</value> 감소"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擁有<keyword id=\"block\">格擋</keyword>時，承受的非<keyword id=\"physical\">物理</keyword>傷害降低<value id=\"quantity_1\">%1$lld</value>點"
          }
