        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 턴 걸러 <keyword id=\"health\">체력</keyword> <value id=\"quantity_1\">%1$lld</value> 소모 후 카드 한 장 뽑기"
          }
        },
        "zh-Hant": {
          "stringUnit": {
