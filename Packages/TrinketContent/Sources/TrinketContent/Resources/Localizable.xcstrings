    "affixes.thick_skinned.astral_description": {
      "comment": "ContentManifest/affixes.tsv: thick-skinned, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erleide <value id=\"quantity_1\">%1$lld</value>%% weniger <keyword id=\"bleed\">Blutungs</keyword>schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Take <value id=\"quantity_1\">%1$lld</value>%% less <keyword id=\"bleed\">Bleed</keyword> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Recibe un <value id=\"quantity_1\">%1$lld</value>%% menos de daño de <keyword id=\"bleed\">Sangrado</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Dégâts de <keyword id=\"bleed\">Saignement</keyword> subis réduits de <value id=\"quantity_1\">%1$lld</value>%%"}},
        "ja": {"stringUnit": {"state": "translated", "value": "受ける<keyword id=\"bleed\">出血</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%減少"}},
        "ko": {"stringUnit": {"state": "translated", "value": "받는 <keyword id=\"bleed\">출혈</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>%% 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Receba <value id=\"quantity_1\">%1$lld</value>%% menos dano de <keyword id=\"bleed\">Sangramento</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "承受的<keyword id=\"bleed\">流血</keyword>傷害降低<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
