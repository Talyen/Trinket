    "talents.library_owl_holy_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: library_owl_holy_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Kritische <keyword id=\"holy\">heilige</keyword> Treffer verhindern gegnerischen <keyword id=\"block\">Block</keyword> bis zu deinem nächsten Zug"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">Holy</keyword> Critical Hits prevent enemy <keyword id=\"block\">Block</keyword> until your next turn"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los golpes críticos <keyword id=\"holy\">sagrados</keyword> impiden el <keyword id=\"block\">Bloqueo</keyword> del enemigo hasta tu siguiente turno"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les coups critiques de type <keyword id=\"holy\">Sacré</keyword> empêchent l’ennemi de gagner du <keyword id=\"block\">Blocage</keyword> jusqu’à votre prochain tour"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">聖</keyword>クリティカルヒットで、次の自分のターンまで敵の<keyword id=\"block\">ブロック</keyword>獲得を防ぐ"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">신성</keyword> 치명타가 다음 내 턴까지 적의 <keyword id=\"block\">방어도</keyword> 획득 방지"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Golpes críticos <keyword id=\"holy\">Sagrados</keyword> impedem <keyword id=\"block\">Bloqueio</keyword> inimigo até seu próximo turno"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">神聖</keyword>暴擊阻止敵人獲得<keyword id=\"block\">格擋</keyword>，直到下個自身回合"}}
      }
    },
    "talents.library_owl_holy_t4_1.name": {
      "comment": "ContentManifest/talents.tsv: library_owl_holy_t4_1, name",
