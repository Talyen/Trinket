    "talents.alchemist_cleanse_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: alchemist_cleanse_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Fähigkeiten, die <keyword id=\"health\">Gesundheit</keyword> wiederherstellen, <keyword id=\"cleanse\">reinigen</keyword> auch <value id=\"quantity_1\">%1$lld</value> Schwächungseffekt"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Fähigkeiten, die <keyword id=\"health\">Gesundheit</keyword> wiederherstellen, <keyword id=\"cleanse\">reinigen</keyword> auch <value id=\"quantity_1\">%1$lld</value> Schwächungseffekte"
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Abilities that restore <keyword id=\"health\">Health</keyword> also <keyword id=\"cleanse\">Cleanse</keyword> <value id=\"quantity_1\">%1$lld</value> debuff"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Abilities that restore <keyword id=\"health\">Health</keyword> also <keyword id=\"cleanse\">Cleanse</keyword> <value id=\"quantity_1\">%1$lld</value> debuffs"
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Les capacités qui rendent de la <keyword id=\"health\">Santé</keyword> déclenchent aussi la <keyword id=\"cleanse\">Purification</keyword> de <value id=\"quantity_1\">%1$lld</value> malus"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Les capacités qui rendent de la <keyword id=\"health\">Santé</keyword> déclenchent aussi la <keyword id=\"cleanse\">Purification</keyword> de <value id=\"quantity_1\">%1$lld</value> malus"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Les capacités qui rendent de la <keyword id=\"health\">Santé</keyword> déclenchent aussi la <keyword id=\"cleanse\">Purification</keyword> de <value id=\"quantity_1\">%1$lld</value> malus"
                }
              }
            }
