    "affixes.rekindled.astral_description": {
      "comment": "ContentManifest/affixes.tsv: rekindled, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Stelle <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Gesundheit</keyword> wieder her, wenn du die <keyword id=\"deathsdoor\">Todesschwelle</keyword> überlebst"}},
        "en": {"stringUnit": {"state": "translated", "value": "Restore <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Health</keyword> when you survive <keyword id=\"deathsdoor\">Death's Door</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Restaura <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Salud</keyword> cuando sobrevives a las <keyword id=\"deathsdoor\">Puertas de la Muerte</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Restaurez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Santé</keyword> lorsque vous survivez au <keyword id=\"deathsdoor\">Seuil de la mort</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">死の淵</keyword>を生き延びると<keyword id=\"health\">体力</keyword>を<value id=\"quantity_1\">%1$lld</value>回復"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"deathsdoor\">죽음의 문턱</keyword>에서 살아남으면 <keyword id=\"health\">체력</keyword> <value id=\"quantity_1\">%1$lld</value> 회복"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Restaure <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Vida</keyword> ao sobreviver à condição <keyword id=\"deathsdoor\">À Beira da Morte</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "從<keyword id=\"deathsdoor\">瀕死之門</keyword>生還時，恢復<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"health\">生命值</keyword>"}}
      }
    },
    "affixes.rekindled.basic_description": {
      "comment": "ContentManifest/affixes.tsv: rekindled, basic_description",
      "extractionState": "manual",
      "localizations": {
