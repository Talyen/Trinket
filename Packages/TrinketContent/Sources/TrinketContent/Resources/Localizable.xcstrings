      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter halber <keyword id=\"health\">Gesundheit</keyword> stellt dein erster Erhalt von <keyword id=\"gold\">Gold</keyword> in jedem Zug <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Gesundheit</keyword> wieder her"
