      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Einmal pro Zug: Wenn du deinen Gefährten heilst, ziehe eine Gefährtenkarte"}},
        "en": {"stringUnit": {"state": "translated", "value": "Once per turn, healing your Companion draws a Companion card"}},
