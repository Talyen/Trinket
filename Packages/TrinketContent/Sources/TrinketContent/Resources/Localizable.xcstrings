    "homestead_nodes.chickencoop.1.summary": {
      "comment": "ContentManifest/homestead_nodes.tsv: chickenCoop.1, summary",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ein lebhafter Hühnerstall, der zwischen Abenteuern grundlegende Vorräte liefert"}},
        "en": {"stringUnit": {"state": "translated", "value": "A lively coop that keeps simple supplies moving between runs"}},
        "es": {"stringUnit": {"state": "translated", "value": "Un gallinero animado que mantiene el suministro de recursos básicos entre aventuras"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Un poulailler animé qui fournit des provisions de base entre les aventures"}},
        "ja": {"stringUnit": {"state": "translated", "value": "冒険の合間に日用品をまかなう、にぎやかな鶏小屋"}},
        "ko": {"stringUnit": {"state": "translated", "value": "모험 사이에도 기본 보급품을 꾸준히 제공하는 활기찬 닭장"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Um galinheiro animado que mantém o fluxo de suprimentos simples entre aventuras"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "在冒險之間持續提供日常物資的熱鬧雞舍"}}
      }
    },
