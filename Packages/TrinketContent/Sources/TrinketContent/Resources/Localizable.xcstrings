    "talents.risen_skeleton_leech_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_leech_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine erste überschüssige Heilung durch <keyword id=\"leech\">Lebensraub</keyword> in jedem Zug gewährt halb so viel <keyword id=\"block\">Block</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your first excess <keyword id=\"leech\">Leech</keyword> restoration each turn grants half as much <keyword id=\"block\">Block</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre première restauration par <keyword id=\"leech\">Vol de vie</keyword> excédentaire de chaque tour octroie la moitié de ce montant en <keyword id=\"block\">Blocage</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ターンで最初の<keyword id=\"leech\">吸収</keyword>による過剰回復時に、その半分の<keyword id=\"block\">ブロック</keyword>を獲得"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매 턴 첫 <keyword id=\"leech\">흡혈</keyword> 초과 회복량의 절반만큼 <keyword id=\"block\">방어도</keyword> 획득"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每回合首次<keyword id=\"leech\">吸血</keyword>過量恢復時，獲得相當於過量恢復量一半的<keyword id=\"block\">格擋</keyword>"
          }
        }
      }
    },
