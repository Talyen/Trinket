        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les coûts en <keyword id=\"health\">Santé</keyword> réduisent de <value id=\"quantity_1\">%1$lld</value> le coût de votre prochain renforcement au <keyword id=\"mana\">Mana</keyword>"
