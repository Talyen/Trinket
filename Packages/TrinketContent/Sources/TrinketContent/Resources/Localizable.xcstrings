    "traits.gathering_zeal.description": {
      "comment": "ContentManifest/traits.tsv: gathering_zeal, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verursachter <keyword id=\"holy\">heiliger</keyword> Schaden fügt dem nächsten Angriff <value id=\"quantity_1\">%1$lld</value> <keyword id=\"holy\">heiligen</keyword> Schaden hinzu"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dealing <keyword id=\"holy\">Holy</keyword> damage adds <value id=\"quantity_1\">%1$lld</value> <keyword id=\"holy\">Holy</keyword> damage to the next attack"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Infliger des dégâts de type <keyword id=\"holy\">Sacré</keyword> ajoute <value id=\"quantity_1\">%1$lld</value> dégâts de type <keyword id=\"holy\">Sacré</keyword> à la prochaine attaque"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"holy\">聖</keyword>ダメージを与えると、次の攻撃に<keyword id=\"holy\">聖</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>追加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"holy\">신성</keyword> 피해를 주면 다음 공격에 <keyword id=\"holy\">신성</keyword> 피해 <value id=\"quantity_1\">%1$lld</value> 추가"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "造成<keyword id=\"holy\">神聖</keyword>傷害時，為下次攻擊增加<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"holy\">神聖</keyword>傷害"
          }
        }
      }
    },
