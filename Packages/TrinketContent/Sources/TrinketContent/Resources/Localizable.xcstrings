            "state": "translated",
            "value": "Les ennemis sous <keyword id=\"stun\">Étourdissement</keyword> infligent <value id=\"quantity_1\">%1$lld</value>%% de dégâts en moins au prochain tour"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"stun\">スタン</keyword>状態の敵が次のターンに与えるダメージが<value id=\"quantity_1\">%1$lld</value>%%減少"
