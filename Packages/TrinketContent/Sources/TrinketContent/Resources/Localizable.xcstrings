    "affixes.spiteful.title": {
      "comment": "ContentManifest/affixes.tsv: spiteful, title",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Gehässig"}},
        "en": {"stringUnit": {"state": "translated", "value": "Spiteful"}},
        "es": {"stringUnit": {"state": "translated", "value": "Rencoroso"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Rancunier"}},
        "ja": {"stringUnit": {"state": "translated", "value": "怨念"}},
        "ko": {"stringUnit": {"state": "translated", "value": "앙심 품은"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Rancoroso"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "惡意"}}
      }
    },
    "affixes.steadfast.astral_description": {
      "comment": "ContentManifest/affixes.tsv: steadfast, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wenn du ohne <keyword id=\"block\">Block</keyword> einen Gegner <keyword id=\"stun\">betäubst</keyword>, erhalte <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "When you <keyword id=\"stun\">Stun</keyword> with no <keyword id=\"block\">Block</keyword>, gain <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Sin <keyword id=\"block\">Bloqueo</keyword>, <keyword id=\"stun\">aturdir</keyword> a un enemigo otorga <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueo</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Sans <keyword id=\"block\">Blocage</keyword>, <keyword id=\"stun\">étourdir</keyword> un ennemi confère <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Blocage</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">ブロック</keyword>がないときに敵を<keyword id=\"stun\">スタン</keyword>させると、<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>得る"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">방어도</keyword>가 없을 때 적을 <keyword id=\"stun\">기절</keyword>시키면 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 획득"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Sem <keyword id=\"block\">Bloqueio</keyword>, <keyword id=\"stun\">atordoar</keyword> um inimigo concede <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueio</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "沒有<keyword id=\"block\">格擋</keyword>時使敵人<keyword id=\"stun\">暈眩</keyword>，獲得<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>"}}
      }
    },
    "affixes.steadfast.basic_description": {
      "comment": "ContentManifest/affixes.tsv: steadfast, basic_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wenn du ohne <keyword id=\"block\">Block</keyword> einen Gegner <keyword id=\"stun\">betäubst</keyword>, erhalte <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"}},
