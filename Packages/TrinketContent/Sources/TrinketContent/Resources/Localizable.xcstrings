    "affixes.discerning.astral_description": {
      "comment": "ContentManifest/affixes.tsv: discerning, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Angriffe verursachen <value id=\"quantity_1\">%1$lld</value> zusätzlichen Schaden pro gegnerischer Stärkung"}},
        "en": {"stringUnit": {"state": "translated", "value": "Attacks gain <value id=\"quantity_1\">%1$lld</value> damage per enemy buff"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques infligen <value id=\"quantity_1\">%1$lld</value> de daño adicional por cada efecto beneficioso del enemigo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques infligent <value id=\"quantity_1\">%1$lld</value> dégâts supplémentaires par effet bénéfique ennemi"}},
        "ja": {"stringUnit": {"state": "translated", "value": "敵の強化効果1つにつき攻撃ダメージが<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "적의 강화 효과 하나당 공격 피해가 <value id=\"quantity_1\">%1$lld</value> 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques causam <value id=\"quantity_1\">%1$lld</value> de dano adicional por efeito benéfico no inimigo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "敵人每有一項增益效果，攻擊傷害提高<value id=\"quantity_1\">%1$lld</value>"}}
      }
    },
