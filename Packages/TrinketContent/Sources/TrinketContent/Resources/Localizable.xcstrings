        "fr": {"stringUnit": {"state": "translated", "value": "Les dégâts de <keyword id=\"bleed\">Saignement</keyword> ont <value id=\"quantity_1\">%1$lld</value>%% de chances de voler aussi de l’<keyword id=\"gold\">Or</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">出血</keyword>ダメージ時、<value id=\"quantity_1\">%1$lld</value>%%の確率でさらに<keyword id=\"gold\">ゴールド</keyword>を盗む"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">출혈</keyword> 피해가 <value id=\"quantity_1\">%1$lld</value>%% 확률로 <keyword id=\"gold\">골드</keyword>도 훔침"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O dano de <keyword id=\"bleed\">Sangramento</keyword> tem <value id=\"quantity_1\">%1$lld</value>%% de chance de também roubar <keyword id=\"gold\">Ouro</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">流血</keyword>傷害有<value id=\"quantity_1\">%1$lld</value>%%機率同時偷取<keyword id=\"gold\">金幣</keyword>"}}
      }
    },
