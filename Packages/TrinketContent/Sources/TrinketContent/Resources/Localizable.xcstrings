    "talents.frost_whelp_dodge_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: frost_whelp_dodge_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Nach dem Ausweichen verursacht dein nächster <keyword id=\"freeze\">Frost</keyword>angriff <value id=\"quantity_1\">%1$lld</value> zusätzlichen Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Dodging adds <value id=\"quantity_1\">%1$lld</value> damage to your next <keyword id=\"freeze\">Freeze</keyword> attack"}},
        "es": {"stringUnit": {"state": "translated", "value": "Esquivar añade <value id=\"quantity_1\">%1$lld</value> de daño a tu siguiente ataque de <keyword id=\"freeze\">Congelación</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Esquiver ajoute <value id=\"quantity_1\">%1$lld</value> dégâts à votre prochaine attaque de <keyword id=\"freeze\">Gel</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "回避すると、次の<keyword id=\"freeze\">凍結</keyword>攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>増加する"}},
        "ko": {"stringUnit": {"state": "translated", "value": "회피하면 다음 <keyword id=\"freeze\">빙결</keyword> 공격의 피해가 <value id=\"quantity_1\">%1$lld</value> 증가합니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Esquivar adiciona <value id=\"quantity_1\">%1$lld</value> de dano ao seu próximo ataque de <keyword id=\"freeze\">Congelamento</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "閃避後，你的下一次<keyword id=\"freeze\">冰凍</keyword>攻擊傷害提高<value id=\"quantity_1\">%1$lld</value>點"}}
      }
    },
    "talents.frost_whelp_dodge_t2_2.name": {
      "comment": "ContentManifest/talents.tsv: frost_whelp_dodge_t2_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Flügelschlag"}},
        "en": {"stringUnit": {"state": "translated", "value": "Wing Buffet"}},
        "es": {"stringUnit": {"state": "translated", "value": "Golpe de ala"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Coup d’aile"}},
        "ja": {"stringUnit": {"state": "translated", "value": "翼の猛打"}},
        "ko": {"stringUnit": {"state": "translated", "value": "날개 강타"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Golpe de Asa"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "翼擊"}}
      }
    },
    "talents.frost_whelp_dodge_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: frost_whelp_dodge_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Ausweichen vor einem Angriff gewährt dem Helden <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Dodging an attack grants the Hero <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Esquivar un ataque otorga al héroe <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueo</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Esquiver une attaque octroie <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Blocage</keyword> au Héros"}},
        "ja": {"stringUnit": {"state": "translated", "value": "攻撃を回避すると、ヒーローに<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>付与"}},
        "ko": {"stringUnit": {"state": "translated", "value": "공격 회피 시 영웅에게 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 부여"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Esquivar de um ataque concede <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueio</keyword> ao Herói"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "閃避攻擊時，賦予英雄<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>"}}
      }
    },
    "talents.frost_whelp_dodge_t3_1.name": {
      "comment": "ContentManifest/talents.tsv: frost_whelp_dodge_t3_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Luftdeckung"}},
        "en": {"stringUnit": {"state": "translated", "value": "Aerial Cover"}},
        "es": {"stringUnit": {"state": "translated", "value": "Cobertura aérea"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Couverture aérienne"}},
        "ja": {"stringUnit": {"state": "translated", "value": "空からの援護"}},
        "ko": {"stringUnit": {"state": "translated", "value": "공중 엄호"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cobertura Aérea"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "空中掩護"}}
      }
    },
    "talents.frost_whelp_dodge_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: frost_whelp_dodge_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Nach dem Ausweichen ist dein nächstes Verstärken mit <keyword id=\"mana\">Mana</keyword> kostenlos"}},
        "en": {"stringUnit": {"state": "translated", "value": "Dodging makes your next <keyword id=\"mana\">Mana</keyword> empowerment free"}},
        "es": {"stringUnit": {"state": "translated", "value": "Esquivar hace que tu siguiente potenciación con <keyword id=\"mana\">Maná</keyword> sea gratuita"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Une esquive rend votre prochain renforcement au <keyword id=\"mana\">Mana</keyword> gratuit"}},
        "ja": {"stringUnit": {"state": "translated", "value": "回避すると、次の<keyword id=\"mana\">マナ</keyword>強化の消費がなくなる"}},
        "ko": {"stringUnit": {"state": "translated", "value": "회피 시 다음 <keyword id=\"mana\">마나</keyword> 강화가 무료"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Esquivar torna gratuito seu próximo fortalecimento com <keyword id=\"mana\">Mana</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "閃避後，下次<keyword id=\"mana\">魔力</keyword>強化無需消耗"}}
      }
    },
    "talents.frost_whelp_dodge_t3_2.name": {
      "comment": "ContentManifest/talents.tsv: frost_whelp_dodge_t3_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Sturmflügel"}},
        "en": {"stringUnit": {"state": "translated", "value": "Tempest Wing"}},
        "es": {"stringUnit": {"state": "translated", "value": "Ala de tempestad"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Aile de tempête"}},
        "ja": {"stringUnit": {"state": "translated", "value": "嵐の翼"}},
        "ko": {"stringUnit": {"state": "translated", "value": "폭풍의 날개"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Asa da Tempestade"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "風暴之翼"}}
      }
    },
    "talents.frost_whelp_dodge_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: frost_whelp_dodge_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Nach dem Ausweichen ignoriert dein nächster <keyword id=\"freeze\">Frost</keyword>-Angriff gegnerischen <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Dodging makes your next <keyword id=\"freeze\">Freeze</keyword> attack ignore enemy <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Esquivar hace que tu siguiente ataque de <keyword id=\"freeze\">Congelación</keyword> ignore el <keyword id=\"block\">Bloqueo</keyword> del enemigo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Une esquive fait ignorer le <keyword id=\"block\">Blocage</keyword> ennemi à votre prochaine attaque de <keyword id=\"freeze\">Gel</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "回避すると、次の<keyword id=\"freeze\">凍結</keyword>攻撃が敵の<keyword id=\"block\">ブロック</keyword>を無視"}},
        "ko": {"stringUnit": {"state": "translated", "value": "회피 시 다음 <keyword id=\"freeze\">빙결</keyword> 공격이 적의 <keyword id=\"block\">방어도</keyword> 무시"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Esquivar faz seu próximo ataque de <keyword id=\"freeze\">Congelamento</keyword> ignorar o <keyword id=\"block\">Bloqueio</keyword> inimigo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "閃避後，下次<keyword id=\"freeze\">冰凍</keyword>攻擊無視敵人<keyword id=\"block\">格擋</keyword>"}}
      }
    },
    "talents.frost_whelp_dodge_t4_1.name": {
      "comment": "ContentManifest/talents.tsv: frost_whelp_dodge_t4_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Winterspur"}},
        "en": {"stringUnit": {"state": "translated", "value": "Winter’s Wake"}},
        "es": {"stringUnit": {"state": "translated", "value": "Estela del invierno"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Sillage de l’hiver"}},
        "ja": {"stringUnit": {"state": "translated", "value": "冬の余波"}},
        "ko": {"stringUnit": {"state": "translated", "value": "겨울의 흔적"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Rastro do Inverno"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "寒冬餘波"}}
      }
    },
    "talents.frost_whelp_freeze_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: frost_whelp_freeze_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Treffer mit <keyword id=\"freeze\">Frost</keyword>-Karten, die <keyword id=\"health\">Gesundheit</keyword> abziehen, lassen dich mit <value id=\"quantity_1\">%1$lld</value>%% Chance eine Karte ziehen"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">Freeze</keyword> card hits that remove <keyword id=\"health\">Health</keyword> have a <value id=\"quantity_1\">%1$lld</value>%% chance to draw a card"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los impactos de cartas de <keyword id=\"freeze\">Congelación</keyword> que reducen <keyword id=\"health\">Salud</keyword> tienen un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de hacer que robes una carta"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les coups de cartes de <keyword id=\"freeze\">Gel</keyword> qui retirent de la <keyword id=\"health\">Santé</keyword> ont <value id=\"quantity_1\">%1$lld</value>%% de chances de faire piocher une carte"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">凍結</keyword>カードのヒットで<keyword id=\"health\">体力</keyword>を減らすと、<value id=\"quantity_1\">%1$lld</value>%%の確率でカードを1枚引く"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">빙결</keyword> 카드 적중으로 <keyword id=\"health\">체력</keyword>을 깎으면 <value id=\"quantity_1\">%1$lld</value>%% 확률로 카드 한 장 뽑기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Acertos de cartas de <keyword id=\"freeze\">Congelamento</keyword> que removem <keyword id=\"health\">Vida</keyword> têm <value id=\"quantity_1\">%1$lld</value>%% de chance de comprar uma carta"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">冰凍</keyword>卡牌命中並使敵人失去<keyword id=\"health\">生命值</keyword>時，有<value id=\"quantity_1\">%1$lld</value>%%機率抽一張牌"}}
      }
    },
