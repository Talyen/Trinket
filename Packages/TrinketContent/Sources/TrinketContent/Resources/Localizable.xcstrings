    "talents.shield_scarab_holy_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: shield_scarab_holy_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dein erster <keyword id=\"holy\">heiliger</keyword> Treffer in jedem Zug verursacht <value id=\"quantity_1\">%1$lld</value>%% mehr Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your first <keyword id=\"holy\">Holy</keyword> hit each turn deals <value id=\"quantity_1\">%1$lld</value>%% more damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu primer impacto <keyword id=\"holy\">sagrado</keyword> de cada turno inflige un <value id=\"quantity_1\">%1$lld</value>%% más de daño"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre premier coup de type <keyword id=\"holy\">Sacré</keyword> de chaque tour inflige <value id=\"quantity_1\">%1$lld</value>%% de dégâts en plus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "各ターンで最初の<keyword id=\"holy\">聖</keyword>ヒットのダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "매 턴 첫 <keyword id=\"holy\">신성</keyword> 적중 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seu primeiro acerto <keyword id=\"holy\">Sagrado</keyword> de cada turno causa <value id=\"quantity_1\">%1$lld</value>%% mais dano"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每回合首次<keyword id=\"holy\">神聖</keyword>命中的傷害提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
