    "affixes.bone_charm.astral_description": {
      "comment": "ContentManifest/affixes.tsv: bone_charm, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe eine Karte, wenn du in einem Zug erstmals <keyword id=\"health\">Gesundheit</keyword> verlierst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw a card the first time you lose <keyword id=\"health\">Health</keyword> each turn"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Piochez une carte la première fois que vous perdez de la <keyword id=\"health\">Santé</keyword> à chaque tour"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ターンに初めて<keyword id=\"health\">体力</keyword>を失うと、カードを1枚引く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매 턴 처음으로 <keyword id=\"health\">체력</keyword>을 잃으면 카드 한 장 뽑기"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每回合首次失去<keyword id=\"health\">生命值</keyword>時，抽一張牌"
          }
        }
      }
    },
