        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"gold\">골드</keyword>를 훔치는 치명타 적중 시 <keyword id=\"gold\">골드</keyword> <value id=\"quantity_1\">%1$lld</value> 추가 획득"
          }
