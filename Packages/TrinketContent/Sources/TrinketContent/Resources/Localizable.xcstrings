    "talents.panther_leech_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: panther_leech_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überschüssige Wiederherstellung deiner <keyword id=\"health\">Gesundheit</keyword> durch <keyword id=\"leech\">Lebensraub</keyword> heilt deinen Verbündeten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Excess <keyword id=\"leech\">Leech</keyword> <keyword id=\"health\">Health</keyword> restoration is shared with your ally"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La <keyword id=\"health\">Santé</keyword> restaurée en excès par <keyword id=\"leech\">Vol de vie</keyword> est partagée avec votre allié"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">吸収</keyword>による<keyword id=\"health\">体力</keyword>の過剰回復を味方と共有"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">흡혈</keyword>의 초과 <keyword id=\"health\">체력</keyword> 회복량을 아군과 공유"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">吸血</keyword>對<keyword id=\"health\">生命值</keyword>的過量恢復與友方共享"
          }
        }
      }
    },
