    "affixes.briarward.astral_description": {
      "comment": "ContentManifest/affixes.tsv: briarward, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dein <keyword id=\"block\">Block</keyword> durchbrochen wird, erhalte <value id=\"quantity_1\">%1$lld</value> <keyword id=\"thorns\">Dornen</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When your <keyword id=\"block\">Block</keyword> is broken, gain <value id=\"quantity_1\">%1$lld</value> <keyword id=\"thorns\">Thorns</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque votre <keyword id=\"block\">Blocage</keyword> est brisé, gagnez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"thorns\">Épines</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の<keyword id=\"block\">ブロック</keyword>が崩れると<keyword id=\"thorns\">棘</keyword>を<value id=\"quantity_1\">%1$lld</value>獲得"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 <keyword id=\"block\">방어도</keyword>가 깨지면 <keyword id=\"thorns\">가시</keyword> <value id=\"quantity_1\">%1$lld</value> 획득"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自身<keyword id=\"block\">格擋</keyword>被擊破時，獲得<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"thorns\">荊棘</keyword>"
          }
        }
      }
    },
