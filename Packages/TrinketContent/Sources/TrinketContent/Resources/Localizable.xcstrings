          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"mana\">마나</keyword>로 강화한 <keyword id=\"burn\">화상</keyword> 공격의 추가 피해 <value id=\"quantity_1\">%1$lld</value>"
          }
