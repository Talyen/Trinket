        "ja": {"stringUnit": {"state": "translated", "value": "捕食者の狙い"}},
        "ko": {"stringUnit": {"state": "translated", "value": "포식자의 조준"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Foco Predatório"}},
