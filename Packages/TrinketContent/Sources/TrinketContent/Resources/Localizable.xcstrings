      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">Lebensraub</keyword>-Angriffe erhalten gegen <keyword id=\"bleed\">blutende</keyword> Gegner +<value id=\"quantity_1\">%1$lld</value>%% Chance auf kritische Treffer"
