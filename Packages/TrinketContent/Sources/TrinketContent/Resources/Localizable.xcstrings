    "talents.mana_moth_burn_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: mana_moth_burn_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Einfrieren eines <keyword id=\"burn\">brennenden</keyword> Gegners verursacht <value id=\"quantity_1\">%1$lld</value> <keyword id=\"burn\">Brand</keyword>schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Freezing a <keyword id=\"burn\">Burning</keyword> enemy deals <value id=\"quantity_1\">%1$lld</value> <keyword id=\"burn\">Burn</keyword> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Congelar a un enemigo con <keyword id=\"burn\">Quemadura</keyword> inflige <value id=\"quantity_1\">%1$lld</value> de daño de <keyword id=\"burn\">Quemadura</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Geler un ennemi sous <keyword id=\"burn\">Brûlure</keyword> inflige <value id=\"quantity_1\">%1$lld</value> dégâts de <keyword id=\"burn\">Brûlure</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">炎上</keyword>状態の敵を凍結させると<keyword id=\"burn\">炎上</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">화상</keyword> 상태의 적을 빙결시키면 <keyword id=\"burn\">화상</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Congelar um inimigo <keyword id=\"burn\">Em Chamas</keyword> causa <value id=\"quantity_1\">%1$lld</value> de dano de <keyword id=\"burn\">Queimadura</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "冰凍<keyword id=\"burn\">燃燒</keyword>中的敵人時，造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"burn\">燃燒</keyword>傷害"}}
      }
    },
