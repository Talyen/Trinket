      "comment": "ContentManifest/affixes.tsv: stunning, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhöhe <keyword id=\"stun\">Betäubungs</keyword>schaden um <value id=\"quantity_1\">%1$lld</value>"
