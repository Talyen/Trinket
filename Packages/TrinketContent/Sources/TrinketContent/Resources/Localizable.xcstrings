        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un renforcement au <keyword id=\"mana\">Mana</keyword> augmente les dégâts de <keyword id=\"burn\">Brûlure</keyword> et de <keyword id=\"freeze\">Gel</keyword> de <value id=\"quantity_1\">%1$lld</value>%%"
