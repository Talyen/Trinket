    "affixes.emberguard.astral_description": {
      "comment": "ContentManifest/affixes.tsv: emberguard, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erleide <value id=\"quantity_1\">%1$lld</value>%% weniger <keyword id=\"burn\">Brand</keyword>schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Take <value id=\"quantity_1\">%1$lld</value>%% less <keyword id=\"burn\">Burn</keyword> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Recibe un <value id=\"quantity_1\">%1$lld</value>%% menos de daño de <keyword id=\"burn\">Quemadura</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Dégâts de <keyword id=\"burn\">Brûlure</keyword> subis réduits de <value id=\"quantity_1\">%1$lld</value>%%"}},
        "ja": {"stringUnit": {"state": "translated", "value": "受ける<keyword id=\"burn\">炎上</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%減少"}},
        "ko": {"stringUnit": {"state": "translated", "value": "받는 <keyword id=\"burn\">화상</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>%% 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Receba <value id=\"quantity_1\">%1$lld</value>%% menos dano de <keyword id=\"burn\">Queimadura</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "承受的<keyword id=\"burn\">燃燒</keyword>傷害降低<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
