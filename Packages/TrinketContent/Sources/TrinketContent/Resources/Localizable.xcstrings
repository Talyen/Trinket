    "talents.wolf_dodge_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: wolf_dodge_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dein erstes <keyword id=\"dodge\">Ausweichen</keyword> in jedem Kampf lässt deinen Verbündeten dem nächsten Angriff gegen ihn durch <keyword id=\"dodge\">Ausweichen</keyword> entgehen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your first <keyword id=\"dodge\">Dodge</keyword> each combat makes your ally <keyword id=\"dodge\">Dodge</keyword> their next incoming attack"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu primera <keyword id=\"dodge\">Evasión</keyword> de cada combate hace que tu aliado <keyword id=\"dodge\">esquive</keyword> el siguiente ataque que reciba"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre première <keyword id=\"dodge\">Esquive</keyword> de chaque combat permet à votre allié d’effectuer une <keyword id=\"dodge\">Esquive</keyword> contre la prochaine attaque qu’il reçoit"}},
        "ja": {"stringUnit": {"state": "translated", "value": "各戦闘で最初の<keyword id=\"dodge\">回避</keyword>で、味方が次に受ける攻撃を<keyword id=\"dodge\">回避</keyword>"}},
        "ko": {"stringUnit": {"state": "translated", "value": "매 전투 첫 <keyword id=\"dodge\">회피</keyword> 시 아군이 다음에 받는 공격을 <keyword id=\"dodge\">회피</keyword>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Sua primeira <keyword id=\"dodge\">Esquiva</keyword> de cada combate faz seu aliado <keyword id=\"dodge\">Esquivar</keyword> do próximo ataque que receber"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每場戰鬥首次<keyword id=\"dodge\">閃避</keyword>時，友方會<keyword id=\"dodge\">閃避</keyword>下次受到的攻擊"}}
      }
    },
