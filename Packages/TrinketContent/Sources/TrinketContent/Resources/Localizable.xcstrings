    "talents.pixie_health_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: pixie_health_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Stelle <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Gesundheit</keyword> wieder her, wenn du in einem Kampf erstmals unter halbe <keyword id=\"health\">Gesundheit</keyword> fällst"}},
        "en": {"stringUnit": {"state": "translated", "value": "Restore <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Health</keyword> the first time you drop below half <keyword id=\"health\">Health</keyword> each combat"}},
        "es": {"stringUnit": {"state": "translated", "value": "Restaura <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Salud</keyword> la primera vez de cada combate que caes por debajo de la mitad de <keyword id=\"health\">Salud</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Restaurez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Santé</keyword> la première fois que vous passez sous la moitié de votre <keyword id=\"health\">Santé</keyword> à chaque combat"}},
        "ja": {"stringUnit": {"state": "translated", "value": "各戦闘で初めて<keyword id=\"health\">体力</keyword>が半分未満になると<keyword id=\"health\">体力</keyword>を<value id=\"quantity_1\">%1$lld</value>回復"}},
        "ko": {"stringUnit": {"state": "translated", "value": "매 전투 처음으로 <keyword id=\"health\">체력</keyword>이 절반 미만이 되면 <keyword id=\"health\">체력</keyword> <value id=\"quantity_1\">%1$lld</value> 회복"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Restaure <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Vida</keyword> na primeira vez que ficar abaixo de metade da <keyword id=\"health\">Vida</keyword> a cada combate"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每場戰鬥首次<keyword id=\"health\">生命值</keyword>低於一半時，恢復<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"health\">生命值</keyword>"}}
      }
    },
    "talents.pixie_health_t3_1.name": {
      "comment": "ContentManifest/talents.tsv: pixie_health_t3_1, name",
