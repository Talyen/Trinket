    "authored.95448989a64f2d08": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Kritische Treffer lassen den gesamten verbleibenden <keyword id=\"bleed\">Blutungs</keyword>- und <keyword id=\"poison\">Gift</keyword>schaden detonieren und verbrauchen ihn"}},
        "en": {"stringUnit": {"state": "translated", "value": "Critical Hits detonate and consume all remaining <keyword id=\"bleed\">Bleed</keyword> and <keyword id=\"poison\">Poison</keyword> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los golpes críticos detonan y consumen todo el daño restante de <keyword id=\"bleed\">Sangrado</keyword> y <keyword id=\"poison\">Veneno</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les coups critiques font exploser et consomment tous les dégâts restants de <keyword id=\"bleed\">Saignement</keyword> et de <keyword id=\"poison\">Poison</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "クリティカルヒット時に残りの<keyword id=\"bleed\">出血</keyword>と<keyword id=\"poison\">毒</keyword>ダメージをすべて炸裂させて消費"}},
        "ko": {"stringUnit": {"state": "translated", "value": "치명타가 남아 있는 모든 <keyword id=\"bleed\">출혈</keyword> 및 <keyword id=\"poison\">독</keyword> 피해를 폭발시키고 소모"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Golpes críticos detonam e consomem todo o dano restante de <keyword id=\"bleed\">Sangramento</keyword> e de <keyword id=\"poison\">Veneno</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "暴擊時引爆並消耗所有剩餘<keyword id=\"bleed\">流血</keyword>與<keyword id=\"poison\">中毒</keyword>傷害"}}
      }
    },
