    "affixes.whiplash.astral_description": {
      "comment": "ContentManifest/affixes.tsv: whiplash, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Nach dem Ausweichen verursacht dein nächster <keyword id=\"stun\">Betäubungs</keyword>angriff <value id=\"quantity_1\">%1$lld</value> zusätzlichen Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Dodging adds <value id=\"quantity_1\">%1$lld</value> damage to your next <keyword id=\"stun\">Stun</keyword> attack"}},
        "es": {"stringUnit": {"state": "translated", "value": "Esquivar añade <value id=\"quantity_1\">%1$lld</value> de daño a tu siguiente ataque de <keyword id=\"stun\">Aturdimiento</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Esquiver ajoute <value id=\"quantity_1\">%1$lld</value> dégâts à votre prochaine attaque d’<keyword id=\"stun\">Étourdissement</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "回避すると、次の<keyword id=\"stun\">スタン</keyword>攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>増加する"}},
        "ko": {"stringUnit": {"state": "translated", "value": "회피하면 다음 <keyword id=\"stun\">기절</keyword> 공격의 피해가 <value id=\"quantity_1\">%1$lld</value> 증가합니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Esquivar adiciona <value id=\"quantity_1\">%1$lld</value> de dano ao seu próximo ataque de <keyword id=\"stun\">Atordoamento</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "閃避後，你的下一次<keyword id=\"stun\">暈眩</keyword>攻擊傷害提高<value id=\"quantity_1\">%1$lld</value>點"}}
      }
    },
