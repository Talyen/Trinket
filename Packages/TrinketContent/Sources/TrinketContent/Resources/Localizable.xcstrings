        "zh-Hant": {"stringUnit": {"state": "translated", "value": "揮發療方"}}
      }
    },
    "talents.alchemist_health_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: alchemist_health_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Wiederherstellen von <keyword id=\"health\">Gesundheit</keyword> stellt mit <value id=\"quantity_1\">%1$lld</value>%% Chance auch <keyword id=\"mana\">Mana</keyword> wieder her"}},
        "en": {"stringUnit": {"state": "translated", "value": "Restoring <keyword id=\"health\">Health</keyword> has a <value id=\"quantity_1\">%1$lld</value>%% chance to also restore <keyword id=\"mana\">Mana</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Restaurar <keyword id=\"health\">Salud</keyword> tiene un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de restaurar también <keyword id=\"mana\">Maná</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Restaurer de la <keyword id=\"health\">Santé</keyword> a <value id=\"quantity_1\">%1$lld</value>%% de chances de restaurer aussi du <keyword id=\"mana\">Mana</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>を回復すると<value id=\"quantity_1\">%1$lld</value>%%の確率で<keyword id=\"mana\">マナ</keyword>も回復"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword> 회복 시 <value id=\"quantity_1\">%1$lld</value>%% 확률로 <keyword id=\"mana\">마나</keyword>도 회복"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Restaurar <keyword id=\"health\">Vida</keyword> tem <value id=\"quantity_1\">%1$lld</value>%% de chance de também restaurar <keyword id=\"mana\">Mana</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "恢復<keyword id=\"health\">生命值</keyword>時，有<value id=\"quantity_1\">%1$lld</value>%%機率同時恢復<keyword id=\"mana\">魔力</keyword>"}}
      }
    },
