    "talents.fox_dodge_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: fox_dodge_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter halber <keyword id=\"health\">Gesundheit</keyword> stellt dein erstes <keyword id=\"dodge\">Ausweichen</keyword> in jedem Zug <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Gesundheit</keyword> wieder her"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Below half <keyword id=\"health\">Health</keyword>, your first <keyword id=\"dodge\">Dodge</keyword> each turn restores <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Health</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sous la moitié de votre <keyword id=\"health\">Santé</keyword>, votre première <keyword id=\"dodge\">Esquive</keyword> de chaque tour restaure <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Santé</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">体力</keyword>が半分未満なら、各ターンで最初の<keyword id=\"dodge\">回避</keyword>で<keyword id=\"health\">体力</keyword>を<value id=\"quantity_1\">%1$lld</value>回復"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">체력</keyword>이 절반 미만이면 매 턴 첫 <keyword id=\"dodge\">회피</keyword> 시 <keyword id=\"health\">체력</keyword> <value id=\"quantity_1\">%1$lld</value> 회복"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">生命值</keyword>低於一半時，每回合首次<keyword id=\"dodge\">閃避</keyword>恢復<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"health\">生命值</keyword>"
          }
        }
      }
    },
