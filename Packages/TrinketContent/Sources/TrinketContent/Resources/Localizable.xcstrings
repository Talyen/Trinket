    "affixes.absolving.astral_description": {
      "comment": "ContentManifest/affixes.tsv: absolving, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"variations": {"plural": {"one": {"stringUnit": {"state": "translated", "value": "<keyword id=\"cleanse\">Reinige</keyword> <value id=\"quantity_1\">%1$lld</value> Schwächungseffekt, wenn du <keyword id=\"holy\">heiligen</keyword> Schaden verursachst"}}, "other": {"stringUnit": {"state": "translated", "value": "<keyword id=\"cleanse\">Reinige</keyword> <value id=\"quantity_1\">%1$lld</value> Schwächungseffekte, wenn du <keyword id=\"holy\">heiligen</keyword> Schaden verursachst"}}}}},
        "en": {"variations": {"plural": {"one": {"stringUnit": {"state": "translated", "value": "<keyword id=\"cleanse\">Cleanse</keyword> <value id=\"quantity_1\">%1$lld</value> debuff when you deal <keyword id=\"holy\">Holy</keyword> damage"}}, "other": {"stringUnit": {"state": "translated", "value": "<keyword id=\"cleanse\">Cleanse</keyword> <value id=\"quantity_1\">%1$lld</value> debuffs when you deal <keyword id=\"holy\">Holy</keyword> damage"}}}}},
        "es": {"variations": {"plural": {"many": {"stringUnit": {"state": "translated", "value": "<keyword id=\"cleanse\">Purifica</keyword> <value id=\"quantity_1\">%1$lld</value> perjuicios cuando infliges daño <keyword id=\"holy\">sagrado</keyword>"}}, "one": {"stringUnit": {"state": "translated", "value": "<keyword id=\"cleanse\">Purifica</keyword> <value id=\"quantity_1\">%1$lld</value> perjuicio cuando infliges daño <keyword id=\"holy\">sagrado</keyword>"}}, "other": {"stringUnit": {"state": "translated", "value": "<keyword id=\"cleanse\">Purifica</keyword> <value id=\"quantity_1\">%1$lld</value> perjuicios cuando infliges daño <keyword id=\"holy\">sagrado</keyword>"}}}}},
        "fr": {"variations": {"plural": {"many": {"stringUnit": {"state": "translated", "value": "<keyword id=\"cleanse\">Purification</keyword> de <value id=\"quantity_1\">%1$lld</value> malus lorsque vous infligez des dégâts de type <keyword id=\"holy\">Sacré</keyword>"}}, "one": {"stringUnit": {"state": "translated", "value": "<keyword id=\"cleanse\">Purification</keyword> de <value id=\"quantity_1\">%1$lld</value> malus lorsque vous infligez des dégâts de type <keyword id=\"holy\">Sacré</keyword>"}}, "other": {"stringUnit": {"state": "translated", "value": "<keyword id=\"cleanse\">Purification</keyword> de <value id=\"quantity_1\">%1$lld</value> malus lorsque vous infligez des dégâts de type <keyword id=\"holy\">Sacré</keyword>"}}}}},
        "ja": {"variations": {"plural": {"other": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">聖</keyword>ダメージを与えると弱体効果を<value id=\"quantity_1\">%1$lld</value>個<keyword id=\"cleanse\">浄化</keyword>"}}}}},
        "ko": {"variations": {"plural": {"other": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">신성</keyword> 피해를 주면 약화 효과 <value id=\"quantity_1\">%1$lld</value>개를 <keyword id=\"cleanse\">정화</keyword>"}}}}},
        "pt-BR": {"variations": {"plural": {"many": {"stringUnit": {"state": "translated", "value": "<keyword id=\"cleanse\">Purifique</keyword> <value id=\"quantity_1\">%1$lld</value> efeitos negativos ao causar dano <keyword id=\"holy\">Sagrado</keyword>"}}, "one": {"stringUnit": {"state": "translated", "value": "<keyword id=\"cleanse\">Purifique</keyword> <value id=\"quantity_1\">%1$lld</value> efeito negativo ao causar dano <keyword id=\"holy\">Sagrado</keyword>"}}, "other": {"stringUnit": {"state": "translated", "value": "<keyword id=\"cleanse\">Purifique</keyword> <value id=\"quantity_1\">%1$lld</value> efeitos negativos ao causar dano <keyword id=\"holy\">Sagrado</keyword>"}}}}},
        "zh-Hant": {"variations": {"plural": {"other": {"stringUnit": {"state": "translated", "value": "造成<keyword id=\"holy\">神聖</keyword>傷害時，<keyword id=\"cleanse\">淨化</keyword><value id=\"quantity_1\">%1$lld</value>項減益效果"}}}}}
      }
    },
