    "talents.risen_skeleton_physical_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_physical_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dein erster <keyword id=\"physical\">physischer</keyword> Angriff in jedem Zug gewährt <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your first <keyword id=\"physical\">Physical</keyword> attack each turn grants <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu primer ataque <keyword id=\"physical\">físico</keyword> de cada turno otorga <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueo</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre première attaque de type <keyword id=\"physical\">Physique</keyword> de chaque tour octroie <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Blocage</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "各ターンで最初の<keyword id=\"physical\">物理</keyword>攻撃で<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>獲得"}},
        "ko": {"stringUnit": {"state": "translated", "value": "매 턴 첫 <keyword id=\"physical\">물리</keyword> 공격 시 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 획득"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seu primeiro ataque <keyword id=\"physical\">Físico</keyword> de cada turno concede <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueio</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每回合首次<keyword id=\"physical\">物理</keyword>攻擊賦予<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>"}}
      }
    },
    "talents.risen_skeleton_physical_t1_1.name": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_physical_t1_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Knochenschild"}},
        "en": {"stringUnit": {"state": "translated", "value": "Bone Shield"}},
        "es": {"stringUnit": {"state": "translated", "value": "Escudo de hueso"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Bouclier d’os"}},
        "ja": {"stringUnit": {"state": "translated", "value": "骨の盾"}},
        "ko": {"stringUnit": {"state": "translated", "value": "뼈 방패"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Escudo de Ossos"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "骨盾"}}
      }
    },
    "talents.risen_skeleton_physical_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_physical_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wenn dein <keyword id=\"block\">Block</keyword> durchbrochen wird, erhält dein nächster <keyword id=\"physical\">physischer</keyword> Angriff <value id=\"quantity_1\">%1$lld</value> Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "When your <keyword id=\"block\">Block</keyword> breaks, your next <keyword id=\"physical\">Physical</keyword> attack gains <value id=\"quantity_1\">%1$lld</value> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Cuando se rompe tu <keyword id=\"block\">Bloqueo</keyword>, tu siguiente ataque <keyword id=\"physical\">físico</keyword> obtiene <value id=\"quantity_1\">%1$lld</value> de daño"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Lorsque votre <keyword id=\"block\">Blocage</keyword> est brisé, votre prochaine attaque de type <keyword id=\"physical\">Physique</keyword> gagne <value id=\"quantity_1\">%1$lld</value> dégâts"}},
        "ja": {"stringUnit": {"state": "translated", "value": "自分の<keyword id=\"block\">ブロック</keyword>が崩れると、次の<keyword id=\"physical\">物理</keyword>攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "내 <keyword id=\"block\">방어도</keyword>가 깨지면 다음 <keyword id=\"physical\">물리</keyword> 공격의 피해 <value id=\"quantity_1\">%1$lld</value> 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Quando seu <keyword id=\"block\">Bloqueio</keyword> quebrar, seu próximo ataque <keyword id=\"physical\">Físico</keyword> ganha <value id=\"quantity_1\">%1$lld</value> de dano"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "自身<keyword id=\"block\">格擋</keyword>被擊破時，下次<keyword id=\"physical\">物理</keyword>攻擊的傷害增加<value id=\"quantity_1\">%1$lld</value>點"}}
      }
    },
    "talents.risen_skeleton_physical_t1_2.name": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_physical_t1_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Knochenbruch"}},
        "en": {"stringUnit": {"state": "translated", "value": "Bone Burst"}},
        "es": {"stringUnit": {"state": "translated", "value": "Estallido de huesos"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Explosion d’os"}},
        "ja": {"stringUnit": {"state": "translated", "value": "骨の爆裂"}},
        "ko": {"stringUnit": {"state": "translated", "value": "뼈 폭발"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Explosão de Ossos"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "骨骸爆裂"}}
      }
    },
    "talents.risen_skeleton_physical_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_physical_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">Physische</keyword> Angriffe verursachen doppelten Schaden an gegnerischem <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">Physical</keyword> attacks deal double damage to enemy <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques <keyword id=\"physical\">físicos</keyword> infligen el doble de daño al <keyword id=\"block\">Bloqueo</keyword> del enemigo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques de type <keyword id=\"physical\">Physique</keyword> infligent le double de dégâts au <keyword id=\"block\">Blocage</keyword> ennemi"}},
        "ja": {"stringUnit": {"state": "translated", "value": "敵の<keyword id=\"block\">ブロック</keyword>への<keyword id=\"physical\">物理</keyword>攻撃のダメージが2倍になる"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">물리</keyword> 공격이 적의 <keyword id=\"block\">방어도</keyword>에 두 배의 피해"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques <keyword id=\"physical\">Físicos</keyword> causam o dobro de dano ao <keyword id=\"block\">Bloqueio</keyword> inimigo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">物理</keyword>攻擊對敵人<keyword id=\"block\">格擋</keyword>造成雙倍傷害"}}
      }
    },
    "talents.risen_skeleton_physical_t2_1.name": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_physical_t2_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Spröder Schlag"}},
        "en": {"stringUnit": {"state": "translated", "value": "Brittle Strike"}},
        "es": {"stringUnit": {"state": "translated", "value": "Golpe quebradizo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Frappe cassante"}},
        "ja": {"stringUnit": {"state": "translated", "value": "脆い一撃"}},
        "ko": {"stringUnit": {"state": "translated", "value": "부서지는 일격"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Golpe Frágil"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "脆裂打擊"}}
      }
    },
    "talents.risen_skeleton_physical_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_physical_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">Block</keyword> absorbiert doppelt so viel <keyword id=\"physical\">physischen</keyword> Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">Block</keyword> absorbs twice as much <keyword id=\"physical\">Physical</keyword> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">Bloqueo</keyword> absorbe el doble de daño <keyword id=\"physical\">físico</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le <keyword id=\"block\">Blocage</keyword> absorbe deux fois plus de dégâts de type <keyword id=\"physical\">Physique</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">ブロック</keyword>の<keyword id=\"physical\">物理</keyword>ダメージ吸収量が2倍になる"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">방어도</keyword>가 <keyword id=\"physical\">물리</keyword> 피해를 두 배로 흡수"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">Bloqueio</keyword> absorve o dobro de dano <keyword id=\"physical\">Físico</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">格擋</keyword>吸收的<keyword id=\"physical\">物理</keyword>傷害加倍"}}
      }
    },
    "talents.risen_skeleton_physical_t2_2.name": {
      "comment": "ContentManifest/talents.tsv: risen_skeleton_physical_t2_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dichte Knochen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Dense Bones"}},
        "es": {"stringUnit": {"state": "translated", "value": "Huesos densos"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Os denses"}},
        "ja": {"stringUnit": {"state": "translated", "value": "緻密な骨"}},
        "ko": {"stringUnit": {"state": "translated", "value": "치밀한 뼈"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ossos Densos"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "密實骨骼"}}
      }
