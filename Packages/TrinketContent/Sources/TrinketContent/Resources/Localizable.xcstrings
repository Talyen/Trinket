    "talents.library_owl_cleanse_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: library_owl_cleanse_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dein erstes erfolgreiches <keyword id=\"cleanse\">Reinigen</keyword> in jedem Kampf lässt dich eine Karte ziehen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your first successful <keyword id=\"cleanse\">Cleanse</keyword> each combat draws a card"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu primera <keyword id=\"cleanse\">Purificación</keyword> exitosa de cada combate hace que robes una carta"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre première <keyword id=\"cleanse\">Purification</keyword> réussie de chaque combat fait piocher une carte"}},
        "ja": {"stringUnit": {"state": "translated", "value": "各戦闘で初めて<keyword id=\"cleanse\">浄化</keyword>に成功すると、カードを1枚引く"}},
        "ko": {"stringUnit": {"state": "translated", "value": "매 전투 첫 <keyword id=\"cleanse\">정화</keyword> 성공 시 카드 한 장 뽑기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Sua primeira <keyword id=\"cleanse\">Purificação</keyword> bem-sucedida de cada combate faz você comprar uma carta"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每場戰鬥首次成功<keyword id=\"cleanse\">淨化</keyword>時，抽一張牌"}}
      }
    },
    "talents.library_owl_cleanse_t1_1.name": {
      "comment": "ContentManifest/talents.tsv: library_owl_cleanse_t1_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Reinigende Weisheit"}},
        "en": {"stringUnit": {"state": "translated", "value": "Purifying Wisdom"}},
        "es": {"stringUnit": {"state": "translated", "value": "Sabiduría purificadora"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Sagesse purificatrice"}},
        "ja": {"stringUnit": {"state": "translated", "value": "清めの知恵"}},
        "ko": {"stringUnit": {"state": "translated", "value": "정화의 지혜"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Sabedoria Purificadora"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "淨化智慧"}}
