      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Gesundheit</keyword> beim Verbündeten mit der niedrigsten <keyword id=\"health\">Gesundheit</keyword> wieder her, wenn du <keyword id=\"cleanse\">reinigst</keyword>"
