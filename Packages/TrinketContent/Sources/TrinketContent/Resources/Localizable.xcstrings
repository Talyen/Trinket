    "affixes.spitebloom.astral_description": {
      "comment": "ContentManifest/affixes.tsv: spitebloom, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn deine <keyword id=\"thorns\">Dornen</keyword> Schaden verursachen, verursache <value id=\"quantity_1\">%1$lld</value> <keyword id=\"poison\">Gift</keyword>schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When your <keyword id=\"thorns\">Thorns</keyword> deal damage, deal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"poison\">Poison</keyword> damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque vos <keyword id=\"thorns\">Épines</keyword> infligent des dégâts, infligez <value id=\"quantity_1\">%1$lld</value> dégâts de <keyword id=\"poison\">Poison</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の<keyword id=\"thorns\">棘</keyword>がダメージを与えると<keyword id=\"poison\">毒</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 <keyword id=\"thorns\">가시</keyword>가 피해를 주면 <keyword id=\"poison\">독</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自身<keyword id=\"thorns\">荊棘</keyword>造成傷害時，造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"poison\">中毒</keyword>傷害"
          }
        }
      }
    },
