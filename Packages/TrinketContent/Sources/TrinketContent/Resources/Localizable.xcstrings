    "talents.druid_health_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: druid_health_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Wiederherstellen von <keyword id=\"health\">Gesundheit</keyword> entfernt <value id=\"quantity_1\">%1$lld</value> gegnerische <keyword id=\"thorns\">Dornen</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Restoring <keyword id=\"health\">Health</keyword> removes <value id=\"quantity_1\">%1$lld</value> enemy <keyword id=\"thorns\">Thorns</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Restaurar <keyword id=\"health\">Salud</keyword> elimina <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"thorns\">Espinas</keyword> del enemigo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Restaurer de la <keyword id=\"health\">Santé</keyword> retire <value id=\"quantity_1\">%1$lld</value> <keyword id=\"thorns\">Épines</keyword> ennemies"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>を回復すると敵の<keyword id=\"thorns\">棘</keyword>を<value id=\"quantity_1\">%1$lld</value>除去"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword> 회복 시 적의 <keyword id=\"thorns\">가시</keyword> <value id=\"quantity_1\">%1$lld</value> 제거"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Restaurar <keyword id=\"health\">Vida</keyword> remove <value id=\"quantity_1\">%1$lld</value> dos <keyword id=\"thorns\">Espinhos</keyword> inimigos"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "恢復<keyword id=\"health\">生命值</keyword>時，移除敵人<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"thorns\">荊棘</keyword>"}}
      }
    },
    "talents.druid_health_t1_2.name": {
      "comment": "ContentManifest/talents.tsv: druid_health_t1_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Stutzende Berührung"}},
        "en": {"stringUnit": {"state": "translated", "value": "Pruning Touch"}},
        "es": {"stringUnit": {"state": "translated", "value": "Toque de poda"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Toucher d’élagage"}},
        "ja": {"stringUnit": {"state": "translated", "value": "剪定の手"}},
        "ko": {"stringUnit": {"state": "translated", "value": "가지치기의 손길"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Toque de Poda"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "修枝之觸"}}
      }
    },
    "talents.druid_health_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: druid_health_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verbündete mit voller <keyword id=\"health\">Gesundheit</keyword> erhalten +<value id=\"quantity_1\">%1$lld</value>%% Chance auf <keyword id=\"dodge\">Ausweichen</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Allies at full <keyword id=\"health\">Health</keyword> gain +<value id=\"quantity_1\">%1$lld</value>%% <keyword id=\"dodge\">Dodge</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los aliados con toda la <keyword id=\"health\">Salud</keyword> obtienen +<value id=\"quantity_1\">%1$lld</value>%% de <keyword id=\"dodge\">Evasión</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les alliés à pleine <keyword id=\"health\">Santé</keyword> gagnent +<value id=\"quantity_1\">%1$lld</value>%% d’<keyword id=\"dodge\">Esquive</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>が満タンの味方の<keyword id=\"dodge\">回避</keyword>率が<value id=\"quantity_1\">%1$lld</value>%%上昇"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword>이 가득 찬 아군의 <keyword id=\"dodge\">회피</keyword> +<value id=\"quantity_1\">%1$lld</value>%%"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Aliados com <keyword id=\"health\">Vida</keyword> cheia ganham +<value id=\"quantity_1\">%1$lld</value>%% de <keyword id=\"dodge\">Esquiva</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">生命值</keyword>全滿的友方<keyword id=\"dodge\">閃避</keyword>機率提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.druid_health_t2_1.name": {
      "comment": "ContentManifest/talents.tsv: druid_health_t2_1, name",
      "extractionState": "manual",
      "localizations": {
