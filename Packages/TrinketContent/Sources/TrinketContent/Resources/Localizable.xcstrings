        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">体力</keyword>が半分未満で<keyword id=\"bleed\">出血</keyword>状態の敵に与えるダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">체력</keyword>이 절반 미만이며 <keyword id=\"bleed\">출혈</keyword> 상태인 적에게 주는 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對<keyword id=\"health\">生命值</keyword>低於一半且<keyword id=\"bleed\">流血</keyword>的敵人，自身傷害提高<value id=\"quantity_1\">%1$lld</value>%%"
          }
        }
      }
    },
