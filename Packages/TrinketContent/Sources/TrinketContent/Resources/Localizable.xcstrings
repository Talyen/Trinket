    "homestead_nodes.herbgarden.1.summary": {
      "comment": "ContentManifest/homestead_nodes.tsv: herbGarden.1, summary",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein kleiner Heilkräutergarten für Tonika, Reagenzien und grüne Magie"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A small medicinal garden for tonics, reagents, and green magic"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un petit jardin médicinal pour les toniques, les réactifs et la magie verte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "強壮薬や試薬、緑の魔術のための小さな薬草園"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강장제와 시약, 자연 마법을 위한 작은 약초 정원"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為補藥、試劑與綠色魔法種植藥草的小花園"
          }
        }
      }
    },
