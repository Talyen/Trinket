        "zh-Hant": {"stringUnit": {"state": "translated", "value": "錢幣手法"}}
      }
    },
    "talents.wildcard_gold_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: wildcard_gold_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wenn du pro Zug zum ersten Mal <keyword id=\"gold\">Gold</keyword> erhältst, ziehst du eine Karte"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your first <keyword id=\"gold\">Gold</keyword> gain each turn draws a card"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu primera obtención de <keyword id=\"gold\">Oro</keyword> de cada turno hace que robes una carta"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre premier gain d’<keyword id=\"gold\">Or</keyword> de chaque tour vous fait piocher une carte"}},
        "ja": {"stringUnit": {"state": "translated", "value": "各ターンで最初に<keyword id=\"gold\">ゴールド</keyword>を獲得すると、カードを1枚引く"}},
        "ko": {"stringUnit": {"state": "translated", "value": "매 턴 처음 <keyword id=\"gold\">골드</keyword>를 얻을 때 카드를 1장 뽑습니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seu primeiro ganho de <keyword id=\"gold\">Ouro</keyword> de cada turno faz você comprar uma carta"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每回合首次獲得<keyword id=\"gold\">金幣</keyword>時，抽一張牌"}}
      }
    },
