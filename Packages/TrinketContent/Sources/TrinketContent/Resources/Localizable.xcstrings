    "talents.pixie_health_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: pixie_health_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dein erstes Wiederherstellen von <keyword id=\"health\">Gesundheit</keyword> in jedem Zug stellt <value id=\"quantity_1\">%1$lld</value> zusätzliche <keyword id=\"health\">Gesundheit</keyword> wieder her"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your first <keyword id=\"health\">Health</keyword> restoration each turn restores <value id=\"quantity_1\">%1$lld</value> additional <keyword id=\"health\">Health</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu primera restauración de <keyword id=\"health\">Salud</keyword> de cada turno restaura <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Salud</keyword> adicional"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre première restauration de <keyword id=\"health\">Santé</keyword> de chaque tour restaure <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Santé</keyword> de plus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "各ターンで最初の<keyword id=\"health\">体力</keyword>回復時に、<keyword id=\"health\">体力</keyword>を追加で<value id=\"quantity_1\">%1$lld</value>回復"}},
        "ko": {"stringUnit": {"state": "translated", "value": "매 턴 첫 <keyword id=\"health\">체력</keyword> 회복 시 <keyword id=\"health\">체력</keyword> <value id=\"quantity_1\">%1$lld</value> 추가 회복"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Sua primeira restauração de <keyword id=\"health\">Vida</keyword> de cada turno restaura <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Vida</keyword> adicional"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每回合首次恢復<keyword id=\"health\">生命值</keyword>時，額外恢復<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"health\">生命值</keyword>"}}
      }
    },
    "talents.pixie_health_t1_1.name": {
      "comment": "ContentManifest/talents.tsv: pixie_health_t1_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Feenberührung"}},
