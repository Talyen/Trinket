        "en": {"stringUnit": {"state": "translated", "value": "Quaking Carapace"}},
        "es": {"stringUnit": {"state": "translated", "value": "Caparazón sísmico"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Carapace sismique"}},
        "ja": {"stringUnit": {"state": "translated", "value": "震える甲殻"}},
        "ko": {"stringUnit": {"state": "translated", "value": "진동하는 갑각"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Carapaça Sísmica"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "震地甲殼"}}
      }
    },
    "talents.shield_scarab_stun_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: shield_scarab_stun_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Betäuben eines Gegners verursacht <value id=\"quantity_1\">%1$lld</value> <keyword id=\"burn\">Brand</keyword>schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Stunning an enemy deals <value id=\"quantity_1\">%1$lld</value> <keyword id=\"burn\">Burn</keyword> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Aturdir a un enemigo inflige <value id=\"quantity_1\">%1$lld</value> de daño de <keyword id=\"burn\">Quemadura</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Étourdir un ennemi inflige <value id=\"quantity_1\">%1$lld</value> dégâts de <keyword id=\"burn\">Brûlure</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "敵をスタン状態にすると<keyword id=\"burn\">炎上</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える"}},
        "ko": {"stringUnit": {"state": "translated", "value": "적을 기절시키면 <keyword id=\"burn\">화상</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Atordoar um inimigo causa <value id=\"quantity_1\">%1$lld</value> de dano de <keyword id=\"burn\">Queimadura</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "使敵人暈眩時，造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"burn\">燃燒</keyword>傷害"}}
      }
    },
    "talents.shield_scarab_stun_t3_2.name": {
      "comment": "ContentManifest/talents.tsv: shield_scarab_stun_t3_2, name",
      "extractionState": "manual",
      "localizations": {
