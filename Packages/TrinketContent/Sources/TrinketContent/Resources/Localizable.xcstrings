    "talents.druid_mana_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: druid_mana_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei unverbrauchtem <keyword id=\"mana\">Mana</keyword> erhält dein Gefährte +<value id=\"quantity_1\">%1$lld</value>%% Chance auf <keyword id=\"dodge\">Ausweichen</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With unspent <keyword id=\"mana\">Mana</keyword>, your Companion gains +<value id=\"quantity_1\">%1$lld</value>%% <keyword id=\"dodge\">Dodge</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec du <keyword id=\"mana\">Mana</keyword> non dépensé, votre Compagnon gagne +<value id=\"quantity_1\">%1$lld</value>%% d’<keyword id=\"dodge\">Esquive</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未使用の<keyword id=\"mana\">マナ</keyword>がある間、仲間の<keyword id=\"dodge\">回避</keyword>率が<value id=\"quantity_1\">%1$lld</value>%%上昇"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용하지 않은 <keyword id=\"mana\">마나</keyword>가 있으면 동료의 <keyword id=\"dodge\">회피</keyword> +<value id=\"quantity_1\">%1$lld</value>%%"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有未使用的<keyword id=\"mana\">魔力</keyword>時，夥伴<keyword id=\"dodge\">閃避</keyword>機率提高<value id=\"quantity_1\">%1$lld</value>%%"
          }
