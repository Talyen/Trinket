    "talents.rogue_poison_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: rogue_poison_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Vergiftete</keyword> Gegner erleiden <value id=\"quantity_1\">%1$lld</value>%% zusätzlichen Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Poisoned</keyword> enemies take <value id=\"quantity_1\">%1$lld</value>%% additional damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los enemigos <keyword id=\"poison\">envenenados</keyword> reciben un <value id=\"quantity_1\">%1$lld</value>%% de daño adicional"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les ennemis sous <keyword id=\"poison\">Poison</keyword> subissent <value id=\"quantity_1\">%1$lld</value>%% de dégâts supplémentaires"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">毒</keyword>状態の敵が受けるダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">독</keyword> 상태의 적이 받는 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Inimigos <keyword id=\"poison\">Envenenados</keyword> recebem <value id=\"quantity_1\">%1$lld</value>%% mais dano"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">中毒</keyword>的敵人承受的傷害增加<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
