    "talents.pixie_health_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: pixie_health_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Wiederherstellen von <keyword id=\"health\">Gesundheit</keyword> wird mit <value id=\"quantity_1\">%1$lld</value>%% Chance im nächsten Zug wiederholt"}},
        "en": {"stringUnit": {"state": "translated", "value": "Restoring <keyword id=\"health\">Health</keyword> has a <value id=\"quantity_1\">%1$lld</value>%% chance to repeat next turn"}},
        "es": {"stringUnit": {"state": "translated", "value": "Restaurar <keyword id=\"health\">Salud</keyword> tiene un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de repetirse el siguiente turno"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Restaurer de la <keyword id=\"health\">Santé</keyword> a <value id=\"quantity_1\">%1$lld</value>%% de chances de se répéter au prochain tour"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>回復が<value id=\"quantity_1\">%1$lld</value>%%の確率で次のターンにも繰り返される"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword> 회복 시 <value id=\"quantity_1\">%1$lld</value>%% 확률로 다음 턴에 반복"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Restaurar <keyword id=\"health\">Vida</keyword> tem <value id=\"quantity_1\">%1$lld</value>%% de chance de se repetir no próximo turno"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "恢復<keyword id=\"health\">生命值</keyword>時，有<value id=\"quantity_1\">%1$lld</value>%%機率於下回合重複恢復"}}
      }
    },
    "talents.pixie_health_t2_1.name": {
      "comment": "ContentManifest/talents.tsv: pixie_health_t2_1, name",
      "extractionState": "manual",
