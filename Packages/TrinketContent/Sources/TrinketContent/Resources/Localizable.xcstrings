    "talents.lizard_scout_poison_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: lizard_scout_poison_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Gift</keyword>-Angriffe verursachen <value id=\"quantity_1\">%1$lld</value> zusätzlichen Schaden an <keyword id=\"bleed\">blutenden</keyword> Gegnern"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Poison</keyword> attacks deal <value id=\"quantity_1\">%1$lld</value> additional damage to <keyword id=\"bleed\">Bleeding</keyword> enemies"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques de <keyword id=\"poison\">Veneno</keyword> infligen <value id=\"quantity_1\">%1$lld</value> de daño adicional a enemigos con <keyword id=\"bleed\">Sangrado</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques de <keyword id=\"poison\">Poison</keyword> infligent <value id=\"quantity_1\">%1$lld</value> dégâts supplémentaires aux ennemis sous <keyword id=\"bleed\">Saignement</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">出血</keyword>状態の敵への<keyword id=\"poison\">毒</keyword>攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">출혈</keyword> 상태의 적에게 <keyword id=\"poison\">독</keyword> 공격의 추가 피해 <value id=\"quantity_1\">%1$lld</value>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques de <keyword id=\"poison\">Veneno</keyword> causam <value id=\"quantity_1\">%1$lld</value> de dano adicional a inimigos com <keyword id=\"bleed\">Sangramento</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">中毒</keyword>攻擊對<keyword id=\"bleed\">流血</keyword>的敵人額外造成<value id=\"quantity_1\">%1$lld</value>點傷害"}}
      }
    },
