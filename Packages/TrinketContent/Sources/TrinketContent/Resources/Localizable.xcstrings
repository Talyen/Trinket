    "affixes.meteorite.astral_description": {
      "comment": "ContentManifest/affixes.tsv: meteorite, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Brand</keyword>-Karten können zusätzliches <keyword id=\"mana\">Mana</keyword> ausgeben, um mehr Schaden zu verursachen"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Burn</keyword> cards can spend additional <keyword id=\"mana\">Mana</keyword> to deal more damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Las cartas de <keyword id=\"burn\">Quemadura</keyword> pueden gastar <keyword id=\"mana\">Maná</keyword> adicional para infligir más daño"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les cartes de <keyword id=\"burn\">Brûlure</keyword> peuvent dépenser du <keyword id=\"mana\">Mana</keyword> supplémentaire pour infliger plus de dégâts"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">炎上</keyword>カードで追加の<keyword id=\"mana\">マナ</keyword>を消費し、ダメージを増加できる"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">화상</keyword> 카드가 <keyword id=\"mana\">마나</keyword>를 추가로 소모해 더 큰 피해를 줄 수 있음"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cartas de <keyword id=\"burn\">Queimadura</keyword> podem gastar <keyword id=\"mana\">Mana</keyword> adicional para causar mais dano"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">燃燒</keyword>卡牌可消耗額外<keyword id=\"mana\">魔力</keyword>，造成更多傷害"}}
      }
    },
    "affixes.meteorite.basic_description": {
      "comment": "ContentManifest/affixes.tsv: meteorite, basic_description",
      "extractionState": "manual",
      "localizations": {
