    "talents.panther_bleed_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: panther_bleed_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Du verursachst <value id=\"quantity_1\">%1$lld</value>%% mehr Schaden an <keyword id=\"bleed\">blutenden</keyword> Gegnern unter halber <keyword id=\"health\">Gesundheit</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "You deal <value id=\"quantity_1\">%1$lld</value>%% more damage to <keyword id=\"bleed\">Bleeding</keyword> enemies below half <keyword id=\"health\">Health</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Infliges un <value id=\"quantity_1\">%1$lld</value>%% más de daño a enemigos con <keyword id=\"bleed\">Sangrado</keyword> por debajo de la mitad de <keyword id=\"health\">Salud</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Vous infligez <value id=\"quantity_1\">%1$lld</value>%% de dégâts en plus aux ennemis sous <keyword id=\"bleed\">Saignement</keyword> et sous la moitié de leur <keyword id=\"health\">Santé</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>が半分未満で<keyword id=\"bleed\">出血</keyword>状態の敵に与えるダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword>이 절반 미만이며 <keyword id=\"bleed\">출혈</keyword> 상태인 적에게 주는 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Você causa <value id=\"quantity_1\">%1$lld</value>%% mais dano a inimigos com <keyword id=\"bleed\">Sangramento</keyword> abaixo de metade da <keyword id=\"health\">Vida</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "對<keyword id=\"health\">生命值</keyword>低於一半且<keyword id=\"bleed\">流血</keyword>的敵人，自身傷害提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
