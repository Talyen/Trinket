    "authored.41efb0420ac47732": {
      "comment": "Packages/TrinketAppState/Sources/TrinketAppState/Play/Modes/VoyagePlayMode.swift: player-facing failure message",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Deine Reise konnte nicht geladen werden. Dein Fortschritt bleibt erhalten."}},
        "en": {"stringUnit": {"state": "translated", "value": "Your Voyage could not be read. Your progress is preserved."}},
        "es": {"stringUnit": {"state": "translated", "value": "No se pudo leer tu Travesía. Tu progreso se conserva."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Impossible de lire votre Expédition. Votre progression est conservée."}},
        "ja": {"stringUnit": {"state": "translated", "value": "航海を読み込めませんでした。進行状況は保持されています。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "항해를 불러오지 못했습니다. 진행도는 보존되어 있습니다."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Não foi possível ler sua Viagem. Seu progresso foi preservado."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法讀取你的遠征，進度已保留。"}}
      }
    },
