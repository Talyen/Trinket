    "affixes.smoldering.astral_description": {
      "comment": "ContentManifest/affixes.tsv: smoldering, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhöhe <keyword id=\"burn\">Brand</keyword>schaden um <value id=\"quantity_1\">%1$lld</value>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Increase <keyword id=\"burn\">Burn</keyword> damage by <value id=\"quantity_1\">%1$lld</value>"
