    "talents.shield_scarab_stun_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: shield_scarab_stun_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange du <keyword id=\"thorns\">Dornen</keyword> hast, verursachen <keyword id=\"stun\">Betäubungs</keyword>-Angriffe <value id=\"quantity_1\">%1$lld</value>%% mehr Schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While you have <keyword id=\"thorns\">Thorns</keyword>, <keyword id=\"stun\">Stun</keyword> attacks deal <value id=\"quantity_1\">%1$lld</value>%% more damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que vous avez des <keyword id=\"thorns\">Épines</keyword>, les attaques d’<keyword id=\"stun\">Étourdissement</keyword> infligent <value id=\"quantity_1\">%1$lld</value>%% de dégâts en plus"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"thorns\">棘</keyword>がある間、<keyword id=\"stun\">スタン</keyword>攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"thorns\">가시</keyword>가 있으면 <keyword id=\"stun\">기절</keyword> 공격의 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擁有<keyword id=\"thorns\">荊棘</keyword>時，<keyword id=\"stun\">暈眩</keyword>攻擊的傷害提高<value id=\"quantity_1\">%1$lld</value>%%"
          }
        }
      }
    },
