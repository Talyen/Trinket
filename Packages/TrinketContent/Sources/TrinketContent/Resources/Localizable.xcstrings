    "affixes.briarward.title": {
      "comment": "ContentManifest/affixes.tsv: briarward, title",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Rankenschutz"}},
        "en": {"stringUnit": {"state": "translated", "value": "Briarward"}},
        "es": {"stringUnit": {"state": "translated", "value": "Protección de zarzas"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Garde de ronces"}},
