        "ja": {"stringUnit": {"state": "translated", "value": "慎重"}},
        "ko": {"stringUnit": {"state": "translated", "value": "신중"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cauteloso"}},
