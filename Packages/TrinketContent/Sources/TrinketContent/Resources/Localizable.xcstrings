    "talents.frost_whelp_dodge_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: frost_whelp_dodge_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ausweichen vor einem Angriff gewährt dem Helden <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodging an attack grants the Hero <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Esquiver une attaque octroie <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Blocage</keyword> au Héros"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "攻撃を回避すると、ヒーローに<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>付与"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공격 회피 시 영웅에게 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 부여"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "閃避攻擊時，賦予英雄<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>"
          }
        }
      }
    },
