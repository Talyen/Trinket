    "affixes.serrated.astral_description": {
      "comment": "ContentManifest/affixes.tsv: serrated, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erhöhe <keyword id=\"bleed\">Blutungs</keyword>schaden um <value id=\"quantity_1\">%1$lld</value>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Increase <keyword id=\"bleed\">Bleed</keyword> damage by <value id=\"quantity_1\">%1$lld</value>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Aumenta el daño de <keyword id=\"bleed\">Sangrado</keyword> en <value id=\"quantity_1\">%1$lld</value>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Dégâts de <keyword id=\"bleed\">Saignement</keyword> augmentés de <value id=\"quantity_1\">%1$lld</value>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">出血</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">출혈</keyword> 피해 <value id=\"quantity_1\">%1$lld</value> 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Aumente o dano de <keyword id=\"bleed\">Sangramento</keyword> em <value id=\"quantity_1\">%1$lld</value>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">流血</keyword>傷害增加<value id=\"quantity_1\">%1$lld</value>點"}}
      }
    },
