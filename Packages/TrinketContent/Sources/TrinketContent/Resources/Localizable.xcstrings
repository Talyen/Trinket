    "talents.druid_poison_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: druid_poison_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei <keyword id=\"poison\">vergifteten</keyword> Gegnern steigt der <keyword id=\"stun\">Betäubungs</keyword>aufbau um <value id=\"quantity_1\">%1$lld</value>%%"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"poison\">Poisoned</keyword> enemies take <value id=\"quantity_1\">%1$lld</value>%% more <keyword id=\"stun\">Stun</keyword> build-up"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les ennemis sous <keyword id=\"poison\">Poison</keyword> subissent <value id=\"quantity_1\">%1$lld</value>%% d’accumulation d’<keyword id=\"stun\">Étourdissement</keyword> en plus"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"poison\">毒</keyword>状態の敵の<keyword id=\"stun\">スタン</keyword>蓄積量が<value id=\"quantity_1\">%1$lld</value>%%増加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"poison\">독</keyword> 상태의 적에게 쌓이는 <keyword id=\"stun\">기절</keyword> <value id=\"quantity_1\">%1$lld</value>%% 증가"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"poison\">中毒</keyword>的敵人承受的<keyword id=\"stun\">暈眩</keyword>累積量增加<value id=\"quantity_1\">%1$lld</value>%%"
          }
        }
      }
    },
