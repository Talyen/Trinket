    "talents.bear_physical_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: bear_physical_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kritische <keyword id=\"physical\">physische</keyword> Treffer entfernen den gesamten gegnerischen <keyword id=\"block\">Block</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"physical\">Physical</keyword> Critical Hits remove all enemy <keyword id=\"block\">Block</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les coups critiques de type <keyword id=\"physical\">Physique</keyword> retirent tout le <keyword id=\"block\">Blocage</keyword> ennemi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"physical\">物理</keyword>クリティカルヒットで敵の<keyword id=\"block\">ブロック</keyword>をすべて除去"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"physical\">물리</keyword> 치명타가 적의 모든 <keyword id=\"block\">방어도</keyword> 제거"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"physical\">物理</keyword>暴擊移除敵人所有<keyword id=\"block\">格擋</keyword>"
          }
        }
      }
    },
