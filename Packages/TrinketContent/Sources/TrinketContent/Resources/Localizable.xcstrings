    "affixes.cauterize.astral_description": {
      "comment": "ContentManifest/affixes.tsv: cauterize, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Deine <keyword id=\"bleed\">Blutung</keyword> verursacht <value id=\"quantity_1\">%1$lld</value> zusätzlichen Schaden bei <keyword id=\"burn\">brennenden</keyword> Gegnern"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your <keyword id=\"bleed\">Bleed</keyword> deals <value id=\"quantity_1\">%1$lld</value> additional damage to <keyword id=\"burn\">Burning</keyword> enemies"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu <keyword id=\"bleed\">Sangrado</keyword> inflige <value id=\"quantity_1\">%1$lld</value> de daño adicional a enemigos con <keyword id=\"burn\">Quemadura</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre <keyword id=\"bleed\">Saignement</keyword> inflige <value id=\"quantity_1\">%1$lld</value> dégâts supplémentaires aux ennemis affectés par une <keyword id=\"burn\">Brûlure</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "あなたの<keyword id=\"bleed\">出血</keyword>は、<keyword id=\"burn\">炎上</keyword>状態の敵に<value id=\"quantity_1\">%1$lld</value>の追加ダメージを与える"}},
        "ko": {"stringUnit": {"state": "translated", "value": "자신의 <keyword id=\"bleed\">출혈</keyword>이 <keyword id=\"burn\">화상</keyword>에 걸린 적에게 <value id=\"quantity_1\">%1$lld</value>의 추가 피해를 줍니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seu <keyword id=\"bleed\">Sangramento</keyword> causa <value id=\"quantity_1\">%1$lld</value> de dano adicional a inimigos <keyword id=\"burn\">Em Chamas</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "你的<keyword id=\"bleed\">流血</keyword>對<keyword id=\"burn\">燃燒</keyword>中的敵人額外造成<value id=\"quantity_1\">%1$lld</value>點傷害"}}
      }
    },
