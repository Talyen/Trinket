        "pt-BR": {"stringUnit": {"state": "translated", "value": "Prender e Rasgar"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "釘住撕裂"}}
      }
    },
    "talents.ranger_burn_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: ranger_burn_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Brand</keyword>-Angriffe verursachen <value id=\"quantity_1\">%1$lld</value>%% mehr Schaden an gegnerischem <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Burn</keyword> attacks deal <value id=\"quantity_1\">%1$lld</value>%% more damage to enemy <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques de <keyword id=\"burn\">Quemadura</keyword> infligen un <value id=\"quantity_1\">%1$lld</value>%% más de daño al <keyword id=\"block\">Bloqueo</keyword> del enemigo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques de <keyword id=\"burn\">Brûlure</keyword> infligent <value id=\"quantity_1\">%1$lld</value>%% de dégâts en plus au <keyword id=\"block\">Blocage</keyword> ennemi"}},
        "ja": {"stringUnit": {"state": "translated", "value": "敵の<keyword id=\"block\">ブロック</keyword>への<keyword id=\"burn\">炎上</keyword>攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">화상</keyword> 공격이 적의 <keyword id=\"block\">방어도</keyword>에 주는 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques de <keyword id=\"burn\">Queimadura</keyword> causam <value id=\"quantity_1\">%1$lld</value>%% mais dano ao <keyword id=\"block\">Bloqueio</keyword> inimigo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">燃燒</keyword>攻擊對敵人<keyword id=\"block\">格擋</keyword>造成的傷害增加<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
