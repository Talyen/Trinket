    "talents.alchemist_cleanse_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: alchemist_cleanse_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"variations": {"plural": {"one": {"stringUnit": {"state": "translated", "value": "Das Reinigen von <keyword id=\"poison\">Gift</keyword> verhindert <keyword id=\"poison\">Gift</keyword> für <value id=\"quantity_1\">%1$lld</value> Zug"}}, "other": {"stringUnit": {"state": "translated", "value": "Das Reinigen von <keyword id=\"poison\">Gift</keyword> verhindert <keyword id=\"poison\">Gift</keyword> für <value id=\"quantity_1\">%1$lld</value> Züge"}}}}},
        "en": {"variations": {"plural": {"one": {"stringUnit": {"state": "translated", "value": "Cleansing <keyword id=\"poison\">Poison</keyword> prevents <keyword id=\"poison\">Poison</keyword> for <value id=\"quantity_1\">%1$lld</value> turn"}}, "other": {"stringUnit": {"state": "translated", "value": "Cleansing <keyword id=\"poison\">Poison</keyword> prevents <keyword id=\"poison\">Poison</keyword> for <value id=\"quantity_1\">%1$lld</value> turns"}}}}},
        "es": {"variations": {"plural": {"many": {"stringUnit": {"state": "translated", "value": "Purificar <keyword id=\"poison\">Veneno</keyword> impide <keyword id=\"poison\">Veneno</keyword> durante <value id=\"quantity_1\">%1$lld</value> turnos"}}, "one": {"stringUnit": {"state": "translated", "value": "Purificar <keyword id=\"poison\">Veneno</keyword> impide <keyword id=\"poison\">Veneno</keyword> durante <value id=\"quantity_1\">%1$lld</value> turno"}}, "other": {"stringUnit": {"state": "translated", "value": "Purificar <keyword id=\"poison\">Veneno</keyword> impide <keyword id=\"poison\">Veneno</keyword> durante <value id=\"quantity_1\">%1$lld</value> turnos"}}}}},
        "fr": {"variations": {"plural": {"many": {"stringUnit": {"state": "translated", "value": "Purifier le <keyword id=\"poison\">Poison</keyword> protège du <keyword id=\"poison\">Poison</keyword> pendant <value id=\"quantity_1\">%1$lld</value> tours"}}, "one": {"stringUnit": {"state": "translated", "value": "Purifier le <keyword id=\"poison\">Poison</keyword> protège du <keyword id=\"poison\">Poison</keyword> pendant <value id=\"quantity_1\">%1$lld</value> tour"}}, "other": {"stringUnit": {"state": "translated", "value": "Purifier le <keyword id=\"poison\">Poison</keyword> protège du <keyword id=\"poison\">Poison</keyword> pendant <value id=\"quantity_1\">%1$lld</value> tours"}}}}},
        "ja": {"variations": {"plural": {"other": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">毒</keyword>を浄化すると<value id=\"quantity_1\">%1$lld</value>ターンの間<keyword id=\"poison\">毒</keyword>を防ぐ"}}}}},
        "ko": {"variations": {"plural": {"other": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">독</keyword> 정화 시 <value id=\"quantity_1\">%1$lld</value>턴 동안 <keyword id=\"poison\">독</keyword> 방지"}}}}},
        "pt-BR": {"variations": {"plural": {"many": {"stringUnit": {"state": "translated", "value": "Purificar <keyword id=\"poison\">Veneno</keyword> impede <keyword id=\"poison\">Veneno</keyword> por <value id=\"quantity_1\">%1$lld</value> turnos"}}, "one": {"stringUnit": {"state": "translated", "value": "Purificar <keyword id=\"poison\">Veneno</keyword> impede <keyword id=\"poison\">Veneno</keyword> por <value id=\"quantity_1\">%1$lld</value> turno"}}, "other": {"stringUnit": {"state": "translated", "value": "Purificar <keyword id=\"poison\">Veneno</keyword> impede <keyword id=\"poison\">Veneno</keyword> por <value id=\"quantity_1\">%1$lld</value> turnos"}}}}},
        "zh-Hant": {"variations": {"plural": {"other": {"stringUnit": {"state": "translated", "value": "淨化<keyword id=\"poison\">中毒</keyword>後，在<value id=\"quantity_1\">%1$lld</value>回合內免疫<keyword id=\"poison\">中毒</keyword>"}}}}}
      }
