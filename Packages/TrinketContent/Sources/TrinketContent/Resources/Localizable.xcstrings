    "talents.druid_mana_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: druid_mana_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verstärken mit <keyword id=\"mana\">Mana</keyword> fügt dem nächsten Angriff deines Gefährten <value id=\"quantity_1\">%1$lld</value> Schaden hinzu"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"mana\">Mana</keyword> empowerment adds <value id=\"quantity_1\">%1$lld</value> damage to your Companion’s next attack"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un renforcement au <keyword id=\"mana\">Mana</keyword> ajoute <value id=\"quantity_1\">%1$lld</value> dégâts à la prochaine attaque de votre Compagnon"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"mana\">マナ</keyword>で強化すると、仲間の次の攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>増加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"mana\">마나</keyword>로 강화 시 동료의 다음 공격 피해 <value id=\"quantity_1\">%1$lld</value> 증가"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以<keyword id=\"mana\">魔力</keyword>強化時，夥伴下次攻擊的傷害增加<value id=\"quantity_1\">%1$lld</value>點"
          }
        }
      }
    },
