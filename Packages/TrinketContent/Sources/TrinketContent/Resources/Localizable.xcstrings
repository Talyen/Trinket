    "talents.ranger_bleed_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: ranger_bleed_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">Blutende</keyword> Gegner verursachen <value id=\"quantity_1\">%1$lld</value>%% weniger Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">Bleeding</keyword> enemies deal <value id=\"quantity_1\">%1$lld</value>%% less damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los enemigos con <keyword id=\"bleed\">Sangrado</keyword> infligen un <value id=\"quantity_1\">%1$lld</value>%% menos de daño"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les ennemis sous <keyword id=\"bleed\">Saignement</keyword> infligent <value id=\"quantity_1\">%1$lld</value>%% de dégâts en moins"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">出血</keyword>状態の敵の与えるダメージが<value id=\"quantity_1\">%1$lld</value>%%減少"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">출혈</keyword> 상태의 적이 주는 피해 <value id=\"quantity_1\">%1$lld</value>%% 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Inimigos com <keyword id=\"bleed\">Sangramento</keyword> causam <value id=\"quantity_1\">%1$lld</value>%% menos dano"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">流血</keyword>的敵人造成的傷害降低<value id=\"quantity_1\">%1$lld</value>%%"}}
