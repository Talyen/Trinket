    "talents.knight_block_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: knight_block_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein <keyword id=\"block\">Block</keyword> absorbiert auch Schaden an deinem Gefährten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your <keyword id=\"block\">Block</keyword> also absorbs damage dealt to your Companion"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre <keyword id=\"block\">Blocage</keyword> absorbe aussi les dégâts infligés à votre Compagnon"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の<keyword id=\"block\">ブロック</keyword>が仲間へのダメージも吸収"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 <keyword id=\"block\">방어도</keyword>가 동료에게 가해지는 피해도 흡수"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自身<keyword id=\"block\">格擋</keyword>也會吸收夥伴承受的傷害"
          }
        }
      }
    },
