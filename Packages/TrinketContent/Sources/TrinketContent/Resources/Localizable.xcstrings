      "extractionState": "manual",
      "localizations": {
        "de": {"variations": {"plural": {"one": {"stringUnit": {"state": "translated", "value": "Das Reinigen von <value id=\"quantity_1\">%1$lld</value> Schwächungseffekt stellt <value id=\"quantity_2\">%2$lld</value> <keyword id=\"health\">Gesundheit</keyword> wieder her"}}, "other": {"stringUnit": {"state": "translated", "value": "Das Reinigen von <value id=\"quantity_1\">%1$lld</value> Schwächungseffekten stellt <value id=\"quantity_2\">%2$lld</value> <keyword id=\"health\">Gesundheit</keyword> wieder her"}}}}},
        "en": {"variations": {"plural": {"one": {"stringUnit": {"state": "translated", "value": "Cleansing <value id=\"quantity_1\">%1$lld</value> debuff restores <value id=\"quantity_2\">%2$lld</value> <keyword id=\"health\">Health</keyword>"}}, "other": {"stringUnit": {"state": "translated", "value": "Cleansing <value id=\"quantity_1\">%1$lld</value> debuffs restores <value id=\"quantity_2\">%2$lld</value> <keyword id=\"health\">Health</keyword>"}}}}},
        "es": {"variations": {"plural": {"many": {"stringUnit": {"state": "translated", "value": "Purificar <value id=\"quantity_1\">%1$lld</value> perjuicios restaura <value id=\"quantity_2\">%2$lld</value> de <keyword id=\"health\">Salud</keyword>"}}, "one": {"stringUnit": {"state": "translated", "value": "Purificar <value id=\"quantity_1\">%1$lld</value> perjuicio restaura <value id=\"quantity_2\">%2$lld</value> de <keyword id=\"health\">Salud</keyword>"}}, "other": {"stringUnit": {"state": "translated", "value": "Purificar <value id=\"quantity_1\">%1$lld</value> perjuicios restaura <value id=\"quantity_2\">%2$lld</value> de <keyword id=\"health\">Salud</keyword>"}}}}},
        "fr": {"variations": {"plural": {"many": {"stringUnit": {"state": "translated", "value": "Purifier <value id=\"quantity_1\">%1$lld</value> malus rend <value id=\"quantity_2\">%2$lld</value> de <keyword id=\"health\">Santé</keyword>"}}, "one": {"stringUnit": {"state": "translated", "value": "Purifier <value id=\"quantity_1\">%1$lld</value> malus rend <value id=\"quantity_2\">%2$lld</value> de <keyword id=\"health\">Santé</keyword>"}}, "other": {"stringUnit": {"state": "translated", "value": "Purifier <value id=\"quantity_1\">%1$lld</value> malus rend <value id=\"quantity_2\">%2$lld</value> de <keyword id=\"health\">Santé</keyword>"}}}}},
        "ja": {"variations": {"plural": {"other": {"stringUnit": {"state": "translated", "value": "弱体効果を<value id=\"quantity_1\">%1$lld</value>個浄化すると<keyword id=\"health\">体力</keyword>を<value id=\"quantity_2\">%2$lld</value>回復"}}}}},
        "ko": {"variations": {"plural": {"other": {"stringUnit": {"state": "translated", "value": "약화 효과 <value id=\"quantity_1\">%1$lld</value>개 정화 시 <keyword id=\"health\">체력</keyword> <value id=\"quantity_2\">%2$lld</value> 회복"}}}}},
        "pt-BR": {"variations": {"plural": {"many": {"stringUnit": {"state": "translated", "value": "Purificar <value id=\"quantity_1\">%1$lld</value> efeitos negativos restaura <value id=\"quantity_2\">%2$lld</value> de <keyword id=\"health\">Vida</keyword>"}}, "one": {"stringUnit": {"state": "translated", "value": "Purificar <value id=\"quantity_1\">%1$lld</value> efeito negativo restaura <value id=\"quantity_2\">%2$lld</value> de <keyword id=\"health\">Vida</keyword>"}}, "other": {"stringUnit": {"state": "translated", "value": "Purificar <value id=\"quantity_1\">%1$lld</value> efeitos negativos restaura <value id=\"quantity_2\">%2$lld</value> de <keyword id=\"health\">Vida</keyword>"}}}}},
        "zh-Hant": {"variations": {"plural": {"other": {"stringUnit": {"state": "translated", "value": "淨化<value id=\"quantity_1\">%1$lld</value>項減益效果時，恢復<value id=\"quantity_2\">%2$lld</value>點<keyword id=\"health\">生命值</keyword>"}}}}}
