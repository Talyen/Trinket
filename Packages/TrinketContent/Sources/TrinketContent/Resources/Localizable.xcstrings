    "authored.600fe69d5d270601": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/InventoryItem+Compatibility.swift: canonical numeric compatibility description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">Lebensraub</keyword> stellt zusätzlich <value id=\"quantity_1\">%1$lld</value>%% des verursachten Schadens wieder her"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">Leech</keyword> restores an additional <value id=\"quantity_1\">%1$lld</value>%% of damage dealt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le <keyword id=\"leech\">Vol de vie</keyword> rend un montant supplémentaire de Santé égal à <value id=\"quantity_1\">%1$lld</value>%% des dégâts infligés"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">吸収</keyword>は与えたダメージの<value id=\"quantity_1\">%1$lld</value>%%を追加で回復"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">흡혈</keyword> 시 준 피해의 <value id=\"quantity_1\">%1$lld</value>%%만큼 추가 회복"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">吸血</keyword>額外恢復相當於所造成傷害<value id=\"quantity_1\">%1$lld</value>%%的生命值"
          }
        }
      }
    },
    "authored.6023edf63b08d7e8": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog+Melee.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine <keyword id=\"bleed\">Blutung</keyword> hält über ihre normale Dauer hinaus an; ihre Stärke halbiert sich mit jedem zusätzlichen Zug"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your <keyword id=\"bleed\">Bleed</keyword> continues after its normal duration, halving in potency each additional turn"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre <keyword id=\"bleed\">Saignement</keyword> persiste après sa durée normale ; sa puissance diminue de moitié à chaque tour supplémentaire"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分が与えた<keyword id=\"bleed\">出血</keyword>が通常の持続時間後も残り、以降は毎ターン威力が半減する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 <keyword id=\"bleed\">출혈</keyword>이 원래 지속 시간이 끝난 후에도 지속되며, 추가 턴마다 위력이 절반으로 감소"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自身施加的<keyword id=\"bleed\">流血</keyword>在正常持續時間結束後仍會延續，之後每回合效力減半"
          }
        }
      }
    },
