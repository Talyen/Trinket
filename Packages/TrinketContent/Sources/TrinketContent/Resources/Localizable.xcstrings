        "es": {"stringUnit": {"state": "translated", "value": "Confort de la hoguera"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Réconfort du feu de camp"}},
        "ja": {"stringUnit": {"state": "translated", "value": "焚き火の安らぎ"}},
        "ko": {"stringUnit": {"state": "translated", "value": "모닥불의 위안"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Conforto da Fogueira"}},
