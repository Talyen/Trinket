    "talents.alchemist_cleanse_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: alchemist_cleanse_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Reinigen von <keyword id=\"burn\">Brand</keyword> fügt deinem nächsten <keyword id=\"burn\">Brand</keyword>-Angriff <value id=\"quantity_1\">%1$lld</value> Schaden hinzu"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleansing <keyword id=\"burn\">Burn</keyword> adds <value id=\"quantity_1\">%1$lld</value> damage to your next <keyword id=\"burn\">Burn</keyword> attack"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Purifier une <keyword id=\"burn\">Brûlure</keyword> ajoute <value id=\"quantity_1\">%1$lld</value> dégâts à votre prochaine attaque de <keyword id=\"burn\">Brûlure</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">炎上</keyword>を浄化すると、次の<keyword id=\"burn\">炎上</keyword>攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>増加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">화상</keyword> 정화 시 다음 <keyword id=\"burn\">화상</keyword> 공격의 피해 <value id=\"quantity_1\">%1$lld</value> 증가"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "淨化<keyword id=\"burn\">燃燒</keyword>時，下次<keyword id=\"burn\">燃燒</keyword>攻擊的傷害增加<value id=\"quantity_1\">%1$lld</value>點"
          }
        }
      }
    },
