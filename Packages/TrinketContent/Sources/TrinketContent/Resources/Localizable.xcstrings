        "ko": {"stringUnit": {"state": "translated", "value": "무인의 방어"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Guarda Marcial"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "武者防禦"}}
