    "authored.55140ece668db90e": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Encounters/Mystery/MysteryEventPool+Events.swift: narrative",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gefallene Äste bergen „%1$@“, und geschnitzte Jahresringe flüstern rund um „%2$@“ ihre Lehren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fallen boughs shelter “%1$@”, and carved rings whisper lessons around “%2$@”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des branches tombées abritent « %1$@ », tandis que des cernes gravés murmurent leurs leçons autour de « %2$@ »"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "落ちた枝が「%1$@」をかばい、刻まれた年輪が「%2$@」の周りで教えをささやいている"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "떨어진 나뭇가지가 품은 것은 ‘%1$@’입니다. 새겨진 나이테는 ‘%2$@’ 주위에서 가르침을 속삭입니다"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "倒下的枝條庇護著「%1$@」，刻出的年輪在「%2$@」四周低語教誨"
          }
        }
      }
    },
