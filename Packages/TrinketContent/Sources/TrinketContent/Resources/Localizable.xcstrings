    "talents.golden_retriever_block_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: golden_retriever_block_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Beginne den Kampf mit <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Start combat with <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Comienza el combate con <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueo</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Commencez le combat avec <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Blocage</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>持って戦闘を開始"}},
        "ko": {"stringUnit": {"state": "translated", "value": "전투 시작 시 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 보유"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Comece o combate com <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueio</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "帶著<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>開始戰鬥"}}
      }
    },
    "talents.golden_retriever_block_t1_2.name": {
      "comment": "ContentManifest/talents.tsv: golden_retriever_block_t1_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wachsames Auge"}},
        "en": {"stringUnit": {"state": "translated", "value": "Watchful Eye"}},
        "es": {"stringUnit": {"state": "translated", "value": "Ojo vigilante"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Œil vigilant"}},
        "ja": {"stringUnit": {"state": "translated", "value": "警戒の眼"}},
        "ko": {"stringUnit": {"state": "translated", "value": "예리한 눈"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Olhar Vigilante"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "警戒之眼"}}
