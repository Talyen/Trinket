    "authored.c5ec2efd91341d6c": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Abilities/AbilityCatalog+Skill.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verursache <value id=\"quantity_1\">%1$lld</value> <keyword id=\"bleed\">Blutungs</keyword>schaden\nDein nächster Angriff erhält <keyword id=\"leech\">Lebensraub</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Deal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"bleed\">Bleed</keyword> damage\nYour next attack has <keyword id=\"leech\">Leech</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Inflige <value id=\"quantity_1\">%1$lld</value> de daño de <keyword id=\"bleed\">Sangrado</keyword>\nTu siguiente ataque tiene <keyword id=\"leech\">Absorción</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Infligez <value id=\"quantity_1\">%1$lld</value> dégâts de <keyword id=\"bleed\">Saignement</keyword>\nVotre prochaine attaque bénéficie de <keyword id=\"leech\">Vol de vie</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">出血</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える\n次の攻撃に<keyword id=\"leech\">吸収</keyword>を付与"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">출혈</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>\n다음 공격에 <keyword id=\"leech\">흡혈</keyword> 부여"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cause <value id=\"quantity_1\">%1$lld</value> de dano de <keyword id=\"bleed\">Sangramento</keyword>\nSeu próximo ataque tem <keyword id=\"leech\">Drenagem</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"bleed\">流血</keyword>傷害\n下次攻擊獲得<keyword id=\"leech\">吸血</keyword>"}}
      }
    },
    "authored.c67f8c006597bf4d": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/InventoryItem+Compatibility.swift: canonical numeric compatibility description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Deine <keyword id=\"bleed\">Blutung</keyword> verursacht <value id=\"quantity_1\">%1$lld</value> zusätzlichen Schaden bei <keyword id=\"burn\">brennenden</keyword> Gegnern"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your <keyword id=\"bleed\">Bleed</keyword> deals <value id=\"quantity_1\">%1$lld</value> additional damage to <keyword id=\"burn\">Burning</keyword> enemies"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu <keyword id=\"bleed\">Sangrado</keyword> inflige <value id=\"quantity_1\">%1$lld</value> de daño adicional a enemigos con <keyword id=\"burn\">Quemadura</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre <keyword id=\"bleed\">Saignement</keyword> inflige <value id=\"quantity_1\">%1$lld</value> dégâts supplémentaires aux ennemis affectés par une <keyword id=\"burn\">Brûlure</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "あなたの<keyword id=\"bleed\">出血</keyword>は、<keyword id=\"burn\">炎上</keyword>状態の敵に<value id=\"quantity_1\">%1$lld</value>の追加ダメージを与える"}},
        "ko": {"stringUnit": {"state": "translated", "value": "자신의 <keyword id=\"bleed\">출혈</keyword>이 <keyword id=\"burn\">화상</keyword>에 걸린 적에게 <value id=\"quantity_1\">%1$lld</value>의 추가 피해를 줍니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seu <keyword id=\"bleed\">Sangramento</keyword> causa <value id=\"quantity_1\">%1$lld</value> de dano adicional a inimigos <keyword id=\"burn\">Em Chamas</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "你的<keyword id=\"bleed\">流血</keyword>對<keyword id=\"burn\">燃燒</keyword>中的敵人額外造成<value id=\"quantity_1\">%1$lld</value>點傷害"}}
      }
    },
