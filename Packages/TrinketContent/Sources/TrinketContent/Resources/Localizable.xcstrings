    "authored.9f6f435f174e9ffd": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Encounters/Mystery/MysteryEventPool+Events.swift: narrative",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ein unvollendeter Zauber umgibt „%1$@“, und ein zersplitterter Schrank verbirgt „%2$@“"}},
        "en": {"stringUnit": {"state": "translated", "value": "An unfinished spell surrounds “%1$@”, and a splintered cabinet hides “%2$@”"}},
        "es": {"stringUnit": {"state": "translated", "value": "Un hechizo inacabado rodea «%1$@», y un armario astillado esconde «%2$@»"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Un sort inachevé entoure « %1$@ », tandis qu’une armoire fendue cache « %2$@ »"}},
        "ja": {"stringUnit": {"state": "translated", "value": "未完成の呪文が「%1$@」を包み、壊れた戸棚が「%2$@」を隠している"}},
        "ko": {"stringUnit": {"state": "translated", "value": "미완성 주문에 둘러싸인 것은 ‘%1$@’, 부서진 수납장이 감춘 것은 ‘%2$@’입니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Um feitiço inacabado cerca “%1$@”, e um armário lascado esconde “%2$@”"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "未完成的法術圍繞著「%1$@」，破裂的櫃子藏著「%2$@」"}}
      }
    },
