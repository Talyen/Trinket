            "value": "Restore <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Health</keyword> to the lowest <keyword id=\"health\">Health</keyword> ally when you <keyword id=\"cleanse\">Cleanse</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Santé</keyword> à l’allié ayant le moins de <keyword id=\"health\">Santé</keyword> lors d’une <keyword id=\"cleanse\">Purification</keyword>"
