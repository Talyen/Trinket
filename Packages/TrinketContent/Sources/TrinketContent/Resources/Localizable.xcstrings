        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both allies' first <keyword id=\"physical\">Physical</keyword> attack each combat gains +<value id=\"quantity_1\">%1$lld</value>%% Critical Hit chance"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La première attaque de type <keyword id=\"physical\">Physique</keyword> de chaque allié à chaque combat gagne +<value id=\"quantity_1\">%1$lld</value>%% de chances de coup critique"
