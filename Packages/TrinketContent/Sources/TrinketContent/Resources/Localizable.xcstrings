        "pt-BR": {"stringUnit": {"state": "translated", "value": "Restaure <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Vida</keyword> na primeira vez que <keyword id=\"thorns\">Espinhos</keyword> causarem dano a cada turno"}},
