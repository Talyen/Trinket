    "traits.ambush.description": {
      "comment": "ContentManifest/traits.tsv: ambush, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verursache mit dem ersten Angriff doppelten Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Deal double damage on the first attack"}},
        "es": {"stringUnit": {"state": "translated", "value": "Inflige el doble de daño en el primer ataque"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Inflige le double de dégâts à la première attaque"}},
        "ja": {"stringUnit": {"state": "translated", "value": "最初の攻撃のダメージが2倍になる"}},
        "ko": {"stringUnit": {"state": "translated", "value": "첫 공격에 두 배의 피해"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cause o dobro de dano no primeiro ataque"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "首次攻擊造成雙倍傷害"}}
      }
    },
    "traits.ambush.name": {
      "comment": "ContentManifest/traits.tsv: ambush, name",
