    "talents.warlock_leech_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: warlock_leech_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein erster <keyword id=\"burn\">Brand</keyword>-Angriff in jedem Zug erhält <keyword id=\"leech\">Lebensraub</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your first <keyword id=\"burn\">Burn</keyword> attack each turn gains <keyword id=\"leech\">Leech</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre première attaque de <keyword id=\"burn\">Brûlure</keyword> de chaque tour bénéficie de <keyword id=\"leech\">Vol de vie</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ターンで最初の<keyword id=\"burn\">炎上</keyword>攻撃に<keyword id=\"leech\">吸収</keyword>を付与"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매 턴 첫 <keyword id=\"burn\">화상</keyword> 공격에 <keyword id=\"leech\">흡혈</keyword> 부여"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每回合首次<keyword id=\"burn\">燃燒</keyword>攻擊獲得<keyword id=\"leech\">吸血</keyword>"
          }
        }
      }
    },
