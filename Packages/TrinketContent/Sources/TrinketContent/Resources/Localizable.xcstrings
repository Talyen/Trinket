    "talents.frost_whelp_freeze_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: frost_whelp_freeze_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">Eingefrorene</keyword> Gegner erleiden <value id=\"quantity_1\">%1$lld</value>%% mehr Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">Frozen</keyword> enemies take <value id=\"quantity_1\">%1$lld</value>%% increased damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los enemigos <keyword id=\"freeze\">congelados</keyword> reciben un <value id=\"quantity_1\">%1$lld</value>%% más de daño"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les ennemis sous <keyword id=\"freeze\">Gel</keyword> subissent <value id=\"quantity_1\">%1$lld</value>%% de dégâts en plus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">凍結</keyword>状態の敵が受けるダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">빙결</keyword> 상태의 적이 받는 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Inimigos <keyword id=\"freeze\">Congelados</keyword> recebem <value id=\"quantity_1\">%1$lld</value>%% mais dano"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">冰凍</keyword>的敵人承受的傷害增加<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
