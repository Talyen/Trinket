    "talents.phoenix_burn_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: phoenix_burn_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du Schaden erleidest, wirfst du mit <value id=\"quantity_1\">%1$lld</value>%% Chance <value id=\"quantity_2\">%2$lld</value> <keyword id=\"burn\">Brand</keyword>schaden zurück"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Taking damage has a <value id=\"quantity_1\">%1$lld</value>%% chance to return <value id=\"quantity_2\">%2$lld</value> <keyword id=\"burn\">Burn</keyword> damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Subir des dégâts a <value id=\"quantity_1\">%1$lld</value>%% de chances de renvoyer <value id=\"quantity_2\">%2$lld</value> dégâts de <keyword id=\"burn\">Brûlure</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダメージを受けると<value id=\"quantity_1\">%1$lld</value>%%の確率で<keyword id=\"burn\">炎上</keyword>ダメージを<value id=\"quantity_2\">%2$lld</value>返す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피해를 받으면 <value id=\"quantity_1\">%1$lld</value>%% 확률로 <keyword id=\"burn\">화상</keyword> 피해 <value id=\"quantity_2\">%2$lld</value> 반사"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "受到傷害時，有<value id=\"quantity_1\">%1$lld</value>%%機率回敬<value id=\"quantity_2\">%2$lld</value>點<keyword id=\"burn\">燃燒</keyword>傷害"
          }
        }
      }
    },
