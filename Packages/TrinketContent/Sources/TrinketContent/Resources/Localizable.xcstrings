    "authored.e933707d1971c6aa": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog+Melee.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Nach dem Ausweichen verursacht der nächste Treffer einer manuell gespielten Karte, der <keyword id=\"health\">Gesundheit</keyword> abzieht, zusätzlichen <keyword id=\"poison\">Gift</keyword>- und <keyword id=\"bleed\">Blutungs</keyword>schaden, jeweils in Höhe der Hälfte der verlorenen <keyword id=\"health\">Gesundheit</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "After Dodging, your next manually played card hit that removes <keyword id=\"health\">Health</keyword> deals additional <keyword id=\"poison\">Poison</keyword> and <keyword id=\"bleed\">Bleed</keyword> damage, each equal to half the <keyword id=\"health\">Health</keyword> lost"}},
        "es": {"stringUnit": {"state": "translated", "value": "Después de esquivar, el siguiente impacto de una carta que juegues manualmente que reduzca <keyword id=\"health\">Salud</keyword> inflige daño adicional de <keyword id=\"poison\">Veneno</keyword> y <keyword id=\"bleed\">Sangrado</keyword>, cada uno equivalente a la mitad de la <keyword id=\"health\">Salud</keyword> perdida"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Après une esquive, le prochain coup d’une carte jouée manuellement qui retire de la <keyword id=\"health\">Santé</keyword> inflige des dégâts supplémentaires de <keyword id=\"poison\">Poison</keyword> et de <keyword id=\"bleed\">Saignement</keyword>, chacun à hauteur de la moitié de la <keyword id=\"health\">Santé</keyword> perdue"}},
        "ja": {"stringUnit": {"state": "translated", "value": "回避後、次に手動で使ったカードのヒットで<keyword id=\"health\">体力</keyword>を減らすと、失わせた<keyword id=\"health\">体力</keyword>の半分に等しい追加の<keyword id=\"poison\">毒</keyword>と<keyword id=\"bleed\">出血</keyword>ダメージをそれぞれ与える"}},
        "ko": {"stringUnit": {"state": "translated", "value": "회피 후 다음에 직접 사용하는 카드의 적중이 <keyword id=\"health\">체력</keyword>을 깎으면, 잃은 <keyword id=\"health\">체력</keyword>의 절반만큼 <keyword id=\"poison\">독</keyword> 및 <keyword id=\"bleed\">출혈</keyword> 추가 피해를 각각 줌"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Após esquivar, o próximo acerto de uma carta jogada manualmente que remover <keyword id=\"health\">Vida</keyword> causa dano adicional de <keyword id=\"poison\">Veneno</keyword> e de <keyword id=\"bleed\">Sangramento</keyword>, cada um equivalente à metade da <keyword id=\"health\">Vida</keyword> perdida"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "閃避後，下次手動出牌的命中使敵人失去<keyword id=\"health\">生命值</keyword>時，額外造成<keyword id=\"poison\">中毒</keyword>與<keyword id=\"bleed\">流血</keyword>傷害，各等於失去的<keyword id=\"health\">生命值</keyword>的一半"}}
      }
    },
    "authored.e98d4de60587bae6": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Abilities/AbilityCatalog+Ultimate.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verursache <value id=\"quantity_1\">%1$lld</value> <keyword id=\"burn\">Brand</keyword>-, <keyword id=\"freeze\">Frost</keyword>- oder <keyword id=\"bleed\">Blutungs</keyword>schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Deal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"burn\">Burn</keyword>, <keyword id=\"freeze\">Freeze</keyword>, or <keyword id=\"bleed\">Bleed</keyword> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Inflige <value id=\"quantity_1\">%1$lld</value> de daño de <keyword id=\"burn\">Quemadura</keyword>, <keyword id=\"freeze\">Congelación</keyword> o <keyword id=\"bleed\">Sangrado</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Infligez <value id=\"quantity_1\">%1$lld</value> dégâts de <keyword id=\"burn\">Brûlure</keyword>, de <keyword id=\"freeze\">Gel</keyword> ou de <keyword id=\"bleed\">Saignement</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">炎上</keyword>、<keyword id=\"freeze\">凍結</keyword>、<keyword id=\"bleed\">出血</keyword>のいずれかのダメージを<value id=\"quantity_1\">%1$lld</value>与える"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">화상</keyword>, <keyword id=\"freeze\">빙결</keyword> 또는 <keyword id=\"bleed\">출혈</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cause <value id=\"quantity_1\">%1$lld</value> de dano de <keyword id=\"burn\">Queimadura</keyword>, de <keyword id=\"freeze\">Congelamento</keyword> ou de <keyword id=\"bleed\">Sangramento</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"burn\">燃燒</keyword>、<keyword id=\"freeze\">冰凍</keyword>或<keyword id=\"bleed\">流血</keyword>傷害"}}
      }
    },
