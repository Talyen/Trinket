      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Blutroter Auftrag"}},
        "en": {"stringUnit": {"state": "translated", "value": "Crimson Writ"}},
        "es": {"stringUnit": {"state": "translated", "value": "Edicto carmesí"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Édit cramoisi"}},
        "ja": {"stringUnit": {"state": "translated", "value": "深紅の依頼書"}},
        "ko": {"stringUnit": {"state": "translated", "value": "진홍 지령"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Mandado Carmesim"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "緋紅敕令"}}
      }
    },
    "authored.2d432e5eac18f64c": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog+Melee.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dein <keyword id=\"stun\">Betäubungs</keyword>schaden ignoriert gegnerischen <keyword id=\"block\">Block</keyword> und erhält zusätzlichen Schaden in Höhe dieses <keyword id=\"block\">Blocks</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your <keyword id=\"stun\">Stun</keyword> damage ignores enemy <keyword id=\"block\">Block</keyword> and gains damage equal to that <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu daño de <keyword id=\"stun\">Aturdimiento</keyword> ignora el <keyword id=\"block\">Bloqueo</keyword> del enemigo y obtiene daño equivalente a ese <keyword id=\"block\">Bloqueo</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Vos dégâts d’<keyword id=\"stun\">Étourdissement</keyword> ignorent le <keyword id=\"block\">Blocage</keyword> ennemi et augmentent à hauteur de ce <keyword id=\"block\">Blocage</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "自分の<keyword id=\"stun\">スタン</keyword>ダメージが敵の<keyword id=\"block\">ブロック</keyword>を無視し、その<keyword id=\"block\">ブロック</keyword>と同量だけ増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "내 <keyword id=\"stun\">기절</keyword> 피해가 적의 <keyword id=\"block\">방어도</keyword>를 무시하고 그 <keyword id=\"block\">방어도</keyword>만큼 피해 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seu dano de <keyword id=\"stun\">Atordoamento</keyword> ignora o <keyword id=\"block\">Bloqueio</keyword> inimigo e ganha dano equivalente a esse <keyword id=\"block\">Bloqueio</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "自身<keyword id=\"stun\">暈眩</keyword>傷害無視敵人<keyword id=\"block\">格擋</keyword>，並增加等同該<keyword id=\"block\">格擋</keyword>的傷害"}}
      }
    },
    "authored.2ea4edd70eaa1239": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Abilities/AbilityCatalog+Basic.swift: name",
