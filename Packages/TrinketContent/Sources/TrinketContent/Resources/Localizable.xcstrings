    "talents.wildcard_dodge_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: wildcard_dodge_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ausweichen unter halber <keyword id=\"health\">Gesundheit</keyword> lässt dich eine Karte ziehen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Dodging below half <keyword id=\"health\">Health</keyword> draws a card"}},
        "es": {"stringUnit": {"state": "translated", "value": "Esquivar por debajo de la mitad de <keyword id=\"health\">Salud</keyword> hace que robes una carta"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Esquiver sous la moitié de votre <keyword id=\"health\">Santé</keyword> fait piocher une carte"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>が半分未満の時に回避すると、カードを1枚引く"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword>이 절반 미만일 때 회피하면 카드 한 장 뽑기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Esquivar abaixo de metade da <keyword id=\"health\">Vida</keyword> faz você comprar uma carta"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">生命值</keyword>低於一半時閃避，抽一張牌"}}
      }
    },
