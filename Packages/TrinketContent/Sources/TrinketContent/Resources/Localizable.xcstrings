    "traits.plague_mask.description": {
      "comment": "ContentManifest/traits.tsv: plague_mask, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Stellt <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Gesundheit</keyword> wieder her, wann immer ein Gegner Schaden durch <keyword id=\"poison\">Gift</keyword> erleidet."}},
        "en": {"stringUnit": {"state": "translated", "value": "Restores <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Health</keyword> whenever an opponent takes <keyword id=\"poison\">Poison</keyword> damage."}},
        "es": {"stringUnit": {"state": "translated", "value": "Recupera <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Salud</keyword> cada vez que un oponente recibe daño de <keyword id=\"poison\">Veneno</keyword>."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Restaure <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Santé</keyword> chaque fois qu’un adversaire subit des dégâts de <keyword id=\"poison\">Poison</keyword>."}},
        "ja": {"stringUnit": {"state": "translated", "value": "相手が<keyword id=\"poison\">毒</keyword>ダメージを受けるたびに、自身の<keyword id=\"health\">体力</keyword>を<value id=\"quantity_1\">%1$lld</value>回復する。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "상대가 <keyword id=\"poison\">독</keyword> 피해를 받을 때마다 자신의 <keyword id=\"health\">체력</keyword>을 <value id=\"quantity_1\">%1$lld</value> 회복한다."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Recupera <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Vida</keyword> sempre que um oponente sofre dano de <keyword id=\"poison\">Veneno</keyword>."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每當對手受到<keyword id=\"poison\">中毒</keyword>傷害時，恢復自身<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"health\">生命值</keyword>。"}}
      }
    },
