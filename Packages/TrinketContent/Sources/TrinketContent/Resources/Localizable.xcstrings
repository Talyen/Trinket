    "affixes.prismatic.astral_description": {
      "comment": "ContentManifest/affixes.tsv: prismatic, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Angriffe verursachen <value id=\"quantity_1\">%1$lld</value> zusätzlichen Schaden, wenn sich ihr Typ vom Typ deines vorherigen Angriffs unterscheidet"}},
        "en": {"stringUnit": {"state": "translated", "value": "Attacks gain <value id=\"quantity_1\">%1$lld</value> damage when their type differs from your previous attack"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques infligen <value id=\"quantity_1\">%1$lld</value> de daño adicional si su tipo difiere del de tu ataque anterior"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques infligent <value id=\"quantity_1\">%1$lld</value> dégâts supplémentaires si leur type diffère de celui de votre attaque précédente"}},
        "ja": {"stringUnit": {"state": "translated", "value": "前回の自分の攻撃と種類が異なる攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "자신의 이전 공격과 유형이 다르면 공격 피해가 <value id=\"quantity_1\">%1$lld</value> 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques causam <value id=\"quantity_1\">%1$lld</value> de dano adicional se o tipo for diferente do seu ataque anterior"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "攻擊類型與你上一次攻擊不同時，傷害提高<value id=\"quantity_1\">%1$lld</value>"}}
      }
    },
    "affixes.prismatic.basic_description": {
      "comment": "ContentManifest/affixes.tsv: prismatic, basic_description",
      "extractionState": "manual",
      "localizations": {
