    "talents.druid_mana_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: druid_mana_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle <value id=\"quantity_1\">%1$lld</value> zusätzliches <keyword id=\"mana\">Mana</keyword> wieder her, solange du <keyword id=\"thorns\">Dornen</keyword> hast"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore <value id=\"quantity_1\">%1$lld</value> additional <keyword id=\"mana\">Mana</keyword> while you have <keyword id=\"thorns\">Thorns</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword> de plus tant que vous avez des <keyword id=\"thorns\">Épines</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"thorns\">棘</keyword>がある間、<keyword id=\"mana\">マナ</keyword>回復量が<value id=\"quantity_1\">%1$lld</value>増加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"thorns\">가시</keyword>가 있으면 <keyword id=\"mana\">마나</keyword> <value id=\"quantity_1\">%1$lld</value> 추가 회복"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擁有<keyword id=\"thorns\">荊棘</keyword>時，額外恢復<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"mana\">魔力</keyword>"
          }
        }
      }
    },
