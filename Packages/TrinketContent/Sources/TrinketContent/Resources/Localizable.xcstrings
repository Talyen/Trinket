    "authored.dd9400808bae9c2b": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog+Accessory.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ausweichen lässt dich eine <keyword id=\"poison\">Gift</keyword>-Karte ziehen und garantiert, dass der Schaden deiner nächsten <keyword id=\"poison\">Gift</keyword>-Karte kritisch trifft"}},
        "en": {"stringUnit": {"state": "translated", "value": "Dodging draws a <keyword id=\"poison\">Poison</keyword> card and guarantees your next <keyword id=\"poison\">Poison</keyword> card’s damage Critically Hits"}},
        "es": {"stringUnit": {"state": "translated", "value": "Esquivar hace que robes una carta de <keyword id=\"poison\">Veneno</keyword> y garantiza que el daño de tu siguiente carta de <keyword id=\"poison\">Veneno</keyword> aseste un golpe crítico"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Une esquive fait piocher une carte de <keyword id=\"poison\">Poison</keyword> et garantit un coup critique aux dégâts de votre prochaine carte de <keyword id=\"poison\">Poison</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "回避すると<keyword id=\"poison\">毒</keyword>カードを1枚引き、次の<keyword id=\"poison\">毒</keyword>カードのダメージが必ずクリティカルヒット"}},
        "ko": {"stringUnit": {"state": "translated", "value": "회피 시 <keyword id=\"poison\">독</keyword> 카드 한 장을 뽑고 다음 <keyword id=\"poison\">독</keyword> 카드의 피해가 반드시 치명타"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Esquivar faz você comprar uma carta de <keyword id=\"poison\">Veneno</keyword> e garante que o dano da sua próxima carta de <keyword id=\"poison\">Veneno</keyword> seja crítico"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "閃避時抽一張<keyword id=\"poison\">中毒</keyword>牌，且下張<keyword id=\"poison\">中毒</keyword>牌的傷害必定暴擊"}}
      }
    },
