    "talents.panther_dodge_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: panther_dodge_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausweichen lässt deinen nächsten Angriff kritisch treffen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodging makes your next attack Critically Hit"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une esquive garantit un coup critique à votre prochaine attaque"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回避すると、次の攻撃が必ずクリティカルヒット"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회피 시 다음 공격이 반드시 치명타"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "閃避後，下次攻擊必定暴擊"
          }
        }
      }
    },
