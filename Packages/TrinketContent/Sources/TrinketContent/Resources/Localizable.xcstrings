        "zh-Hant": {"stringUnit": {"state": "translated", "value": "恢復的<keyword id=\"mana\">魔力</keyword>增加<value id=\"quantity_1\">%1$lld</value>%%\n每天生產<value id=\"quantity_2\">%2$lld</value>寶石"}}
