    "talents.wolf_bleed_t4_2.description": {
      "comment": "ContentManifest/talents.tsv: wolf_bleed_t4_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Kritische <keyword id=\"bleed\">Blutungs</keyword>-Treffer lassen dich mit <value id=\"quantity_1\">%1$lld</value>%% Chance eine Karte ziehen"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">Bleed</keyword> Critical Hits have a <value id=\"quantity_1\">%1$lld</value>%% chance to draw a card"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los golpes críticos de <keyword id=\"bleed\">Sangrado</keyword> tienen un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de hacer que robes una carta"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les coups critiques de <keyword id=\"bleed\">Saignement</keyword> ont <value id=\"quantity_1\">%1$lld</value>%% de chances de faire piocher une carte"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">出血</keyword>クリティカルヒット時に<value id=\"quantity_1\">%1$lld</value>%%の確率でカードを1枚引く"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">출혈</keyword> 치명타 적중 시 <value id=\"quantity_1\">%1$lld</value>%% 확률로 카드 한 장 뽑기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Golpes críticos de <keyword id=\"bleed\">Sangramento</keyword> têm <value id=\"quantity_1\">%1$lld</value>%% de chance de comprar uma carta"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">流血</keyword>暴擊有<value id=\"quantity_1\">%1$lld</value>%%機率抽一張牌"}}
      }
