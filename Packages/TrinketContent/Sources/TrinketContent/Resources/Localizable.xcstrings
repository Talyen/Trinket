    "talents.frost_whelp_freeze_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: frost_whelp_freeze_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Einfrieren eines Gegners stellt <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword> wieder her"}},
        "en": {"stringUnit": {"state": "translated", "value": "Freezing an enemy restores <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Congelar a un enemigo restaura <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"mana\">Maná</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Geler un ennemi restaure <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "敵を凍結状態にすると<keyword id=\"mana\">マナ</keyword>を<value id=\"quantity_1\">%1$lld</value>回復"}},
        "ko": {"stringUnit": {"state": "translated", "value": "적을 빙결시키면 <keyword id=\"mana\">마나</keyword> <value id=\"quantity_1\">%1$lld</value> 회복"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Congelar um inimigo restaura <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"mana\">Mana</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "使敵人冰凍時，恢復<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"mana\">魔力</keyword>"}}
      }
    },
