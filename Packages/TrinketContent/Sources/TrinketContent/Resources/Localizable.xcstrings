    "affixes.catalytic.astral_description": {
      "comment": "ContentManifest/affixes.tsv: catalytic, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Angriffe verursachen <value id=\"quantity_1\">%1$lld</value> zusätzlichen Schaden gegen Gegner mit <keyword id=\"burn\">Brand</keyword> und <keyword id=\"poison\">Gift</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Attacks gain <value id=\"quantity_1\">%1$lld</value> damage against enemies with both <keyword id=\"burn\">Burn</keyword> and <keyword id=\"poison\">Poison</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques infligen <value id=\"quantity_1\">%1$lld</value> de daño adicional a enemigos con <keyword id=\"burn\">Quemadura</keyword> y <keyword id=\"poison\">Veneno</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques infligent <value id=\"quantity_1\">%1$lld</value> dégâts supplémentaires aux ennemis avec <keyword id=\"burn\">Brûlure</keyword> et <keyword id=\"poison\">Poison</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">炎上</keyword>と<keyword id=\"poison\">毒</keyword>の両方が付与された敵への攻撃ダメージが<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">화상</keyword>과 <keyword id=\"poison\">독</keyword>에 모두 걸린 적에게 주는 공격 피해가 <value id=\"quantity_1\">%1$lld</value> 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques causam <value id=\"quantity_1\">%1$lld</value> de dano adicional a inimigos com <keyword id=\"burn\">Queimadura</keyword> e <keyword id=\"poison\">Veneno</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "攻擊同時帶有<keyword id=\"burn\">燃燒</keyword>與<keyword id=\"poison\">中毒</keyword>的敵人時，傷害提高<value id=\"quantity_1\">%1$lld</value>"}}
      }
    },
