      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wiederformung"}},
        "en": {"stringUnit": {"state": "translated", "value": "Reform"}},
        "es": {"stringUnit": {"state": "translated", "value": "Recomposición"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Reconstitution"}},
        "ja": {"stringUnit": {"state": "translated", "value": "再形成"}},
        "ko": {"stringUnit": {"state": "translated", "value": "재형성"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Recomposição"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "重塑"}}
      }
    },
    "traits.restoring_light.description": {
      "comment": "ContentManifest/traits.tsv: restoring_light, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Jeder Treffer vom Typ <keyword id=\"holy\">Heilig</keyword> stellt <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Gesundheit</keyword> wieder her."}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">Holy</keyword> hits restore <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Health</keyword>."}},
        "es": {"stringUnit": {"state": "translated", "value": "Cada impacto <keyword id=\"holy\">Sagrado</keyword> restaura <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Salud</keyword>."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Chaque coup de type <keyword id=\"holy\">Sacré</keyword> restaure <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Santé</keyword>."}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">聖</keyword>ダメージの各ヒットで、<keyword id=\"health\">体力</keyword>を<value id=\"quantity_1\">%1$lld</value>回復する。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">신성</keyword> 타격이 적중할 때마다 <keyword id=\"health\">체력</keyword>을 <value id=\"quantity_1\">%1$lld</value> 회복한다."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cada acerto <keyword id=\"holy\">Sagrado</keyword> restaura <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Vida</keyword>."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每次<keyword id=\"holy\">神聖</keyword>打擊命中時，恢復<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"health\">生命值</keyword>。"}}
      }
    },
    "traits.restoring_light.name": {
      "comment": "ContentManifest/traits.tsv: restoring_light, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Heilendes Licht"}},
        "en": {"stringUnit": {"state": "translated", "value": "Restoring Light"}},
        "es": {"stringUnit": {"state": "translated", "value": "Luz restauradora"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Lumière réparatrice"}},
        "ja": {"stringUnit": {"state": "translated", "value": "癒やしの光"}},
        "ko": {"stringUnit": {"state": "translated", "value": "회복의 빛"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Luz Restauradora"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "恢復之光"}}
      }
    },
    "traits.righteous_guard.description": {
      "comment": "ContentManifest/traits.tsv: righteous_guard, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Treffer vom Typ <keyword id=\"holy\">Heilig</keyword> oder <keyword id=\"stun\">Betäubung</keyword> gewähren jeweils <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>."}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">Holy</keyword> and <keyword id=\"stun\">Stun</keyword> hits grant <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>."}},
        "es": {"stringUnit": {"state": "translated", "value": "Los impactos de daño <keyword id=\"holy\">Sagrado</keyword> y de <keyword id=\"stun\">Aturdimiento</keyword> otorgan <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueo</keyword> cada uno."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les coups de type <keyword id=\"holy\">Sacré</keyword> et les coups d’<keyword id=\"stun\">Étourdissement</keyword> octroient chacun <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Blocage</keyword>."}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">聖</keyword>または<keyword id=\"stun\">スタン</keyword>ダメージの各ヒットで、<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>獲得する。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">신성</keyword> 또는 <keyword id=\"stun\">기절</keyword> 타격이 적중할 때마다 <keyword id=\"block\">방어도</keyword>를 <value id=\"quantity_1\">%1$lld</value> 얻는다."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Acertos de dano <keyword id=\"holy\">Sagrado</keyword> e de <keyword id=\"stun\">Atordoamento</keyword> concedem <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueio</keyword> cada um."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每次<keyword id=\"holy\">神聖</keyword>或<keyword id=\"stun\">暈眩</keyword>打擊命中時，都會獲得<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>。"}}
      }
    },
    "traits.righteous_guard.name": {
      "comment": "ContentManifest/traits.tsv: righteous_guard, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Rechtschaffener Schutz"}},
        "en": {"stringUnit": {"state": "translated", "value": "Righteous Guard"}},
        "es": {"stringUnit": {"state": "translated", "value": "Guardia justa"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Garde vertueuse"}},
        "ja": {"stringUnit": {"state": "translated", "value": "正義の守り"}},
        "ko": {"stringUnit": {"state": "translated", "value": "정의로운 수호"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Guarda Justa"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "正義守護"}}
      }
    },
    "traits.rimeguard.description": {
      "comment": "ContentManifest/traits.tsv: rimeguard, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erhalte <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>, wenn ein Gegner <keyword id=\"freeze\">eingefroren</keyword> wird"}},
        "en": {"stringUnit": {"state": "translated", "value": "Gain <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword> whenever an enemy becomes <keyword id=\"freeze\">Frozen</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Obtén <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueo</keyword> siempre que un enemigo queda <keyword id=\"freeze\">congelado</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Gagnez <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Blocage</keyword> chaque fois qu’un ennemi devient <keyword id=\"freeze\">gelé</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "敵が<keyword id=\"freeze\">凍結</keyword>状態になるたび、<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>獲得"}},
        "ko": {"stringUnit": {"state": "translated", "value": "적이 <keyword id=\"freeze\">빙결</keyword> 상태가 될 때마다 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 획득"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ganhe <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueio</keyword> sempre que um inimigo for <keyword id=\"freeze\">Congelado</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每當敵人陷入<keyword id=\"freeze\">冰凍</keyword>，獲得<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>"}}
      }
    },
    "traits.rimeguard.name": {
      "comment": "ContentManifest/traits.tsv: rimeguard, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Reifschutz"}},
        "en": {"stringUnit": {"state": "translated", "value": "Rimeguard"}},
        "es": {"stringUnit": {"state": "translated", "value": "Guardia de escarcha"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Garde givrée"}},
        "ja": {"stringUnit": {"state": "translated", "value": "霜の守護"}},
        "ko": {"stringUnit": {"state": "translated", "value": "서리 수호자"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Guarda de Geada"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "寒霜護衛"}}
      }
    },
    "traits.sated_fury.description": {
      "comment": "ContentManifest/traits.tsv: sated_fury, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Erreichen voller <keyword id=\"health\">Gesundheit</keyword> lässt den nächsten Angriff <value id=\"quantity_1\">%1$lld</value> zusätzlichen Schaden verursachen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Reaching full <keyword id=\"health\">Health</keyword> makes the next attack deal <value id=\"quantity_1\">%1$lld</value> additional damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Alcanzar toda la <keyword id=\"health\">Salud</keyword> hace que el siguiente ataque inflija <value id=\"quantity_1\">%1$lld</value> de daño adicional"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Atteindre la pleine <keyword id=\"health\">Santé</keyword> ajoute <value id=\"quantity_1\">%1$lld</value> dégâts à la prochaine attaque"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>が満タンになると、次の攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword>이 가득 차면 다음 공격의 추가 피해 <value id=\"quantity_1\">%1$lld</value>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Encher a <keyword id=\"health\">Vida</keyword> faz o próximo ataque causar <value id=\"quantity_1\">%1$lld</value> de dano adicional"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">生命值</keyword>恢復全滿時，下次攻擊額外造成<value id=\"quantity_1\">%1$lld</value>點傷害"}}
      }
    },
    "traits.sated_fury.name": {
      "comment": "ContentManifest/traits.tsv: sated_fury, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Gesättigte Wut"}},
        "en": {"stringUnit": {"state": "translated", "value": "Sated Fury"}},
        "es": {"stringUnit": {"state": "translated", "value": "Furia saciada"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Fureur rassasiée"}},
        "ja": {"stringUnit": {"state": "translated", "value": "満ちた怒り"}},
        "ko": {"stringUnit": {"state": "translated", "value": "충만한 분노"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Fúria Saciada"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "飽足之怒"}}
      }
    },
    "traits.searing_body.description": {
      "comment": "ContentManifest/traits.tsv: searing_body, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wenn du getroffen wirst, belege den Angreifer mit <value id=\"quantity_1\">%1$lld</value> <keyword id=\"burn\">Brand</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Apply <value id=\"quantity_1\">%1$lld</value> <keyword id=\"burn\">Burn</keyword> to attackers when hit"}},
        "es": {"stringUnit": {"state": "translated", "value": "Aplica <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"burn\">Quemadura</keyword> a los atacantes al recibir un impacto"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Lorsque vous êtes touché, appliquez <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"burn\">Brûlure</keyword> aux attaquants"}},
        "ja": {"stringUnit": {"state": "translated", "value": "攻撃を受けると攻撃者に<keyword id=\"burn\">炎上</keyword>を<value id=\"quantity_1\">%1$lld</value>付与"}},
        "ko": {"stringUnit": {"state": "translated", "value": "공격에 맞으면 공격자에게 <keyword id=\"burn\">화상</keyword> <value id=\"quantity_1\">%1$lld</value> 부여"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Aplique <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"burn\">Queimadura</keyword> aos atacantes ao ser atingido"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "被命中時，對攻擊者施加<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"burn\">燃燒</keyword>"}}
      }
    },
    "traits.searing_body.name": {
      "comment": "ContentManifest/traits.tsv: searing_body, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Sengender Körper"}},
        "en": {"stringUnit": {"state": "translated", "value": "Searing Body"}},
        "es": {"stringUnit": {"state": "translated", "value": "Cuerpo abrasador"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Corps ardent"}},
        "ja": {"stringUnit": {"state": "translated", "value": "灼熱の体"}},
        "ko": {"stringUnit": {"state": "translated", "value": "불타는 몸체"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Corpo Abrasador"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "灼熱身軀"}}
      }
    },
    "traits.seismic_pulse.description": {
      "comment": "ContentManifest/traits.tsv: seismic_pulse, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verursacht jeden zweiten Zug <value id=\"quantity_1\">%1$lld</value> <keyword id=\"physical\">physischen</keyword> Schaden."}},
        "en": {"stringUnit": {"state": "translated", "value": "Deals <value id=\"quantity_1\">%1$lld</value> <keyword id=\"physical\">Physical</keyword> damage every other turn."}},
        "es": {"stringUnit": {"state": "translated", "value": "Inflige <value id=\"quantity_1\">%1$lld</value> de daño <keyword id=\"physical\">Físico</keyword> cada dos turnos."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Inflige <value id=\"quantity_1\">%1$lld</value> de dégâts de type <keyword id=\"physical\">Physique</keyword> un tour sur deux."}},
        "ja": {"stringUnit": {"state": "translated", "value": "1ターンおきに<keyword id=\"physical\">物理</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "한 턴 걸러 <keyword id=\"physical\">물리</keyword> 피해를 <value id=\"quantity_1\">%1$lld</value> 준다."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Causa <value id=\"quantity_1\">%1$lld</value> de dano <keyword id=\"physical\">Físico</keyword> a cada dois turnos."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每隔一回合造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"physical\">物理</keyword>傷害。"}}
      }
    },
    "traits.seismic_pulse.name": {
      "comment": "ContentManifest/traits.tsv: seismic_pulse, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Seismischer Puls"}},
        "en": {"stringUnit": {"state": "translated", "value": "Seismic Pulse"}},
        "es": {"stringUnit": {"state": "translated", "value": "Pulso sísmico"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Pulsation sismique"}},
        "ja": {"stringUnit": {"state": "translated", "value": "大地の脈動"}},
        "ko": {"stringUnit": {"state": "translated", "value": "지진의 파동"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Pulso Sísmico"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "震地脈衝"}}
      }
    },
    "traits.self_sacrifice.description": {
      "comment": "ContentManifest/traits.tsv: self_sacrifice, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verliert nach jedem eigenen Angriffstreffer <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Gesundheit</keyword>."}},
        "en": {"stringUnit": {"state": "translated", "value": "Loses <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Health</keyword> after each attack hit."}},
        "es": {"stringUnit": {"state": "translated", "value": "Pierde <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Salud</keyword> después de cada impacto de sus ataques."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Perd <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Santé</keyword> après chaque coup porté lors de ses attaques."}},
        "ja": {"stringUnit": {"state": "translated", "value": "攻撃の各ヒット後に<keyword id=\"health\">体力</keyword>を<value id=\"quantity_1\">%1$lld</value>失う。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "공격이 적중할 때마다 그 직후 <keyword id=\"health\">체력</keyword>을 <value id=\"quantity_1\">%1$lld</value> 잃는다."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Perde <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Vida</keyword> após cada acerto de seus ataques."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每次攻擊命中後，失去<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"health\">生命值</keyword>。"}}
      }
    },
    "traits.self_sacrifice.name": {
      "comment": "ContentManifest/traits.tsv: self_sacrifice, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Selbstopfer"}},
        "en": {"stringUnit": {"state": "translated", "value": "Self-Sacrifice"}},
        "es": {"stringUnit": {"state": "translated", "value": "Autosacrificio"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Sacrifice de soi"}},
        "ja": {"stringUnit": {"state": "translated", "value": "自己犠牲"}},
        "ko": {"stringUnit": {"state": "translated", "value": "자기희생"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Autossacrifício"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "自我犧牲"}}
      }
    },
    "traits.shieldbreaker.description": {
      "comment": "ContentManifest/traits.tsv: shieldbreaker, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">Physische</keyword> Angriffe verursachen doppelten Schaden an gegnerischem <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">Physical</keyword> attacks deal double damage to enemy <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques <keyword id=\"physical\">físicos</keyword> infligen el doble de daño al <keyword id=\"block\">Bloqueo</keyword> del enemigo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques de type <keyword id=\"physical\">Physique</keyword> infligent le double de dégâts au <keyword id=\"block\">Blocage</keyword> ennemi"}},
        "ja": {"stringUnit": {"state": "translated", "value": "敵の<keyword id=\"block\">ブロック</keyword>への<keyword id=\"physical\">物理</keyword>攻撃のダメージが2倍になる"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">물리</keyword> 공격이 적의 <keyword id=\"block\">방어도</keyword>에 두 배의 피해"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques <keyword id=\"physical\">Físicos</keyword> causam o dobro de dano ao <keyword id=\"block\">Bloqueio</keyword> inimigo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">物理</keyword>攻擊對敵人<keyword id=\"block\">格擋</keyword>造成雙倍傷害"}}
      }
    },
    "traits.shieldbreaker.name": {
      "comment": "ContentManifest/traits.tsv: shieldbreaker, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Schildzertrümmerer"}},
        "en": {"stringUnit": {"state": "translated", "value": "Shieldbreaker"}},
        "es": {"stringUnit": {"state": "translated", "value": "Rompeescudos"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Briseur de bouclier"}},
        "ja": {"stringUnit": {"state": "translated", "value": "盾破り"}},
        "ko": {"stringUnit": {"state": "translated", "value": "방패 파괴"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Quebra-Escudos"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "碎盾者"}}
      }
    },
    "traits.siphon.description": {
      "comment": "ContentManifest/traits.tsv: siphon, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Jeder eigene Angriffstreffer stellt <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Gesundheit</keyword> wieder her."}},
        "en": {"stringUnit": {"state": "translated", "value": "Attack hits restore <value id=\"quantity_1\">%1$lld</value> <keyword id=\"health\">Health</keyword>."}},
        "es": {"stringUnit": {"state": "translated", "value": "Cada impacto de sus ataques restaura <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Salud</keyword>."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Chaque coup porté lors de ses attaques restaure <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Santé</keyword>."}},
        "ja": {"stringUnit": {"state": "translated", "value": "攻撃の各ヒットで<keyword id=\"health\">体力</keyword>を<value id=\"quantity_1\">%1$lld</value>回復する。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "공격이 적중할 때마다 <keyword id=\"health\">체력</keyword>을 <value id=\"quantity_1\">%1$lld</value> 회복한다."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cada acerto de seus ataques restaura <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Vida</keyword>."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每次攻擊命中時，恢復<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"health\">生命值</keyword>。"}}
      }
    },
    "traits.siphon.name": {
      "comment": "ContentManifest/traits.tsv: siphon, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Absaugen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Siphon"}},
        "es": {"stringUnit": {"state": "translated", "value": "Succión"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Siphon"}},
        "ja": {"stringUnit": {"state": "translated", "value": "吸引"}},
        "ko": {"stringUnit": {"state": "translated", "value": "착취"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Sifão"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "汲取之觸"}}
      }
    },
    "traits.stonehide.description": {
      "comment": "ContentManifest/traits.tsv: stonehide, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erlittener <keyword id=\"physical\">physischer</keyword> Schaden um <value id=\"quantity_1\">%1$lld</value>%% verringert"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">Physical</keyword> damage taken reduced by <value id=\"quantity_1\">%1$lld</value>%%"}},
        "es": {"stringUnit": {"state": "translated", "value": "Daño <keyword id=\"physical\">físico</keyword> recibido reducido en un <value id=\"quantity_1\">%1$lld</value>%%"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Dégâts de type <keyword id=\"physical\">Physique</keyword> subis réduits de <value id=\"quantity_1\">%1$lld</value>%%"}},
        "ja": {"stringUnit": {"state": "translated", "value": "受ける<keyword id=\"physical\">物理</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%減少"}},
        "ko": {"stringUnit": {"state": "translated", "value": "받는 <keyword id=\"physical\">물리</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>%% 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Dano <keyword id=\"physical\">Físico</keyword> recebido reduzido em <value id=\"quantity_1\">%1$lld</value>%%"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "承受的<keyword id=\"physical\">物理</keyword>傷害降低<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "traits.stonehide.name": {
      "comment": "ContentManifest/traits.tsv: stonehide, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Steinhaut"}},
        "en": {"stringUnit": {"state": "translated", "value": "Stonehide"}},
        "es": {"stringUnit": {"state": "translated", "value": "Piel pétrea"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Peau de pierre"}},
        "ja": {"stringUnit": {"state": "translated", "value": "石の皮膚"}},
        "ko": {"stringUnit": {"state": "translated", "value": "돌가죽"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Pele de Pedra"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "石膚"}}
      }
    },
    "traits.thawing.description": {
      "comment": "ContentManifest/traits.tsv: thawing, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erlittener Schaden durch <keyword id=\"burn\">Brand</keyword> um <value id=\"quantity_1\">%1$lld</value> %% erhöht"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Burn</keyword> damage taken increased by <value id=\"quantity_1\">%1$lld</value>%%"}},
        "es": {"stringUnit": {"state": "translated", "value": "El daño de <keyword id=\"burn\">Quemadura</keyword> recibido aumenta un <value id=\"quantity_1\">%1$lld</value> %%"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les dégâts de <keyword id=\"burn\">Brûlure</keyword> subis augmentent de <value id=\"quantity_1\">%1$lld</value> %%"}},
        "ja": {"stringUnit": {"state": "translated", "value": "受ける<keyword id=\"burn\">炎上</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "받는 <keyword id=\"burn\">화상</keyword> 피해가 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O dano de <keyword id=\"burn\">Queimadura</keyword> recebido aumenta em <value id=\"quantity_1\">%1$lld</value>%%"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "受到的<keyword id=\"burn\">燃燒</keyword>傷害提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "traits.thawing.name": {
      "comment": "ContentManifest/traits.tsv: thawing, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Auftauend"}},
        "en": {"stringUnit": {"state": "translated", "value": "Thawing"}},
        "es": {"stringUnit": {"state": "translated", "value": "Deshielo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Dégel"}},
        "ja": {"stringUnit": {"state": "translated", "value": "解凍"}},
        "ko": {"stringUnit": {"state": "translated", "value": "해빙"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Degelo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "解凍"}}
      }
    },
    "traits.thunderous_tremor.description": {
      "comment": "ContentManifest/traits.tsv: thunderous_tremor, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verursacht jeden zweiten Zug <value id=\"quantity_1\">%1$lld</value> Schaden vom Typ <keyword id=\"physical\">Physisch</keyword> oder <keyword id=\"stun\">Betäubung</keyword>."}},
        "en": {"stringUnit": {"state": "translated", "value": "Deals <value id=\"quantity_1\">%1$lld</value> <keyword id=\"physical\">Physical</keyword> or <keyword id=\"stun\">Stun</keyword> damage every other turn."}},
        "es": {"stringUnit": {"state": "translated", "value": "Inflige <value id=\"quantity_1\">%1$lld</value> de daño <keyword id=\"physical\">Físico</keyword> o de <keyword id=\"stun\">Aturdimiento</keyword> cada dos turnos."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Inflige <value id=\"quantity_1\">%1$lld</value> de dégâts de type <keyword id=\"physical\">Physique</keyword> ou d’<keyword id=\"stun\">Étourdissement</keyword> un tour sur deux."}},
        "ja": {"stringUnit": {"state": "translated", "value": "1ターンおきに<keyword id=\"physical\">物理</keyword>か<keyword id=\"stun\">スタン</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "한 턴 걸러 <keyword id=\"physical\">물리</keyword> 또는 <keyword id=\"stun\">기절</keyword> 피해를 <value id=\"quantity_1\">%1$lld</value> 준다."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Causa <value id=\"quantity_1\">%1$lld</value> de dano <keyword id=\"physical\">Físico</keyword> ou de <keyword id=\"stun\">Atordoamento</keyword> a cada dois turnos."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每隔一回合造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"physical\">物理</keyword>或<keyword id=\"stun\">暈眩</keyword>傷害。"}}
      }
    },
    "traits.thunderous_tremor.name": {
      "comment": "ContentManifest/traits.tsv: thunderous_tremor, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Donnerndes Beben"}},
        "en": {"stringUnit": {"state": "translated", "value": "Thunderous Tremor"}},
        "es": {"stringUnit": {"state": "translated", "value": "Temblor atronador"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Secousse tonitruante"}},
        "ja": {"stringUnit": {"state": "translated", "value": "轟く震動"}},
        "ko": {"stringUnit": {"state": "translated", "value": "천둥 같은 진동"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Tremor Trovejante"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "雷霆巨震"}}
      }
    },
    "traits.venomous_strikes.description": {
      "comment": "ContentManifest/traits.tsv: venomous_strikes, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Jeder Angriffstreffer belegt das Ziel mit <value id=\"quantity_1\">%1$lld</value> <keyword id=\"poison\">Gift</keyword>."}},
        "en": {"stringUnit": {"state": "translated", "value": "Attack hits inflict <value id=\"quantity_1\">%1$lld</value> <keyword id=\"poison\">Poison</keyword>."}},
        "es": {"stringUnit": {"state": "translated", "value": "Cada impacto de ataque aplica <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"poison\">Veneno</keyword>."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Chaque coup d’une attaque applique <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"poison\">Poison</keyword>."}},
        "ja": {"stringUnit": {"state": "translated", "value": "攻撃の各ヒットで<keyword id=\"poison\">毒</keyword>を<value id=\"quantity_1\">%1$lld</value>付与する。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "공격이 적중할 때마다 <keyword id=\"poison\">독</keyword>을 <value id=\"quantity_1\">%1$lld</value> 부여한다."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cada acerto de ataque aplica <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"poison\">Veneno</keyword>."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每次攻擊命中時，施加<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"poison\">中毒</keyword>。"}}
      }
    },
    "traits.venomous_strikes.name": {
      "comment": "ContentManifest/traits.tsv: venomous_strikes, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Giftige Schläge"}},
        "en": {"stringUnit": {"state": "translated", "value": "Venomous Strikes"}},
        "es": {"stringUnit": {"state": "translated", "value": "Golpes venenosos"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Frappes venimeuses"}},
        "ja": {"stringUnit": {"state": "translated", "value": "毒の連撃"}},
        "ko": {"stringUnit": {"state": "translated", "value": "맹독 연격"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Golpes Peçonhentos"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "毒液打擊"}}
      }
    },
    "traits.watchful_guard.description": {
      "comment": "ContentManifest/traits.tsv: watchful_guard, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erhalte zu Beginn jeder Runde <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Gain <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword> at the start of each round"}},
        "es": {"stringUnit": {"state": "translated", "value": "Obtén <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueo</keyword> al inicio de cada ronda"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Gagnez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Blocage</keyword> au début de chaque manche"}},
        "ja": {"stringUnit": {"state": "translated", "value": "各ラウンド開始時に<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>獲得"}},
        "ko": {"stringUnit": {"state": "translated", "value": "매 라운드 시작 시 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 획득"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ganhe <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueio</keyword> no início de cada rodada"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每輪開始時，獲得<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>"}}
      }
    },
    "traits.watchful_guard.name": {
      "comment": "ContentManifest/traits.tsv: watchful_guard, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wachsamer Schutz"}},
        "en": {"stringUnit": {"state": "translated", "value": "Watchful Guard"}},
        "es": {"stringUnit": {"state": "translated", "value": "Guardia vigilante"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Garde vigilante"}},
        "ja": {"stringUnit": {"state": "translated", "value": "警戒の守り"}},
        "ko": {"stringUnit": {"state": "translated", "value": "경계의 수호"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Guarda Vigilante"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "警戒守護"}}
      }
    },
    "traits.winterborn.description": {
      "comment": "ContentManifest/traits.tsv: winterborn, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erlittener <keyword id=\"freeze\">Frost</keyword>schaden um <value id=\"quantity_1\">%1$lld</value>%% verringert"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">Freeze</keyword> damage taken reduced by <value id=\"quantity_1\">%1$lld</value>%%"}},
        "es": {"stringUnit": {"state": "translated", "value": "Daño de <keyword id=\"freeze\">Congelación</keyword> recibido reducido en un <value id=\"quantity_1\">%1$lld</value>%%"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Dégâts de <keyword id=\"freeze\">Gel</keyword> subis réduits de <value id=\"quantity_1\">%1$lld</value>%%"}},
        "ja": {"stringUnit": {"state": "translated", "value": "受ける<keyword id=\"freeze\">凍結</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%減少"}},
        "ko": {"stringUnit": {"state": "translated", "value": "받는 <keyword id=\"freeze\">빙결</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>%% 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Dano de <keyword id=\"freeze\">Congelamento</keyword> recebido reduzido em <value id=\"quantity_1\">%1$lld</value>%%"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "承受的<keyword id=\"freeze\">冰凍</keyword>傷害降低<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "traits.winterborn.name": {
      "comment": "ContentManifest/traits.tsv: winterborn, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wintergeboren"}},
        "en": {"stringUnit": {"state": "translated", "value": "Winterborn"}},
        "es": {"stringUnit": {"state": "translated", "value": "Nacido del invierno"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Né de l’hiver"}},
        "ja": {"stringUnit": {"state": "translated", "value": "冬に生まれし者"}},
        "ko": {"stringUnit": {"state": "translated", "value": "겨울의 자손"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Nascido no Inverno"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "寒冬之子"}}
      }
    },
    "traits.winters_grasp.description": {
      "comment": "ContentManifest/traits.tsv: winters_grasp, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verursacht jeden zweiten Zug <value id=\"quantity_1\">%1$lld</value> <keyword id=\"freeze\">Frost</keyword>schaden."}},
        "en": {"stringUnit": {"state": "translated", "value": "Deals <value id=\"quantity_1\">%1$lld</value> <keyword id=\"freeze\">Freeze</keyword> damage every other turn."}},
        "es": {"stringUnit": {"state": "translated", "value": "Inflige <value id=\"quantity_1\">%1$lld</value> de daño de <keyword id=\"freeze\">Congelación</keyword> cada dos turnos."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Inflige <value id=\"quantity_1\">%1$lld</value> de dégâts de <keyword id=\"freeze\">Gel</keyword> un tour sur deux."}},
        "ja": {"stringUnit": {"state": "translated", "value": "1ターンおきに<keyword id=\"freeze\">凍結</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "한 턴 걸러 <keyword id=\"freeze\">빙결</keyword> 피해를 <value id=\"quantity_1\">%1$lld</value> 준다."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Causa <value id=\"quantity_1\">%1$lld</value> de dano de <keyword id=\"freeze\">Congelamento</keyword> a cada dois turnos."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每隔一回合造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"freeze\">冰凍</keyword>傷害。"}}
      }
    },
    "traits.winters_grasp.name": {
      "comment": "ContentManifest/traits.tsv: winters_grasp, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wintergriff"}},
        "en": {"stringUnit": {"state": "translated", "value": "Winter’s Grasp"}},
        "es": {"stringUnit": {"state": "translated", "value": "Agarre del invierno"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Étreinte de l’hiver"}},
        "ja": {"stringUnit": {"state": "translated", "value": "冬の掌握"}},
        "ko": {"stringUnit": {"state": "translated", "value": "겨울의 손아귀"}},
