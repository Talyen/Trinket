    "affixes.executioners.astral_description": {
      "comment": "ContentManifest/affixes.tsv: executioners, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verursache <value id=\"quantity_1\">%1$lld</value> zusätzlichen Schaden, wenn der Gegner unter <value id=\"quantity_2\">%2$lld</value>%% <keyword id=\"health\">Gesundheit</keyword> ist"}},
        "en": {"stringUnit": {"state": "translated", "value": "Deal <value id=\"quantity_1\">%1$lld</value> additional damage if the enemy is below <value id=\"quantity_2\">%2$lld</value>%% <keyword id=\"health\">Health</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Inflige <value id=\"quantity_1\">%1$lld</value> de daño adicional si el enemigo está por debajo del <value id=\"quantity_2\">%2$lld</value>%% de <keyword id=\"health\">Salud</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Infligez <value id=\"quantity_1\">%1$lld</value> dégâts supplémentaires si l’ennemi est sous <value id=\"quantity_2\">%2$lld</value>%% de <keyword id=\"health\">Santé</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "敵の<keyword id=\"health\">体力</keyword>が<value id=\"quantity_2\">%2$lld</value>%%未満なら、与えるダメージが<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "적의 <keyword id=\"health\">체력</keyword>이 <value id=\"quantity_2\">%2$lld</value>%% 미만이면 추가 피해 <value id=\"quantity_1\">%1$lld</value>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cause <value id=\"quantity_1\">%1$lld</value> de dano adicional se o inimigo estiver abaixo de <value id=\"quantity_2\">%2$lld</value>%% de <keyword id=\"health\">Vida</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "敵人<keyword id=\"health\">生命值</keyword>低於<value id=\"quantity_2\">%2$lld</value>%%時，額外造成<value id=\"quantity_1\">%1$lld</value>點傷害"}}
      }
    },
