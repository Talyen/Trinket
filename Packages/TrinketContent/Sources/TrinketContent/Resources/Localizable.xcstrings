      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Glücksbringer"}},
        "en": {"stringUnit": {"state": "translated", "value": "Lucky"}},
        "es": {"stringUnit": {"state": "translated", "value": "Afortunado"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Chanceux"}},
        "ja": {"stringUnit": {"state": "translated", "value": "幸運"}},
        "ko": {"stringUnit": {"state": "translated", "value": "운 좋은"}},
