    "affixes.vampiric.astral_description": {
      "comment": "ContentManifest/affixes.tsv: vampiric, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">Lebensraub</keyword> stellt zusätzlich <value id=\"quantity_1\">%1$lld</value>%% des verursachten Schadens wieder her"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">Leech</keyword> restores an additional <value id=\"quantity_1\">%1$lld</value>%% of damage dealt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le <keyword id=\"leech\">Vol de vie</keyword> restaure en plus <value id=\"quantity_1\">%1$lld</value>%% des dégâts infligés"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">吸収</keyword>による回復量が与えたダメージの<value id=\"quantity_1\">%1$lld</value>%%分増加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">흡혈</keyword>로 준 피해의 <value id=\"quantity_1\">%1$lld</value>%%만큼 추가 회복"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"leech\">吸血</keyword>額外恢復相當於所造成傷害<value id=\"quantity_1\">%1$lld</value>%%的生命值"
          }
        }
      }
    },
