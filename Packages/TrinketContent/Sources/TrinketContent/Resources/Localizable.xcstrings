    "homestead_nodes.chickencoop.1.bonus_description": {
      "comment": "ContentManifest/homestead_nodes.tsv: chickenCoop.1, bonus_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Die <keyword id=\"health\">Gesundheit</keyword> des Gefährten steigt um <value id=\"quantity_1\">%1$lld</value>%%\nProduziere <value id=\"quantity_2\">%2$lld</value> Nahrung pro Tag"}},
        "en": {"stringUnit": {"state": "translated", "value": "Companion <keyword id=\"health\">Health</keyword> rises by <value id=\"quantity_1\">%1$lld</value>%%\nProduce <value id=\"quantity_2\">%2$lld</value> Food per Day"}},
        "es": {"stringUnit": {"state": "translated", "value": "La <keyword id=\"health\">Salud</keyword> del compañero aumenta en un <value id=\"quantity_1\">%1$lld</value>%%\nProduce <value id=\"quantity_2\">%2$lld</value> de comida al día"}},
        "fr": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">Santé</keyword> du Compagnon augmentée de <value id=\"quantity_1\">%1$lld</value>%%\nProduit <value id=\"quantity_2\">%2$lld</value> de nourriture par jour"}},
        "ja": {"stringUnit": {"state": "translated", "value": "仲間の<keyword id=\"health\">体力</keyword>が<value id=\"quantity_1\">%1$lld</value>%%増加\n1日に食料を<value id=\"quantity_2\">%2$lld</value>生産"}},
        "ko": {"stringUnit": {"state": "translated", "value": "동료의 <keyword id=\"health\">체력</keyword> <value id=\"quantity_1\">%1$lld</value>%% 증가\n하루에 식량 <value id=\"quantity_2\">%2$lld</value>개 생산"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "A <keyword id=\"health\">Vida</keyword> do Companheiro aumenta em <value id=\"quantity_1\">%1$lld</value>%%\nProduza <value id=\"quantity_2\">%2$lld</value> de Comida por Dia"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "夥伴<keyword id=\"health\">生命值</keyword>提高<value id=\"quantity_1\">%1$lld</value>%%\n每天生產<value id=\"quantity_2\">%2$lld</value>食物"}}
      }
