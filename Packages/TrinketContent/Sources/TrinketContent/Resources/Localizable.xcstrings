    "authored.213743323f51ef50": {
      "comment": "Packages/TrinketAppState/Sources/TrinketAppState/Play/Modes/LabyrinthPlayMode.swift: player-facing failure message",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Schließe einen anderen Pfad ab, um diesen Knoten zu erreichen."}},
        "en": {"stringUnit": {"state": "translated", "value": "Clear another path to reach this node."}},
        "es": {"stringUnit": {"state": "translated", "value": "Despeja otro camino para llegar a este nodo."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Terminez un autre chemin pour atteindre ce nœud."}},
        "ja": {"stringUnit": {"state": "translated", "value": "別の道を攻略すると、このマスに到達できます。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "이 지점에 도달하려면 다른 경로를 먼저 돌파하세요."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Conclua outro caminho para alcançar este ponto."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "打通另一條路徑以抵達此節點。"}}
      }
    },
