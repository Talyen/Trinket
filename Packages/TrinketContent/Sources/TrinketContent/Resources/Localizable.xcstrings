    "talents.mana_moth_mana_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: mana_moth_mana_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dein <keyword id=\"block\">Block</keyword> absorbiert <value id=\"quantity_1\">%1$lld</value>%% mehr Schaden, solange du <keyword id=\"mana\">Mana</keyword> hast"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your <keyword id=\"block\">Block</keyword> absorbs <value id=\"quantity_1\">%1$lld</value>%% more damage while you have <keyword id=\"mana\">Mana</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu <keyword id=\"block\">Bloqueo</keyword> absorbe un <value id=\"quantity_1\">%1$lld</value>%% más de daño mientras tienes <keyword id=\"mana\">Maná</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre <keyword id=\"block\">Blocage</keyword> absorbe <value id=\"quantity_1\">%1$lld</value>%% de dégâts en plus tant que vous avez du <keyword id=\"mana\">Mana</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">マナ</keyword>がある間、自分の<keyword id=\"block\">ブロック</keyword>のダメージ吸収量が<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">마나</keyword>가 있으면 내 <keyword id=\"block\">방어도</keyword>의 피해 흡수량 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seu <keyword id=\"block\">Bloqueio</keyword> absorve <value id=\"quantity_1\">%1$lld</value>%% mais dano enquanto você tiver <keyword id=\"mana\">Mana</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "擁有<keyword id=\"mana\">魔力</keyword>時，自身<keyword id=\"block\">格擋</keyword>吸收的傷害增加<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
