    "authored.c5ec2efd91341d6c": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Abilities/AbilityCatalog+Skill.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verursache <value id=\"quantity_1\">%1$lld</value> <keyword id=\"bleed\">Blutungs</keyword>schaden\nDein nächster Angriff erhält <keyword id=\"leech\">Lebensraub</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"bleed\">Bleed</keyword> damage\nYour next attack has <keyword id=\"leech\">Leech</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Infligez <value id=\"quantity_1\">%1$lld</value> dégâts de <keyword id=\"bleed\">Saignement</keyword>\nVotre prochaine attaque bénéficie de <keyword id=\"leech\">Vol de vie</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"bleed\">出血</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える\n次の攻撃に<keyword id=\"leech\">吸収</keyword>を付与"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"bleed\">출혈</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>\n다음 공격에 <keyword id=\"leech\">흡혈</keyword> 부여"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"bleed\">流血</keyword>傷害\n下次攻擊獲得<keyword id=\"leech\">吸血</keyword>"
          }
        }
      }
    },
