          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"poison\">독</keyword> 상태의 적이 받는 <keyword id=\"freeze\">빙결</keyword> 추가 피해 <value id=\"quantity_1\">%1$lld</value>"
          }
