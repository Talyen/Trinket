    "authored.128a299334d9ba34": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Abilities/AbilityCatalog+Skill.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verursache <value id=\"quantity_1\">%1$lld</value> <keyword id=\"holy\">heiligen</keyword> Schaden\n<keyword id=\"purge\">Entzaubere</keyword> <value id=\"quantity_2\">%2$lld</value> Verstärkung des Gegners"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deal <value id=\"quantity_1\">%1$lld</value> <keyword id=\"holy\">Holy</keyword> damage\n<keyword id=\"purge\">Purge</keyword> <value id=\"quantity_2\">%2$lld</value> buff from the enemy"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inflige <value id=\"quantity_1\">%1$lld</value> dégâts de type <keyword id=\"holy\">Sacré</keyword>\n<keyword id=\"purge\">Dissipation</keyword> de <value id=\"quantity_2\">%2$lld</value> bonus de l’ennemi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"holy\">聖</keyword>ダメージを<value id=\"quantity_1\">%1$lld</value>与える\n敵の強化効果を<value id=\"quantity_2\">%2$lld</value>個<keyword id=\"purge\">強化解除</keyword>"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"holy\">신성</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>\n<keyword id=\"purge\">강화 해제</keyword>로 적의 강화 효과 <value id=\"quantity_2\">%2$lld</value>개 제거"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "造成<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"holy\">神聖</keyword>傷害\n<keyword id=\"purge\">驅散</keyword>敵人的<value id=\"quantity_2\">%2$lld</value>項增益效果"
          }
        }
      }
    },
