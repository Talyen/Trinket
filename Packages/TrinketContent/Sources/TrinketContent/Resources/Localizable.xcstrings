    "talents.fox_stun_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: fox_stun_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Betäuben eines Gegners lässt deinen nächsten Angriff kritisch treffen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Stunning an enemy makes your next attack Critically Hit"}},
        "es": {"stringUnit": {"state": "translated", "value": "Aturdir a un enemigo hace que tu siguiente ataque aseste un golpe crítico"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Étourdir un ennemi garantit un coup critique à votre prochaine attaque"}},
        "ja": {"stringUnit": {"state": "translated", "value": "敵をスタン状態にすると、次の攻撃が必ずクリティカルヒット"}},
        "ko": {"stringUnit": {"state": "translated", "value": "적을 기절시키면 다음 공격이 반드시 치명타"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Atordoar um inimigo faz seu próximo ataque acertar um golpe crítico"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "使敵人暈眩後，下次攻擊必定暴擊"}}
      }
    },
    "talents.fox_stun_t4_1.name": {
      "comment": "ContentManifest/talents.tsv: fox_stun_t4_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Gestohlener Donner"}},
        "en": {"stringUnit": {"state": "translated", "value": "Stolen Thunder"}},
        "es": {"stringUnit": {"state": "translated", "value": "Trueno robado"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Tonnerre dérobé"}},
        "ja": {"stringUnit": {"state": "translated", "value": "手柄横取り"}},
        "ko": {"stringUnit": {"state": "translated", "value": "훔친 천둥"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Trovão Roubado"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "搶盡風頭"}}
      }
    },
    "talents.frost_whelp_dodge_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: frost_whelp_dodge_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Oberhalb halber <keyword id=\"health\">Gesundheit</keyword> erhältst du +<value id=\"quantity_1\">%1$lld</value>%% Chance auf <keyword id=\"dodge\">Ausweichen</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Above half <keyword id=\"health\">Health</keyword>, gain +<value id=\"quantity_1\">%1$lld</value>%% <keyword id=\"dodge\">Dodge</keyword> chance"}},
        "es": {"stringUnit": {"state": "translated", "value": "Por encima de la mitad de <keyword id=\"health\">Salud</keyword>, obtén +<value id=\"quantity_1\">%1$lld</value>%% de probabilidad de <keyword id=\"dodge\">Evasión</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Au-dessus de la moitié de votre <keyword id=\"health\">Santé</keyword>, gagnez +<value id=\"quantity_1\">%1$lld</value>%% de chances d’<keyword id=\"dodge\">Esquive</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>が半分を超えている間、<keyword id=\"dodge\">回避</keyword>率が<value id=\"quantity_1\">%1$lld</value>%%上昇"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword>이 절반 초과이면 <keyword id=\"dodge\">회피</keyword> 확률 +<value id=\"quantity_1\">%1$lld</value>%%"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Acima de metade da <keyword id=\"health\">Vida</keyword>, ganhe +<value id=\"quantity_1\">%1$lld</value>%% de chance de <keyword id=\"dodge\">Esquiva</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">生命值</keyword>高於一半時，<keyword id=\"dodge\">閃避</keyword>機率提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.frost_whelp_dodge_t1_1.name": {
      "comment": "ContentManifest/talents.tsv: frost_whelp_dodge_t1_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Große Höhe"}},
        "en": {"stringUnit": {"state": "translated", "value": "High Altitude"}},
        "es": {"stringUnit": {"state": "translated", "value": "Gran altitud"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Haute altitude"}},
        "ja": {"stringUnit": {"state": "translated", "value": "高高度"}},
        "ko": {"stringUnit": {"state": "translated", "value": "높은 고도"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Grande Altitude"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "高空"}}
      }
    },
    "talents.frost_whelp_dodge_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: frost_whelp_dodge_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dein erstes <keyword id=\"dodge\">Ausweichen</keyword> in jedem Kampf lässt deinen Verbündeten eine Karte ziehen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your first <keyword id=\"dodge\">Dodge</keyword> each combat draws a card for your ally"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu primera <keyword id=\"dodge\">Evasión</keyword> de cada combate hace que tu aliado robe una carta"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre première <keyword id=\"dodge\">Esquive</keyword> de chaque combat fait piocher une carte à votre allié"}},
        "ja": {"stringUnit": {"state": "translated", "value": "各戦闘で最初の<keyword id=\"dodge\">回避</keyword>で、味方がカードを1枚引く"}},
        "ko": {"stringUnit": {"state": "translated", "value": "매 전투 첫 <keyword id=\"dodge\">회피</keyword> 시 아군이 카드 한 장 뽑기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Sua primeira <keyword id=\"dodge\">Esquiva</keyword> de cada combate faz seu aliado comprar uma carta"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每場戰鬥首次<keyword id=\"dodge\">閃避</keyword>時，友方抽一張牌"}}
      }
    },
    "talents.frost_whelp_dodge_t1_2.name": {
      "comment": "ContentManifest/talents.tsv: frost_whelp_dodge_t1_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Rückenwind"}},
        "en": {"stringUnit": {"state": "translated", "value": "Tailwind"}},
        "es": {"stringUnit": {"state": "translated", "value": "Viento a favor"}},
