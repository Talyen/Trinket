        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dégâts d’<keyword id=\"stun\">Étourdissement</keyword> subis réduits de <value id=\"quantity_1\">%1$lld</value>%%"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
