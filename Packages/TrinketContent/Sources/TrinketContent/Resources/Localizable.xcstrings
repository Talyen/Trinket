    "talents.knight_stun_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: knight_stun_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wenn <keyword id=\"stun\">Betäubung</keyword> endet, ziehe eine Karte"}},
        "en": {"stringUnit": {"state": "translated", "value": "When <keyword id=\"stun\">Stun</keyword> ends, draw a card"}},
        "es": {"stringUnit": {"state": "translated", "value": "Cuando termina <keyword id=\"stun\">Aturdimiento</keyword>, roba una carta"}},
        "fr": {"stringUnit": {"state": "translated", "value": "À la fin de l’<keyword id=\"stun\">Étourdissement</keyword>, piochez une carte"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">スタン</keyword>が終了すると、カードを1枚引く"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">기절</keyword> 종료 시 카드 한 장 뽑기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Quando <keyword id=\"stun\">Atordoamento</keyword> terminar, compre uma carta"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">暈眩</keyword>結束時，抽一張牌"}}
      }
    },
