    "affixes.rimed.astral_description": {
      "comment": "ContentManifest/affixes.tsv: rimed, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erleide <value id=\"quantity_1\">%1$lld</value>%% weniger <keyword id=\"freeze\">Frost</keyword>schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Take <value id=\"quantity_1\">%1$lld</value>%% less <keyword id=\"freeze\">Freeze</keyword> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Recibe un <value id=\"quantity_1\">%1$lld</value>%% menos de daño de <keyword id=\"freeze\">Congelación</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Dégâts de <keyword id=\"freeze\">Gel</keyword> subis réduits de <value id=\"quantity_1\">%1$lld</value>%%"}},
        "ja": {"stringUnit": {"state": "translated", "value": "受ける<keyword id=\"freeze\">凍結</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%減少"}},
        "ko": {"stringUnit": {"state": "translated", "value": "받는 <keyword id=\"freeze\">빙결</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>%% 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Receba <value id=\"quantity_1\">%1$lld</value>%% menos dano de <keyword id=\"freeze\">Congelamento</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "承受的<keyword id=\"freeze\">冰凍</keyword>傷害降低<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
