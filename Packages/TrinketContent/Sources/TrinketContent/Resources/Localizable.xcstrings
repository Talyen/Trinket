    "talents.fox_dodge_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: fox_dodge_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"dodge\">Weiche</keyword> dem ersten Angriff gegen dich in jedem Kampf aus"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"dodge\">Dodge</keyword> the first attack against you each combat"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"dodge\">Esquive</keyword> de la première attaque qui vous vise à chaque combat"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各戦闘で自分への最初の攻撃を<keyword id=\"dodge\">回避</keyword>"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매 전투 자신을 향한 첫 공격을 <keyword id=\"dodge\">회피</keyword>"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每場戰鬥<keyword id=\"dodge\">閃避</keyword>首次針對自身的攻擊"
          }
        }
      }
    },
