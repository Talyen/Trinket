    "homestead_nodes.wishingwell.1.bonus_description": {
      "comment": "ContentManifest/homestead_nodes.tsv: wishingWell.1, bonus_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde <value id=\"quantity_1\">%1$lld</value>%% mehr <keyword id=\"gold\">Gold</keyword>\nProduziere <value id=\"quantity_2\">%2$lld</value> <keyword id=\"gold\">Gold</keyword> pro Tag"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find <value id=\"quantity_1\">%1$lld</value>%% more <keyword id=\"gold\">Gold</keyword>\nProduce <value id=\"quantity_2\">%2$lld</value> <keyword id=\"gold\">Gold</keyword> per Day"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez <value id=\"quantity_1\">%1$lld</value>%% d’<keyword id=\"gold\">Or</keyword> en plus\nProduit <value id=\"quantity_2\">%2$lld</value> <keyword id=\"gold\">Or</keyword> par jour"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"gold\">ゴールド</keyword>の発見量が<value id=\"quantity_1\">%1$lld</value>%%増加\n1日に<keyword id=\"gold\">ゴールド</keyword>を<value id=\"quantity_2\">%2$lld</value>生産"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"gold\">골드</keyword> 발견량 <value id=\"quantity_1\">%1$lld</value>%% 증가\n하루에 <keyword id=\"gold\">골드</keyword> <value id=\"quantity_2\">%2$lld</value> 생산"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發現的<keyword id=\"gold\">金幣</keyword>增加<value id=\"quantity_1\">%1$lld</value>%%\n每天生產<value id=\"quantity_2\">%2$lld</value><keyword id=\"gold\">金幣</keyword>"
          }
        }
      }
    },
