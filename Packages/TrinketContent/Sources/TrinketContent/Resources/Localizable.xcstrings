      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Kritische <keyword id=\"freeze\">Frost</keyword>-Treffer verursachen <value id=\"quantity_1\">%1$lld</value>%% mehr Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">Freeze</keyword> Critical Hits deal <value id=\"quantity_1\">%1$lld</value>%% more damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los golpes críticos de <keyword id=\"freeze\">Congelación</keyword> infligen un <value id=\"quantity_1\">%1$lld</value>%% más de daño"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les coups critiques de <keyword id=\"freeze\">Gel</keyword> infligent <value id=\"quantity_1\">%1$lld</value>%% de dégâts en plus"}},
