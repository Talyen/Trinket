    "homestead_nodes.archeryrange.1.summary": {
      "comment": "ContentManifest/homestead_nodes.tsv: archeryRange.1, summary",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ferne Zielscheiben und Befiederungsbänke für treffsichere Fernschüsse"}},
        "en": {"stringUnit": {"state": "translated", "value": "Distance butts and fletching benches for long-range marksmanship"}},
        "es": {"stringUnit": {"state": "translated", "value": "Blancos a distancia y bancos de emplumado para la puntería de largo alcance"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Des cibles lointaines et des établis d’empennage pour le tir de précision à distance"}},
        "ja": {"stringUnit": {"state": "translated", "value": "遠距離射撃を鍛える遠的と矢作りの作業台"}},
        "ko": {"stringUnit": {"state": "translated", "value": "원거리 사격술을 연마하는 장거리 과녁과 화살 제작대"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Alvos distantes e bancadas de flechamento para a pontaria de longo alcance"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "設有遠距箭靶與製箭工作檯，精進長程射術"}}
      }
    },
