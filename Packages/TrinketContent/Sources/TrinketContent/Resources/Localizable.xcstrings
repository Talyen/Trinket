    "talents.library_owl_cleanse_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: library_owl_cleanse_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dein erstes erfolgreiches <keyword id=\"cleanse\">Reinigen</keyword> in jedem Zug reinigt auch deinen Verbündeten"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your first successful <keyword id=\"cleanse\">Cleanse</keyword> each turn also Cleanses your ally"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu primera <keyword id=\"cleanse\">Purificación</keyword> exitosa de cada turno también purifica a tu aliado"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre première <keyword id=\"cleanse\">Purification</keyword> réussie de chaque tour purifie aussi votre allié"}},
        "ja": {"stringUnit": {"state": "translated", "value": "各ターンで初めて<keyword id=\"cleanse\">浄化</keyword>に成功すると、味方も浄化"}},
        "ko": {"stringUnit": {"state": "translated", "value": "매 턴 첫 <keyword id=\"cleanse\">정화</keyword> 성공 시 아군도 정화"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Sua primeira <keyword id=\"cleanse\">Purificação</keyword> bem-sucedida de cada turno também Purifica seu aliado"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每回合首次成功<keyword id=\"cleanse\">淨化</keyword>時，也會淨化友方"}}
      }
    },
    "talents.library_owl_cleanse_t2_2.name": {
