      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Kritische <keyword id=\"freeze\">Frost</keyword>-Treffer verdoppeln den <keyword id=\"freeze\">Frost</keyword>-Aufbau"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">Freeze</keyword> Critical Hits double <keyword id=\"freeze\">Freeze</keyword> build-up"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los golpes críticos de <keyword id=\"freeze\">Congelación</keyword> duplican la acumulación de <keyword id=\"freeze\">Congelación</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les coups critiques de <keyword id=\"freeze\">Gel</keyword> doublent l’accumulation de <keyword id=\"freeze\">Gel</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">凍結</keyword>クリティカルヒットで<keyword id=\"freeze\">凍結</keyword>蓄積量が2倍になる"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">빙결</keyword> 치명타의 <keyword id=\"freeze\">빙결</keyword> 축적량이 두 배"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Golpes críticos de <keyword id=\"freeze\">Congelamento</keyword> dobram o acúmulo de <keyword id=\"freeze\">Congelamento</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">冰凍</keyword>暴擊使<keyword id=\"freeze\">冰凍</keyword>累積量加倍"}}
