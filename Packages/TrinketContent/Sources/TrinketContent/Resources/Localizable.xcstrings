        "de": {"stringUnit": {"state": "translated", "value": "Hainreserve"}},
        "en": {"stringUnit": {"state": "translated", "value": "Grove Reserve"}},
        "es": {"stringUnit": {"state": "translated", "value": "Reserva de la arboleda"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Réserve du bosquet"}},
        "ja": {"stringUnit": {"state": "translated", "value": "木立の備え"}},
        "ko": {"stringUnit": {"state": "translated", "value": "숲의 비축"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Reserva do Bosque"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "林地儲備"}}
      }
    },
    "talents.druid_mana_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: druid_mana_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Überschüssig wiederhergestelltes <keyword id=\"mana\">Mana</keyword> wird in <keyword id=\"thorns\">Dornen</keyword> umgewandelt"}},
        "en": {"stringUnit": {"state": "translated", "value": "Excess <keyword id=\"mana\">Mana</keyword> restored is converted into <keyword id=\"thorns\">Thorns</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "El exceso de <keyword id=\"mana\">Maná</keyword> restaurado se convierte en <keyword id=\"thorns\">Espinas</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le <keyword id=\"mana\">Mana</keyword> restauré en excès est converti en <keyword id=\"thorns\">Épines</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "過剰に回復した<keyword id=\"mana\">マナ</keyword>を<keyword id=\"thorns\">棘</keyword>に変換"}},
        "ko": {"stringUnit": {"state": "translated", "value": "초과 <keyword id=\"mana\">마나</keyword> 회복량을 <keyword id=\"thorns\">가시</keyword>로 전환"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "A <keyword id=\"mana\">Mana</keyword> restaurada em excesso é convertida em <keyword id=\"thorns\">Espinhos</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "過量恢復的<keyword id=\"mana\">魔力</keyword>轉化為<keyword id=\"thorns\">荊棘</keyword>"}}
      }
    },
    "talents.druid_mana_t2_2.name": {
      "comment": "ContentManifest/talents.tsv: druid_mana_t2_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Lebender Kanal"}},
        "en": {"stringUnit": {"state": "translated", "value": "Living Conduit"}},
        "es": {"stringUnit": {"state": "translated", "value": "Conducto viviente"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Conduit vivant"}},
        "ja": {"stringUnit": {"state": "translated", "value": "生ける導管"}},
        "ko": {"stringUnit": {"state": "translated", "value": "살아 있는 도관"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Condutor Vivo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "活體導管"}}
      }
    },
    "talents.druid_mana_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: druid_mana_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verstärken mit <keyword id=\"mana\">Mana</keyword> fügt dem nächsten Angriff deines Gefährten <value id=\"quantity_1\">%1$lld</value> Schaden hinzu"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">Mana</keyword> empowerment adds <value id=\"quantity_1\">%1$lld</value> damage to your Companion’s next attack"}},
        "es": {"stringUnit": {"state": "translated", "value": "Potenciar con <keyword id=\"mana\">Maná</keyword> añade <value id=\"quantity_1\">%1$lld</value> de daño al siguiente ataque de tu compañero"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Un renforcement au <keyword id=\"mana\">Mana</keyword> ajoute <value id=\"quantity_1\">%1$lld</value> dégâts à la prochaine attaque de votre Compagnon"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">マナ</keyword>で強化すると、仲間の次の攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">마나</keyword>로 강화 시 동료의 다음 공격 피해 <value id=\"quantity_1\">%1$lld</value> 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Fortalecer com <keyword id=\"mana\">Mana</keyword> adiciona <value id=\"quantity_1\">%1$lld</value> de dano ao próximo ataque do seu Companheiro"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "以<keyword id=\"mana\">魔力</keyword>強化時，夥伴下次攻擊的傷害增加<value id=\"quantity_1\">%1$lld</value>點"}}
      }
    },
    "talents.druid_mana_t3_1.name": {
      "comment": "ContentManifest/talents.tsv: druid_mana_t3_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Geteilter Strom"}},
        "en": {"stringUnit": {"state": "translated", "value": "Shared Current"}},
        "es": {"stringUnit": {"state": "translated", "value": "Corriente compartida"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Courant partagé"}},
        "ja": {"stringUnit": {"state": "translated", "value": "分かち合う流れ"}},
        "ko": {"stringUnit": {"state": "translated", "value": "공유하는 흐름"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Corrente Compartilhada"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "共享流動"}}
      }
    },
    "talents.druid_mana_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: druid_mana_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Stelle <value id=\"quantity_1\">%1$lld</value> zusätzliches <keyword id=\"mana\">Mana</keyword> wieder her, solange du <keyword id=\"thorns\">Dornen</keyword> hast"}},
        "en": {"stringUnit": {"state": "translated", "value": "Restore <value id=\"quantity_1\">%1$lld</value> additional <keyword id=\"mana\">Mana</keyword> while you have <keyword id=\"thorns\">Thorns</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Restaura <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"mana\">Maná</keyword> adicional mientras tienes <keyword id=\"thorns\">Espinas</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Restaurez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword> de plus tant que vous avez des <keyword id=\"thorns\">Épines</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"thorns\">棘</keyword>がある間、<keyword id=\"mana\">マナ</keyword>回復量が<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"thorns\">가시</keyword>가 있으면 <keyword id=\"mana\">마나</keyword> <value id=\"quantity_1\">%1$lld</value> 추가 회복"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Restaure <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"mana\">Mana</keyword> adicional enquanto tiver <keyword id=\"thorns\">Espinhos</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "擁有<keyword id=\"thorns\">荊棘</keyword>時，額外恢復<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"mana\">魔力</keyword>"}}
      }
    },
    "talents.druid_mana_t3_2.name": {
      "comment": "ContentManifest/talents.tsv: druid_mana_t3_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Tiefe Wurzeln"}},
        "en": {"stringUnit": {"state": "translated", "value": "Deep Roots"}},
        "es": {"stringUnit": {"state": "translated", "value": "Raíces profundas"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Racines profondes"}},
        "ja": {"stringUnit": {"state": "translated", "value": "深き根"}},
        "ko": {"stringUnit": {"state": "translated", "value": "깊은 뿌리"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Raízes Profundas"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "深根"}}
      }
    },
    "talents.druid_mana_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: druid_mana_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wenn beide Verbündeten im selben Zug <keyword id=\"mana\">Mana</keyword> ausgeben, erhält jeder <value id=\"quantity_1\">%1$lld</value> <keyword id=\"thorns\">Dornen</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Both allies spending <keyword id=\"mana\">Mana</keyword> in the same turn grants each <value id=\"quantity_1\">%1$lld</value> <keyword id=\"thorns\">Thorns</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Si ambos aliados gastan <keyword id=\"mana\">Maná</keyword> en el mismo turno, cada uno obtiene <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"thorns\">Espinas</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Si les deux alliés dépensent du <keyword id=\"mana\">Mana</keyword> au même tour, chacun gagne <value id=\"quantity_1\">%1$lld</value> <keyword id=\"thorns\">Épines</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "同じターンに味方2人が<keyword id=\"mana\">マナ</keyword>を消費すると、それぞれ<keyword id=\"thorns\">棘</keyword>を<value id=\"quantity_1\">%1$lld</value>獲得"}},
        "ko": {"stringUnit": {"state": "translated", "value": "두 아군이 같은 턴에 <keyword id=\"mana\">마나</keyword>를 소모하면 각각 <keyword id=\"thorns\">가시</keyword> <value id=\"quantity_1\">%1$lld</value> 획득"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Se ambos os aliados gastarem <keyword id=\"mana\">Mana</keyword> no mesmo turno, cada um ganha <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"thorns\">Espinhos</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "同回合兩名友方都消耗<keyword id=\"mana\">魔力</keyword>時，各獲得<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"thorns\">荊棘</keyword>"}}
      }
    },
    "talents.druid_mana_t4_1.name": {
      "comment": "ContentManifest/talents.tsv: druid_mana_t4_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Hainpakt"}},
        "en": {"stringUnit": {"state": "translated", "value": "Grove Accord"}},
        "es": {"stringUnit": {"state": "translated", "value": "Acuerdo de la arboleda"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Accord du bosquet"}},
        "ja": {"stringUnit": {"state": "translated", "value": "木立の盟約"}},
        "ko": {"stringUnit": {"state": "translated", "value": "숲의 협약"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Acordo do Bosque"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "林地協約"}}
      }
    },
    "talents.druid_poison_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: druid_poison_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Vergiftete</keyword> Gegner erleiden <value id=\"quantity_1\">%1$lld</value>%% mehr <keyword id=\"thorns\">Dornen</keyword>schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Poisoned</keyword> enemies take <value id=\"quantity_1\">%1$lld</value>%% increased <keyword id=\"thorns\">Thorns</keyword> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los enemigos <keyword id=\"poison\">envenenados</keyword> reciben un <value id=\"quantity_1\">%1$lld</value>%% más de daño de <keyword id=\"thorns\">Espinas</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les ennemis sous <keyword id=\"poison\">Poison</keyword> subissent <value id=\"quantity_1\">%1$lld</value>%% de dégâts d’<keyword id=\"thorns\">Épines</keyword> en plus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">毒</keyword>状態の敵が受ける<keyword id=\"thorns\">棘</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">독</keyword> 상태의 적이 받는 <keyword id=\"thorns\">가시</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Inimigos <keyword id=\"poison\">Envenenados</keyword> recebem <value id=\"quantity_1\">%1$lld</value>%% mais dano de <keyword id=\"thorns\">Espinhos</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">中毒</keyword>的敵人承受的<keyword id=\"thorns\">荊棘</keyword>傷害增加<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.druid_poison_t1_1.name": {
      "comment": "ContentManifest/talents.tsv: druid_poison_t1_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Stachelsporen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Barbed Spores"}},
        "es": {"stringUnit": {"state": "translated", "value": "Esporas espinosas"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Spores barbelées"}},
        "ja": {"stringUnit": {"state": "translated", "value": "棘の胞子"}},
        "ko": {"stringUnit": {"state": "translated", "value": "가시 포자"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Esporos Farpados"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "倒刺孢子"}}
      }
    },
    "talents.druid_poison_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: druid_poison_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erleide halben <keyword id=\"poison\">Gift</keyword>schaden, solange du <keyword id=\"thorns\">Dornen</keyword> hast"}},
        "en": {"stringUnit": {"state": "translated", "value": "Take half <keyword id=\"poison\">Poison</keyword> damage while you have <keyword id=\"thorns\">Thorns</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Recibe la mitad de daño de <keyword id=\"poison\">Veneno</keyword> mientras tienes <keyword id=\"thorns\">Espinas</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Subissez la moitié des dégâts de <keyword id=\"poison\">Poison</keyword> tant que vous avez des <keyword id=\"thorns\">Épines</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"thorns\">棘</keyword>がある間、受ける<keyword id=\"poison\">毒</keyword>ダメージが半減"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"thorns\">가시</keyword>가 있으면 받는 <keyword id=\"poison\">독</keyword> 피해가 절반으로 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Receba metade do dano de <keyword id=\"poison\">Veneno</keyword> enquanto tiver <keyword id=\"thorns\">Espinhos</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "擁有<keyword id=\"thorns\">荊棘</keyword>時，承受的<keyword id=\"poison\">中毒</keyword>傷害減半"}}
      }
    },
    "talents.druid_poison_t1_2.name": {
      "comment": "ContentManifest/talents.tsv: druid_poison_t1_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Lebende Rinde"}},
        "en": {"stringUnit": {"state": "translated", "value": "Living Bark"}},
        "es": {"stringUnit": {"state": "translated", "value": "Corteza viviente"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Écorce vivante"}},
        "ja": {"stringUnit": {"state": "translated", "value": "生ける樹皮"}},
        "ko": {"stringUnit": {"state": "translated", "value": "살아 있는 나무껍질"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Casca Viva"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "活體樹皮"}}
      }
    },
    "talents.druid_poison_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: druid_poison_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Vergiftete</keyword> Gegner erleiden <value id=\"quantity_1\">%1$lld</value> zusätzlichen <keyword id=\"freeze\">Frost</keyword>schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">Poisoned</keyword> enemies take <value id=\"quantity_1\">%1$lld</value> additional <keyword id=\"freeze\">Freeze</keyword> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los enemigos <keyword id=\"poison\">envenenados</keyword> reciben <value id=\"quantity_1\">%1$lld</value> de daño adicional de <keyword id=\"freeze\">Congelación</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les ennemis sous <keyword id=\"poison\">Poison</keyword> subissent <value id=\"quantity_1\">%1$lld</value> dégâts de <keyword id=\"freeze\">Gel</keyword> supplémentaires"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">毒</keyword>状態の敵が受ける<keyword id=\"freeze\">凍結</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">독</keyword> 상태의 적이 받는 <keyword id=\"freeze\">빙결</keyword> 추가 피해 <value id=\"quantity_1\">%1$lld</value>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Inimigos <keyword id=\"poison\">Envenenados</keyword> recebem <value id=\"quantity_1\">%1$lld</value> de dano de <keyword id=\"freeze\">Congelamento</keyword> adicional"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"poison\">中毒</keyword>的敵人額外承受<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"freeze\">冰凍</keyword>傷害"}}
      }
    },
    "talents.druid_poison_t2_1.name": {
      "comment": "ContentManifest/talents.tsv: druid_poison_t2_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Kühles Moos"}},
        "en": {"stringUnit": {"state": "translated", "value": "Cool Moss"}},
        "es": {"stringUnit": {"state": "translated", "value": "Musgo fresco"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Mousse fraîche"}},
        "ja": {"stringUnit": {"state": "translated", "value": "冷たい苔"}},
        "ko": {"stringUnit": {"state": "translated", "value": "차가운 이끼"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Musgo Frio"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "清涼青苔"}}
      }
