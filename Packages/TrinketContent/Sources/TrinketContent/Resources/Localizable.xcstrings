    "talents.alchemist_cleanse_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: alchemist_cleanse_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Reinigen des letzten Schwächungseffekts eines Verbündeten lässt dich eine Karte ziehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleansing an ally’s last debuff draws a card"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Purifier le dernier malus d’un allié fait piocher une carte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "味方の最後の弱体効果を浄化すると、カードを1枚引く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아군의 마지막 약화 효과 정화 시 카드 한 장 뽑기"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "淨化友方最後一項減益效果時，抽一張牌"
          }
        }
      }
    },
