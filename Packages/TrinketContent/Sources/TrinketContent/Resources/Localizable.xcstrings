    "talents.bear_block_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: bear_block_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange du <keyword id=\"block\">Block</keyword> hast, wird <keyword id=\"bleed\">Blutungs</keyword>schaden halbiert"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While you have <keyword id=\"block\">Block</keyword>, <keyword id=\"bleed\">Bleed</keyword> damage is halved"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que vous avez du <keyword id=\"block\">Blocage</keyword>, les dégâts de <keyword id=\"bleed\">Saignement</keyword> subis sont réduits de moitié"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"block\">ブロック</keyword>がある間、受ける<keyword id=\"bleed\">出血</keyword>ダメージが半減"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"block\">방어도</keyword>가 있으면 받는 <keyword id=\"bleed\">출혈</keyword> 피해가 절반으로 감소"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擁有<keyword id=\"block\">格擋</keyword>時，承受的<keyword id=\"bleed\">流血</keyword>傷害減半"
          }
        }
      }
    },
