    "talents.alchemist_cleanse_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: alchemist_cleanse_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ziehe eine Karte, wenn du <keyword id=\"cleanse\">reinigst</keyword>,\nwährend du kein <keyword id=\"mana\">Mana</keyword> hast"}},
        "en": {"stringUnit": {"state": "translated", "value": "Draw a card when you <keyword id=\"cleanse\">Cleanse</keyword>\nwhile out of <keyword id=\"mana\">Mana</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Roba una carta cuando usas <keyword id=\"cleanse\">Purificación</keyword>\nmientras no tienes <keyword id=\"mana\">Maná</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Piochez une carte lors d’une <keyword id=\"cleanse\">Purification</keyword>\nsi vous n’avez plus de <keyword id=\"mana\">Mana</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">マナ</keyword>がない状態で<keyword id=\"cleanse\">浄化</keyword>すると\nカードを1枚引く"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">마나</keyword>가 없을 때 <keyword id=\"cleanse\">정화</keyword>하면\n카드 한 장 뽑기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Compre uma carta ao <keyword id=\"cleanse\">Purificar</keyword>\nenquanto estiver sem <keyword id=\"mana\">Mana</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "沒有<keyword id=\"mana\">魔力</keyword>時\n<keyword id=\"cleanse\">淨化</keyword>會抽一張牌"}}
      }
    },
    "talents.alchemist_cleanse_t3_1.name": {
      "comment": "ContentManifest/talents.tsv: alchemist_cleanse_t3_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Klarer Geist"}},
        "en": {"stringUnit": {"state": "translated", "value": "Clear Mind"}},
        "es": {"stringUnit": {"state": "translated", "value": "Mente despejada"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Esprit limpide"}},
        "ja": {"stringUnit": {"state": "translated", "value": "澄んだ心"}},
        "ko": {"stringUnit": {"state": "translated", "value": "맑은 마음"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Mente Clara"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "清明心智"}}
      }
    },
    "talents.alchemist_cleanse_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: alchemist_cleanse_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Reinigen des letzten Schwächungseffekts eines Verbündeten lässt dich eine Karte ziehen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Cleansing an ally’s last debuff draws a card"}},
        "es": {"stringUnit": {"state": "translated", "value": "Purificar el último perjuicio de un aliado hace que robes una carta"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Purifier le dernier malus d’un allié fait piocher une carte"}},
        "ja": {"stringUnit": {"state": "translated", "value": "味方の最後の弱体効果を浄化すると、カードを1枚引く"}},
        "ko": {"stringUnit": {"state": "translated", "value": "아군의 마지막 약화 효과 정화 시 카드 한 장 뽑기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Purificar o último efeito negativo de um aliado faz você comprar uma carta"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "淨化友方最後一項減益效果時，抽一張牌"}}
      }
    },
    "talents.alchemist_cleanse_t3_2.name": {
      "comment": "ContentManifest/talents.tsv: alchemist_cleanse_t3_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Sauberer Schnitt"}},
        "en": {"stringUnit": {"state": "translated", "value": "Clean Break"}},
        "es": {"stringUnit": {"state": "translated", "value": "Ruptura limpia"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Rupture nette"}},
        "ja": {"stringUnit": {"state": "translated", "value": "完全な解放"}},
        "ko": {"stringUnit": {"state": "translated", "value": "깔끔한 해결"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ruptura Limpa"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "徹底擺脫"}}
      }
    },
    "talents.alchemist_cleanse_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: alchemist_cleanse_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Reinigen von Schwächungseffekten verhindert neue Schwächungseffekte bis zu deinem nächsten Zug"}},
        "en": {"stringUnit": {"state": "translated", "value": "Cleansing debuffs prevents new debuffs until your next turn"}},
        "es": {"stringUnit": {"state": "translated", "value": "Purificar perjuicios impide nuevos perjuicios hasta tu siguiente turno"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Purifier des malus empêche les nouveaux malus jusqu’à votre prochain tour"}},
        "ja": {"stringUnit": {"state": "translated", "value": "弱体効果を浄化すると、次の自分のターンまで新たな弱体効果を防ぐ"}},
        "ko": {"stringUnit": {"state": "translated", "value": "약화 효과 정화 시 다음 내 턴까지 새로운 약화 효과 방지"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Purificar efeitos negativos impede novos efeitos negativos até seu próximo turno"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "淨化減益效果後，防止新減益效果，直到下個自身回合"}}
      }
    },
    "talents.alchemist_cleanse_t4_1.name": {
      "comment": "ContentManifest/talents.tsv: alchemist_cleanse_t4_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Vollkommene Reinheit"}},
        "en": {"stringUnit": {"state": "translated", "value": "Perfect Purity"}},
        "es": {"stringUnit": {"state": "translated", "value": "Pureza perfecta"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Pureté parfaite"}},
        "ja": {"stringUnit": {"state": "translated", "value": "完全なる清浄"}},
        "ko": {"stringUnit": {"state": "translated", "value": "완벽한 순수"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Pureza Perfeita"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "完美純淨"}}
      }
    },
    "talents.alchemist_health_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: alchemist_health_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verbündete unter halber <keyword id=\"health\">Gesundheit</keyword> stellen <value id=\"quantity_1\">%1$lld</value> zusätzliche <keyword id=\"health\">Gesundheit</keyword> wieder her"}},
        "en": {"stringUnit": {"state": "translated", "value": "Allies below half <keyword id=\"health\">Health</keyword> restore <value id=\"quantity_1\">%1$lld</value> additional <keyword id=\"health\">Health</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los aliados por debajo de la mitad de <keyword id=\"health\">Salud</keyword> restauran <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Salud</keyword> adicional"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les alliés sous la moitié de leur <keyword id=\"health\">Santé</keyword> restaurent <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Santé</keyword> de plus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>が半分未満の味方の<keyword id=\"health\">体力</keyword>回復量が<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword>이 절반 미만인 아군의 <keyword id=\"health\">체력</keyword> <value id=\"quantity_1\">%1$lld</value> 추가 회복"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Aliados abaixo de metade da <keyword id=\"health\">Vida</keyword> restauram <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"health\">Vida</keyword> adicional"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">生命值</keyword>低於一半的友方額外恢復<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"health\">生命值</keyword>"}}
      }
    },
    "talents.alchemist_health_t1_1.name": {
      "comment": "ContentManifest/talents.tsv: alchemist_health_t1_1, name",
