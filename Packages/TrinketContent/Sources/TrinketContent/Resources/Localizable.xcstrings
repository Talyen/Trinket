    "authored.0dcca8be276ca533": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog+Offhand.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">Brand</keyword>schaden, <keyword id=\"freeze\">Frost</keyword>schaden oder <keyword id=\"holy\">heiliger</keyword> Schaden stellt mit <value id=\"quantity_1\">%1$lld</value>%% Chance <value id=\"quantity_2\">%2$lld</value> <keyword id=\"mana\">Mana</keyword> des Trägers wieder her"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">Burn</keyword>, <keyword id=\"freeze\">Freeze</keyword>, or <keyword id=\"holy\">Holy</keyword> damage has a <value id=\"quantity_1\">%1$lld</value>%% chance to restore <value id=\"quantity_2\">%2$lld</value> <keyword id=\"mana\">Mana</keyword> to the wearer"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dégâts de <keyword id=\"burn\">Brûlure</keyword>, de <keyword id=\"freeze\">Gel</keyword> ou de type <keyword id=\"holy\">Sacré</keyword> ont <value id=\"quantity_1\">%1$lld</value>%% de chances de restaurer <value id=\"quantity_2\">%2$lld</value> <keyword id=\"mana\">Mana</keyword> au porteur"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">炎上</keyword>、<keyword id=\"freeze\">凍結</keyword>、<keyword id=\"holy\">聖</keyword>ダメージを与えると<value id=\"quantity_1\">%1$lld</value>%%の確率で装備者の<keyword id=\"mana\">マナ</keyword>を<value id=\"quantity_2\">%2$lld</value>回復"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">화상</keyword>, <keyword id=\"freeze\">빙결</keyword> 또는 <keyword id=\"holy\">신성</keyword> 피해를 주면 <value id=\"quantity_1\">%1$lld</value>%% 확률로 착용자의 <keyword id=\"mana\">마나</keyword> <value id=\"quantity_2\">%2$lld</value> 회복"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"burn\">燃燒</keyword>、<keyword id=\"freeze\">冰凍</keyword>或<keyword id=\"holy\">神聖</keyword>傷害有<value id=\"quantity_1\">%1$lld</value>%%機率為穿戴者恢復<value id=\"quantity_2\">%2$lld</value>點<keyword id=\"mana\">魔力</keyword>"
          }
        }
      }
    },
    "authored.0dea24121c57dcff": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Encounters/Mystery/MysteryEventPool+Events.swift: narrative",
