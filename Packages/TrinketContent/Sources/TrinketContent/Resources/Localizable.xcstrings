    "homestead_nodes.blacksmithforge.1.summary": {
      "comment": "ContentManifest/homestead_nodes.tsv: blacksmithForge.1, summary",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine betriebsame Schmiede für Beschläge, Waffen und stärkere Bauwerke"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A working forge for hardware, weapons, and stronger construction"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une forge en activité pour les ferrures, les armes et des constructions plus solides"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "金具や武器、より頑丈な建材を作る稼働中の鍛冶場"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "철물과 무기를 만들고 건물을 튼튼하게 하는 작업 대장간"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打造五金、武器與堅固建材的鍛造坊"
          }
        }
      }
    },
