    "affixes.ironbriar.astral_description": {
      "comment": "ContentManifest/affixes.tsv: ironbriar, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erhalte jeden Zug <value id=\"quantity_1\">%1$lld</value> <keyword id=\"thorns\">Dornen</keyword>, wenn du <keyword id=\"block\">Block</keyword> behältst"}},
        "en": {"stringUnit": {"state": "translated", "value": "Gain <value id=\"quantity_1\">%1$lld</value> <keyword id=\"thorns\">Thorns</keyword> each turn you retain <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Obtén <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"thorns\">Espinas</keyword> cada turno que conservas <keyword id=\"block\">Bloqueo</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Gagnez <value id=\"quantity_1\">%1$lld</value> <keyword id=\"thorns\">Épines</keyword> à chaque tour où vous conservez du <keyword id=\"block\">Blocage</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">ブロック</keyword>を維持している各ターンに<keyword id=\"thorns\">棘</keyword>を<value id=\"quantity_1\">%1$lld</value>獲得"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">방어도</keyword>를 유지하는 턴마다 <keyword id=\"thorns\">가시</keyword> <value id=\"quantity_1\">%1$lld</value> 획득"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ganhe <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"thorns\">Espinhos</keyword> a cada turno em que mantiver <keyword id=\"block\">Bloqueio</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每個保有<keyword id=\"block\">格擋</keyword>的回合獲得<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"thorns\">荊棘</keyword>"}}
      }
    },
