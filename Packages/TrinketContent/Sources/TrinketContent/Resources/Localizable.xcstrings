        "ja": {"stringUnit": {"state": "translated", "value": "回避すると、次の攻撃が敵の<keyword id=\"block\">ブロック</keyword>を無視"}},
        "ko": {"stringUnit": {"state": "translated", "value": "회피 시 다음 공격이 적의 <keyword id=\"block\">방어도</keyword> 무시"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Esquivar faz seu próximo ataque ignorar o <keyword id=\"block\">Bloqueio</keyword> inimigo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "閃避後，下次攻擊無視敵人<keyword id=\"block\">格擋</keyword>"}}
      }
    },
