    "talents.alchemist_poison_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: alchemist_poison_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dein <keyword id=\"poison\">Gift</keyword> von selbst endet, stelle <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword> wieder her"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your <keyword id=\"poison\">Poison</keyword> naturally expiring restores <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fin naturelle de votre <keyword id=\"poison\">Poison</keyword> restaure <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分が与えた<keyword id=\"poison\">毒</keyword>が自然消滅すると<keyword id=\"mana\">マナ</keyword>を<value id=\"quantity_1\">%1$lld</value>回復"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 <keyword id=\"poison\">독</keyword>이 자연적으로 끝나면 <keyword id=\"mana\">마나</keyword> <value id=\"quantity_1\">%1$lld</value> 회복"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自身施加的<keyword id=\"poison\">中毒</keyword>自然消退時，恢復<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"mana\">魔力</keyword>"
          }
        }
      }
    },
