    "talents.shield_scarab_block_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: shield_scarab_block_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dein <keyword id=\"block\">Block</keyword> durchbrochen wird, verursacht dein nächster <keyword id=\"holy\">heiliger</keyword> Treffer doppelten Schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When your <keyword id=\"block\">Block</keyword> breaks, your next <keyword id=\"holy\">Holy</keyword> hit deals double damage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque votre <keyword id=\"block\">Blocage</keyword> est brisé, votre prochain coup de type <keyword id=\"holy\">Sacré</keyword> inflige le double de dégâts"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の<keyword id=\"block\">ブロック</keyword>が崩れると、次の<keyword id=\"holy\">聖</keyword>ヒットのダメージが2倍になる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 <keyword id=\"block\">방어도</keyword>가 깨지면 다음 <keyword id=\"holy\">신성</keyword> 적중이 두 배의 피해"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自身<keyword id=\"block\">格擋</keyword>被擊破後，下次<keyword id=\"holy\">神聖</keyword>命中的傷害加倍"
          }
        }
      }
    },
