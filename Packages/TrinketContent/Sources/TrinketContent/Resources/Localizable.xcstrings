      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Brand</keyword> nimmt bei <keyword id=\"bleed\">blutenden</keyword> Gegnern <value id=\"quantity_1\">%1$lld</value>%% langsamer ab"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Burn</keyword> fades <value id=\"quantity_1\">%1$lld</value>%% slower on <keyword id=\"bleed\">Bleeding</keyword> enemies"}},
        "es": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Quemadura</keyword> disminuye un <value id=\"quantity_1\">%1$lld</value>%% más despacio en enemigos con <keyword id=\"bleed\">Sangrado</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "La <keyword id=\"burn\">Brûlure</keyword> diminue <value id=\"quantity_1\">%1$lld</value>%% plus lentement sur les ennemis sous <keyword id=\"bleed\">Saignement</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">出血</keyword>状態の敵の<keyword id=\"burn\">炎上</keyword>減衰が<value id=\"quantity_1\">%1$lld</value>%%遅くなる"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">출혈</keyword> 상태의 적에게 걸린 <keyword id=\"burn\">화상</keyword>의 감소 속도 <value id=\"quantity_1\">%1$lld</value>%% 저하"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Queimadura</keyword> diminui <value id=\"quantity_1\">%1$lld</value>%% mais devagar em inimigos com <keyword id=\"bleed\">Sangramento</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"bleed\">流血</keyword>敵人身上的<keyword id=\"burn\">燃燒</keyword>衰減速度降低<value id=\"quantity_1\">%1$lld</value>%%"}}
