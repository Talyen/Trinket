          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"health\">체력</keyword> 소모 시 다음 <keyword id=\"mana\">마나</keyword> 강화 소모량 <value id=\"quantity_1\">%1$lld</value> 감소"
