    "affixes.serrated.astral_description": {
      "comment": "ContentManifest/affixes.tsv: serrated, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhöhe <keyword id=\"bleed\">Blutungs</keyword>schaden um <value id=\"quantity_1\">%1$lld</value>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Increase <keyword id=\"bleed\">Bleed</keyword> damage by <value id=\"quantity_1\">%1$lld</value>"
