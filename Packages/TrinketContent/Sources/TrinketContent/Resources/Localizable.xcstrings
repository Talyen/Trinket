    "affixes.runic_quill.astral_description": {
      "comment": "ContentManifest/affixes.tsv: runic_quill, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ziehe eine Karte, wenn du in einem Zug erstmals <keyword id=\"mana\">Mana</keyword> ausgibst"}},
        "en": {"stringUnit": {"state": "translated", "value": "Draw a card the first time you spend <keyword id=\"mana\">Mana</keyword> each turn"}},
        "es": {"stringUnit": {"state": "translated", "value": "Roba una carta la primera vez que gastas <keyword id=\"mana\">Maná</keyword> cada turno"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Piochez une carte la première fois que vous dépensez du <keyword id=\"mana\">Mana</keyword> à chaque tour"}},
        "ja": {"stringUnit": {"state": "translated", "value": "各ターンに初めて<keyword id=\"mana\">マナ</keyword>を消費すると、カードを1枚引く"}},
        "ko": {"stringUnit": {"state": "translated", "value": "매 턴 처음으로 <keyword id=\"mana\">마나</keyword>를 소모하면 카드 한 장 뽑기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Compre uma carta na primeira vez que gastar <keyword id=\"mana\">Mana</keyword> a cada turno"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每回合首次消耗<keyword id=\"mana\">魔力</keyword>時，抽一張牌"}}
      }
    },
    "affixes.runic_quill.basic_description": {
      "comment": "ContentManifest/affixes.tsv: runic_quill, basic_description",
      "extractionState": "manual",
      "localizations": {
