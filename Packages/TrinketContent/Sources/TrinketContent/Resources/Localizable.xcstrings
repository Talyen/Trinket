    "authored.b5cf40958600ae29": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verursachter <keyword id=\"freeze\">Frost</keyword>schaden gewährt ebenso viel <keyword id=\"block\">Block</keyword>\nErhalte <keyword id=\"mana\">Mana</keyword> in Höhe deines <keyword id=\"block\">Blocks</keyword>, wenn du einen Gegner <keyword id=\"freeze\">einfrierst</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Dealing <keyword id=\"freeze\">Freeze</keyword> damage grants that amount of <keyword id=\"block\">Block</keyword>\nGain <keyword id=\"mana\">Mana</keyword> equal to your <keyword id=\"block\">Block</keyword> when you <keyword id=\"freeze\">Freeze</keyword> an enemy"}},
        "es": {"stringUnit": {"state": "translated", "value": "Infligir daño de <keyword id=\"freeze\">Congelación</keyword> otorga esa cantidad de <keyword id=\"block\">Bloqueo</keyword>\nObtén <keyword id=\"mana\">Maná</keyword> equivalente a tu <keyword id=\"block\">Bloqueo</keyword> cuando <keyword id=\"freeze\">congelas</keyword> a un enemigo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Infliger des dégâts de <keyword id=\"freeze\">Gel</keyword> octroie autant de <keyword id=\"block\">Blocage</keyword>\nGagnez autant de <keyword id=\"mana\">Mana</keyword> que votre <keyword id=\"block\">Blocage</keyword> lorsque vous infligez un <keyword id=\"freeze\">Gel</keyword> à un ennemi"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">凍結</keyword>ダメージを与えると、同量の<keyword id=\"block\">ブロック</keyword>を獲得\n敵を<keyword id=\"freeze\">凍結</keyword>状態にすると、自分の<keyword id=\"block\">ブロック</keyword>と同量の<keyword id=\"mana\">マナ</keyword>を獲得"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"freeze\">빙결</keyword> 피해를 주면 같은 양의 <keyword id=\"block\">방어도</keyword> 획득\n적을 <keyword id=\"freeze\">빙결</keyword>시키면 내 <keyword id=\"block\">방어도</keyword>만큼 <keyword id=\"mana\">마나</keyword> 획득"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Causar dano de <keyword id=\"freeze\">Congelamento</keyword> concede a mesma quantidade de <keyword id=\"block\">Bloqueio</keyword>\nGanhe <keyword id=\"mana\">Mana</keyword> equivalente ao seu <keyword id=\"block\">Bloqueio</keyword> ao <keyword id=\"freeze\">Congelar</keyword> um inimigo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "造成<keyword id=\"freeze\">冰凍</keyword>傷害時，獲得等量<keyword id=\"block\">格擋</keyword>\n使敵人<keyword id=\"freeze\">冰凍</keyword>時，獲得等同自身<keyword id=\"block\">格擋</keyword>的<keyword id=\"mana\">魔力</keyword>"}}
      }
    },
