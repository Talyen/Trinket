        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que vous avez du <keyword id=\"block\">Blocage</keyword>, les <keyword id=\"thorns\">Épines</keyword> infligent <value id=\"quantity_1\">%1$lld</value>%% de dégâts en plus"
