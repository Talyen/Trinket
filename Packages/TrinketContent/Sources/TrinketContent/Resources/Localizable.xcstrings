    "affixes.arcane.astral_description": {
      "comment": "ContentManifest/affixes.tsv: arcane, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wenn du ohne <keyword id=\"mana\">Mana</keyword> einen Gegner <keyword id=\"stun\">betäubst</keyword>, stelle <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword> wieder her"}},
        "en": {"stringUnit": {"state": "translated", "value": "When you <keyword id=\"stun\">Stun</keyword> with no <keyword id=\"mana\">Mana</keyword>, restore <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Sin <keyword id=\"mana\">Maná</keyword>, <keyword id=\"stun\">aturdir</keyword> a un enemigo restaura <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"mana\">Maná</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Sans <keyword id=\"mana\">Mana</keyword>, <keyword id=\"stun\">étourdir</keyword> un ennemi restaure <value id=\"quantity_1\">%1$lld</value> <keyword id=\"mana\">Mana</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">マナ</keyword>がないときに敵を<keyword id=\"stun\">スタン</keyword>させると、<keyword id=\"mana\">マナ</keyword>を<value id=\"quantity_1\">%1$lld</value>回復"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">마나</keyword>가 없을 때 적을 <keyword id=\"stun\">기절</keyword>시키면 <keyword id=\"mana\">마나</keyword> <value id=\"quantity_1\">%1$lld</value> 회복"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Sem <keyword id=\"mana\">Mana</keyword>, <keyword id=\"stun\">atordoar</keyword> um inimigo restaura <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"mana\">Mana</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "沒有<keyword id=\"mana\">魔力</keyword>時使敵人<keyword id=\"stun\">暈眩</keyword>，恢復<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"mana\">魔力</keyword>"}}
      }
    },
