        "en": {"stringUnit": {"state": "translated", "value": "Wishing Well"}},
        "es": {"stringUnit": {"state": "translated", "value": "Pozo de los deseos"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Puits aux souhaits"}},
        "ja": {"stringUnit": {"state": "translated", "value": "願いの井戸"}},
        "ko": {"stringUnit": {"state": "translated", "value": "소원의 우물"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Poço dos Desejos"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "許願井"}}
      }
    },
    "homestead_nodes.wooltailoring.1.bonus_description": {
      "comment": "ContentManifest/homestead_nodes.tsv: woolTailoring.1, bonus_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erleide <value id=\"quantity_1\">%1$lld</value>%% weniger <keyword id=\"freeze\">Frost</keyword>schaden\nErleide <value id=\"quantity_2\">%2$lld</value>%% weniger <keyword id=\"burn\">Brand</keyword>schaden\nProduziere <value id=\"quantity_3\">%3$lld</value> <keyword id=\"gold\">Gold</keyword> pro Tag"}},
        "en": {"stringUnit": {"state": "translated", "value": "Take <value id=\"quantity_1\">%1$lld</value>%% less <keyword id=\"freeze\">Freeze</keyword> damage\nTake <value id=\"quantity_2\">%2$lld</value>%% less <keyword id=\"burn\">Burn</keyword> damage\nProduce <value id=\"quantity_3\">%3$lld</value> <keyword id=\"gold\">Gold</keyword> per Day"}},
        "es": {"stringUnit": {"state": "translated", "value": "Recibe un <value id=\"quantity_1\">%1$lld</value>%% menos de daño de <keyword id=\"freeze\">Congelación</keyword>\nRecibe un <value id=\"quantity_2\">%2$lld</value>%% menos de daño de <keyword id=\"burn\">Quemadura</keyword>\nProduce <value id=\"quantity_3\">%3$lld</value> de <keyword id=\"gold\">Oro</keyword> al día"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Dégâts de <keyword id=\"freeze\">Gel</keyword> subis réduits de <value id=\"quantity_1\">%1$lld</value>%%\nDégâts de <keyword id=\"burn\">Brûlure</keyword> subis réduits de <value id=\"quantity_2\">%2$lld</value>%%\nProduit <value id=\"quantity_3\">%3$lld</value> <keyword id=\"gold\">Or</keyword> par jour"}},
        "ja": {"stringUnit": {"state": "translated", "value": "受ける<keyword id=\"freeze\">凍結</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%減少\n受ける<keyword id=\"burn\">炎上</keyword>ダメージが<value id=\"quantity_2\">%2$lld</value>%%減少\n1日に<keyword id=\"gold\">ゴールド</keyword>を<value id=\"quantity_3\">%3$lld</value>生産"}},
        "ko": {"stringUnit": {"state": "translated", "value": "받는 <keyword id=\"freeze\">빙결</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>%% 감소\n받는 <keyword id=\"burn\">화상</keyword> 피해 <value id=\"quantity_2\">%2$lld</value>%% 감소\n하루에 <keyword id=\"gold\">골드</keyword> <value id=\"quantity_3\">%3$lld</value> 생산"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Receba <value id=\"quantity_1\">%1$lld</value>%% menos dano de <keyword id=\"freeze\">Congelamento</keyword>\nReceba <value id=\"quantity_2\">%2$lld</value>%% menos dano de <keyword id=\"burn\">Queimadura</keyword>\nProduza <value id=\"quantity_3\">%3$lld</value> de <keyword id=\"gold\">Ouro</keyword> por Dia"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "承受的<keyword id=\"freeze\">冰凍</keyword>傷害降低<value id=\"quantity_1\">%1$lld</value>%%\n承受的<keyword id=\"burn\">燃燒</keyword>傷害降低<value id=\"quantity_2\">%2$lld</value>%%\n每天生產<value id=\"quantity_3\">%3$lld</value><keyword id=\"gold\">金幣</keyword>"}}
      }
    },
