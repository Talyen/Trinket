    "affixes.clearheaded.astral_description": {
      "comment": "ContentManifest/affixes.tsv: clearheaded, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erhalte <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>, wenn du <value id=\"quantity_2\">%2$lld</value> Schwächungseffekt <keyword id=\"cleanse\">reinigst</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Gain <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword> when you <keyword id=\"cleanse\">Cleanse</keyword> <value id=\"quantity_2\">%2$lld</value> debuff"}},
        "es": {"stringUnit": {"state": "translated", "value": "Obtén <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueo</keyword> cuando <keyword id=\"cleanse\">purificas</keyword> <value id=\"quantity_2\">%2$lld</value> perjuicio"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Gagne <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Blocage</keyword> lors de la <keyword id=\"cleanse\">Purification</keyword> de <value id=\"quantity_2\">%2$lld</value> malus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "弱体効果を<value id=\"quantity_2\">%2$lld</value>個<keyword id=\"cleanse\">浄化</keyword>すると<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>得る"}},
        "ko": {"stringUnit": {"state": "translated", "value": "약화 효과 <value id=\"quantity_2\">%2$lld</value>개를 <keyword id=\"cleanse\">정화</keyword>하면 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 획득"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ganhe <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueio</keyword> ao <keyword id=\"cleanse\">Purificar</keyword> <value id=\"quantity_2\">%2$lld</value> efeito negativo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"cleanse\">淨化</keyword><value id=\"quantity_2\">%2$lld</value>項減益效果時，獲得<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>"}}
      }
    },
    "affixes.clearheaded.basic_description": {
      "comment": "ContentManifest/affixes.tsv: clearheaded, basic_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erhalte <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword>, wenn du <value id=\"quantity_2\">%2$lld</value> Schwächungseffekt <keyword id=\"cleanse\">reinigst</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "Gain <value id=\"quantity_1\">%1$lld</value> <keyword id=\"block\">Block</keyword> when you <keyword id=\"cleanse\">Cleanse</keyword> <value id=\"quantity_2\">%2$lld</value> debuff"}},
        "es": {"stringUnit": {"state": "translated", "value": "Obtén <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueo</keyword> cuando <keyword id=\"cleanse\">purificas</keyword> <value id=\"quantity_2\">%2$lld</value> perjuicio"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Gagne <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Blocage</keyword> lors de la <keyword id=\"cleanse\">Purification</keyword> de <value id=\"quantity_2\">%2$lld</value> malus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "弱体効果を<value id=\"quantity_2\">%2$lld</value>個<keyword id=\"cleanse\">浄化</keyword>すると<keyword id=\"block\">ブロック</keyword>を<value id=\"quantity_1\">%1$lld</value>得る"}},
        "ko": {"stringUnit": {"state": "translated", "value": "약화 효과 <value id=\"quantity_2\">%2$lld</value>개를 <keyword id=\"cleanse\">정화</keyword>하면 <keyword id=\"block\">방어도</keyword> <value id=\"quantity_1\">%1$lld</value> 획득"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ganhe <value id=\"quantity_1\">%1$lld</value> de <keyword id=\"block\">Bloqueio</keyword> ao <keyword id=\"cleanse\">Purificar</keyword> <value id=\"quantity_2\">%2$lld</value> efeito negativo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"cleanse\">淨化</keyword><value id=\"quantity_2\">%2$lld</value>項減益效果時，獲得<value id=\"quantity_1\">%1$lld</value>點<keyword id=\"block\">格擋</keyword>"}}
      }
    },
    "affixes.clearheaded.title": {
      "comment": "ContentManifest/affixes.tsv: clearheaded, title",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Klarer Kopf"}},
        "en": {"stringUnit": {"state": "translated", "value": "Clearheaded"}},
        "es": {"stringUnit": {"state": "translated", "value": "Lúcido"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Esprit clair"}},
        "ja": {"stringUnit": {"state": "translated", "value": "明晰"}},
        "ko": {"stringUnit": {"state": "translated", "value": "맑은 정신"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Lucidez"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "頭腦清醒"}}
      }
    },
    "affixes.companions_collar.astral_description": {
      "comment": "ContentManifest/affixes.tsv: companions_collar, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Einmal pro Zug: Wenn du deinen Gefährten heilst, ziehe eine Gefährtenkarte"}},
        "en": {"stringUnit": {"state": "translated", "value": "Once per turn, healing your Companion draws a Companion card"}},
        "es": {"stringUnit": {"state": "translated", "value": "Una vez por turno, al curar a tu compañero, robas una carta de compañero"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Une fois par tour, soigner votre Compagnon fait piocher une carte de Compagnon"}},
        "ja": {"stringUnit": {"state": "translated", "value": "1ターンに1回、仲間を回復すると仲間のカードを1枚引く"}},
        "ko": {"stringUnit": {"state": "translated", "value": "턴마다 한 번, 동료를 치유하면 동료 카드 한 장 뽑기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Uma vez por turno, curar seu Companheiro faz você comprar uma carta de Companheiro"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每回合一次，治療夥伴時抽一張夥伴牌"}}
      }
    },
    "affixes.companions_collar.basic_description": {
      "comment": "ContentManifest/affixes.tsv: companions_collar, basic_description",
