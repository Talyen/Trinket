    "affixes.tattered_pages.astral_description": {
      "comment": "ContentManifest/affixes.tsv: tattered_pages, astral_description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Bei <keyword id=\"burn\">Brand</keyword>-Schaden besteht eine Chance von <value id=\"quantity_1\">%1$lld</value>%%, eine Karte zu ziehen"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">Burn</keyword> damage has a <value id=\"quantity_1\">%1$lld</value>%% chance to draw a card"}},
        "es": {"stringUnit": {"state": "translated", "value": "El daño de <keyword id=\"burn\">Quemadura</keyword> tiene un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de hacerte robar una carta"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les dégâts de <keyword id=\"burn\">Brûlure</keyword> ont <value id=\"quantity_1\">%1$lld</value>%% de chances de vous faire piocher une carte"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">炎上</keyword>ダメージで、<value id=\"quantity_1\">%1$lld</value>%%の確率でカードを1枚引く"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">화상</keyword> 피해 발생 시 <value id=\"quantity_1\">%1$lld</value>%% 확률로 카드 한 장 뽑기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O dano de <keyword id=\"burn\">Queimadura</keyword> tem <value id=\"quantity_1\">%1$lld</value>%% de chance de fazer você comprar uma carta"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "造成<keyword id=\"burn\">燃燒</keyword>傷害時，有<value id=\"quantity_1\">%1$lld</value>%%的機率抽一張牌"}}
      }
    },
