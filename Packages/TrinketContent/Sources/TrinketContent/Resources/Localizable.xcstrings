    "talents.rogue_bleed_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: rogue_bleed_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kritische <keyword id=\"bleed\">Blutungs</keyword>-Treffer verursachen doppelten Schaden, wenn der Gegner unter halber <keyword id=\"health\">Gesundheit</keyword> ist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"bleed\">Bleed</keyword> Critical Hits deal double damage below half enemy <keyword id=\"health\">Health</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les coups critiques de <keyword id=\"bleed\">Saignement</keyword> infligent le double de dégâts si l’ennemi est sous la moitié de sa <keyword id=\"health\">Santé</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "敵の<keyword id=\"health\">体力</keyword>が半分未満なら、<keyword id=\"bleed\">出血</keyword>クリティカルヒットのダメージが2倍になる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적의 <keyword id=\"health\">체력</keyword>이 절반 미만이면 <keyword id=\"bleed\">출혈</keyword> 치명타가 두 배의 피해"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "敵人<keyword id=\"health\">生命值</keyword>低於一半時，<keyword id=\"bleed\">流血</keyword>暴擊造成雙倍傷害"
          }
        }
      }
    },
