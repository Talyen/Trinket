    "homestead_nodes.wishingwell.1.summary": {
      "comment": "ContentManifest/homestead_nodes.tsv: wishingWell.1, summary",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ein stilles Wahrzeichen für ferne Ziele, seltene Funde und glückliche Heimkehr"}},
        "en": {"stringUnit": {"state": "translated", "value": "A quiet landmark for late goals, rare finds, and lucky returns"}},
        "es": {"stringUnit": {"state": "translated", "value": "Un lugar tranquilo para metas lejanas, hallazgos raros y regresos afortunados"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Un repère paisible pour les objectifs lointains, les trouvailles rares et les retours chanceux"}},
        "ja": {"stringUnit": {"state": "translated", "value": "遠い目標や希少な発見、幸運な帰還を願う静かな目印"}},
        "ko": {"stringUnit": {"state": "translated", "value": "먼 목표와 희귀한 발견, 행운의 귀환을 위한 고요한 이정표"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Um marco tranquilo para objetivos distantes, achados raros e retornos de sorte"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "為長遠目標、稀有發現與幸運回報而立的寧靜地標"}}
      }
    },
