    "talents.warlock_leech_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: warlock_leech_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Lebensraub deine <keyword id=\"health\">Gesundheit</keyword> vollständig auffüllt, erhält dein nächster Angriff <value id=\"quantity_1\">%1$lld</value> zusätzlichen Schaden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leeching to full <keyword id=\"health\">Health</keyword> adds <value id=\"quantity_1\">%1$lld</value> bonus damage to your next attack"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atteindre la pleine <keyword id=\"health\">Santé</keyword> par un vol de vie ajoute <value id=\"quantity_1\">%1$lld</value> dégâts à votre prochaine attaque"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "吸収で<keyword id=\"health\">体力</keyword>が満タンになると、次の攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>増加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흡혈로 <keyword id=\"health\">체력</keyword>을 가득 채우면 다음 공격의 추가 피해 <value id=\"quantity_1\">%1$lld</value>"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "吸血使<keyword id=\"health\">生命值</keyword>全滿時，下次攻擊的傷害增加<value id=\"quantity_1\">%1$lld</value>點"
          }
        }
      }
    },
