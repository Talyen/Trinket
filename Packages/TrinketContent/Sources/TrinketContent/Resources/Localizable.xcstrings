    "authored.2d432e5eac18f64c": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog+Melee.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein <keyword id=\"stun\">Betäubungs</keyword>schaden ignoriert gegnerischen <keyword id=\"block\">Block</keyword> und erhält zusätzlichen Schaden in Höhe dieses <keyword id=\"block\">Blocks</keyword>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your <keyword id=\"stun\">Stun</keyword> damage ignores enemy <keyword id=\"block\">Block</keyword> and gains damage equal to that <keyword id=\"block\">Block</keyword>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos dégâts d’<keyword id=\"stun\">Étourdissement</keyword> ignorent le <keyword id=\"block\">Blocage</keyword> ennemi et augmentent à hauteur de ce <keyword id=\"block\">Blocage</keyword>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の<keyword id=\"stun\">スタン</keyword>ダメージが敵の<keyword id=\"block\">ブロック</keyword>を無視し、その<keyword id=\"block\">ブロック</keyword>と同量だけ増加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 <keyword id=\"stun\">기절</keyword> 피해가 적의 <keyword id=\"block\">방어도</keyword>를 무시하고 그 <keyword id=\"block\">방어도</keyword>만큼 피해 증가"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自身<keyword id=\"stun\">暈眩</keyword>傷害無視敵人<keyword id=\"block\">格擋</keyword>，並增加等同該<keyword id=\"block\">格擋</keyword>的傷害"
          }
        }
      }
    },
