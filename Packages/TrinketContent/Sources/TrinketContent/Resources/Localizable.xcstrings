    "traits.dread_exploitation.description": {
      "comment": "ContentManifest/traits.tsv: dread_exploitation, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Angriffe gegen <keyword id=\"stun\">betäubte</keyword> Gegner verursachen <value id=\"quantity_1\">%1$lld</value> zusätzlichen Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Attacks against <keyword id=\"stun\">Stunned</keyword> enemies deal <value id=\"quantity_1\">%1$lld</value> additional damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques contra enemigos <keyword id=\"stun\">aturdidos</keyword> infligen <value id=\"quantity_1\">%1$lld</value> de daño adicional"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques contre les ennemis sous <keyword id=\"stun\">Étourdissement</keyword> infligent <value id=\"quantity_1\">%1$lld</value> dégâts supplémentaires"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">スタン</keyword>状態の敵への攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">기절</keyword> 상태의 적을 대상으로 하는 공격의 추가 피해 <value id=\"quantity_1\">%1$lld</value>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques contra inimigos <keyword id=\"stun\">Atordoados</keyword> causam <value id=\"quantity_1\">%1$lld</value> de dano adicional"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "對<keyword id=\"stun\">暈眩</keyword>敵人的攻擊額外造成<value id=\"quantity_1\">%1$lld</value>點傷害"}}
      }
    },
    "traits.dread_exploitation.name": {
      "comment": "ContentManifest/traits.tsv: dread_exploitation, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Gnadenlose Ausnutzung"}},
        "en": {"stringUnit": {"state": "translated", "value": "Dread Exploitation"}},
        "es": {"stringUnit": {"state": "translated", "value": "Aprovechar el terror"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Exploitation de l’effroi"}},
        "ja": {"stringUnit": {"state": "translated", "value": "恐怖につけ込む"}},
        "ko": {"stringUnit": {"state": "translated", "value": "공포의 틈"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Exploração do Pavor"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "恐懼剝削"}}
      }
    },
    "traits.fan_the_flames.description": {
      "comment": "ContentManifest/traits.tsv: fan_the_flames, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Angriffe gegen <keyword id=\"burn\">brennende</keyword> Gegner verursachen <value id=\"quantity_1\">%1$lld</value>%% zusätzlichen Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Attacks against <keyword id=\"burn\">Burning</keyword> enemies deal <value id=\"quantity_1\">%1$lld</value>%% additional damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques contra enemigos con <keyword id=\"burn\">Quemadura</keyword> infligen un <value id=\"quantity_1\">%1$lld</value>%% de daño adicional"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques contre les ennemis sous <keyword id=\"burn\">Brûlure</keyword> infligent <value id=\"quantity_1\">%1$lld</value>%% de dégâts supplémentaires"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">炎上</keyword>状態の敵への攻撃のダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"burn\">화상</keyword> 상태의 적에게 공격 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques contra inimigos <keyword id=\"burn\">Em Chamas</keyword> causam <value id=\"quantity_1\">%1$lld</value>%% de dano adicional"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "對<keyword id=\"burn\">燃燒</keyword>中敵人的攻擊額外造成<value id=\"quantity_1\">%1$lld</value>%%傷害"}}
      }
    },
    "traits.fan_the_flames.name": {
      "comment": "ContentManifest/traits.tsv: fan_the_flames, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Die Flammen anfachen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Fan the Flames"}},
        "es": {"stringUnit": {"state": "translated", "value": "Avivar el fuego"}},
