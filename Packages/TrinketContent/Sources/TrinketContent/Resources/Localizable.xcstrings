    "talents.pixie_health_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: pixie_health_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbündete mit voller <keyword id=\"health\">Gesundheit</keyword> erhalten +<value id=\"quantity_1\">%1$lld</value>%% Chance auf <keyword id=\"dodge\">Ausweichen</keyword>"
