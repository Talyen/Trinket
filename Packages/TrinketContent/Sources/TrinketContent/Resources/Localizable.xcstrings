    "talents.frost_whelp_mana_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: frost_whelp_mana_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Ausgeben von <keyword id=\"mana\">Mana</keyword> lässt dich mit <value id=\"quantity_1\">%1$lld</value>%% Chance eine Karte ziehen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Spending <keyword id=\"mana\">Mana</keyword> has a <value id=\"quantity_1\">%1$lld</value>%% chance to draw a card"}},
        "es": {"stringUnit": {"state": "translated", "value": "Gastar <keyword id=\"mana\">Maná</keyword> tiene un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de hacer que robes una carta"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Dépenser du <keyword id=\"mana\">Mana</keyword> a <value id=\"quantity_1\">%1$lld</value>%% de chances de faire piocher une carte"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">マナ</keyword>を消費すると<value id=\"quantity_1\">%1$lld</value>%%の確率でカードを1枚引く"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"mana\">마나</keyword> 소모 시 <value id=\"quantity_1\">%1$lld</value>%% 확률로 카드 한 장 뽑기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Gastar <keyword id=\"mana\">Mana</keyword> tem <value id=\"quantity_1\">%1$lld</value>%% de chance de comprar uma carta"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "消耗<keyword id=\"mana\">魔力</keyword>時，有<value id=\"quantity_1\">%1$lld</value>%%機率抽一張牌"}}
