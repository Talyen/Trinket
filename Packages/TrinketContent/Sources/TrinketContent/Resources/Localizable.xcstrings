    "homestead_nodes.moonlitsanctum.4.summary": {
      "comment": "ContentManifest/homestead_nodes.tsv: moonlitSanctum.4, summary",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein stilles Heiligtum zum Aufspüren seltener Funde und widernatürlicher Gefahren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A quiet sanctum for sensing rare finds and unnatural threats"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un sanctuaire paisible pour déceler les trouvailles rares et les menaces surnaturelles"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "希少な発見と異形の脅威を感じ取る、静かな聖所"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "희귀한 물건과 불길한 위협을 감지하는 고요한 성소"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "感知稀有發現與異常威脅的寧靜聖所"
          }
        }
      }
    },
