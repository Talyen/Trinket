    "authored.600fe69d5d270601": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/InventoryItem+Compatibility.swift: canonical numeric compatibility description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">Lebensraub</keyword> stellt zusätzlich <value id=\"quantity_1\">%1$lld</value>%% des verursachten Schadens wieder her"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">Leech</keyword> restores an additional <value id=\"quantity_1\">%1$lld</value>%% of damage dealt"}},
        "es": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">Absorción</keyword> restaura un <value id=\"quantity_1\">%1$lld</value>%% adicional del daño infligido"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le <keyword id=\"leech\">Vol de vie</keyword> rend un montant supplémentaire de Santé égal à <value id=\"quantity_1\">%1$lld</value>%% des dégâts infligés"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">吸収</keyword>は与えたダメージの<value id=\"quantity_1\">%1$lld</value>%%を追加で回復"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">흡혈</keyword> 시 준 피해의 <value id=\"quantity_1\">%1$lld</value>%%만큼 추가 회복"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">Drenagem</keyword> restaura <value id=\"quantity_1\">%1$lld</value>%% adicional do dano causado"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"leech\">吸血</keyword>額外恢復相當於所造成傷害<value id=\"quantity_1\">%1$lld</value>%%的生命值"}}
      }
    },
    "authored.6023edf63b08d7e8": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Equipment/UniqueCatalog+Melee.swift: description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Deine <keyword id=\"bleed\">Blutung</keyword> hält über ihre normale Dauer hinaus an; ihre Stärke halbiert sich mit jedem zusätzlichen Zug"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your <keyword id=\"bleed\">Bleed</keyword> continues after its normal duration, halving in potency each additional turn"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu <keyword id=\"bleed\">Sangrado</keyword> continúa después de su duración normal y su potencia se reduce a la mitad cada turno adicional"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre <keyword id=\"bleed\">Saignement</keyword> persiste après sa durée normale ; sa puissance diminue de moitié à chaque tour supplémentaire"}},
        "ja": {"stringUnit": {"state": "translated", "value": "自分が与えた<keyword id=\"bleed\">出血</keyword>が通常の持続時間後も残り、以降は毎ターン威力が半減する"}},
        "ko": {"stringUnit": {"state": "translated", "value": "내 <keyword id=\"bleed\">출혈</keyword>이 원래 지속 시간이 끝난 후에도 지속되며, 추가 턴마다 위력이 절반으로 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seu <keyword id=\"bleed\">Sangramento</keyword> continua após a duração normal, perdendo metade da potência a cada turno adicional"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "自身施加的<keyword id=\"bleed\">流血</keyword>在正常持續時間結束後仍會延續，之後每回合效力減半"}}
      }
    },
    "authored.60bacaa26533e879": {
      "comment": "Packages/TrinketContent/Sources/TrinketContent/Encounters/Mystery/MysteryEventPool+Events.swift: narrative",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Leuchtende Beeren umgeben „%1$@“, und blaue Wurzeln summen rund um „%2$@“"}},
        "en": {"stringUnit": {"state": "translated", "value": "Glowing berries surround “%1$@”, and blue roots hum around “%2$@”"}},
        "es": {"stringUnit": {"state": "translated", "value": "Bayas luminosas rodean «%1$@», y raíces azules zumban alrededor de «%2$@»"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Des baies lumineuses entourent « %1$@ », tandis que des racines bleues bourdonnent autour de « %2$@ »"}},
        "ja": {"stringUnit": {"state": "translated", "value": "光る実が「%1$@」を囲み、青い根が「%2$@」の周りで唸っている"}},
        "ko": {"stringUnit": {"state": "translated", "value": "빛나는 열매가 ‘%1$@’ 주위를 둘러싸고, 푸른 뿌리가 ‘%2$@’ 주위에서 공명합니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Frutas brilhantes cercam “%1$@”, e raízes azuis ressoam ao redor de “%2$@”"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "發光莓果圍繞著「%1$@」，藍色根鬚在「%2$@」四周低鳴"}}
      }
    },
    "authored.60d2ffb433ad89de": {
