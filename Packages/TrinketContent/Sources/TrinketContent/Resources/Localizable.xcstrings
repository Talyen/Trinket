        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restoring <keyword id=\"health\">Health</keyword> removes <value id=\"quantity_1\">%1$lld</value> enemy <keyword id=\"thorns\">Thorns</keyword>"
