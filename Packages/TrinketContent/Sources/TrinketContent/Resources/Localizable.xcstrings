    "talents.knight_block_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: knight_block_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"thorns\">Dornen</keyword>schaden wird verdoppelt, solange du <keyword id=\"block\">Block</keyword> hast"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"thorns\">Thorns</keyword> damage is doubled while you have <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "El daño de <keyword id=\"thorns\">Espinas</keyword> se duplica mientras tienes <keyword id=\"block\">Bloqueo</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les dégâts d’<keyword id=\"thorns\">Épines</keyword> sont doublés tant que vous avez du <keyword id=\"block\">Blocage</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">ブロック</keyword>がある間、<keyword id=\"thorns\">棘</keyword>ダメージが2倍になる"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">방어도</keyword>가 있으면 <keyword id=\"thorns\">가시</keyword> 피해가 두 배"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O dano de <keyword id=\"thorns\">Espinhos</keyword> é dobrado enquanto você tiver <keyword id=\"block\">Bloqueio</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "擁有<keyword id=\"block\">格擋</keyword>時，<keyword id=\"thorns\">荊棘</keyword>傷害加倍"}}
      }
    },
    "talents.knight_block_t1_2.name": {
      "comment": "ContentManifest/talents.tsv: knight_block_t1_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Stachelbarrikade"}},
        "en": {"stringUnit": {"state": "translated", "value": "Spiked Barricade"}},
        "es": {"stringUnit": {"state": "translated", "value": "Barricada de púas"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Barricade à pointes"}},
        "ja": {"stringUnit": {"state": "translated", "value": "棘の防柵"}},
        "ko": {"stringUnit": {"state": "translated", "value": "가시 바리케이드"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Barricada de Espinhos"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "尖刺路障"}}
      }
    },
    "talents.knight_block_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: knight_block_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dein <keyword id=\"block\">Block</keyword> absorbiert auch Schaden an deinem Gefährten"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your <keyword id=\"block\">Block</keyword> also absorbs damage dealt to your Companion"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu <keyword id=\"block\">Bloqueo</keyword> también absorbe el daño infligido a tu compañero"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre <keyword id=\"block\">Blocage</keyword> absorbe aussi les dégâts infligés à votre Compagnon"}},
        "ja": {"stringUnit": {"state": "translated", "value": "自分の<keyword id=\"block\">ブロック</keyword>が仲間へのダメージも吸収"}},
        "ko": {"stringUnit": {"state": "translated", "value": "내 <keyword id=\"block\">방어도</keyword>가 동료에게 가해지는 피해도 흡수"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seu <keyword id=\"block\">Bloqueio</keyword> também absorve dano causado ao seu Companheiro"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "自身<keyword id=\"block\">格擋</keyword>也會吸收夥伴承受的傷害"}}
      }
    },
    "talents.knight_block_t2_1.name": {
      "comment": "ContentManifest/talents.tsv: knight_block_t2_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Einschreiten"}},
        "en": {"stringUnit": {"state": "translated", "value": "Intercede"}},
        "es": {"stringUnit": {"state": "translated", "value": "Interceder"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Intercession"}},
        "ja": {"stringUnit": {"state": "translated", "value": "庇う"}},
        "ko": {"stringUnit": {"state": "translated", "value": "중재"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Interceder"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "挺身庇護"}}
      }
    },
    "talents.knight_block_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: knight_block_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">Physischer</keyword> Schaden wird um <value id=\"quantity_1\">%1$lld</value>%% deines <keyword id=\"block\">Blocks</keyword> erhöht"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">Physical</keyword> damage is increased by <value id=\"quantity_1\">%1$lld</value>%% of your <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "El daño <keyword id=\"physical\">físico</keyword> aumenta en un <value id=\"quantity_1\">%1$lld</value>%% de tu <keyword id=\"block\">Bloqueo</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Vos dégâts de type <keyword id=\"physical\">Physique</keyword> augmentent de <value id=\"quantity_1\">%1$lld</value>%% de votre <keyword id=\"block\">Blocage</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">物理</keyword>ダメージが自分の<keyword id=\"block\">ブロック</keyword>の<value id=\"quantity_1\">%1$lld</value>%%分増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "내 <keyword id=\"block\">방어도</keyword>의 <value id=\"quantity_1\">%1$lld</value>%%만큼 <keyword id=\"physical\">물리</keyword> 피해 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O dano <keyword id=\"physical\">Físico</keyword> aumenta em <value id=\"quantity_1\">%1$lld</value>%% do seu <keyword id=\"block\">Bloqueio</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"physical\">物理</keyword>傷害增加相當於自身<keyword id=\"block\">格擋</keyword>的<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.knight_block_t2_2.name": {
      "comment": "ContentManifest/talents.tsv: knight_block_t2_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Geschützter Einschlag"}},
        "en": {"stringUnit": {"state": "translated", "value": "Guarded Impact"}},
        "es": {"stringUnit": {"state": "translated", "value": "Impacto protegido"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Impact protégé"}},
        "ja": {"stringUnit": {"state": "translated", "value": "守りの衝撃"}},
        "ko": {"stringUnit": {"state": "translated", "value": "방어 일격"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Impacto Protegido"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "防守衝擊"}}
      }
    },
    "talents.knight_block_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: knight_block_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Mit <keyword id=\"block\">Block</keyword> erleidest du halben <keyword id=\"burn\">Brand</keyword>-, <keyword id=\"poison\">Gift</keyword>- und <keyword id=\"bleed\">Blutungs</keyword>schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "With <keyword id=\"block\">Block</keyword>, take half <keyword id=\"burn\">Burn</keyword>, <keyword id=\"poison\">Poison</keyword>, and <keyword id=\"bleed\">Bleed</keyword> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Con <keyword id=\"block\">Bloqueo</keyword>, recibe la mitad de daño de <keyword id=\"burn\">Quemadura</keyword>, <keyword id=\"poison\">Veneno</keyword> y <keyword id=\"bleed\">Sangrado</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Avec du <keyword id=\"block\">Blocage</keyword>, les dégâts de <keyword id=\"burn\">Brûlure</keyword>, de <keyword id=\"poison\">Poison</keyword> et de <keyword id=\"bleed\">Saignement</keyword> subis sont réduits de moitié"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">ブロック</keyword>がある間、受ける<keyword id=\"burn\">炎上</keyword>、<keyword id=\"poison\">毒</keyword>、<keyword id=\"bleed\">出血</keyword>ダメージが半減"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">방어도</keyword>가 있으면 받는 <keyword id=\"burn\">화상</keyword>, <keyword id=\"poison\">독</keyword>, <keyword id=\"bleed\">출혈</keyword> 피해가 절반으로 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Com <keyword id=\"block\">Bloqueio</keyword>, receba metade do dano de <keyword id=\"burn\">Queimadura</keyword>, de <keyword id=\"poison\">Veneno</keyword> e de <keyword id=\"bleed\">Sangramento</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "擁有<keyword id=\"block\">格擋</keyword>時，承受的<keyword id=\"burn\">燃燒</keyword>、<keyword id=\"poison\">中毒</keyword>與<keyword id=\"bleed\">流血</keyword>傷害減半"}}
      }
    },
    "talents.knight_block_t3_1.name": {
      "comment": "ContentManifest/talents.tsv: knight_block_t3_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Geweihter Schutz"}},
        "en": {"stringUnit": {"state": "translated", "value": "Hallowed Guard"}},
        "es": {"stringUnit": {"state": "translated", "value": "Guardia bendita"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Garde bénie"}},
        "ja": {"stringUnit": {"state": "translated", "value": "聖なる防御"}},
        "ko": {"stringUnit": {"state": "translated", "value": "신성한 방어"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Guarda Consagrada"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "神聖防禦"}}
      }
    },
    "talents.knight_block_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: knight_block_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Behalte <value id=\"quantity_1\">%1$lld</value>%% deines <keyword id=\"block\">Blocks</keyword> zwischen deinen Zügen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Keep <value id=\"quantity_1\">%1$lld</value>%% of your <keyword id=\"block\">Block</keyword> between turns"}},
        "es": {"stringUnit": {"state": "translated", "value": "Conserva un <value id=\"quantity_1\">%1$lld</value>%% de tu <keyword id=\"block\">Bloqueo</keyword> entre turnos"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Conservez <value id=\"quantity_1\">%1$lld</value>%% de votre <keyword id=\"block\">Blocage</keyword> entre les tours"}},
        "ja": {"stringUnit": {"state": "translated", "value": "ターンをまたいで<keyword id=\"block\">ブロック</keyword>の<value id=\"quantity_1\">%1$lld</value>%%を保持"}},
        "ko": {"stringUnit": {"state": "translated", "value": "턴이 바뀌어도 내 <keyword id=\"block\">방어도</keyword>의 <value id=\"quantity_1\">%1$lld</value>%% 유지"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Mantenha <value id=\"quantity_1\">%1$lld</value>%% do seu <keyword id=\"block\">Bloqueio</keyword> entre turnos"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "回合之間保留<value id=\"quantity_1\">%1$lld</value>%%的<keyword id=\"block\">格擋</keyword>"}}
      }
    },
    "talents.knight_block_t3_2.name": {
      "comment": "ContentManifest/talents.tsv: knight_block_t3_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Unzerbrechlich"}},
        "en": {"stringUnit": {"state": "translated", "value": "Unbreakable"}},
        "es": {"stringUnit": {"state": "translated", "value": "Irrompible"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Incassable"}},
        "ja": {"stringUnit": {"state": "translated", "value": "不壊"}},
        "ko": {"stringUnit": {"state": "translated", "value": "불굴"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Inquebrável"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "堅不可摧"}}
      }
    },
    "talents.knight_block_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: knight_block_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Unter halber <keyword id=\"health\">Gesundheit</keyword> absorbiert <keyword id=\"block\">Block</keyword> <value id=\"quantity_1\">%1$lld</value>%% mehr Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Below half <keyword id=\"health\">Health</keyword>, <keyword id=\"block\">Block</keyword> absorbs <value id=\"quantity_1\">%1$lld</value>%% more damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Por debajo de la mitad de <keyword id=\"health\">Salud</keyword>, <keyword id=\"block\">Bloqueo</keyword> absorbe un <value id=\"quantity_1\">%1$lld</value>%% más de daño"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Sous la moitié de votre <keyword id=\"health\">Santé</keyword>, le <keyword id=\"block\">Blocage</keyword> absorbe <value id=\"quantity_1\">%1$lld</value>%% de dégâts en plus"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>が半分未満なら、<keyword id=\"block\">ブロック</keyword>が吸収するダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword>이 절반 미만이면 <keyword id=\"block\">방어도</keyword>의 피해 흡수량 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Abaixo de metade da <keyword id=\"health\">Vida</keyword>, <keyword id=\"block\">Bloqueio</keyword> absorve <value id=\"quantity_1\">%1$lld</value>%% mais dano"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">生命值</keyword>低於一半時，<keyword id=\"block\">格擋</keyword>吸收的傷害增加<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.knight_block_t4_1.name": {
      "comment": "ContentManifest/talents.tsv: knight_block_t4_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Unerschütterlicher Eid"}},
        "en": {"stringUnit": {"state": "translated", "value": "Stalwart Oath"}},
        "es": {"stringUnit": {"state": "translated", "value": "Juramento firme"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Serment indéfectible"}},
        "ja": {"stringUnit": {"state": "translated", "value": "揺るがぬ誓い"}},
        "ko": {"stringUnit": {"state": "translated", "value": "굳건한 맹세"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Juramento Resoluto"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "堅毅誓言"}}
      }
    },
    "talents.knight_holy_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: knight_holy_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">Heiliger</keyword> Schaden wird um <value id=\"quantity_1\">%1$lld</value>%% erhöht, solange du <keyword id=\"block\">Block</keyword> hast"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">Holy</keyword> damage is increased by <value id=\"quantity_1\">%1$lld</value>%% while you have <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "El daño <keyword id=\"holy\">sagrado</keyword> aumenta en un <value id=\"quantity_1\">%1$lld</value>%% mientras tienes <keyword id=\"block\">Bloqueo</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Dégâts de type <keyword id=\"holy\">Sacré</keyword> augmentés de <value id=\"quantity_1\">%1$lld</value>%% tant que vous avez du <keyword id=\"block\">Blocage</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">ブロック</keyword>がある間、<keyword id=\"holy\">聖</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"block\">방어도</keyword>가 있으면 <keyword id=\"holy\">신성</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O dano <keyword id=\"holy\">Sagrado</keyword> aumenta em <value id=\"quantity_1\">%1$lld</value>%% enquanto você tiver <keyword id=\"block\">Bloqueio</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "擁有<keyword id=\"block\">格擋</keyword>時，<keyword id=\"holy\">神聖</keyword>傷害提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.knight_holy_t1_1.name": {
      "comment": "ContentManifest/talents.tsv: knight_holy_t1_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Eidgebunden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Oathbound"}},
        "es": {"stringUnit": {"state": "translated", "value": "Ligado por juramento"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Lié par serment"}},
        "ja": {"stringUnit": {"state": "translated", "value": "誓約"}},
        "ko": {"stringUnit": {"state": "translated", "value": "맹세의 유대"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Vinculado ao Juramento"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "誓約束縛"}}
      }
