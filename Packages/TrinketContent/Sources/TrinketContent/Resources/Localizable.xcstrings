    "talents.phoenix_deathsdoor_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: phoenix_deathsdoor_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die <keyword id=\"deathsdoor\">Todesschwelle</keyword> halbiert den Schaden, den du erleidest"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"deathsdoor\">Death's Door</keyword> halves damage you take"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le <keyword id=\"deathsdoor\">Seuil de la mort</keyword> réduit de moitié les dégâts subis"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"deathsdoor\">死の淵</keyword>の間、受けるダメージが半減"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"deathsdoor\">죽음의 문턱</keyword> 상태에서 받는 피해가 절반으로 감소"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "<keyword id=\"deathsdoor\">瀕死之門</keyword>使自身承受的傷害減半"
          }
        }
      }
    },
