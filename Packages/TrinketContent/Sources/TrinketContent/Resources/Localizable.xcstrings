        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ambos os aliados ganham +<value id=\"quantity_1\">%1$lld</value>%% de chance de <keyword id=\"dodge\">Esquiva</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "兩名友方的<keyword id=\"dodge\">閃避</keyword>機率提高<value id=\"quantity_1\">%1$lld</value>%%"}}
