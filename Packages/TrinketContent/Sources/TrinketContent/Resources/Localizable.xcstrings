    "homestead_nodes.culinaryarts.1.summary": {
      "comment": "ContentManifest/homestead_nodes.tsv: culinaryArts.1, summary",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine warme Küche, die die Ernte in bleibende Stärke verwandelt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A warm kitchen that turns the harvest into lasting strength"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une cuisine chaleureuse qui transforme les récoltes en force durable"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "収穫物を長く続く力へと変える、温かな厨房"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수확물을 든든한 힘으로 바꾸는 따뜻한 부엌"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將收成轉化為持久力量的溫暖廚房"
          }
        }
      }
    },
