    "talents.knight_holy_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: knight_holy_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">Heiliger</keyword> Schaden gegen gegnerischen <keyword id=\"block\">Block</keyword> wird um <value id=\"quantity_1\">%1$lld</value>%% erhöht"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">Holy</keyword> damage is increased by <value id=\"quantity_1\">%1$lld</value>%% against enemy <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "El daño <keyword id=\"holy\">sagrado</keyword> aumenta en un <value id=\"quantity_1\">%1$lld</value>%% contra el <keyword id=\"block\">Bloqueo</keyword> del enemigo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Dégâts de type <keyword id=\"holy\">Sacré</keyword> augmentés de <value id=\"quantity_1\">%1$lld</value>%% contre le <keyword id=\"block\">Blocage</keyword> ennemi"}},
        "ja": {"stringUnit": {"state": "translated", "value": "敵の<keyword id=\"block\">ブロック</keyword>への<keyword id=\"holy\">聖</keyword>ダメージが<value id=\"quantity_1\">%1$lld</value>%%増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "적의 <keyword id=\"block\">방어도</keyword>에 주는 <keyword id=\"holy\">신성</keyword> 피해 <value id=\"quantity_1\">%1$lld</value>%% 증가"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O dano <keyword id=\"holy\">Sagrado</keyword> aumenta em <value id=\"quantity_1\">%1$lld</value>%% contra o <keyword id=\"block\">Bloqueio</keyword> inimigo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "對敵人<keyword id=\"block\">格擋</keyword>造成的<keyword id=\"holy\">神聖</keyword>傷害提高<value id=\"quantity_1\">%1$lld</value>%%"}}
      }
    },
    "talents.knight_holy_t1_2.name": {
      "comment": "ContentManifest/talents.tsv: knight_holy_t1_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Reiner Glanz"}},
        "en": {"stringUnit": {"state": "translated", "value": "Pure Radiance"}},
        "es": {"stringUnit": {"state": "translated", "value": "Resplandor puro"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Radiance pure"}},
        "ja": {"stringUnit": {"state": "translated", "value": "純粋な輝き"}},
        "ko": {"stringUnit": {"state": "translated", "value": "순수한 광휘"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Resplendor Puro"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "純淨光輝"}}
      }
    },
    "talents.knight_holy_t2_1.description": {
      "comment": "ContentManifest/talents.tsv: knight_holy_t2_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Deine <keyword id=\"thorns\">Dornen</keyword> verursachen <keyword id=\"holy\">heiligen</keyword> statt <keyword id=\"physical\">physischen</keyword> Schaden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your <keyword id=\"thorns\">Thorns</keyword> deal <keyword id=\"holy\">Holy</keyword> instead of <keyword id=\"physical\">Physical</keyword> damage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tus <keyword id=\"thorns\">Espinas</keyword> infligen daño <keyword id=\"holy\">sagrado</keyword> en lugar de <keyword id=\"physical\">físico</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Vos <keyword id=\"thorns\">Épines</keyword> infligent des dégâts de type <keyword id=\"holy\">Sacré</keyword> au lieu de type <keyword id=\"physical\">Physique</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "自分の<keyword id=\"thorns\">棘</keyword>が<keyword id=\"physical\">物理</keyword>の代わりに<keyword id=\"holy\">聖</keyword>ダメージを与える"}},
        "ko": {"stringUnit": {"state": "translated", "value": "내 <keyword id=\"thorns\">가시</keyword>가 <keyword id=\"physical\">물리</keyword> 대신 <keyword id=\"holy\">신성</keyword> 피해를 줌"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seus <keyword id=\"thorns\">Espinhos</keyword> causam dano <keyword id=\"holy\">Sagrado</keyword> em vez de <keyword id=\"physical\">Físico</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "自身<keyword id=\"thorns\">荊棘</keyword>改為造成<keyword id=\"holy\">神聖</keyword>而非<keyword id=\"physical\">物理</keyword>傷害"}}
      }
    },
    "talents.knight_holy_t2_1.name": {
      "comment": "ContentManifest/talents.tsv: knight_holy_t2_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">Heilige</keyword> Infusion"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">Holy</keyword> Infusion"}},
        "es": {"stringUnit": {"state": "translated", "value": "Infusión <keyword id=\"holy\">sagrada</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Infusion <keyword id=\"holy\">Sacrée</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">聖</keyword>の注入"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">신성</keyword> 주입"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Infusão <keyword id=\"holy\">Sagrada</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">神聖</keyword>灌注"}}
      }
    },
    "talents.knight_holy_t2_2.description": {
      "comment": "ContentManifest/talents.tsv: knight_holy_t2_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">Heilige</keyword> Angriffe ignorieren die Hälfte des gegnerischen <keyword id=\"block\">Blocks</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">Holy</keyword> attacks ignore half enemy <keyword id=\"block\">Block</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los ataques <keyword id=\"holy\">sagrados</keyword> ignoran la mitad del <keyword id=\"block\">Bloqueo</keyword> del enemigo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les attaques de type <keyword id=\"holy\">Sacré</keyword> ignorent la moitié du <keyword id=\"block\">Blocage</keyword> ennemi"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">聖</keyword>攻撃が敵の<keyword id=\"block\">ブロック</keyword>を半分無視"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">신성</keyword> 공격이 적의 <keyword id=\"block\">방어도</keyword> 절반 무시"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ataques <keyword id=\"holy\">Sagrados</keyword> ignoram metade do <keyword id=\"block\">Bloqueio</keyword> inimigo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">神聖</keyword>攻擊無視敵人一半<keyword id=\"block\">格擋</keyword>"}}
      }
    },
    "talents.knight_holy_t2_2.name": {
      "comment": "ContentManifest/talents.tsv: knight_holy_t2_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Schildzertrümmerung"}},
        "en": {"stringUnit": {"state": "translated", "value": "Shield Shatter"}},
        "es": {"stringUnit": {"state": "translated", "value": "Quebranto de escudo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Fracas de bouclier"}},
        "ja": {"stringUnit": {"state": "translated", "value": "盾の破砕"}},
        "ko": {"stringUnit": {"state": "translated", "value": "방패 분쇄"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Estilhaçar Escudo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "盾碎"}}
      }
    },
    "talents.knight_holy_t3_1.description": {
      "comment": "ContentManifest/talents.tsv: knight_holy_t3_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">Entzaubern</keyword> lässt dich eine Karte ziehen,\nwährend du unter halber <keyword id=\"health\">Gesundheit</keyword> bist"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">Purge</keyword> draws a card while you're\nbelow half <keyword id=\"health\">Health</keyword>"}},
        "es": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">Purga</keyword> hace que robes una carta mientras estás\npor debajo de la mitad de <keyword id=\"health\">Salud</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Une <keyword id=\"purge\">Dissipation</keyword> fait piocher une carte\nsi vous êtes sous la moitié de votre <keyword id=\"health\">Santé</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">体力</keyword>が半分未満の間に\n<keyword id=\"purge\">強化解除</keyword>すると、カードを1枚引く"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"health\">체력</keyword>이 절반 미만일 때\n<keyword id=\"purge\">강화 해제</keyword> 시 카드 한 장 뽑기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "<keyword id=\"purge\">Expurgo</keyword> faz você comprar uma carta enquanto estiver\nabaixo de metade da <keyword id=\"health\">Vida</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "自身<keyword id=\"health\">生命值</keyword>低於一半時\n<keyword id=\"purge\">驅散</keyword>會抽一張牌"}}
      }
    },
    "talents.knight_holy_t3_1.name": {
      "comment": "ContentManifest/talents.tsv: knight_holy_t3_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Das Böse zerschmettern"}},
        "en": {"stringUnit": {"state": "translated", "value": "Smite the Wicked"}},
        "es": {"stringUnit": {"state": "translated", "value": "Castigar al malvado"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Châtier les impies"}},
        "ja": {"stringUnit": {"state": "translated", "value": "邪悪を討つ"}},
        "ko": {"stringUnit": {"state": "translated", "value": "악인 응징"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Castigar os Ímpios"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "懲戒邪惡"}}
      }
    },
    "talents.knight_holy_t3_2.description": {
      "comment": "ContentManifest/talents.tsv: knight_holy_t3_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">Heiliger</keyword> Schaden belebt deinen Gefährten mit <value id=\"quantity_1\">%1$lld</value>%% Chance wieder"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">Holy</keyword> damage has a <value id=\"quantity_1\">%1$lld</value>%% chance to revive your Companion"}},
        "es": {"stringUnit": {"state": "translated", "value": "El daño <keyword id=\"holy\">sagrado</keyword> tiene un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de revivir a tu compañero"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les dégâts de type <keyword id=\"holy\">Sacré</keyword> ont <value id=\"quantity_1\">%1$lld</value>%% de chances de ranimer votre Compagnon"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">聖</keyword>ダメージを与えると<value id=\"quantity_1\">%1$lld</value>%%の確率で仲間を蘇生"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">신성</keyword> 피해를 주면 <value id=\"quantity_1\">%1$lld</value>%% 확률로 동료 부활"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Dano <keyword id=\"holy\">Sagrado</keyword> tem <value id=\"quantity_1\">%1$lld</value>%% de chance de reviver seu Companheiro"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">神聖</keyword>傷害有<value id=\"quantity_1\">%1$lld</value>%%機率使夥伴復活"}}
      }
    },
    "talents.knight_holy_t3_2.name": {
      "comment": "ContentManifest/talents.tsv: knight_holy_t3_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Göttlicher Segen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Divine Blessing"}},
        "es": {"stringUnit": {"state": "translated", "value": "Bendición divina"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Bénédiction divine"}},
        "ja": {"stringUnit": {"state": "translated", "value": "神の祝福"}},
        "ko": {"stringUnit": {"state": "translated", "value": "신의 축복"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Bênção Divina"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "神聖祝福"}}
      }
    },
    "talents.knight_holy_t4_1.description": {
      "comment": "ContentManifest/talents.tsv: knight_holy_t4_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">Heiliger</keyword> Schaden gewährt deinem Gefährten mit <value id=\"quantity_1\">%1$lld</value>%% Chance ebenso viel <keyword id=\"block\">Block</keyword>"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">Holy</keyword> damage has a <value id=\"quantity_1\">%1$lld</value>%% chance to grant equal <keyword id=\"block\">Block</keyword> to your Companion"}},
        "es": {"stringUnit": {"state": "translated", "value": "El daño <keyword id=\"holy\">sagrado</keyword> tiene un <value id=\"quantity_1\">%1$lld</value>%% de probabilidad de otorgar una cantidad igual de <keyword id=\"block\">Bloqueo</keyword> a tu compañero"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les dégâts de type <keyword id=\"holy\">Sacré</keyword> ont <value id=\"quantity_1\">%1$lld</value>%% de chances d’octroyer autant de <keyword id=\"block\">Blocage</keyword> à votre Compagnon"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">聖</keyword>ダメージを与えると<value id=\"quantity_1\">%1$lld</value>%%の確率で同量の<keyword id=\"block\">ブロック</keyword>を仲間に付与"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">신성</keyword> 피해를 주면 <value id=\"quantity_1\">%1$lld</value>%% 확률로 동료에게 같은 양의 <keyword id=\"block\">방어도</keyword> 부여"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Dano <keyword id=\"holy\">Sagrado</keyword> tem <value id=\"quantity_1\">%1$lld</value>%% de chance de conceder uma quantidade igual de <keyword id=\"block\">Bloqueio</keyword> ao seu Companheiro"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"holy\">神聖</keyword>傷害有<value id=\"quantity_1\">%1$lld</value>%%機率為夥伴賦予等量<keyword id=\"block\">格擋</keyword>"}}
      }
    },
    "talents.knight_holy_t4_1.name": {
      "comment": "ContentManifest/talents.tsv: knight_holy_t4_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Sonnenwall"}},
        "en": {"stringUnit": {"state": "translated", "value": "Sunwall"}},
        "es": {"stringUnit": {"state": "translated", "value": "Muralla solar"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Mur solaire"}},
        "ja": {"stringUnit": {"state": "translated", "value": "陽光の壁"}},
        "ko": {"stringUnit": {"state": "translated", "value": "태양의 벽"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Muralha Solar"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "日光之壁"}}
      }
    },
    "talents.knight_stun_t1_1.description": {
      "comment": "ContentManifest/talents.tsv: knight_stun_t1_1, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verursache <value id=\"quantity_1\">%1$lld</value> zusätzlichen Schaden an <keyword id=\"stun\">betäubten</keyword> Gegnern"}},
        "en": {"stringUnit": {"state": "translated", "value": "Deal <value id=\"quantity_1\">%1$lld</value> additional damage to <keyword id=\"stun\">Stunned</keyword> enemies"}},
        "es": {"stringUnit": {"state": "translated", "value": "Inflige <value id=\"quantity_1\">%1$lld</value> de daño adicional a enemigos <keyword id=\"stun\">aturdidos</keyword>"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Infligez <value id=\"quantity_1\">%1$lld</value> dégâts supplémentaires aux ennemis sous <keyword id=\"stun\">Étourdissement</keyword>"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">スタン</keyword>状態の敵に与えるダメージが<value id=\"quantity_1\">%1$lld</value>増加"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">기절</keyword> 상태의 적에게 추가 피해 <value id=\"quantity_1\">%1$lld</value>"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cause <value id=\"quantity_1\">%1$lld</value> de dano adicional a inimigos <keyword id=\"stun\">Atordoados</keyword>"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "對<keyword id=\"stun\">暈眩</keyword>的敵人額外造成<value id=\"quantity_1\">%1$lld</value>點傷害"}}
      }
    },
    "talents.knight_stun_t1_1.name": {
      "comment": "ContentManifest/talents.tsv: knight_stun_t1_1, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Schwerer Flegel"}},
        "en": {"stringUnit": {"state": "translated", "value": "Heavy Flail"}},
        "es": {"stringUnit": {"state": "translated", "value": "Mayal pesado"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Fléau lourd"}},
        "ja": {"stringUnit": {"state": "translated", "value": "重いフレイル"}},
        "ko": {"stringUnit": {"state": "translated", "value": "무거운 도리깨"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Mangual Pesado"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "重型連枷"}}
      }
    },
    "talents.knight_stun_t1_2.description": {
      "comment": "ContentManifest/talents.tsv: knight_stun_t1_2, description",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">Betäubte</keyword> Gegner verursachen halben Schaden, wenn sie sich erholen"}},
        "en": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">Stunned</keyword> enemies deal half damage when they recover"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los enemigos <keyword id=\"stun\">aturdidos</keyword> infligen la mitad de daño cuando se recuperan"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les ennemis sous <keyword id=\"stun\">Étourdissement</keyword> infligent la moitié des dégâts lorsqu’ils récupèrent"}},
        "ja": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">スタン</keyword>状態から回復した敵の与えるダメージが半減"}},
        "ko": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">기절</keyword> 상태의 적이 회복한 뒤 주는 피해가 절반으로 감소"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Inimigos <keyword id=\"stun\">Atordoados</keyword> causam metade do dano ao se recuperarem"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "<keyword id=\"stun\">暈眩</keyword>的敵人恢復後，造成的傷害減半"}}
      }
    },
    "talents.knight_stun_t1_2.name": {
      "comment": "ContentManifest/talents.tsv: knight_stun_t1_2, name",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erschütternder Schlag"}},
