      "comment": "Trinket/Features/Play/Modes/VoyageView.swift: Button. Arguments are displayed values in source order.",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Reisen aktualisieren"}},
