    "ui.mysteryitemchoicecontent.choose_gear_to_corrupt_the_altar_remakes_it_o_b4084": {
      "comment": "Trinket/Features/Play/Mystery/MysteryItemChoiceContent.swift: display copy. Arguments are displayed values in source order.",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wähle Ausrüstung zum Verderben\nDer Altar formt sie einmalig und dauerhaft um"}},
        "en": {"stringUnit": {"state": "translated", "value": "Choose gear to corrupt\nThe altar remakes it once, forever"}},
        "es": {"stringUnit": {"state": "translated", "value": "Elige equipo que corromper\nEl altar lo transforma una sola vez, para siempre"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Choisissez un équipement à corrompre\nL’autel le refaçonne une seule fois, pour toujours"}},
        "ja": {"stringUnit": {"state": "translated", "value": "汚染する装備を選択\n祭壇による変化は一度きりで、元には戻せません"}},
        "ko": {"stringUnit": {"state": "translated", "value": "타락시킬 장비를 선택하세요\n제단은 장비를 단 한 번, 영원히 바꿉니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Escolha um equipamento para corromper\nO altar o transforma uma única vez, para sempre"}},
