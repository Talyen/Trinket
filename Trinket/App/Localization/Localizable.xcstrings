    "homestead.wish.choose": {
      "comment": "Homestead activities: exact costs, eligibility, and results. Wishes affect only eligible same-category battle drops. Inscription changes one permanent affix position.",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ein nicht besessenes Unikat oder Schmuckstück wählen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Choose an unowned Unique or Trinket"}},
        "es": {"stringUnit": {"state": "translated", "value": "Elige un objeto único o abalorio que no tengas"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Choisissez un objet unique ou un bibelot non possédé"}},
        "ja": {"stringUnit": {"state": "translated", "value": "未所持の固有装備またはトリンケットを選択"}},
        "ko": {"stringUnit": {"state": "translated", "value": "보유하지 않은 고유 장비 또는 트링킷 선택"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Escolha um item Único ou Berloque que ainda não possui"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "選擇尚未擁有的獨特裝備或飾物"}}
      }
    },
    "homestead.wish.for": {
      "comment": "Homestead activities: exact costs, eligibility, and results. Wishes affect only eligible same-category battle drops. Inscription changes one permanent affix position.",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "%1$@ wünschen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Wish for %1$@"}},
        "es": {"stringUnit": {"state": "translated", "value": "Desear %1$@"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Souhaiter %1$@"}},
        "ja": {"stringUnit": {"state": "translated", "value": "%1$@を願う"}},
        "ko": {"stringUnit": {"state": "translated", "value": "%1$@ 소원 빌기"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Desejar %1$@"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "許願獲得 %1$@"}}
      }
    },
    "homestead.wish.help": {
      "comment": "Homestead activities: exact costs, eligibility, and results. Wishes affect only eligible same-category battle drops. Inscription changes one permanent affix position.",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wenn im Kampf ein zulässiger Gegenstand derselben Kategorie fällt, wird dein Wunsch mit %1$lld%% Wahrscheinlichkeit gewählt"}},
        "en": {"stringUnit": {"state": "translated", "value": "When a battle drops an eligible item of the same category, your wish has a %1$lld%% chance to be chosen"}},
        "es": {"stringUnit": {"state": "translated", "value": "Cuando una batalla otorga un objeto válido de la misma categoría, tu deseo tiene un %1$lld%% de probabilidad de ser elegido"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Lorsqu’un combat rapporte un objet éligible de la même catégorie, votre vœu a %1$lld%% de chances d’être choisi"}},
        "ja": {"stringUnit": {"state": "translated", "value": "戦闘で同じ種類の対象アイテムがドロップする際、%1$lld%%の確率で願ったアイテムが選ばれます"}},
        "ko": {"stringUnit": {"state": "translated", "value": "전투에서 같은 분류의 획득 가능한 아이템이 나올 때, %1$lld%% 확률로 소원 아이템이 선택됩니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Quando uma batalha concede um item elegível da mesma categoria, seu desejo tem %1$lld%% de chance de ser escolhido"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "戰鬥掉落同類別的合資格物品時，有 %1$lld%% 機率選中許願物品"}}
      }
    },
    "homestead.wish.last": {
      "comment": "Homestead activities: exact costs, eligibility, and results. Wishes affect only eligible same-category battle drops. Inscription changes one permanent affix position.",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wenn keine anderen zulässigen Gegenstände übrig sind, ist dein Wunsch garantiert"}},
        "en": {"stringUnit": {"state": "translated", "value": "If no other eligible items remain, your wish is guaranteed"}},
        "es": {"stringUnit": {"state": "translated", "value": "Si no quedan otros objetos válidos, tu deseo está garantizado"}},
        "fr": {"stringUnit": {"state": "translated", "value": "S’il ne reste aucun autre objet éligible, votre vœu est garanti"}},
        "ja": {"stringUnit": {"state": "translated", "value": "他に対象アイテムがなければ、願ったアイテムを必ず獲得"}},
        "ko": {"stringUnit": {"state": "translated", "value": "다른 획득 가능 아이템이 없으면 소원 아이템이 확정됩니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Se não houver outros itens elegíveis, seu desejo é garantido"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "若沒有其他合資格物品，必定獲得許願物品"}}
      }
    },
    "homestead.wish.rates": {
      "comment": "Homestead activities: exact costs, eligibility, and results. Wishes affect only eligible same-category battle drops. Inscription changes one permanent affix position.",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wünsche erhöhen nicht die Fundchancen für Unikate oder Schmuckstücke"}},
        "en": {"stringUnit": {"state": "translated", "value": "Wishes do not increase Unique or Trinket drop rates"}},
        "es": {"stringUnit": {"state": "translated", "value": "Los deseos no aumentan la probabilidad de obtener objetos únicos o abalorios"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les vœux n’augmentent pas les chances d’obtenir des objets uniques ou des bibelots"}},
        "ja": {"stringUnit": {"state": "translated", "value": "願いは固有装備やトリンケットのドロップ率を上げません"}},
        "ko": {"stringUnit": {"state": "translated", "value": "소원은 고유 장비나 트링킷의 획득 확률을 높이지 않습니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Desejos não aumentam as chances de obter itens Únicos ou Berloques"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "許願不會提高獨特裝備或飾物的掉落率"}}
      }
    },
    "homestead.wishing.for": {
      "comment": "Homestead activities: exact costs, eligibility, and results. Wishes affect only eligible same-category battle drops. Inscription changes one permanent affix position.",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wunsch: %1$@"}},
        "en": {"stringUnit": {"state": "translated", "value": "Wishing for %1$@"}},
        "es": {"stringUnit": {"state": "translated", "value": "Deseo: %1$@"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Vœu : %1$@"}},
        "ja": {"stringUnit": {"state": "translated", "value": "%1$@を願っています"}},
        "ko": {"stringUnit": {"state": "translated", "value": "소원: %1$@"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Desejo: %1$@"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "正在許願：%1$@"}}
      }
    },
    "library.basic_or_astral": {
      "comment": "Library, Bestiary and Archery Range crafting. Discovery means encountered; recipe affix guarantees do not guarantee rarity.",
      "extractionState": "manual",
