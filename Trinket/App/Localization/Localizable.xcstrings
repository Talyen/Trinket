        "ko": {"stringUnit": {"state": "translated", "value": "모든 고유 장비와 트링킷 수집 완료"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Todos os itens Únicos e Berloques foram coletados"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "已收集所有獨特裝備與飾物"}}
      }
    },
