    "ui.voyageview.keep_rewards_already_earned_remaining_progres_3052e": {
      "comment": "Trinket/Features/Play/Modes/VoyageView.swift: Text. Arguments are displayed values in source order.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereits verdiente Belohnungen bleiben erhalten. Der übrige Fortschritt und der Abschlussbonus gehen verloren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep rewards already earned. Remaining progress and the completion bonus will be lost."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les récompenses déjà obtenues sont conservées. La progression restante et le bonus de fin seront perdus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "獲得済みの報酬は保持されます。残りの進行状況と完了ボーナスは失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 획득한 보상은 유지됩니다. 남은 진행도와 완료 보너스는 사라집니다."
