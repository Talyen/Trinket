    "ui.optionsview.reset_cloud_explanation": {
      "comment": "Reset progress alert message when iCloud sync applies. Permanently deletes game progress including synced devices; settings and purchases are preserved.",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dein Fortschritt wird dauerhaft gelöscht und du beginnst von vorn. Einstellungen und Käufe bleiben erhalten. Auch der Fortschritt auf synchronisierten Geräten wird zurückgesetzt."}},
        "en": {"stringUnit": {"state": "translated", "value": "Permanently delete your progress and start over. Settings and purchases are kept. Also resets progress on synced devices."}},
        "es": {"stringUnit": {"state": "translated", "value": "Elimina permanentemente tu progreso y empieza de nuevo. Se conservan los ajustes y las compras. También restablece el progreso en los dispositivos sincronizados."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre progression sera définitivement effacée et vous recommencerez à zéro. Vos réglages et achats seront conservés. La progression sera aussi réinitialisée sur les appareils synchronisés."}},
        "ja": {"stringUnit": {"state": "translated", "value": "進行状況を永久に削除して最初からやり直します。設定と購入内容は保持されます。同期先のデバイスの進行状況もリセットされます。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "진행 상황을 영구적으로 삭제하고 처음부터 시작합니다. 설정과 구매 항목은 유지됩니다. 동기화된 기기의 진행 상황도 초기화됩니다."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Exclua permanentemente seu progresso e recomece. Configurações e compras são mantidas. Também redefine o progresso nos dispositivos sincronizados."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "永久刪除你的進度並重新開始。設定與購買內容會保留。也會重設已同步裝置上的進度。"}}
      }
    },
    "ui.optionsview.reset_game_progress_2edb2": {
      "comment": "Trinket/Features/Options/OptionsView.swift: Button. Arguments are displayed values in source order.",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Spielfortschritt zurücksetzen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Reset Game Progress"}},
        "es": {"stringUnit": {"state": "translated", "value": "Restablecer progreso del juego"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Réinitialiser la progression"}},
        "ja": {"stringUnit": {"state": "translated", "value": "ゲームの進行状況をリセット"}},
        "ko": {"stringUnit": {"state": "translated", "value": "게임 진행 초기화"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Redefinir progresso do jogo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "重設遊戲進度"}}
      }
    },
    "ui.optionsview.reset_local_explanation": {
      "comment": "Reset progress alert message. Permanently deletes game progress; settings and purchases are preserved.",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dein Fortschritt wird dauerhaft gelöscht und du beginnst von vorn. Einstellungen und Käufe bleiben erhalten."}},
        "en": {"stringUnit": {"state": "translated", "value": "Permanently delete your progress and start over. Settings and purchases are kept."}},
        "es": {"stringUnit": {"state": "translated", "value": "Elimina permanentemente tu progreso y empieza de nuevo. Se conservan los ajustes y las compras."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre progression sera définitivement effacée et vous recommencerez à zéro. Vos réglages et achats seront conservés."}},
        "ja": {"stringUnit": {"state": "translated", "value": "進行状況を永久に削除して最初からやり直します。設定と購入内容は保持されます。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "진행 상황을 영구적으로 삭제하고 처음부터 시작합니다. 설정과 구매 항목은 유지됩니다."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Exclua permanentemente seu progresso e recomece. Configurações e compras são mantidas."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "永久刪除你的進度並重新開始。設定與購買內容會保留。"}}
      }
    },
