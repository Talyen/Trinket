    "ui.optionsview.reset_local_explanation": {
      "comment": "Inline destructive reset confirmation in Options. Device-only reset; do not imply purchases or Options settings are deleted.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden deine Kampagnenabschnitte, deine Durchläufe im Modus „Erkunden“, deine Helden und Gefährten, deine Gegenstände sowie die Verbesserungen deiner Heimstatt auf diesem Gerät dauerhaft gelöscht. Du wählst danach erneut einen neuen Helden für den Spielstart. Deine Einstellungen unter „Optionen“ bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently clears your Campaign stages, Explore runs, Heroes and Companions, Items, and Homestead upgrades on this device. You'll choose a new starter Hero again. Options settings are kept."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action efface définitivement vos étapes de Campagne, vos parties du mode Explorer, vos Héros et Compagnons, vos Objets et les améliorations de votre Domaine sur cet appareil. Vous devrez à nouveau choisir un nouveau Héros de départ. Les réglages des Options sont conservés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスのキャンペーンのステージ、探索のプレイデータ、ヒーローと仲間、アイテム、拠点のアップグレードを削除し、元に戻すことはできません。もう一度、新しい初期ヒーローを選ぶことになります。オプションの設定は保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 캠페인 스테이지, 탐험 플레이 데이터, 영웅과 동료, 아이템, 안식처 업그레이드를 영구적으로 삭제합니다. 새로운 시작 영웅을 다시 선택하게 됩니다. 설정은 유지됩니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會永久清除此裝置上的戰役關卡、探索遊玩進度、英雄與夥伴、物品，以及家園升級。你將再次選擇新的初始英雄。選項設定會保留。"
          }
        }
      }
    },
