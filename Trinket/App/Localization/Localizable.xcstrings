{
  "sourceLanguage": "en",
  "strings": {
    "homestead.affix.lock.help": {
      "comment": "Homestead activities: exact costs, eligibility, and results. Wishes affect only eligible same-category battle drops. Inscription changes one permanent affix position.",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Nach dem Gravieren kann nur dieses Affix geändert werden"}},
        "en": {"stringUnit": {"state": "translated", "value": "After inscription, only this affix can be changed"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tras la inscripción, solo podrás cambiar este afijo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Après la gravure, seul cet affixe pourra être modifié"}},
        "ja": {"stringUnit": {"state": "translated", "value": "刻印後は、この付与効果のみ変更可能"}},
        "ko": {"stringUnit": {"state": "translated", "value": "각인 후에는 이 접사만 변경할 수 있습니다"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Após a inscrição, apenas este afixo poderá ser alterado"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "銘刻後只能變更此詞綴"}}
      }
    },
    "homestead.affix.replaced": {
      "comment": "Homestead activities: exact costs, eligibility, and results. Wishes affect only eligible same-category battle drops. Inscription changes one permanent affix position.",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Affix ersetzt"}},
        "en": {"stringUnit": {"state": "translated", "value": "Affix replaced"}},
        "es": {"stringUnit": {"state": "translated", "value": "Afijo reemplazado"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Affixe remplacé"}},
        "ja": {"stringUnit": {"state": "translated", "value": "付与効果を置き換えました"}},
        "ko": {"stringUnit": {"state": "translated", "value": "접사 교체 완료"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Afixo substituído"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "詞綴已替換"}}
      }
    },
    "homestead.all.collected": {
      "comment": "Homestead activities: exact costs, eligibility, and results. Wishes affect only eligible same-category battle drops. Inscription changes one permanent affix position.",
      "extractionState": "manual",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Alle Unikate und Schmuckstücke gesammelt"}},
